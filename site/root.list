# Guest files in the browser's root bundle (site/tools/rootpack.zi).
#
# This file names the guest root's structure and the ZX libraries the emulator
# installs. It does not name app bundles: those come from lib/preinstall.list,
# whose first-run column decides whether a bundle ships in the first download
# (root) or stays on the server until first open (lazy). Rill and the desktop
# panel are root; every other application is lazy.
#
# `- .zx` keeps the Dis tree from packing ZX bundles as a side effect of the
# directory walk. The porting lanes build app bundles into zx/, and packing
# them all would put tens of megabytes into the first download. A bundle
# reaches the guest root only by being named in the manifest, and the emulator's
# own libraries by being named below.

dis
- .sbl
- .zx

# The three ZX libraries emu/port/zx.c installs for the window manager.
zx/lib/window_chrome.zx
zx/lib/winplace.zx
zx/lib/wm_policy.zx

# Dis programs served on first open. They are not catalog applications, so the
# preinstall manifest does not describe them.
lazy zx/tclsh.zx
lazy zx/tcltk.zx
lazy zx/coffee.zx
lazy zx/man.zx
lazy zx/math/linbench.zx
lazy zx/math/graph0.zx

lib/apps
lib/rill
lib/wmsetup
lib/sh
lib/ndb
lib/keyboard
lib/mimeapps.list
lib/mimetype
lib/tbsetup
lib/emptydirs
lib/icons/hicolor/index.theme
lib/icons/hicolor/16x16
lib/icons/hicolor/22x22
lib/icons/hicolor/24x24
lib/icons/hicolor/32x32
lib/icons/hicolor/48x48
lib/icons/hicolor/64x64
- .png

icons
icons/taijios/22.png
icons/taijios/48.png
icons/taijios/64.png
icons/taijios/128.png
icons/taijios/logo.png

fonts/lucidasans
fonts/pelm
fonts/misc

locale
module

mkdir tmp
mkdir n
mkdir mnt
mkdir usr/taiji/lib
mkdir usr/taiji/tmp
