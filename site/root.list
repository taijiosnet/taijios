lazy dis/wm/clock.zx
lazy dis/wm/counter.zx
lazy dis/wm/stopwatch.zx
lazy dis/wm/memory.zx
lazy dis/wm/logwindow.zx
lazy dis/wm/dir.zx
lazy dis/wm/taskmgr.zx
lazy dis/wm/view.zx
lazy dis/wm/explorer.zx
lazy dis/tclsh.zx
lazy dis/tcltk.zx
lazy dis/coffee.zx
lazy dis/man.zx
lazy dis/math/linbench.zx
lazy dis/math/graph0.zx

