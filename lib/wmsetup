# /zx/sh script
# wm defines "menu" and "delmenu" builtins
load std
prompt='% ' ''
fn % {$*}
autoload=std
home=/usr/^"{cat /dev/user}

if {! {~ wm ${loaded}}} {
	echo wmsetup must run under wm >[1=2]
	raise usage
}

fn wmrun {
	args := $*
	{
		pctl newpgrp
		fn wmrun
		$args
	} > /chan/wmstdout >[2] /chan/wmstderr &
}

fn cd {
	builtin cd $*;
	rescue 'bad redir' {} {
		echo cwd `{pwd} > /chan/shctl
	} >[2] /dev/null
}

plumber >/chan/wmstdout >[2=1]
if {ftest -f /zx/wm/explorer.zx} {
	menu Files              {wmrun zxrun -w /zx/wm/explorer.zx}
} {
	menu Files              {if {ftest -d $home} {wmrun wm/ftree $home} {wmrun wm/ftree /}}
}
menu 'Web Browser'          {wmrun charon}
menu ''                     ''
menu Development Acme       {wmrun acme}
menu Development Edit       {wmrun zxrun -w /zx/wm/edit.zx}
menu Development Debugger   {wmrun wm/deb}
menu System Shell           {wmrun wm/sh}
menu System 'Module Manager' {wmrun wm/rt}
if {ftest -f /zx/wm/taskmgr.zx} {
	menu System 'Task Manager' {wmrun zxrun -w /zx/wm/taskmgr.zx}
} {
	menu System 'Task Manager' {wmrun wm/task}
}
menu System 'Memory Monitor' {wmrun zxrun -p -w /zx/wm/memory.zx}
menu System About         {wmrun zxrun -w /zx/wm/about.zx}
menu Utilities Manual       {wmrun zxrun -w /zx/man.zx}
menu Utilities Coffee       {wmrun zxrun -w /zx/coffee.zx}
if {ftest -f /zx/wm/colors.zx} {
	menu Utilities Colours  {wmrun zxrun -w /zx/wm/colors.zx}
} {
	menu Utilities Colours  {wmrun wm/colors}
}
if {ftest -f /zx/wm/date.zx} {
	menu Utilities 'Date and Time' {wmrun zxrun -w /zx/wm/date.zx}
} {
	menu Utilities 'Date and Time' {wmrun wm/date}
}
menu Utilities Clock        {wmrun zxrun -w /zx/wm/clock.zx}
menu Utilities Stopwatch    {wmrun zxrun -w /zx/wm/stopwatch.zx}
menu Utilities Counter      {wmrun zxrun -w /zx/wm/counter.zx}
menu Games Tetris            {wmrun zxrun -w /zx/wm/tetris.zx}
menu Games Bounce            {wmrun zxrun -w /zx/wm/bounce.zx}

if {ftest -f $home/lib/wmsetup} {run $home/lib/wmsetup} {}
