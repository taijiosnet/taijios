// alphabet [-c commands] [file ...]: run Alphabet's shell builtins, as
// "load alphabet" gave them to the Dis shell: declare, declares,
// undeclare, define, import, autodeclare, type, typeset, autoconvert,
// - {expr} [arg...], info and clear; the value builtins rewrite, modules,
// types and usage, whose words are printed, or substituted as ${name ...}
// in an echo; and whatis. Commands come from -c, from the files, or from
// standard input, one shell command line at a time. The exit status is
// that of the last command.
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
Sh :: #import "shcmd";
Bu :: #import "alpha_builtins";
Typesets :: #import "alpha_typesets";

main :: () -> s32 {
    Typesets.Register();
    state: Bu.State;
    none: []Bu.Arg;
    Bu.Init(*state, none);
    count := Args.OperandCount();
    status := "";
    if count >= 2 && Args.Operand(0) == "-c" {
        status = RunText(*state, Args.Operand(1));
    } else if count == 0 {
        status = RunText(*state, ReadHandle(0));
    } else {
        for i: 0..count - 1 {
            path := Args.Operand(cast(s32)i);
            h := Io.OpenFile(path, 0);
            if h < 0 {
                line: Vec(u8);
                BuilderPrint(*line, "alphabet: cannot open %: %\n", path, Io.LastError());
                unused Io.WriteBytes(2, BuilderFinish(line));
                unused Args.SetFailure("bad open");
                return 1;
            }
            status = RunText(*state, ReadHandle(h));
            unused Io.CloseFile(h);
        }
    }
    if status.count > 0 {
        unused Args.SetFailure(status);
        return 1;
    }
    return 0;
}

RunText :: (state: *Bu.State, text: string) -> string {
    status := "";
    at: s64 = 0;
    while at < text.count {
        n, err, next := Sh.ParseAt(text, at);
        if err.count > 0 {
            line: Vec(u8);
            BuilderPrint(*line, "alphabet: %\n", err);
            unused Io.WriteBytes(2, BuilderFinish(line));
            status = "parse error";
        } else if n >= 0 {
            status = Bu.RunTree(state, n);
            if state.raised { break }
        }
        if next <= at { break }
        at = next;
    }
    return status;
}

ReadHandle :: (h: s32) -> string {
    out: Vec(u8);
    buffer: [8192]u8;
    while true {
        n := Io.ReadBytes(h, buffer[:]);
        if n <= 0 { break }
        for buffer[:n] { VecPush(out, it) }
    }
    return BuilderFinish(out);
}
