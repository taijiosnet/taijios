// The fd and wfd values many modules make: text served from memory, the
// contents of a handle, and a handle a wfd value holds. An fd value that
// reaches its end lets its handle go.
using Io :: #import "taijios_io";
Va :: #import "alpha_values";

// An fd value whose bytes are text.
TextStream :: (text: string) -> s32 {
    if text_prod < 0 {
        p := Va.BlankProducer("text");
        p.read = TextRead;
        text_prod = Va.AddProducer(p);
    }
    v := Va.NewValue(#char "f", text_prod);
    Va.SetText(v, text);
    return v;
}

// An fd value read from handle; it offers the handle to a consumer that
// wants one, as a Dis producer offered its descriptor.
HandleStream :: (handle: s32, errc: s32) -> s32 {
    if handle_prod < 0 {
        p := Va.BlankProducer("handle");
        p.read = HandleRead;
        p.free = HandleFree;
        p.handle = HandleOf;
        handle_prod = Va.AddProducer(p);
    }
    v := Va.NewValue(#char "f", handle_prod);
    Va.SetRawHandle(v, handle);
    Va.SetErrc(v, errc);
    return v;
}

// A wfd value that is handle.
WfdHandle :: (handle: s32, errc: s32) -> s32 {
    v := HandleStream(handle, errc);
    Va.SetTypec(v, #char "w");
    return v;
}

// The next chunk of a filled stream; more is false with the last one.
Chunk :: struct {
    text: string;
    more: bool;
}

FillOp :: #type (v: s32) -> Chunk;

// An fd value whose bytes come in chunks from fill, until it has no more.
FillStream :: (fill: FillOp) -> s32 {
    k: s64 = -1;
    for fills { if it == fill { k = it_index } }
    if k < 0 {
        p := Va.BlankProducer("fill");
        p.read = FillRead;
        VecPush(fill_prods, Va.AddProducer(p));
        VecPush(fills, fill);
        k = fills.count - 1;
    }
    v := Va.NewValue(#char "f", fill_prods[k]);
    Va.SetN1(v, k);
    return v;
}

// A handle for descriptor number n of the process, as sys->fildes gave
// one, or -1 when it is not open.
Fildes :: (n: s64, mode: s32) -> s32 {
    if n < 0 { return -1 }
    if n < 3 { return cast(s32)n }
    path: Vec(u8);
    BuilderPrint(*path, "/fd/%", n);
    return Io.OpenFile(BuilderFinish(path), mode);
}

ReleaseHandle :: (h: s32) {
    if h >= 3 { unused Io.CloseFile(h) }
}

#scope_file

text_prod: s32 = -1;
fills: Vec(FillOp);
fill_prods: Vec(s32);

// Serves the chunk in hand, then asks fill for the next; N2 is 1 once
// fill has said there is no more.
FillRead :: (v: s32, buffer: []u8) -> s64 {
    while true {
        n := TextRead(v, buffer);
        if n > 0 || Va.N2(v) == 1 { return n }
        chunk := fills[Va.N1(v)](v);
        Va.SetText(v, chunk.text);
        Va.SetN0(v, 0);
        if !chunk.more { Va.SetN2(v, 1) }
    }
    return 0;
}
handle_prod: s32 = -1;

TextRead :: (v: s32, buffer: []u8) -> s64 {
    text := Va.ValueText(v);
    at := Va.N0(v);
    n := text.count - at;
    if n > buffer.count { n = buffer.count }
    if n <= 0 { return 0 }
    for i: 0..n - 1 { buffer[i] = text[at + i] }
    Va.SetN0(v, at + n);
    return n;
}

HandleRead :: (v: s32, buffer: []u8) -> s64 {
    h := Va.RawHandle(v);
    if h < 0 { return 0 }
    n := Io.ReadBytes(h, buffer);
    if n <= 0 {
        ReleaseHandle(h);
        Va.SetRawHandle(v, -1);
    }
    return n;
}

HandleFree :: (v: s32, used: bool) -> s32 {
    if used { return 0 }
    ReleaseHandle(Va.RawHandle(v));
    Va.SetRawHandle(v, -1);
    return 0;
}

HandleOf :: (v: s32) -> s32 { return Va.RawHandle(v) }
