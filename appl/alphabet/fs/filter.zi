// /fs/filter [-d] fs gate -> fs: the tree with only the entries the gate
// lets through below the root; -d keeps every directory.
#import "std/vec";
#import "std/option";
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
using Fs :: #import "fs/fsvalue";

Register :: (reg: s32) { Al.RegisterModule(reg, "filter", "xxp-d", Run) }

Run :: (call: *Al.Call) -> s32 {
    f: Filter;
    f.dflag = Al.OptCount(call) > 0;
    f.gate = call.args[1];
    return New(call.args[0], f);
}

// A filter of fs value src; chstat's filters change entries instead.
New :: (src: s32, f: Filter) -> s32 {
    if prod < 0 { prod = FsProducer("filter", Next1) }
    v := Va.NewValue(#char "x", prod);
    kids := s32.[src];
    Va.SetKids(v, kids[:]);
    VecPush(filters, f);
    Va.SetN0(v, filters.count - 1);
    return v;
}

// fsfilter's filter, item by item. A chstat filter lets every entry
// through, changing those its gate (if any) chooses.
Filter :: struct {
    dflag: bool;
    gate: s32;
    chstat: bool;
    mask: s64;
    mode: s64;
    uid: string;
    gid: string;
    mtime: s64;   // -1: leave it
    atime: s64;
    cflag: bool;
    names: Vec(string);
    name: string;
    indent: s64;
    last: Item;   // the item given on, to know what its answer means
    started: bool;
    over: bool;
}

#scope_file

prod: s32 = -1;
filters: Vec(Filter);

Pass :: (f: s64, d: FsDir, name: string, depth: s64, gate: s32) -> bool {
    if depth == 0 || (filters[f].dflag && IsDir(d)) { return true }
    e := EntryItemOf(d, name, depth);
    return Query(gate, *e);
}

// chstat's query: the entry changed when the gate says so; always kept.
Change :: (f: s64, d: *FsDir, name: string, depth: s64) {
    c := true;
    if filters[f].gate >= 0 {
        e := EntryItemOf(<<d, name, depth);
        c = Query(filters[f].gate, *e);
    }
    if !c { return }
    mode := cast(s64)d.mode;
    if filters[f].cflag {
        m := mode & 0x1C0;
        mode = (mode & ~0x3F) | (m >> 3) | (m >> 6);
    }
    mode = (mode & ~filters[f].mask) | (filters[f].mode & filters[f].mask);
    d.mode = cast(u32)(mode & 0xFFFFFFFF);
    if filters[f].uid.count > 0 { d.uid = filters[f].uid }
    if filters[f].gid.count > 0 { d.gid = filters[f].gid }
    if filters[f].mtime != -1 { d.mtime = cast(u32)filters[f].mtime }
    if filters[f].atime != -1 { d.atime = cast(u32)filters[f].atime }
}

Next1 :: (v: s32, reply_in: s32) -> Item {
    f := Va.N0(v);
    src := Va.Kid(v, 0);
    gate := filters[f].gate;
    if filters[f].over { return ItemOf(Done) }
    reply := reply_in;
    if filters[f].started {
        // the answer to the item given before, as fsfilter kept count of it
        d := filters[f].last;
        if reply == Quit {
            filters[f].over = true;
            unused FsNext(src, Quit);
            return ItemOf(Done);
        }
        if reply == Next {
            if d.kind == End {
                filters[f].indent -= 1;
                if filters[f].indent == 0 { return Finish(f, src, Next) }
                Pop(f);
            }
        } else if reply == Skip {
            filters[f].indent -= 1;
            if filters[f].indent == 0 { return Finish(f, src, Skip) }
            Pop(f);
        } else if reply == Down {
            if d.kind == Entry {
                VecPush(filters[f].names, filters[f].name);
                if IsDir(d.dir) {
                    if filters[f].indent == 0 {
                        filters[f].name = d.dir.name;
                    } else {
                        filters[f].name = Slash(filters[f].name, d.dir.name);
                    }
                }
                filters[f].indent += 1;
            }
        }
    } else {
        filters[f].started = true;
        reply = Start;
    }
    while true {
        item := FsNext(src, reply);
        if item.kind == Done {
            filters[f].over = true;
            return item;
        }
        if item.kind == Entry {
            p := filters[f].name;
            if filters[f].indent > 0 && p.count > 0 && p[p.count - 1] != #char "/" { p = Al.Join(p, "/") }
            if filters[f].chstat {
                Change(f, *item.dir, Al.Join(p, item.dir.name), filters[f].indent);
            } else if !Pass(f, item.dir, Al.Join(p, item.dir.name), filters[f].indent, gate) && filters[f].indent > 0 {
                reply = Next;
                continue;
            }
        }
        filters[f].last = item;
        return item;
    }
    return ItemOf(Done);
}

// The root's directory is over: the answer goes back and the tree ends.
Finish :: (f: s64, src: s32, reply: s32) -> Item {
    unused FsNext(src, reply);
    filters[f].over = true;
    return ItemOf(Done);
}

Pop :: (f: s64) {
    last := VecPop(filters[f].names);
    filters[f].name = last.value;
}

Slash :: (a: string, b: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    if a.count == 0 || a[a.count - 1] != #char "/" { VecPush(out, #char "/") }
    BuilderAppend(out, b);
    return BuilderFinish(out);
}
