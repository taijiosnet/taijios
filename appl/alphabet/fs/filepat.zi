// Filepat's match: whether a name fits a shell pattern of * ? [...] and
// \ escapes, character by character as appl/lib/filepat.b read it.
#import "std/vec";

Match :: (pat: string, name: string) -> bool {
    p: Vec(s32);
    n: Vec(s32);
    Runes(pat, *p);
    Runes(name, *n);
    return Match1(p[:], n[:]);
}

#scope_file

Runes :: (s: string, out: *Vec(s32)) {
    i: s64 = 0;
    while i < s.count {
        c := cast(s32)s[i];
        width: s64 = 1;
        if c >= 0xF0 && i + 3 < s.count {
            c = ((c & 0x07) << 18) | ((cast(s32)s[i + 1] & 0x3F) << 12) | ((cast(s32)s[i + 2] & 0x3F) << 6) | (cast(s32)s[i + 3] & 0x3F);
            width = 4;
        } else if c >= 0xE0 && i + 2 < s.count {
            c = ((c & 0x0F) << 12) | ((cast(s32)s[i + 1] & 0x3F) << 6) | (cast(s32)s[i + 2] & 0x3F);
            width = 3;
        } else if c >= 0xC0 && i + 1 < s.count {
            c = ((c & 0x1F) << 6) | (cast(s32)s[i + 1] & 0x3F);
            width = 2;
        }
        VecPush(<<out, c);
        i += width;
    }
}

Match1 :: (pat_in: []s32, name: []s32) -> bool {
    pat := pat_in;
    n: s64 = 0;
    p: s64 = 0;
    while p < pat.count {
        r := pat[p];
        p += 1;
        if r == #char "*" {
            pat = pat[p:];
            if pat.count == 0 { return true }
            while n <= name.count {
                if Match1(pat, name[n:]) { return true }
                n += 1;
            }
            return false;
        } else if r == #char "[" {
            if n == name.count { return false }
            s := name[n];
            n += 1;
            matched := false;
            invert := false;
            first := true;
            esc: s32 = 0;
            while p < pat.count {
                q, c, e := Char(pat, p);
                p = q;
                r = c;
                esc = e;
                if first && esc == 0 && r == #char "^" {
                    invert = true;
                    first = false;
                    continue;
                }
                first = false;
                if esc == 0 && r == #char "]" { break }
                q2, lo, hi := Range(pat, p - 1);
                p = q2;
                if lo <= s && s <= hi { matched = true }
            }
            if !(esc == 0 && r == #char "]") || invert == matched { return false }
        } else if r == #char "?" {
            if n == name.count { return false }
            n += 1;
        } else if r == #char "\\" {
            if n == name.count || p == pat.count { return false }
            c := pat[p];
            p += 1;
            if c != name[n] { return false }
            n += 1;
        } else {
            if n == name.count || r != name[n] { return false }
            n += 1;
        }
    }
    return n == name.count;
}

// A character or a range a-z.
Range :: (pat: []s32, p: s64) -> (next: s64, lo: s32, hi: s32) {
    q, lo, e0 := Char(pat, p);
    q1, hi, esc := Char(pat, q);
    if esc == 0 && hi == #char "-" {
        q2, hi2, e2 := Char(pat, q1);
        return q2, lo, hi2;
    }
    return q, lo, lo;
}

// The next character, maybe escaped by a backslash: (position after it,
// the character, 1 when escaped, -1 at the end).
Char :: (pat: []s32, p_in: s64) -> (next: s64, c: s32, esc: s32) {
    p := p_in;
    if p == pat.count { return p, 0, -1 }
    r := pat[p];
    p += 1;
    if p == pat.count || r != #char "\\" { return p, r, 0 }
    return p + 1, pat[p], 1;
}
