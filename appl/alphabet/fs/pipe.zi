// /fs/pipe [-1pP] fs cmd -> status: run a shell command for each file of a
// tree with the file's data on its standard input and $file its path; -p
// sets its mode, uid, mtime and length, -P its whole stat. With -1 one
// command reads every file, and the status is that command's.
#import "std/vec";
#import "std/option";
using Io :: #import "taijios_io";
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
Sh :: #import "shcmd";
Ns :: #import "taijios_namespace";
Run1 :: #import "fs/shellrun";
using Fs :: #import "fs/fsvalue";

Register :: (reg: s32) { Al.RegisterModule(reg, "pipe", "rxc-1-p-P", Run) }

Run :: (call: *Al.Call) -> s32 {
    if prod < 0 {
        p := Va.BlankProducer("pipe");
        p.run = RunPipe;
        prod = Va.AddProducer(p);
    }
    one := false;
    pflag: s64 = 0;
    for i: 0..Al.OptCount(call) - 1 {
        opt := Al.OptLetter(call, i);
        if opt == #char "1" { one = true }
        if opt == #char "p" { pflag = 1 }
        if opt == #char "P" { pflag = 2 }
    }
    if pflag != 0 && one {
        unused Io.WriteBytes(2, "fs: exec: cannot specify -p with -1\n");
        return -1;
    }
    v := Va.NewValue(#char "r", prod);
    Va.SetKids(v, call.args[0:1]);
    Va.SetCmd(v, Va.CmdOf(call.args[1]));
    Va.SetN0(v, ifx one then 1 else 0);
    Va.SetN1(v, pflag);
    return v;
}

#scope_file

prod: s32 = -1;

// popen: a shell reading a pipe; (its id, the end to write).
Popen :: (prelude: string, cmd: s32) -> (id: s32, input: s32) {
    ends: [2]s32;
    if Ns.Pipe(ends[:]) < 0 { return 0, -1 }
    launch := Run1.Start(Al.Join(prelude, Sh.CmdString(cmd)), ends[0]);
    unused Io.CloseFile(ends[0]);
    if launch.id == 0 {
        unused Io.CloseFile(ends[1]);
        return 0, -1;
    }
    return launch.id, ends[1];
}

RunPipe :: (v: s32) -> string {
    src := Va.Kid(v, 0);
    one := Va.N0(v) == 1;
    pflag := Va.N1(v);
    cmd := Va.CmdOf(v);
    id: s32 = 0;
    fd: s32 = -1;
    if one {
        id, fd = Popen("", cmd);
        if fd < 0 {
            first := FsNext(src, Start);
            if first.kind != Done { unused FsNext(src, Quit) }
            return "cannot make pipe";
        }
    }
    names: Vec(string);
    name := "";
    indent: s64 = 0;
    reply: s32 = Start;
    while true {
        item := FsNext(src, reply);
        if item.kind == Done { break }
        if item.kind != Entry {
            reply = Next;
            indent -= 1;
            if indent == 0 {
                unused FsNext(src, Next);
                break;
            }
            last := VecPop(names);
            name = last.value;
            continue;
        }
        d := item.dir;
        if IsDir(d) {
            reply = Down;
            VecPush(names, name);
            if indent > 0 && name.count > 0 && name[name.count - 1] != #char "/" { name = Al.Join(name, "/") }
            name = Al.Join(name, d.name);
            indent += 1;
            continue;
        }
        if !one {
            p := name;
            if p.count > 0 && p[p.count - 1] != #char "/" { p = Al.Join(p, "/") }
            prelude: Vec(u8);
            Run1.Assign1(*prelude, "file", Al.Join(p, d.name));
            if pflag != 0 { Run1.StatEnv(*prelude, d, pflag) }
            id, fd = Popen(BuilderFinish(prelude), cmd);
        }
        if fd < 0 {
            reply = Next;
            continue;
        }
        data := FsNext(src, Down);
        reply = Next;
        truncated := false;
        while data.kind == Data {
            n := Io.WriteBytes(fd, data.data);
            if n != data.data.count {
                truncated = true;
                break;
            }
            data = FsNext(src, Next);
        }
        if truncated {
            if one {
                unused FsNext(src, Quit);
                unused Io.CloseFile(fd);
                unused Run1.Wait(id);
                return "truncated write";
            }
            reply = Skip;
        }
        if !one {
            unused Io.CloseFile(fd);
            fd = -1;
            unused Run1.Wait(id);
        }
    }
    if one {
        unused Io.CloseFile(fd);
        return Run1.Wait(id);
    }
    return "";
}
