// /abc/type abc string [string...] -> abc: use types by their short names.
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
Value :: #import "abc/value";

Register :: (reg: s32) { Al.RegisterModule(reg, "type", "AAss*", Run) }

Run :: (call: *Al.Call) -> s32 {
    sx := Value.Alphabet(call.args[0]);
    for call.args[1:] {
        e := Al.ImportType(sx, Va.ValueText(it));
        if e.count > 0 {
            out: Vec(u8);
            BuilderPrint(*out, "type: %: %", Va.ValueText(it), e);
            Va.Report(call.errc, BuilderFinish(out));
            return -1;
        }
    }
    return Va.Dup(call.args[0]);
}
