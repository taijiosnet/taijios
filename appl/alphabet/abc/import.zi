// /abc/import abc string [string...] -> abc: use modules by their short names.
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
Value :: #import "abc/value";

Register :: (reg: s32) { Al.RegisterModule(reg, "import", "AAss*", Run) }

Run :: (call: *Al.Call) -> s32 {
    sx := Value.Alphabet(call.args[0]);
    for call.args[1:] {
        e := Al.ImportModule(sx, Va.ValueText(it));
        if e.count > 0 {
            out: Vec(u8);
            BuilderPrint(*out, "import: %: %", Va.ValueText(it), e);
            Va.Report(call.errc, BuilderFinish(out));
            return -1;
        }
    }
    return Va.Dup(call.args[0]);
}
