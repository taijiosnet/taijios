// /create fd string -> status: write the fd to a new file.
using Io :: #import "taijios_io";
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
Ty :: #import "alpha_types";
Print :: #import "main/print";

Register :: () { Al.RegisterModule(-1, "create", "rfs", Run) }

Run :: (call: *Al.Call) -> s32 {
    path := Va.ValueText(call.args[1]);
    h := Io.CreateFile(path, 1, 0x1B6);
    if h < 0 {
        Va.Report(call.errc, Va.WithError(Al.Join("error: cannot create ", Ty.Q(path))));
        return -1;
    }
    return Print.Copier(call.args[0], h);
}
