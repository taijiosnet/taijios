// /env string -> string: the value of an environment variable that holds
// exactly one word. (The Dis module had no source left; this follows its
// code.)
#import "std/byte_text_linux";
using Io :: #import "taijios_io";
Al :: #import "alpha_eval";
Va :: #import "alpha_values";
Ty :: #import "alpha_types";
Stat :: #import "taijios_stat";
Quote :: #import "taijios_quote";

Register :: () { Al.RegisterModule(-1, "env", "ss", Run) }

Run :: (call: *Al.Call) -> s32 {
    name := Va.ValueText(call.args[0]);
    for name {
        if it == #char "/" { return Fail(call, Message("env: invalid environment variable name ", name, "")) }
    }
    path := Al.Join("/env/", name);
    h := Io.OpenFile(path, 0);
    if h < 0 { return Fail(call, Message("env: environment variable ", name, " not set")) }
    record: [Stat.BufferSize]u8;
    size := Io.FstatPacked(h, record[:]);
    if size <= 0 {
        message := Va.WithError(Al.Join("env: cannot stat ", Ty.Q(Io.FdPath(h))));
        unused Io.CloseFile(h);
        return Fail(call, message);
    }
    info := Stat.Decode(record[:size]);
    // one read of as many bytes as the file's length
    buffer: Vec(u8);
    unused VecResize(buffer, info.length);
    n := Io.ReadBytes(h, buffer[:]);
    if n < 0 {
        message := Va.WithError(Al.Join("env: error reading ", Ty.Q(Io.FdPath(h))));
        unused Io.CloseFile(h);
        return Fail(call, message);
    }
    unused Io.CloseFile(h);
    words: Vec(Text);
    Quote.Unquoted(TextFromBytes(buffer[:n]), *words);
    if words.count == 0 { return Fail(call, Message("env: environment variable ", name, " not set")) }
    if words.count > 1 { return Fail(call, Message("env: environment variable ", name, " has more than one element")) }
    return Va.MkString(TextDetach(TextCopy(TextView(words[0]))));
}

#scope_file

Message :: (before: string, name: string, after: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, before);
    Ty.AppendQ(*out, name);
    BuilderAppend(out, after);
    return BuilderFinish(out);
}

Fail :: (call: *Al.Call, message: string) -> s32 {
    Va.Report(call.errc, message);
    return -1;
}
