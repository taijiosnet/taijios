// /par [status...] -> status: run all the statuses; the result is the last
// failure among them, in the order they were given. They run one after
// another, in that order.
Al :: #import "alpha_eval";
Va :: #import "alpha_values";

Register :: () { Al.RegisterModule(-1, "par", "rr*", Run) }

Run :: (call: *Al.Call) -> s32 {
    if prod < 0 {
        p := Va.BlankProducer("par");
        p.run = RunPar;
        p.free = Free;
        prod = Va.AddProducer(p);
    }
    v := Va.NewValue(#char "r", prod);
    Va.SetKids(v, call.args[:]);
    return v;
}

#scope_file

prod: s32 = -1;

RunPar :: (v: s32) -> string {
    status := "";
    for i: 0..Va.KidCount(v) - 1 {
        e := Va.RunStatus(Va.Kid(v, i));
        if e.count > 0 { status = e }
    }
    return status;
}

Free :: (v: s32, used: bool) -> s32 {
    if !used { for i: 0..Va.KidCount(v) - 1 { Va.Free(Va.Kid(v, i), false) } }
    return 0;
}
