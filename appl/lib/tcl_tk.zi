// Optional Tk command model, following Inferno libtk and tcl_tk.b. See ../../NOTICE.
#import "std/vec"
#import "std/number_text"
using Tcl :: #import "tcl"
using T :: #import "tcl_types"
using UTF :: #import "tcl_tk_text"
using View :: #import "tcl_tk_view"
using Scale :: #import "tcl_tk_scale"
using Check :: #import "tcl_tk_check"
using Scroll :: #import "tcl_tk_scrollbar"

MAX_WIDGETS :: 32;
MAX_ENTRY_BYTES :: 16384;
LABEL :: 0;
BUTTON :: 1;
FRAME :: 2;
ENTRY :: 3;
TEXT :: 4;
SCALE :: 5;
PANEL :: 6;
CHECKBUTTON :: 7;
SCROLLBAR :: 8;
MAX_PANEL_BYTES :: 16777216;
CHAR_WIDTH :: 12;
ENTRY_INSET :: 8;
Box :: struct { x: s32; y: s32; w: s32; h: s32; }
Packing :: struct {
    side: s32;
    padx: s32;
    pady: s32;
    fill: s32;
    expand: s32;
    anchor_x: s32;
    anchor_y: s32;
}
Panel :: struct {
    pixels: Vec(u8);
    width: s32;
    height: s32;
    border: s32;
}
Widget :: struct {
    name: Text;
    text: Text;
    command: Text;
    box: Box;
    kind: s64;
    parent: s64;
    cursor: s64;
    view: View.State;
    scale: Scale.State;
    panel: Panel;
    check: Check.State;
    scroll: Scroll.State;
    text_height: s32;
    last_scroll: Scroll.State;
    sent_scroll: bool;
    disabled: bool;
    requested: Box;
    order: s32;
    pack: Packing;
}

// One root per app, matching the current Taiji surface lifetime.
widgets: Vec(Widget);
attached: bool;
closed: bool;
pressed: s64 = -1;
pressed_range: s64 = -1;
focused: s64 = -1;
sequence: s32;
drag_start: s32;
drag_value: s64;

Attach :: (interpreter: *Tcl.Interpreter) -> bool {
    if attached { return false }
    commands := interpreter.extensions.count;
    prefixes := interpreter.prefixes.count;
    attached = Tcl.RegisterCommand(interpreter, "label", Create, LABEL) &&
               Tcl.RegisterCommand(interpreter, "button", Create, BUTTON) &&
               Tcl.RegisterCommand(interpreter, "frame", Create, FRAME) &&
               Tcl.RegisterCommand(interpreter, "entry", Create, ENTRY) &&
               Tcl.RegisterCommand(interpreter, "text", Create, TEXT) &&
               Tcl.RegisterCommand(interpreter, "scale", Create, SCALE) &&
               Tcl.RegisterCommand(interpreter, "panel", Create, PANEL) &&
               Tcl.RegisterCommand(interpreter, "checkbutton", Create, CHECKBUTTON) &&
               Tcl.RegisterCommand(interpreter, "scrollbar", Create, SCROLLBAR) &&
               Tcl.RegisterCommand(interpreter, "variable", VariableCommand) &&
               Tcl.RegisterPrefix(interpreter, "update", Update) &&
               Tcl.RegisterCommand(interpreter, "pack", Pack) &&
               Tcl.RegisterCommand(interpreter, "focus", Focus) &&
               Tcl.RegisterCommand(interpreter, "bind", Bind) &&
               Tcl.RegisterCommand(interpreter, "destroy", Destroy) &&
               Tcl.RegisterPrefix(interpreter, ".", WidgetCommand);
    if !attached {
        unused VecResize(interpreter.extensions, commands);
        unused VecResize(interpreter.prefixes, prefixes);
    }
    return attached;
}

Find :: (name: string) -> s64 {
    for * widgets { if it.name.bytes.count > 0 && TextView(it.name) == name { return it_index } }
    return -1;
}

ParentEnd :: (path: string) -> s64 {
    if path.count < 2 || path[0] != 46 || path[path.count-1] == 46 { return -1 }
    parent_end: s64;
    for 1..path.count-1 {
        if path[it] == 46 {
            if it == parent_end + 1 { return -1 }
            parent_end = it;
        }
    }
    return parent_end;
}

SetError :: (result: *Result, message: string) {
    result.code = .Error;
    unused BuilderAppend(result.value.bytes, message);
}

Configure :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    if args.count % 2 != 0 { SetError(result, "expected option and value pairs"); return false }
    if widget.kind == SCALE { return ConfigureScale(widget, args, result) }
    if widget.kind == PANEL { return ConfigurePanel(widget, args, result) }
    if widget.kind == TEXT || widget.kind == SCROLLBAR { return ConfigureScroll(widget, args, result) }
    button := widget.kind == BUTTON || widget.kind == CHECKBUTTON;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        if option == "-text" && (widget.kind == LABEL || button) { continue }
        if option == "-command" && button { continue }
        if option == "-state" && button {
            value := TextView(args[2*i+1]);
            if value == "normal" || value == "disabled" { continue }
        }
        if widget.kind == CHECKBUTTON && CheckOption(option) { continue }
        if option == "-bg" && widget.kind == ENTRY && TextView(args[2*i+1]) == "white" { continue }
        SetError(result, "unsupported widget option or value");
        return false;
    }
    if widget.kind == CHECKBUTTON && !ConfigureCheck(widget, args, result) { return false }
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        if option == "-state" { widget.disabled = TextView(args[2*i+1]) == "disabled"; continue }
        if option == "-bg" || CheckOption(option) { continue }
        value: Text = TextCopy(TextView(args[2*i+1]));
        if option == "-text" { VecSwap(widget.text.bytes, value.bytes) }
        else { VecSwap(widget.command.bytes, value.bytes) }
    }
    return true;
}

Create :: (kind: s64, args: []Text, result: *Result) {
    if closed || args.count == 0 { SetError(result, "expected a widget path in an open root"); return }
    path := TextView(args[0]);
    parent_end := ParentEnd(path);
    if parent_end < 0 || Find(path) >= 0 { SetError(result, "invalid or duplicate widget path"); return }
    parent: s64 = -1;
    if parent_end > 0 {
        parent = Find(path[:parent_end]);
        if parent < 0 || widgets[parent].kind != FRAME { SetError(result, "expected a frame parent"); return }
    }
    widget := Widget.{name = TextCopy(path), kind = kind, parent = parent};
    if kind == SCALE { widget.scale = Scale.Default() }
    if kind == CHECKBUTTON {
        on: Text = TextCopy("1");
        off: Text = TextCopy("0");
        VecSwap(widget.check.on.bytes, on.bytes);
        VecSwap(widget.check.off.bytes, off.bytes);
    }
    if !Configure(*widget, args[1:], result) { return }
    if kind == SCALE && widget.scale.big_increment == 0 {
        widget.scale.big_increment = ((widget.scale.last - widget.scale.first) / Scale.UNIT / 10) * Scale.UNIT;
    }
    slot := widgets.count;
    for * widgets { if it.name.bytes.count == 0 { slot = it_index; break } }
    if slot == widgets.count {
        if slot == MAX_WIDGETS { SetError(result, "widget limit exceeded"); return }
        if !VecResize(widgets, slot + 1) { SetError(result, "could not allocate widget"); return }
    }
    saved := *widgets[slot];
    saved.kind = widget.kind;
    saved.parent = widget.parent;
    saved.cursor = 0;
    saved.disabled = widget.disabled;
    saved.scale = widget.scale;
    saved.scroll = widget.scroll;
    saved.text_height = widget.text_height;
    saved.sent_scroll = false;
    saved.check.selected = widget.check.selected;
    VecSwap(saved.check.variable.bytes, widget.check.variable.bytes);
    VecSwap(saved.check.on.bytes, widget.check.on.bytes);
    VecSwap(saved.check.off.bytes, widget.check.off.bytes);
    saved.panel.border = widget.panel.border;
    saved.panel.width = 0;
    saved.panel.height = 0;
    View.Reset(*saved.view);
    saved.order = 0;
    saved.box = .{};
    saved.pack = .{padx = 8, pady = 5};
    VecSwap(saved.name.bytes, widget.name.bytes);
    VecSwap(saved.text.bytes, widget.text.bytes);
    VecSwap(saved.command.bytes, widget.command.bytes);
    unused BuilderAppend(result.value.bytes, path);
}

Pack :: (_: s64, args: []Text, result: *Result) {
    if args.count == 0 { SetError(result, "expected pack path ?path ...? ?options?"); return }
    count: s64;
    options := Packing.{side = -1, padx = -1, pady = -1, fill = -1, expand = -1, anchor_x = -2, anchor_y = -2};
    while count < args.count && ParentEnd(TextView(args[count])) >= 0 {
        if Find(TextView(args[count])) < 0 { SetError(result, "cannot pack unknown widget"); return }
        count += 1;
    }
    if count == 0 || (args.count - count) % 2 != 0 { SetError(result, "invalid pack arguments"); return }
    for i: 0..(args.count-count)/2-1 {
        option := TextView(args[count+2*i]);
        value := TextView(args[count+2*i+1]);
        if option == "-side" {
            if value == "top" { options.side = 0 }
            else if value == "left" { options.side = 1 }
            else if value == "bottom" { options.side = 2 }
            else if value == "right" { options.side = 3 }
            else { SetError(result, "unknown pack side"); return }
        } else if option == "-padx" || option == "-pady" {
            amount, ok := ParseInteger(value);
            if !ok || amount < 0 || amount > 512 { SetError(result, "invalid pack padding"); return }
            if option == "-padx" { options.padx = cast(s32)amount } else { options.pady = cast(s32)amount }
        } else if option == "-fill" {
            if value == "none" { options.fill = 0 }
            else if value == "x" { options.fill = 1 }
            else if value == "y" { options.fill = 2 }
            else if value == "both" { options.fill = 3 }
            else { SetError(result, "unknown pack fill"); return }
        } else if option == "-anchor" {
            if value == "center" { options.anchor_x = 0; options.anchor_y = 0 }
            else if value == "w" || value == "e" || value == "n" || value == "s" ||
                    value == "nw" || value == "ne" || value == "sw" || value == "se" {
                options.anchor_x = ifx value[value.count-1] == 119 then -1 else ifx value[value.count-1] == 101 then 1 else 0;
                options.anchor_y = ifx value[0] == 110 then -1 else ifx value[0] == 115 then 1 else 0;
            } else { SetError(result, "unknown pack anchor"); return }
        } else if option == "-expand" {
            if value == "1" { options.expand = 1 }
            else if value == "0" { options.expand = 0 }
            else { SetError(result, "expected 0 or 1 for pack -expand"); return }
        } else { SetError(result, "unsupported pack option"); return }
    }
    for 0..count-1 {
        widget := *widgets[Find(TextView(args[it]))];
        sequence += 1;
        widget.order = sequence;
        if options.side >= 0 { widget.pack.side = options.side }
        if options.padx >= 0 { widget.pack.padx = options.padx }
        if options.pady >= 0 { widget.pack.pady = options.pady }
        if options.fill >= 0 { widget.pack.fill = options.fill }
        if options.expand >= 0 { widget.pack.expand = options.expand }
        if options.anchor_x >= -1 { widget.pack.anchor_x = options.anchor_x; widget.pack.anchor_y = options.anchor_y }
    }
}

Destroy :: (_: s64, args: []Text, result: *Result) {
    if args.count == 0 { SetError(result, "expected destroy path ?path ...?"); return }
    for 0..args.count-1 {
        path := TextView(args[it]);
        if path == "." { closed = true; focused = -1; pressed = -1; return }
        index := Find(path);
        if index < 0 { continue }
        for * widgets {
            if it.name.bytes.count == 0 { continue }
            ancestor := it_index;
            while ancestor >= 0 && ancestor != index { ancestor = widgets[ancestor].parent }
            if ancestor != index { continue }
            unused VecResize(it.name.bytes, 0);
            unused VecResize(it.text.bytes, 0);
            unused VecResize(it.command.bytes, 0);
            unused VecResize(it.check.variable.bytes, 0);
            unused VecResize(it.check.on.bytes, 0);
            unused VecResize(it.check.off.bytes, 0);
            unused VecResize(it.view.tags, 0);
            unused VecResize(it.panel.pixels, 0);
            View.Reset(*it.view);
            it.order = 0;
            it.box = .{};
            if pressed == it_index { pressed = -1 }
            if focused == it_index { focused = -1 }
        }
    }
}

WidgetCommand :: (_: s64, name: string, args: []Text, result: *Result, script: *Text) {
    index := Find(name);
    if index < 0 || closed { SetError(result, "unknown widget path"); return }
    if args.count == 0 { SetError(result, "expected widget subcommand"); return }
    widget := *widgets[index];
    subcommand := TextView(args[0]);
    if subcommand == "configure" && args.count >= 3 {
        if Configure(widget, args[1:], result) && widget.kind == TEXT { TextScroll(widget, script) }
        return;
    }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        button := widget.kind == BUTTON || widget.kind == CHECKBUTTON;
        if option == "-text" && (widget.kind == LABEL || button) {
            unused BuilderAppend(result.value.bytes, TextView(widget.text)); return;
        }
        if option == "-bg" && widget.kind == ENTRY {
            unused BuilderAppend(result.value.bytes, "white"); return;
        }
        if option == "-command" && button {
            unused BuilderAppend(result.value.bytes, TextView(widget.command)); return;
        }
        if option == "-state" && button {
            unused BuilderAppend(result.value.bytes, ifx widget.disabled then "disabled" else "normal"); return;
        }
    }
    if subcommand == "invoke" && args.count == 1 && widget.kind == BUTTON {
        if !widget.disabled { unused BuilderAppend(script.bytes, TextView(widget.command)) }
        return;
    }
    if widget.kind == SCALE { ScaleCommand(widget, args, result); return }
    if widget.kind == PANEL { PanelCommand(widget, args, result); return }
    if widget.kind == CHECKBUTTON { CheckCommand(widget, args, result, script); return }
    if widget.kind == SCROLLBAR { ScrollCommand(widget, args, result); return }
    if widget.kind == ENTRY { EntryCommand(widget, args, result); return }
    if widget.kind == TEXT {
        TextCommand(widget, args, result);
        if result.code == .OK && result.value.bytes.count == 0 { TextScroll(widget, script) }
        return;
    }
    SetError(result, "unsupported widget subcommand or arguments");
}

Focus :: (_: s64, args: []Text, result: *Result) {
    if args.count == 0 {
        if focused >= 0 { unused BuilderAppend(result.value.bytes, TextView(widgets[focused].name)) }
        return;
    }
    if args.count != 1 { SetError(result, "expected focus ?widget?"); return }
    index := Find(TextView(args[0]));
    if closed || index < 0 || (widgets[index].kind != ENTRY && widgets[index].kind != TEXT && widgets[index].kind != SCALE) {
        SetError(result, "expected a focusable widget path"); return;
    }
    focused = index;
}

Bind :: (_: s64, args: []Text, result: *Result) {
    if args.count != 3 { SetError(result, "expected bind entry <Return> script"); return }
    index := Find(TextView(args[0]));
    event := TextView(args[1]);
    if closed || index < 0 || widgets[index].kind != ENTRY || (event != "<Return>" && event != "<Key-\n>") {
        SetError(result, "only the entry Return binding is supported"); return;
    }
    command: Text = TextCopy(TextView(args[2]));
    VecSwap(widgets[index].command.bytes, command.bytes);
}

EntryOffset :: (widget: *Widget, index: string) -> (offset: s64, ok: bool) {
    if index == "insert" { return widget.cursor, true }
    if index == "end" { return widget.text.bytes.count, true }
    number, ok := ParseInteger(index);
    if !ok || number < 0 { return 0, false }
    offset, good := UTF.Offset(TextView(widget.text), number);
    return offset, good;
}

Insert :: (widget: *Widget, at: s64, value: string) -> bool {
    if value.count > MAX_ENTRY_BYTES - widget.text.bytes.count || !UTF.SingleLine(value) { return false }
    if value.count == 0 { return true }
    after: Text;
    {
        before := TextView(widget.text);
        if !BuilderAppend(after.bytes, before[:at]) || !BuilderAppend(after.bytes, value) ||
           !BuilderAppend(after.bytes, before[at:]) { return false }
    }
    VecSwap(widget.text.bytes, after.bytes);
    if at <= widget.cursor { widget.cursor += value.count }
    return true;
}

Delete :: (widget: *Widget, first: s64, last: s64) {
    if first >= last { return }
    length := widget.text.bytes.count;
    {
        bytes := VecSlice(widget.text.bytes, 0, length);
        for i: last..length-1 { bytes[first+i-last] = bytes[i] }
    }
    unused VecResize(widget.text.bytes, length - (last - first));
    if last <= widget.cursor { widget.cursor -= last-first }
    else if first < widget.cursor { widget.cursor = first }
}

EntryCommand :: (widget: *Widget, args: []Text, result: *Result) {
    command := TextView(args[0]);
    if command == "get" && args.count == 1 {
        unused BuilderAppend(result.value.bytes, TextView(widget.text)); return;
    }
    valid := ((command == "index" || command == "icursor") && args.count == 2) ||
             (command == "insert" && args.count == 3) || (command == "delete" && (args.count == 2 || args.count == 3));
    if !valid { SetError(result, "unsupported entry subcommand or arguments"); return }
    at, ok := EntryOffset(widget, TextView(args[1]));
    if !ok { SetError(result, "bad entry index"); return }
    if command == "index" {
        value := T.Integer(UTF.Count(TextView(widget.text)[:at]));
        VecSwap(result.value.bytes, value.value.bytes);
    } else if command == "icursor" { widget.cursor = at }
    else if command == "insert" {
        if !Insert(widget, at, TextView(args[2])) { SetError(result, "cannot insert single-line UTF-8 text") }
    } else {
        last := UTF.Next(TextView(widget.text), at);
        if args.count == 3 {
            end, good := EntryOffset(widget, TextView(args[2]));
            if !good { SetError(result, "bad entry index"); return }
            last = end;
        }
        Delete(widget, at, last);
    }
}

TextLayout :: (widget: *Widget) {
    columns := (widget.box.w - 2 * View.INSET) / CHAR_WIDTH;
    height := (widget.box.h - 2 * View.INSET) / View.ROW_HEIGHT;
    if widget.box.w == 0 { columns = 38 }
    if widget.box.h == 0 { height = ifx widget.text_height > 0 then (widget.text_height - 2*View.INSET)/View.ROW_HEIGHT else 14 }
    View.Reflow(*widget.view, TextView(widget.text), Maximum(columns, 1), Maximum(height, 1));
}

TextOffset :: (widget: *Widget, name: string) -> (at: s64, ok: bool) {
    source := TextView(widget.text);
    at: s64;
    if name.count > 0 && name[0] == 64 {
        for i: 1..name.count-1 {
            if name[i] != 44 { continue }
            x, valid_x := ParseInteger(name[1:i]);
            y, valid_y := ParseInteger(name[i+1:]);
            if !valid_x || !valid_y || x < -2147483640 || x > 2147483647 || y < -2147483640 || y > 2147483647 { break }
            TextLayout(widget);
            at, _ = View.Point(*widget.view, source, cast(s32)x - View.INSET, cast(s32)y - View.INSET, CHAR_WIDTH);
            return at, true;
        }
        return 0, false;
    }
    end := name.count;
    for i: 1..name.count-1 {
        if name[i] == 43 || name[i] == 45 { end = i; break }
    }
    base := name[:end];
    if base == "end" { at = source.count }
    else {
        dot: s64;
        while dot < base.count && base[dot] != 46 { dot += 1 }
        if dot >= base.count { return 0, false }
        line, valid_line := ParseInteger(base[:dot]);
        column, valid_column := ParseInteger(base[dot+1:]);
        if !valid_line || !valid_column || line < 1 || column < 0 { return 0, false }
        at = View.Offset(source, line, column);
    }
    if end == name.count { return at, true }
    if name.count-end < 3 || name[name.count-1] != 99 { return 0, false }
    count, valid := ParseInteger(name[end+1:name.count-1]);
    if !valid || count < 0 { return 0, false }
    if name[end] == 43 {
        while count > 0 && at < source.count { at = UTF.Next(source, at); count -= 1 }
    } else {
        while count > 0 && at > 0 { at = UTF.Previous(source, at); count -= 1 }
    }
    return at, true;
}

TextSearch :: (widget: *Widget, args: []Text, result: *Result) {
    arg: s64 = 1;
    backwards: bool;
    while arg < args.count {
        option := TextView(args[arg]);
        if option.count == 0 || option[0] != 45 { break }
        arg += 1;
        if option == "--" { break }
        if option == "-backwards" { backwards = true }
        else if option == "-forwards" { backwards = false }
        else if option != "-exact" { SetError(result, "unsupported text search option"); return }
    }
    if args.count-arg < 2 || args.count-arg > 3 {
        SetError(result, "expected search ?-forwards|-backwards? ?-exact? ?--? pattern index ?stopIndex?"); return;
    }
    source := TextView(widget.text);
    pattern := TextView(args[arg]);
    start, valid := TextOffset(widget, TextView(args[arg+1]));
    if !valid { SetError(result, "bad text index"); return }
    stop := ifx backwards then cast(s64)0 else source.count;
    wrap := args.count-arg == 2;
    if !wrap {
        limit, ok := TextOffset(widget, TextView(args[arg+2]));
        if !ok { SetError(result, "bad text stop index"); return }
        if (backwards && limit >= start) || (!backwards && limit <= start) { return }
        stop = ifx backwards then UTF.Next(source, limit) else limit;
    }
    found := View.Match(source, pattern, start, stop, backwards);
    if found < 0 && wrap {
        if backwards { found = View.Match(source, pattern, source.count, start, true) }
        else { found = View.Match(source, pattern, 0, start, false) }
    }
    if found >= 0 { View.Index(source, found, *result.value.bytes) }
}

TextTag :: (widget: *Widget, args: []Text, result: *Result) {
    if args.count < 3 { SetError(result, "expected text tag operation and name"); return }
    action := TextView(args[1]);
    name := TextView(args[2]);
    view := *widget.view;
    if action == "add" && args.count == 5 {
        first, valid_first := TextOffset(widget, TextView(args[3]));
        last, valid_last := TextOffset(widget, TextView(args[4]));
        if !valid_first || !valid_last { SetError(result, "bad text tag index"); return }
        tag := View.EnsureTag(view, name);
        if tag < 0 || !View.AddRange(view, tag, first, last) { SetError(result, "could not add text tag range") }
        return;
    }
    if action == "remove" && args.count == 5 && TextView(args[3]) == "1.0" && TextView(args[4]) == "end" {
        View.ClearRanges(view, View.FindTag(view, name));
        return;
    }
    underline := action == "configure" && args.count == 5 && TextView(args[3]) == "-underline";
    bind := action == "bind" && args.count == 5 && TextView(args[3]) == "<ButtonRelease-1>";
    if underline || bind {
        value := TextView(args[4]);
        if underline && value != "0" && value != "1" { SetError(result, "expected 0 or 1 for tag -underline"); return }
        tag := View.EnsureTag(view, name);
        if tag < 0 { SetError(result, "could not add text tag"); return }
        if underline { view.tags[tag].underline = value == "1" }
        else {
            script: Text = TextCopy(value);
            VecSwap(view.tags[tag].release.bytes, script.bytes);
        }
        return;
    }
    SetError(result, "unsupported text tag operation or arguments");
}

AppendText :: (widget: *Widget, value: string) -> bool {
    if value.count == 0 { return true }
    if !BuilderAppend(widget.text.bytes, value) { return false }
    widget.view.appended = true;
    return true;
}

TextCommand :: (widget: *Widget, args: []Text, result: *Result) {
    command := TextView(args[0]);
    if command == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-yscrollcommand" { unused BuilderAppend(result.value.bytes, TextView(widget.command)); return }
        if option == "-height" {
            digits: [24]u8;
            height := ifx widget.text_height > 0 then widget.text_height else 150;
            unused BuilderAppend(result.value.bytes, FormatInteger(height, digits[:]));
            return;
        }
    }
    if command == "search" { TextSearch(widget, args, result); return }
    if command == "tag" { TextTag(widget, args, result); return }
    if (command == "index" || command == "see") && args.count == 2 {
        at, valid := TextOffset(widget, TextView(args[1]));
        if !valid { SetError(result, "bad text index"); return }
        if command == "index" { View.Index(TextView(widget.text), at, *result.value.bytes) }
        else { TextLayout(widget); View.See(*widget.view, at) }
        return;
    }
    if command == "yview" {
        TextLayout(widget);
        if args.count == 1 { View.Position(*widget.view, *result.value.bytes); return }
        if args.count == 3 && TextView(args[1]) == "moveto" && View.Moveto(*widget.view, TextView(args[2])) { return }
        if args.count == 4 && TextView(args[1]) == "scroll" {
            amount, ok := ParseInteger(TextView(args[2]));
            scale := TextView(args[3]);
            if ok && (scale == "units" || scale == "unit" || scale == "pages" || scale == "page") {
                if scale == "page" || scale == "pages" { amount *= View.PageSize(*widget.view) }
                View.Move(*widget.view, amount);
                return;
            }
        }
        SetError(result, "expected yview ?moveto fraction|scroll count units|pages?"); return;
    }
    if command == "get" && (args.count == 2 || args.count == 3) {
        source := TextView(widget.text);
        first, valid_first := TextOffset(widget, TextView(args[1]));
        last := UTF.Next(source, first);
        if !valid_first { SetError(result, "bad text index"); return }
        if args.count == 3 {
            end, valid := TextOffset(widget, TextView(args[2]));
            if !valid { SetError(result, "bad text index"); return }
            last = end;
        }
        if first < last { unused BuilderAppend(result.value.bytes, source[first:last]) }
        return;
    }
    if command == "delete" && args.count == 3 && TextView(args[1]) == "1.0" && TextView(args[2]) == "end" {
        unused VecResize(widget.text.bytes, 0);
        View.Reset(*widget.view);
        return;
    }
    if command == "insert" && args.count == 3 && TextView(args[1]) == "end" {
        if !AppendText(widget, TextView(args[2])) { SetError(result, "could not grow text widget") }
        return;
    }
    SetError(result, "unsupported text subcommand or arguments");
}

EntryKey :: enum s32 { Return; Backspace; Delete; Left; Right; Home; End; Up; Down; PageUp; PageDown; }

KeyDown :: (key: EntryKey) -> Text {
    if focused < 0 { return TextCopy("") }
    entry := *widgets[focused];
    if entry.kind == SCALE {
        if key == .Up || key == .Left { return ScaleInput(entry, Scale.Step(*entry.scale, -1)) }
        if key == .Down || key == .Right { return ScaleInput(entry, Scale.Step(*entry.scale, 1)) }
        return .{};
    }
    if entry.kind == TEXT {
        if key == .Up { View.Move(*entry.view, -1) }
        if key == .Down { View.Move(*entry.view, 1) }
        if key == .PageUp { View.Move(*entry.view, -View.PageSize(*entry.view)) }
        if key == .PageDown { View.Move(*entry.view, View.PageSize(*entry.view)) }
        if key == .Home { entry.view.top = 0 }
        if key == .End { View.Move(*entry.view, entry.view.rows.count) }
        return TextCopy("");
    }
    if key == .Return { return TextCopy(TextView(entry.command)) }
    if key == .Left { entry.cursor = UTF.Previous(TextView(entry.text), entry.cursor) }
    if key == .Right { entry.cursor = UTF.Next(TextView(entry.text), entry.cursor) }
    if key == .Home { entry.cursor = 0 }
    if key == .End { entry.cursor = entry.text.bytes.count }
    if key == .Backspace {
        at := UTF.Previous(TextView(entry.text), entry.cursor);
        Delete(entry, at, entry.cursor);
    }
    if key == .Delete {
        at := UTF.Next(TextView(entry.text), entry.cursor);
        Delete(entry, entry.cursor, at);
    }
    return TextCopy("");
}

TextInput :: (value: string) {
    if focused >= 0 && widgets[focused].kind == ENTRY {
        unused Insert(*widgets[focused], widgets[focused].cursor, value);
    }
}

Minimum :: (a: s32, b: s32) -> s32 { return ifx a < b then a else b }
Maximum :: (a: s32, b: s32) -> s32 { return ifx a > b then a else b }
NonNegative :: (x: s32) -> s32 { return ifx x > 0 then x else 0 }

NextChild :: (parent: s64, after: s32) -> s64 {
    index: s64 = -1;
    for * widgets {
        if it.parent == parent && it.order > after && (index < 0 || it.order < widgets[index].order) { index = it_index }
    }
    return index;
}

Horizontal :: (pack: Packing) -> bool { return pack.side == 1 || pack.side == 3 }

Measure :: (parent: s64) -> Box {
    used: Box;
    required: Box;
    index := NextChild(parent, 0);
    while index >= 0 {
        widget := *widgets[index];
        requested: Box;
        if widget.kind == FRAME { requested = Measure(index) }
        else if widget.kind == SCALE {
            length := widget.scale.length + 2 * Scale.INSET;
            minor: s32 = Scale.MINOR;
            if widget.scale.show_value { minor += ifx widget.scale.horizontal then Scale.VALUE_HEIGHT else 120 }
            requested = ifx widget.scale.horizontal then Box.{w = length, h = minor} else Box.{w = minor, h = length};
        }
        else if widget.kind == PANEL { requested = .{w = widget.panel.width + 2*widget.panel.border, h = widget.panel.height + 2*widget.panel.border} }
        else if widget.kind == ENTRY { requested = .{w = 168, h = 30} }
        else if widget.kind == TEXT { requested = .{w = 280, h = ifx widget.text_height > 0 then widget.text_height else 150} }
        else if widget.kind == SCROLLBAR {
            requested = ifx widget.scroll.horizontal then Box.{w = Scroll.LENGTH, h = Scroll.WIDTH}
                        else Box.{w = Scroll.WIDTH, h = Scroll.LENGTH};
        }
        else {
            length := UTF.Count(TextView(widget.text), 512);
            requested = .{w = length * CHAR_WIDTH + 30, h = ifx widget.kind == BUTTON then 36 else 28};
            if widget.kind == CHECKBUTTON { requested.w += 10 }
        }
        widget.requested = requested;
        w := requested.w + widget.pack.padx * 2;
        h := requested.h + widget.pack.pady * 2;
        if Horizontal(widget.pack) {
            used.w += w;
            required.h = Maximum(required.h, used.h + h);
        } else {
            used.h += h;
            required.w = Maximum(required.w, used.w + w);
        }
        index = NextChild(parent, widget.order);
    }
    return .{w = Maximum(used.w, required.w), h = Maximum(used.h, required.h)};
}

// Reserve room for later siblings before sharing the cavity among expanders.
Expansion :: (index: s64, cavity: s32, horizontal: bool) -> s32 {
    available := cavity;
    extra := cavity;
    expanders: s32;
    while index >= 0 {
        widget := *widgets[index];
        needed := ifx horizontal then widget.requested.w + widget.pack.padx * 2 else widget.requested.h + widget.pack.pady * 2;
        if Horizontal(widget.pack) == horizontal {
            available -= needed;
            expanders += widget.pack.expand;
        } else if expanders > 0 { extra = Minimum(extra, (available - needed) / expanders) }
        index = NextChild(widget.parent, widget.order);
    }
    if expanders == 0 { return 0 }
    return NonNegative(Minimum(extra, available / expanders));
}

Place :: (parent: s64, cavity: Box) {
    index := NextChild(parent, 0);
    while index >= 0 {
        widget := *widgets[index];
        pack := widget.pack;
        available := cavity;
        if Horizontal(pack) {
            parcel := widget.requested.w + pack.padx * 2;
            if pack.expand > 0 { parcel += Expansion(index, cavity.w, true) }
            available.w = Minimum(cavity.w, parcel);
            if pack.side == 1 { cavity.x += available.w }
            else { available.x += cavity.w - available.w }
            cavity.w -= available.w;
        } else {
            parcel := widget.requested.h + pack.pady * 2;
            if pack.expand > 0 { parcel += Expansion(index, cavity.h, false) }
            available.h = Minimum(cavity.h, parcel);
            if pack.side == 0 { cavity.y += available.h }
            else { available.y += cavity.h - available.h }
            cavity.h -= available.h;
        }
        inner_w := NonNegative(available.w - pack.padx * 2);
        inner_h := NonNegative(available.h - pack.pady * 2);
        w := ifx (pack.fill & 1) != 0 then inner_w else Minimum(widget.requested.w, inner_w);
        h := ifx (pack.fill & 2) != 0 then inner_h else Minimum(widget.requested.h, inner_h);
        x := available.x + pack.padx + (inner_w-w)*(1+pack.anchor_x)/2;
        y := available.y + pack.pady + (inner_h-h)*(1+pack.anchor_y)/2;
        // Keep cramped parcels centered even when padding consumes the cavity.
        if inner_w == 0 { x = available.x + available.w/2 }
        if inner_h == 0 { y = available.y + available.h/2 }
        widget.box = .{x = x, y = y, w = w, h = h};
        if widget.kind == FRAME { Place(index, widget.box) }
        else if widget.kind == TEXT { TextLayout(widget) }
        index = NextChild(parent, widget.order);
    }
}

Layout :: (width: s32, height: s32) {
    for * widgets { it.box = .{} }
    unused Measure(-1);
    Place(-1, .{x = 12, y = 12, w = NonNegative(width - 24), h = NonNegative(height - 24)});
}

EntrySlots :: (box: Box) -> s32 { return NonNegative(box.w - 2 * ENTRY_INSET - 1) / CHAR_WIDTH }

EntryStart :: (widget: *Widget) -> s64 {
    text := TextView(widget.text);
    cursor_position := UTF.Count(text[:widget.cursor]);
    first, _ := UTF.Offset(text, NonNegative(cursor_position - EntrySlots(widget.box)));
    return first;
}

Over :: (x: s32, y: s32, kind: s64) -> s64 {
    for * widgets {
        box := it.box;
        if it.kind == kind && !it.disabled && x >= box.x && x < box.x + box.w && y >= box.y && y < box.y + box.h {
            return it_index;
        }
    }
    return -1;
}

BoundRange :: (widget: *Widget, x: s32, y: s32) -> s64 {
    at, hit := View.Point(*widget.view, TextView(widget.text), x, y, CHAR_WIDTH);
    if hit {
        index := widget.view.ranges.count;
        while index > 0 {
            index -= 1;
            range := *widget.view.ranges[index];
            if at >= range.first && at < range.last && widget.view.tags[range.tag].release.bytes.count > 0 { return index }
        }
    }
    return -1;
}

PointerDown :: (x: s32, y: s32) {
    pressed = Over(x, y, BUTTON);
    pressed_range = -1;
    index := Over(x, y, ENTRY);
    if index < 0 {
        index = Over(x, y, TEXT);
        if index >= 0 {
            focused = index;
            widget := *widgets[index];
            pressed_range = BoundRange(widget, x-widget.box.x-View.INSET, y-widget.box.y-View.INSET);
            if pressed_range >= 0 { pressed = index }
        }
        return;
    }
    focused = index;
    widget := *widgets[index];
    start := EntryStart(widget);
    position := NonNegative(x - widget.box.x - ENTRY_INSET + CHAR_WIDTH/2) / CHAR_WIDTH;
    offset, _ := UTF.Offset(TextView(widget.text)[start:], position);
    widget.cursor = start + offset;
}

PointerUp :: (x: s32, y: s32) -> Text {
    index := pressed;
    range := pressed_range;
    pressed = -1;
    pressed_range = -1;
    if index < 0 { return .{} }
    if widgets[index].kind == SCALE {
        widget := *widgets[index];
        return ScaleDrag(widget, x, y);
    }
    if widgets[index].kind == SCROLLBAR { return .{} }
    if range < 0 {
        if Over(x, y, BUTTON) == index { return TextCopy(TextView(widgets[index].command)) }
        return .{};
    }
    if Over(x, y, TEXT) != index { return .{} }
    widget := *widgets[index];
    local_x := x-widget.box.x;
    local_y := y-widget.box.y;
    if BoundRange(widget, local_x-View.INSET, local_y-View.INSET) != range { return .{} }
    tag := widget.view.ranges[range].tag;
    output: Text;
    script := TextView(widget.view.tags[tag].release);
    digits: [24]u8;
    i: s64;
    while i < script.count {
        if script[i] == 37 && i+1 < script.count {
            code := script[i+1];
            if code == 120 || code == 121 {
                coordinate := ifx code == 120 then local_x else local_y;
                unused BuilderAppend(output.bytes, FormatInteger(coordinate, digits[:]));
                i += 2;
                continue;
            }
            if code == 37 { i += 1 }
        }
        unused VecPush(output.bytes, script[i]);
        i += 1;
    }
    return output;
}

Closed :: () -> bool { return closed }

ConfigureScale :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    scale := widget.scale;
    command: string;
    replace_command := false;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value := TextView(args[2*i+1]);
        if option == "-command" {
            command = value;
            replace_command = true;
        } else if option == "-orient" && (value == "horizontal" || value == "vertical") {
            scale.horizontal = value == "horizontal";
        } else if option == "-showvalue" && (value == "0" || value == "1") {
            scale.show_value = value == "1";
        } else if option == "-length" {
            length, ok := ParseInteger(value);
            if !ok || length < 1 || length > 4090 { SetError(result, "invalid scale length"); return false }
            scale.length = cast(s32)length;
        } else {
            number, ok := Scale.Parse(value);
            if ok && option == "-from" { scale.first = number }
            else if ok && option == "-to" { scale.last = number }
            else if ok && number >= 0 && option == "-resolution" { scale.resolution = number }
            else if ok && number >= 0 && option == "-bigincrement" { scale.big_increment = number }
            else { SetError(result, "unsupported scale option or value"); return false }
        }
    }
    scale.value = Scale.Bound(*scale, scale.value);
    if replace_command {
        copy: Text = TextCopy(command);
        if copy.bytes.count != command.count { SetError(result, "could not allocate scale command"); return false }
        VecSwap(widget.command.bytes, copy.bytes);
    }
    widget.scale = scale;
    return true;
}

ScaleCommand :: (widget: *Widget, args: []Text, result: *Result) {
    subcommand := TextView(args[0]);
    scale := *widget.scale;
    if subcommand == "get" && args.count == 1 { Scale.Append(*result.value, scale.value); return }
    if subcommand == "set" && args.count == 2 {
        value, ok := Scale.Parse(TextView(args[1]));
        if !ok { SetError(result, "invalid scale value"); return }
        scale.value = Scale.Bound(scale, value);
        return;
    }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-from" { Scale.Append(*result.value, scale.first); return }
        if option == "-to" { Scale.Append(*result.value, scale.last); return }
        if option == "-resolution" { Scale.Append(*result.value, scale.resolution); return }
        if option == "-bigincrement" { Scale.Append(*result.value, scale.big_increment); return }
        if option == "-length" { Scale.Append(*result.value, cast(s64)scale.length * Scale.UNIT); return }
        if option == "-command" { unused BuilderAppend(result.value.bytes, TextView(widget.command)); return }
        if option == "-orient" { unused BuilderAppend(result.value.bytes, ifx scale.horizontal then "horizontal" else "vertical"); return }
        if option == "-showvalue" { unused BuilderAppend(result.value.bytes, ifx scale.show_value then "1" else "0"); return }
    }
    SetError(result, "unsupported scale subcommand or arguments");
}

ScaleLength :: (widget: *Widget) -> s32 { return ifx widget.scale.horizontal then widget.box.w else widget.box.h }

ScaleCoordinate :: (widget: *Widget, x: s32, y: s32) -> s32 {
    return ifx widget.scale.horizontal then x else y;
}

ScaleInput :: (widget: *Widget, value: s64) -> Text {
    if widget.scale.value == value { return .{} }
    widget.scale.value = value;
    script: Text = TextCopy(TextView(widget.command));
    if script.bytes.count > 0 {
        unused BuilderAppend(script.bytes, " ");
        Scale.Append(*script, value);
    }
    return script;
}

ScaleTrack :: (widget: *Widget) -> Box {
    box := widget.box;
    if widget.scale.horizontal {
        return .{x = box.x, y = box.y + NonNegative(box.h - Scale.MINOR), w = box.w, h = Minimum(box.h, Scale.MINOR)};
    }
    return .{x = box.x + NonNegative(box.w - Scale.MINOR), y = box.y, w = Minimum(box.w, Scale.MINOR), h = box.h};
}

PointerPress :: (x: s32, y: s32) -> Text {
    PointerDown(x, y);
    check := Over(x, y, CHECKBUTTON);
    if check >= 0 {
        widget := *widgets[check];
        if Check.Select(*widget.check, !Check.Selected(*widget.check)) { return TextCopy(TextView(widget.command)) }
        return .{};
    }
    scrollbar := Over(x, y, SCROLLBAR);
    if scrollbar >= 0 { return ScrollPress(scrollbar, x, y) }
    index := Over(x, y, SCALE);
    if index < 0 { return .{} }
    focused = index;
    widget := *widgets[index];
    track := ScaleTrack(widget);
    if x < track.x || y < track.y || x >= track.x + track.w || y >= track.y + track.h { return .{} }
    position := ScaleCoordinate(widget, x-widget.box.x, y-widget.box.y);
    thumb := Scale.Position(*widget.scale, ScaleLength(widget));
    if position < thumb || position >= thumb + Scale.SLIDER {
        return ScaleInput(widget, Scale.Step(*widget.scale, ifx position < thumb then -1 else 1));
    }
    pressed = index;
    drag_start = ScaleCoordinate(widget, x, y);
    drag_value = widget.scale.value;
    return .{};
}

Dragging :: () -> bool {
    return pressed >= 0 && (widgets[pressed].kind == SCALE || widgets[pressed].kind == SCROLLBAR);
}

PointerMove :: (x: s32, y: s32) -> Text {
    if !Dragging() { return .{} }
    widget := *widgets[pressed];
    if widget.kind == SCROLLBAR { return ScrollDrag(widget, x, y) }
    return ScaleDrag(widget, x, y);
}

ScaleDrag :: (widget: *Widget, x: s32, y: s32) -> Text {
    return ScaleInput(widget, Scale.Drag(*widget.scale, ScaleLength(widget), ScaleCoordinate(widget, x, y) - drag_start, drag_value));
}

ConfigurePanel :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    border := widget.panel.border;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value := TextView(args[2*i+1]);
        if option == "-relief" && value == "flat" { continue }
        if option == "-bd" || option == "-borderwidth" {
            pixels, ok := ParseInteger(value);
            if ok && pixels >= 0 && pixels <= 512 { border = cast(s32)pixels; continue }
        }
        SetError(result, "unsupported panel option or value");
        return false;
    }
    widget.panel.border = border;
    return true;
}

PanelCommand :: (widget: *Widget, args: []Text, result: *Result) {
    subcommand := TextView(args[0]);
    if subcommand == "dirty" && (args.count == 1 || args.count == 5) {
        for i: 1..args.count-1 {
            _, ok := ParseInteger(TextView(args[i]));
            if !ok { SetError(result, "invalid panel dirty rectangle"); return }
        }
        // The surface renderer presents the entire widget tree after callbacks.
        return;
    }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-relief" { unused BuilderAppend(result.value.bytes, "flat"); return }
        if option == "-bd" || option == "-borderwidth" {
            digits: [24]u8;
            unused BuilderAppend(result.value.bytes, FormatInteger(widget.panel.border, digits[:]));
            return;
        }
    }
    SetError(result, "unsupported panel subcommand or arguments");
}

// Allocate a writable RGBA8 image for the panel and return its widget index.
// Callers take a fresh pixel view while the widget is alive.
PanelImage :: (name: string, width: s32, height: s32) -> s64 {
    index := Find(name);
    if closed || index < 0 || widgets[index].kind != PANEL || width < 1 || height < 1 || width > 4096 || height > 4096 { return -1 }
    panel := *widgets[index].panel;
    count := cast(s64)width * cast(s64)height * 4;
    if !VecResizeBounded(panel.pixels, count, MAX_PANEL_BYTES) { return -1 }
    panel.width = width;
    panel.height = height;
    return index;
}

CheckOption :: (name: string) -> bool {
    return name == "-variable" || name == "-onvalue" || name == "-offvalue";
}

CopyOption :: (args: []Text, name: string, fallback: string, target: *Text) -> bool {
    index := args.count-2;
    while index >= 0 {
        if TextView(args[index]) == name { return BuilderAppend(target.bytes, TextView(args[index+1])) }
        index -= 2;
    }
    return BuilderAppend(target.bytes, fallback);
}

ConfigureCheck :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    next: Check.State;
    if !CopyOption(args, "-variable", TextView(widget.check.variable), *next.variable) ||
       !CopyOption(args, "-onvalue", TextView(widget.check.on), *next.on) ||
       !CopyOption(args, "-offvalue", TextView(widget.check.off), *next.off) ||
       !Check.Ensure(TextView(next.variable), TextView(next.off)) {
        SetError(result, "could not allocate checkbutton values"); return false;
    }
    widget.check.selected = Check.Selected(*widget.check);
    VecSwap(widget.check.variable.bytes, next.variable.bytes);
    VecSwap(widget.check.on.bytes, next.on.bytes);
    VecSwap(widget.check.off.bytes, next.off.bytes);
    return true;
}

VariableCommand :: (_: s64, args: []Text, result: *Result) {
    if args.count < 1 || args.count > 2 { SetError(result, "expected variable name ?value?"); return }
    name := TextView(args[0]);
    if args.count == 2 {
        if !Check.Put(name, TextView(args[1])) { SetError(result, "could not store Tk variable") }
        return;
    }
    Check.Read(name, *result.value);
}

CheckCommand :: (widget: *Widget, args: []Text, result: *Result, script: *Text) {
    operation := TextView(args[0]);
    check := *widget.check;
    if operation == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if CheckOption(option) {
            value := TextView(check.off);
            if option == "-variable" { value = TextView(check.variable) }
            else if option == "-onvalue" { value = TextView(check.on) }
            unused BuilderAppend(result.value.bytes, value);
            return;
        }
    }
    if args.count == 1 {
        if operation == "select" || operation == "deselect" {
            if !Check.Select(check, operation == "select") { SetError(result, "could not store Tk variable") }
            return;
        }
        if operation == "toggle" || operation == "invoke" {
            if widget.disabled { return }
            if !Check.Select(check, !Check.Selected(check)) { SetError(result, "could not store Tk variable"); return }
            if operation == "invoke" { unused BuilderAppend(script.bytes, TextView(widget.command)) }
            return;
        }
    }
    SetError(result, "unsupported checkbutton subcommand or arguments");
}

Distance :: (value: string) -> (pixels: s32, ok: bool) {
    if value.count == 0 { return 0, false }
    factor: s64 = 1;
    divisor: s64 = 1;
    length := value.count;
    unit := value[length-1];
    if unit == 99 { factor = 39; length -= 1 }
    else if unit == 109 { factor = 3; length -= 1 }
    else if unit == 105 { factor = 100; length -= 1 }
    else if unit == 112 { factor = 100; divisor = 72; length -= 1 }
    else if unit == 119 { factor = CHAR_WIDTH; length -= 1 }
    else if unit == 104 { factor = View.ROW_HEIGHT; length -= 1 }
    amount, valid := Scale.Parse(value[:length], Scroll.UNIT);
    pixels := cast(s32)((amount*factor/divisor + Scroll.UNIT/2)/Scroll.UNIT);
    return pixels, valid && amount >= 0 && pixels <= 4096;
}

ConfigureScroll :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    bar := widget.kind == SCROLLBAR;
    callback: string;
    replace_callback := false;
    height := widget.text_height;
    horizontal := widget.scroll.horizontal;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value := TextView(args[2*i+1]);
        if (bar && option == "-command") || (!bar && option == "-yscrollcommand") {
            callback = value;
            replace_callback = true;
        }
        else if bar && option == "-orient" && (value == "horizontal" || value == "vertical") {
            horizontal = value == "horizontal";
        } else if !bar && option == "-height" {
            pixels, ok := Distance(value);
            if !ok { SetError(result, "invalid text height"); return false }
            height = pixels;
        } else { SetError(result, "unsupported widget option or value"); return false }
    }
    if replace_callback && callback != TextView(widget.command) {
        copy: Text = TextCopy(callback);
        if copy.bytes.count != callback.count { SetError(result, "could not allocate scroll callback"); return false }
        VecSwap(widget.command.bytes, copy.bytes);
        widget.sent_scroll = false;
    }
    widget.text_height = height;
    widget.scroll.horizontal = horizontal;
    return true;
}

ScrollCommand :: (widget: *Widget, args: []Text, result: *Result) {
    operation := TextView(args[0]);
    if operation == "set" && args.count == 3 {
        first, first_ok := Scale.Parse(TextView(args[1]), Scroll.UNIT);
        last, last_ok := Scale.Parse(TextView(args[2]), Scroll.UNIT);
        if !first_ok || !last_ok { SetError(result, "invalid scrollbar fraction"); return }
        widget.scroll.first = Scroll.Clamp(first);
        widget.scroll.last = Scroll.Clamp(last);
        return;
    }
    if operation == "get" && args.count == 1 {
        Scale.Append(*result.value, widget.scroll.first, Scroll.UNIT);
        unused BuilderAppend(result.value.bytes, " ");
        Scale.Append(*result.value, widget.scroll.last, Scroll.UNIT);
        return;
    }
    if operation == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-orient" {
            unused BuilderAppend(result.value.bytes, ifx widget.scroll.horizontal then "horizontal" else "vertical");
            return;
        }
        if option == "-command" { unused BuilderAppend(result.value.bytes, TextView(widget.command)); return }
    }
    if operation == "identify" && args.count == 3 {
        x, x_ok := ParseInteger(TextView(args[1]));
        y, y_ok := ParseInteger(TextView(args[2]));
        if x_ok && y_ok {
            box := widget.box;
            if x >= 0 && y >= 0 && x < box.w && y < box.h {
                length := ScrollLength(widget);
                offset := ifx widget.scroll.horizontal then cast(s32)x else cast(s32)y;
                unused BuilderAppend(result.value.bytes, Scroll.Hit(Scroll.Track(*widget.scroll, length), offset, length));
            }
            return;
        }
    }
    SetError(result, "unsupported scrollbar subcommand or arguments");
}

ScrollLength :: (widget: *Widget) -> s32 {
    return ifx widget.scroll.horizontal then widget.box.w else widget.box.h;
}

ScrollOffset :: (widget: *Widget, x: s32, y: s32) -> s32 {
    return ifx widget.scroll.horizontal then x-widget.box.x else y-widget.box.y;
}

ScrollPress :: (index: s64, x: s32, y: s32) -> Text {
    widget := *widgets[index];
    length := ScrollLength(widget);
    coordinate := ScrollOffset(widget, x, y);
    part := Scroll.Hit(Scroll.Track(*widget.scroll, length), coordinate, length);
    if part == "slider" {
        pressed = index;
        drag_start = coordinate;
        drag_value = widget.scroll.first;
        return .{};
    }
    command := TextView(widget.command);
    if part == "" || command == "" { return .{} }
    script: Text = TextCopy(command);
    action := ifx part == "arrow1" || part == "trough1" then " scroll -1" else " scroll 1";
    unit := ifx part == "arrow1" || part == "arrow2" then " unit" else " page";
    unused BuilderAppend(script.bytes, action);
    unused BuilderAppend(script.bytes, unit);
    return script;
}

ScrollDrag :: (widget: *Widget, x: s32, y: s32) -> Text {
    command := TextView(widget.command);
    track := Scroll.Track(*widget.scroll, ScrollLength(widget));
    if command == "" || track.travel == 0 { return .{} }
    delta := cast(s64)(ScrollOffset(widget, x, y) - drag_start) * Scroll.UNIT / track.travel;
    script: Text = TextCopy(command);
    unused BuilderAppend(script.bytes, " moveto ");
    Scale.Append(*script, Scroll.Clamp(drag_value + delta), Scroll.UNIT);
    return script;
}

TextScroll :: (widget: *Widget, script: *Text) {
    command := TextView(widget.command);
    if command == "" { return }
    TextLayout(widget);
    rows := widget.view.rows.count;
    first: s64;
    last: s64 = Scroll.UNIT;
    if rows > 0 {
        first = cast(s64)widget.view.top * Scroll.UNIT / rows;
        last = Scroll.Clamp(cast(s64)(widget.view.top + widget.view.visible) * Scroll.UNIT / rows);
    }
    if widget.sent_scroll && widget.last_scroll.first == first && widget.last_scroll.last == last { return }
    widget.last_scroll = .{first = first, last = last};
    widget.sent_scroll = true;
    unused BuilderAppend(script.bytes, command);
    unused BuilderAppend(script.bytes, " ");
    Scale.Append(script, first, Scroll.UNIT);
    unused BuilderAppend(script.bytes, " ");
    Scale.Append(script, last, Scroll.UNIT);
    unused BuilderAppend(script.bytes, "\nlist\n");
}

CollectTextScroll :: (script: *Text) {
    for * widgets {
        if it.name.bytes.count > 0 && it.kind == TEXT { TextScroll(it, script) }
    }
}

Update :: (_: s64, name: string, args: []Text, result: *Result, script: *Text) {
    if name != "update" || args.count != 0 { SetError(result, "expected update"); return }
    CollectTextScroll(script);
}
