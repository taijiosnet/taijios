// Optional Tk command model, following Inferno libtk and tcl_tk.b. See ../../NOTICE.
#import "std/vec"
using Tcl :: #import "tcl"
using T :: #import "tcl_types"

MAX_WIDGETS :: 32;
Box :: struct { x: s32; y: s32; w: s32; h: s32; }
Widget :: struct {
    name: Text;
    text: Text;
    command: Text;
    box: Box;
    button: bool;
    order: s32;
    side: s32;
    padx: s32;
    pady: s32;
}

// One root per app, matching the current Taiji surface lifetime.
widgets: Vec(Widget);
attached: bool;
closed: bool;
pressed: s64 = -1;
sequence: s32;

Attach :: (interpreter: *Tcl.Interpreter) -> bool {
    if attached { return false }
    commands := interpreter.extensions.count;
    prefixes := interpreter.prefixes.count;
    attached = Tcl.RegisterCommand(interpreter, "label", Create, 0) &&
               Tcl.RegisterCommand(interpreter, "button", Create, 1) &&
               Tcl.RegisterCommand(interpreter, "pack", Pack) &&
               Tcl.RegisterCommand(interpreter, "destroy", Destroy) &&
               Tcl.RegisterPrefix(interpreter, ".", WidgetCommand);
    if !attached {
        unused VecResize(interpreter.extensions, commands);
        unused VecResize(interpreter.prefixes, prefixes);
    }
    return attached;
}

Find :: (name: string) -> s64 {
    for * widgets { if TextView(it.name) == name { return it_index } }
    return -1;
}

FlatPath :: (path: string) -> bool {
    if path.count < 2 || path[0] != 46 { return false }
    for 1..path.count-1 { if path[it] == 46 { return false } }
    return true;
}

SetError :: (result: *Result, message: string) {
    result.code = .Error;
    unused BuilderAppend(result.value.bytes, message);
}

Configure :: (widget: *Widget, args: []Text, result: *Result) -> bool {
    if args.count % 2 != 0 { SetError(result, "expected option and value pairs"); return false }
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        if option != "-text" && (option != "-command" || !widget.button) {
            SetError(result, "unsupported widget option");
            return false;
        }
    }
    for i: 0..args.count/2-1 {
        value: Text = TextCopy(TextView(args[2*i+1]));
        if TextView(args[2*i]) == "-text" { VecSwap(widget.text.bytes, value.bytes) }
        else { VecSwap(widget.command.bytes, value.bytes) }
    }
    return true;
}

Create :: (kind: s64, args: []Text, result: *Result) {
    if closed || args.count == 0 { SetError(result, "expected a widget path in an open root"); return }
    path := TextView(args[0]);
    if !FlatPath(path) || Find(path) >= 0 { SetError(result, "invalid or duplicate widget path"); return }
    if widgets.count == MAX_WIDGETS { SetError(result, "widget limit exceeded"); return }
    widget := Widget.{name = TextCopy(path), button = kind == 1};
    if !Configure(*widget, args[1:], result) { return }
    if !VecPush(widgets, widget) { SetError(result, "could not allocate widget"); return }
    unused BuilderAppend(result.value.bytes, path);
}

Pack :: (_: s64, args: []Text, result: *Result) {
    if args.count == 0 { SetError(result, "expected pack path ?path ...? ?options?"); return }
    count: s64;
    side: s32;
    padx: s32 = 8;
    pady: s32 = 5;
    while count < args.count && FlatPath(TextView(args[count])) {
        if Find(TextView(args[count])) < 0 { SetError(result, "cannot pack unknown widget"); return }
        count += 1;
    }
    if count == 0 || (args.count - count) % 2 != 0 { SetError(result, "invalid pack arguments"); return }
    for i: 0..(args.count-count)/2-1 {
        option := TextView(args[count+2*i]);
        value := TextView(args[count+2*i+1]);
        if option == "-side" {
            if value == "top" { side = 0 }
            else if value == "left" { side = 1 }
            else if value == "bottom" { side = 2 }
            else if value == "right" { side = 3 }
            else { SetError(result, "unknown pack side"); return }
        } else if option == "-padx" || option == "-pady" {
            amount, ok := ParseInteger(value);
            if !ok || amount < 0 || amount > 512 { SetError(result, "invalid pack padding"); return }
            if option == "-padx" { padx = cast(s32)amount } else { pady = cast(s32)amount }
        } else { SetError(result, "unsupported pack option"); return }
    }
    for 0..count-1 {
        widget := *widgets[Find(TextView(args[it]))];
        if widget.order == 0 { sequence += 1; widget.order = sequence }
        widget.side = side;
        widget.padx = padx;
        widget.pady = pady;
    }
}

Destroy :: (_: s64, args: []Text, result: *Result) {
    if args.count == 0 { SetError(result, "expected destroy path ?path ...?"); return }
    for 0..args.count-1 {
        path := TextView(args[it]);
        if path == "." { closed = true; return }
        index := Find(path);
        if index < 0 { continue }
        last := widgets.count - 1;
        if index != last {
            old := *widgets[index];
            tail := *widgets[last];
            VecSwap(old.name.bytes, tail.name.bytes);
            VecSwap(old.text.bytes, tail.text.bytes);
            VecSwap(old.command.bytes, tail.command.bytes);
            old.button = tail.button;
            old.order = tail.order;
            old.side = tail.side;
            old.padx = tail.padx;
            old.pady = tail.pady;
            old.box = tail.box;
        }
        if pressed == index { pressed = -1 }
        else if pressed == last { pressed = index }
        unused VecResize(widgets, last);
    }
}

WidgetCommand :: (_: s64, name: string, args: []Text, result: *Result, script: *Text) {
    index := Find(name);
    if index < 0 || closed { SetError(result, "unknown widget path"); return }
    if args.count == 0 { SetError(result, "expected widget subcommand"); return }
    widget := *widgets[index];
    subcommand := TextView(args[0]);
    if subcommand == "configure" && args.count >= 3 { unused Configure(widget, args[1:], result); return }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-text" { unused BuilderAppend(result.value.bytes, TextView(widget.text)); return }
        if option == "-command" && widget.button {
            unused BuilderAppend(result.value.bytes, TextView(widget.command)); return;
        }
    }
    if subcommand == "invoke" && args.count == 1 && widget.button {
        unused BuilderAppend(script.bytes, TextView(widget.command));
        return;
    }
    SetError(result, "unsupported widget subcommand or arguments");
}

Minimum :: (a: s32, b: s32) -> s32 { return ifx a < b then a else b }
NonNegative :: (x: s32) -> s32 { return ifx x > 0 then x else 0 }

Layout :: (width: s32, height: s32) {
    cavity := Box.{x = 12, y = 12, w = NonNegative(width - 24), h = NonNegative(height - 24)};
    // Maintain packing order even when creation or deletion order differs.
    after: s32;
    while true {
        index: s64 = -1;
        for * widgets {
            if it.order > after && (index < 0 || it.order < widgets[index].order) { index = it_index }
        }
        if index < 0 { break }
        widget := *widgets[index];
        after = widget.order;
        count := TextView(widget.text).count;
        text_width := ifx count < 512 then cast(s32)count * 12 else 6144;
        requested_w := text_width + 30;
        requested_h := ifx widget.button then cast(s32)36 else cast(s32)28;
        available := cavity;
        if widget.side == 1 || widget.side == 3 {
            available.w = Minimum(cavity.w, requested_w + widget.padx * 2);
            if widget.side == 1 { cavity.x += available.w }
            else { available.x += cavity.w - available.w }
            cavity.w -= available.w;
        } else {
            available.h = Minimum(cavity.h, requested_h + widget.pady * 2);
            if widget.side == 0 { cavity.y += available.h }
            else { available.y += cavity.h - available.h }
            cavity.h -= available.h;
        }
        w := Minimum(requested_w, NonNegative(available.w - widget.padx * 2));
        h := Minimum(requested_h, NonNegative(available.h - widget.pady * 2));
        widget.box = .{x = available.x + (available.w-w)/2, y = available.y + (available.h-h)/2, w = w, h = h};
    }
}

OverButton :: (x: s32, y: s32) -> s64 {
    for * widgets {
        box := it.box;
        if it.button && it.order > 0 && x >= box.x && x < box.x + box.w && y >= box.y && y < box.y + box.h {
            return it_index;
        }
    }
    return -1;
}

PointerDown :: (x: s32, y: s32) { pressed = OverButton(x, y) }

PointerUp :: (x: s32, y: s32) -> Text {
    index := pressed;
    pressed = -1;
    if index < 0 || OverButton(x, y) != index { return TextCopy("") }
    return TextCopy(TextView(widgets[index].command));
}

Closed :: () -> bool { return closed }
