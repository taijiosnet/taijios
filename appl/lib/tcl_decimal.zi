// Fixed-point conversion for the Inferno Tcl format command. See ../../NOTICE (MIT).
#import "std/vec"
#import "std/math"
using F :: #import "std/float_text"
using T :: #import "tcl_types"

// The exact finite value is significand * 2^exponent. When the exponent
// is negative, represent it instead as significand * 5^-exponent / 10^-exponent.
// Base 10^9 limbs keep the longest binary64 expansion small.
DecimalDigits :: (value: float64, digits: []u8) -> (count: s64, scale: s64) {
    if value == 0.0 { return 1, 0 }
    exponent: s64 = -52
    while value >= 4294967296.0 { value /= 4294967296.0; exponent += 32 }
    while value < 1.0 { value *= 4294967296.0; exponent -= 32 }
    while value >= 2.0 { value *= 0.5; exponent += 1 }
    significand := cast(u64)(value * 4503599627370496.0)
    while exponent < 0 && significand % 2 == 0 { significand /= 2; exponent += 1 }
    scale := ifx exponent < 0 then -exponent else 0
    base: u64 = 1000000000
    limbs: [86]u64
    limbs[0] = significand % base
    limbs[1] = significand / base
    used: s64 = ifx limbs[1] == 0 then 1 else 2
    while exponent != 0 {
        factor: u64 = 1
        if exponent < 0 {
            // 5^13 * (10^9 - 1) fits in 64 bits.
            for 1..13 {
                if exponent == 0 { break }
                factor *= 5
                exponent += 1
            }
        } else {
            step := ifx exponent > 29 then 29 else exponent
            factor = cast(u64)1 << cast(u64)step
            exponent -= step
        }
        carry: u64 = 0
        for i: 0..used-1 {
            chunk := limbs[i] * factor + carry
            limbs[i] = chunk % base
            carry = chunk / base
        }
        while carry != 0 {
            limbs[used] = carry % base
            carry /= base
            used += 1
        }
    }
    count: s64 = 0
    for i: 0..used-1 {
        chunk := limbs[i]
        for 0..8 {
            if i == used-1 && chunk == 0 { break }
            digits[count] = cast(u8)(chunk % 10)
            chunk /= 10
            count += 1
        }
    }
    return count, scale
}

// Drop decimal places using round-to-nearest, ties-to-even. Digits are
// least significant first. Caller storage is zero-filled past count.
Round :: (digits: []u8, count: s64, discard: s64) -> s64 {
    if discard <= 0 || discard > count { return count }
    halfway := digits[discard-1]
    up := halfway > 5
    if halfway == 5 {
        up = digits[discard] % 2 != 0
        for 0..discard-2 {
            if digits[it] != 0 { up = true; break }
        }
    }
    if !up { return count }
    at := discard
    while digits[at] == 9 { digits[at] = 0; at += 1 }
    digits[at] += 1
    return ifx at >= count then at+1 else count
}

// Return the sign separately so format can place zero padding after it.
Fixed :: (input: string, precision: s64) -> (magnitude: Text, negative: bool, ok: bool) {
    first: s64 = 0
    last := input.count
    while first < last && Space(input[first]) { first += 1 }
    while last > first && Space(input[last-1]) { last -= 1 }
    text := input[first:last]
    value, valid := F.ParseFloat64(text)
    if !valid { return .{}, false, false }
    if value != value { return TextCopy("NaN"), false, true }
    negative := value < 0.0 || (value == 0.0 && text[0] == 45)
    if negative { value = -value }
    if !Finite64(value) { return TextCopy("Inf"), negative, true }

    // At most 767 exact significant digits for finite binary64 values.
    digits: [768]u8
    count, scale := DecimalDigits(value, digits[:])
    discard := ifx scale > precision then scale-precision else 0
    count = Round(digits[:], count, discard)
    output: Text
    first_digit := ifx count > scale then count-1 else scale
    at := first_digit
    while at >= discard {
        if at == scale-1 { unused VecPush(output.bytes, cast(u8)46) }
        digit: u8 = ifx at < count then digits[at] else cast(u8)0
        unused VecPush(output.bytes, digit + 48)
        at -= 1
    }
    if precision > scale && scale == 0 { unused VecPush(output.bytes, cast(u8)46) }
    for 1..precision-scale { unused VecPush(output.bytes, cast(u8)48) }
    return output, negative, true
}
