// Selection values live in the Tk root, following Inferno libtk/varbl.c.
#import "std/vec"
using V :: #import "tcl_variables"

DEFAULT_VARIABLE :: "selectedButton";
MAX_VARIABLES :: 1024;
variables: V.VariableTable;
versions: [MAX_VARIABLES]u64;
revision: u64;

State :: struct {
    variable: Text;
    on: Text;
    off: Text;
    selected: bool;
    radio: bool;
    indicator: s32;
    observed: u64;
}

Find :: (name: string) -> s64 {
    return V.FindVariable(*variables, name);
}

Read :: (name: string, output: *Text) {
    index := Find(name);
    if index >= 0 { unused BuilderAppend(output.bytes, TextView(variables.entries[index].value)) }
}

Put :: (name: string, value: string) -> bool {
    if name == "" { return true }
    index := Find(name);
    if index >= 0 && TextView(variables.entries[index].value) == value { return true }
    if index < 0 && variables.entries.count >= MAX_VARIABLES { return false }
    if !V.StoreValue(*variables, name, value) { return false }
    if index < 0 { index = variables.entries.count-1 }
    revision += 1;
    versions[index] = revision;
    return true;
}

Option :: (state: *State, name: string, output: *Text = null) -> bool {
    value: string;
    if name == "-variable" { value = TextView(state.variable) }
    else if name == "-value" && state.radio || name == "-onvalue" && !state.radio { value = TextView(state.on) }
    else if name == "-offvalue" && !state.radio { value = TextView(state.off) }
    else if name == "-indicatoron" {
        if state.indicator < 0 { value = "0" }
        else if state.indicator > 0 { value = "1" }
    } else { return false }
    if output != null { unused BuilderAppend(output.bytes, value) }
    return true;
}

Indicator :: (value: string) -> s32 {
    if value == "0" || value == "no" || value == "off" || value == "false" { return -1 }
    if value == "1" || value == "yes" || value == "on" || value == "true" { return 1 }
    return 0;
}

CopyOption :: (args: []Text, name: string, fallback: string, target: *Text) -> bool {
    index := args.count-2;
    while index >= 0 {
        if TextView(args[index]) == name { return BuilderAppend(target.bytes, TextView(args[index+1])) }
        index -= 2;
    }
    return BuilderAppend(target.bytes, fallback);
}

Configure :: (state: *State, args: []Text, path: string, in_menu: bool) -> bool {
    next: State = .{radio = state.radio, indicator = state.indicator};
    {
        default_variable := ifx state.radio && path != "" then DEFAULT_VARIABLE else TextView(state.variable);
        if !CopyOption(args, "-variable", default_variable, *next.variable) ||
           !CopyOption(args, ifx state.radio then "-value" else "-onvalue", TextView(state.on), *next.on) ||
           !CopyOption(args, "-offvalue", TextView(state.off), *next.off) { return false }
    }
    for i: 0..args.count/2-1 {
        if TextView(args[2*i]) == "-indicatoron" { next.indicator = Indicator(TextView(args[2*i+1])) }
    }
    {
        variable := TextView(next.variable);
        if state.radio && path != "" && variable == DEFAULT_VARIABLE && TextView(next.on) == "" {
            if !BuilderAppend(next.on.bytes, path) { return false }
        }
        index := Find(variable);
        if !in_menu && !state.radio && path != "" && variable != "" && index < 0 {
            if !Put(variable, Value(TextView(next.off), next.radio, "0")) { return false }
            index = Find(variable);
        }
        next.selected = Selected(state);
        if index >= 0 {
            next.observed = versions[index];
            // Stock menu entryconfigure preserves the indicator until the variable changes.
            if !in_menu { next.selected = TextView(variables.entries[index].value) == Value(TextView(next.on), next.radio, "1") }
        }
    }
    Swap(state, *next);
    return true;
}

Swap :: (a: *State, b: *State) {
    VecSwap(a.variable.bytes, b.variable.bytes);
    VecSwap(a.on.bytes, b.on.bytes);
    VecSwap(a.off.bytes, b.off.bytes);
    selected := a.selected;
    radio := a.radio;
    indicator := a.indicator;
    observed := a.observed;
    a.selected = b.selected;
    a.radio = b.radio;
    a.indicator = b.indicator;
    a.observed = b.observed;
    b.selected = selected;
    b.radio = radio;
    b.indicator = indicator;
    b.observed = observed;
}

Value :: (value: string, radio: bool, fallback: string) -> string {
    return ifx value == "" && !radio then fallback else value;
}

Selected :: (state: *State) -> bool {
    index := Find(TextView(state.variable));
    if index >= 0 && state.observed != versions[index] {
        state.selected = TextView(variables.entries[index].value) == Value(TextView(state.on), state.radio, "1");
        state.observed = versions[index];
    }
    return state.selected;
}

Select :: (state: *State, selected: bool) -> bool {
    value := ifx selected then Value(TextView(state.on), state.radio, "1") else Value(TextView(state.off), state.radio, "0");
    if !Put(TextView(state.variable), value) { return false }
    if !state.radio { state.selected = selected }
    return true;
}

Invoke :: (state: *State) -> bool {
    return Select(state, state.radio || !Selected(state));
}
