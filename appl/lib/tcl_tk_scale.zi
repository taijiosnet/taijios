// Fixed-point scale values and slider geometry, following Inferno libtk/scale.c.
#import "std/vec"
#import "std/number_text"
using T :: #import "tcl_types"

UNIT :: 1000;
SLIDER :: 16;
INSET :: 3;
MINOR :: 18;
VALUE_HEIGHT :: 20;

State :: struct {
    first: s64;
    last: s64;
    value: s64;
    resolution: s64;
    big_increment: s64;
    length: s32;
    horizontal: bool;
    show_value: bool;
}

Default :: () -> State { return .{last = 100 * UNIT, resolution = UNIT, length = 80, show_value = true} }

Parse :: (text: string, unit: s64 = UNIT) -> (value: s64, ok: bool) {
    i: s64;
    negative := text.count > 0 && text[0] == 45;
    if negative || (text.count > 0 && text[0] == 43) { i += 1 }
    whole: s64;
    digits: s64;
    while i < text.count && T.Digit(text[i]) {
        whole = whole * 10 + cast(s64)(text[i] - 48);
        if whole > 2147483 { return 0, false }
        i += 1;
        digits += 1;
    }
    fraction: s64;
    place := unit / 10;
    if i < text.count && text[i] == 46 {
        i += 1;
        while i < text.count && T.Digit(text[i]) {
            fraction += cast(s64)(text[i] - 48) * place;
            place /= 10;
            i += 1;
            digits += 1;
        }
    }
    value := whole * unit + fraction;
    if negative { value = -value }
    return value, digits > 0 && i == text.count && T.InRange(value);
}

Append :: (target: *Text, value: s64, unit: s64 = UNIT) {
    digits: [24]u8;
    magnitude := value;
    if magnitude < 0 { unused BuilderAppend(target.bytes, "-"); magnitude = -magnitude }
    unused BuilderAppend(target.bytes, FormatInteger(magnitude / unit, digits[:]));
    fraction := magnitude % unit;
    if fraction == 0 { return }
    unused BuilderAppend(target.bytes, ".");
    place := unit / 10;
    while fraction != 0 {
        unused VecPush(target.bytes, cast(u8)(48 + fraction / place));
        fraction %= place;
        place /= 10;
    }
}

Bound :: (scale: *State, value: s64) -> s64 {
    if scale.resolution > 0 { value = (value / scale.resolution) * scale.resolution }
    low := ifx scale.first < scale.last then scale.first else scale.last;
    high := ifx scale.first > scale.last then scale.first else scale.last;
    if value < low { return low }
    if value > high { return high }
    return value;
}

Step :: (scale: *State, direction: s64) -> s64 {
    sign := ifx scale.last >= scale.first then 1 else -1;
    return Bound(scale, scale.value + direction * sign * scale.big_increment);
}

Travel :: (length: s32) -> s32 {
    usable := length - 2 * INSET - SLIDER;
    return ifx usable > 0 then usable else 0;
}

Position :: (scale: *State, length: s32) -> s32 {
    if scale.last == scale.first { return INSET }
    return INSET + cast(s32)((scale.value - scale.first) * Travel(length) / (scale.last - scale.first));
}

Drag :: (scale: *State, length: s32, delta: s32, base: s64) -> s64 {
    travel := Travel(length);
    if travel == 0 { return base }
    value := base + cast(s64)delta * (scale.last - scale.first) / travel;
    if scale.resolution > 0 {
        half := scale.resolution / 2;
        value += ifx value < 0 then -half else half;
    }
    return Bound(scale, value);
}
