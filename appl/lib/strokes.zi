// Strokes for the Li/Yeung handwriting recogniser, as the Limbo Strokes and
// Buildstrokes modules computed them: filtering, scaling, equidistant
// resampling, canonical class examples and their dominant points. All
// arithmetic is integer and coordinates are scaled by 100 where noted.
// Derived from code Copyright 2000 Compaq Computer Corporation, adapted
// from cmu_recognizer.c by Jay Kistler, with credit to Dean Rubine, Jim
// Kempf and Ari Rapkin: "Copying or modifying this code for any purpose is
// permitted, provided that this copyright notice is preserved in its
// entirety in all copies or modifications. COMPAQ COMPUTER CORPORATION
// MAKES NO WARRANTIES, EXPRESSED OR IMPLIED, AS TO THE USEFULNESS OR
// CORRECTNESS OF THIS CODE OR ITS FITNESS FOR ANY PARTICULAR PURPOSE."

#import "std/option";

Penpoint :: struct {
    x: s64;
    y: s64;
    chaincode: s64;
}

Stroke :: struct {
    pts: Vec(Penpoint);
    xrange: s64;
    yrange: s64;
}

RCONVEX :: 0;
RCONCAVE :: 1;
RPLAIN :: 2;
RPSEUDO :: 3;

Region :: struct {
    rtype: s64;
    start: s64;
    end: s64;
}

MAXINT :: 2147483647;
CANONICAL_X :: 108;
CANONICAL_Y :: 128;
NCANONICAL :: 50;
DIST_SQ_THRESHOLD :: 9;
LP_FILTER_WIDTH :: 6;
LP_FILTER_ITERS :: 8;
LP_FILTER_THLD :: 250;
LP_FILTER_MIN :: 5;
PE_AL_THLD :: 1500;
PE_ATCR_THLD :: 135;

// Low-pass filter weights: floor(100 * exp(0.04 * i * i)) for |i| <= 6.
weights: [13]s64 = .[422, 271, 189, 143, 117, 104, 100, 104, 117, 143, 189, 271, 422];

// Direction codes indexed by dx+1 and dy+1.
directions: [9]s64 = .[1, 0, 7, 2, 2147483647, 6, 3, 4, 5];

Abs :: (a: s64) -> s64 { return ifx a < 0 then -a else a }

// Integer square root, rounded, by Joseph Hall's method.
Sqrt :: (n: s64) -> s64 {
    k0: s64 = 2;
    i := n;
    while i > 0 { k0 *= 2; i /= 4 }
    nn := n * 4;
    k1: s64 = 0;
    while true {
        k1 = (nn / k0 + k0) / 2;
        if ((k0 ^ k1) & ~1) == 0 { break }
        k0 = k1;
    }
    return (k1 + 1) / 2;
}

// A monotone stand-in for the angle of (bot, top), from 0 to 0x40000. As in
// the Limbo code it is 0 whenever top is 0.
LikeAtan :: (top: s64, bot: s64) -> s64 {
    if top == 0 { return 0 }
    t := (top * 65536) / (Abs(top) + Abs(bot));
    if bot < 0 { return 131072 - t }
    if top < 0 { return 262144 + t }
    return t;
}

Quadrant :: (t: s64) -> s64 { return (8 - (((t + 16384) / 32768) % 8)) % 8 }

Copy :: (s: *Stroke) -> Stroke {
    out: Stroke;
    for i: 0..s.pts.count - 1 { VecPush(out.pts, s.pts[i]) }
    out.xrange = s.xrange;
    out.yrange = s.yrange;
    return out;
}

// The closed bounding box: minx, miny, maxx, maxy.
Bbox :: (s: *Stroke) -> (minx: s64, miny: s64, maxx: s64, maxy: s64) {
    minx := s.pts[0].x; maxx := minx;
    miny := s.pts[0].y; maxy := miny;
    for i: 1..s.pts.count - 1 {
        p := s.pts[i];
        if p.x < minx { minx = p.x }
        if p.x > maxx { maxx = p.x }
        if p.y < miny { miny = p.y }
        if p.y > maxy { maxy = p.y }
    }
    return minx, miny, maxx, maxy;
}

// Moves the points by -minx, -miny and scales them by scalex/100 and
// scaley/100; xrange and yrange are left alone.
Translate :: (s: *Stroke, minx: s64, miny: s64, scalex: s64, scaley: s64) {
    for i: 0..s.pts.count - 1 {
        s.pts[i].x = ((s.pts[i].x - minx) * scalex + 50) / 100;
        s.pts[i].y = ((s.pts[i].y - miny) * scaley + 50) / 100;
    }
}

Center :: (s: *Stroke) {
    minx, miny, maxx, maxy := Bbox(s);
    s.xrange = maxx - minx;
    s.yrange = maxy - miny;
    Translate(s, -((CANONICAL_X - s.xrange + 1) / 2), -((CANONICAL_Y - s.yrange + 1) / 2), 100, 100);
}

ScaleUp :: (s: *Stroke) -> s64 {
    minx, miny, maxx, maxy := Bbox(s);
    xrange := maxx - minx;
    yrange := maxy - miny;
    scale: s64 = 0;
    if (100 * xrange + CANONICAL_X / 2) / CANONICAL_X > (100 * yrange + CANONICAL_Y / 2) / CANONICAL_Y {
        scale = (100 * CANONICAL_X + xrange / 2) / xrange;
    } else {
        scale = (100 * CANONICAL_Y + yrange / 2) / yrange;
    }
    Translate(s, minx, miny, scale, scale);
    return scale;
}

// The path length from point first to point last, x 100.
PathLength :: (s: *Stroke, first: s64, last: s64) -> s64 {
    l: s64 = 0;
    for i: first + 1..last {
        dx := s.pts[i].x - s.pts[i - 1].x;
        dy := s.pts[i].y - s.pts[i - 1].y;
        l += Sqrt(10000 * (dx * dx + dy * dy));
    }
    return l;
}

Length :: (s: *Stroke) -> s64 { return PathLength(s, 0, s.pts.count - 1) }

// The points that are at least 3 units from the previous kept point.
Filter :: (s: *Stroke) -> Stroke {
    out: Stroke;
    VecPush(out.pts, s.pts[0]);
    for i: 1..s.pts.count - 1 {
        last := out.pts[out.pts.count - 1];
        dx := s.pts[i].x - last.x;
        dy := s.pts[i].y - last.y;
        if dx * dx + dy * dy >= DIST_SQ_THRESHOLD { VecPush(out.pts, s.pts[i]) }
    }
    return out;
}

ChainCode :: (s: *Stroke) {
    for i: 0..s.pts.count - 2 {
        dx := s.pts[i + 1].x - s.pts[i].x;
        dy := s.pts[i + 1].y - s.pts[i].y;
        s.pts[i].chaincode = (12 - Quadrant(LikeAtan(dy, dx))) % 8;
    }
}

UnitChainCode :: (s: *Stroke) {
    for i: 0..s.pts.count - 2 {
        dx := s.pts[i + 1].x - s.pts[i].x;
        dy := s.pts[i + 1].y - s.pts[i].y;
        s.pts[i].chaincode = directions[(dx + 1) * 3 + dy + 1];
    }
}

// Appends the Bresenham line from a to b, both ends included.
Line :: (a: Penpoint, b: Penpoint, out: *Stroke) {
    x0 := a.x; y0 := a.y;
    stepx: s64 = 1; dx := b.x - x0;
    if dx < 0 { dx = -dx; stepx = -1 }
    dx *= 2;
    stepy: s64 = 1; dy := b.y - y0;
    if dy < 0 { dy = -dy; stepy = -1 }
    dy *= 2;
    VecPush(out.pts, Penpoint.{x = x0, y = y0});
    if dx >= dy {
        e := dy - dx / 2;
        while x0 != b.x {
            if e >= 0 { y0 += stepy; e -= dx }
            x0 += stepx;
            e += dy;
            VecPush(out.pts, Penpoint.{x = x0, y = y0});
        }
    } else {
        e := dx - dy / 2;
        while y0 != b.y {
            if e >= 0 { x0 += stepx; e -= dy }
            y0 += stepy;
            e += dx;
            VecPush(out.pts, Penpoint.{x = x0, y = y0});
        }
    }
}

// The stroke with every unit step between its points filled in.
Interpolate :: (s: *Stroke) -> Stroke {
    out: Stroke;
    for i: 0..s.pts.count - 2 {
        Line(s.pts[i], s.pts[i + 1], *out);
        // A segment's end point starts the next one.
        unused VecPop(out.pts);
    }
    VecPush(out.pts, s.pts[s.pts.count - 1]);
    UnitChainCode(*out);
    return out;
}

RegionType :: (value: s64) -> s64 {
    if value == 18000 { return RPLAIN }
    return ifx value < 18000 then RCONCAVE else RCONVEX;
}

// The convex, concave, plain and pseudo-extreme regions of an
// interpolated stroke, from its low-pass filtered turning angles.
Regions :: (pts: *Stroke) -> Vec(Region) {
    n := pts.pts.count;
    current: Vec(s64);
    VecPush(current, 18000);
    for i: 1..n - 2 {
        d := pts.pts[i].chaincode;
        before := pts.pts[i - 1].chaincode;
        if before < d { before += 8 }
        turn := (before - d) % 8;
        VecPush(current, ((12 - turn) % 8) * 4500);
    }
    if n > 1 { VecPush(current, 18000) }
    total: s64 = 0;
    for weights { total += it }
    for 1..LP_FILTER_ITERS {
        next: Vec(s64);
        for i: 0..n - 1 {
            sum: s64 = 0;
            for k: i - LP_FILTER_WIDTH..i + LP_FILTER_WIDTH {
                old := ifx k < 0 || k >= n then cast(s64)18000 else current[k];
                sum += old * weights[k - (i - LP_FILTER_WIDTH)];
            }
            VecPush(next, sum / total);
        }
        VecSwap(current, next);
    }
    for i: 0..n - 1 { if Abs(current[i] - 18000) < LP_FILTER_THLD { current[i] = 18000 } }

    found: Vec(Region);
    VecPush(found, Region.{rtype = RegionType(current[0]), start = 0});
    for i: 1..n - 1 {
        t := RegionType(current[i]);
        if t != found[found.count - 1].rtype {
            found[found.count - 1].end = i - 1;
            VecPush(found, Region.{rtype = t, start = i});
        }
    }
    found[found.count - 1].end = n - 1;

    // Short convex or concave regions merge into the plain ones around them.
    merged: Vec(Region);
    r: s64 = 0;
    while r < found.count {
        region := found[r];
        r += 1;
        if region.rtype == RPLAIN {
            while r < found.count && found[r].end - found[r].start < LP_FILTER_MIN && r + 1 < found.count {
                region.end = found[r + 1].end;
                r += 2;
            }
        }
        VecPush(merged, region);
    }

    // Long, curved plain regions are split at a pseudo-extreme, and the
    // second half is considered again.
    regions: Vec(Region);
    pending: Vec(Region);
    for < i: 0..merged.count - 1 { VecPush(pending, merged[i]) }
    while pending.count > 0 {
        region := VecPop(pending).value;
        if region.rtype == RPLAIN {
            arc := PathLength(pts, region.start, region.end);
            dx := pts.pts[region.end].x - pts.pts[region.start].x;
            dy := pts.pts[region.end].y - pts.pts[region.start].y;
            chord := Sqrt(10000 * (dx * dx + dy * dy));
            ratio: s64 = 0;
            if chord != 0 { ratio = (100 * arc + chord / 2) / chord }
            if arc >= PE_AL_THLD && ratio >= PE_ATCR_THLD {
                mid := (region.start + region.end) / 2;
                VecPush(pending, Region.{rtype = RPLAIN, start = mid + 1, end = region.end});
                VecPush(regions, Region.{rtype = RPLAIN, start = region.start, end = mid - 1});
                VecPush(regions, Region.{rtype = RPSEUDO, start = mid, end = mid});
                continue;
            }
        }
        VecPush(regions, region);
    }
    return regions;
}

// The turning angle chosen for each point: the middle of each convex
// region is 18000 and of each other non-plain region 0.
ContourAngles :: (s: *Stroke, regions: []Region) -> Vec(s64) {
    v: Vec(s64);
    for 1..s.pts.count { VecPush(v, 18000) }
    for regions {
        for i: it.start..it.end {
            if it.rtype == RPLAIN {
                v[i] = 18000;
            } else {
                middle := i == (it.start + it.end) / 2;
                v[i] = ifx middle != (it.rtype != RCONVEX) then cast(s64)18000 else 0;
            }
        }
    }
    // The first point starts at 18000 and may be changed by its region;
    // the last point is always 18000.
    v[s.pts.count - 1] = 18000;
    return v;
}

// The start, end and extreme points of an interpolated stroke, with the
// midpoints between them.
Dominant :: (s: *Stroke) -> Stroke {
    regions := Regions(s);
    angles := ContourAngles(s, regions[:]);
    dom: Stroke;
    previous: s64 = 0;
    VecPush(dom.pts, s.pts[0]);
    for regions {
        if it.rtype == RPLAIN { continue }
        max_v: s64 = 0; min_v: s64 = MAXINT;
        max_i: s64 = -1; min_i: s64 = -1;
        for i: it.start..it.end {
            if angles[i] > max_v { max_v = angles[i]; max_i = i }
            if angles[i] < min_v { min_v = angles[i]; min_i = i }
        }
        current := ifx it.rtype == RCONVEX then max_i else min_i;
        VecPush(dom.pts, s.pts[(previous + current) / 2]);
        VecPush(dom.pts, s.pts[current]);
        previous = current;
    }
    last := s.pts.count - 1;
    VecPush(dom.pts, s.pts[(previous + last) / 2]);
    VecPush(dom.pts, s.pts[last]);
    ChainCode(*dom);
    return dom;
}

// NCANONICAL points spaced evenly along the stroke; false when the stroke
// does not yield exactly that many.
EquiPoints :: (s: *Stroke, out: *Stroke) -> bool {
    VecClear(out.pts);
    equidist := (Length(s) + (NCANONICAL - 1) / 2) / (NCANONICAL - 1);
    VecPush(out.pts, s.pts[0]);
    since: s64 = 0;
    for i: 1..s.pts.count - 1 {
        dx1 := s.pts[i].x - s.pts[i - 1].x;
        dy1 := s.pts[i].y - s.pts[i - 1].y;
        endx := s.pts[i - 1].x * 100;
        endy := s.pts[i - 1].y * 100;
        remaining := Sqrt(10000 * (dx1 * dx1 + dy1 * dy1));
        to_next := equidist - since;
        while remaining >= to_next {
            if out.pts.count >= NCANONICAL { return false }
            if dx1 == 0 {
                if dy1 >= 0 { endy += to_next } else { endy -= to_next }
            } else {
                slope := (100 * dy1 + dx1 / 2) / dx1;
                tmp := Sqrt(10000 + slope * slope);
                dx := (100 * to_next + tmp / 2) / tmp;
                dy := Abs((slope * dx + 50) / 100);
                if dx1 >= 0 { endx += dx } else { endx -= dx }
                if dy1 >= 0 { endy += dy } else { endy -= dy }
            }
            VecPush(out.pts, Penpoint.{x = (endx + 50) / 100, y = (endy + 50) / 100});
            since = 0;
            remaining -= to_next;
            to_next = equidist;
        }
        since += remaining;
    }
    if out.pts.count == NCANONICAL - 1 { VecPush(out.pts, s.pts[s.pts.count - 1]) }
    return out.pts.count == NCANONICAL;
}

// The canonical form of an example: filtered, scaled up, resampled to
// NCANONICAL points and moved to the origin, with its ranges set.
Canonical :: (example: *Stroke, out: *Stroke) -> bool {
    points := Filter(example);
    if points.pts.count < 2 { return false }
    unused ScaleUp(*points);
    if !EquiPoints(*points, out) { return false }
    minx, miny, maxx, maxy := Bbox(out);
    Translate(out, minx, miny, 100, 100);
    out.xrange = maxx - minx;
    out.yrange = maxy - miny;
    return true;
}

Normalise :: (x: s64, y: s64, xrange: s64, yrange: s64) -> (nx: s64, ny: s64) {
    if (100 * x + xrange / 2) / xrange > (100 * y + yrange / 2) / yrange {
        return xrange, (y * xrange + x / 2) / x;
    }
    return (x * yrange + y / 2) / y, yrange;
}

// The dominant points of a class's canonical example: the average of its
// canonical examples, scaled to the largest ranges among them.
ClassDominant :: (examples: []Stroke) -> Stroke {
    forms: Vec(Stroke);
    for i: 0..examples.count - 1 {
        form: Stroke;
        if Canonical(*examples[i], *form) {
            VecPush(forms, form);
        } else {
            // An example without a canonical form is averaged as it was read.
            VecPush(forms, Copy(*examples[i]));
        }
    }
    maxx: s64 = 0; maxy: s64 = 0;
    for i: 0..forms.count - 1 {
        if forms[i].xrange > maxx { maxx = forms[i].xrange }
        if forms[i].yrange > maxy { maxy = forms[i].yrange }
    }
    maxx, maxy = Normalise(maxx, maxy, CANONICAL_X, CANONICAL_Y);
    for i: 0..forms.count - 1 {
        scalex := ifx forms[i].xrange == 0 then cast(s64)100 else (100 * maxx + forms[i].xrange / 2) / forms[i].xrange;
        scaley := ifx forms[i].yrange == 0 then cast(s64)100 else (100 * maxy + forms[i].yrange / 2) / forms[i].yrange;
        Translate(*forms[i], 0, 0, scalex, scaley);
    }
    count := forms.count;
    average := Copy(*forms[0]);
    for k: 0..NCANONICAL - 1 {
        xsum: s64 = 0; ysum: s64 = 0;
        for i: 0..count - 1 {
            // The Limbo code averaged into the first example as it went.
            p := ifx i == 0 then average.pts[k] else forms[i].pts[k];
            xsum += p.x;
            ysum += p.y;
        }
        average.pts[k].x = (xsum + count / 2) / count;
        average.pts[k].y = (ysum + count / 2) / count;
    }
    unused ScaleUp(*average);
    Center(*average);
    interpolated := Interpolate(*average);
    return Dominant(*interpolated);
}
