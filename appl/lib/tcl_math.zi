// Real-valued function vocabulary from Inferno tcl_calc.b. See ../../NOTICE (MIT).
using M :: #import "std/math"
using T :: #import "tcl_types"

Arity :: (name: string) -> s32 {
    if T.WordIn("atan2 fmod hypot pow", name) { return 2 }
    if T.WordIn("abs acos asin atan ceil cos cosh exp floor log log10 sin sinh sqrt tan tanh", name) { return 1 }
    return 0;
}

Absolute :: (value: float64) -> float64 {
    if value == 0.0 { return 0.0 }
    return ifx value < 0.0 then -value else value;
}

Finite :: (value: float64) -> bool {
    return value > -M.Infinity() && value < M.Infinity();
}

RoundDirected :: (value: float64, upward: bool) -> float64 {
    // At this magnitude all finite binary64 values are already integral.
    if !Finite(value) || value == 0.0 || Absolute(value) >= 4503599627370496.0 { return value }
    integral := cast(float64)cast(s64)value;
    if upward && integral < value { return integral+1.0 }
    if !upward && integral > value { return integral-1.0 }
    return integral;
}

Hypot :: (first: float64, second: float64) -> float64 {
    x := Absolute(first);
    y := Absolute(second);
    if x == M.Infinity() || y == M.Infinity() { return M.Infinity() }
    if x != x || y != y { return M.NotANumber() }
    large := ifx x >= y then x else y;
    small := ifx x >= y then y else x;
    if large == 0.0 { return 0.0 }
    ratio := small/large;
    return large*M.Sqrt(1.0+ratio*ratio);
}

Remainder :: (first: float64, second: float64) -> float64 {
    if !Finite(first) || second != second || second == 0.0 { return M.NotANumber() }
    if !Finite(second) || first == 0.0 { return first }
    remaining := Absolute(first);
    divisor := Absolute(second);
    if remaining < divisor { return first }
    // Subtract scaled divisors instead of converting a potentially huge quotient.
    steps: s32;
    while divisor <= remaining*0.5 { divisor *= 2.0; steps += 1 }
    while steps >= 0 {
        if remaining >= divisor { remaining -= divisor }
        divisor *= 0.5;
        steps -= 1;
    }
    return ifx first < 0.0 then -remaining else remaining;
}

Call :: (name: string, first: float64, second: float64) -> float64 {
    if name == "abs" { return Absolute(first) }
    if name == "acos" { return M.Acos(first) }
    if name == "asin" { return M.Asin(first) }
    if name == "atan" { return M.Atan(first) }
    if name == "atan2" { return M.Atan2(first, second) }
    if name == "ceil" { return RoundDirected(first, true) }
    if name == "cos" { return M.Cos(first) }
    if name == "cosh" { return M.Cosh(first) }
    if name == "exp" { return M.Exp(first) }
    if name == "floor" { return RoundDirected(first, false) }
    if name == "fmod" { return Remainder(first, second) }
    if name == "hypot" { return Hypot(first, second) }
    if name == "log" { return M.Log(first) }
    if name == "log10" { return M.Log10(first) }
    if name == "pow" { return M.Pow(first, second) }
    if name == "sin" { return M.Sin(first) }
    if name == "sinh" { return M.Sinh(first) }
    if name == "sqrt" { return M.Sqrt(first) }
    if name == "tan" { return M.Tan(first) }
    return M.Tanh(first);
}
