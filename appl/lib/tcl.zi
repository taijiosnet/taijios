// Ported from Inferno's Tcl_Core, TclLib and Tcl_Stack. See ../../NOTICE (MIT).
#import "std/vec"
using T :: #import "tcl_types"
using L :: #import "tcl_lists"
using C :: #import "tcl_calc"
using S :: #import "tcl_strings"

Variable :: struct { name: Text; value: Text; }
Frame :: struct { variables: Vec(Variable); }
Parameter :: struct { name: Text; fallback: Text; optional: bool; }
Procedure :: struct { name: Text; parameters: Vec(Parameter); body: Text; variadic: bool; }

// Command words exclude the command name. A handler fills an owned result.
// The client can use the context ID as a lookup key for its own widget state.
CommandHandler :: #type (context: s64, args: []Text, result: *Result) -> void;
Extension :: struct { name: Text; context: s64; handler: CommandHandler; }

// A prefix can supply dynamically named commands. A nonempty script is
// evaluated in the current frame and its result becomes the command result.
PrefixHandler :: #type (context: s64, name: string, args: []Text, result: *Result, script: *Text) -> void;
CommandPrefix :: struct { name: Text; context: s64; handler: PrefixHandler; }

Interpreter :: struct {
    globals: Frame;
    procedures: Vec(Procedure);
    extensions: Vec(Extension);
    prefixes: Vec(CommandPrefix);
    output: Text;
    steps: s64;
}

// A zero-initialized Interpreter is ready to use. Eval keeps globals and
// procedures between calls. Break/continue outside a loop are script errors.
Eval :: (interpreter: *Interpreter, script: string) -> Result {
    interpreter.steps = 10000;
    result := EvalScript(interpreter, *interpreter.globals, script, 0);
    if result.code == .Return { result.code = .OK }
    return OutsideLoop(result);
}

TakeOutput :: (interpreter: *Interpreter) -> Text {
    result: Text;
    VecSwap(result.bytes, interpreter.output.bytes);
    return result;
}

RegisterCommand :: (interpreter: *Interpreter, name: string, handler: CommandHandler, context: s64 = 0) -> bool {
    if name == "" || handler == null || IsBuiltin(name) { return false }
    if FindProcedure(interpreter, name) >= 0 { return false }
    for * interpreter.extensions {
        if TextView(it.name) == name { return false }
    }
    return VecPush(interpreter.extensions, Extension.{name = TextCopy(name), context = context, handler = handler});
}

RegisterPrefix :: (interpreter: *Interpreter, prefix: string, handler: PrefixHandler, context: s64 = 0) -> bool {
    if prefix == "" || handler == null { return false }
    for * interpreter.prefixes {
        if TextView(it.name) == prefix { return false }
    }
    return VecPush(interpreter.prefixes, CommandPrefix.{name = TextCopy(prefix), context = context, handler = handler});
}

OutsideLoop :: (result: Result) -> Result {
    if result.code == .Break { return Failure("invoked \"break\" outside of a loop") }
    if result.code == .Continue { return Failure("invoked \"continue\" outside of a loop") }
    return result;
}

CopyResult :: (result: *Result) -> Result {
    return .{code = result.code, value = TextCopy(TextView(result.value))};
}

IsListCommand :: (name: string) -> bool {
    return name == "list" || name == "llength" || name == "lindex" || name == "lrange" || name == "join";
}

IsBuiltin :: (name: string) -> bool {
    return IsListCommand(name) || name == "set" || name == "unset" || name == "incr" ||
        name == "append" || name == "lappend" || name == "proc" || name == "if" || name == "while" ||
        name == "for" || name == "foreach" || name == "catch" || name == "eval" || name == "error" ||
        name == "return" || name == "break" || name == "continue" || name == "puts" ||
        name == "expr" || name == "calc" || name == "string";
}

ScalarName :: (name: string) -> bool {
    if name.count > 0 && name[name.count-1] == 41 {
        for name { if it == 40 { return false } }
    }
    for 1..name.count-1 { if name[it-1] == 58 && name[it] == 58 { return false } }
    return true;
}

FindVariable :: (frame: *Frame, name: string) -> s64 {
    for * frame.variables { if TextView(it.name) == name { return it_index } }
    return -1;
}

ReadVariable :: (frame: *Frame, name: string) -> Result {
    if !ScalarName(name) { return Failure("array and namespace variables are unsupported") }
    index := FindVariable(frame, name);
    if index >= 0 { return Success(TextView(frame.variables[index].value)) }
    return QuotedError("can't read \"", name, "\": no such variable");
}

StoreVariable :: (frame: *Frame, name: string, value: string) -> Result {
    if !ScalarName(name) { return Failure("array and namespace variables are unsupported") }
    index := FindVariable(frame, name);
    if index >= 0 {
        copy: Text = TextCopy(value);
        VecSwap(frame.variables[index].value.bytes, copy.bytes);
    } else if !VecPush(frame.variables, Variable.{name = TextCopy(name), value = TextCopy(value)}) {
        return Failure("cannot allocate variable");
    }
    return Success(value);
}

RemoveVariable :: (frame: *Frame, name: string) -> Result {
    if !ScalarName(name) { return Failure("array and namespace variables are unsupported") }
    index := FindVariable(frame, name);
    if index < 0 {
        return QuotedError("can't unset \"", name, "\": no such variable");
    }
    last := frame.variables.count - 1;
    if index != last {
        VecSwap(frame.variables[index].name.bytes, frame.variables[last].name.bytes);
        VecSwap(frame.variables[index].value.bytes, frame.variables[last].value.bytes);
    }
    unused VecResize(frame.variables, last);
    return Success();
}

VariableSubstitution :: (frame: *Frame, cursor: *Cursor) -> Result {
    cursor.at += 1;
    if Has(cursor) && Peek(cursor) == 123 {
        cursor.at += 1;
        start := cursor.at;
        while Has(cursor) && Peek(cursor) != 125 { cursor.at += 1 }
        if !Has(cursor) { return Failure("missing close-brace for variable name") }
        finish := cursor.at;
        cursor.at += 1;
        return ReadVariable(frame, cursor.text[start:finish]);
    }
    start := cursor.at;
    while Has(cursor) {
        if NameByte(Peek(cursor)) { cursor.at += 1; continue }
        if Peek(cursor) == 58 && cursor.at + 1 < cursor.text.count && cursor.text[cursor.at+1] == 58 {
            return Failure("namespace variables are unsupported");
        }
        break;
    }
    if start == cursor.at { return Success("$") }
    if Has(cursor) && Peek(cursor) == 40 { return Failure("array variables are unsupported") }
    return ReadVariable(frame, cursor.text[start:cursor.at]);
}

AtEnd :: (cursor: *Cursor, nested: bool) -> bool {
    return !Has(cursor) || Peek(cursor) == 10 || Peek(cursor) == 59 || (nested && Peek(cursor) == 93);
}

SkipWordSpace :: (cursor: *Cursor) {
    while Has(cursor) {
        if InlineSpace(Peek(cursor)) { cursor.at += 1 }
        else if ContinuesLine(cursor) { SkipContinuation(cursor) }
        else { break }
    }
}

ReadWord :: (interpreter: *Interpreter, frame: *Frame, cursor: *Cursor, depth: s32, nested: bool) -> Result {
    if Peek(cursor) == 123 {
        word := Braced(cursor);
        if word.code == .OK && !AtEnd(cursor, nested) && !InlineSpace(Peek(cursor)) && !ContinuesLine(cursor) {
            return Failure("extra characters after close-brace");
        }
        return word;
    }
    quoted := Peek(cursor) == 34;
    if quoted { cursor.at += 1 }
    word: Text;
    while Has(cursor) {
        byte := Peek(cursor);
        if quoted && byte == 34 {
            cursor.at += 1;
            if !AtEnd(cursor, nested) && !InlineSpace(Peek(cursor)) && !ContinuesLine(cursor) {
                return Failure("extra characters after close-quote");
            }
            return .{value = word};
        }
        if !quoted && (AtEnd(cursor, nested) || InlineSpace(byte) || ContinuesLine(cursor)) { break }
        part := Substitute(interpreter, frame, cursor, depth, *word.bytes);
        if part.code != .OK { return part }
    }
    if quoted { return Failure("missing close-quote") }
    return .{value = word};
}

Substitute :: (interpreter: *Interpreter, frame: *Frame, cursor: *Cursor, depth: s32, out: *Vec(u8)) -> Result {
    byte := Peek(cursor);
    if byte == 36 || byte == 91 {
        result := SubstitutionValue(interpreter, frame, cursor, depth);
        if result.code != .OK { return CopyResult(*result) }
        if !BuilderAppend(<<out, TextView(result.value)) { return Failure("cannot allocate word") }
        return .{};
    }
    if byte == 92 { byte = Unescape(cursor) } else { cursor.at += 1 }
    if !VecPush(<<out, byte) { return Failure("cannot allocate word") }
    return .{};
}

SubstitutionValue :: (interpreter: *Interpreter, frame: *Frame, cursor: *Cursor, depth: s32) -> Result {
    if Peek(cursor) == 36 { return VariableSubstitution(frame, cursor) }
    cursor.at += 1;
    return EvalCursor(interpreter, frame, cursor, depth + 1, true);
}

EvalScript :: (interpreter: *Interpreter, frame: *Frame, script: string, depth: s32) -> Result {
    cursor := Cursor.{text = script};
    return EvalCursor(interpreter, frame, *cursor, depth, false);
}

EvalCursor :: (interpreter: *Interpreter, frame: *Frame, cursor: *Cursor, depth: s32, nested: bool) -> Result {
    if depth > 48 { return Failure("script nesting limit exceeded") }
    result: Result;
    closed := !nested;
    while Has(cursor) {
        SkipWordSpace(cursor);
        if !Has(cursor) { break }
        byte := Peek(cursor);
        if nested && byte == 93 { cursor.at += 1; closed = true; break }
        if byte == 10 || byte == 59 { cursor.at += 1; continue }
        if byte == 35 {
            while Has(cursor) && Peek(cursor) != 10 {
                if ContinuesLine(cursor) { SkipContinuation(cursor) } else { cursor.at += 1 }
            }
            continue;
        }
        if interpreter.steps <= 0 { return Failure("script command limit exceeded") }
        interpreter.steps -= 1;
        words: Vec(Text);
        while !AtEnd(cursor, nested) {
            word := ReadWord(interpreter, frame, cursor, depth, nested);
            if word.code != .OK { return CopyResult(*word) }
            if !VecPush(words, word.value) { return Failure("cannot allocate command arguments") }
            SkipWordSpace(cursor);
        }
        command := Dispatch(interpreter, frame, VecSlice(words, 0, words.count), depth);
        if command.code != .OK { return CopyResult(*command) }
        VecSwap(result.value.bytes, command.value.bytes);
    }
    if !closed { return Failure("missing close-bracket") }
    return result;
}

ExpressionValue :: (interpreter: *Interpreter, frame: *Frame, text: string, depth: s32) -> Result {
    cursor := Cursor.{text = text};
    expanded: Text;
    while Has(*cursor) {
        byte := Peek(*cursor);
        if byte == 36 || byte == 91 {
            part := SubstitutionValue(interpreter, frame, *cursor, depth);
            if part.code != .OK { return CopyResult(*part) }
            literal := TextView(part.value);
            number, valid := ParseInteger(literal);
            if !valid && literal != "true" && literal != "false" && literal != "yes" &&
                literal != "no" && literal != "on" && literal != "off" {
                return Failure("expected integer or boolean expression operand");
            }
            if !VecPush(expanded.bytes, cast(u8)40) { return Failure("cannot allocate expression") }
            if valid {
                integer := Integer(number);
                if !BuilderAppend(expanded.bytes, TextView(integer.value)) { return Failure("cannot allocate expression") }
            } else if !BuilderAppend(expanded.bytes, literal) { return Failure("cannot allocate expression") }
            if !VecPush(expanded.bytes, cast(u8)41) { return Failure("cannot allocate expression") }
        } else {
            part := Substitute(interpreter, frame, *cursor, depth, *expanded.bytes);
            if part.code != .OK { return part }
        }
    }
    value, problem := EvaluateInteger(TextView(expanded));
    if problem != "" { return Failure(problem) }
    return Integer(value);
}

FindProcedure :: (interpreter: *Interpreter, name: string) -> s64 {
    for * interpreter.procedures { if TextView(it.name) == name { return it_index } }
    return -1;
}

DefineProcedure :: (interpreter: *Interpreter, args: []Text) -> Result {
    if args.count != 3 { return WrongArgs("proc name args body") }
    name := TextView(args[0]);
    if name == "" || IsBuiltin(name) { return Failure("cannot define procedure with that name") }
    for * interpreter.extensions {
        if TextView(it.name) == name { return Failure("procedure name is reserved by an extension") }
    }
    formals := ParseList(TextView(args[1]));
    if formals.problem != "" { return Failure(formals.problem) }
    procedure := Procedure.{name = TextCopy(name), body = TextCopy(TextView(args[2]))};
    for 0..formals.words.count-1 {
        parts := ParseList(TextView(formals.words[it]));
        if parts.problem != "" { return Failure(parts.problem) }
        if parts.words.count < 1 || parts.words.count > 2 { return Failure("invalid procedure formal parameter") }
        formal := TextView(parts.words[0]);
        if formal == "" || !ScalarName(formal) { return Failure("invalid procedure formal parameter") }
        if formal == "args" && it == formals.words.count - 1 && parts.words.count == 1 {
            procedure.variadic = true;
            break;
        }
        parameter := Parameter.{name = TextCopy(formal), optional = parts.words.count == 2};
        if parameter.optional { parameter.fallback = TextCopy(TextView(parts.words[1])) }
        if !VecPush(procedure.parameters, parameter) { return Failure("cannot allocate procedure parameters") }
    }
    index := FindProcedure(interpreter, name);
    if index >= 0 {
        VecSwap(interpreter.procedures[index].parameters, procedure.parameters);
        VecSwap(interpreter.procedures[index].body.bytes, procedure.body.bytes);
        interpreter.procedures[index].variadic = procedure.variadic;
    } else if !VecPush(interpreter.procedures, procedure) { return Failure("cannot allocate procedure") }
    return Success();
}

CallProcedure :: (interpreter: *Interpreter, index: s64, args: []Text, depth: s32) -> Result {
    frame: Frame;
    procedure := *interpreter.procedures[index];
    argc := procedure.parameters.count;
    for 0..argc-1 {
        parameter := *procedure.parameters[it];
        if it >= args.count && !parameter.optional { return Failure("wrong # args for procedure") }
        value: string;
        if it < args.count { value = TextView(args[it]) } else { value = TextView(parameter.fallback) }
        stored := StoreVariable(*frame, TextView(parameter.name), value);
        if stored.code != .OK { return stored }
    }
    if procedure.variadic {
        extra: Text;
        for argc..args.count-1 { AppendElement(*extra.bytes, TextView(args[it]), it > argc) }
        stored := StoreVariable(*frame, "args", TextView(extra));
        if stored.code != .OK { return stored }
    } else if args.count > argc { return Failure("wrong # args for procedure") }
    // The body can itself redefine this procedure and grow the procedure table.
    body: Text = TextCopy(TextView(procedure.body));
    result := EvalScript(interpreter, *frame, TextView(body), depth + 1);
    if result.code == .Return { result.code = .OK }
    return OutsideLoop(result);
}

RunIf :: (interpreter: *Interpreter, frame: *Frame, args: []Text, depth: s32) -> Result {
    at: s64;
    selected: s64 = -1;
    while true {
        if at >= args.count { return WrongArgs("if test ?then? body ?elseif test ?then? body ...? ?else? ?body?") }
        condition := at;
        at += 1;
        if at < args.count && TextView(args[at]) == "then" { at += 1 }
        if at >= args.count { return Failure("missing body in if command") }
        if selected < 0 {
            test := ExpressionValue(interpreter, frame, TextView(args[condition]), depth);
            if test.code != .OK { return CopyResult(*test) }
            if TextView(test.value) != "0" { selected = at }
        }
        at += 1;
        if at == args.count { break }
        keyword := TextView(args[at]);
        if keyword == "elseif" { at += 1; continue }
        if keyword == "else" { at += 1 }
        if at + 1 != args.count { return Failure("wrong # args after if body") }
        if selected < 0 { selected = at }
        break;
    }
    if selected < 0 { return Success() }
    return EvalScript(interpreter, frame, TextView(args[selected]), depth + 1);
}

RunLoop :: (interpreter: *Interpreter, frame: *Frame, test_source: string, body: string, next: string, depth: s32) -> Result {
    while interpreter.steps > 0 {
        interpreter.steps -= 1;
        test := ExpressionValue(interpreter, frame, test_source, depth);
        if test.code != .OK { return CopyResult(*test) }
        if TextView(test.value) == "0" { return Success() }
        result := EvalScript(interpreter, frame, body, depth + 1);
        if result.code == .Break { return Success() }
        if result.code != .OK && result.code != .Continue { return result }
        if next != "" {
            advanced := EvalScript(interpreter, frame, next, depth + 1);
            if advanced.code == .Break { return Success() }
            if advanced.code != .OK { return OutsideLoop(advanced) }
        }
    }
    return Failure("script command limit exceeded");
}

RunFor :: (interpreter: *Interpreter, frame: *Frame, args: []Text, depth: s32) -> Result {
    if args.count != 4 { return WrongArgs("for start test next body") }
    initial := EvalScript(interpreter, frame, TextView(args[0]), depth + 1);
    if initial.code != .OK { return OutsideLoop(initial) }
    return RunLoop(interpreter, frame, TextView(args[1]), TextView(args[3]), TextView(args[2]), depth);
}

RunForeach :: (interpreter: *Interpreter, frame: *Frame, args: []Text, depth: s32) -> Result {
    if args.count != 3 { return WrongArgs("foreach varList list body") }
    names := ParseList(TextView(args[0]));
    if names.problem != "" { return Failure(names.problem) }
    if names.words.count == 0 { return Failure("foreach varList is empty") }
    values := ParseList(TextView(args[1]));
    if values.problem != "" { return Failure(values.problem) }
    at: s64;
    while at < values.words.count {
        if interpreter.steps <= 0 { return Failure("script command limit exceeded") }
        interpreter.steps -= 1;
        for * names.words {
            value: string = "";
            if at < values.words.count { value = TextView(values.words[at]) }
            stored := StoreVariable(frame, TextView(<<it), value);
            if stored.code != .OK { return stored }
            at += 1;
        }
        result := EvalScript(interpreter, frame, TextView(args[2]), depth + 1);
        if result.code == .Break { break }
        if result.code != .OK && result.code != .Continue { return result }
    }
    return Success();
}

Increment :: (frame: *Frame, args: []Text) -> Result {
    if args.count < 1 || args.count > 2 { return WrongArgs("incr varName ?increment?") }
    name := TextView(args[0]);
    if !ScalarName(name) { return Failure("array and namespace variables are unsupported") }
    index := FindVariable(frame, name);
    value: s64;
    delta: s64 = 1;
    if index >= 0 {
        parsed, valid := ParseInteger(TextView(frame.variables[index].value));
        if !valid { return Failure("expected integer variable value") }
        value = parsed;
    }
    if args.count == 2 {
        parsed, valid := ParseInteger(TextView(args[1]));
        if !valid { return Failure("expected integer increment") }
        delta = parsed;
    }
    if !InRange(value + delta) { return Failure("integer overflow") }
    result := Integer(value + delta);
    return StoreVariable(frame, name, TextView(result.value));
}

AppendVariable :: (frame: *Frame, args: []Text, as_list: bool) -> Result {
    if args.count < 1 {
        if as_list { return WrongArgs("lappend varName ?value ...?") }
        return WrongArgs("append varName ?value ...?");
    }
    name := TextView(args[0]);
    if !ScalarName(name) { return Failure("array and namespace variables are unsupported") }
    index := FindVariable(frame, name);
    result: Text;
    if index >= 0 {
        existing := TextView(frame.variables[index].value);
        if as_list {
            items := ParseList(existing);
            if items.problem != "" { return Failure(items.problem) }
            for 0..items.words.count-1 { AppendElement(*result.bytes, TextView(items.words[it]), it > 0) }
        } else { unused BuilderAppend(result.bytes, existing) }
    }
    for 1..args.count-1 {
        if as_list { AppendElement(*result.bytes, TextView(args[it]), result.bytes.count > 0) }
        else { unused BuilderAppend(result.bytes, TextView(args[it])) }
    }
    return StoreVariable(frame, name, TextView(result));
}

JoinWords :: (args: []Text) -> Text {
    result: Text;
    for 0..args.count-1 {
        if it > 0 { unused VecPush(result.bytes, cast(u8)32) }
        unused BuilderAppend(result.bytes, TextView(args[it]));
    }
    return result;
}

Dispatch :: (interpreter: *Interpreter, frame: *Frame, words: []Text, depth: s32) -> Result {
    name := TextView(words[0]);
    args := words[1:];
    if IsListCommand(name) { return RunList(name, args) }
    if name == "string" { return RunString(args) }
    if name == "set" {
        if args.count == 1 { return ReadVariable(frame, TextView(args[0])) }
        if args.count == 2 { return StoreVariable(frame, TextView(args[0]), TextView(args[1])) }
        return WrongArgs("set varName ?newValue?");
    }
    if name == "unset" {
        if args.count == 0 { return WrongArgs("unset varName ?varName ...?") }
        for 0..args.count-1 {
            removed := RemoveVariable(frame, TextView(args[it]));
            if removed.code != .OK { return removed }
        }
        return Success();
    }
    if name == "incr" { return Increment(frame, args) }
    if name == "append" || name == "lappend" { return AppendVariable(frame, args, name == "lappend") }
    if name == "proc" { return DefineProcedure(interpreter, args) }
    if name == "if" { return RunIf(interpreter, frame, args, depth) }
    if name == "while" {
        if args.count != 2 { return WrongArgs("while test body") }
        return RunLoop(interpreter, frame, TextView(args[0]), TextView(args[1]), "", depth);
    }
    if name == "for" { return RunFor(interpreter, frame, args, depth) }
    if name == "foreach" { return RunForeach(interpreter, frame, args, depth) }
    if name == "catch" {
        if args.count < 1 || args.count > 2 { return WrongArgs("catch script ?resultVarName?") }
        caught := EvalScript(interpreter, frame, TextView(args[0]), depth + 1);
        if args.count == 2 {
            stored := StoreVariable(frame, TextView(args[1]), TextView(caught.value));
            if stored.code != .OK { return stored }
        }
        return Integer(cast(s64)caught.code);
    }
    if name == "eval" || name == "expr" || name == "calc" {
        if args.count == 0 {
            if name == "eval" { return WrongArgs("eval arg ?arg ...?") }
            if name == "calc" { return WrongArgs("calc arg ?arg ...?") }
            return WrongArgs("expr arg ?arg ...?");
        }
        source: Text = JoinWords(args);
        if name == "eval" { return EvalScript(interpreter, frame, TextView(source), depth + 1) }
        return ExpressionValue(interpreter, frame, TextView(source), depth);
    }
    if name == "error" {
        if args.count != 1 { return WrongArgs("error message") }
        return Failure(TextView(args[0]));
    }
    if name == "return" {
        if args.count > 1 { return WrongArgs("return ?result?") }
        value: string = "";
        if args.count == 1 { value = TextView(args[0]) }
        return .{code = .Return, value = TextCopy(value)};
    }
    if name == "break" {
        if args.count != 0 { return WrongArgs("break") }
        return .{code = .Break};
    }
    if name == "continue" {
        if args.count != 0 { return WrongArgs("continue") }
        return .{code = .Continue};
    }
    if name == "puts" {
        no_newline := args.count == 2 && TextView(args[0]) == "-nonewline";
        if args.count != 1 && !no_newline { return WrongArgs("puts ?-nonewline? string") }
        unused BuilderAppend(interpreter.output.bytes, TextView(args[args.count-1]));
        if !no_newline { unused VecPush(interpreter.output.bytes, cast(u8)10) }
        return Success();
    }
    index := FindProcedure(interpreter, name);
    if index >= 0 { return CallProcedure(interpreter, index, args, depth) }
    for * interpreter.extensions {
        if TextView(it.name) != name { continue }
        result: Result;
        handler := it.handler;
        handler(it.context, args, *result);
        return result;
    }
    longest: s64;
    matched: s64 = -1;
    for * interpreter.prefixes {
        prefix := TextView(it.name);
        if prefix.count > longest && prefix.count <= name.count && name[:prefix.count] == prefix {
            matched = it_index;
            longest = prefix.count;
        }
    }
    if matched >= 0 {
        result: Result;
        script: Text;
        entry := *interpreter.prefixes[matched];
        handler := entry.handler;
        handler(entry.context, name, args, *result, *script);
        if result.code == .OK && script.bytes.count > 0 {
            return EvalScript(interpreter, frame, TextView(script), depth + 1);
        }
        return result;
    }
    return QuotedError("invalid command name \"", name, "\"");
}
