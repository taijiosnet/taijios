// Dates in the text form HTTP and mail headers use, as the Limbo RFC822
// module wrote and read them through Daytime: seconds since 1970 as
// "Sun, 06 Nov 1994 08:49:37 GMT", and that form, RFC 850's
// "Sunday, 06-Nov-94 08:49:37 GMT" or asctime's "Sun Nov  6 08:49:37
// 1994" back to seconds. Seconds are 32-bit, as Limbo's were.
#import "std/vec";

DAYS: [7]string = .["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
LONG_DAYS: [7]string = .["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
MONTHS: [12]string = .["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
MONTH_DAYS: [12]s64 = .[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

YearDays :: (year: s64) -> s64 {
    return ifx year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) then 366 else 365;
}

MonthDays :: (year: s64, month: s64) -> s64 {
    return ifx month == 1 && YearDays(year) == 366 then 29 else MONTH_DAYS[month];
}

Two :: (out: *Vec(u8), value: s64) {
    VecPush(<<out, cast(u8)(#char "0" + value / 10 % 10));
    VecPush(<<out, cast(u8)(#char "0" + value % 10));
}

// Appends the date of seconds since 1970, in GMT.
Format :: (out: *Vec(u8), seconds: s64) {
    day := seconds / 86400;
    rest := seconds % 86400;
    if rest < 0 {
        rest += 86400;
        day -= 1;
    }
    weekday := (day + 7340036) % 7; // 1 January 1970 was a Thursday
    year: s64 = 1970;
    while day >= YearDays(year) { day -= YearDays(year); year += 1 }
    while day < 0 { year -= 1; day += YearDays(year) }
    month: s64 = 0;
    while day >= MonthDays(year, month) { day -= MonthDays(year, month); month += 1 }
    BuilderPrint(out, "%, ", DAYS[weekday]);
    Two(out, day + 1);
    BuilderPrint(out, " % ", MONTHS[month]);
    Two(out, year / 100);
    Two(out, year);
    VecPush(<<out, #char " ");
    Two(out, rest / 3600);
    VecPush(<<out, #char ":");
    Two(out, rest / 60 % 60);
    VecPush(<<out, #char ":");
    Two(out, rest % 60);
    BuilderAppend(<<out, " GMT");
}

Alnum :: (c: u8) -> bool {
    return (c >= #char "A" && c <= #char "Z") || (c >= #char "a" && c <= #char "z") || (c >= #char "0" && c <= #char "9");
}

Digit :: (c: u8) -> bool { return c >= #char "0" && c <= #char "9" }

// The next run of letters and digits and the text after it.
Word :: (text: string) -> (word: string, rest: string) {
    start: s64 = 0;
    while start < text.count && !Alnum(text[start]) { start += 1 }
    end := start;
    while end < text.count && Alnum(text[end]) { end += 1 }
    return text[start:end], text[end:];
}

// The next run of digits as a number, 0 when there is none, and the text
// after it.
Number :: (text: string) -> (value: s64, rest: string) {
    start: s64 = 0;
    while start < text.count && !Digit(text[start]) { start += 1 }
    end := start;
    value: s64 = 0;
    while end < text.count && Digit(text[end]) {
        value = value * 10 + cast(s64)(text[end] - #char "0");
        end += 1;
    }
    return value, text[end:];
}

Lookup :: (names: []string, name: string) -> s64 {
    for names { if it == name { return it_index } }
    return -1;
}

// What a time zone means: its offset from GMT in seconds, and whether it
// is GMT or an offset written from it. An empty zone, GMT, UT, UTC, Z and
// +hhmm or -hhmm are; the continental US zone names are not. known is
// false for any other name.
Zone :: (text: string) -> (offset: s64, gmt: bool, known: bool) {
    zone := text;
    while zone.count > 0 && (zone[0] == #char " " || zone[0] == #char "\t") { zone = zone[1:] }
    while zone.count > 0 && (zone[zone.count - 1] == #char " " || zone[zone.count - 1] == #char "\t") { zone = zone[:zone.count - 1] }
    if zone == "" || zone == "GMT" || zone == "UT" || zone == "UTC" || zone == "Z" { return 0, true, true }
    if zone.count == 5 && (zone[0] == #char "+" || zone[0] == #char "-") {
        hours, after_hours := Number(zone[1:3]);
        minutes, after_minutes := Number(zone[3:5]);
        if hours > 23 || minutes > 59 { return 0, false, false }
        offset := hours * 3600 + minutes * 60;
        return ifx zone[0] == #char "-" then -offset else offset, true, true;
    }
    us := string.["CST", "CDT", "EST", "EDT", "MST", "MDT", "PST", "PDT"];
    return 0, false, Lookup(us[:], zone) >= 0;
}

// The seconds since 1970 of a date in one of the three forms, or 0 when
// it is not one, is before 1970 or is not given in GMT. Names of days
// and months must be capitalised as above. A zone name the Limbo module
// would have looked up as the local zone is taken as unknown: an asctime
// date with one counts as GMT and the other forms are refused.
Parse :: (date: string) -> s64 {
    day_name, after_day := Word(date);
    if Lookup(DAYS[:], day_name) < 0 && Lookup(LONG_DAYS[:], day_name) < 0 { return 0 }
    first, after_first := Word(after_day);
    month := Lookup(MONTHS[:], first);
    day: s64 = 0;
    year: s64 = 0;
    hour: s64 = 0;
    minute: s64 = 0;
    second: s64 = 0;
    offset: s64 = 0;
    if month >= 0 {
        // asctime: Mon DD HH:MM:SS [zone] YYYY
        day_value, after_date := Number(after_first);
        h, after_h := Number(after_date);
        m, after_m := Number(after_h);
        s, after_s := Number(after_m);
        rest := after_s;
        while rest.count > 0 && rest[0] == #char " " { rest = rest[1:] }
        if rest.count > 0 && !Digit(rest[0]) {
            for i: 0..rest.count - 1 {
                if rest[i] != #char " " { continue }
                zone_offset, gmt, known := Zone(rest[:i]);
                if known && !gmt { return 0 }
                offset = zone_offset;
                rest = rest[i:];
                break;
            }
        }
        year_value, after_year := Number(rest);
        day = day_value;
        hour = h;
        minute = m;
        second = s;
        year = year_value;
    } else {
        // DD Mon YYYY or DD-Mon-YY, then HH:MM:SS zone
        day_value, after_date := Number(after_day);
        month_name, after_month := Word(after_date);
        month = Lookup(MONTHS[:], month_name);
        if month < 0 { return 0 }
        year_value, after_year := Number(after_month);
        h, after_h := Number(after_year);
        m, after_m := Number(after_h);
        s, after_s := Number(after_m);
        zone_offset, gmt, known := Zone(after_s);
        if !gmt { return 0 }
        offset = zone_offset;
        day = day_value;
        hour = h;
        minute = m;
        second = s;
        year = year_value;
    }
    if day < 1 || day > 31 || hour >= 24 || minute >= 60 || second >= 60 { return 0 }
    if year > 1900 { year -= 1900 }
    if year < 70 { return 0 }
    seconds: s64 = 0;
    for y: 1970..year + 1900 - 1 { seconds += YearDays(y) * 86400 }
    for i: 0..month - 1 { seconds += MonthDays(year + 1900, i) * 86400 }
    seconds += (day - 1) * 86400 + hour * 3600 + minute * 60 + second - offset;
    low := seconds & 0xFFFFFFFF;
    return ifx low >= 0x80000000 then low - 0x100000000 else low;
}
