// Tcl channel behavior adapted from Inferno tcl_io.b. See ../../NOTICE (MIT).
#import "std/vec"
#import "tcl_types"

OpenCallback :: #type (context: s64, path: string, mode: s32) -> s32;
CreateCallback :: #type (context: s64, path: string, mode: s32, permissions: s32) -> s32;
ReadCallback :: #type (context: s64, handle: s32, buffer: []u8) -> s32;
WriteCallback :: #type (context: s64, handle: s32, data: string) -> s32;
CloseCallback :: #type (context: s64, handle: s32) -> s32;
SeekCallback :: #type (context: s64, handle: s32, offset: s64, origin: s32) -> s64;
StatCallback :: #type (context: s64, path: string, metadata: []u8) -> s32;
ErrorCallback :: #type (context: s64) -> string;

Backend :: struct {
    context: s64;
    open: OpenCallback;
    create: CreateCallback;
    read: ReadCallback;
    write: WriteCallback;
    close: CloseCallback;
    seek: SeekCallback;
    stat: StatCallback;
    error: ErrorCallback;
    stdin: bool;
}

Channel :: struct {
    active: bool;
    handle: s32;
    mode: s32;
    eof: bool;
    pending: Vec(u8);
    next: s64;
    end: s64;
}

ChannelTable :: struct {
    backend: Backend;
    files: Vec(Channel);
    input: Channel;
    stdout_closed: bool;
}

COMMANDS :: "close eof file flush gets open puts read seek tell";
CHUNK :: 4096;
MAX_READ :: 1048576;

BackendError :: (table: *ChannelTable, operation: string) -> Result {
    get_error := table.backend.error;
    if get_error == null { return Failure(operation) }
    details := get_error(table.backend.context);
    if details == "" { return Failure(operation) }
    message: Text;
    unused BuilderAppend(message.bytes, operation);
    unused BuilderAppend(message.bytes, ": ");
    unused BuilderAppend(message.bytes, details);
    return .{code = .Error, value = message};
}

ChannelError :: (name: string) -> Result {
    return QuotedError("bad file identifier \"", name, "\"");
}

FindChannel :: (table: *ChannelTable, name: string) -> *Channel {
    if name == "stdin" && table.input.active { return *table.input }
    if name.count < 5 || name[:4] != "file" { return null }
    if name.count > 5 && name[4] == 48 { return null }
    for i: 4..name.count-1 { if !Digit(name[i]) { return null } }
    number, valid := ParseInteger(name[4:]);
    if !valid || number == 1 { return null }
    index := ifx number == 0 then 0 else number-1;
    if index >= table.files.count || !table.files[index].active { return null }
    return *table.files[index];
}

OpenMode :: (name: string) -> (mode: s32, create: bool) {
    if name == "OREAD" || name == "r" { return 0, false }
    if name == "OWRITE" { return 1, false }
    if name == "ORDWR" || name == "r+" { return 2, false }
    if name == "w" { return 1, true }
    if name == "w+" { return 2, true }
    return -1, false;
}

Permissions :: (text: string) -> s32 {
    if text.count > 1 && text[0] == 48 {
        number: s32;
        for i: 1..text.count-1 {
            if text[i] < 48 || text[i] > 55 { return -1 }
            number = number*8 + cast(s32)(text[i]-48);
            if number > 511 { return -1 }
        }
        return number;
    }
    number, valid := ParseInteger(text);
    return ifx valid && number >= 0 && number <= 511 then cast(s32)number else -1;
}

OpenChannel :: (table: *ChannelTable, args: []Text) -> Result {
    if args.count < 1 || args.count > 3 { return WrongArgs("open filename ?access? ?permissions?") }
    access: string = "OREAD";
    if args.count >= 2 { access = TextView(args[1]) }
    mode, create := OpenMode(access);
    if mode < 0 { return QuotedError("illegal access mode \"", access, "\"") }
    if args.count == 3 && !create { return WrongArgs("open filename ?access? ?permissions?") }
    permissions: s32 = 438;
    if args.count == 3 {
        permissions = Permissions(TextView(args[2]));
        if permissions < 0 { return Failure("invalid file permissions") }
    }
    closer := table.backend.close;
    if closer == null { return Failure("open requires an I/O backend") }
    index := table.files.count;
    for i: 0..table.files.count-1 {
        if !table.files[i].active { index = i; break }
    }
    if index == table.files.count {
        if !VecPush(table.files, Channel.{}) { return Failure("cannot allocate Tcl channel") }
    }
    path := TextView(args[0]);
    handle: s32;
    if create {
        make_file := table.backend.create;
        if make_file == null { return Failure("open for creation requires a create capability") }
        handle = make_file(table.backend.context, path, mode, permissions);
    } else {
        open_file := table.backend.open;
        if open_file == null { return Failure("open requires an I/O backend") }
        handle = open_file(table.backend.context, path, mode);
    }
    if handle < 0 {
        action := QuotedError("couldn't open \"", path, "\"");
        return BackendError(table, TextView(action.value));
    }
    slot := *table.files[index];
    slot.active = true;
    slot.handle = handle;
    slot.mode = mode;
    slot.eof = false;
    slot.next = 0;
    slot.end = 0;
    name: Text = TextCopy("file");
    number := Integer(ifx index == 0 then 0 else index+1);
    unused BuilderAppend(name.bytes, TextView(number.value));
    return .{value = name};
}

CloseChannel :: (table: *ChannelTable, channel: *Channel) -> bool {
    channel.active = false;
    closer := table.backend.close;
    return closer != null && closer(table.backend.context, channel.handle) == 0;
}

CloseAll :: (table: *ChannelTable) -> Result {
    failure: Result;
    for i: 0..table.files.count-1 {
        channel := *table.files[i];
        if channel.active && !CloseChannel(table, channel) && failure.code == .OK {
            error := BackendError(table, "couldn't close file channel");
            failure.code = error.code;
            VecSwap(failure.value.bytes, error.value.bytes);
        }
    }
    return failure;
}

AppendPending :: (channel: *Channel, output: *Text, limit: s64, line: bool) -> (ok: bool, finished: bool) {
    at := channel.next;
    count := channel.end-at;
    if count > limit { count = limit }
    end := at+count;
    found: bool;
    if line {
        for i: at..end-1 {
            if channel.pending[i] == 10 { end = i+1; found = true; break }
        }
    }
    if !BuilderAppend(output.bytes, TextView(VecSlice(channel.pending, at, end))) { return false, false }
    channel.next = end;
    return true, found;
}

ReadChannel :: (table: *ChannelTable, channel: *Channel, count: s64, line: bool) -> Result {
    read_bytes := table.backend.read;
    if read_bytes == null { return Failure("read requires an I/O backend") }
    if channel.mode == 1 { return Failure("channel isn't open for reading") }
    output: Text;
    line_end: bool;
    while output.bytes.count < count {
        if channel.next == channel.end {
            if !VecResize(channel.pending, CHUNK) { return Failure("cannot allocate channel buffer") }
            // A counted read need not consume more input than requested.
            requested := count-output.bytes.count;
            if line || requested > CHUNK { requested = CHUNK }
            size := read_bytes(table.backend.context, channel.handle, VecSlice(channel.pending, 0, requested));
            if size < 0 || size > requested { return BackendError(table, "couldn't read channel") }
            channel.next = 0;
            channel.end = size;
            if size == 0 { break }
        }
        ok, finished := AppendPending(channel, *output, count-output.bytes.count, line);
        if !ok { return Failure("cannot allocate read result") }
        if finished { line_end = true; break }
    }
    if output.bytes.count == 0 { channel.eof = true }
    if line && !line_end && output.bytes.count == count { return Failure("channel line exceeds Tcl read limit") }
    return .{value = output};
}

WriteChannel :: (table: *ChannelTable, channel: *Channel, text: string, newline: bool) -> Result {
    write_bytes := table.backend.write;
    if write_bytes == null { return Failure("puts requires an I/O backend") }
    if channel.mode == 0 { return Failure("channel isn't open for writing") }
    if channel.next != channel.end {
        seek := table.backend.seek;
        if seek == null { return Failure("writing after a buffered read requires a seek capability") }
        if seek(table.backend.context, channel.handle, channel.next-channel.end, 1) < 0 {
            return BackendError(table, "couldn't seek channel");
        }
        channel.next = 0;
        channel.end = 0;
    }
    at: s64;
    while at < text.count {
        size := write_bytes(table.backend.context, channel.handle, text[at:]);
        if size <= 0 || size > text.count-at { return BackendError(table, "couldn't write channel") }
        at += size;
    }
    if newline && write_bytes(table.backend.context, channel.handle, "\n") != 1 {
        return BackendError(table, "couldn't write channel");
    }
    return Success();
}

RunPuts :: (table: *ChannelTable, output: *Text, args: []Text) -> Result {
    no_newline := args.count > 0 && TextView(args[0]) == "-nonewline";
    first: s64 = ifx no_newline then 1 else 0;
    if args.count < first+1 || args.count > first+2 { return WrongArgs("puts ?-nonewline? ?fileId? string") }
    text := TextView(args[args.count-1]);
    if args.count == first+2 {
        name := TextView(args[first]);
        if name != "stdout" {
            channel := FindChannel(table, name);
            if channel == null { return ChannelError(name) }
            return WriteChannel(table, channel, text, !no_newline);
        }
        if table.stdout_closed { return ChannelError(name) }
    }
    if !BuilderAppend(output.bytes, text) || (!no_newline && !VecPush(output.bytes, cast(u8)10)) {
        return Failure("cannot allocate Tcl output");
    }
    return Success();
}

RunRead :: (table: *ChannelTable, command: string, args: []Text) -> Result {
    if args.count < 1 || args.count > 2 {
        if command == "gets" { return WrongArgs("gets fileId ?varName?") }
        return WrongArgs("read fileId ?numBytes?\" or \"read -nonewline fileId");
    }
    nonewline := command == "read" && TextView(args[0]) == "-nonewline";
    if nonewline && args.count != 2 { return WrongArgs("read -nonewline fileId") }
    index: s64 = ifx nonewline then 1 else 0;
    name := TextView(args[index]);
    channel := FindChannel(table, name);
    if channel == null { return ChannelError(name) }
    line := command == "gets" || nonewline || args.count == 1;
    if !line {
        count, valid := ParseInteger(TextView(args[1]));
        if !valid || count < 0 || count > MAX_READ { return Failure("invalid Tcl read byte count") }
        return ReadChannel(table, channel, count, false);
    }
    result := ReadChannel(table, channel, MAX_READ, true);
    if result.code == .OK && result.value.bytes.count > 0 {
        if command == "gets" {
            last := result.value.bytes.count-1;
            while last > 0 && (result.value.bytes[last] & 192) == 128 { last -= 1 }
            unused VecResize(result.value.bytes, last);
        } else if !nonewline && !VecPush(result.value.bytes, cast(u8)10) {
            return Failure("cannot allocate read result");
        }
    }
    return result;
}

Origin :: (name: string) -> s32 {
    if name == "SEEKSTART" || name == "start" { return 0 }
    if name == "SEEKRELA" || name == "current" { return 1 }
    if name == "SEEKEND" || name == "end" { return 2 }
    return -1;
}

RunSeek :: (table: *ChannelTable, channel: *Channel, args: []Text) -> Result {
    origin: s32;
    if args.count == 3 {
        word := TextView(args[2]);
        origin = Origin(word);
        if origin < 0 { return QuotedError("illegal access mode \"", word, "\"") }
    }
    offset, valid := ParseFileOffset(TextView(args[1]));
    if !valid { return Failure("invalid channel offset") }
    seek := table.backend.seek;
    if seek == null { return Failure("seek requires a seek capability") }
    unread := channel.end-channel.next;
    if origin == 1 {
        if offset < -9223372036854775807-1+unread { return Failure("channel offset is out of range") }
        offset -= unread;
    }
    if seek(table.backend.context, channel.handle, offset, origin) < 0 { return BackendError(table, "couldn't seek channel") }
    channel.next = 0;
    channel.end = 0;
    return Success();
}

ParseFileOffset :: (text: string) -> (offset: s64, valid: bool) {
    start: s64;
    end := text.count;
    while start < end && Space(text[start]) { start += 1 }
    while start < end && Space(text[end-1]) { end -= 1 }
    if start == end { return 0, false }
    negative := text[start] == 45;
    if negative || text[start] == 43 { start += 1 }
    if start == end { return 0, false }
    // Accumulate a negative value, since INT64_MIN has no positive counterpart.
    bound: s64 = ifx negative then -9223372036854775807-1 else -9223372036854775807;
    value: s64;
    for i: start..end-1 {
        if !Digit(text[i]) { return 0, false }
        digit := cast(s64)(text[i]-48);
        if value < bound/10 { return 0, false }
        value *= 10;
        if value < bound+digit { return 0, false }
        value -= digit;
    }
    return (ifx negative then value else -value), true;
}

RunFile :: (table: *ChannelTable, args: []Text) -> Result {
    if args.count != 2 { return WrongArgs("file exists|size|isfile|isdirectory name") }
    option := TextView(args[0]);
    if !WordIn("exists size isfile isdirectory", option) { return Failure("unsupported file option") }
    stat := table.backend.stat;
    if stat == null { return Failure("file requires a stat capability") }
    metadata: [12]u8;
    status := stat(table.backend.context, TextView(args[1]), metadata[:]);
    if status < 0 {
        if option != "size" { return Integer(0) }
        return BackendError(table, "couldn't stat file");
    }
    if option == "exists" { return Integer(1) }
    directory := (metadata[11] & 128) != 0;
    if option == "isfile" { return Integer(ifx directory then 0 else 1) }
    if option == "isdirectory" { return Integer(ifx directory then 1 else 0) }
    size: u64;
    for i: 0..7 { size = size | (cast(u64)metadata[i] << cast(u64)(i*8)) }
    return Integer(cast(s64)size);
}

Run :: (table: *ChannelTable, output: *Text, name: string, args: []Text) -> Result {
    if name == "open" { return OpenChannel(table, args) }
    if name == "puts" { return RunPuts(table, output, args) }
    if name == "file" { return RunFile(table, args) }
    if name == "gets" || name == "read" { return RunRead(table, name, args) }
    if name == "seek" {
        if args.count < 2 || args.count > 3 { return WrongArgs("seek fileId offset ?origin?") }
    } else if args.count != 1 { return QuotedError("wrong # args: should be \"", name, " fileId\"") }
    file := TextView(args[0]);
    if file == "stdout" && !table.stdout_closed {
        if name == "close" { table.stdout_closed = true; return Success() }
        if name == "eof" { return Integer(0) }
        if name == "flush" { return Success() }
    }
    channel := FindChannel(table, file);
    if channel == null { return ChannelError(file) }
    if name == "close" {
        if file == "stdin" { return ChannelError(file) }
        if !CloseChannel(table, channel) { return BackendError(table, "couldn't close channel") }
        return Success();
    }
    if name == "eof" { return Integer(ifx channel.eof then 1 else 0) }
    if name == "flush" { return Success() }
    if name == "seek" { return RunSeek(table, channel, args) }
    seek := table.backend.seek;
    if seek == null { return Failure("tell requires a seek capability") }
    position := seek(table.backend.context, channel.handle, 0, 1);
    if position < 0 { return BackendError(table, "couldn't tell channel position") }
    return Integer(position-(channel.end-channel.next));
}
