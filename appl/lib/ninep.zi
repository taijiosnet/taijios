// 9P2000 messages packed into and unpacked from their wire format, and
// written as text, as the Limbo Ninep module did. One Message holds a
// request (T-message) or a reply (R-message); kind is its wire type and
// tells which fields are in use. Unpacked text and data view the bytes
// they came from. Reading and writing files is left to the caller.
//
//     size[4] type[1] tag[2] then the fields of the type; integers are
//     little-endian and a string is a 2-byte length and its bytes
//
// Unlike the Limbo module, a Twstat whose stat is 256 bytes or longer
// unpacks, and a count past the end of its message is refused where the
// Limbo module raised an exception.
#import "std/vec";

VERSION :: "9P2000";
MAXWELEM :: 16;
NOTAG :: 0xFFFF;
NOFID :: 0xFFFFFFFF;
QIDSZ :: 13;
STATFIXLEN :: 49;  // the fixed part of a packed stat
IOHDRSZ :: 24;     // room for the header of Twrite and Rread
DEFIOUNIT :: 8192;
DEFMSIZE :: 8216;
HEADER :: 7;       // size[4] type[1] tag[2]

Tversion :: 100;
Rversion :: 101;
Tauth :: 102;
Rauth :: 103;
Tattach :: 104;
Rattach :: 105;
Rerror :: 107;
Tflush :: 108;
Rflush :: 109;
Twalk :: 110;
Rwalk :: 111;
Topen :: 112;
Ropen :: 113;
Tcreate :: 114;
Rcreate :: 115;
Tread :: 116;
Rread :: 117;
Twrite :: 118;
Rwrite :: 119;
Tclunk :: 120;
Rclunk :: 121;
Tremove :: 122;
Rremove :: 123;
Tstat :: 124;
Rstat :: 125;
Twstat :: 126;
Rwstat :: 127;

Qid :: struct {
    path: u64;
    version: s64; // 32 bits, as are the other integers below unless noted
    qtype: s64;   // 8 bits
}

Dir :: struct {
    name: string;
    uid: string;
    gid: string;
    muid: string;
    qid: Qid;
    mode: s64;
    atime: s64;
    mtime: s64;
    length: s64; // 64 bits
    dtype: s64;  // 16 bits
    dev: s64;
}

Message :: struct {
    kind: s64;
    tag: s64;           // 16 bits
    fid: s64;           // Tattach Twalk Topen Tcreate Tread Twrite Tclunk Tremove Tstat Twstat
    afid: s64;          // Tauth Tattach
    newfid: s64;        // Twalk
    oldtag: s64;        // Tflush
    msize: s64;         // Tversion Rversion
    mode: s64;          // Topen Tcreate, 8 bits
    perm: s64;          // Tcreate
    count: s64;         // Tread Rwrite
    iounit: s64;        // Ropen Rcreate
    offset: s64;        // Tread Twrite, 64 bits
    version: string;    // Tversion Rversion
    uname: string;      // Tauth Tattach
    aname: string;      // Tauth Tattach
    name: string;       // Tcreate
    ename: string;      // Rerror
    names: Vec(string); // Twalk
    qid: Qid;           // Rauth Rattach Ropen Rcreate
    qids: Vec(Qid);     // Rwalk
    data: string;       // Twrite Rread
    stat: Dir;          // Twstat Rstat
}

// The length of a message of a kind before its strings, names, qids,
// data and stat; 0 for a type 9P does not have.
HeaderLength :: (kind: s64) -> s64 {
    if kind == Tversion || kind == Rversion { return HEADER + 4 + 2 }
    if kind == Tauth { return HEADER + 4 + 2 + 2 }
    if kind == Tattach { return HEADER + 4 + 4 + 2 + 2 }
    if kind == Rauth || kind == Rattach { return HEADER + QIDSZ }
    if kind == Rerror || kind == Tflush || kind == Rwalk || kind == Rstat { return HEADER + 2 }
    if kind == Twalk { return HEADER + 4 + 4 + 2 }
    if kind == Topen { return HEADER + 4 + 1 }
    if kind == Ropen || kind == Rcreate { return HEADER + QIDSZ + 4 }
    if kind == Tcreate { return HEADER + 4 + 2 + 4 + 1 }
    if kind == Tread || kind == Twrite { return HEADER + 4 + 8 + 4 }
    if kind == Rread || kind == Rwrite { return HEADER + 4 }
    if kind == Tclunk || kind == Tremove || kind == Tstat { return HEADER + 4 }
    if kind == Twstat { return HEADER + 4 + 2 }
    if kind == Rflush || kind == Rclunk || kind == Rremove || kind == Rwstat { return HEADER }
    return 0;
}

Put :: (out: *Vec(u8), value: s64, bytes: s64) {
    for i: 0..bytes - 1 { VecPush(<<out, cast(u8)((value >> (8 * i)) & 0xFF)) }
}

PutString :: (out: *Vec(u8), text: string) {
    Put(out, text.count, 2);
    BuilderAppend(<<out, text);
}

PutQid :: (out: *Vec(u8), qid: Qid) {
    Put(out, qid.qtype, 1);
    Put(out, qid.version, 4);
    Put(out, cast(s64)(qid.path & 0xFFFFFFFF), 4);
    Put(out, cast(s64)(qid.path >> 32), 4);
}

DirSize :: (dir: *Dir) -> s64 {
    return STATFIXLEN + dir.name.count + dir.uid.count + dir.gid.count + dir.muid.count;
}

// Appends a stat: its length less 2, then its fields.
PackDir :: (out: *Vec(u8), dir: *Dir) {
    Put(out, DirSize(dir) - 2, 2);
    Put(out, dir.dtype, 2);
    Put(out, dir.dev, 4);
    PutQid(out, dir.qid);
    Put(out, dir.mode, 4);
    Put(out, dir.atime, 4);
    Put(out, dir.mtime, 4);
    Put(out, dir.length & 0xFFFFFFFF, 4);
    Put(out, (dir.length >> 32) & 0xFFFFFFFF, 4);
    PutString(out, dir.name);
    PutString(out, dir.uid);
    PutString(out, dir.gid);
    PutString(out, dir.muid);
}

// The little-endian integer of some bytes; with all 8, a negative offset
// or length comes back negative.
Get :: (f: string, at: s64, bytes: s64) -> s64 {
    value: u64 = 0;
    for i: 0..bytes - 1 { value |= cast(u64)f[at + i] << cast(u64)(8 * i) }
    return cast(s64)value;
}

GetQid :: (f: string, at: s64) -> Qid {
    qid: Qid;
    qid.qtype = Get(f, at, 1);
    qid.version = Get(f, at + 1, 4);
    qid.path = cast(u64)Get(f, at + 5, 8);
    return qid;
}

// The string at an offset and the offset after it, or -1 when the string
// or the offset itself lies outside f.
GetString :: (f: string, at: s64) -> (text: string, next: s64) {
    if at < 0 || at + 2 > f.count { return "", -1 }
    end := at + 2 + Get(f, at, 2);
    if end > f.count { return "", -1 }
    return f[at + 2:end], end;
}

// Unpacks the stat that starts f into dir and returns its length; 0 when
// f is too short or the stat's strings do not fill it exactly.
UnpackDir :: (f: string, dir: *Dir) -> s64 {
    if f.count < STATFIXLEN { return 0 }
    size := Get(f, 0, 2) + 2;
    if f.count < size { return 0 }
    dir.dtype = Get(f, 2, 2);
    dir.dev = Get(f, 4, 4);
    dir.qid = GetQid(f, 8);
    dir.mode = Get(f, 21, 4);
    dir.atime = Get(f, 25, 4);
    dir.mtime = Get(f, 29, 4);
    dir.length = Get(f, 33, 8);
    name, after_name := GetString(f, 41);
    uid, after_uid := GetString(f, after_name);
    gid, after_gid := GetString(f, after_uid);
    muid, end := GetString(f, after_gid);
    if end != size { return 0 }
    dir.name = name;
    dir.uid = uid;
    dir.gid = gid;
    dir.muid = muid;
    return size;
}

// The packed length of a message; 0 for a kind that cannot be packed.
PackedSize :: (m: *Message) -> s64 {
    size := HeaderLength(m.kind);
    if size == 0 { return 0 }
    kind := m.kind;
    if kind == Tversion || kind == Rversion { size += m.version.count }
    if kind == Tauth || kind == Tattach { size += m.uname.count + m.aname.count }
    if kind == Twalk { for i: 0..m.names.count - 1 { size += 2 + m.names[i].count } }
    if kind == Tcreate { size += m.name.count }
    if kind == Twrite || kind == Rread { size += m.data.count }
    if kind == Twstat || kind == Rstat { size += DirSize(*m.stat) }
    if kind == Rerror { size += m.ename.count }
    if kind == Rwalk { size += QIDSZ * m.qids.count }
    return size;
}

// Appends the wire form of a message; false for a kind that cannot be
// packed.
Pack :: (m: *Message, out: *Vec(u8)) -> bool {
    size := PackedSize(m);
    if size == 0 { return false }
    kind := m.kind;
    Put(out, size, 4);
    Put(out, kind, 1);
    Put(out, m.tag, 2);
    if kind == Tversion || kind == Rversion {
        Put(out, m.msize, 4);
        PutString(out, m.version);
    } else if kind == Tauth {
        Put(out, m.afid, 4);
        PutString(out, m.uname);
        PutString(out, m.aname);
    } else if kind == Tflush {
        Put(out, m.oldtag, 2);
    } else if kind == Tattach {
        Put(out, m.fid, 4);
        Put(out, m.afid, 4);
        PutString(out, m.uname);
        PutString(out, m.aname);
    } else if kind == Twalk {
        Put(out, m.fid, 4);
        Put(out, m.newfid, 4);
        Put(out, m.names.count, 2);
        for i: 0..m.names.count - 1 { PutString(out, m.names[i]) }
    } else if kind == Topen {
        Put(out, m.fid, 4);
        Put(out, m.mode, 1);
    } else if kind == Tcreate {
        Put(out, m.fid, 4);
        PutString(out, m.name);
        Put(out, m.perm, 4);
        Put(out, m.mode, 1);
    } else if kind == Tread {
        Put(out, m.fid, 4);
        Put(out, m.offset, 8);
        Put(out, m.count, 4);
    } else if kind == Twrite {
        Put(out, m.fid, 4);
        Put(out, m.offset, 8);
        Put(out, m.data.count, 4);
        BuilderAppend(<<out, m.data);
    } else if kind == Tclunk || kind == Tremove || kind == Tstat {
        Put(out, m.fid, 4);
    } else if kind == Twstat {
        Put(out, m.fid, 4);
        Put(out, DirSize(*m.stat), 2);
        PackDir(out, *m.stat);
    } else if kind == Rauth || kind == Rattach {
        PutQid(out, m.qid);
    } else if kind == Rerror {
        PutString(out, m.ename);
    } else if kind == Rwalk {
        Put(out, m.qids.count, 2);
        for i: 0..m.qids.count - 1 { PutQid(out, m.qids[i]) }
    } else if kind == Ropen || kind == Rcreate {
        PutQid(out, m.qid);
        Put(out, m.iounit, 4);
    } else if kind == Rread {
        Put(out, m.data.count, 4);
        BuilderAppend(<<out, m.data);
    } else if kind == Rwrite {
        Put(out, m.count, 4);
    } else if kind == Rstat {
        Put(out, DirSize(*m.stat), 2);
        PackDir(out, *m.stat);
    }
    return true;
}

// The fields of a request after its header; the bytes used, or -1.
UnpackRequest :: (f: string, m: *Message) -> s64 {
    kind := m.kind;
    if HeaderLength(kind) >= HEADER + 4 { m.fid = Get(f, HEADER, 4) }
    if kind == Tversion {
        m.msize = m.fid;
        version, end := GetString(f, HEADER + 4);
        m.version = version;
        return end;
    }
    if kind == Tauth || kind == Tattach {
        at: s64 = HEADER + 4;
        m.afid = m.fid;
        if kind == Tattach {
            m.afid = Get(f, at, 4);
            at += 4;
        }
        uname, after_uname := GetString(f, at);
        aname, end := GetString(f, after_uname);
        m.uname = uname;
        m.aname = aname;
        return end;
    }
    if kind == Tflush {
        m.oldtag = Get(f, HEADER, 2);
        return HEADER + 2;
    }
    if kind == Twalk {
        m.newfid = Get(f, HEADER + 4, 4);
        count := Get(f, HEADER + 8, 2);
        if count > MAXWELEM { return -1 }
        at: s64 = HEADER + 10;
        for 1..count {
            name, next := GetString(f, at);
            if next <= 0 { return -1 }
            VecPush(m.names, name);
            at = next;
        }
        return at;
    }
    if kind == Topen {
        m.mode = Get(f, HEADER + 4, 1);
        return HEADER + 5;
    }
    if kind == Tcreate {
        name, at := GetString(f, HEADER + 4);
        if at <= 0 || at + 5 > f.count { return -1 }
        m.name = name;
        m.perm = Get(f, at, 4);
        m.mode = Get(f, at + 4, 1);
        return at + 5;
    }
    if kind == Tread || kind == Twrite {
        m.offset = Get(f, HEADER + 4, 8);
        count := Get(f, HEADER + 12, 4);
        if kind == Tread {
            m.count = count;
            return HEADER + 16;
        }
        if count > f.count - (HEADER + 16) { return -1 }
        m.data = f[HEADER + 16:HEADER + 16 + count];
        return HEADER + 16 + count;
    }
    if kind == Tclunk || kind == Tremove || kind == Tstat { return HEADER + 4 }
    if kind == Twstat {
        size := Get(f, HEADER + 4, 2);
        if f.count < HEADER + 6 + size || UnpackDir(f[HEADER + 6:], *m.stat) != size { return -1 }
        return HEADER + 6 + size;
    }
    return -1;
}

// The fields of a reply after its header; the bytes used, or -1.
UnpackReply :: (f: string, m: *Message) -> s64 {
    kind := m.kind;
    if kind == Rversion {
        m.msize = Get(f, HEADER, 4);
        version, end := GetString(f, HEADER + 4);
        m.version = version;
        return end;
    }
    if kind == Rauth || kind == Rattach {
        m.qid = GetQid(f, HEADER);
        return HEADER + QIDSZ;
    }
    if kind == Rerror {
        ename, end := GetString(f, HEADER);
        m.ename = ename;
        return end;
    }
    if kind == Rflush || kind == Rclunk || kind == Rremove || kind == Rwstat { return HEADER }
    if kind == Rwalk {
        count := Get(f, HEADER, 2);
        if f.count < HEADER + 2 + count * QIDSZ { return -1 }
        for i: 0..count - 1 { VecPush(m.qids, GetQid(f, HEADER + 2 + i * QIDSZ)) }
        return HEADER + 2 + count * QIDSZ;
    }
    if kind == Ropen || kind == Rcreate {
        m.qid = GetQid(f, HEADER);
        m.iounit = Get(f, HEADER + QIDSZ, 4);
        return HEADER + QIDSZ + 4;
    }
    if kind == Rread {
        count := Get(f, HEADER, 4);
        if f.count < HEADER + 4 + count { return -1 }
        m.data = f[HEADER + 4:HEADER + 4 + count];
        return HEADER + 4 + count;
    }
    if kind == Rwrite {
        m.count = Get(f, HEADER, 4);
        return HEADER + 4;
    }
    if kind == Rstat {
        size := Get(f, HEADER, 2);
        if f.count < HEADER + 2 + size || UnpackDir(f[HEADER + 2:], *m.stat) != size { return -1 }
        return HEADER + 2 + size;
    }
    return -1;
}

// Empties a message for reuse.
Clear :: (m: *Message) {
    none: Qid;
    nothing: Dir;
    m.kind = 0;
    m.tag = 0;
    m.fid = 0;
    m.afid = 0;
    m.newfid = 0;
    m.oldtag = 0;
    m.msize = 0;
    m.mode = 0;
    m.perm = 0;
    m.count = 0;
    m.iounit = 0;
    m.offset = 0;
    m.version = "";
    m.uname = "";
    m.aname = "";
    m.name = "";
    m.ename = "";
    VecClear(m.names);
    m.qid = none;
    VecClear(m.qids);
    m.data = "";
    m.stat = nothing;
}

// Unpacks the message that starts f, a request or a reply as asked, into
// m. Returns the bytes it used, 0 when f does not yet hold the whole
// message, or -1 when it is not a 9P message of that direction; m then
// holds no message.
Unpack :: (f: string, request: bool, m: *Message) -> s64 {
    Clear(m);
    if f.count < HEADER { return 0 }
    size := Get(f, 0, 4);
    if f.count < size { return 0 }
    kind := Get(f, 4, 1);
    if kind >= 128 || (kind % 2 == 0) != request || size < HeaderLength(kind) { return -1 }
    m.kind = kind;
    m.tag = Get(f, 5, 2);
    used := ifx request then UnpackRequest(f[:size], m) else UnpackReply(f[:size], m);
    if used <= 0 {
        m.kind = 0;
        return -1;
    }
    return used;
}

// Whether the message that starts f is a request: 1, 0, or -1 when f is
// shorter than a header.
IsRequest :: (f: string) -> s64 {
    if f.count < HEADER { return -1 }
    return ifx f[4] % 2 == 0 then 1 else 0;
}

// Checks the size at the start of a message against the limit agreed for
// the connection (DEFMSIZE when limit is 0): the size and "", or why the
// message is refused.
MessageSize :: (header: string, limit: s64) -> (size: s64, error: string) {
    size := Get(header, 0, 4);
    if size <= 4 { return 0, "invalid 9P message size" }
    if size > (ifx limit <= 0 then DEFMSIZE else limit) { return 0, "9P message longer than agreed" }
    return size, "";
}

Less :: (a: string, b: string) -> bool {
    for i: 0..a.count - 1 {
        if i >= b.count || a[i] > b[i] { return false }
        if a[i] < b[i] { return true }
    }
    return a.count < b.count;
}

// What a server offering msize and version (VERSION when empty) settles on
// with a client that sent the Tversion values: the smaller size and the
// older version, or "unknown" for a version it cannot speak. A client
// version's part after a dot is ignored.
Compatible :: (client_msize: s64, client_version: string, msize: s64, version: string) -> (size: s64, agreed: string) {
    size := ifx client_msize < msize then client_msize else msize;
    offered := ifx version.count == 0 then VERSION else version;
    v := client_version;
    if v.count < 2 || v[:2] != "9P" { return size, "unknown" }
    for i: 2..v.count - 1 {
        if v[i] == #char "." {
            v = v[:i];
            break;
        }
        if v[i] < #char "0" || v[i] > #char "9" { return size, "unknown" }
    }
    if Less(v, VERSION) { return size, "unknown" }
    return size, ifx Less(v, offered) then v else offered;
}

// Appends the wire form of a reply for a connection whose agreed message
// size is msize: an Rerror instead when no size was agreed (0) or the
// reply is longer.
PackReply :: (m: *Message, msize: s64, out: *Vec(u8)) {
    start := out.count;
    if msize != 0 {
        unused Pack(m, out);
        if out.count - start <= msize { return }
        unused VecResize(<<out, start);
    }
    error: Message;
    error.kind = Rerror;
    error.tag = m.tag;
    error.ename = ifx msize == 0 then "Tversion not seen" else "9P reply didn't fit";
    unused Pack(*error, out);
}

// value as an unsigned 32-bit number in a base up to 16, with at least
// width digits.
PutBase :: (out: *Vec(u8), value: u64, base: u64, width: s64) {
    digits: [64]u8;
    count: s64 = 0;
    rest := value;
    while rest > 0 || count < width || count == 0 {
        digit := cast(u8)(rest % base);
        digits[count] = ifx digit < 10 then digit + #char "0" else digit - 10 + #char "a";
        count += 1;
        rest /= base;
    }
    while count > 0 {
        count -= 1;
        VecPush(<<out, digits[count]);
    }
}

Unsigned :: (value: s64) -> u64 { return cast(u64)value & 0xFFFFFFFF }

Signed :: (value: s64) -> s64 {
    low := value & 0xFFFFFFFF;
    return ifx low >= 0x80000000 then low - 0x100000000 else low;
}

QidText :: (out: *Vec(u8), qid: Qid) {
    BuilderAppend(<<out, "Qid(16r");
    PutBase(out, qid.path, 16, 1);
    BuilderPrint(out, ",%,16r", Signed(qid.version));
    PutBase(out, Unsigned(qid.qtype), 16, 2);
    VecPush(<<out, #char ")");
}

DirText :: (out: *Vec(u8), dir: *Dir) {
    BuilderPrint(out, "Dir(\"%\",\"%\",\"%\",", dir.name, dir.uid, dir.gid);
    QidText(out, dir.qid);
    BuilderAppend(<<out, ",8r");
    PutBase(out, Unsigned(dir.mode), 8, 1);
    BuilderPrint(out, ",%,%,%,16r", Signed(dir.atime), Signed(dir.mtime), dir.length);
    PutBase(out, Unsigned(dir.dtype), 16, 1);
    BuilderPrint(out, ",%)", Signed(dir.dev));
}

KindName :: (kind: s64) -> string {
    names := string.["Version", "Auth", "Attach", "Error", "Flush", "Walk", "Open", "Create", "Read", "Write", "Clunk", "Remove",
        "Stat", "Wstat"];
    if kind < Tversion || kind > Rwstat { return "" }
    return names[(kind - Tversion) / 2];
}

// Appends a message as the Limbo module wrote it, such as
// Tmsg.Open(7,11,18); "nil" for no message.
Text :: (m: *Message, out: *Vec(u8)) {
    kind := m.kind;
    if HeaderLength(kind) == 0 { BuilderAppend(<<out, "nil"); return }
    BuilderPrint(out, "%msg.%(%", ifx kind % 2 == 0 then "T" else "R", KindName(kind), Unsigned(m.tag));
    if kind == Tversion || kind == Rversion {
        BuilderPrint(out, ",%,\"%\"", Signed(m.msize), m.version);
    } else if kind == Tauth {
        BuilderPrint(out, ",%,\"%\",\"%\"", Unsigned(m.afid), m.uname, m.aname);
    } else if kind == Tflush {
        BuilderPrint(out, ",%", Unsigned(m.oldtag));
    } else if kind == Tattach {
        BuilderPrint(out, ",%,%,\"%\",\"%\"", Unsigned(m.fid), Unsigned(m.afid), m.uname, m.aname);
    } else if kind == Twalk {
        BuilderPrint(out, ",%,%,", Unsigned(m.fid), Unsigned(m.newfid));
        if m.names.count == 0 { BuilderAppend(<<out, "nil") } else { BuilderAppend(<<out, "array[] of {") }
        for i: 0..m.names.count - 1 {
            if i > 0 { VecPush(<<out, #char ",") }
            BuilderPrint(out, "\"%\"", m.names[i]);
        }
        if m.names.count > 0 { VecPush(<<out, #char "}") }
    } else if kind == Topen {
        BuilderPrint(out, ",%,%", Unsigned(m.fid), m.mode);
    } else if kind == Tcreate {
        BuilderPrint(out, ",%,\"%\",8r", Unsigned(m.fid), m.name);
        PutBase(out, Unsigned(m.perm), 8, 1);
        BuilderPrint(out, ",%", m.mode);
    } else if kind == Tread {
        BuilderPrint(out, ",%,%,%", Unsigned(m.fid), m.offset, Unsigned(m.count));
    } else if kind == Twrite {
        BuilderPrint(out, ",%,%,array[%] of byte", Unsigned(m.fid), m.offset, m.data.count);
    } else if kind == Tclunk || kind == Tremove || kind == Tstat {
        BuilderPrint(out, ",%", Unsigned(m.fid));
    } else if kind == Twstat {
        BuilderPrint(out, ",%,", Unsigned(m.fid));
        DirText(out, *m.stat);
    } else if kind == Rauth || kind == Rattach || kind == Ropen || kind == Rcreate {
        VecPush(<<out, #char ",");
        QidText(out, m.qid);
        if kind == Ropen || kind == Rcreate { BuilderPrint(out, ",%", Signed(m.iounit)) }
    } else if kind == Rerror {
        BuilderPrint(out, ",\"%\"", m.ename);
    } else if kind == Rwalk {
        BuilderAppend(<<out, ",array[] of {");
        for i: 0..m.qids.count - 1 {
            if i > 0 { VecPush(<<out, #char ",") }
            QidText(out, m.qids[i]);
        }
        VecPush(<<out, #char "}");
    } else if kind == Rread {
        BuilderPrint(out, ",array[%] of byte", m.data.count);
    } else if kind == Rwrite {
        BuilderPrint(out, ",%", Signed(m.count));
    } else if kind == Rstat {
        VecPush(<<out, #char ",");
        DirText(out, *m.stat);
    }
    VecPush(<<out, #char ")");
}
