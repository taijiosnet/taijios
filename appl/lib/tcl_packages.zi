// Versioned Tcl script libraries for the headless Inferno Tcl port. See ../../NOTICE (MIT).
#import "std/vec"
#import "tcl_types"
using Tcl :: #import "tcl"
using Vars :: #import "tcl_variables"
using Lists :: #import "tcl_lists"
using Io :: #import "tcl_io"

Attach :: (interpreter: *Tcl.Interpreter) {
    interpreter.package_runner = Dispatch;
}

Find :: (table: *Tcl.PackageTable, name: string) -> s64 {
    for * table.entries { if TextView(it.name) == name { return it_index } }
    return -1;
}

Ensure :: (table: *Tcl.PackageTable, name: string) -> s64 {
    at := Find(table, name);
    if at >= 0 { return at }
    if !VecPush(table.entries, Tcl.Package.{name = TextCopy(name)}) { return -1 }
    return table.entries.count-1;
}

Forget :: (table: *Tcl.PackageTable, name: string) {
    at := Find(table, name);
    if at < 0 { return }
    last := table.entries.count-1;
    if at != last {
        VecSwap(table.entries[at].name.bytes, table.entries[last].name.bytes);
        VecSwap(table.entries[at].provided.bytes, table.entries[last].provided.bytes);
        VecSwap(table.entries[at].scripts, table.entries[last].scripts);
    }
    unused VecResize(table.entries, last);
}

// Alpha and beta markers occupy their own version component and sort below 0.
// Comparing decimal component text avoids truncating large version components.
ValidVersion :: (version: string) -> bool {
    at: s64;
    prerelease := false;
    while at < version.count {
        start := at;
        while at < version.count && Digit(version[at]) { at += 1 }
        if at == start { return false }
        if at == version.count { return true }
        sep := version[at];
        if sep != 46 {
            if prerelease || (sep != 97 && sep != 98) { return false }
            prerelease = true;
        }
        at += 1;
    }
    return false;
}

NextComponent :: (version: string, at: *s64) -> string {
    if <<at == version.count { return "0" }
    start := <<at;
    if version[start] == 97 || version[start] == 98 {
        <<at += 1;
        return version[start:<<at];
    }
    while <<at < version.count && Digit(version[<<at]) { <<at += 1 }
    part := version[start:<<at];
    if <<at < version.count && version[<<at] == 46 { <<at += 1 }
    return part;
}

CompareComponent :: (left: string, right: string) -> s64 {
    if left == right { return 0 }
    if !Digit(left[0]) { return ifx left == "a" || Digit(right[0]) then -1 else 1 }
    if !Digit(right[0]) { return 1 }
    a: s64;
    b: s64;
    while a < left.count && left[a] == 48 { a += 1 }
    while b < right.count && right[b] == 48 { b += 1 }
    if left.count-a != right.count-b { return ifx left.count-a < right.count-b then -1 else 1 }
    return CompareText(left[a:], right[b:]);
}

Compare :: (left: string, right: string) -> s64 {
    a: s64;
    b: s64;
    while a < left.count || b < right.count {
        diff := CompareComponent(NextComponent(left, *a), NextComponent(right, *b));
        if diff != 0 { return diff }
    }
    return 0;
}

Prerelease :: (version: string) -> bool {
    for version { if it == 97 || it == 98 { return true } }
    return false;
}

// Range endpoints use an implicit a0 on a stable version, so for example
// 1.2b1 is included at the lower bound 1.2 and excluded at the upper bound 1.2.
CompareBound :: (version: string, bound: string) -> s64 {
    if Prerelease(bound) { return Compare(version, bound) }
    a: s64;
    b: s64;
    while b < bound.count {
        diff := CompareComponent(NextComponent(version, *a), NextComponent(bound, *b));
        if diff != 0 { return diff }
    }
    return CompareComponent(NextComponent(version, *a), "a");
}

SplitRequirement :: (word: string) -> (first: string, last: string, range: bool) {
    for word { if it == 45 { return word[:it_index], word[it_index+1:], true } }
    return word, "", false;
}

BadVersion :: (version: string) -> Result {
    return QuotedError("expected version number but got \"", version, "\"");
}

Validate :: (requirements: []Text, exact: bool) -> Result {
    for * requirements {
        word := TextView(it);
        if exact {
            if !ValidVersion(word) { return BadVersion(word) }
        } else {
            first, last, ranged := SplitRequirement(word);
            if !ValidVersion(first) || (ranged && last != "" && !ValidVersion(last)) {
                return QuotedError("expected version requirement but got \"", word, "\"");
            }
        }
    }
    return Success();
}

Matches :: (version: string, requirements: []Text, exact: bool) -> bool {
    if requirements.count == 0 { return true }
    for * requirements {
        word := TextView(it);
        if exact {
            if Compare(version, word) == 0 { return true }
            continue;
        }
        first, last, ranged := SplitRequirement(word);
        if ranged && last != "" && Compare(first, last) == 0 {
            if Compare(version, first) == 0 { return true }
            continue;
        }
        if CompareBound(version, first) < 0 { continue }
        if !ranged {
            a: s64;
            b: s64;
            if CompareComponent(NextComponent(version, *a), NextComponent(first, *b)) == 0 { return true }
        } else if last == "" || CompareBound(version, last) < 0 {
            return true;
        }
    }
    return false;
}

Provided :: (table: *Tcl.PackageTable, name: string) -> Result {
    at := Find(table, name);
    if at < 0 { return Success() }
    return Success(TextView(table.entries[at].provided));
}

Conflict :: (name: string, have: string, requirements: []Text, wanted: string = "") -> Result {
    error := QuotedError("version conflict for package \"", name, "\": have ");
    unused BuilderAppend(error.value.bytes, have);
    unused BuilderAppend(error.value.bytes, ", need");
    if wanted != "" {
        Lists.AppendElement(*error.value.bytes, wanted);
    } else {
        for * requirements { Lists.AppendElement(*error.value.bytes, TextView(it)) }
    }
    return error;
}

// An embedder calls Provide after it has attached its own implementation.
Provide :: (interpreter: *Tcl.Interpreter, name: string, version: string) -> Result {
    if !ValidVersion(version) { return BadVersion(version) }
    current := Provided(*interpreter.packages, name);
    if current.value.bytes.count == 0 {
        at := Ensure(*interpreter.packages, name);
        if at < 0 { return Failure("cannot allocate package") }
        copy: Text = TextCopy(version);
        VecSwap(interpreter.packages.entries[at].provided.bytes, copy.bytes);
    } else if Compare(TextView(current.value), version) != 0 {
        empty: []Text;
        return Conflict(name, TextView(current.value), empty, version);
    }
    return Success();
}

IfNeeded :: (table: *Tcl.PackageTable, name: string, version: string, args: []Text) -> Result {
    if !ValidVersion(version) { return BadVersion(version) }
    at: s64;
    if args.count != 0 {
        at = Ensure(table, name);
        if at < 0 { return Failure("cannot allocate package") }
    } else {
        at = Find(table, name);
        if at < 0 { return Success() }
    }
    package := *table.entries[at];
    for * package.scripts {
        if Compare(TextView(it.version), version) != 0 { continue }
        if args.count == 0 { return Success(TextView(it.script)) }
        script: Text = TextCopy(TextView(args[0]));
        VecSwap(it.script.bytes, script.bytes);
        return Success();
    }
    if args.count == 0 { return Success() }
    entry := Tcl.PackageScript.{version = TextCopy(version), script = TextCopy(TextView(args[0]))};
    if !VecPush(package.scripts, entry) { return Failure("cannot allocate package script") }
    return Success();
}

Choose :: (table: *Tcl.PackageTable, name: string, requirements: []Text, exact: bool) -> (package_at: s64, script_at: s64) {
    at := Find(table, name);
    if at < 0 { return -1, -1 }
    best: s64 = -1;
    package := *table.entries[at];
    for * package.scripts {
        version := TextView(it.version);
        if !Matches(version, requirements, exact) { continue }
        if best >= 0 {
            previous := TextView(package.scripts[best].version);
            if !table.prefer_latest && Prerelease(version) != Prerelease(previous) {
                if Prerelease(version) { continue }
            } else if Compare(version, previous) <= 0 {
                continue;
            }
        }
        best = it_index;
    }
    return at, best;
}

ScanIndexes :: (interpreter: *Tcl.Interpreter, depth: s32) -> Result {
    loader := interpreter.source_loader;
    if loader == null || !Vars.VariableExists(*interpreter.globals, "auto_path") { return Success() }
    paths := Vars.ReadVariable(*interpreter.globals, "auto_path");
    if paths.code != .OK { return Tcl.CopyResult(*paths) }
    dirs := Lists.ParseList(TextView(paths.value));
    if dirs.problem != "" { return Failure(dirs.problem) }
    for * dirs.words {
        dir := TextView(it);
        if dir == "" { continue }
        if interpreter.steps <= 0 { return Failure("script command limit exceeded") }
        interpreter.steps -= 1;
        path: Text;
        if !Io.AppendPath(*path, dir) || !Io.AppendPath(*path, "pkgIndex.tcl") { return Failure("cannot allocate package index path") }
        loaded: Result;
        loader(interpreter.source_context, TextView(path), *loaded);
        if loaded.code != .OK { continue }
        frame := Vars.Frame.{parent = *interpreter.globals, level = 1};
        setup := Vars.StoreVariable(*frame, "dir", dir);
        if setup.code != .OK { return setup }
        result := Tcl.EvalScript(interpreter, *frame, TextView(loaded.value), depth+1);
        if result.code != .OK && result.code != .Return { return Tcl.OutsideLoop(result) }
    }
    return Success();
}

Discover :: (interpreter: *Tcl.Interpreter, name: string, requirements: []Text, exact: bool, depth: s32) -> Result {
    if interpreter.packages.discovering { return Success() }
    interpreter.packages.discovering = true;
    defer { interpreter.packages.discovering = false }
    if !interpreter.packages.custom_unknown { return ScanIndexes(interpreter, depth) }
    if interpreter.packages.unknown.bytes.count == 0 { return Success() }
    command: Text = TextCopy(TextView(interpreter.packages.unknown));
    Lists.AppendElement(*command.bytes, name);
    if exact {
        version := TextView(requirements[0]);
        range: Text = TextCopy(version);
        unused BuilderAppend(range.bytes, "-");
        unused BuilderAppend(range.bytes, version);
        Lists.AppendElement(*command.bytes, TextView(range));
    } else if requirements.count == 0 {
        Lists.AppendElement(*command.bytes, "0-");
    } else {
        for * requirements { Lists.AppendElement(*command.bytes, TextView(it)) }
    }
    return Tcl.EvalScript(interpreter, *interpreter.globals, TextView(command), depth+1);
}

Require :: (interpreter: *Tcl.Interpreter, name: string, requirements: []Text, exact: bool, present: bool, depth: s32) -> Result {
    table := *interpreter.packages;
    current := Provided(table, name);
    version := TextView(current.value);
    if version != "" {
        if !Matches(version, requirements, exact) { return Conflict(name, version, requirements) }
        return Tcl.CopyResult(*current);
    }
    if present {
        problem := QuotedError("package ", name, "");
        for * requirements { Lists.AppendElement(*problem.value.bytes, TextView(it)) }
        unused BuilderAppend(problem.value.bytes, " is not present");
        return problem;
    }
    for * table.loading {
        if TextView(it) == name { return QuotedError("circular package dependency: ", name, "") }
    }
    if !VecPush(table.loading, TextCopy(name)) { return Failure("cannot allocate package load state") }
    defer { unused VecResize(table.loading, table.loading.count-1) }

    package_at, script_at := Choose(table, name, requirements, exact);
    if script_at < 0 {
        discovered := Discover(interpreter, name, requirements, exact, depth);
        if discovered.code != .OK { return discovered }
        discovered_version := Provided(table, name);
        found := TextView(discovered_version.value);
        if found != "" {
            if !Matches(found, requirements, exact) { return Conflict(name, found, requirements) }
            return Tcl.CopyResult(*discovered_version);
        }
        package_at, script_at = Choose(table, name, requirements, exact);
        if script_at < 0 {
            problem := QuotedError("can't find package ", name, "");
            for * requirements { Lists.AppendElement(*problem.value.bytes, TextView(it)) }
            return problem;
        }
    }
    // The loader can insert packages, replace the script or forget its own entry.
    choice := *table.entries[package_at].scripts[script_at];
    expected: Text = TextCopy(TextView(choice.version));
    script: Text = TextCopy(TextView(choice.script));
    result := Tcl.EvalScript(interpreter, *interpreter.globals, TextView(script), depth+1);
    activated := Provided(table, name);
    actual := TextView(activated.value);
    if result.code == .OK && actual != "" && Compare(actual, TextView(expected)) == 0 { return Tcl.CopyResult(*activated) }
    at := Find(table, name);
    if at >= 0 { unused VecResize(table.entries[at].provided.bytes, 0) }
    if result.code == .Error || result.code == .Exit { return result }
    problem := QuotedError("attempt to provide package ", name, " ");
    unused BuilderAppend(problem.value.bytes, TextView(expected));
    unused BuilderAppend(problem.value.bytes, " failed: ");
    if result.code != .OK {
        unused BuilderAppend(problem.value.bytes, "bad return code: ");
        code := Integer(cast(s64)result.code);
        unused BuilderAppend(problem.value.bytes, TextView(code.value));
    } else if actual == "" {
        unused BuilderAppend(problem.value.bytes, "no version of package provided");
    } else {
        unused BuilderAppend(problem.value.bytes, "provided version ");
        unused BuilderAppend(problem.value.bytes, actual);
        unused BuilderAppend(problem.value.bytes, " instead");
    }
    return problem;
}

Run :: (interpreter: *Tcl.Interpreter, args: []Text, depth: s32) -> Result {
    if args.count == 0 { return WrongArgs("package option ?arg ...?") }
    option := TextView(args[0]);
    args = args[1:];
    table := *interpreter.packages;
    if option == "provide" {
        if args.count < 1 || args.count > 2 { return WrongArgs("package provide package ?version?") }
        name := TextView(args[0]);
        if args.count == 1 { return Provided(table, name) }
        return Provide(interpreter, name, TextView(args[1]));
    }
    if option == "ifneeded" {
        if args.count < 2 || args.count > 3 { return WrongArgs("package ifneeded package version ?script?") }
        return IfNeeded(table, TextView(args[0]), TextView(args[1]), args[2:]);
    }
    if option == "require" || option == "present" {
        exact := args.count > 0 && TextView(args[0]) == "-exact";
        if exact { args = args[1:] }
        if args.count == 0 || (exact && args.count != 2) { return WrongArgs("package require|present ?-exact? package ?requirement ...?") }
        requirements := args[1:];
        valid := Validate(requirements, exact);
        if valid.code != .OK { return valid }
        return Require(interpreter, TextView(args[0]), requirements, exact, option == "present", depth);
    }
    if option == "vcompare" || option == "vsatisfies" {
        if args.count < 2 || (option == "vcompare" && args.count != 2) { return WrongArgs("package vcompare|vsatisfies version versionOrRequirement ?requirement ...?") }
        version := TextView(args[0]);
        if !ValidVersion(version) { return BadVersion(version) }
        valid := Validate(args[1:], option == "vcompare");
        if valid.code != .OK { return valid }
        if option == "vcompare" { return Integer(Compare(version, TextView(args[1]))) }
        return Integer(ifx Matches(version, args[1:], false) then 1 else 0);
    }
    if option == "names" || option == "versions" {
        if option == "names" && args.count != 0 { return WrongArgs("package names") }
        if option == "versions" && args.count != 1 { return WrongArgs("package versions package") }
        names: Text;
        if option == "names" {
            for * table.entries { Lists.AppendElement(*names.bytes, TextView(it.name), names.bytes.count > 0) }
        } else {
            at := Find(table, TextView(args[0]));
            if at >= 0 {
                package := *table.entries[at];
                for * package.scripts { Lists.AppendElement(*names.bytes, TextView(it.version), names.bytes.count > 0) }
            }
        }
        return .{value = names};
    }
    if option == "forget" {
        for * args { Forget(table, TextView(it)) }
        return Success();
    }
    if option == "unknown" {
        if args.count > 1 { return WrongArgs("package unknown ?command?") }
        if args.count == 0 { return Success(TextView(table.unknown)) }
        command: Text = TextCopy(TextView(args[0]));
        VecSwap(table.unknown.bytes, command.bytes);
        table.custom_unknown = true;
        return Success();
    }
    if option == "prefer" {
        if args.count > 1 { return WrongArgs("package prefer ?latest|stable?") }
        if args.count == 1 {
            mode := TextView(args[0]);
            if mode == "latest" { table.prefer_latest = true }
            else if mode != "stable" { return Failure("package preference must be latest or stable") }
        }
        return Success(ifx table.prefer_latest then "latest" else "stable");
    }
    return QuotedError("unknown package option \"", option, "\"");
}

Dispatch :: (interpreter: *Tcl.Interpreter, args: []Text, depth: s32, result: *Result) {
    value := Run(interpreter, args, depth);
    result.code = value.code;
    VecSwap(result.value.bytes, value.value.bytes);
}
