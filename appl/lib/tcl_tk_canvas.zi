// Canvas item geometry and commands, following Inferno libtk/canvs.c.
#import "std/vec"
#import "std/number_text"
using T :: #import "tcl_types"
using UTF :: #import "tcl_tk_text"

NONE :: -1;
BLACK :: 0x000000;
WHITE :: 0xffffff;
RED :: 0xff0000;
CELL_WIDTH :: 12;
TEXT_HEIGHT :: 14;
MAX_CELLS :: 512;
FRACTION :: 10000;

Anchor :: enum { Center; North; Northeast; East; Southeast; South; Southwest; West; Northwest; }
Kind :: enum { Rectangle; Label; Line; Oval; }
Coordinates :: struct { x0: s32; y0: s32; x1: s32; y1: s32; }
PathPoint :: struct { x: s64; y: s64; }
FixedCoordinates :: struct { x0: s64; y0: s64; x1: s64; y1: s64; }
Item :: struct {
    kind: Kind;
    coordinates: Coordinates;
    anchor: Anchor;
    fill: s32;
    outline: s32;
    text: Text;
    precise: FixedCoordinates;
    path: Vec(PathPoint);
    stroke: s64;
    marker_radius: s64;
}
State :: struct { width: s32; height: s32; background: s32; border: s32; sunken: bool; items: Vec(Item); }

Default :: () -> State { return .{width = 360, height = 270, background = NONE} }

Minimum :: (a: s32, b: s32) -> s32 { return ifx a < b then a else b }
Maximum :: (a: s32, b: s32) -> s32 { return ifx a > b then a else b }

Rectangle :: (coordinates: Coordinates) -> Coordinates {
    return .{Minimum(coordinates.x0, coordinates.x1), Minimum(coordinates.y0, coordinates.y1),
             Maximum(coordinates.x0, coordinates.x1), Maximum(coordinates.y0, coordinates.y1)};
}

Bounds :: (item: *Item) -> Coordinates {
    coordinates := item.coordinates;
    if item.kind != .Label {
        rect := Rectangle(coordinates);
        margin: s32 = 2;
        if item.kind == .Line { margin = Pixel(item.stroke) }
        if item.kind == .Oval { margin = 2*Pixel(item.stroke) }
        return .{rect.x0-margin, rect.y0-margin, rect.x1+margin, rect.y1+margin};
    }
    width := UTF.Count(TextView(item.text), MAX_CELLS) * CELL_WIDTH;
    x := coordinates.x0;
    y := coordinates.y0;
    anchor := item.anchor;
    if anchor == .East || anchor == .Northeast || anchor == .Southeast { x -= width }
    else if anchor != .West && anchor != .Northwest && anchor != .Southwest { x -= width / 2 }
    if anchor == .South || anchor == .Southeast || anchor == .Southwest { y -= TEXT_HEIGHT }
    else if anchor != .North && anchor != .Northeast && anchor != .Northwest { y -= TEXT_HEIGHT / 2 }
    return .{x, y, x + width, y + TEXT_HEIGHT};
}

Add :: (state: *State, kind: Kind, coordinates: Coordinates, fill: s32, outline: s32, anchor: Anchor) -> s64 {
    index := state.items.count;
    if !VecResize(state.items, index+1) { return 0 }
    item := *state.items[index];
    item.kind = kind;
    SetInteger(item, coordinates);
    item.fill = fill;
    item.outline = outline;
    item.anchor = anchor;
    item.stroke = FRACTION;
    return index+1;
}

AddRectangle :: (state: *State, coordinates: Coordinates, fill: s32, outline: s32) -> s64 {
    return Add(state, .Rectangle, coordinates, fill, outline, .Center);
}

AddPolyline :: (state: *State, count: s64, bounds: Coordinates, fill: s32, stroke: s64, marker_radius: s64 = 0) -> *Item {
    if count < 1 || count > 4096 { return null }
    id := Add(state, .Line, bounds, fill, NONE, .Center);
    item := Find(state, id);
    if item == null { return null }
    if !VecResizeBounded(item.path, count, count) {
        unused VecResize(state.items, id-1);
        return null;
    }
    item.stroke = stroke;
    item.marker_radius = marker_radius;
    return item;
}

IncludePoint :: (bounds: Coordinates, x: s64, y: s64, first: bool) -> Coordinates {
    px := Pixel(x);
    py := Pixel(y);
    if first { return .{px, py, px, py} }
    return .{Minimum(bounds.x0, px), Minimum(bounds.y0, py), Maximum(bounds.x1, px), Maximum(bounds.y1, py)};
}

Find :: (state: *State, id: s64) -> *Item {
    if id < 1 || id > state.items.count { return null }
    return *state.items[id-1];
}

SetCoordinates :: (state: *State, id: s64, coordinates: Coordinates) -> bool {
    item := Find(state, id);
    if item == null { return false }
    SetInteger(item, coordinates);
    return true;
}

SetText :: (state: *State, id: s64, text: string) -> bool {
    item := Find(state, id);
    if item == null || item.kind != .Label || !VecResize(item.text.bytes, text.count) { return false }
    for i: 0..text.count-1 { item.text.bytes[i] = text[i] }
    return true;
}

AddText :: (state: *State, x: s32, y: s32, anchor: Anchor, text: string, fill: s32) -> s64 {
    id := Add(state, .Label, .{x, y, 0, 0}, fill, NONE, anchor);
    if id == 0 || SetText(state, id, text) { return id }
    unused VecResize(state.items, id-1);
    return 0;
}

Clear :: (state: *State) {
    unused VecResize(state.items, 0);
}

Error :: (result: *T.Result, message: string) {
    result.code = .Error;
    unused BuilderAppend(result.value.bytes, message);
}

Configure :: (state: *State, args: []Text, result: *T.Result) -> bool {
    width := state.width;
    height := state.height;
    background := state.background;
    border := state.border;
    sunken := state.sunken;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        word := TextView(args[2*i+1]);
        if option == "-background" || option == "-bg" {
            color, ok := ParseColor(word);
            if !ok { Error(result, "bad canvas background"); return false }
            background = color;
        } else if option == "-relief" && (word == "flat" || word == "sunken") {
            sunken = word == "sunken";
        } else {
            value, ok := T.ParseInteger(word);
            if !ok || value < 0 || value > 32767 { Error(result, "bad canvas size or relief"); return false }
            if option == "-width" { width = cast(s32)value }
            else if option == "-height" { height = cast(s32)value }
            else if option == "-borderwidth" || option == "-bd" { border = cast(s32)value }
            else { Error(result, "unsupported canvas option"); return false }
        }
    }
    state.width = width;
    state.height = height;
    state.background = background;
    state.border = border;
    state.sunken = sunken;
    return true;
}

Pixel :: (number: s64) -> s32 {
    offset := ifx number >= 0 then FRACTION/2 else -FRACTION/2;
    return cast(s32)((number+offset)/FRACTION);
}

SetInteger :: (item: *Item, coordinates: Coordinates) {
    item.coordinates = coordinates;
    item.precise = .{cast(s64)coordinates.x0*FRACTION, cast(s64)coordinates.y0*FRACTION,
                     cast(s64)coordinates.x1*FRACTION, cast(s64)coordinates.y1*FRACTION};
}

ReadCoordinate :: (word: string) -> (value: s64, valid: bool) {
    if word.count == 0 { return 0, false }
    negative := word[0] == 45;
    at: s64 = ifx negative || word[0] == 43 then 1 else 0;
    whole: s64;
    digits: s64;
    while at < word.count && word[at] >= 48 && word[at] <= 57 {
        whole = whole*10 + cast(s64)(word[at]-48);
        if whole > 1000000 { return 0, false }
        at += 1;
        digits += 1;
    }
    fraction: s64;
    if at < word.count && word[at] == 46 {
        at += 1;
        place: s64 = FRACTION/10;
        while at < word.count && word[at] >= 48 && word[at] <= 57 {
            fraction += place*cast(s64)(word[at]-48);
            place /= 10;
            at += 1;
            digits += 1;
        }
    }
    value := whole*FRACTION+fraction;
    if negative { value = -value }
    return value, digits > 0 && at == word.count;
}

SetFixed :: (item: *Item, args: []Text, count: s64) -> bool {
    if args.count < count { return false }
    x0, x_ok := ReadCoordinate(TextView(args[0]));
    y0, y_ok := ReadCoordinate(TextView(args[1]));
    if !x_ok || !y_ok { return false }
    x1: s64;
    y1: s64;
    if count == 4 {
        x1, x_ok = ReadCoordinate(TextView(args[2]));
        y1, y_ok = ReadCoordinate(TextView(args[3]));
        if !x_ok || !y_ok { return false }
    }
    item.precise = .{x0, y0, x1, y1};
    item.coordinates = .{Pixel(x0), Pixel(y0), Pixel(x1), Pixel(y1)};
    return true;
}

SetLine :: (item: *Item, args: []Text, allow_options: bool) -> (consumed: s64, ok: bool) {
    points: Vec(PathPoint);
    bounds: Coordinates;
    at: s64;
    while at+1 < args.count {
        x, x_ok := ReadCoordinate(TextView(args[at]));
        if !x_ok && allow_options { break }
        y, y_ok := ReadCoordinate(TextView(args[at+1]));
        if !x_ok || !y_ok || points.count >= 4096 || !VecPush(points, PathPoint.{x, y}) { return 0, false }
        bounds = IncludePoint(bounds, x, y, at == 0);
        at += 2;
    }
    if points.count < 2 || (!allow_options && at != args.count) { return 0, false }
    VecSwap(item.path, points);
    item.coordinates = bounds;
    return at, true;
}

ParseAnchor :: (word: string) -> (anchor: Anchor, valid: bool) {
    if word == "center" { return Anchor.Center, true }
    if word == "n" { return Anchor.North, true }
    if word == "ne" { return Anchor.Northeast, true }
    if word == "e" { return Anchor.East, true }
    if word == "se" { return Anchor.Southeast, true }
    if word == "s" { return Anchor.South, true }
    if word == "sw" { return Anchor.Southwest, true }
    if word == "w" { return Anchor.West, true }
    if word == "nw" { return Anchor.Northwest, true }
    return Anchor.Center, false;
}

ParseColor :: (word: string) -> (rgb: s32, valid: bool) {
    if word == "" { return NONE, true }
    if word == "black" { return BLACK, true }
    if word == "white" { return WHITE, true }
    if word == "red" { return RED, true }
    if word == "blue" { return 0x0000ff, true }
    if word == "green" { return 0x00ff00, true }
    if word.count != 7 || word[0] != 35 { return NONE, false }
    color: s32;
    for i: 1..6 {
        byte := cast(s32)word[i];
        if byte >= 48 && byte <= 57 { byte -= 48 }
        else if byte >= 65 && byte <= 70 { byte -= 55 }
        else if byte >= 97 && byte <= 102 { byte -= 87 }
        else { return NONE, false }
        color = 16*color + byte;
    }
    return color, true;
}

UpdateItem :: (state: *State, id: s64, args: []Text) -> bool {
    if args.count % 2 != 0 { return false }
    item := Find(state, id);
    fill := item.fill;
    outline := item.outline;
    anchor := item.anchor;
    stroke := item.stroke;
    text_index: s64 = -1;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value := TextView(args[2*i+1]);
        if option == "-fill" || (option == "-outline" && (item.kind == .Rectangle || item.kind == .Oval)) {
            color, ok := ParseColor(value);
            if !ok { return false }
            if option == "-fill" { fill = color } else { outline = color }
        } else if option == "-anchor" && item.kind == .Label {
            parsed, ok := ParseAnchor(value);
            if !ok { return false }
            anchor = parsed;
        } else if option == "-text" && item.kind == .Label { text_index = 2*i+1 }
        else if option == "-width" && (item.kind == .Line || item.kind == .Oval) {
            number, ok := ReadCoordinate(value);
            if !ok || number < 0 || number > 32767*FRACTION { return false }
            stroke = number;
        }
        else { return false }
    }
    if text_index >= 0 && !SetText(state, id, TextView(args[text_index])) { return false }
    item.fill = fill;
    item.outline = outline;
    item.anchor = anchor;
    item.stroke = stroke;
    return true;
}

Create :: (state: *State, args: []Text, result: *T.Result) {
    name := TextView(args[0]);
    kind: Kind;
    if name == "rectangle" { kind = .Rectangle }
    else if name == "text" { kind = .Label }
    else if name == "line" { kind = .Line }
    else if name == "oval" { kind = .Oval }
    else { Error(result, "unsupported canvas item type"); return }
    foreground := kind == .Label || kind == .Line;
    id := Add(state, kind, .{}, ifx foreground then BLACK else NONE, ifx foreground then NONE else BLACK, .Center);
    if id < 1 { Error(result, "could not allocate canvas item"); return }
    item := Find(state, id);
    count: s64 = ifx kind == .Label then 2 else 4;
    valid: bool;
    if kind == .Line { count, valid = SetLine(item, args[1:], true) }
    else { valid = SetFixed(item, args[1:], count) }
    if !valid {
        unused VecResize(state.items, id-1);
        Error(result, "bad canvas coordinates");
        return;
    }
    if !UpdateItem(state, id, args[count+1:]) {
        unused VecResize(state.items, id-1);
        Error(result, "unsupported canvas item option or value");
        return;
    }
    Append(result, id);
}

Append :: (result: *T.Result, number: s64) {
    digits: [24]u8;
    if result.value.bytes.count != 0 { unused BuilderAppend(result.value.bytes, " ") }
    unused BuilderAppend(result.value.bytes, FormatInteger(number, digits[:]));
}

AppendCoordinates :: (result: *T.Result, coordinates: Coordinates, count: s64) {
    Append(result, coordinates.x0);
    Append(result, coordinates.y0);
    if count == 4 {
        Append(result, coordinates.x1);
        Append(result, coordinates.y1);
    }
}

AppendFixed :: (result: *T.Result, value: s64) {
    if value < 0 && value > -FRACTION {
        if result.value.bytes.count != 0 { unused BuilderAppend(result.value.bytes, " ") }
        unused BuilderAppend(result.value.bytes, "-0");
    } else { Append(result, value/FRACTION) }
    fraction := value%FRACTION;
    if fraction < 0 { fraction = -fraction }
    if fraction == 0 { return }
    unused BuilderAppend(result.value.bytes, ".");
    place: s64 = FRACTION/10;
    while fraction > 0 {
        unused VecPush(result.value.bytes, cast(u8)(48+fraction/place));
        fraction %= place;
        place /= 10;
    }
}

Command :: (state: *State, args: []Text, result: *T.Result) {
    subcommand := TextView(args[0]);
    if subcommand == "create" && args.count >= 2 { Create(state, args[1:], result); return }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-width" { Append(result, state.width); return }
        if option == "-height" { Append(result, state.height); return }
        if option == "-bd" || option == "-borderwidth" { Append(result, state.border); return }
        if option == "-relief" { unused BuilderAppend(result.value.bytes, ifx state.sunken then "sunken" else "flat"); return }
    }
    if args.count >= 2 && (subcommand == "bbox" || subcommand == "coords" ||
                          subcommand == "itemconfigure" || subcommand == "itemcget") {
        id, ok := T.ParseInteger(TextView(args[1]));
        item := Find(state, id);
        if !ok || item == null { Error(result, "bad canvas item"); return }
        if subcommand == "bbox" && args.count == 2 { AppendCoordinates(result, Bounds(item), 4); return }
        if subcommand == "coords" {
            count: s64 = ifx item.kind == .Label then 2 else 4;
            if args.count == 2 {
                if item.kind == .Line {
                    for * item.path { AppendFixed(result, it.x); AppendFixed(result, it.y) }
                } else {
                    AppendFixed(result, item.precise.x0);
                    AppendFixed(result, item.precise.y0);
                    if count == 4 {
                        AppendFixed(result, item.precise.x1);
                        AppendFixed(result, item.precise.y1);
                    }
                }
                return;
            }
            valid: bool;
            if item.kind == .Line { _, valid = SetLine(item, args[2:], false) }
            else { valid = args.count == count+2 && SetFixed(item, args[2:], count) }
            if !valid { Error(result, "bad canvas coordinates") }
            return;
        }
        if subcommand == "itemconfigure" && args.count >= 4 {
            if !UpdateItem(state, id, args[2:]) { Error(result, "unsupported canvas item option or value") }
            return;
        }
        if subcommand == "itemcget" && args.count == 3 && TextView(args[2]) == "-width" &&
           (item.kind == .Line || item.kind == .Oval) {
            AppendFixed(result, item.stroke);
            return;
        }
        if subcommand == "itemcget" && args.count == 3 && item.kind == .Label && TextView(args[2]) == "-text" {
            count := item.text.bytes.count;
            if !VecResize(result.value.bytes, count) { Error(result, "could not copy canvas item text"); return }
            for i: 0..count-1 { result.value.bytes[i] = item.text.bytes[i] }
            return;
        }
    }
    Error(result, "unsupported canvas subcommand or arguments");
}
