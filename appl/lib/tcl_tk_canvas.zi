// Integer-pixel text and rectangle items, following Inferno libtk/canvs.c.
#import "std/vec"
#import "std/number_text"
using T :: #import "tcl_types"
using UTF :: #import "tcl_tk_text"

NONE :: -1;
BLACK :: 0x000000;
WHITE :: 0xffffff;
RED :: 0xff0000;
CELL_WIDTH :: 12;
TEXT_HEIGHT :: 14;
MAX_CELLS :: 512;

Anchor :: enum { Center; North; Northeast; East; Southeast; South; Southwest; West; Northwest; }
Kind :: enum { Rectangle; Label; }
Coordinates :: struct { x0: s32; y0: s32; x1: s32; y1: s32; }
Item :: struct {
    kind: Kind;
    coordinates: Coordinates;
    anchor: Anchor;
    fill: s32;
    outline: s32;
    text: Text;
}
State :: struct { width: s32; height: s32; items: Vec(Item); }

Default :: () -> State { return .{width = 360, height = 270} }

Minimum :: (a: s32, b: s32) -> s32 { return ifx a < b then a else b }
Maximum :: (a: s32, b: s32) -> s32 { return ifx a > b then a else b }

Rectangle :: (coordinates: Coordinates) -> Coordinates {
    return .{Minimum(coordinates.x0, coordinates.x1), Minimum(coordinates.y0, coordinates.y1),
             Maximum(coordinates.x0, coordinates.x1), Maximum(coordinates.y0, coordinates.y1)};
}

Bounds :: (item: *Item) -> Coordinates {
    coordinates := item.coordinates;
    if item.kind == .Rectangle {
        rect := Rectangle(coordinates);
        return .{rect.x0-2, rect.y0-2, rect.x1+2, rect.y1+2};
    }
    width := UTF.Count(TextView(item.text), MAX_CELLS) * CELL_WIDTH;
    x := coordinates.x0;
    y := coordinates.y0;
    anchor := item.anchor;
    if anchor == .East || anchor == .Northeast || anchor == .Southeast { x -= width }
    else if anchor != .West && anchor != .Northwest && anchor != .Southwest { x -= width / 2 }
    if anchor == .South || anchor == .Southeast || anchor == .Southwest { y -= TEXT_HEIGHT }
    else if anchor != .North && anchor != .Northeast && anchor != .Northwest { y -= TEXT_HEIGHT / 2 }
    return .{x, y, x + width, y + TEXT_HEIGHT};
}

Add :: (state: *State, kind: Kind, coordinates: Coordinates, fill: s32, outline: s32, anchor: Anchor) -> s64 {
    index := state.items.count;
    if !VecResize(state.items, index+1) { return 0 }
    item := *state.items[index];
    item.kind = kind;
    item.coordinates = coordinates;
    item.fill = fill;
    item.outline = outline;
    item.anchor = anchor;
    return index+1;
}

AddRectangle :: (state: *State, coordinates: Coordinates, fill: s32, outline: s32) -> s64 {
    return Add(state, .Rectangle, coordinates, fill, outline, .Center);
}

Find :: (state: *State, id: s64) -> *Item {
    if id < 1 || id > state.items.count { return null }
    return *state.items[id-1];
}

SetCoordinates :: (state: *State, id: s64, coordinates: Coordinates) -> bool {
    item := Find(state, id);
    if item == null { return false }
    item.coordinates = coordinates;
    return true;
}

SetText :: (state: *State, id: s64, text: string) -> bool {
    item := Find(state, id);
    if item == null || item.kind != .Label || !VecResize(item.text.bytes, text.count) { return false }
    for i: 0..text.count-1 { item.text.bytes[i] = text[i] }
    return true;
}

AddText :: (state: *State, x: s32, y: s32, anchor: Anchor, text: string, fill: s32) -> s64 {
    id := Add(state, .Label, .{x, y, 0, 0}, fill, NONE, anchor);
    if id == 0 || SetText(state, id, text) { return id }
    unused VecResize(state.items, id-1);
    return 0;
}

Clear :: (state: *State) {
    unused VecResize(state.items, 0);
}

Error :: (result: *T.Result, message: string) {
    result.code = .Error;
    unused BuilderAppend(result.value.bytes, message);
}

Configure :: (state: *State, args: []Text, result: *T.Result) -> bool {
    width := state.width;
    height := state.height;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value, ok := T.ParseInteger(TextView(args[2*i+1]));
        if !ok || value < 0 || value > 32767 { Error(result, "bad canvas size"); return false }
        if option == "-width" { width = cast(s32)value }
        else if option == "-height" { height = cast(s32)value }
        else { Error(result, "unsupported canvas option"); return false }
    }
    state.width = width;
    state.height = height;
    return true;
}

ReadCoordinate :: (word: string) -> (pixel: s32, valid: bool) {
    value, ok := T.ParseInteger(word);
    return cast(s32)value, ok && value >= -1000000 && value <= 1000000;
}

ReadCoordinates :: (args: []Text, count: s64) -> (coordinates: Coordinates, valid: bool) {
    if args.count < count { return Coordinates.{}, false }
    x0, x0ok := ReadCoordinate(TextView(args[0]));
    y0, y0ok := ReadCoordinate(TextView(args[1]));
    if count == 2 { return Coordinates.{x0, y0, 0, 0}, x0ok && y0ok }
    x1, x1ok := ReadCoordinate(TextView(args[2]));
    y1, y1ok := ReadCoordinate(TextView(args[3]));
    return Coordinates.{x0, y0, x1, y1}, x0ok && y0ok && x1ok && y1ok;
}

ParseAnchor :: (word: string) -> (anchor: Anchor, valid: bool) {
    if word == "center" { return Anchor.Center, true }
    if word == "n" { return Anchor.North, true }
    if word == "ne" { return Anchor.Northeast, true }
    if word == "e" { return Anchor.East, true }
    if word == "se" { return Anchor.Southeast, true }
    if word == "s" { return Anchor.South, true }
    if word == "sw" { return Anchor.Southwest, true }
    if word == "w" { return Anchor.West, true }
    if word == "nw" { return Anchor.Northwest, true }
    return Anchor.Center, false;
}

ParseColor :: (word: string) -> (rgb: s32, valid: bool) {
    if word == "" { return NONE, true }
    if word == "black" { return BLACK, true }
    if word == "white" { return WHITE, true }
    if word == "red" { return RED, true }
    if word == "blue" { return 0x0000ff, true }
    if word == "green" { return 0x00ff00, true }
    if word.count != 7 || word[0] != 35 { return NONE, false }
    color: s32;
    for i: 1..6 {
        byte := cast(s32)word[i];
        if byte >= 48 && byte <= 57 { byte -= 48 }
        else if byte >= 65 && byte <= 70 { byte -= 55 }
        else if byte >= 97 && byte <= 102 { byte -= 87 }
        else { return NONE, false }
        color = 16*color + byte;
    }
    return color, true;
}

UpdateItem :: (state: *State, id: s64, args: []Text) -> bool {
    if args.count % 2 != 0 { return false }
    item := Find(state, id);
    fill := item.fill;
    outline := item.outline;
    anchor := item.anchor;
    text_index: s64 = -1;
    for i: 0..args.count/2-1 {
        option := TextView(args[2*i]);
        value := TextView(args[2*i+1]);
        if option == "-fill" || (option == "-outline" && item.kind == .Rectangle) {
            color, ok := ParseColor(value);
            if !ok { return false }
            if option == "-fill" { fill = color } else { outline = color }
        } else if option == "-anchor" && item.kind == .Label {
            parsed, ok := ParseAnchor(value);
            if !ok { return false }
            anchor = parsed;
        } else if option == "-text" && item.kind == .Label { text_index = 2*i+1 }
        else { return false }
    }
    if text_index >= 0 && !SetText(state, id, TextView(args[text_index])) { return false }
    item.fill = fill;
    item.outline = outline;
    item.anchor = anchor;
    return true;
}

Create :: (state: *State, args: []Text, result: *T.Result) {
    kind := TextView(args[0]);
    if kind != "rectangle" && kind != "text" { Error(result, "unsupported canvas item type"); return }
    count: s64 = ifx kind == "rectangle" then 4 else 2;
    coordinates, ok := ReadCoordinates(args[1:], count);
    if !ok { Error(result, "bad canvas coordinates"); return }
    id: s64;
    if kind == "rectangle" { id = AddRectangle(state, coordinates, NONE, BLACK) }
    else { id = AddText(state, coordinates.x0, coordinates.y0, .Center, "", BLACK) }
    if id < 1 { Error(result, "could not allocate canvas item"); return }
    if !UpdateItem(state, id, args[count+1:]) {
        unused VecResize(state.items, id-1);
        Error(result, "unsupported canvas item option or value");
        return;
    }
    Append(result, id);
}

Append :: (result: *T.Result, number: s64) {
    digits: [24]u8;
    if result.value.bytes.count != 0 { unused BuilderAppend(result.value.bytes, " ") }
    unused BuilderAppend(result.value.bytes, FormatInteger(number, digits[:]));
}

AppendCoordinates :: (result: *T.Result, coordinates: Coordinates, count: s64) {
    Append(result, coordinates.x0);
    Append(result, coordinates.y0);
    if count == 4 {
        Append(result, coordinates.x1);
        Append(result, coordinates.y1);
    }
}

Command :: (state: *State, args: []Text, result: *T.Result) {
    subcommand := TextView(args[0]);
    if subcommand == "create" && args.count >= 2 { Create(state, args[1:], result); return }
    if subcommand == "cget" && args.count == 2 {
        option := TextView(args[1]);
        if option == "-width" { Append(result, state.width); return }
        if option == "-height" { Append(result, state.height); return }
    }
    if args.count >= 2 && (subcommand == "bbox" || subcommand == "coords" ||
                          subcommand == "itemconfigure" || subcommand == "itemcget") {
        id, ok := T.ParseInteger(TextView(args[1]));
        item := Find(state, id);
        if !ok || item == null { Error(result, "bad canvas item"); return }
        if subcommand == "bbox" && args.count == 2 { AppendCoordinates(result, Bounds(item), 4); return }
        if subcommand == "coords" {
            count: s64 = ifx item.kind == .Rectangle then 4 else 2;
            if args.count == 2 { AppendCoordinates(result, item.coordinates, count); return }
            coordinates, valid := ReadCoordinates(args[2:], count);
            if !valid || args.count != count+2 { Error(result, "bad canvas coordinates"); return }
            unused SetCoordinates(state, id, coordinates);
            return;
        }
        if subcommand == "itemconfigure" && args.count >= 4 {
            if !UpdateItem(state, id, args[2:]) { Error(result, "unsupported canvas item option or value") }
            return;
        }
        if subcommand == "itemcget" && args.count == 3 && item.kind == .Label && TextView(args[2]) == "-text" {
            count := item.text.bytes.count;
            if !VecResize(result.value.bytes, count) { Error(result, "could not copy canvas item text"); return }
            for i: 0..count-1 { result.value.bytes[i] = item.text.bytes[i] }
            return;
        }
    }
    Error(result, "unsupported canvas subcommand or arguments");
}
