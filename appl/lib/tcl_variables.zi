// Tcl variables and stack links adapted from Inferno tcl_core.b and tcl_stack.b. See NOTICE.
#import "std/vec"
using T :: #import "tcl_types"
using L :: #import "tcl_lists"

Variable :: struct { name: Text; value: Text; }
VariableTable :: struct { entries: Vec(Variable); }
ArrayVariable :: struct { name: Text; elements: VariableTable; }
Alias :: struct { name: Text; target: Text; frame: *Frame; }
Frame :: struct {
    variables: VariableTable;
    arrays: Vec(ArrayVariable);
    aliases: Vec(Alias);
    parent: *Frame;
    level: s64;
}

VariableRef :: struct { frame: *Frame; base: Text; key: Text; element: bool; valid: bool; }

Parts :: (frame: *Frame, name: string) -> VariableRef {
    end := name.count;
    if end >= 2 && name[end-1] == 41 {
        for i: 1..end-2 { if name[i] == 40 { end = i; break } }
    }
    for i: 1..end-1 { if name[i-1] == 58 && name[i] == 58 { return .{} } }
    if end == name.count { return .{frame = frame, base = TextCopy(name), valid = true} }
    return .{frame = frame, base = TextCopy(name[:end]), key = TextCopy(name[end+1:name.count-1]), element = true, valid = true};
}

ScalarName :: (name: string) -> bool {
    parts := Parts(null, name);
    return parts.valid && !parts.element;
}

FindAlias :: (frame: *Frame, name: string) -> s64 {
    for * frame.aliases { if TextView(it.name) == name { return it_index } }
    return -1;
}

ResolveVariable :: (frame: *Frame, name: string) -> VariableRef {
    ref := Parts(frame, name);
    while ref.valid {
        index := FindAlias(ref.frame, TextView(ref.base));
        if index < 0 { break }
        target := Parts(ref.frame.aliases[index].frame, TextView(ref.frame.aliases[index].target));
        if target.element {
            if ref.element { return .{} }
            ref.element = true;
            VecSwap(ref.key.bytes, target.key.bytes);
        }
        ref.frame = target.frame;
        ref.valid = target.valid;
        VecSwap(ref.base.bytes, target.base.bytes);
    }
    return ref;
}

FindVariable :: (variables: *VariableTable, name: string) -> s64 {
    for * variables.entries { if TextView(it.name) == name { return it_index } }
    return -1;
}

FindArray :: (frame: *Frame, name: string) -> s64 {
    for * frame.arrays { if TextView(it.name) == name { return it_index } }
    return -1;
}

VariableExists :: (frame: *Frame, name: string) -> bool {
    ref := ResolveVariable(frame, name);
    if !ref.valid { return false }
    array := FindArray(ref.frame, TextView(ref.base));
    if ref.element { return array >= 0 && FindVariable(*ref.frame.arrays[array].elements, TextView(ref.key)) >= 0 }
    return array >= 0 || FindVariable(*ref.frame.variables, TextView(ref.base)) >= 0;
}

ReadVariable :: (frame: *Frame, name: string) -> Result {
    ref := ResolveVariable(frame, name);
    if !ref.valid { return Failure("invalid or unsupported variable name") }
    array := FindArray(ref.frame, TextView(ref.base));
    if ref.element {
        if array >= 0 {
            elements := *ref.frame.arrays[array].elements;
            index := FindVariable(elements, TextView(ref.key));
            if index >= 0 { return Success(TextView(ref.frame.arrays[array].elements.entries[index].value)) }
        }
    } else {
        if array >= 0 { return QuotedError("can't read \"", name, "\": variable is an array") }
        index := FindVariable(*ref.frame.variables, TextView(ref.base));
        if index >= 0 { return Success(TextView(ref.frame.variables.entries[index].value)) }
    }
    return QuotedError("can't read \"", name, "\": no such variable");
}

StoreValue :: (values: *VariableTable, name: string, value: string) -> bool {
    index := FindVariable(values, name);
    if index >= 0 {
        copy: Text = TextCopy(value);
        VecSwap(values.entries[index].value.bytes, copy.bytes);
        return true;
    }
    return VecPush(values.entries, Variable.{name = TextCopy(name), value = TextCopy(value)});
}

StoreVariable :: (frame: *Frame, name: string, value: string) -> Result {
    ref := ResolveVariable(frame, name);
    if !ref.valid { return Failure("invalid or unsupported variable name") }
    index := FindArray(ref.frame, TextView(ref.base));
    if ref.element {
        if FindVariable(*ref.frame.variables, TextView(ref.base)) >= 0 { return Failure("variable isn't an array") }
        if index < 0 {
            array := ArrayVariable.{name = TextCopy(TextView(ref.base))};
            if !StoreValue(*array.elements, TextView(ref.key), value) { return Failure("cannot allocate array element") }
            if !VecPush(ref.frame.arrays, array) {
                return Failure("cannot allocate array variable");
            }
        } else if !StoreValue(*ref.frame.arrays[index].elements, TextView(ref.key), value) {
            return Failure("cannot allocate array element");
        }
    } else {
        if index >= 0 { return Failure("variable is an array") }
        if !StoreValue(*ref.frame.variables, TextView(ref.base), value) { return Failure("cannot allocate variable") }
    }
    return Success(value);
}

RemoveValue :: (values: *VariableTable, name: string) -> bool {
    index := FindVariable(values, name);
    if index < 0 { return false }
    last := values.entries.count-1;
    if last != index {
        VecSwap(values.entries[index].name.bytes, values.entries[last].name.bytes);
        VecSwap(values.entries[index].value.bytes, values.entries[last].value.bytes);
    }
    unused VecResize(values.entries, last);
    return true;
}

RemoveVariable :: (frame: *Frame, name: string) -> Result {
    ref := ResolveVariable(frame, name);
    if !ref.valid { return Failure("invalid or unsupported variable name") }
    index := FindArray(ref.frame, TextView(ref.base));
    if ref.element {
        if index >= 0 && RemoveValue(*ref.frame.arrays[index].elements, TextView(ref.key)) { return Success() }
    } else if index >= 0 {
        last := ref.frame.arrays.count-1;
        if last != index {
            VecSwap(ref.frame.arrays[index].name.bytes, ref.frame.arrays[last].name.bytes);
            VecSwap(ref.frame.arrays[index].elements.entries, ref.frame.arrays[last].elements.entries);
        }
        unused VecResize(ref.frame.arrays, last);
        return Success();
    } else if RemoveValue(*ref.frame.variables, TextView(ref.base)) { return Success() }
    return QuotedError("can't unset \"", name, "\": no such variable");
}

RunArray :: (frame: *Frame, args: []Text) -> Result {
    if args.count != 2 { return WrongArgs("array names|size name") }
    option := TextView(args[0]);
    if option != "names" && option != "size" { return Failure("expected array names or size") }
    name := TextView(args[1]);
    ref := ResolveVariable(frame, name);
    index := ifx ref.valid && !ref.element then FindArray(ref.frame, TextView(ref.base)) else -1;
    if index < 0 { return QuotedError("", name, " isn't an array") }
    elements := *ref.frame.arrays[index].elements;
    if option == "size" { return Integer(elements.entries.count) }
    output: Text;
    for i: 0..elements.entries.count-1 { AppendElement(*output.bytes, TextView(ref.frame.arrays[index].elements.entries[i].name), i > 0) }
    return .{value = output};
}

LinkVariable :: (frame: *Frame, name: string, target: *Frame, target_name: string) -> Result {
    parts := Parts(target, target_name);
    if !ScalarName(name) || !parts.valid { return Failure("invalid alias name") }
    if target == frame || target == null { return Failure("expected an outer frame") }
    if FindVariable(*frame.variables, name) >= 0 || FindArray(frame, name) >= 0 { return Failure("alias would replace a local variable") }
    index := FindAlias(frame, name);
    if index >= 0 {
        copy: Text = TextCopy(target_name);
        VecSwap(frame.aliases[index].target.bytes, copy.bytes);
        frame.aliases[index].frame = target;
        return Success();
    }
    if !VecPush(frame.aliases, Alias.{name = TextCopy(name), target = TextCopy(target_name), frame = target}) {
        return Failure("cannot allocate variable alias");
    }
    return Success();
}

AppendDumpHeader :: (out: *Text, label: string, level: s64) -> bool {
    number := Integer(level);
    return BuilderAppend(out.bytes, label) && BuilderAppend(out.bytes, TextView(number.value)) && BuilderAppend(out.bytes, "\n");
}

AppendDumpValues :: (out: *Text, table: *VariableTable, indent: string) -> bool {
    for * table.entries {
        if !BuilderAppend(out.bytes, indent) || !BuilderAppend(out.bytes, "name [") || !BuilderAppend(out.bytes, TextView(it.name)) ||
            !BuilderAppend(out.bytes, "], value [") || !BuilderAppend(out.bytes, TextView(it.value)) || !BuilderAppend(out.bytes, "]\n") { return false }
    }
    return true;
}

AppendStackDump :: (out: *Text, frame: *Frame) -> bool {
    if frame == null { return true }
    if !AppendStackDump(out, frame.parent) || !AppendDumpHeader(out, "simple table at ", frame.level) ||
        !AppendDumpValues(out, *frame.variables, "\t") || !AppendDumpHeader(out, "assoc table at ", frame.level) { return false }
    for * frame.arrays {
        index := Integer(it_index);
        if !BuilderAppend(out.bytes, "\tassoc array at ") || !BuilderAppend(out.bytes, TextView(index.value)) ||
            !BuilderAppend(out.bytes, ", name ") || !BuilderAppend(out.bytes, TextView(it.name)) || !BuilderAppend(out.bytes, "\n") ||
            !AppendDumpValues(out, *it.elements, "\t\t") { return false }
    }
    if !AppendDumpHeader(out, "Symbol table at ", frame.level) { return false }
    for * frame.aliases {
        level := Integer(it.frame.level);
        if !BuilderAppend(out.bytes, "\tname [") || !BuilderAppend(out.bytes, TextView(it.name)) ||
            !BuilderAppend(out.bytes, "], alias [") || !BuilderAppend(out.bytes, TextView(it.target)) ||
            !BuilderAppend(out.bytes, "], value [") || !BuilderAppend(out.bytes, TextView(level.value)) || !BuilderAppend(out.bytes, "]\n") { return false }
    }
    return true;
}
