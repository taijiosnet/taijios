// acme/dis/awd: set current acme window's tag name and dumpdir to cwd.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
Bin :: #import "bin_common";

#program_export
main :: () -> s32 {
    fd := Io.OpenFile("/dev/acme/ctl", Bin.OWRITE);
    if fd < 0 { return 0 }
    dir := Io.Cwd();
    suffix := ifx Args.OperandCount() > 0 then Args.Operand(0) else "rc";

    name_cmd: Vec(u8);
    BuilderPrint(*name_cmd, "name %", dir);
    if dir.count == 0 || dir[dir.count - 1] != #char "/" {
        unused VecPush(name_cmd, #char "/");
    }
    BuilderPrint(*name_cmd, "-%\n", suffix);
    unused Bin.WriteAll(fd, BuilderFinish(name_cmd));

    dump_cmd: Vec(u8);
    BuilderPrint(*dump_cmd, "dumpdir %\n", dir);
    unused Bin.WriteAll(fd, BuilderFinish(dump_cmd));

    unused Io.CloseFile(fd);
    return 0;
}
