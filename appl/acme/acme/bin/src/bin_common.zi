// Shared helpers for acme/bin tools (adiff, agrep, awd, cd, new, spout, win, winm).
#import "std/vec";
using Io :: #import "taijios_io";
Process :: #import "taijios_process";

#scope_export

OREAD :: 0;
OWRITE :: 1;
ORDWR :: 2;

LineReader :: struct {
    handle: s32;
    buf: [4096]u8;
    start: s64;
    end: s64;
    done: bool;
}

CopyStr :: (s: string) -> string {
    return TextDetach(TextCopy(s));
}

WriteAll :: (fd: s32, text: string) -> bool {
    done: s64 = 0;
    while done < text.count {
        n := Io.WriteBytes(fd, text[done:]);
        if n <= 0 { return false }
        done += n;
    }
    return true;
}

PrintErr :: (text: string) {
    unused WriteAll(2, text);
}

ParseInt :: (s: string) -> s32 {
    i: s64 = 0;
    while i < s.count && (s[i] == #char " " || s[i] == #char "\t" || s[i] == #char "\n" || s[i] == #char "\r") {
        i += 1;
    }
    neg := false;
    if i < s.count && s[i] == #char "-" {
        neg = true;
        i += 1;
    } else if i < s.count && s[i] == #char "+" {
        i += 1;
    }
    val: s64 = 0;
    while i < s.count && s[i] >= #char "0" && s[i] <= #char "9" {
        val = val * 10 + cast(s64)(s[i] - #char "0");
        i += 1;
    }
    if neg { val = -val }
    return cast(s32)val;
}

Basename :: (s: string) -> string {
    i := s.count - 1;
    while i >= 0 {
        if s[i] == #char "/" { return s[i + 1:] }
        i -= 1;
    }
    return s;
}

Exists :: (path: string) -> bool {
    meta: [12]u8;
    return Io.StatFile(path, meta[:]) >= 0;
}

IsDir :: (path: string) -> (is_dir: bool, ok: bool) {
    meta: [12]u8;
    if Io.StatFile(path, meta[:]) < 0 { return false, false }
    mode := cast(u32)meta[8] | (cast(u32)meta[9] << 8) | (cast(u32)meta[10] << 16) | (cast(u32)meta[11] << 24);
    return (mode & 0x80000000) != 0, true;
}

HasSuffix :: (s: string, suf: string) -> bool {
    if s.count < suf.count { return false }
    return s[s.count - suf.count:] == suf;
}

ResolveCommand :: (cmd: string) -> string {
    if HasSuffix(cmd, ".zx") || HasSuffix(cmd, ".dis") {
        if Exists(cmd) { return cmd }
    } else {
        zx: Vec(u8);
        BuilderPrint(*zx, "%.zx", cmd);
        zxs := CopyStr(BuilderFinish(zx));
        if Exists(zxs) { return zxs }

        dis: Vec(u8);
        BuilderPrint(*dis, "%.dis", cmd);
        diss := CopyStr(BuilderFinish(dis));
        if Exists(diss) { return diss }
    }
    is_rel := cmd.count == 0 || (cmd[0] != #char "/" && !(cmd.count >= 2 && cmd[0] == #char "." && cmd[1] == #char "/"));
    if is_rel {
        if HasSuffix(cmd, ".zx") || HasSuffix(cmd, ".dis") {
            p: Vec(u8);
            BuilderPrint(*p, "/zx/%", cmd);
            ps := CopyStr(BuilderFinish(p));
            if Exists(ps) { return ps }
        } else {
            zx: Vec(u8);
            BuilderPrint(*zx, "/zx/%.zx", cmd);
            zxs := CopyStr(BuilderFinish(zx));
            if Exists(zxs) { return zxs }

            dis: Vec(u8);
            BuilderPrint(*dis, "/zx/%.dis", cmd);
            diss := CopyStr(BuilderFinish(dis));
            if Exists(diss) { return diss }
        }
    }
    return "";
}

QuoteShell :: (out: *Vec(u8), word: string) {
    needs := word.count == 0;
    for word {
        if it <= cast(u8)32 || it == #char "'" || it == #char "\"" || it == #char "$" || it == #char "#" || it == #char ";" || it == #char "|" || it == #char "&" || it == #char "(" || it == #char ")" || it == #char "{" || it == #char "}" || it == #char "<" || it == #char ">" {
            needs = true;
            break;
        }
    }
    if !needs {
        unused BuilderAppend(out.*, word);
        return;
    }
    unused VecPush(out.*, #char "'");
    for word {
        if it == #char "'" { unused VecPush(out.*, #char "'") }
        unused VecPush(out.*, it);
    }
    unused VecPush(out.*, #char "'");
}

StartResolved :: (resolved: string, args: []string, fd_in: s32, fd_out: s32, fd_err: s32) -> Process.Launch {
    if HasSuffix(resolved, ".zx") {
        return Process.StartWith(resolved, args, fd_in, fd_out, fd_err);
    }
    line: Vec(u8);
    QuoteShell(*line, resolved);
    for args {
        unused VecPush(line, #char " ");
        QuoteShell(*line, it);
    }
    sh_args := string.["-c", BuilderFinish(line)];
    return Process.StartWith("/zx/sh.zx", sh_args[:], fd_in, fd_out, fd_err);
}

ReadLine :: (r: *LineReader) -> (text: string, ok: bool) {
    line: Vec(u8);
    while true {
        if r.start >= r.end {
            if r.done { break }
            n := Io.ReadBytes(r.handle, r.buf[:]);
            if n <= 0 {
                r.done = true;
                break;
            }
            r.start = 0;
            r.end = cast(s64)n;
        }
        c := r.buf[r.start];
        r.start += 1;
        unused VecPush(line, c);
        if c == #char "\n" { break }
    }
    if line.count == 0 { return "", false }
    return CopyStr(BuilderFinish(line)), true;
}

ReadUser :: () -> string {
    fd := Io.OpenFile("/dev/user", OREAD);
    if fd < 0 { return "inferno" }
    buf: [128]u8;
    n := Io.ReadBytes(fd, buf[:]);
    unused Io.CloseFile(fd);
    if n <= 0 { return "inferno" }
    return CopyStr(TextView(buf[:n]));
}

ReadSysname :: () -> string {
    fd := Io.OpenFile("#c/sysname", OREAD);
    if fd < 0 { return "" }
    buf: [128]u8;
    n := Io.ReadBytes(fd, buf[:]);
    unused Io.CloseFile(fd);
    if n <= 0 { return "" }
    return CopyStr(TextView(buf[:n]));
}

Utf8CharWidth :: (buf: []u8, at: s64, limit: s64) -> s64 {
    if at >= limit { return 0 }
    b := buf[at];
    if b < 0x80 { return 1 }
    if (b & 0xE0) == 0xC0 {
        if at + 2 <= limit { return 2 }
        return 1;
    }
    if (b & 0xF0) == 0xE0 {
        if at + 3 <= limit { return 3 }
        return 1;
    }
    if (b & 0xF8) == 0xF0 {
        if at + 4 <= limit { return 4 }
        return 1;
    }
    return 1;
}

NRunes :: (buf: []u8, nb: s64) -> s32 {
    i: s64 = 0;
    n: s32 = 0;
    while i < nb {
        w := Utf8CharWidth(buf, i, nb);
        if w <= 0 { break }
        i += w;
        n += 1;
    }
    return n;
}
