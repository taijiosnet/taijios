// Shared implementation for acme/dis/win and acme/dis/winm.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
Namespace :: #import "taijios_namespace";
Process :: #import "taijios_process";
Bin :: #import "bin_common";

#scope_export

EVENTSIZE :: 256;
UTFMAX :: 4;

Event :: struct {
    c1: u8;
    c2: u8;
    q0: s32;
    q1: s32;
    flag: s32;
    nr: s32;
    nb: s32;
    b: [EVENTSIZE * UTFMAX + 1]u8;
}

WinState :: struct {
    qp: s32;
    typing: Vec(u8);
    ntyper: s32;
    ntypebreak: s32;
    child_id: s32;
    ev_buf: [8192]u8;
    ev_pos: s64;
    ev_len: s64;
    ev_eof: bool;
}

RunWin :: (set_acmewin: bool, self_path: string) -> s32 {
    count := Args.OperandCount();
    // Internal child trampoline mode: -%child <id> <cmd> [args...]
    if count >= 3 && Args.Operand(0) == "-%child" {
        return RunChild(Args.Operand(1), count);
    }

    unused Process.NewPgrp();
    unused Namespace.Fork();

    prog_args: Vec(string);
    if count > 0 {
        for i: 0..count - 1 {
            unused VecPush(prog_args, Bin.CopyStr(Args.Operand(i)));
        }
    } else {
        unused VecPush(prog_args, "sh");
    }

    name: string = "";
    if count == 0 {
        name = Bin.ReadSysname();
    }
    if name.count == 0 {
        nb: Vec(u8);
        unused BuilderAppend(nb, Bin.Basename(prog_args[0]));
        for i: 1..prog_args.count - 1 {
            if nb.count + 1 + prog_args[i].count >= 16 { break }
            unused VecPush(nb, #char "_");
            unused BuilderAppend(nb, prog_args[i]);
        }
        name = Bin.CopyStr(BuilderFinish(nb));
    }

    if Namespace.Bind("#|", "/dev/acme", Namespace.Replace) < 0 {
        Fail("pipe");
        return 0;
    }

    ctlfd := Io.OpenFile("/chan/new/ctl", Bin.ORDWR);
    if ctlfd < 0 {
        Fail("ctl");
        return 0;
    }
    idbuf: [12]u8;
    if Io.ReadBytes(ctlfd, idbuf[:]) != 12 {
        unused Io.CloseFile(ctlfd);
        Fail("ctl");
        return 0;
    }
    id := Bin.ParseInt(TextView(idbuf[:12]));

    if set_acmewin {
        ef := Io.CreateFile("/env/acmewin", Bin.OWRITE, 0x1B6);
        if ef >= 0 {
            ids: Vec(u8);
            BuilderPrint(*ids, "%", id);
            unused Bin.WriteAll(ef, BuilderFinish(ids));
            unused Io.CloseFile(ef);
        }
    }

    tagp: Vec(u8);
    BuilderPrint(*tagp, "/chan/%/tag", id);
    tfd := Io.OpenFile(BuilderFinish(tagp), Bin.OWRITE);
    if tfd >= 0 {
        unused Bin.WriteAll(tfd, " Send Delete");
        unused Io.CloseFile(tfd);
    }

    evp: Vec(u8);
    BuilderPrint(*evp, "/chan/%/event", id);
    eventfd := Io.OpenFile(BuilderFinish(evp), Bin.ORDWR);

    adp: Vec(u8);
    BuilderPrint(*adp, "/chan/%/addr", id);
    addrfd := Io.OpenFile(BuilderFinish(adp), Bin.ORDWR);

    dtp: Vec(u8);
    BuilderPrint(*dtp, "/chan/%/data", id);
    datafd := Io.OpenFile(BuilderFinish(dtp), Bin.ORDWR);

    if eventfd < 0 || addrfd < 0 || datafd < 0 {
        if eventfd >= 0 { unused Io.CloseFile(eventfd) }
        if addrfd >= 0 { unused Io.CloseFile(addrfd) }
        if datafd >= 0 { unused Io.CloseFile(datafd) }
        unused Io.CloseFile(ctlfd);
        Fail("data files");
        return 0;
    }

    pipe_fd := Io.OpenFile("/dev/acme/data", Bin.ORDWR);
    if pipe_fd < 0 {
        unused Io.CloseFile(eventfd);
        unused Io.CloseFile(addrfd);
        unused Io.CloseFile(datafd);
        unused Io.CloseFile(ctlfd);
        Fail("/dev/acme/data");
        return 0;
    }

    // Start child via self trampoline so it binds /dev/cons, /dev/acme, /dev/consctl in its own namespace.
    child_ops: Vec(string);
    unused VecPush(child_ops, "-%child");
    ids2: Vec(u8);
    BuilderPrint(*ids2, "%", id);
    unused VecPush(child_ops, Bin.CopyStr(BuilderFinish(ids2)));
    for i: 0..prog_args.count - 1 {
        unused VecPush(child_ops, prog_args[i]);
    }
    launch := Process.Start(self_path, child_ops[:]);

    wd := Io.Cwd();
    cmd1: Vec(u8);
    BuilderPrint(*cmd1, "name %/-%\n", wd, name);
    unused Bin.WriteAll(ctlfd, BuilderFinish(cmd1));

    cmd2: Vec(u8);
    BuilderPrint(*cmd2, "dumpdir %/\n", wd);
    unused Bin.WriteAll(ctlfd, BuilderFinish(cmd2));

    cmd3: Vec(u8);
    unused BuilderAppend(cmd3, "dump win");
    for i: 0..count - 1 {
        unused VecPush(cmd3, #char " ");
        unused BuilderAppend(cmd3, Args.Operand(i));
    }
    unused VecPush(cmd3, #char "\n");
    unused Bin.WriteAll(ctlfd, BuilderFinish(cmd3));

    st: WinState;
    st.child_id = launch.id;

    // Event + stdout multiplex loop using PollRead.
    outbuf: [8192 + UTFMAX + 1]u8;
    npart: s64 = 0;

    while true {
        did_work := false;

        // 1. Drain child stdout/stderr from pipe_fd into acme window body.
        nr := Io.PollRead(pipe_fd, outbuf[npart:npart + 8192]);
        if nr > 0 {
            did_work = true;
            n := CastSquashNuls(outbuf[:], npart, cast(s64)nr) + npart;
            // Hold trailing partial UTF-8 rune.
            npart = 0;
            while n > 0 && (outbuf[n - 1] & 0xC0) != 0 {
                n -= 1;
                npart += 1;
                if (outbuf[n] & 0xC0) != 0x80 {
                    w := FullUtf8Width(outbuf[n:n + npart]);
                    if w > 0 {
                        n += w;
                        npart -= w;
                    }
                    break;
                }
            }
            if n > 0 {
                hold: [UTFMAX]u8;
                for k: 0..npart - 1 { hold[k] = outbuf[n + k] }
                addr: Vec(u8);
                BuilderPrint(*addr, "#%", st.qp);
                as := BuilderFinish(addr);
                if Io.WriteBytes(addrfd, as) != cast(s32)as.count {
                    Fail("stdout writing address");
                    break;
                }
                if !Bin.WriteAll(datafd, TextView(outbuf[:n])) {
                    Fail("stdout writing body");
                    break;
                }
                st.qp += Bin.NRunes(outbuf[:n], n);
                for k: 0..npart - 1 { outbuf[k] = hold[k] }
            }
        } else if nr == -1 {
            break;
        }

        // 2. Poll acme event file.
        if PollEvent(*st, eventfd) {
            did_work = true;
            if st.ev_eof { break }
            ProcessEvents(*st, pipe_fd, ctlfd, eventfd, addrfd, datafd);
            if st.ev_eof { break }
        }

        // 3. Check if child has exited; if so, drain any remaining buffered pipe output before exiting.
        if !did_work && st.child_id > 0 {
            out := Process.Poll(st.child_id);
            if out.status != -2 {
                st.child_id = 0;
                while true {
                    dr := Io.PollRead(pipe_fd, outbuf[npart:npart + 8192]);
                    if dr <= 0 { break }
                    n := CastSquashNuls(outbuf[:], npart, cast(s64)dr) + npart;
                    if n > 0 {
                        addr: Vec(u8);
                        BuilderPrint(*addr, "#%", st.qp);
                        as := BuilderFinish(addr);
                        if Io.WriteBytes(addrfd, as) == cast(s32)as.count {
                            unused Bin.WriteAll(datafd, TextView(outbuf[:n]));
                            st.qp += Bin.NRunes(outbuf[:n], n);
                        }
                        npart = 0;
                    }
                }
                break;
            }
        }
    }

    if st.child_id > 0 {
        unused Process.Kill(st.child_id);
        unused Process.Wait(st.child_id);
    }
    unused Io.CloseFile(pipe_fd);
    unused Io.CloseFile(eventfd);
    unused Io.CloseFile(addrfd);
    unused Io.CloseFile(datafd);
    unused Io.CloseFile(ctlfd);
    return 0;
}

#scope_file

Fail :: (s: string) {
    msg: Vec(u8);
    BuilderPrint(*msg, "win: %: %\n", s, Io.LastError());
    Bin.PrintErr(BuilderFinish(msg));
}

RunChild :: (id_str: string, argc: s32) -> s32 {
    unused Namespace.ForkEnv();
    unused Process.NewPgrp();
    unused Namespace.Fork();

    if Namespace.Bind("/dev/acme/data1", "/dev/cons", Namespace.Replace) < 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "can't bind /dev/cons: %\n", Io.LastError());
        Bin.PrintErr(BuilderFinish(msg));
        return 1;
    }
    fd0 := Io.OpenFile("/dev/cons", Bin.OREAD);
    fd1 := Io.OpenFile("/dev/cons", Bin.OWRITE);
    if fd0 < 0 || fd1 < 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "can't open /dev/cons: %\n", Io.LastError());
        Bin.PrintErr(BuilderFinish(msg));
        return 1;
    }

    acmedir: Vec(u8);
    BuilderPrint(*acmedir, "/chan/%", id_str);
    unused Namespace.Bind(BuilderFinish(acmedir), "/dev/acme", Namespace.Replace);

    consctl: Vec(u8);
    BuilderPrint(*consctl, "/chan/%/consctl", id_str);
    unused Namespace.Bind(BuilderFinish(consctl), "/dev/consctl", Namespace.Replace);

    cmd := Args.Operand(2);
    resolved := Bin.ResolveCommand(cmd);
    if resolved.count == 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "%: file does not exist\n", cmd);
        unused Bin.WriteAll(fd1, BuilderFinish(msg));
        unused Io.CloseFile(fd0);
        unused Io.CloseFile(fd1);
        return 1;
    }
    ops: Vec(string);
    for i: 3..argc - 1 {
        unused VecPush(ops, Bin.CopyStr(Args.Operand(i)));
    }
    launch := Bin.StartResolved(resolved, ops[:], fd0, fd1, fd1);
    unused Io.CloseFile(fd0);
    unused Io.CloseFile(fd1);
    if launch.id > 0 {
        unused Process.Wait(launch.id);
    }
    return 0;
}

CastSquashNuls :: (buf: []u8, npart: s64, n: s64) -> s64 {
    t: s64 = 0;
    for s: 0..n - 1 {
        if buf[npart + s] != 0 {
            buf[npart + t] = buf[npart + s];
            t += 1;
        }
    }
    return t;
}

FullUtf8Width :: (b: []u8) -> s64 {
    if b.count == 0 { return 0 }
    c := b[0];
    if c < 0x80 { return 1 }
    if (c & 0xE0) == 0xC0 { return ifx b.count >= 2 then 2 else 0 }
    if (c & 0xF0) == 0xE0 { return ifx b.count >= 3 then 3 else 0 }
    if (c & 0xF8) == 0xF0 { return ifx b.count >= 4 then 4 else 0 }
    return 1;
}

PollEvent :: (st: *WinState, efd: s32) -> bool {
    if st.ev_pos < st.ev_len { return true }
    n := Io.PollRead(efd, st.ev_buf[:]);
    if n == -2 { return false }
    if n <= 0 {
        st.ev_eof = true;
        return true;
    }
    st.ev_pos = 0;
    st.ev_len = cast(s64)n;
    return true;
}

GetEvByte :: (st: *WinState, efd: s32) -> (b: u8, ok: bool) {
    if st.ev_pos >= st.ev_len {
        n := Io.ReadBytes(efd, st.ev_buf[:]);
        if n <= 0 {
            st.ev_eof = true;
            return 0, false;
        }
        st.ev_pos = 0;
        st.ev_len = cast(s64)n;
    }
    c := st.ev_buf[st.ev_pos];
    st.ev_pos += 1;
    return c, true;
}

GetEvNum :: (st: *WinState, efd: s32) -> (val: s32, ok: bool) {
    n: s32 = 0;
    while true {
        c, ok := GetEvByte(st, efd);
        if !ok { return 0, false }
        if c >= #char "0" && c <= #char "9" {
            n = n * 10 + cast(s32)(c - #char "0");
        } else if c == #char " " {
            return n, true;
        } else {
            return 0, false;
        }
    }
    return 0, false;
}

GetEvent :: (st: *WinState, efd: s32, e: *Event) -> bool {
    c1, ok1 := GetEvByte(st, efd);
    if !ok1 { return false }
    c2, ok2 := GetEvByte(st, efd);
    if !ok2 { return false }
    q0, ok3 := GetEvNum(st, efd);
    if !ok3 { return false }
    q1, ok4 := GetEvNum(st, efd);
    if !ok4 { return false }
    flag, ok5 := GetEvNum(st, efd);
    if !ok5 { return false }
    nr, ok6 := GetEvNum(st, efd);
    if !ok6 || nr < 0 || nr > EVENTSIZE { return false }

    e.c1 = c1;
    e.c2 = c2;
    e.q0 = q0;
    e.q1 = q1;
    e.flag = flag;
    e.nr = nr;
    e.nb = 0;

    for i: 0..nr - 1 {
        b0, okb := GetEvByte(st, efd);
        if !okb { return false }
        e.b[e.nb] = b0;
        e.nb += 1;
        extra: s32 = 0;
        if b0 >= 0x80 {
            if (b0 & 0xE0) == 0xC0 { extra = 1 }
            else if (b0 & 0xF0) == 0xE0 { extra = 2 }
            else if (b0 & 0xF8) == 0xF0 { extra = 3 }
        }
        for k: 0..extra - 1 {
            bx, okx := GetEvByte(st, efd);
            if !okx { return false }
            e.b[e.nb] = bx;
            e.nb += 1;
        }
    }
    e.b[e.nb] = 0;
    nl, oknl := GetEvByte(st, efd);
    if !oknl || nl != #char "\n" { return false }
    return true;
}

EchoEvent :: (efd: s32, e: *Event) {
    out: Vec(u8);
    unused VecPush(out, e.c1);
    unused VecPush(out, e.c2);
    BuilderPrint(*out, "% %\n", e.q0, e.q1);
    unused Bin.WriteAll(efd, BuilderFinish(out));
}

AddType :: (st: *WinState, c: u8, p0: s32, b: []u8, nb: s64, nr: s32) {
    i: s64 = 0;
    while i < nb {
        ch := b[i];
        w := Bin.Utf8CharWidth(b, i, nb);
        if ch == 0x7F && c == #char "K" {
            if st.child_id > 0 { unused Process.Kill(st.child_id) }
            st.qp += st.ntyper + nr;
            st.ntypebreak = 0;
            VecClear(st.typing);
            st.ntyper = 0;
            return;
        }
        if ch == #char "\n" || ch == 0x04 { st.ntypebreak += 1 }
        i += w;
    }

    if p0 == st.ntyper {
        for k: 0..nb - 1 { unused VecPush(st.typing, b[k]) }
    } else {
        b0: s64 = 0;
        p: s32 = 0;
        while p < p0 && b0 < st.typing.count {
            b0 += Bin.Utf8CharWidth(st.typing[:], b0, st.typing.count);
            p += 1;
        }
        next: Vec(u8);
        for k: 0..b0 - 1 { unused VecPush(next, st.typing[k]) }
        for k: 0..nb - 1 { unused VecPush(next, b[k]) }
        for k: b0..st.typing.count - 1 { unused VecPush(next, st.typing[k]) }
        VecClear(st.typing);
        for k: 0..next.count - 1 { unused VecPush(st.typing, next[k]) }
    }
    st.ntyper += nr;
}

SendType :: (st: *WinState, fd0: s32, raw: bool) {
    while st.ntypebreak > 0 {
        brkc := false;
        i: s64 = 0;
        while i < st.typing.count {
            ch := st.typing[i];
            if ch == #char "\n" || ch == 0x04 {
                n := ifx ch == #char "\n" then i + 1 else i;
                i += 1;
                if n > 0 {
                    unused Bin.WriteAll(fd0, TextView(st.typing[:n]));
                } else {
                    unused Io.WriteBytes(fd0, "");
                }
                nr := Bin.NRunes(st.typing[:i], i);
                if !raw { st.qp += nr }
                st.ntyper -= nr;
                rem: Vec(u8);
                for k: i..st.typing.count - 1 { unused VecPush(rem, st.typing[k]) }
                VecClear(st.typing);
                for k: 0..rem.count - 1 { unused VecPush(st.typing, rem[k]) }
                i = 0;
                st.ntypebreak -= 1;
                brkc = true;
            } else {
                i += 1;
            }
        }
        if !brkc { st.ntypebreak = 0 }
    }
}

DelType :: (st: *WinState, p0: s32, p1: s32) {
    b0: s64 = 0;
    p: s32 = 0;
    while p < p0 && b0 < st.typing.count {
        b0 += Bin.Utf8CharWidth(st.typing[:], b0, st.typing.count);
        p += 1;
    }
    b1 := b0;
    while p < p1 && b1 < st.typing.count {
        ch := st.typing[b1];
        if ch == #char "\n" || ch == 0x04 { st.ntypebreak -= 1 }
        b1 += Bin.Utf8CharWidth(st.typing[:], b1, st.typing.count);
        p += 1;
    }
    rem: Vec(u8);
    for k: 0..b0 - 1 { unused VecPush(rem, st.typing[k]) }
    for k: b1..st.typing.count - 1 { unused VecPush(rem, st.typing[k]) }
    VecClear(st.typing);
    for k: 0..rem.count - 1 { unused VecPush(st.typing, rem[k]) }
    st.ntyper -= p1 - p0;
}

DeleteEv :: (st: *WinState, e: *Event) -> s32 {
    q0 := e.q0;
    q1 := e.q1;
    if q1 <= st.qp { return e.q1 - e.q0 }
    if q0 >= st.qp + st.ntyper { return 0 }
    deltap: s32 = 0;
    if q0 < st.qp {
        deltap = st.qp - q0;
        q0 = 0;
    } else {
        q0 -= st.qp;
    }
    if q1 > st.qp + st.ntyper {
        q1 = st.ntyper;
    } else {
        q1 -= st.qp;
    }
    DelType(st, q0, q1);
    return deltap;
}

TypeX :: (st: *WinState, e: *Event, fd0: s32, afd: s32, dfd: s32) {
    if e.nr > 0 {
        AddType(st, e.c1, e.q0 - st.qp, e.b[:e.nb], cast(s64)e.nb, e.nr);
    } else {
        buf: [128]u8;
        m := e.q0;
        while m < e.q1 {
            a: Vec(u8);
            BuilderPrint(*a, "#%", m);
            unused Bin.WriteAll(afd, BuilderFinish(a));
            n := Io.ReadBytes(dfd, buf[:]);
            if n <= 0 { break }
            nb := cast(s64)n;
            nr := Bin.NRunes(buf[:nb], nb);
            while m + nr > e.q1 && nb > 0 {
                nb -= 1;
                while nb > 0 && (buf[nb] & 0xC0) == 0x80 { nb -= 1 }
                nr -= 1;
            }
            if nb == 0 { break }
            AddType(st, e.c1, m - st.qp, buf[:nb], nb, nr);
            m += nr;
        }
    }
    SendType(st, fd0, false);
}

SendEv :: (st: *WinState, e: *Event, fd0: s32, cfd: s32, afd: s32, dfd: s32, donl: bool) {
    end := st.qp + st.ntyper;
    a: Vec(u8);
    BuilderPrint(*a, "#%", end);
    unused Bin.WriteAll(afd, BuilderFinish(a));
    lastc: u8 = 0;

    if e.nr > 0 {
        unused Bin.WriteAll(dfd, TextView(e.b[:e.nb]));
        AddType(st, e.c1, st.ntyper, e.b[:e.nb], cast(s64)e.nb, e.nr);
        if e.nb > 0 { lastc = e.b[e.nb - 1] }
    } else {
        buf: [128]u8;
        m := e.q0;
        while m < e.q1 {
            a1: Vec(u8);
            BuilderPrint(*a1, "#%", m);
            unused Bin.WriteAll(afd, BuilderFinish(a1));
            n := Io.ReadBytes(dfd, buf[:]);
            if n <= 0 { break }
            nb := cast(s64)n;
            nr := Bin.NRunes(buf[:nb], nb);
            while m + nr > e.q1 && nb > 0 {
                nb -= 1;
                while nb > 0 && (buf[nb] & 0xC0) == 0x80 { nb -= 1 }
                nr -= 1;
            }
            if nb == 0 { break }
            a2: Vec(u8);
            BuilderPrint(*a2, "#%", end);
            unused Bin.WriteAll(afd, BuilderFinish(a2));
            unused Bin.WriteAll(dfd, TextView(buf[:nb]));
            AddType(st, e.c1, st.ntyper, buf[:nb], nb, nr);
            lastc = buf[nb - 1];
            m += nr;
            end += nr;
        }
    }
    if donl && lastc != #char "\n" {
        nl: [1]u8 = .[#char "\n"];
        unused Bin.WriteAll(dfd, "\n");
        AddType(st, e.c1, st.ntyper, nl[:], 1, 1);
    }
    unused Bin.WriteAll(cfd, "dot=addr");
    SendType(st, fd0, false);
}

ProcessEvents :: (st: *WinState, fd0: s32, cfd: s32, efd: s32, afd: s32, dfd: s32) {
    while st.ev_pos < st.ev_len && !st.ev_eof {
        e: Event;
        e2: Event;
        e3: Event;
        e4: Event;
        if !GetEvent(st, efd, *e) { break }

        if e.c1 == #char "E" || e.c1 == #char "F" {
            continue;
        }
        if e.c1 == #char "K" || e.c1 == #char "M" {
            if e.c2 == #char "R" {
                AddType(st, #char " ", st.ntyper, e.b[:e.nb], cast(s64)e.nb, e.nr);
                SendType(st, fd0, true);
            } else if e.c2 == #char "I" {
                if e.q0 < st.qp {
                    st.qp += e.q1 - e.q0;
                } else if e.q0 <= st.qp + st.ntyper {
                    TypeX(st, *e, fd0, afd, dfd);
                }
            } else if e.c2 == #char "D" {
                st.qp -= DeleteEv(st, *e);
            } else if e.c2 == #char "x" || e.c2 == #char "X" {
                if (e.flag & 2) != 0 { unused GetEvent(st, efd, *e2) }
                if (e.flag & 8) != 0 {
                    unused GetEvent(st, efd, *e3);
                    unused GetEvent(st, efd, *e4);
                }
                if (e.flag & 1) != 0 || (e.c2 == #char "x" && e.nr == 0 && e2.nr == 0) {
                    EchoEvent(efd, *e);
                    continue;
                }
                if e.q0 == e.q1 && (e.flag & 2) != 0 {
                    e2.flag = e.flag;
                    e = e2;
                }
                if (e.flag & 8) != 0 {
                    if e.q1 != e.q0 {
                        SendEv(st, *e, fd0, cfd, afd, dfd, false);
                        blank: Event;
                        blank.c1 = #char "M";
                        blank.c2 = #char "X";
                        blank.nr = 1;
                        blank.nb = 1;
                        blank.b[0] = #char " ";
                        SendEv(st, *blank, fd0, cfd, afd, dfd, false);
                    }
                    SendEv(st, *e3, fd0, cfd, afd, dfd, true);
                } else if e.q1 != e.q0 {
                    SendEv(st, *e, fd0, cfd, afd, dfd, true);
                }
            } else if e.c2 == #char "l" || e.c2 == #char "L" {
                if (e.flag & 2) != 0 { unused GetEvent(st, efd, *e2) }
                EchoEvent(efd, *e);
            } else if e.c2 == #char "d" || e.c2 == #char "i" {
                // ignore
            }
        }
    }
}
