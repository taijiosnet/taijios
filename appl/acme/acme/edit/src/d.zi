// acme/edit/d: delete each addressed range (equivalent to c '').
using Args :: #import "taijios_args";
Edit :: #import "edit_common";

#program_export
main :: () -> s32 {
    if Args.OperandCount() != 0 {
        Edit.PrintErr("usage : d\n");
        return 0;
    }
    return Edit.RunEdit("c", "", true, 0);
}
