jpg2bit.zx: jpg2bit.zi jpg2bit_model.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../cmd --bind-host taijios_args --bind-host taijios_io --entry jpg2bit:main -o $target jpg2bit.zi

$DISBIN/jpg2bit.zx: jpg2bit.zx
