<../../../mkconfig

TARG=\

MODULES=\

SYSMODULES=\

DISBIN=$ROOT/dis/grid/demo

<$ROOT/mkfiles/mkdis

blur.zx: blur.zi block_fs.zi block_model.zi ../../cmd/tcltk/zx_surface.zi ../../cmd/taijios_args.zi ../../cmd/taijios_clock.zi ../../cmd/taijios_io.zi ../../cmd/taijios_stat.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../../cmd/tcltk --module-path ../../cmd --bind-host zx_surface --bind-host taijios_args --bind-host taijios_clock --bind-host taijios_io --bind-host taijios_stat --entry blur:main -o $target blur.zi

$DISBIN/blur.zx: blur.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 blur.zx "$staged" && mv "$staged" "$target"

install:V:	$DISBIN/blur.zx
%.install:V:	$DISBIN/%
%.installall:V:	$DISBIN/%
