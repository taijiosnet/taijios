// Pure SHA-1, request parser, and 9P2000 server logic for grid/usercreatesrv,
// ported from appl/grid/usercreatesrv.b.
#import "std/vec"

QDIR :: 0;
QCREATE :: 1;

DMDIR :: 0x80000000;
QTDIR :: 0x80;
QTFILE :: 0x00;

TVERSION :: 100;
RVERSION :: 101;
TATTACH :: 104;
RATTACH :: 105;
RERROR :: 107;
TFLUSH :: 108;
RFLUSH :: 109;
TWALK :: 110;
RWALK :: 111;
TOPEN :: 112;
ROPEN :: 113;
TREAD :: 116;
RREAD :: 117;
TWRITE :: 118;
RWRITE :: 119;
TCLUNK :: 120;
RCLUNK :: 121;
TSTAT :: 124;
RSTAT :: 125;

MAX_FIDS :: 32;

FidEntry :: struct {
    in_use: bool;
    fid: u32;
    qpath: u64;
    is_open: bool;
}

Server :: struct {
    msize: u32;
    fids: [MAX_FIDS]FidEntry;
}

CreateCallback :: #type (uname: string, secret: []u8, err_out: *Text) -> bool;

InitServer :: (s: *Server) {
    s.msize = 8192;
    for i: 0..MAX_FIDS-1 { s.fids[i].in_use = false }
}

Rotl32 :: (x: u32, n: u32) -> u32 {
    return (x << n) | (x >> (32 - n));
}

Sha1 :: (data: string, digest: []u8) {
    h0: u32 = 0x67452301;
    h1: u32 = 0xEFCDAB89;
    h2: u32 = 0x98BADCFE;
    h3: u32 = 0x10325476;
    h4: u32 = 0xC3D2E1F0;

    msg: Vec(u8);
    unused BuilderAppend(msg, data);
    unused VecPush(msg, 0x80);
    while (msg.count % 64) != 56 { unused VecPush(msg, 0) }
    bit_len := cast(u64)data.count * 8;
    for i: 0..7 {
        shift := cast(u64)(56 - i * 8);
        unused VecPush(msg, cast(u8)((bit_len >> shift) & 0xFF));
    }

    w: [80]u32;
    blocks := msg.count / 64;
    for b: 0..blocks-1 {
        base := b * 64;
        for i: 0..15 {
            off := base + i * 4;
            w[i] = (cast(u32)msg[off] << 24) | (cast(u32)msg[off + 1] << 16) |
                   (cast(u32)msg[off + 2] << 8) | cast(u32)msg[off + 3];
        }
        for i: 16..79 {
            w[i] = Rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        }
        a := h0;
        bb := h1;
        c := h2;
        d := h3;
        e := h4;
        for i: 0..79 {
            f: u32;
            k: u32;
            if i < 20 {
                f = (bb & c) | ((~bb) & d);
                k = 0x5A827999;
            } else if i < 40 {
                f = bb ^ c ^ d;
                k = 0x6ED9EBA1;
            } else if i < 60 {
                f = (bb & c) | (bb & d) | (c & d);
                k = 0x8F1BBCDC;
            } else {
                f = bb ^ c ^ d;
                k = 0xCA62C1D6;
            }
            temp := Rotl32(a, 5) + f + e + k + w[i];
            e = d;
            d = c;
            c = Rotl32(bb, 30);
            bb = a;
            a = temp;
        }
        h0 += a;
        h1 += bb;
        h2 += c;
        h3 += d;
        h4 += e;
    }

    hs: [5]u32 = .[h0, h1, h2, h3, h4];
    for i: 0..4 {
        if i * 4 + 3 >= digest.count { break }
        digest[i * 4] = cast(u8)((hs[i] >> 24) & 0xFF);
        digest[i * 4 + 1] = cast(u8)((hs[i] >> 16) & 0xFF);
        digest[i * 4 + 2] = cast(u8)((hs[i] >> 8) & 0xFF);
        digest[i * 4 + 3] = cast(u8)(hs[i] & 0xFF);
    }
}

ParseRequest :: (data: string, uname: *Text, password: *Text) -> bool {
    unused VecResize(uname.bytes, 0);
    unused VecResize(password.bytes, 0);
    tok_count: s32 = 0;
    i: s64 = 0;
    while i < data.count {
        while i < data.count && (data[i] == 32 || data[i] == 9 || data[i] == 10 || data[i] == 13) { i += 1 }
        if i >= data.count { break }
        tok: Text;
        if data[i] == 39 {
            i += 1;
            while i < data.count {
                if data[i] == 39 {
                    if i + 1 < data.count && data[i + 1] == 39 {
                        unused VecPush(tok.bytes, 39);
                        i += 2;
                    } else {
                        i += 1;
                        break;
                    }
                } else {
                    unused VecPush(tok.bytes, data[i]);
                    i += 1;
                }
            }
        } else {
            while i < data.count && data[i] != 32 && data[i] != 9 && data[i] != 10 && data[i] != 13 {
                unused VecPush(tok.bytes, data[i]);
                i += 1;
            }
        }
        if tok_count == 0 { unused BuilderAppend(uname.bytes, TextView(tok)) }
        else if tok_count == 1 { unused BuilderAppend(password.bytes, TextView(tok)) }
        tok_count += 1;
    }
    return tok_count == 2;
}

ReadU16 :: (b: []u8, off: s64) -> u16 {
    return cast(u16)b[off] | (cast(u16)b[off + 1] << 8);
}

ReadU32 :: (b: []u8, off: s64) -> u32 {
    return cast(u32)b[off] | (cast(u32)b[off + 1] << 8) |
           (cast(u32)b[off + 2] << 16) | (cast(u32)b[off + 3] << 24);
}

ReadU64 :: (b: []u8, off: s64) -> u64 {
    return cast(u64)ReadU32(b, off) | (cast(u64)ReadU32(b, off + 4) << 32);
}

PushU8 :: (out: *Vec(u8), v: u8) { unused VecPush(<<out, v) }
PushU16 :: (out: *Vec(u8), v: u16) { PushU8(out, cast(u8)(v & 0xFF)); PushU8(out, cast(u8)((v >> 8) & 0xFF)) }
PushU32 :: (out: *Vec(u8), v: u32) {
    PushU8(out, cast(u8)(v & 0xFF));
    PushU8(out, cast(u8)((v >> 8) & 0xFF));
    PushU8(out, cast(u8)((v >> 16) & 0xFF));
    PushU8(out, cast(u8)((v >> 24) & 0xFF));
}
PushU64 :: (out: *Vec(u8), v: u64) {
    PushU32(out, cast(u32)(v & 0xFFFFFFFF));
    PushU32(out, cast(u32)((v >> 32) & 0xFFFFFFFF));
}
PushStr :: (out: *Vec(u8), s: string) { PushU16(out, cast(u16)s.count); unused BuilderAppend(<<out, s) }
PushQid :: (out: *Vec(u8), qpath: u64) {
    PushU8(out, ifx qpath == QDIR then QTDIR else QTFILE);
    PushU32(out, 0);
    PushU64(out, qpath);
}

PackDir :: (out: *Vec(u8), qpath: u64) {
    name := ifx qpath == QDIR then "." else "createuser";
    perm: u32 = ifx qpath == QDIR then (cast(u32)DMDIR | 365) else 146; // 0555 / 0222
    body_len: u16 = cast(u16)(39 + (2 + name.count) + (2 + 7) + (2 + 7) + 2);
    PushU16(out, body_len);
    PushU16(out, 0);
    PushU32(out, 0);
    PushQid(out, qpath);
    PushU32(out, perm);
    PushU32(out, 0);
    PushU32(out, 0);
    PushU64(out, 0);
    PushStr(out, name);
    PushStr(out, "inferno");
    PushStr(out, "inferno");
    PushStr(out, "");
}

FinishReply :: (kind: u8, tag: u16, payload: []u8, out: *Text) {
    unused VecResize(out.bytes, 0);
    PushU32(*out.bytes, cast(u32)(7 + payload.count));
    PushU8(*out.bytes, kind);
    PushU16(*out.bytes, tag);
    unused BuilderAppend(out.bytes, TextView(payload));
}

EmitError :: (tag: u16, msg: string, out: *Text) {
    body: Vec(u8);
    PushStr(*body, msg);
    FinishReply(RERROR, tag, VecSlice(body, 0, body.count), out);
}

FindFid :: (s: *Server, fid: u32) -> s64 {
    for i: 0..MAX_FIDS-1 { if s.fids[i].in_use && s.fids[i].fid == fid { return i } }
    return -1;
}

AllocFid :: (s: *Server, fid: u32, qpath: u64) -> s64 {
    for i: 0..MAX_FIDS-1 {
        if !s.fids[i].in_use {
            s.fids[i].in_use = true;
            s.fids[i].fid = fid;
            s.fids[i].qpath = qpath;
            s.fids[i].is_open = false;
            return i;
        }
    }
    return -1;
}

HandlePacket :: (s: *Server, pkt: []u8, on_create: CreateCallback, reply: *Text) {
    unused VecResize(reply.bytes, 0);
    if pkt.count < 7 { return }
    kind := pkt[4];
    tag := ReadU16(pkt, 5);

    if kind == TVERSION {
        req_msize := ifx pkt.count >= 11 then ReadU32(pkt, 7) else 8192;
        if req_msize < s.msize && req_msize >= 256 { s.msize = req_msize }
        body: Vec(u8);
        PushU32(*body, s.msize);
        PushStr(*body, "9P2000");
        FinishReply(RVERSION, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TATTACH {
        if pkt.count < 11 { EmitError(tag, "short Tattach", reply); return }
        fid := ReadU32(pkt, 7);
        if FindFid(s, fid) >= 0 || AllocFid(s, fid, QDIR) < 0 { EmitError(tag, "bad fid", reply); return }
        body: Vec(u8);
        PushQid(*body, QDIR);
        FinishReply(RATTACH, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TFLUSH {
        empty: [0]u8;
        FinishReply(RFLUSH, tag, empty[:], reply);
        return;
    }
    if kind == TWALK {
        if pkt.count < 17 { EmitError(tag, "short Twalk", reply); return }
        fid := ReadU32(pkt, 7);
        newfid := ReadU32(pkt, 11);
        nwname := cast(s64)ReadU16(pkt, 15);
        idx := FindFid(s, fid);
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        cur := s.fids[idx].qpath;
        off: s64 = 17;
        qids: [8]u64;
        nq: s64 = 0;
        for w: 0..nwname-1 {
            if off + 2 > pkt.count { EmitError(tag, "short Twalk", reply); return }
            slen := cast(s64)ReadU16(pkt, off);
            off += 2;
            if off + slen > pkt.count { EmitError(tag, "short Twalk", reply); return }
            name := TextView(pkt[off:off + slen]);
            off += slen;
            if cur != QDIR { break }
            if name == "createuser" { cur = QCREATE }
            else if name == "." || name == ".." { cur = QDIR }
            else { break }
            if nq < 8 { qids[nq] = cur; nq += 1 }
        }
        if nwname > 0 && nq == 0 { EmitError(tag, "file does not exist", reply); return }
        if nq == nwname {
            if newfid == fid { s.fids[idx].qpath = cur }
            else if AllocFid(s, newfid, cur) < 0 { EmitError(tag, "too many fids", reply); return }
        }
        body: Vec(u8);
        PushU16(*body, cast(u16)nq);
        for k: 0..nq-1 { PushQid(*body, qids[k]) }
        FinishReply(RWALK, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TOPEN {
        if pkt.count < 12 { EmitError(tag, "short Topen", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        s.fids[idx].is_open = true;
        body: Vec(u8);
        PushQid(*body, s.fids[idx].qpath);
        PushU32(*body, s.msize - 24);
        FinishReply(ROPEN, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TREAD {
        if pkt.count < 23 { EmitError(tag, "short Tread", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        offset := cast(s64)ReadU64(pkt, 11);
        count := cast(s64)ReadU32(pkt, 19);
        if idx < 0 || !s.fids[idx].is_open { EmitError(tag, "bad fid", reply); return }
        if s.fids[idx].qpath != QDIR { EmitError(tag, "permission denied", reply); return }
        dir_bytes: Vec(u8);
        PackDir(*dir_bytes, QCREATE);
        body: Vec(u8);
        if offset >= dir_bytes.count {
            PushU32(*body, 0);
        } else {
            end := offset + count;
            if end > dir_bytes.count { end = dir_bytes.count }
            PushU32(*body, cast(u32)(end - offset));
            unused BuilderAppend(body, TextView(VecSlice(dir_bytes, offset, end)));
        }
        FinishReply(RREAD, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TWRITE {
        if pkt.count < 23 { EmitError(tag, "short Twrite", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        count := cast(s64)ReadU32(pkt, 19);
        if idx < 0 || !s.fids[idx].is_open { EmitError(tag, "bad fid", reply); return }
        if s.fids[idx].qpath != QCREATE { EmitError(tag, "permission denied", reply); return }
        if 23 + count > pkt.count { EmitError(tag, "short Twrite", reply); return }
        uname: Text;
        password: Text;
        if !ParseRequest(TextView(pkt[23:23 + count]), *uname, *password) {
            EmitError(tag, "invalid request", reply);
            return;
        }
        secret: [20]u8;
        Sha1(TextView(password), secret[:]);
        err_msg: Text;
        if !on_create(TextView(uname), secret[:], *err_msg) {
            EmitError(tag, TextView(err_msg), reply);
            return;
        }
        body: Vec(u8);
        PushU32(*body, cast(u32)count);
        FinishReply(RWRITE, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TCLUNK {
        if pkt.count >= 11 {
            idx := FindFid(s, ReadU32(pkt, 7));
            if idx >= 0 { s.fids[idx].in_use = false }
        }
        empty: [0]u8;
        FinishReply(RCLUNK, tag, empty[:], reply);
        return;
    }
    if kind == TSTAT {
        if pkt.count < 11 { EmitError(tag, "short Tstat", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        st: Vec(u8);
        PackDir(*st, s.fids[idx].qpath);
        body: Vec(u8);
        PushU16(*body, cast(u16)st.count);
        unused BuilderAppend(body, TextView(VecSlice(st, 0, st.count)));
        FinishReply(RSTAT, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    EmitError(tag, "unsupported 9P message", reply);
}
