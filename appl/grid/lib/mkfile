fbrowse.zx: fbrowse.zi browser.zi ../../cmd/tcltk/tcltk.zi ../../cmd/tcltk/zx_surface.zi ../../cmd/taijios_files.zi ../../cmd/taijios_stdin.zi ../../cmd/taijios_args.zi ../../cmd/taijios_io.zi ../../cmd/taijios_namespace.zi ../../cmd/taijios_process.zi ../../cmd/taijios_stat.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../../cmd/tcltk --module-path ../../cmd --bind-host zx_surface --bind-host taijios_files --bind-host taijios_stdin --bind-host taijios_args --bind-host taijios_io --bind-host taijios_namespace --bind-host taijios_process --bind-host taijios_stat --entry fbrowse:main -o $target fbrowse.zi

$DISBIN/fbrowse.zx: fbrowse.zx
