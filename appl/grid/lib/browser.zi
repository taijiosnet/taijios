// Grid two-pane browser & selection state library, ported from appl/grid/lib/browser.b.
#import "std/vec"

DESELECT :: 0;
SELECT :: 1;
TOGGLE :: 2;
OPEN :: 3;
CLOSE :: 4;

SELECTED :: 0;
UNSELECTED :: 1;
ALL :: 2;

MAX_OPENED :: 64;
MAX_FRAMES :: 16;
MAX_SELECTIONS :: 64;

File :: struct {
    path: Text;
    qid: Text;
}

FileEq :: (a: *File, b: *File) -> bool {
    return TextView(a.path) == TextView(b.path) && TextView(a.qid) == TextView(b.qid);
}

FileSet :: (dst: *File, path: string, qid: string) {
    unused VecResize(dst.path.bytes, 0);
    unused BuilderAppend(dst.path.bytes, path);
    unused VecResize(dst.qid.bytes, 0);
    unused BuilderAppend(dst.qid.bytes, qid);
}

// Return parent directory path (matching browser.b prevpath).
PrevPath :: (path: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    if path.count == 0 { return }
    end := path.count;
    if end > 1 && path[end - 1] == 47 { end -= 1 }
    last_slash: s64 = -1;
    for i: 0..end-1 {
        if path[i] == 47 { last_slash = i }
    }
    if last_slash >= 0 {
        unused BuilderAppend(out.bytes, path[:last_slash + 1]);
    } else {
        unused BuilderAppend(out.bytes, "/");
    }
}

EnsureTrailingSlash :: (path: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    if path.count == 0 {
        unused BuilderAppend(out.bytes, "/");
        return;
    }
    unused BuilderAppend(out.bytes, path);
    if path[path.count - 1] != 47 {
        unused BuilderAppend(out.bytes, "/");
    }
}

// Browse state (ported from Browser->Browse adt).
BrowseState :: struct {
    root: Text;
    rlabel: Text;
    nopanes: s32;
    showpathlabel: bool;
    selected: [2]File;
    pane1: File;
    opened: [MAX_OPENED]File;
    opened_count: s32;
}

BrowseInit :: (b: *BrowseState, root: string, rlabel: string, nopanes: s32) -> bool {
    if root.count == 0 || nopanes < 1 || nopanes > 2 { return false }
    b.nopanes = nopanes;
    b.showpathlabel = true;
    b.opened_count = 0;
    EnsureTrailingSlash(root, *b.root);
    unused VecResize(b.rlabel.bytes, 0);
    unused BuilderAppend(b.rlabel.bytes, rlabel);
    FileSet(*b.selected[0], "", "");
    FileSet(*b.selected[1], "", "");
    FileSet(*b.pane1, TextView(b.root), "");
    BrowseAddOpened(b, TextView(b.root), "", true);
    return true;
}

BrowseNewRoot :: (b: *BrowseState, root: string, rlabel: string) {
    EnsureTrailingSlash(root, *b.root);
    unused VecResize(b.rlabel.bytes, 0);
    unused BuilderAppend(b.rlabel.bytes, rlabel);
    FileSet(*b.selected[0], "", "");
    FileSet(*b.selected[1], "", "");
    FileSet(*b.pane1, TextView(b.root), "");
}

BrowseChangeView :: (b: *BrowseState, nopanes: s32) {
    if nopanes == 1 || nopanes == 2 { b.nopanes = nopanes }
}

BrowseShowPath :: (b: *BrowseState, on: bool) {
    b.showpathlabel = on;
}

BrowseIsOpened :: (b: *BrowseState, path: string, qid: string) -> bool {
    for i: 0..cast(s64)b.opened_count-1 {
        if TextView(b.opened[i].path) == path && TextView(b.opened[i].qid) == qid {
            return true;
        }
    }
    return false;
}

BrowseAddOpened :: (b: *BrowseState, path: string, qid: string, add: bool) {
    if add {
        if BrowseIsOpened(b, path, qid) || b.opened_count >= MAX_OPENED { return }
        FileSet(*b.opened[b.opened_count], path, qid);
        b.opened_count += 1;
        return;
    }
    for i: 0..cast(s64)b.opened_count-1 {
        if TextView(b.opened[i].path) == path && TextView(b.opened[i].qid) == qid {
            for j: i..cast(s64)b.opened_count-2 {
                tp: Text; tq: Text;
                unused BuilderAppend(tp.bytes, TextView(b.opened[j + 1].path));
                unused BuilderAppend(tq.bytes, TextView(b.opened[j + 1].qid));
                FileSet(*b.opened[j], TextView(tp), TextView(tq));
            }
            b.opened_count -= 1;
            return;
        }
    }
}

BrowseSelectFile :: (b: *BrowseState, pane: s32, action: s32, path: string, qid: string) {
    if pane < 0 || pane > 1 { return }
    if action == DESELECT {
        FileSet(*b.selected[pane], "", "");
    } else if action == SELECT {
        FileSet(*b.selected[pane], path, qid);
    } else if action == TOGGLE {
        if TextView(b.selected[pane].path) == path && TextView(b.selected[pane].qid) == qid {
            FileSet(*b.selected[pane], "", "");
        } else {
            FileSet(*b.selected[pane], path, qid);
        }
    }
}

// Select state (ported from Browser->Select adt).
SelectFrame :: struct {
    name: Text;
    title: Text;
    items: [MAX_SELECTIONS]Text;
    item_count: s32;
    selected_idx: s32;
}

SelectState :: struct {
    frames: [MAX_FRAMES]SelectFrame;
    frame_count: s32;
    curr_frame: s32;
}

SelectInit :: (s: *SelectState) {
    s.frame_count = 0;
    s.curr_frame = -1;
}

SelectFindFrame :: (s: *SelectState, fname: string) -> s32 {
    for i: 0..cast(s64)s.frame_count-1 {
        if TextView(s.frames[i].name) == fname { return cast(s32)i }
    }
    return -1;
}

SelectAddFrame :: (s: *SelectState, fname: string, title: string) -> bool {
    if SelectFindFrame(s, fname) >= 0 || s.frame_count >= MAX_FRAMES { return false }
    idx := s.frame_count;
    unused VecResize(s.frames[idx].name.bytes, 0);
    unused BuilderAppend(s.frames[idx].name.bytes, fname);
    unused VecResize(s.frames[idx].title.bytes, 0);
    unused BuilderAppend(s.frames[idx].title.bytes, title);
    s.frames[idx].item_count = 0;
    s.frames[idx].selected_idx = -1;
    s.frame_count += 1;
    if s.curr_frame < 0 { s.curr_frame = idx }
    return true;
}

SelectShowFrame :: (s: *SelectState, fname: string) -> bool {
    idx := SelectFindFrame(s, fname);
    if idx < 0 { return false }
    s.curr_frame = idx;
    return true;
}

SelectAddSelection :: (s: *SelectState, fname: string, text: string, allowdups: bool) -> s32 {
    fi := SelectFindFrame(s, fname);
    if fi < 0 { return -1 }
    f := *s.frames[fi];
    if !allowdups {
        for i: 0..cast(s64)f.item_count-1 {
            if TextView(f.items[i]) == text { return cast(s32)i }
        }
    }
    if f.item_count >= MAX_SELECTIONS { return -1 }
    idx := f.item_count;
    unused VecResize(f.items[idx].bytes, 0);
    unused BuilderAppend(f.items[idx].bytes, text);
    f.item_count += 1;
    return idx;
}

SelectDelSelection :: (s: *SelectState, fname: string, idx: s32) -> bool {
    fi := SelectFindFrame(s, fname);
    if fi < 0 { return false }
    f := *s.frames[fi];
    if idx < 0 || idx >= f.item_count { return false }
    for j: cast(s64)idx..cast(s64)f.item_count-2 {
        ti: Text;
        unused BuilderAppend(ti.bytes, TextView(f.items[j + 1]));
        unused VecResize(f.items[j].bytes, 0);
        unused BuilderAppend(f.items[j].bytes, TextView(ti));
    }
    f.item_count -= 1;
    if f.selected_idx == idx { f.selected_idx = -1 }
    else if f.selected_idx > idx { f.selected_idx -= 1 }
    return true;
}

SelectGetSelected :: (s: *SelectState, fname: string, out: *Text) -> bool {
    unused VecResize(out.bytes, 0);
    fi := SelectFindFrame(s, fname);
    if fi < 0 { return false }
    f := *s.frames[fi];
    if f.selected_idx < 0 || f.selected_idx >= f.item_count { return false }
    unused BuilderAppend(out.bytes, TextView(f.items[f.selected_idx]));
    return true;
}

SelectSet :: (s: *SelectState, fname: string, idx: s32, action: s32) {
    fi := SelectFindFrame(s, fname);
    if fi < 0 { return }
    f := *s.frames[fi];
    if action == DESELECT {
        f.selected_idx = -1;
    } else if action == SELECT && idx >= 0 && idx < f.item_count {
        f.selected_idx = idx;
    } else if action == TOGGLE && idx >= 0 && idx < f.item_count {
        f.selected_idx = ifx f.selected_idx == idx then -1 else idx;
    }
}
