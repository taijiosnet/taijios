#import "std/vec"
using Log :: #import "logwindow_stream"
using Input :: #import "logwindow_input"
using Tcl :: #import "tcl"
using Tk :: #import "tcl_tk"

Check :: (stream: *Log.Stream, input: string, expected: string) -> bool {
    buffer := stream.bytes[stream.pending:];
    for i: 0..input.count-1 { buffer[i] = input[i] }
    output: Text;
    Log.Take(stream, input.count, *output);
    return TextView(output) == expected;
}

NotReady :: (_: []u8) -> s32 { return -2 }
AtEnd :: (_: []u8) -> s32 { return 0 }
Failed :: (_: []u8) -> s32 { return -1 }

main :: () -> s32 {
    stream: Log.Stream;
    if !Check(*stream, "café"[:4], "caf") { return 1 }
    if !Check(*stream, "é\n€"[1:5], "é\n") { return 2 }
    last := u8.[172, 240];
    if !Check(*stream, TextView(last[:]), "€") { return 3 }
    if !Check(*stream, "💡"[1:3], "") { return 4 }
    if !Check(*stream, "💡\n"[3:], "💡\n") { return 5 }
    if !Check(*stream, "€"[:1], "") { return 6 }
    invalid := u8.[88, 237, 160];
    if !Check(*stream, TextView(invalid[:]), "�X��") { return 7 }
    if !Check(*stream, "𐀀"[:3], "") || stream.pending != 3 { return 8 }
    message: Text;
    Log.Poll(*stream, NotReady, *message);
    if message.bytes.count != 0 || stream.ended || stream.pending != 3 { return 9 }
    Log.Poll(*stream, AtEnd, *message);
    if TextView(message) != "Got EOF\n" || !stream.ended || stream.pending != 0 { return 10 }
    Log.Poll(*stream, Failed, *message);
    if message.bytes.count != 0 { return 11 }
    broken: Log.Stream;
    Log.Poll(*broken, Failed, *message, "pipe closed by peer");
    if TextView(message) != "Input error: pipe closed by peer\n" || !broken.ended { return 12 }
    interpreter: Tcl.Interpreter;
    if !Tk.Attach(*interpreter) { return 13 }
    widget := Tcl.Eval(*interpreter, "frame .t; text .t.t");
    if widget.code != .OK { return 13 }
    literal := "{line}; [error unwanted] $variable\nÉ\n";
    if !Input.Append(literal) { return 14 }
    contents := Tcl.Eval(*interpreter, ".t.t get 1.0 end");
    if contents.code != .OK || TextView(contents.value) != literal { return 14 }
    print("Log Window verified split UTF-8, idle input, EOF and input errors\n");
    return 0;
}
