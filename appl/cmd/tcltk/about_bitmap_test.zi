#import "std/vec"
using Tcl :: #import "tcl"
using Tk :: #import "tcl_tk"
using Window :: #import "tcltk"
using Fixture :: #import "about_bitmap_fixture"

main :: () -> s32 {
    interpreter: Tcl.Interpreter;
    if !Tk.Attach(*interpreter) { return 1 }
    Tk.SetImageLoader(Window.LoadBitmap);
    start: s64;
    for at: 0..Fixture.Commands.count-1 {
        if Fixture.Commands[at] != 10 { continue }
        result := Tcl.Eval(*interpreter, Fixture.Commands[start:at]);
        if result.code == .Error { print("!%\n", TextView(result.value)) }
        else if result.code != .OK { return 1 }
        else if result.value.bytes.count > 0 { print("%\n", TextView(result.value)) }
        start = at+1;
    }
    return 0;
}
