// Hosted launcher for an ordinary Ziran Tcl interpreter with optional Tk.
#import "std/vec"
using Tcl :: #import "tcl/interpreter"
using Tk :: #import "tk/widgets"
#if #defined(TK_PACKAGES) {
    using Packages :: #import "tcl/packages"
    using Types :: #import "tcl/types"
}
#if #defined(TK_PACKAGES) || #defined(TK_BITMAP) || !#defined(TK_NO_CANVAS) {
    using Files :: #import "taijios_files"
}
#if #defined(TK_BITMAP) {
    LoadBitmap :: (path: string, bytes: *Text) -> bool {
        return Files.ReadFile(path, bytes, 1048576) == 0;
    }
}
using Paint :: #import "tk/paint"
using Surface :: #import "zx_surface"
using Stdin :: #import "taijios_stdin"

Execute :: (tcl: *Tcl.Interpreter, script: string) -> bool {
    result := Tcl.Eval(tcl, script);
    output: Text = Tcl.TakeOutput(tcl);
    if output.bytes.count > 0 { print("%", TextView(output)) }
    if result.code == .OK { return true }
    print("tcltk: %\n", TextView(result.value));
    return false;
}

ExecuteCallback :: (tcl: *Tcl.Interpreter, script: Text) -> bool {
    return script.bytes.count == 0 || Execute(tcl, TextView(script));
}

#if !#defined(TK_NO_CANVAS) {
    PointerTime :: () -> s64 {
        time := Surface.PointerMillis();
        if time >= 0 { return time }
        buf: [32]u8;
        count := Files.ReadBytesAt("/dev/msec", 0, buf[:]);
        value: s64;
        digits: s32;
        for i: 0..count-1 {
            byte := buf[i];
            if byte >= 48 && byte <= 57 {
                value = 10*value+cast(s64)(byte-48);
                digits += 1;
            } else if digits > 0 { break }
        }
        return ifx digits > 0 then value else -1;
    }
}

#if #defined(TK_PACKAGES) {
    LoadScript :: (_: s64, path: string, result: *Types.Result) {
        script: Text;
        if Files.ReadFile(path, *script, 1048576) == 0 {
            VecSwap(result.value.bytes, script.bytes);
            return;
        }
        failure := Types.QuotedError("could not read Tcl script \"", path, "\"");
        result.code = failure.code;
        VecSwap(result.value.bytes, failure.value.bytes);
    }
}

Frame :: struct { pixels: Vec(u8); banded: bool; }

#if #defined(TK_BANDED) {
    BAND_ROWS :: 128;

    CanRenderBands :: (height: s32) -> bool {
        if height <= BAND_ROWS { return false }
        for * Tk.widgets {
            if it.order > 0 && it.kind == Tk.PANEL { return false }
        }
        return true;
    }

    DrawBands :: (frame: *Frame, width: s32, height: s32) -> bool {
        first: s32;
        while first < height {
            rows := Tk.Minimum(BAND_ROWS, height-first);
            pixels := VecSlice(frame.pixels, 0, cast(s64)width*rows*4);
            Paint.Render(pixels, width, first+rows, first);
            if !Surface.PresentOpaqueRows(width, height, first, TextView(pixels)) { return false }
            first += rows;
        }
        return true;
    }
}

Draw :: (tcl: *Tcl.Interpreter, frame: *Frame, width: s32, height: s32) -> bool {
    if width <= 0 || height <= 0 || width > 4096 || height > 4096 { return false }
    count := cast(s64)width * cast(s64)height * 4;
    if count > 16777216 { return false }
    Tk.Layout(width, height);
    callbacks: Text;
    Tk.CollectScroll(*callbacks);
    if !ExecuteCallback(tcl, callbacks) { return false }
    if Tk.Closed() { return true }
    #if #defined(TK_BANDED) {
        frame.banded = CanRenderBands(height);
        if frame.banded { count = cast(s64)width*BAND_ROWS*4 }
    }
    // A full redraw overwrites the frame. Release the old storage before growing
    // and reclaim the excess after a large shrink.
    if frame.pixels.capacity < count || frame.pixels.capacity > count*2 {
        previous: Vec(u8);
        VecSwap(frame.pixels, previous);
    }
    if !VecResizeBounded(frame.pixels, count, 16777216) { return false }
    #if #defined(TK_BANDED) {
        if frame.banded { return DrawBands(frame, width, height) }
    }
    Paint.Render(VecSlice(frame.pixels, 0, count), width, height);
    return Surface.PresentRGBA(width, height, TextView(VecSlice(frame.pixels, 0, count)));
}

main :: () -> s32 {
    source: Text;
    error := Stdin.ReadScript(*source);
    if error != "" { print("tcltk: %\n", error); return 1 }
    tcl: Tcl.Interpreter;
    return Run(*tcl, TextView(source), "Tk", 300, 208);
}

Prepare :: #type () -> bool;
Animate :: #type () -> bool;
PollResult :: enum { Idle; Changed; Failed; }
Poll :: #type (tcl: *Tcl.Interpreter, event: Surface.SurfaceEvent) -> PollResult;

NoPrepare :: () -> bool { return true }
NoAnimation :: () -> bool { return false }
NoPoll :: (_: *Tcl.Interpreter, event: Surface.SurfaceEvent) -> PollResult { return .Idle }

Run :: (tcl: *Tcl.Interpreter, script: string, title: string, width: s32, height: s32) -> s32 {
    return RunAnimated(tcl, script, title, width, height, NoPrepare, NoAnimation, 500);
}

RunAnimated :: (tcl: *Tcl.Interpreter, script: string, title: string, width: s32, height: s32,
                prepare: Prepare, animate: Animate, interval: s32) -> s32 {
    return RunWindow(tcl, script, title, width, height, interval, prepare, animate, NoPrepare, NoPoll);
}

RunPolled :: (tcl: *Tcl.Interpreter, script: string, title: string, width: s32, height: s32,
              started: Prepare, poll: Poll, interval: s32) -> s32 {
    return RunWindow(tcl, script, title, width, height, interval, NoPrepare, NoAnimation, started, poll);
}

RunWindow :: (tcl: *Tcl.Interpreter, script: string, title: string, width: s32, height: s32, interval: s32,
              prepare: Prepare, animate: Animate, started: Prepare, poll: Poll) -> s32 {
    if !Tk.Attach(tcl) { return 1 }
    #if #defined(TK_BITMAP) {
        Tk.SetImageLoader(LoadBitmap)
    }
    #if #defined(TK_PACKAGES) {
        Packages.Attach(tcl);
        Tcl.SetSourceLoader(tcl, LoadScript);
        provided := Packages.Provide(tcl, "Tk", "0.1");
        if provided.code != .OK {
            print("tcltk: %\n", TextView(provided.value));
            return 1;
        }
    }
    if !Execute(tcl, script) { return 1 }
    if Tk.Closed() { return 0 }
    if !Surface.OpenWindow(title, width, height) { return 1 }
    defer Surface.CloseWindow();
    if !prepare() { return 1 }
    frame: Frame;
    if !Draw(tcl, *frame, width, height) { return 1 }
    if !Tk.Closed() && !started() { return 1 }
    while !Tk.Closed() {
        event := Surface.GetEvent(interval);
        if event.kind == Surface.Closed { break }
        redraw := true;
        entry_only := false;
        canvas_changed := false;
        #if !#defined(TK_NO_CANVAS) {
            if event.kind == Surface.Down || event.kind == Surface.Up || event.kind == Surface.Move {
                kind: Tk.CanvasPointerKind = .Move;
                if event.kind == Surface.Down { kind = .Press }
                else if event.kind == Surface.Up { kind = .Release }
                time := ifx kind == .Press then PointerTime() else -1;
                canvas_changed = Tk.CanvasPointer(tcl, event.x, event.y, kind, event.button, time, ExecuteCallback);
                if Tk.Closed() { break }
            }
        }
        if event.kind == Surface.Redraw || event.kind == Surface.Resize {
            width = event.width;
            height = event.height;
        } else if event.kind == Surface.Down && event.button == 1 {
            if !ExecuteCallback(tcl, Tk.PointerPress(event.x, event.y)) { return 1 }
        } else if event.kind == Surface.Move {
            if !ExecuteCallback(tcl, Tk.PointerMove(event.x, event.y)) { return 1 }
            redraw = Tk.Dragging();
        } else if event.kind == Surface.Up && event.button == 1 {
            if !ExecuteCallback(tcl, Tk.PointerUp(event.x, event.y)) { return 1 }
        } else if event.kind == Surface.TextEvent {
            Tk.TextInput(event.text);
            entry_only = true;
        } else if event.kind == Surface.Key {
            key: Tk.EntryKey;
            if event.key == Surface.EnterKey { key = .Return }
            else if event.key == Surface.LeftKey { key = .Left }
            else if event.key == Surface.RightKey { key = .Right }
            else if event.key == Surface.HomeKey { key = .Home }
            else if event.key == Surface.EndKey { key = .End }
            else if event.key == Surface.UpKey { key = .Up }
            else if event.key == Surface.DownKey { key = .Down }
            else if event.key == Surface.PageUpKey { key = .PageUp }
            else if event.key == Surface.PageDownKey { key = .PageDown }
            else if event.key == Surface.BackspaceKey { key = .Backspace }
            else if event.key == Surface.DeleteKey { key = .Delete }
            else { continue }
            if !ExecuteCallback(tcl, Tk.KeyDown(key)) { return 1 }
            entry_only = key != .Return;
        } else { redraw = false }
        if Tk.Closed() { break }
        polled := poll(tcl, event);
        if polled == .Failed { return 1 }
        if Tk.Closed() { break }
        // Editing an entry changes its contents and caret, leaving its packed size fixed.
        if entry_only && !frame.banded && !Tk.MenuPosted() && polled == .Idle && Tk.focused >= 0 && Tk.widgets[Tk.focused].kind == Tk.ENTRY {
            pixels := VecSlice(frame.pixels, 0, frame.pixels.count);
            Paint.RenderFocusedEntry(pixels, width, height);
            if !Surface.PresentRGBA(width, height, TextView(pixels)) { return 1 }
        } else if redraw || canvas_changed || polled == .Changed || (entry_only && frame.banded) {
            if !Draw(tcl, *frame, width, height) { return 1 }
        } else if event.kind == Surface.Idle && animate() {
            if frame.banded {
                if !Draw(tcl, *frame, width, height) { return 1 }
            } else {
                pixels := VecSlice(frame.pixels, 0, frame.pixels.count);
                Paint.RenderPanels(pixels, width, height);
                if !Surface.PresentRGBA(width, height, TextView(pixels)) { return 1 }
            }
        }
    }
    return 0;
}
