#import "std/vec"
using UTF :: #import "tcl_tk_text"

Stream :: struct {
    bytes: [4096]u8;
    pending: s64;
    ended: bool;
}

Read :: #type (buffer: []u8) -> s32;

Poll :: (stream: *Stream, read: Read, text: *Text, problem: string = "could not read guest stdin") {
    unused VecResize(text.bytes, 0);
    if stream.ended { return }
    count := read(stream.bytes[stream.pending:]);
    if count > 0 { Take(stream, count, text); return }
    if count == -2 { return }

    stream.ended = true;
    stream.pending = 0;
    if count == 0 { unused BuilderAppend(text.bytes, "Got EOF\n"); return }
    unused BuilderAppend(text.bytes, "Input error: ");
    unused BuilderAppend(text.bytes, problem);
    unused BuilderAppend(text.bytes, "\n");
}

// Keep an incomplete UTF-8 suffix for the next guest read.
Take :: (stream: *Stream, count: s64, text: *Text) {
    length := stream.pending + count;
    at := AppendComplete(TextView(stream.bytes[:length]), text);
    stream.pending = length - at;
    for i: 0..stream.pending-1 { stream.bytes[i] = stream.bytes[at+i] }
}

AppendComplete :: (data: string, text: *Text) -> s64 {
    start: s64;
    at: s64;
    while at < data.count {
        rune, width := UTF.Decode(data, at);
        if rune >= 0 { at += width; continue }
        if PartialRune(data[at:]) { break }
        unused BuilderAppend(text.bytes, data[start:at]);
        unused BuilderAppend(text.bytes, "�");
        at += 1;
        start = at;
    }
    unused BuilderAppend(text.bytes, data[start:at]);
    return at;
}

PartialRune :: (data: string) -> bool {
    lead := data[0];
    if lead < 194 || lead > 244 { return false }
    width := ifx lead < 224 then 2 else (ifx lead < 240 then 3 else 4);
    if data.count >= width { return false }
    if data.count >= 2 {
        second := data[1];
        if (lead == 224 && second < 160) || (lead == 237 && second > 159) ||
           (lead == 240 && second < 144) || (lead == 244 && second > 143) { return false }
    }
    for i: 1..data.count-1 { if (data[i] & 192) != 128 { return false } }
    return true;
}
