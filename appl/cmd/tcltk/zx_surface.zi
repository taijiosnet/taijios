// Generic Taiji surface ABI for the independent, optional Tk module.
host_api :: #system_library "host_api";

SurfaceEvent :: struct {
    kind: s32;
    x: s32;
    y: s32;
    button: s32;
    key: s32;
    modifiers: s32;
    width: s32;
    height: s32;
    text: string;
}

Idle :: 0;
Closed :: 1;
Redraw :: 2;
Resize :: 3;
Move :: 4;
Down :: 5;
Up :: 6;
Key :: 7;
TextEvent :: 9;
Visibility :: 10; // button is 1 when tasked, 0 when restored
PointerWheel :: 11; // button is signed milli-detents, positive up
EnterKey :: 257;
BackspaceKey :: 259;
DeleteKey :: 261;
RightKey :: 262;
LeftKey :: 263;
DownKey :: 264;
UpKey :: 265;
PageUpKey :: 266;
PageDownKey :: 267;
HomeKey :: 268;
EndKey :: 269;

#scope_export
Open :: (title: string, width: s32, height: s32) -> bool #reads #foreign host_api;
Event :: (wait_ms: s32) -> SurfaceEvent #foreign host_api;
// Time at input, or -1 when the last event has no pointer timestamp.
PointerMillis :: () -> s64 #foreign host_api;
Present :: (width: s32, height: s32, rgba: string) -> bool #reads #foreign host_api;
// Submit contiguous, opaque RGBA8 rows starting at row zero. The final rows publish the frame.
PresentOpaqueRows :: (width: s32, height: s32, first: s32, rgba: string) -> bool #reads #foreign host_api;
// Initialize each size with contiguous opaque RGBA8 rows, then update any row range.
// The host consumes rgba synchronously and preserves rows outside the strip.
PresentOpaqueStrip :: (width: s32, height: s32, first: s32, rgba: string) -> bool #reads #foreign host_api;
// Initialize each size with contiguous rows, then update any row range.
// Synchronous opaque strip of packed 0xRRGGBB words; ignore the high byte.
PresentRGBStrip :: (width: s32, height: s32, first: s32, pixels: []u32) -> bool #reads #foreign host_api;
SetTasked :: (tasked: bool) -> bool #foreign host_api;
SetTitle :: (title: string) -> bool #reads #foreign host_api;
Close :: () #foreign host_api;

OpenWindow :: (title: string, width: s32, height: s32) -> bool { return Open(title, width, height) }
GetEvent :: (wait_ms: s32) -> SurfaceEvent { return Event(wait_ms) }
PresentRGBA :: (width: s32, height: s32, rgba: string) -> bool { return Present(width, height, rgba) }
SetWindowTasked :: (tasked: bool) -> bool { return SetTasked(tasked) }
SetWindowTitle :: (title: string) -> bool { return SetTitle(title) }
CloseWindow :: () { Close() }
