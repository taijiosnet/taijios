// Run the same supported canvas commands as the original Inferno tkcmd.
#import "std/vec"
using Tcl :: #import "tcl/interpreter"
using Tk :: #import "tk/widgets"
using Fixture :: #import "memory_canvas_fixture"

main :: () -> s32 {
    tcl: Tcl.Interpreter;
    if !Tk.Attach(*tcl) { return 1 }
    commands := Fixture.Commands;
    start: s64;
    for i: 0..commands.count-1 {
        if commands[i] != 10 { continue }
        result := Tcl.Eval(*tcl, commands[start:i]);
        if result.code != .OK { print("%\n", TextView(result.value)); return 2 }
        if result.value.bytes.count > 0 { print("%\n", TextView(result.value)) }
        start = i+1;
    }
    return 0;
}
