<../../../mkconfig

TARG=

MODULES=

SYSMODULES=

DISBIN=$ROOT/zx/install

<$ROOT/mkfiles/mkdis

ZXCOMMANDS=mkproto ckproto proto2list mergelog updatelog applylog archfs info wfind wrap2list wdiff create inst install eproto log
ZXUTIL=install_util.zi proto_lib.zi logs_lib.zi arch_lib.zi wrap_lib.zi inst_lib.zi ../zx_arg.zi ../taijios_args.zi ../taijios_io.zi ../taijios_stat.zi ../taijios_clock.zi ../taijios_keyring.zi ../taijios_namespace.zi ../../lib/taijios_quote.zi ../../lib/ninep.zi

install:V: ${ZXCOMMANDS:%=$DISBIN/%.zx}

updatelog.zx: updatelog.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry updatelog:main -o $target updatelog.zi

archfs.zx: archfs.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_namespace --entry archfs:main -o $target archfs.zi

info.zx: info.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry info:main -o $target info.zi

wfind.zx: wfind.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry wfind:main -o $target wfind.zi

wrap2list.zx: wrap2list.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry wrap2list:main -o $target wrap2list.zi

wdiff.zx: wdiff.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry wdiff:main -o $target wdiff.zi

create.zx: create.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry create:main -o $target create.zi

inst.zx: inst.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --entry inst:main -o $target inst.zi

install.zx: install.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --bind-host taijios_keyring --bind-host taijios_namespace --entry install:main -o $target install.zi

log.zx: log.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_clock --entry log:main -o $target log.zi

&.zx: &.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --entry $stem:main -o $target $stem.zi

$DISBIN/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 "$stem.zx" "$staged" && mv "$staged" "$target"
