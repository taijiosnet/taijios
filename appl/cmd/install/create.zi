// Create wrapped package or update archive (replaces appl/cmd/install/create.b).
Args :: #import "taijios_args";
Arg :: #import "zx_arg";
IO :: #import "taijios_io";
Stat :: #import "taijios_stat";
Clock :: #import "taijios_clock";
Keyring :: #import "taijios_keyring";
Util :: #import "install_util";
Proto :: #import "proto_lib";
Arch :: #import "arch_lib";
Wrap :: #import "wrap_lib";
#import "std/format"
#import "std/vec"

OnPair :: struct {
    old_p: Text;
    new_p: Text;
}

out_fd: s32 = -1;
close_out: bool = false;
protof: Vec(u8);
notesf: Vec(u8);
oldroot: Vec(u8);
root: Vec(u8);
uid: Vec(u8);
gid: Vec(u8);
desc: Vec(u8);
remfile: Vec(u8);
verb: bool = false;
xflag: bool = false;
update: bool = false;
has_w: bool = false;
w: Wrap.Wrapped;
prefixes: Vec(Text);
notprefixes: Vec(Text);
onlist: Vec(OnPair);
md5s: Keyring.DigestState;
md5_lines: Vec(Text);
pass: s32 = 0;

MakeText :: (s: string) -> Text {
    t: Text;
    unused BuilderAppend(t.bytes, s);
    return t;
}

StrPrefix :: (s: string, pre: string) -> bool {
    return s.count >= pre.count && s[:pre.count] == pre;
}

MatchPrefix :: (s: string, pre: *Vec(Text)) -> bool {
    if pre.count == 0 || s == "/wrap" || StrPrefix(s, "/wrap/") { return true }
    for i: 0..pre.count - 1 {
        if StrPrefix(s, TextView(pre.*[i])) { return true }
    }
    return false;
}

NotMatchPrefix :: (s: string, pre: *Vec(Text)) -> bool {
    if pre.count == 0 || s == "/wrap" || StrPrefix(s, "/wrap/") { return true }
    for i: 0..pre.count - 1 {
        if StrPrefix(s, TextView(pre.*[i])) { return false }
    }
    return true;
}

Cleanup :: () {
    if has_w {
        Wrap.End(*w);
        has_w = false;
    }
    if close_out && out_fd >= 0 {
        unused IO.Close(out_fd);
        out_fd = -1;
    }
}

Usage :: () -> s32 {
    Util.WriteErr("usage: install/create [-ovx] [-N uid] [-G gid] [-r root] [-d desc] [-s src-fs] [-p proto] name\n");
    Util.WriteErr("or install/create -u [-ovx] [-N uid] [-G gid] [-r root] [-d desc] [-s src-fs] [-p proto] old-package [prefix ...]\n");
    Cleanup();
    return 1;
}

Fatal :: (s: string) -> s32 {
    eb: Vec(u8);
    BuilderPrint(*eb, "fatal: %\n", s);
    Util.WriteErr(TextView(eb[:]));
    Cleanup();
    return 1;
}

Warn :: (s: string) {
    eb: Vec(u8);
    BuilderPrint(*eb, "%: %\n", TextView(protof[:]), s);
    Util.WriteErr(TextView(eb[:]));
}

ErrorExit :: (s: string) -> s32 {
    eb: Vec(u8);
    BuilderPrint(*eb, "%: %\n", TextView(protof[:]), s);
    Util.WriteErr(TextView(eb[:]));
    Cleanup();
    return 1;
}

N2O :: (n: string) -> string {
    for i: 0..onlist.count - 1 {
        if TextView(onlist[i].new_p) == n {
            return TextView(onlist[i].old_p);
        }
    }
    return n;
}

HandleDiags :: (pres: *Proto.ProtoResult) -> bool {
    nd := Proto.DiagCount(pres);
    for i: 0..nd - 1 {
        lev := Proto.DiagLevel(pres, i);
        ln := Proto.DiagLine(pres, i);
        msg_t := Proto.DiagMsg(pres, i);
        s: Vec(u8);
        BuilderPrint(*s, "line % : %", ln, TextView(msg_t));
        if lev == Proto.WARN {
            Warn(TextView(s[:]));
        } else if lev == Proto.ERROR {
            unused ErrorExit(TextView(s[:]));
            return false;
        } else {
            unused Fatal(TextView(s[:]));
            return false;
        }
    }
    return true;
}

MkArch :: (new_p: string, old_p: string, d: *Util.DirEntry) {
    if pass == 0 && old_p != new_p {
        pair: OnPair;
        pair.old_p = MakeText(old_p);
        pair.new_p = MakeText(new_p);
        VecPush(onlist, pair);
    }
    if prefixes.count > 0 && !MatchPrefix(new_p, *prefixes) { return }
    if notprefixes.count > 0 && !NotMatchPrefix(new_p, *notprefixes) { return }

    digest: [16]u8;
    unused Wrap.Md5File(old_p, digest[:]);
    dummy: [1]u8;
    if has_w {
        ok, _ := Wrap.GetFileInfo(*w, new_p, true, digest[:], false, dummy[:], false, dummy[:]);
        if ok { return }
    }
    unused Keyring.DigestAdd(Keyring.MD5, *md5s, new_p);
    if pass == 0 {
        mhex: Vec(u8);
        Wrap.Md5Conv(digest[:], *mhex);
        line: Vec(u8);
        BuilderPrint(*line, "% %\n", new_p, TextView(mhex[:]));
        VecPush(md5_lines, MakeText(TextView(line[:])));
        return;
    }
    if verb {
        vb: Vec(u8);
        BuilderPrint(*vb, "%\n", new_p);
        Util.WriteErr(TextView(vb[:]));
    }
    flen := ifx (d.mode & Stat.Directory) != 0 then cast(s64)0 else d.length;
    hdr: Vec(u8);
    Arch.PutHdr(*hdr, new_p, d.mode, TextView(uid[:]), TextView(gid[:]), d.mtime, flen);
    unused IO.Write(out_fd, TextView(hdr[:]));
    if (d.mode & Stat.Directory) == 0 {
        err_t := Arch.PutFileToFd(out_fd, old_p, d.length);
        es := TextView(err_t);
        if es.count > 0 {
            Warn(es);
        }
    }
}

ProcessProtoItems :: (pres: *Proto.ProtoResult) {
    ni := Proto.ItemCount(pres);
    for i: 0..ni - 1 {
        np_t := Proto.ItemNewPath(pres, i);
        op_t := Proto.ItemOldPath(pres, i);
        np := TextView(np_t);
        op := TextView(op_t);
        d: Util.DirEntry;
        Proto.ItemDir(pres, i, *d);
        if xflag {
            line: Vec(u8);
            BuilderPrint(*line, "%\t%\t%\n", np, cast(s64)d.mtime, d.length);
            unused IO.Write(out_fd, TextView(line[:]));
            continue;
        }
        if (d.mode & Stat.Directory) == 0 {
            fd := IO.Open(op, 0);
            if fd < 0 {
                wb: Vec(u8);
                BuilderPrint(*wb, "can't open %: %", op, IO.Error());
                Warn(TextView(wb[:]));
                continue;
            }
            unused IO.Close(fd);
        }
        MkArch(np, op, *d);
    }
}

WrapInit :: (name_in: string, t: s32, digest_out: []u8) -> bool {
    name: Vec(u8);
    unused BuilderAppend(name, name_in);
    if uid.count == 0 { unused BuilderAppend(uid, "inferno") }
    if gid.count == 0 { unused BuilderAppend(gid, "inferno") }
    if update {
        if !Wrap.OpenWrapHdr(name_in, TextView(root[:]), false, *w) {
            unused Fatal("no such package found");
            return false;
        }
        has_w = true;
        if protof.count == 0 {
            udir_t := Wrap.UpdateDir(*w, 0);
            BuilderPrint(*protof, "%/proto", TextView(udir_t));
        }
        VecClear(name);
        unused BuilderAppend(name, TextView(w.name));
    } else {
        if protof.count == 0 {
            unused Fatal("proto file missing");
            return false;
        }
    }

    eb: Vec(u8);
    BuilderPrint(*eb, "wrap pass %\n", TextView(protof[:]));
    Util.WriteErr(TextView(eb[:]));

    md5s = .{};
    VecClear(md5_lines);
    VecClear(onlist);
    pass = 0;

    pres: Proto.ProtoResult;
    unused Proto.RdProto(TextView(protof[:]), TextView(oldroot[:]), *pres);
    if !HandleDiags(*pres) { return false }
    ProcessProtoItems(*pres);

    for i: 0..15 { digest_out[i] = 0 }
    unused Keyring.DigestEnd(Keyring.MD5, *md5s, digest_out);

    // Sort md5_lines lexicographically (replaces spawning /zx/sort.dis)
    for i: 1..md5_lines.count - 1 {
        j := i;
        while j > 0 && Util.StrLess(TextView(md5_lines[j]), TextView(md5_lines[j - 1])) {
            tmp: Text;
            Util.CopyTextInto(*tmp, *md5_lines[j]);
            Util.CopyTextInto(*md5_lines[j], *md5_lines[j - 1]);
            Util.CopyTextInto(*md5_lines[j - 1], *tmp);
            j -= 1;
        }
    }
    md5_sorted: Vec(u8);
    for i: 0..md5_lines.count - 1 {
        unused BuilderAppend(md5_sorted, TextView(md5_lines[i]));
    }

    rm_buf: Vec(u8);
    if update {
        rmed: Vec(Text);
        ui := Wrap.UpdateCount(*w) - 1;
        while ui >= 0 {
            mdata: Vec(u8);
            Wrap.UpdateMd5(*w, ui, *mdata);
            pos: s64 = 0;
            while pos < mdata.count {
                start := pos;
                while pos < mdata.count && mdata[pos] != 10 { pos += 1 }
                if pos < mdata.count { pos += 1 }
                p := TextView(mdata[start:pos]);
                if prefixes.count > 0 && !MatchPrefix(p, *prefixes) { continue }
                if notprefixes.count > 0 && !NotMatchPrefix(p, *notprefixes) { continue }
                sp: s64 = 0;
                while sp < p.count && p[sp] != 32 && p[sp] != 10 { sp += 1 }
                q_rel := p[:sp];
                src_base := ifx oldroot.count > 0 then TextView(oldroot[:]) else TextView(root[:]);
                q_full: Vec(u8);
                Wrap.PathCat(src_base, q_rel, *q_full);
                qs := TextView(q_full[:]);
                de: Util.DirEntry;
                exists := Util.StatEntry(qs, *de);
                if !exists {
                    exists = Util.StatEntry(N2O(qs), *de);
                }
                if q_rel.count >= 7 && q_rel[q_rel.count - 7:] == "emu.new" { continue }
                if !exists {
                    dup := false;
                    for r: 0..rmed.count - 1 {
                        if TextView(rmed[r]) == q_rel { dup = true; break }
                    }
                    if !dup { VecPush(rmed, MakeText(q_rel)) }
                }
            }
            ui -= 1;
        }
        // Limbo cons list order: reverse of discovery order
        ri := rmed.count - 1;
        while ri >= 0 {
            BuilderPrint(*rm_buf, "%\n", TextView(rmed[ri]));
            ri -= 1;
        }
        if remfile.count > 0 {
            extra_rm: Vec(u8);
            if Util.ReadAllFile(TextView(remfile[:]), *extra_rm) {
                unused BuilderAppend(rm_buf, TextView(extra_rm[:]));
            }
        }
    }

    nm := TextView(name[:]);
    u_s := TextView(uid[:]);
    g_s := TextView(gid[:]);
    d_s := TextView(desc[:]);
    if update {
        Wrap.PutWrap(out_fd, nm, t, d_s, w.tfull, prefixes.count == 0 && notprefixes.count == 0, u_s, g_s);
    } else {
        Wrap.PutWrap(out_fd, nm, t, d_s, 0, true, u_s, g_s);
    }
    Wrap.PutWrapFile(out_fd, nm, t, "proto", TextView(protof[:]), u_s, g_s);
    Wrap.PutWrapBytes(out_fd, nm, t, "md5sum", md5_sorted[:], u_s, g_s);
    if update {
        Wrap.PutWrapBytes(out_fd, nm, t, "remove", rm_buf[:], u_s, g_s);
    }
    if notesf.count > 0 {
        Wrap.PutWrapFile(out_fd, nm, t, "notes", TextView(notesf[:]), u_s, g_s);
    }
    md5s = .{};
    pass = 1;
    return true;
}

WrapEnd :: (digest: []u8) {
    digest0: [16]u8;
    for i: 0..15 { digest0[i] = 0 }
    unused Keyring.DigestEnd(Keyring.MD5, *md5s, digest0[:]);
    if Wrap.MemCmp(digest, digest0[:], 16) != 0 {
        s1: Vec(u8);
        s0: Vec(u8);
        Wrap.Md5Conv(digest, *s1);
        Wrap.Md5Conv(digest0[:], *s0);
        wb: Vec(u8);
        BuilderPrint(*wb, "files changed underfoot % %", TextView(s1[:]), TextView(s0[:]));
        Warn(TextView(wb[:]));
    }
}

ReqArg :: (scan: *Arg.Scan, what: string, dst: *Vec(u8)) -> bool {
    v, ok := Arg.Value(scan);
    if !ok {
        eb: Vec(u8);
        BuilderPrint(*eb, "missing %\n", what);
        Util.WriteErr(TextView(eb[:]));
        return false;
    }
    VecClear(dst.*);
    unused BuilderAppend(dst.*, v);
    return true;
}

main :: () -> s32 {
    now := cast(s32)(Clock.UnixMillis() / 1000);
    unused BuilderAppend(root, "/");
    unused BuilderAppend(desc, "inferno");
    tostdout := false;
    not := false;

    scan: Arg.Scan;
    while true {
        c := Arg.Option(*scan);
        if c == 0 { break }
        if c == 110 { not = true }
        else if c == 111 { tostdout = true }
        else if c == 112 { if !ReqArg(*scan, "proto file (-p)", *protof) { return 1 } }
        else if c == 114 { if !ReqArg(*scan, "root directory (-r)", *root) { return 1 } }
        else if c == 115 { if !ReqArg(*scan, "source directory (-d)", *oldroot) { return 1 } }
        else if c == 117 { update = true }
        else if c == 118 { verb = true }
        else if c == 120 { xflag = true }
        else if c == 78 { if !ReqArg(*scan, "user name (-U)", *uid) { return 1 } }
        else if c == 71 { if !ReqArg(*scan, "group name (-G)", *gid) { return 1 } }
        else if c == 100 || c == 68 { if !ReqArg(*scan, "product description (-D)", *desc) { return 1 } }
        else if c == 116 {
            rt: Vec(u8);
            if !ReqArg(*scan, "package time (-t)", *rt) { return 1 }
            tv, _ := Util.ParseIntBase(TextView(rt[:]), 10);
            now = cast(s32)tv;
        }
        else if c == 105 { if !ReqArg(*scan, "file (-i)", *notesf) { return 1 } }
        else if c == 82 { if !ReqArg(*scan, "remove file (-R)", *remfile) { return 1 } }
        else if c == 80 { Arch.AddPerms(false) }
        else { return Usage() }
    }

    argc := Args.OperandCount();
    if scan.next >= argc { return Usage() }

    pkg_name := Args.Operand(scan.next);
    if tostdout || xflag {
        out_fd = 1;
        close_out = false;
    } else {
        ar_name: Vec(u8);
        Wrap.Now2String(now, 0, *ar_name);
        out_fd = IO.Create(TextView(ar_name[:]), 1, 0x1B4); // 0664
        if out_fd < 0 {
            eb: Vec(u8);
            BuilderPrint(*eb, "can't create % for archive: %", TextView(ar_name[:]), IO.Error());
            return ErrorExit(TextView(eb[:]));
        }
        close_out = true;
        ob: Vec(u8);
        BuilderPrint(*ob, "archiving package % to %\n", pkg_name, TextView(ar_name[:]));
        Util.WriteOut(TextView(ob[:]));
    }

    if update {
        for i: scan.next + 1..argc - 1 {
            s_arg := Args.Operand(cast(s32)i);
            if not { VecPush(notprefixes, MakeText(s_arg)) }
            else { VecPush(prefixes, MakeText(s_arg)) }
        }
    } else if scan.next + 1 < argc {
        return Fatal("only one name allowed");
    }

    digest: [16]u8;
    if !xflag {
        if !WrapInit(pkg_name, now, digest[:]) { return 1 }
    }
    eb: Vec(u8);
    BuilderPrint(*eb, "processing %\n", TextView(protof[:]));
    Util.WriteErr(TextView(eb[:]));

    pres2: Proto.ProtoResult;
    unused Proto.RdProto(TextView(protof[:]), TextView(oldroot[:]), *pres2);
    if !HandleDiags(*pres2) { return 1 }
    ProcessProtoItems(*pres2);

    if !xflag {
        WrapEnd(digest[:]);
        Util.WriteErr("file system made\n");
    }
    end_b: Vec(u8);
    Arch.PutEnd(*end_b);
    unused IO.Write(out_fd, TextView(end_b[:]));
    Cleanup();
    return 0;
}
