<../../../mkconfig

TARG=	mash.dis\
	mashlib.dis\
	mashparse.dis\
	builtins.dis\
	history.dis\
	make.dis\

INS=	$ROOT/zx/mash.dis\
	$ROOT/zx/lib/mashlib.dis\
	$ROOT/zx/lib/mashparse.dis\
	$ROOT/zx/lib/mash/builtins.dis\
	$ROOT/zx/lib/mash/history.dis\
	$ROOT/zx/lib/mash/make.dis\

MODULES=\
	mash.m\
	mashparse.m\

SYSMODULES=\
	bufio.m\
	draw.m\
	filepat.m\
	hash.m\
	regex.m\
	sh.m\
	string.m\
	sys.m\

LIBSRC=\
	depends.b\
	dump.b\
	exec.b\
	expr.b\
	lex.b\
	misc.b\
	serve.b\
	symb.b\
	xeq.b\

all:V:		$TARG

install:V:	$INS

nuke:V: clean
	rm -f $INS

clean:V:
	rm -f *.dis *.sbl

uninstall:V:
	rm -f $INS

MODDIR=$ROOT/module
SYS_MODULE=${SYSMODULES:%=$MODDIR/%}
LIMBOFLAGS=-I$MODDIR

$ROOT/zx/mash.dis:	mash.dis
	rm -f $ROOT/zx/mash.dis && cp mash.dis $ROOT/zx/mash.dis

$ROOT/zx/lib/mashlib.dis:	mashlib.dis
	rm -f $ROOT/zx/mashlib.dis && cp mashlib.dis $ROOT/zx/lib/mashlib.dis

$ROOT/zx/lib/mashparse.dis:	mashparse.dis
	rm -f $ROOT/zx/mashparse.dis && cp mashparse.dis $ROOT/zx/lib/mashparse.dis

$ROOT/zx/lib/mash/%.dis:	%.dis
	rm -f $ROOT/zx/$stem.dis && cp $stem.dis $ROOT/zx/lib/mash/$stem.dis

%.dis:		$MODULES $SYS_MODULE
mashlib.dis:	$LIBSRC

%.dis:		%.b
	limbo $LIMBOFLAGS -gw $stem.b

%.s:		%.b
	limbo $LIMBOFLAGS -w -G -S $stem.b

# The ZX mash: mash.zi and its modules, with the builtins compiled in.
ZXCMD=..
ZXSH=../sh
MASHZX=mash.zi mash_ast.zi mash_lex.zi mash_parse.zi mash_env.zi mash_value.zi mash_exec.zi mash_builtins.zi

mash.zx:	$MASHZX $ZXSH/shell_util.zi $ZXSH/shell_filepat.zi $ZXSH/shell_regexp.zi $ZXCMD/taijios_args.zi $ZXCMD/taijios_io.zi $ZXCMD/taijios_namespace.zi $ZXCMD/taijios_process.zi mkfile
	zi2zx --root . --module-path .. --module-path ../sh --bind-host taijios_args --bind-host taijios_io --bind-host taijios_namespace --bind-host taijios_process --entry mash:main -o $target mash.zi
	chmod 755 $target

install-zx:V:	$ROOT/zx/mash.zx

$ROOT/zx/mash.zx:	mash.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 mash.zx "$staged" && mv "$staged" "$target"
