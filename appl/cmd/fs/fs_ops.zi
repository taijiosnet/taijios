// Gates, selectors, entries streams, void sinks, and shell command runners for /zx/fs.
#import "std/vec"
#import "std/option"
Io :: #import "taijios_io";
Stat :: #import "taijios_stat";
Ns :: #import "taijios_namespace";
Proc :: #import "taijios_process";
Re :: #import "shell_regexp";
using Fs :: #import "fs_types";

// ============================================================================
// 1. Gates: and, or, not, match, mode, depth, path, query
// ============================================================================

and_prod: s32 = -1;
or_prod: s32 = -1;
not_prod: s32 = -1;
match_prod: s32 = -1;
mode_prod: s32 = -1;
depth_prod: s32 = -1;
path_prod: s32 = -1;
query_prod: s32 = -1;

RunAnd :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if and_prod < 0 { and_prod = GateProducer("and", AndGate) }
    v := NewValue(#char "p", and_prod);
    SetKids(v, args);
    return v;
}

AndGate :: (v: s32, e: *EntryItem) -> bool {
    for i: 0..KidCount(v) - 1 {
        if !Query(Kid(v, i), e) { return false }
    }
    return true;
}

RunOr :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if or_prod < 0 { or_prod = GateProducer("or", OrGate) }
    v := NewValue(#char "p", or_prod);
    SetKids(v, args);
    return v;
}

OrGate :: (v: s32, e: *EntryItem) -> bool {
    for i: 0..KidCount(v) - 1 {
        if Query(Kid(v, i), e) { return true }
    }
    return false;
}

RunNot :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if not_prod < 0 { not_prod = GateProducer("not", NotGate) }
    v := NewValue(#char "p", not_prod);
    SetKids(v, args[0:1]);
    return v;
}

NotGate :: (v: s32, e: *EntryItem) -> bool {
    return !Query(Kid(v, 0), e);
}

MatchState :: struct {
    all: bool;
    regex: bool;
    pat: string;
    re: Re.Re;
}

matches: Vec(MatchState);

RunMatch :: (opts: []FsOpt, args: []s32) -> s32 {
    if match_prod < 0 { match_prod = GateProducer("match", MatchGate) }
    pat := ValueText(args[0]);
    m: MatchState;
    m.pat = pat;
    for * it: opts {
        if it.opt == #char "a" { m.all = true }
        if it.opt == #char "r" { m.regex = true }
    }
    if m.regex {
        err: Text;
        if !Re.Compile(pat, 0, *m.re, *err) {
            out: Vec(u8);
            BuilderPrint(*out, "fs: match: regex error on %: %", QQ(pat), TextView(err));
            ErrLine(BuilderFinish(out));
            return -1;
        }
    }
    v := NewValue(#char "p", match_prod);
    VecPush(matches, m);
    SetN0(v, matches.count - 1);
    return v;
}

MatchGate :: (v: s32, e: *EntryItem) -> bool {
    idx := N0(v);
    name := ifx matches[idx].all then e.path else e.dir.name;
    if matches[idx].regex {
        w: Vec(s32);
        Runes(name, *w);
        rm: Re.Match;
        return Re.Execute(*matches[idx].re, *w, *rm);
    }
    return FilepatMatch(matches[idx].pat, name);
}

RunMode :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if mode_prod < 0 { mode_prod = GateProducer("mode", ModeGate) }
    spec := ValueText(args[0]);
    ok, mask, mode := ParseMode(spec);
    if !ok {
        out: Vec(u8);
        BuilderPrint(*out, "fs: mode: bad mode %", QQ(spec));
        ErrLine(BuilderFinish(out));
        return -1;
    }
    v := NewValue(#char "p", mode_prod);
    SetN0(v, mask);
    SetN1(v, mode & mask);
    return v;
}

ModeGate :: (v: s32, e: *EntryItem) -> bool {
    return ((cast(s64)e.dir.mode & N0(v)) ^ N1(v)) == 0;
}

RunDepth :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if depth_prod < 0 { depth_prod = GateProducer("depth", DepthGate) }
    d := LimboInt(ValueText(args[0]));
    if d <= 0 {
        ErrLine("fs: depth: invalid depth");
        return -1;
    }
    v := NewValue(#char "p", depth_prod);
    SetN0(v, d);
    return v;
}

DepthGate :: (v: s32, e: *EntryItem) -> bool {
    return e.depth <= N0(v);
}

RunPath :: (opts: []FsOpt, args: []s32) -> s32 {
    if path_prod < 0 { path_prod = GateProducer("path", PathGate) }
    v := NewValue(#char "p", path_prod);
    SetKids(v, args);
    SetN0(v, ifx opts.count > 0 then 1 else 0);
    return v;
}

PathGate :: (v: s32, e: *EntryItem) -> bool {
    path := e.path;
    xflag := N0(v) == 1;
    i := KidCount(v) - 1;
    while i >= 0 {
        p := ValueText(Kid(v, i));
        i -= 1;
        if xflag {
            r := true;
            if path.count > p.count {
                r = path[p.count] != #char "/" || path[0:p.count] != p;
            } else if path.count == p.count {
                r = path != p;
            }
            if !r { return false }
        } else {
            r := false;
            if path.count > p.count {
                r = path[p.count] == #char "/" && path[0:p.count] == p;
            } else if path.count == p.count {
                r = path == p;
            } else {
                r = p[path.count] == #char "/" && p[0:path.count] == path;
            }
            if r { return true }
        }
    }
    return xflag;
}

// Helper to format stat environment assignments for exec, pipe, query
AppendHexU64 :: (out: *Vec(u8), v_in: u64) {
    if v_in == 0 {
        VecPush(<<out, #char "0");
        return;
    }
    hex := "0123456789abcdef";
    digits: [20]u8;
    k := 0;
    v := v_in;
    while v > 0 {
        digits[k] = hex[cast(s64)(v & 15)];
        k += 1;
        v >>= 4;
    }
    while k > 0 {
        k -= 1;
        VecPush(<<out, digits[k]);
    }
}

AppendStatEnv :: (out: *Vec(u8), d: FsDir, pflag: s32) {
    if pflag <= 0 { return }
    BuilderPrint(out, "mode=%; uid=%; mtime=%; length=%; ", Q(Modes(d.mode)), Q(d.uid), d.mtime, d.length);
    if pflag > 1 {
        qbuf: Vec(u8);
        unused BuilderAppend(qbuf, "16r");
        AppendHexU64(*qbuf, d.qpath);
        dtbuf: Vec(u8);
        AppendRune(*dtbuf, ifx d.dtype < 0 || d.dtype > 0x10FFFF then 0xFFFD else d.dtype);
        BuilderPrint(out, "name=%; gid=%; muid=%; qid=(% %); atime=%; dtype=%; dev=%; ",
            Q(d.name), Q(d.gid), Q(d.muid), BuilderFinish(qbuf), d.qvers, d.atime, Q(BuilderFinish(dtbuf)), d.dev);
    }
}

StripBraces :: (cmd: string) -> string {
    if cmd.count >= 2 && cmd[0] == #char "{" && cmd[cmd.count - 1] == #char "}" {
        return cmd[1:cmd.count - 1];
    }
    return cmd;
}

RunShellScript :: (script: string) -> Proc.Outcome {
    args: [2]string = .["-c", script];
    return Proc.Run("/zx/sh.zx", args[:]);
}

RunQuery :: (opts: []FsOpt, args: []s32) -> s32 {
    if query_prod < 0 { query_prod = GateProducer("query", QueryGate) }
    pflag: s32 = 0;
    for * it: opts {
        if it.opt == #char "p" { pflag = 1 }
        if it.opt == #char "P" { pflag = 2 }
    }
    v := NewValue(#char "p", query_prod);
    SetKids(v, args[0:1]);
    SetN0(v, cast(s64)pflag);
    return v;
}

QueryGate :: (v: s32, e: *EntryItem) -> bool {
    cmd := ValueText(Kid(v, 0));
    pflag := cast(s32)N0(v);
    script: Vec(u8);
    BuilderPrint(*script, "file=%; ", Q(e.path));
    AppendStatEnv(*script, e.dir, pflag);
    unused BuilderAppend(script, StripBraces(cmd));
    out := RunShellScript(BuilderFinish(script));
    return out.status >= 0 && out.value == 0 && out.error.count == 0;
}

// ============================================================================
// 2. Selectors: compose / join ("ms-d")
// ============================================================================

compose_prod: s32 = -1;

AinB :: 8;
BinA :: 4;
AoutB :: 2;
BoutA :: 1;

COMPOSE_OPS: [12]string = .["", "BoutA", "AoutB", "AxorB", "BinA", "B", "BatopA", "BoverA", "AinB", "AatopB", "A", "AoverB"];

RunCompose :: (opts: []FsOpt, args: []s32) -> s32 {
    if compose_prod < 0 { compose_prod = SelectorProducer("compose", ComposeCmp) }
    s := ValueText(args[0]);
    op: s64 = -1;
    for COMPOSE_OPS { if it == s { op = it_index } }
    if op <= 0 {
        out: Vec(u8);
        BuilderPrint(*out, "fs: join: bad op %", Q(s));
        ErrLine(BuilderFinish(out));
        return -1;
    }
    v := NewValue(#char "m", compose_prod);
    t: s64 = 0;
    if (op & AinB) != 0 { t |= 1 << 6 }
    if (op & BinA) != 0 { t = (t & ~(3 << 6)) | (2 << 6) }
    if (op & AoutB) != 0 { t |= 1 << 2 }
    if (op & BoutA) != 0 { t |= 2 << 4 }
    SetN0(v, t);
    SetN1(v, ifx opts.count > 0 then 1 else 0);
    return v;
}

ComposeCmp :: (v: s32, d0: *FsDir, d1: *FsDir, has0: bool, has1: bool) -> s32 {
    x: s64 = (ifx has1 then 2 else 0) | (ifx has0 then 1 else 0);
    r := cast(s32)((N0(v) >> (2 * x)) & 3);
    if N1(v) == 1 && r == 0 && x == 3 && (d0.mode & d1.mode & DMDIR) != 0 { r = 3 }
    return r;
}

// ============================================================================
// 3. Entries streams: entries ("tx"), select ("tpt")
// ============================================================================

entries_prod: s32 = -1;
select_prod: s32 = -1;

EntriesState :: struct {
    names: Vec(string);
    name: string;
    indent: s64;
    reply: s32;
    started: bool;
    over: bool;
}

entries_states: Vec(EntriesState);

RunEntries :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if entries_prod < 0 { entries_prod = EntriesProducer("entries", EntriesNextOp) }
    v := NewValue(#char "t", entries_prod);
    SetKids(v, args[0:1]);
    e: EntriesState;
    e.reply = Start;
    VecPush(entries_states, e);
    SetN0(v, entries_states.count - 1);
    return v;
}

EntriesNextOp :: (v: s32, go: bool) -> EntryItem {
    s := N0(v);
    src := Kid(v, 0);
    none: EntryItem;
    if entries_states[s].over { return none }
    if !entries_states[s].started {
        entries_states[s].started = true;
        if !go {
            entries_states[s].over = true;
            first := FsNext(src, Start);
            if first.kind != Done { unused FsNext(src, Quit) }
            return none;
        }
    }
    while true {
        item := FsNext(src, entries_states[s].reply);
        if item.kind == Done {
            entries_states[s].over = true;
            return none;
        }
        if item.kind == Entry {
            d := item.dir;
            depth := entries_states[s].indent;
            p: string;
            if IsDir(d) {
                VecPush(entries_states[s].names, entries_states[s].name);
                if entries_states[s].indent == 0 {
                    entries_states[s].name = d.name;
                } else {
                    entries_states[s].name = Slash(entries_states[s].name, d.name);
                }
                entries_states[s].indent += 1;
                entries_states[s].reply = Down;
                p = entries_states[s].name;
            } else {
                p = Slash(entries_states[s].name, d.name);
                entries_states[s].reply = Next;
            }
            if p.count == 0 { continue }
            return EntryItemOf(d, p, depth);
        }
        entries_states[s].reply = Next;
        if item.kind == End {
            entries_states[s].indent -= 1;
            if entries_states[s].indent == 0 {
                unused FsNext(src, Next);
                entries_states[s].over = true;
                return none;
            }
            last := VecPop(entries_states[s].names);
            entries_states[s].name = last.value;
        }
    }
    return none;
}

RunSelect :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    // Note: in appl/cmd/fs/select.b, signature is "tpt": args[0] is gate, args[1] is entries!
    if select_prod < 0 { select_prod = EntriesProducer("select", SelectNextOp) }
    v := NewValue(#char "t", select_prod);
    SetKids(v, args[0:2]);
    return v;
}

SelectNextOp :: (v: s32, go: bool) -> EntryItem {
    none: EntryItem;
    gate := Kid(v, 0);
    src := Kid(v, 1);
    if !go {
        unused EntriesNext(src, false);
        return none;
    }
    while true {
        e := EntriesNext(src, true);
        if !e.ok { return none }
        if Query(gate, *e) { return e }
    }
    return none;
}

// ============================================================================
// 4. Void sinks: print ("vt"), ls ("vt-u-m"), size ("vt"), void ("vv")
// ============================================================================

print_prod: s32 = -1;
ls_prod: s32 = -1;
size_prod: s32 = -1;

RunPrint :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if print_prod < 0 { print_prod = VoidProducer("print", PrintVoid) }
    v := NewValue(#char "v", print_prod);
    SetKids(v, args[0:1]);
    SetErrc(v, ReportStart("print"));
    return v;
}

PrintVoid :: (v: s32, go: bool) -> s32 {
    src := Kid(v, 0);
    if !go {
        unused EntriesNext(src, false);
        return 0;
    }
    out: Vec(u8);
    while true {
        e := EntriesNext(src, true);
        if !e.ok { break }
        BuilderPrint(*out, "%\n", e.path);
    }
    WriteOut(BuilderFinish(out));
    return 0;
}

RunLs :: (opts: []FsOpt, args: []s32) -> s32 {
    if ls_prod < 0 { ls_prod = VoidProducer("ls", LsVoid) }
    v := NewValue(#char "v", ls_prod);
    SetKids(v, args[0:1]);
    SetErrc(v, ReportStart("ls"));
    flags: s64 = 0;
    for * it: opts {
        if it.opt == #char "m" { flags |= 1 }
        if it.opt == #char "u" { flags |= 2 }
    }
    SetN0(v, flags);
    return v;
}

LsVoid :: (v: s32, go: bool) -> s32 {
    src := Kid(v, 0);
    if !go {
        unused EntriesNext(src, false);
        return 0;
    }
    flags := N0(v);
    now := Now();
    out: Vec(u8);
    while true {
        e := EntriesNext(src, true);
        if !e.ok { break }
        d := e.dir;
        if (flags & 1) != 0 { BuilderPrint(*out, "[%] ", d.muid) }
        unused BuilderAppend(out, Modes(d.mode));
        VecPush(out, #char " ");
        AppendRune(*out, ifx d.dtype < 0 || d.dtype > 0x10FFFF then 0xFFFD else d.dtype);
        // Note: in appl/cmd/fs/ls.b line 66, daytime->filet(now, dir.mtime) is passed dir.mtime
        t := d.mtime;
        BuilderPrint(*out, " % % % % % %\n", d.dev, d.uid, d.gid, d.length, Filet(now, cast(s64)t), e.path);
    }
    WriteOut(BuilderFinish(out));
    return 0;
}

RunSize :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if size_prod < 0 { size_prod = VoidProducer("size", SizeVoid) }
    v := NewValue(#char "v", size_prod);
    SetKids(v, args[0:1]);
    SetErrc(v, ReportStart("size"));
    return v;
}

SizeVoid :: (v: s32, go: bool) -> s32 {
    src := Kid(v, 0);
    if !go {
        unused EntriesNext(src, false);
        return 0;
    }
    total: s64 = 0;
    while true {
        e := EntriesNext(src, true);
        if !e.ok { break }
        total += e.dir.length;
    }
    out: Vec(u8);
    BuilderPrint(*out, "%\n", total);
    WriteOut(BuilderFinish(out));
    return 0;
}

RunVoidVerb :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    return args[0];
}

// ============================================================================
// 5. bundle ("vx"), write ("vsx"), mergewrite ("vmsx")
// ============================================================================

bundle_prod: s32 = -1;
write_prod: s32 = -1;
mergewrite_prod: s32 = -1;

Dir2Header :: (d: FsDir) -> string {
    out: Vec(u8);
    AppendQ(*out, d.name);
    VecPush(out, #char " ");
    Octal(*out, cast(u64)d.mode);
    VecPush(out, #char " ");
    AppendQ(*out, d.uid);
    VecPush(out, #char " ");
    AppendQ(*out, d.gid);
    BuilderPrint(*out, " % %\n", d.mtime, d.length);
    return BuilderFinish(out);
}

RunBundle :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    if bundle_prod < 0 { bundle_prod = VoidProducer("bundle", BundleVoid) }
    v := NewValue(#char "v", bundle_prod);
    SetKids(v, args[0:1]);
    SetErrc(v, ReportStart("bundle"));
    return v;
}

BundleDir :: (src: s32, path_in: string, d: FsDir, errc: s32, ok: *bool) -> Item {
    done: Item;
    done.kind = Done;
    if IsDir(d) {
        path := Join(path_in, "/");
        ent := FsNext(src, Down);
        while ent.kind == Entry {
            WriteOut(Dir2Header(ent.dir));
            ent = BundleDir(src, Join(path, ent.dir.name), ent.dir, errc, ok);
            if !ok.* { return done }
        }
        WriteOut("\n");
        return FsNext(src, Skip);
    }
    length := d.length;
    n: s64 = 0;
    item := FsNext(src, Down);
    while item.kind == Data && item.data.count > 0 {
        WriteOut(item.data);
        n += item.data.count;
        if n > length {
            out: Vec(u8);
            BuilderPrint(*out, "% is longer than expected (fatal)", Q(path_in));
            Report(errc, BuilderFinish(out));
            unused FsNext(src, Quit);
            <<ok = false;
            return done;
        }
        if n == length {
            return FsNext(src, Skip);
        }
        item = FsNext(src, Next);
    }
    if n < length {
        out: Vec(u8);
        BuilderPrint(*out, "% is shorter than expected (%/%); adding null bytes", Q(path_in), n, length);
        Report(errc, BuilderFinish(out));
        while n < length {
            nb: s64 = ATOMICIO;
            if length - n < nb { nb = length - n }
            pad: Vec(u8);
            for _: 0..nb - 1 { VecPush(pad, 0) }
            WriteOut(BuilderFinish(pad));
            msg: Vec(u8);
            BuilderPrint(*msg, "added % null bytes", nb);
            Report(errc, BuilderFinish(msg));
            n += nb;
        }
    }
    return FsNext(src, Skip);
}

BundleVoid :: (v: s32, go: bool) -> s32 {
    src := Kid(v, 0);
    errc := ErrcOf(v);
    if !go {
        first := FsNext(src, Start);
        if first.kind != Done { unused FsNext(src, Quit) }
        return 0;
    }
    item := FsNext(src, Start);
    if item.kind != Entry || item.dir.name.count == 0 {
        Report(errc, "no root directory");
        WriteOut("end of archive\n");
        return 0;
    }
    WriteOut(Dir2Header(item.dir));
    ok := true;
    unused BundleDir(src, item.dir.name, item.dir, errc, *ok);
    if ok {
        WriteOut("end of archive\n");
    }
    return 0;
}

SetFileMode :: (h: s32, mode: u32) -> bool {
    info: Stat.Info;
    info.mode = mode;
    return Stat.Change(h, info, true, false, false, false);
}

RunWrite :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    // Signature in appl/cmd/fs/write.b is "vsx": args[0] is root: string, args[1] is fs!
    if write_prod < 0 { write_prod = VoidProducer("write", WriteVoid) }
    v := NewValue(#char "v", write_prod);
    kids: [1]s32 = .[args[1]];
    SetKids(v, kids[:]);
    SetText(v, ValueText(args[0]));
    SetErrc(v, ReportStart("fswrite"));
    return v;
}

WriteDirTree :: (src: s32, path: string, d: FsDir, errc: s32) -> Item {
    if IsDir(d) {
        h := Io.CreateFile(path, 0, cast(s32)(d.mode | 0xC0));
        if h < 0 {
            err := Io.LastError();
            h = Io.OpenFile(path, 0);
            if h < 0 {
                next := FsNext(src, Next);
                out: Vec(u8);
                BuilderPrint(*out, "cannot create %, mode ", Q(path));
                Octal(*out, cast(u64)(d.mode | 0xC0));
                BuilderPrint(*out, ": %", err);
                Report(errc, BuilderFinish(out));
                return next;
            }
        }
        item := FsNext(src, Down);
        dir_prefix := Join(path, "/");
        while item.kind == Entry {
            item = WriteDirTree(src, Join(dir_prefix, item.dir.name), item.dir, errc);
        }
        next := FsNext(src, Next);
        if (d.mode & 0xC0) != 0xC0 {
            if !SetFileMode(h, d.mode) {
                Report(errc, WithError(Join("cannot wstat ", Q(path))));
            }
        }
        unused Io.CloseFile(h);
        return next;
    }
    h := Io.CreateFile(path, 1, cast(s32)d.mode);
    if h < 0 {
        next := FsNext(src, Next);
        out: Vec(u8);
        BuilderPrint(*out, "cannot create %, mode ", Q(path));
        Octal(*out, cast(u64)(d.mode | 0xC0));
        BuilderPrint(*out, ": %", Io.LastError());
        Report(errc, BuilderFinish(out));
        return next;
    }
    item := FsNext(src, Down);
    while item.kind == Data {
        nw := Io.WriteBytes(h, item.data);
        if nw < item.data.count {
            if nw < 0 {
                Report(errc, WithError(Join("error writing ", Q(path))));
            } else {
                Report(errc, "short write");
            }
            unused Io.CloseFile(h);
            return FsNext(src, Skip);
        }
        item = FsNext(src, Next);
    }
    unused Io.CloseFile(h);
    return FsNext(src, Next);
}

WriteVoid :: (v: s32, go: bool) -> s32 {
    src := Kid(v, 0);
    if !go {
        first := FsNext(src, Start);
        if first.kind != Done { unused FsNext(src, Quit) }
        return 0;
    }
    item := FsNext(src, Start);
    if item.kind != Entry { return 0 }
    d := item.dir;
    root := ValueText(v);
    if root.count > 0 { d.name = root }
    unused WriteDirTree(src, d.name, d, ErrcOf(v));
    return 0;
}

RunMergewrite :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    // Signature in appl/cmd/fs/mergewrite.b is "vmsx": args[0] is selector, args[1] is root, args[2] is fs!
    if mergewrite_prod < 0 { mergewrite_prod = VoidProducer("mergewrite", MergewriteVoid) }
    v := NewValue(#char "v", mergewrite_prod);
    kids: [2]s32 = .[args[0], args[2]];
    SetKids(v, kids[:]);
    SetText(v, ValueText(args[1]));
    SetErrc(v, ReportStart("mergewrite"));
    return v;
}

MwRemove :: (name: string) {
    if Io.Remove(name) < 0 {
        ErrLine(WithError(Join("mergewrite: cannot remove ", Q(name))));
    }
}

MwRmdir :: (name: string) {
    entries: Vec(FsDir);
    unused ReadDirUnsorted(name, *entries);
    for entries {
        p := Slash(name, it.name);
        if IsDir(it) {
            MwRmdir(p);
        } else {
            MwRemove(p);
        }
    }
    MwRemove(name);
}

MwCompare :: (cmp: s32, d0: FsDir, d1: FsDir, has0: bool, has1: bool) -> s32 {
    mask: s32 = (ifx has0 then 1 else 0) | (ifx has1 then 2 else 0);
    if cmp < 0 { return mask }
    a := d0;
    b := d1;
    return Compare(cmp, *a, *b, has0, has1) & mask;
}

MergewriteDir :: (src: s32, cmp: s32, path: string, dir: FsDir, pend_reply: *s32, errc: s32) {
    if IsDir(dir) {
        h := Io.CreateFile(path, 0, cast(s32)(dir.mode | 0xC0));
        made := h >= 0;
        if h < 0 {
            err := Io.LastError();
            h = Io.OpenFile(path, 0);
            if h < 0 {
                <<pend_reply = Next;
                out: Vec(u8);
                BuilderPrint(*out, "cannot create %, mode ", Q(path));
                Octal(*out, cast(u64)(dir.mode | 0xC0));
                BuilderPrint(*out, ": %", err);
                Report(errc, BuilderFinish(out));
                return;
            }
        }
        entries: Vec(FsDir);
        if !made {
            unused ReadDir(path, *entries);
        }
        i: s64 = 0;
        eod := false;
        has0 := false;
        has1 := false;
        d0: FsDir;
        d1: FsDir;
        next_reply: s32 = Down;
        dir_prefix := Join(path, "/");
        while true {
            if !eod && !has0 {
                it := FsNext(src, next_reply);
                if it.kind != Entry {
                    eod = true;
                } else {
                    d0 = it.dir;
                    has0 = true;
                }
            }
            if !has1 && i < entries.count {
                d1 = entries[i];
                has1 = true;
                i += 1;
            }
            if !has0 && !has1 { break }
            w0 := has0;
            w1 := has1;
            if has0 && has1 && d0.name != d1.name {
                if NameLess(d0.name, d1.name) { w1 = false } else { w0 = false }
            }
            r := MwCompare(cmp, d0, d1, w0, w1);
            if w1 && (r & 2) == 0 {
                p1 := Join(dir_prefix, d1.name);
                if IsDir(d1) { MwRmdir(p1) } else { MwRemove(p1) }
                has1 = false;
            } else if w1 {
                has1 = false;
            }
            if w0 {
                if (r & 1) == 0 {
                    next_reply = Next;
                } else {
                    MergewriteDir(src, cmp, Join(dir_prefix, d0.name), d0, *next_reply, errc);
                }
                has0 = false;
            }
        }
        <<pend_reply = Next;
        if (dir.mode & 0xC0) != 0xC0 {
            if !SetFileMode(h, dir.mode) {
                Report(errc, WithError(Join("cannot wstat ", Q(path))));
            }
        }
        unused Io.CloseFile(h);
        return;
    }
    h := Io.CreateFile(path, 1, cast(s32)dir.mode);
    if h < 0 {
        <<pend_reply = Next;
        out: Vec(u8);
        BuilderPrint(*out, "cannot create %, mode ", Q(path));
        Octal(*out, cast(u64)(dir.mode | 0xC0));
        BuilderPrint(*out, ": %", Io.LastError());
        Report(errc, BuilderFinish(out));
        return;
    }
    item := FsNext(src, Down);
    while item.kind == Data {
        nw := Io.WriteBytes(h, item.data);
        if nw < item.data.count {
            if nw < 0 {
                Report(errc, WithError(Join("error writing ", Q(path))));
            } else {
                Report(errc, "short write");
            }
            unused Io.CloseFile(h);
            <<pend_reply = Skip;
            return;
        }
        item = FsNext(src, Next);
    }
    unused Io.CloseFile(h);
    <<pend_reply = Next;
}

MergewriteVoid :: (v: s32, go: bool) -> s32 {
    cmp := Kid(v, 0);
    src := Kid(v, 1);
    if !go {
        first := FsNext(src, Start);
        if first.kind != Done { unused FsNext(src, Quit) }
        return 0;
    }
    item := FsNext(src, Start);
    if item.kind != Entry { return 0 }
    d := item.dir;
    root := ValueText(v);
    if root.count > 0 { d.name = root }
    pend_reply: s32 = Next;
    MergewriteDir(src, cmp, d.name, d, *pend_reply, ErrcOf(v));
    unused FsNext(src, pend_reply);
    return 0;
}

// ============================================================================
// 6. Shell command verbs: exec ("vct-ns-tc-p-P"), pipe ("vcx-1-p-P"), run ("sc")
// ============================================================================

exec_prod: s32 = -1;
pipe_prod: s32 = -1;

ExecState :: struct {
    n: s32;
    pflag: s32;
    has_tcmd: bool;
    tcmd: string;
}

exec_states: Vec(ExecState);

RunExec :: (opts: []FsOpt, args: []s32) -> s32 {
    if exec_prod < 0 { exec_prod = VoidProducer("exec", ExecVoid) }
    st: ExecState;
    st.n = 1;
    st.pflag = 0;
    for * it: opts {
        if it.opt == #char "n" && it.args.count > 0 {
            nval := cast(s32)LimboInt(ValueText(it.args[0]));
            if nval <= 0 {
                ErrLine("fs: exec: invalid argument to -n");
                return -1;
            }
            st.n = nval;
        } else if it.opt == #char "t" && it.args.count > 0 {
            st.has_tcmd = true;
            st.tcmd = ValueText(it.args[0]);
        } else if it.opt == #char "p" {
            st.pflag = 1;
        } else if it.opt == #char "P" {
            st.pflag = 2;
        }
    }
    if st.pflag != 0 && st.n > 1 {
        out: Vec(u8);
        BuilderPrint(*out, "fs: exec: cannot specify -p with -n %", st.n);
        ErrLine(BuilderFinish(out));
        return -1;
    }
    v := NewValue(#char "v", exec_prod);
    SetKids(v, args[0:2]);
    SetErrc(v, ReportStart("exec"));
    VecPush(exec_states, st);
    SetN0(v, exec_states.count - 1);
    return v;
}

ExecBatch :: (files: []string, last_dir: FsDir, pflag: s32, cmd: string) {
    script: Vec(u8);
    if files.count == 0 {
        unused BuilderAppend(script, "file=(); ");
    } else if files.count == 1 {
        BuilderPrint(*script, "file=%; ", Q(files[0]));
    } else {
        unused BuilderAppend(script, "file=(");
        for files {
            if it_index > 0 { VecPush(script, #char " ") }
            AppendQ(*script, it);
        }
        unused BuilderAppend(script, "); ");
    }
    AppendStatEnv(*script, last_dir, pflag);
    unused BuilderAppend(script, StripBraces(cmd));
    unused RunShellScript(BuilderFinish(script));
}

ExecVoid :: (v: s32, go: bool) -> s32 {
    idx := N0(v);
    cmd := ValueText(Kid(v, 0));
    src := Kid(v, 1);
    if !go {
        unused EntriesNext(src, false);
        return 0;
    }
    n := exec_states[idx].n;
    pflag := exec_states[idx].pflag;
    fl: Vec(string);
    last_dir: FsDir;
    while true {
        e := EntriesNext(src, true);
        if !e.ok { break }
        VecPush(fl, e.path);
        last_dir = e.dir;
        if cast(s32)fl.count >= n {
            ExecBatch(fl[:], last_dir, pflag, cmd);
            VecClear(fl);
        }
    }
    if fl.count > 0 {
        ExecBatch(fl[:], last_dir, 0, cmd);
    }
    if exec_states[idx].has_tcmd {
        empty_fl: [0]string;
        ExecBatch(empty_fl[:], last_dir, 0, exec_states[idx].tcmd);
    }
    return 0;
}

RunPipe :: (opts: []FsOpt, args: []s32) -> s32 {
    if pipe_prod < 0 { pipe_prod = VoidProducer("pipe", PipeVoid) }
    oneflag: s32 = 0;
    pflag: s32 = 0;
    for * it: opts {
        if it.opt == #char "1" { oneflag = 1 }
        if it.opt == #char "p" { pflag = 1 }
        if it.opt == #char "P" { pflag = 2 }
    }
    if pflag != 0 && oneflag != 0 {
        ErrLine("fs: exec: cannot specify -p with -1");
        return -1;
    }
    v := NewValue(#char "v", pipe_prod);
    SetKids(v, args[0:2]);
    SetN0(v, cast(s64)oneflag);
    SetN1(v, cast(s64)pflag);
    SetErrc(v, ReportStart("exec"));
    return v;
}

PopenShell :: (script: string, child_id: *s32) -> s32 {
    ends: [2]s32;
    if Ns.Pipe(ends[:]) < 0 { return -1 }
    args: [2]string = .["-c", script];
    launch := Proc.StartWith("/zx/sh.zx", args[:], ends[0], -1, -1);
    unused Io.CloseFile(ends[0]);
    if launch.id <= 0 {
        unused Io.CloseFile(ends[1]);
        return -1;
    }
    <<child_id = launch.id;
    return ends[1];
}

PipeVoid :: (v: s32, go: bool) -> s32 {
    cmd := ValueText(Kid(v, 0));
    src := Kid(v, 1);
    if !go {
        first := FsNext(src, Start);
        if first.kind != Done { unused FsNext(src, Quit) }
        return 0;
    }
    oneflag := N0(v) == 1;
    pflag := cast(s32)N1(v);
    fd: s32 = -1;
    child_id: s32 = 0;
    if oneflag {
        fd = PopenShell(StripBraces(cmd), *child_id);
        if fd < 0 {
            first := FsNext(src, Start);
            if first.kind != Done { unused FsNext(src, Quit) }
            return 0;
        }
    }
    names: Vec(string);
    name := "";
    indent: s64 = 0;
    reply: s32 = Start;
    while true {
        item := FsNext(src, reply);
        if item.kind == Done { break }
        if item.kind != Entry {
            reply = Next;
            indent -= 1;
            if indent <= 0 { break }
            last := VecPop(names);
            name = last.value;
            continue;
        }
        d := item.dir;
        if IsDir(d) {
            reply = Down;
            VecPush(names, name);
            if indent == 0 {
                name = d.name;
            } else {
                name = Slash(name, d.name);
            }
            indent += 1;
            continue;
        }
        if !oneflag {
            p := ifx name.count > 0 then Slash(name, d.name) else d.name;
            script: Vec(u8);
            BuilderPrint(*script, "file=%; ", Q(p));
            AppendStatEnv(*script, d, pflag);
            unused BuilderAppend(script, StripBraces(cmd));
            fd = PopenShell(BuilderFinish(script), *child_id);
        }
        if fd < 0 {
            reply = Next;
            continue;
        }
        reply = Down;
        while true {
            ditem := FsNext(src, reply);
            reply = Next;
            if ditem.kind != Data || ditem.data.count == 0 { break }
            nw := Io.WriteBytes(fd, ditem.data);
            if nw != ditem.data.count {
                if oneflag {
                    unused Io.CloseFile(fd);
                    unused Proc.Wait(child_id);
                    unused FsNext(src, Quit);
                    return 0;
                }
                reply = Skip;
                break;
            }
        }
        if !oneflag {
            unused Io.CloseFile(fd);
            fd = -1;
            unused Proc.Wait(child_id);
        }
    }
    if oneflag && fd >= 0 {
        unused Io.CloseFile(fd);
        unused Proc.Wait(child_id);
    }
    return 0;
}

// run command -> string ("sc")
RunRun :: (opts: []FsOpt, args: []s32) -> s32 {
    unused opts;
    cmd := ValueText(args[0]);
    // Use a pipe on stdout for the inspection suffix while letting the command itself use stderr/stdout:
    // We open a pipe, and run the command in sh.zx, writing $#s and $s to a temporary inspection file or pipe!
    // Even simpler: use a pipe as stdout of a child shell that redirects the command's stdout to the original stdout?
    // Or write $#s and $s to /tmp/fs_run_s or a pipe!
    // Wait: in TaijiOS guest, /chan or /env or current directory or a pipe:
    // Look at sh.zx: in sh.zx, `s=(); <cmd>` sets `s`, which sh.zx exports to `/env/s` (or we can redirect `echo $#s; for (x in $s) { echo -n $x }` to a pipe if the command doesn't print to stdout, or if we use fd 1 of the pipe after running `{ <cmd> } >[1=2]`? No, run command in fs is used for `s=...` without stdout, e.g. `{s=hello}`!).
    // Wait: what if the command DOES or DOES NOT write to stdout?
    // If we create a pipe `ends`, and run `Proc.StartWith("/zx/sh.zx", .["-c", script], -1, ends[1], -1)` where `script` is:
    // `s := (); { <body of cmd> }; load std; echo $#s; for i in $s { echo $i }`
    // Wait: what if `<body of cmd>` raises `fail:something`?
    // In `sh.zx`, if `<body of cmd>` raises `fail:something` inside `{ <body of cmd> }` without `rescue`, `sh.zx` unwinds immediately and exits with status 1 and `outcome.error = "something"` (WITHOUT executing `echo $#s`)!
    ends: [2]s32;
    if Ns.Pipe(ends[:]) < 0 { return -1 }
    script: Vec(u8);
    BuilderPrint(*script, "s := (); %; echo __FS_RUN_S__ $#s $s", cmd);
    sh_args: [2]string = .["-c", BuilderFinish(script)];
    launch := Proc.StartWith("/zx/sh.zx", sh_args[:], -1, ends[1], -1);
    unused Io.CloseFile(ends[1]);
    if launch.id <= 0 {
        unused Io.CloseFile(ends[0]);
        return -1;
    }
    captured: Vec(u8);
    buf: [1024]u8;
    while true {
        n := Io.ReadBytes(ends[0], buf[:]);
        if n <= 0 { break }
        unused BuilderAppend(captured, TextView(buf[:n]));
    }
    unused Io.CloseFile(ends[0]);
    out := Proc.Wait(launch.id);
    cap_text := BuilderFinish(captured);
    // Find "__FS_RUN_S__ " marker in cap_text
    marker := "__FS_RUN_S__ ";
    mpos: s64 = -1;
    if cap_text.count >= marker.count {
        i: s64 = 0;
        while i <= cap_text.count - marker.count {
            if cap_text[i:i + marker.count] == marker { mpos = i }
            i += 1;
        }
    }
    if mpos > 0 {
        WriteOut(cap_text[0:mpos]);
    }
    if mpos < 0 {
        // Command raised an exception before reaching marker
        err_str := ifx out.error.count > 0 then out.error else "error";
        eb: Vec(u8);
        BuilderPrint(*eb, "fs: run: exception % raised in %", Q(err_str), cmd);
        ErrLine(BuilderFinish(eb));
        return -1;
    }
    tail := cap_text[mpos + marker.count:];
    if tail.count > 0 && tail[tail.count - 1] == #char "\n" {
        tail = tail[0:tail.count - 1];
    }
    // Parse count and value
    sp: s64 = 0;
    while sp < tail.count && tail[sp] != #char " " { sp += 1 }
    cnt := LimboInt(tail[0:sp]);
    if cnt != 1 {
        eb: Vec(u8);
        BuilderPrint(*eb, "fs: run: $s has % members; exactly one is required", cnt);
        ErrLine(BuilderFinish(eb));
        return -1;
    }
    val := ifx sp + 1 <= tail.count then tail[sp + 1:] else "";
    return NewString(val);
}
