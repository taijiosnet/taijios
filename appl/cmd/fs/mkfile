<../../../mkconfig

ZI2ZX=zi2zx
ZXBIN=$ROOT/dis/fs
ZIFLAGS=--root . --module-path .. --module-path ../sh --bind-host taijios_args --bind-host taijios_io --bind-host taijios_stat --bind-host taijios_files --bind-host taijios_time --bind-host taijios_namespace --bind-host taijios_process

ZXCOMMANDS=\
	and\
	bundle\
	chstat\
	compose\
	depth\
	entries\
	eval\
	exec\
	filter\
	join\
	ls\
	match\
	merge\
	mergewrite\
	mode\
	not\
	or\
	path\
	pipe\
	print\
	proto\
	query\
	run\
	select\
	setroot\
	size\
	unbundle\
	void\
	walk\
	write\

ZXTARGETS=${ZXCOMMANDS:%=%.zx}
ZXINSTALL=${ZXCOMMANDS:%=$ZXBIN/%.zx}

all:V:		$ZXTARGETS

install:V:	$ZXINSTALL

clean:V:
	rm -f *.zx *.dis *.sbl

nuke:V:		clean
	cd $ZXBIN; rm -f $ZXTARGETS

uninstall:V:
	rm -f $ZXINSTALL

&.zx:	&.zi fs_types.zi fs_trees.zi fs_ops.zi fs_eval.zi
	$ZI2ZX $ZIFLAGS --entry $stem:main -o $target $stem.zi

$ZXBIN/%.zx:	%.zx
	install -m 0755 $stem.zx $target
