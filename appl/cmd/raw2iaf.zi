// Add an Inferno audio-file header to raw samples, after raw2iaf.b.
Args :: #import "taijios_args";
Io :: #import "taijios_io";
Cli :: #import "zx_cli";
Audio :: #import "zx_iaf";
#import "std/vec"

Usage :: () -> s32 {
    unused Cli.WriteAll(2, "usage: raw2iaf -8124 -ms -bw -aup -o out in\n");
    return 0;
}

#program_export
main :: () -> s32 {
    rate := "44100";
    channels := "2";
    bits := "16";
    encoding := "pcm";
    input_name: string;
    output_name: string;
    at: s32;
    while at < Args.OperandCount() {
        arg := Args.Operand(at);
        at += 1;
        if arg.count == 0 { continue }
        if arg[0] == 45 {
            if arg.count == 1 {
                if input_name.count == 0 { input_name = "-" }
                else { return Usage() }
            } else if arg[1] == 111 {
                if output_name.count != 0 { return Usage() }
                if arg.count > 2 { output_name = arg[2:] }
                else if at >= Args.OperandCount() { return Usage() }
                else { output_name = Args.Operand(at); at += 1 }
            } else {
                for index: 1..arg.count-1 {
                    flag := arg[index];
                    if flag == 56 { rate = "8000" }
                    else if flag == 49 { rate = "11025" }
                    else if flag == 50 { rate = "22050" }
                    else if flag == 52 { rate = "44100" }
                    else if flag == 109 { channels = "1" }
                    else if flag == 115 { channels = "2" }
                    else if flag == 98 { bits = "8" }
                    else if flag == 119 { bits = "16" }
                    else if flag == 97 { encoding = "alaw" }
                    else if flag == 117 { encoding = "ulaw" }
                    else if flag == 112 { encoding = "pcm" }
                    else { return Usage() }
                }
            }
        } else if input_name.count == 0 { input_name = arg }
        else { return Usage() }
    }
    input: s32;
    if input_name.count > 0 && input_name != "-" {
        input = Io.Open(input_name, 0);
        if input < 0 { Audio.IoError("raw2iaf", "open", input_name); return 0 }
    }
    defer { if input != 0 { unused Io.Close(input) } }
    output: s32 = 1;
    if output_name.count > 0 && output_name != "-" {
        output = Io.Create(output_name, 1, 438);
        if output < 0 { Audio.IoError("raw2iaf", "create", output_name); return 0 }
    }
    defer { if output != 1 { unused Io.Close(output) } }
    header: Vec(u8);
    Audio.Header(rate, channels, bits, encoding, *header);
    unused Cli.WriteAll(output, TextView(header[:]));
    if !Audio.Stream(input, output) {
        problem := Io.Error();
        unused Cli.WriteAll(2, "raw2iaf: data copy error: ");
        unused Cli.WriteAll(2, problem);
        unused Cli.WriteAll(2, "\n");
    }
    return 0;
}
