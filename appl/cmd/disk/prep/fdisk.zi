// disk/fdisk [-abfprvw] [-s sectorsize] /dev/sdC0/data:
// edit DOS / MBR disk partition tables.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";
using Arg :: #import "zx_arg";
using Lines :: #import "zx_lines";
using Disks :: #import "disks";
using Calc :: #import "calc";
using Pedit :: #import "pedit";

USAGE :: "usage: disk/fdisk [-abfprvw] [-s sectorsize] /dev/sdC0/data\n";

TYPE_EMPTY :: 0x00;
TYPE_EXTENDED :: 0x05;
TYPE_EXTHUGE :: 0x0F;
TYPE_LINUXEXT :: 0x85;
TYPE_DMDDO :: 0x54;
TYPE_PLAN9 :: 0x39;
TABLE_SIZE :: 64;

KB :: 1024;
MB :: 1048576;
GB :: 1073741824;

TypeDesc :: (pt: u8) -> (desc: string, name: string) {
    if pt == 0x00 { return "EMPTY", "" }
    if pt == 0x01 { return "FAT12", "dos" }
    if pt == 0x04 { return "FAT16", "dos" }
    if pt == 0x05 { return "EXTENDED", "" }
    if pt == 0x06 { return "FATHUGE", "dos" }
    if pt == 0x07 { return "HPFS", "ntfs" }
    if pt == 0x0B { return "FAT32", "dos" }
    if pt == 0x0C { return "FAT32LBA", "dos" }
    if pt == 0x0F { return "EXTHUGE", "" }
    if pt == 0x39 { return "PLAN9", "plan9" }
    if pt == 0x82 { return "LINUXSWAP", "linuxswap" }
    if pt == 0x83 { return "LINUX", "linux" }
    if pt == 0x85 { return "LINUXEXTENDED", "" }
    if pt == 0xA5 { return "BSD386", "bsd386" }
    if pt == 0xFF { return "BB", "bb" }
    return "", "";
}

LookupType :: (desc_upper: string) -> (pt: u8, ok: bool) {
    for code: 0..255 {
        d, _ := TypeDesc(cast(u8)code);
        if d != "" && d == desc_upper { return cast(u8)code, true }
    }
    return 0, false;
}

ParseInt :: (s: string) -> s64 {
    v: s64 = 0;
    for i: 0..s.count - 1 {
        c := s[i];
        if c < #char "0" || c > #char "9" { break }
        v = v * 10 + cast(s64)(c - #char "0");
    }
    return v;
}

OkFdiskName :: (name: string) -> bool {
    if name.count < 2 { return false }
    if name[0] != #char "p" && name[0] != #char "s" { return false }
    for i: 1..name.count - 1 {
        if name[i] < #char "0" || name[i] > #char "9" { return false }
    }
    return true;
}

GetTable :: (d: *Disks.Disk, sec: s64, require_mbr: bool, table: []u8) -> bool {
    a := sec * d.secsize + Disks.TOFFSET;
    if Io.SeekFile(d.fd, a, 0) != a { return false }
    if Disks.ReadN(d.fd, table) != table.count { return false }
    if require_mbr && (table[TABLE_SIZE] != Disks.MAGIC0 || table[TABLE_SIZE + 1] != Disks.MAGIC1) {
        return false;
    }
    return true;
}

PutTable :: (d: *Disks.Disk, sec: s64, table: []u8) -> bool {
    a := sec * d.secsize + Disks.TOFFSET;
    if Io.SeekFile(d.wfd, a, 0) != a { return false }
    return Io.WriteBytes(d.wfd, TextView(table)) == cast(s32)table.count;
}

ReadDosParts :: (edit: *Pedit.Edit, mbroffset: s64, sec2cyl: s64, lba: s64, xbase_in: s64, partgen: *s32) -> bool {
    xbase := ifx xbase_in == 0 then lba else xbase_in;
    table: [66]u8;
    if !GetTable(*edit.disk, mbroffset + lba, lba == 0, table[:]) { return false }
    err: Text;
    for idx: 0..3 {
        dp := Disks.ExtractPCpart(table[idx * 16:(idx + 1) * 16]);
        if dp.ptype == TYPE_EMPTY { continue }
        if dp.ptype == TYPE_EXTENDED || dp.ptype == TYPE_EXTHUGE || dp.ptype == TYPE_LINUXEXT {
            unused ReadDosParts(edit, mbroffset, sec2cyl, xbase + dp.offset, xbase, partgen);
            continue;
        }
        <<partgen += 1;
        p: Pedit.Part;
        ch: u8 = ifx lba == 0 then #char "p" else #char "s";
        VecPush(p.name.bytes, ch);
        BuilderPrint(*p.name.bytes, "%", <<partgen);
        p.primary = lba == 0;
        p.active = dp.active;
        p.ptype = dp.ptype;
        p.lba = lba + dp.offset;
        p.size = dp.size;
        p.start = p.lba / sec2cyl;
        p.end = (p.lba + p.size) / sec2cyl;
        p.ctlstart = p.lba;
        p.ctlend = p.lba + p.size;
        unused Pedit.AddPart(edit, p, *err);
    }
    return true;
}

AssignCtlNames :: (edit: *Pedit.Edit) {
    used: Vec(Text);
    for i: 0..edit.parts.count - 1 {
        _, vname := TypeDesc(edit.parts[i].ptype);
        VecClear(edit.parts[i].ctlname.bytes);
        if vname == "" { continue }
        sep := ifx vname[vname.count - 1] >= #char "0" && vname[vname.count - 1] <= #char "9" then "." else "";
        n: s32 = 0;
        cand: Text;
        BuilderAppend(cand.bytes, vname);
        while true {
            dup := false;
            for k: 0..used.count - 1 {
                if TextView(used[k]) == TextView(cand) { dup = true; break }
            }
            if !dup { break }
            n += 1;
            VecClear(cand.bytes);
            BuilderAppend(cand.bytes, vname);
            BuilderAppend(cand.bytes, sep);
            BuilderPrint(*cand.bytes, "%", n);
        }
        BuilderAppend(edit.parts[i].ctlname.bytes, TextView(cand));
        VecPush(used, cand);
    }
}

WriteDosParts :: (edit: *Pedit.Edit, mbroffset: s64, sec2cyl: s64) -> string {
    if edit.disk.rdonly { return "read only" }
    table: [66]u8;
    unused GetTable(*edit.disk, mbroffset, false, table[:]);
    for i: 0..TABLE_SIZE - 1 { table[i] = 0 }
    tp: s64 = 0;
    for i: 0..edit.parts.count - 1 {
        if tp >= TABLE_SIZE { break }
        if !edit.parts[i].primary { continue }
        s := ifx edit.parts[i].start == 0 then edit.disk.s else edit.parts[i].start * sec2cyl;
        end_lba := edit.parts[i].end * sec2cyl;
        pc := Disks.PCpart.{
            active = edit.parts[i].active,
            ptype = edit.parts[i].ptype,
            base = 0,
            offset = s,
            size = end_lba - s,
        };
        Disks.EncodePCpart(pc, *edit.disk, table[tp:tp + 16]);
        tp += 16;
    }
    table[TABLE_SIZE] = Disks.MAGIC0;
    table[TABLE_SIZE + 1] = Disks.MAGIC1;
    if !PutTable(*edit.disk, mbroffset, table[:]) { return "write error" }
    for i: 0..edit.parts.count - 1 { edit.parts[i].changed = false }
    edit.changed = false;
    return "";
}

PrintSum :: (edit: *Pedit.Edit, sec2cyl: s64, has_part: bool, idx: s64, a: s64, b: s64) {
    c0: u8 = #char " ";
    c1: u8 = #char " ";
    name := "empty";
    ty := "";
    if has_part {
        if edit.parts[idx].changed { c0 = #char "'" }
        if (edit.parts[idx].active & Disks.ACTIVE) != 0 { c1 = #char "*" }
        name = TextView(edit.parts[idx].name);
        desc, _ := TypeDesc(edit.parts[idx].ptype);
        ty = desc;
    }
    sz := (b - a) * edit.disk.secsize * sec2cyl;
    suf := "B";
    div: s64 = 1;
    if sz >= GB { suf = "GB"; div = GB }
    else if sz >= MB { suf = "MB"; div = MB }
    else if sz >= KB { suf = "KB"; div = KB }

    line: Vec(u8);
    VecPush(line, c0);
    VecPush(line, c1);
    VecPush(line, #char " ");
    Pedit.AppendRightPad(*line, name, 12);
    VecPush(line, #char " ");
    Pedit.AppendLeftPad(*line, a, edit.disk.width);
    VecPush(line, #char " ");
    Pedit.AppendRightPadNum(*line, b, edit.disk.width);
    if div == 1 {
        BuilderPrint(*line, " (% cylinders, % %)", b - a, sz, suf);
    } else {
        frac := ((sz % div) * 100) / div;
        BuilderPrint(*line, " (% cylinders, %.", b - a, sz / div);
        if frac < 10 { VecPush(line, #char "0") }
        BuilderPrint(*line, "% %)", frac, suf);
    }
    if has_part {
        if ty != "" {
            BuilderPrint(*line, " %", ty);
        } else {
            BuilderPrint(*line, " type %", edit.parts[idx].ptype);
        }
    }
    VecPush(line, #char "\n");
    unused Cli.WriteAll(1, BuilderFinish(line));
}

PrintTable :: (edit: *Pedit.Edit, sec2cyl: s64) {
    lastend: s64 = 0;
    for i: 0..edit.parts.count - 1 {
        if lastend < edit.parts[i].start {
            PrintSum(edit, sec2cyl, false, 0, lastend, edit.parts[i].start);
        }
        PrintSum(edit, sec2cyl, true, i, edit.parts[i].start, edit.parts[i].end);
        lastend = edit.parts[i].end;
    }
    if lastend < edit.end {
        PrintSum(edit, sec2cyl, false, 0, lastend, edit.end);
    }
}

AutoPart :: (edit: *Pedit.Edit, sec2cyl: s64) {
    for i: 0..edit.parts.count - 1 {
        if edit.parts[i].ptype == TYPE_PLAN9 { return }
    }
    start: s64 = 0;
    bigsize: s64 = 0;
    bigstart: s64 = 0;
    for i: 0..edit.parts.count - 1 {
        if edit.parts[i].start > start && edit.parts[i].start - start > bigsize {
            bigsize = edit.parts[i].start - start;
            bigstart = start;
        }
        start = edit.parts[i].end;
    }
    if edit.end - start > bigsize {
        bigsize = edit.end - start;
        bigstart = start;
    }
    if bigsize < 1 {
        unused Cli.WriteAll(2, "couldn't find space or partition slot for plan 9 partition\n");
        return;
    }
    active: u8 = Disks.ACTIVE;
    for i: 0..edit.parts.count - 1 {
        if edit.parts[i].primary && (edit.parts[i].active & Disks.ACTIVE) != 0 { active = 0 }
    }
    lba := bigstart * sec2cyl;
    sz := bigsize * sec2cyl;
    if lba == 0 {
        lba += edit.disk.s;
        sz -= edit.disk.s;
    }
    p: Pedit.Part;
    BuilderPrint(*p.name.bytes, "p%", edit.parts.count + 1);
    p.primary = true;
    p.active = active;
    p.ptype = TYPE_PLAN9;
    p.lba = lba;
    p.size = sz;
    p.start = bigstart;
    p.end = bigstart + bigsize;
    p.ctlstart = lba;
    p.ctlend = lba + sz;
    p.changed = true;
    err: Text;
    unused Pedit.AddPart(edit, p, *err);
}

main :: () -> s32 {
    blank := false;
    dowrite := false;
    file := false;
    rdonly := false;
    doauto := false;
    printflag := false;
    secsize: s64 = 0;

    scan: Arg.Scan;
    letter := Arg.Option(*scan);
    while letter != 0 {
        if letter == #char "a" { doauto = true }
        else if letter == #char "b" { blank = true }
        else if letter == #char "f" { file = true }
        else if letter == #char "p" { printflag = true }
        else if letter == #char "r" { rdonly = true }
        else if letter == #char "v" { }
        else if letter == #char "w" { dowrite = true }
        else if letter == #char "s" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            secsize = ParseInt(val);
        } else {
            return Cli.Usage(USAGE);
        }
        letter = Arg.Option(*scan);
    }

    if Args.OperandCount() - scan.next != 1 { return Cli.Usage(USAGE) }
    diskpath := Args.Operand(scan.next);

    edit: Pedit.Edit;
    edit.unit = "cylinder";
    mode: s32 = ifx rdonly then 0 else 2;
    if !Disks.Open(*edit.disk, diskpath, mode, file) {
        msg: Vec(u8);
        BuilderPrint(*msg, "cannot open disk: %\n", Io.LastError());
        unused Cli.WriteAll(2, BuilderFinish(msg));
        unused Args.SetFailure("opendisk");
        return 1;
    }
    if secsize != 0 {
        edit.disk.secsize = secsize;
        edit.disk.secs = edit.disk.size / secsize;
    }
    sec2cyl := edit.disk.h * edit.disk.s;
    if sec2cyl <= 0 { sec2cyl = 1 }
    edit.end = edit.disk.secs / sec2cyl;

    mbr_tab: [66]u8;
    if !GetTable(*edit.disk, 0, true, mbr_tab[:]) {
        unused Cli.WriteAll(2, "fdisk: did not find master boot record\n");
        Disks.Close(*edit.disk);
        unused Args.SetFailure("error");
        return 1;
    }
    mbroffset: s64 = 0;
    for idx: 0..3 {
        dp := Disks.ExtractPCpart(mbr_tab[idx * 16:(idx + 1) * 16]);
        if dp.ptype == TYPE_DMDDO { mbroffset = edit.disk.s }
    }

    partgen: s32 = 0;
    if blank {
        edit.changed = true;
    } else {
        unused ReadDosParts(*edit, mbroffset, sec2cyl, 0, 0, *partgen);
    }
    if doauto { AutoPart(*edit, sec2cyl) }

    if dowrite {
        werr := WriteDosParts(*edit, mbroffset, sec2cyl);
        if werr != "" {
            emsg: Vec(u8);
            BuilderPrint(*emsg, "?%\n", werr);
            unused Cli.WriteAll(2, BuilderFinish(emsg));
        }
    }
    if printflag {
        AssignCtlNames(*edit);
        Pedit.PrintCtl(*edit, 1);
    }
    if dowrite || printflag {
        Disks.Close(*edit.disk);
        return 0;
    }

    cmsg: Vec(u8);
    BuilderPrint(*cmsg, "cylinder = % bytes\n", sec2cyl * edit.disk.secsize);
    unused Cli.WriteAll(2, BuilderFinish(cmsg));
    PrintTable(*edit, sec2cyl);

    reader: Lines.LineReader;
    reader.handle = 0;
    line: Vec(u8);
    toks: Vec(Text);
    while true {
        unused Cli.WriteAll(2, ">>> ");
        if !Lines.ReadLine(*reader, *line) {
            if edit.changed { unused Cli.WriteAll(2, "?warning: changes not written\n") }
            break;
        }
        Pedit.Tokenize(TextView(line[:]), *toks);
        if toks.count == 0 { continue }
        first := TextView(toks[0]);
        if first.count != 1 { unused Cli.WriteAll(2, "?\n"); continue }
        c := first[0];
        if c == #char "p" {
            PrintTable(*edit, sec2cyl);
        } else if c == #char "P" {
            AssignCtlNames(*edit);
            Pedit.PrintCtl(*edit, 1);
        } else if c == #char "w" {
            werr := WriteDosParts(*edit, mbroffset, sec2cyl);
            if werr != "" {
                emsg: Vec(u8);
                BuilderPrint(*emsg, "?%\n", werr);
                unused Cli.WriteAll(2, BuilderFinish(emsg));
            }
        } else if c == #char "q" {
            if edit.changed && (!edit.warned || edit.lastcmd != #char "q") {
                edit.warned = true;
                unused Cli.WriteAll(2, "?changes unwritten\n");
            } else {
                break;
            }
        } else if c == #char "d" && toks.count == 2 {
            idx := Pedit.FindPartIndex(*edit, TextView(toks[1]));
            if idx < 0 { unused Cli.WriteAll(2, "?no such partition\n") }
            else { Pedit.DelPartAt(*edit, idx) }
        } else if c == #char "A" && toks.count == 2 {
            name := TextView(toks[1]);
            if name.count == 0 || name[0] != #char "p" {
                unused Cli.WriteAll(2, "?cannot set secondary partition active\n");
            } else {
                idx := Pedit.FindPartIndex(*edit, name);
                if idx < 0 {
                    unused Cli.WriteAll(2, "?unknown partition\n");
                } else {
                    for i: 0..edit.parts.count - 1 {
                        if (edit.parts[i].active & Disks.ACTIVE) != 0 {
                            edit.parts[i].active &= ~cast(u8)Disks.ACTIVE;
                            edit.parts[i].changed = true;
                            edit.changed = true;
                        }
                    }
                    edit.parts[idx].active |= Disks.ACTIVE;
                    edit.parts[idx].changed = true;
                    edit.changed = true;
                }
            }
        } else if c == #char "t" && toks.count >= 3 {
            idx := Pedit.FindPartIndex(*edit, TextView(toks[1]));
            if idx < 0 {
                unused Cli.WriteAll(2, "?unknown partition\n");
            } else {
                up: Vec(u8);
                tname := TextView(toks[2]);
                for i: 0..tname.count - 1 {
                    ch := tname[i];
                    if ch >= #char "a" && ch <= #char "z" { ch -= 32 }
                    VecPush(up, ch);
                }
                pt, ok := LookupType(BuilderFinish(up));
                if ok && edit.parts[idx].ptype != pt {
                    edit.parts[idx].ptype = pt;
                    edit.parts[idx].changed = true;
                    edit.changed = true;
                }
            }
        } else {
            unused Cli.WriteAll(2, "?unknown command\n");
        }
        edit.lastcmd = c;
    }
    Disks.Close(*edit.disk);
    return 0;
}
