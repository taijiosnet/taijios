// disk/ftl flashsize secsize kfsfile flashfile: build and verify an FTL flash image,
// matching appl/cmd/disk/ftl.b.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";

BSHIFT :: 9;
BSIZE :: 512;
BAM_OFFSET :: 0x100;
USABLE_PCT :: 95;
ERASE_HDR_LEN :: 64;

O_LINKTUPLE :: 0;
O_ORGTUPLE :: 5;
O_NXFER :: 15;
O_NERASE :: 16;
O_ID :: 20;
O_BSHIFT :: 22;
O_ESHIFT :: 23;
O_PSTART :: 24;
O_NUNITS :: 26;
O_PSIZE :: 28;
O_VBMBASE :: 32;
O_NVBM :: 36;
O_FLAGS :: 38;
O_CODE :: 39;
O_SERIAL :: 40;
O_ALTOFFSET :: 44;
O_BAMOFFSET :: 48;

XFER_ID :: 0xFFFF;
XFER_BUSY :: 0x7FFF;

BFREE :: 0xFFFFFFFF;
BWRITING :: 0xFFFFFFFE;
BDELETED :: 0;

BLOCK_TYPE_MASK :: 0x7F;
CONTROL_BLOCK :: 0x30;
DATA_BLOCK :: 0x40;
REPLACE_PAGE :: 0x60;
BAD_BLOCK :: 0x70;

Terase :: struct {
    valid: bool;
    x: s64;
    id: u32;
    offset: s64;
    bamoffset: s64;
    nbam: s64;
    bam: Vec(u8);
    bamx: s64;
    nfree: s64;
    nused: s64;
    ndead: s64;
    nbad: s64;
    nerase: u32;
}

Ftl :: struct {
    flashsize: s64;
    secsize: s64;
    flashm: Vec(u8);
    base: s64;
    size: s64;
    segsize: s64;
    eshift: s64;
    bshift: s64;
    bsize: s64;
    nunit: s64;
    units: Vec(Terase);
    lastx: s64;
    xfer: s64;
    nfree: s64;
    nblock: s64;
    rwlimit: s64;
    vbm: Vec(u32);
    fstart: s64;
}

Get2 :: (b: []u8, off: s64) -> u32 {
    return (cast(u32)b[off + 1] << 8) | cast(u32)b[off];
}

Get4 :: (b: []u8, off: s64) -> u32 {
    return (cast(u32)b[off + 3] << 24) | (cast(u32)b[off + 2] << 16) |
        (cast(u32)b[off + 1] << 8) | cast(u32)b[off];
}

Put2 :: (b: []u8, off: s64, v: u32) {
    b[off] = cast(u8)(v & 0xFF);
    b[off + 1] = cast(u8)((v >> 8) & 0xFF);
}

Put4 :: (b: []u8, off: s64, v: u32) {
    b[off] = cast(u8)(v & 0xFF);
    b[off + 1] = cast(u8)((v >> 8) & 0xFF);
    b[off + 2] = cast(u8)((v >> 16) & 0xFF);
    b[off + 3] = cast(u8)((v >> 24) & 0xFF);
}

MkBam :: (b: s64, t: u32) -> u32 {
    return (cast(u32)b << BSHIFT) | t;
}

ParseNum :: (s: string) -> (val: s64, ok: bool) {
    i: s64 = 0;
    while i < s.count && (s[i] == #char " " || s[i] == #char "\t") { i += 1 }
    if i >= s.count { return 0, false }
    neg := false;
    if s[i] == #char "-" { neg = true; i += 1 }
    else if s[i] == #char "+" { i += 1 }
    base: s64 = 10;
    if s.count - i >= 2 && s[i] == #char "0" && s[i + 1] == #char "x" {
        base = 16;
        i += 2;
    } else if s.count - i >= 1 && s[i] == #char "0" {
        base = 8;
        i += 1;
    }
    m: s64 = 0;
    while i < s.count {
        c := s[i];
        v: s64 = -1;
        if c >= #char "0" && c <= #char "9" { v = cast(s64)(c - #char "0") }
        else if c >= #char "a" && c <= #char "z" { v = cast(s64)(c - #char "a") + 10 }
        else if c >= #char "A" && c <= #char "Z" { v = cast(s64)(c - #char "A") + 10 }
        if v < 0 || v >= base { return 0, false }
        m = m * base + v;
        i += 1;
    }
    return ifx neg then -m else m, true;
}

EraseFlash :: (ftl: *Ftl, offset: s64) {
    base := ftl.base + offset;
    for i: 0..ftl.secsize - 1 { ftl.flashm[base + i] = 0xFF }
}

PutFlash :: (ftl: *Ftl, offset: s64, src: []u8) {
    base := ftl.base + offset;
    for i: 0..src.count - 1 { ftl.flashm[base + i] = src[i] }
}

GetFlash :: (ftl: *Ftl, dst: []u8, offset: s64) {
    base := ftl.base + offset;
    for i: 0..dst.count - 1 { dst[i] = ftl.flashm[base + i] }
}

EraseInit :: (ftl: *Ftl, offset: s64, id: u32, nerase: u32) -> bool {
    nov := ((ftl.segsize / BSIZE) * 4 + BAM_OFFSET + BSIZE - 1) / BSIZE;
    if nov * BSIZE >= ftl.segsize {
        unused Cli.WriteAll(2, "ftl -- too small for files");
        return false;
    }
    EraseFlash(ftl, offset);
    m: [64]u8;
    for i: 0..63 { m[i] = 0xFF }
    m[O_LINKTUPLE] = 0x13;
    m[O_LINKTUPLE + 1] = 0x03;
    cis := "CIS";
    for i: 0..2 { m[O_LINKTUPLE + 2 + i] = cis[i] }
    m[O_ORGTUPLE] = 0x46;
    m[O_ORGTUPLE + 1] = 0x57;
    m[O_ORGTUPLE + 2] = 0x00;
    org := "FTL100";
    for i: 0..5 { m[O_ORGTUPLE + 3 + i] = org[i] }
    m[O_ORGTUPLE + 9] = 0;
    m[O_NXFER] = 1;
    Put4(m[:], O_NERASE, nerase);
    Put2(m[:], O_ID, id);
    m[O_BSHIFT] = cast(u8)ftl.bshift;
    m[O_ESHIFT] = cast(u8)ftl.eshift;
    Put2(m[:], O_PSTART, 0);
    Put2(m[:], O_NUNITS, cast(u32)ftl.nunit);
    Put4(m[:], O_PSIZE, cast(u32)(ftl.size - nov * BSIZE));
    Put4(m[:], O_VBMBASE, 0xFFFFFFFF);
    Put2(m[:], O_NVBM, 0);
    m[O_FLAGS] = 0;
    m[O_CODE] = 0xFF;
    ser := "Inf1";
    for i: 0..3 { m[O_SERIAL + i] = ser[i] }
    Put4(m[:], O_ALTOFFSET, 0);
    Put4(m[:], O_BAMOFFSET, BAM_OFFSET);
    PutFlash(ftl, offset, m[:]);
    if id == XFER_ID { return true }

    bam_bytes := nov * 4;
    bam: Vec(u8);
    for i: 0..bam_bytes - 1 { VecPush(bam, 0) }
    i: s64 = 0;
    while i < bam_bytes {
        Put4(bam[:], i, CONTROL_BLOCK);
        i += 4;
    }
    PutFlash(ftl, offset + BAM_OFFSET, bam[:]);
    return true;
}

EraseLoad :: (ftl: *Ftl, x: s64, offset: s64, e: *Terase) -> bool {
    m: [64]u8;
    GetFlash(ftl, m[:], offset);
    if TextView(m[O_ORGTUPLE + 3:O_ORGTUPLE + 9]) != "FTL100" || m[O_ORGTUPLE + 9] != 0 ||
        TextView(m[O_SERIAL:O_SERIAL + 4]) != "Inf1" {
        return false;
    }
    e.valid = true;
    e.x = x;
    e.id = Get2(m[:], O_ID);
    e.offset = offset;
    e.bamoffset = cast(s64)Get4(m[:], O_BAMOFFSET);
    e.nerase = Get4(m[:], O_NERASE);
    e.bamx = 0;
    e.nfree = 0;
    e.nused = 0;
    e.ndead = 0;
    e.nbad = 0;
    if e.bamoffset != BAM_OFFSET { return false }
    e.bamoffset += offset;
    if e.id == XFER_ID || e.id == XFER_BUSY {
        e.nbam = 0;
        VecClear(e.bam);
        return true;
    }
    nbam := ftl.segsize / BSIZE;
    e.nbam = nbam;
    VecClear(e.bam);
    for i: 0..nbam * 4 - 1 { VecPush(e.bam, 0) }
    GetFlash(ftl, e.bam[:], e.bamoffset);
    for i: 0..nbam - 1 {
        v := Get4(e.bam[:], i * 4);
        if v == BWRITING || v == BDELETED {
            e.ndead += 1;
        } else if v == BFREE {
            if e.bamx == 0 { e.bamx = i }
            e.nfree += 1;
            ftl.nfree += 1;
        } else {
            bt := v & BLOCK_TYPE_MASK;
            if bt == DATA_BLOCK && (v & 0x80000000) == 0 {
                bno := cast(s64)((v & ~cast(u32)BLOCK_TYPE_MASK) >> BSHIFT);
                if i >= ftl.fstart && bno < ftl.nblock {
                    ftl.vbm[bno] = (cast(u32)e.x << 16) | cast(u32)i;
                    e.nused += 1;
                } else {
                    e.nbad += 1;
                }
            } else if bt == BAD_BLOCK {
                e.nbad += 1;
            }
        }
    }
    return true;
}

PutBam :: (ftl: *Ftl, ux: s64, n: s64, entry: u32) {
    off := n * 4;
    ftl.units[ux].bam[off] = cast(u8)(entry & 0xFF);
    ftl.units[ux].bam[off + 1] = cast(u8)((entry >> 8) & 0xFF);
    ftl.units[ux].bam[off + 2] = cast(u8)((entry >> 16) & 0xFF);
    ftl.units[ux].bam[off + 3] = cast(u8)((entry >> 24) & 0xFF);
    b: [4]u8;
    Put4(b[:], 0, entry);
    PutFlash(ftl, ftl.units[ux].bamoffset + off, b[:]);
}

GetBamEntry :: (u: *Terase, n: s64) -> u32 {
    off := n * 4;
    return (cast(u32)u.bam[off + 3] << 24) | (cast(u32)u.bam[off + 2] << 16) |
        (cast(u32)u.bam[off + 1] << 8) | cast(u32)u.bam[off];
}

AllocBlk :: (ftl: *Ftl) -> u32 {
    i := ftl.lastx;
    while true {
        if ftl.units[i].valid && ftl.units[i].id != XFER_ID && ftl.units[i].nfree > 0 {
            ftl.lastx = i;
            j := ftl.units[i].bamx;
            while j < ftl.units[i].nbam {
                if GetBamEntry(*ftl.units[i], j) == BFREE {
                    PutBam(ftl, i, j, BWRITING);
                    ftl.nfree -= 1;
                    ftl.units[i].nfree -= 1;
                    ftl.units[i].bamx = j + 1;
                    return (cast(u32)ftl.units[i].x << 16) | cast(u32)j;
                }
                j += 1;
            }
            ftl.units[i].nfree = 0;
        }
        i += 1;
        if i >= ftl.nunit { i = 0 }
        if i == ftl.lastx { break }
    }
    return 0;
}

MapBlk :: (ftl: *Ftl, bno: s64) -> (ok: bool, ux: s64, pb: s64) {
    if bno < ftl.nblock {
        v := ftl.vbm[bno];
        if v == 0 || v == 0xFFFFFFFF { return false, 0, 0 }
        x := cast(s64)(v >> 16);
        if x >= ftl.nunit || x == ftl.xfer || !ftl.units[x].valid { return false, 0, 0 }
        return true, x, cast(s64)(v & 0xFFFF);
    }
    return false, 0, 0;
}

FtlWrite :: (ftl: *Ftl, buf: []u8, offset_in: s64) -> s64 {
    if buf.count <= 0 { return 0 }
    if (buf.count % BSIZE) != 0 || (offset_in % BSIZE) != 0 {
        unused Cli.WriteAll(2, "ftl: bad write\n");
        return -1;
    }
    nb := buf.count / BSIZE;
    offset := offset_in / BSIZE;
    if offset >= ftl.rwlimit { return 0 }
    if offset + nb > ftl.rwlimit { nb = ftl.rwlimit - offset }
    a: s64 = 0;
    for n: 0..nb - 1 {
        v := AllocBlk(ftl);
        if v == 0 {
            unused Cli.WriteAll(2, "ftl: flash memory full\n");
            return -1;
        }
        has_old, oux, ob := MapBlk(ftl, offset + n);
        ux := cast(s64)(v >> 16);
        pb := cast(s64)(v & 0xFFFF);
        PutFlash(ftl, ftl.units[ux].offset + pb * BSIZE, buf[a:a + BSIZE]);
        PutBam(ftl, ux, pb, MkBam(offset + n, DATA_BLOCK));
        ftl.vbm[offset + n] = (cast(u32)ftl.units[ux].x << 16) | cast(u32)pb;
        if has_old {
            PutBam(ftl, oux, ob, BDELETED);
            ftl.units[oux].ndead += 1;
        }
        a += BSIZE;
    }
    return a;
}

FtlRead :: (ftl: *Ftl, buf: []u8, offset_in: s64) -> s64 {
    if buf.count <= 0 || (buf.count % BSIZE) != 0 || (offset_in % BSIZE) != 0 {
        unused Cli.WriteAll(2, "ftl: bad read\n");
        return -1;
    }
    nb := buf.count / BSIZE;
    offset := offset_in / BSIZE;
    if offset >= ftl.rwlimit { return 0 }
    if offset + nb > ftl.rwlimit { nb = ftl.rwlimit - offset }
    a: s64 = 0;
    for n: 0..nb - 1 {
        ok, ux, pb := MapBlk(ftl, offset + n);
        if ok {
            GetFlash(ftl, buf[a:a + BSIZE], ftl.units[ux].offset + pb * BSIZE);
        } else {
            for k: 0..BSIZE - 1 { buf[a + k] = 0 }
        }
        a += BSIZE;
    }
    return a;
}

AppendHex :: (out: *Vec(u8), v: u64) {
    digits := "0123456789abcdef";
    if v == 0 { VecPush(<<out, #char "0"); return }
    tmp: [16]u8;
    n := 0;
    x := v;
    while x > 0 {
        tmp[n] = digits[x & 0xF];
        x >>= 4;
        n += 1;
    }
    for i: 0..n - 1 { VecPush(<<out, tmp[n - 1 - i]) }
}

main :: () -> s32 {
    if Args.OperandCount() != 4 {
        unused Cli.WriteAll(2, "usage: ftl flashsize secsize kfsfile flashfile\n");
        return 0;
    }
    fsize, fok := ParseNum(Args.Operand(0));
    ssize, sok := ParseNum(Args.Operand(1));
    if !fok || !sok {
        unused Cli.WriteAll(2, "ftl: bad character in number\n");
        return 0;
    }
    inpath := Args.Operand(2);
    outpath := Args.Operand(3);
    fd1 := Io.OpenFile(inpath, 0);
    fd2 := Io.CreateFile(outpath, 1, 0x1A4);
    if fd1 < 0 || fd2 < 0 {
        if fd1 >= 0 { unused Io.CloseFile(fd1) }
        if fd2 >= 0 { unused Io.CloseFile(fd2) }
        unused Cli.WriteAll(2, "bad io files\n");
        return 0;
    }
    if ssize <= 0 || ssize > fsize || (ssize & (ssize - 1)) != 0 || fsize <= 0 || (fsize & (ssize - 1)) != 0 {
        unused Io.CloseFile(fd1);
        unused Io.CloseFile(fd2);
        unused Cli.WriteAll(2, "ftl: bad sizes\n");
        return 0;
    }
    eshift: s64 = 0;
    while eshift < 32 && (cast(s64)1 << eshift) != ssize { eshift += 1 }

    ftl: Ftl;
    ftl.flashsize = fsize;
    ftl.secsize = ssize;
    ftl.base = 0;
    ftl.size = fsize;
    ftl.bshift = BSHIFT;
    ftl.bsize = BSIZE;
    ftl.eshift = eshift;
    ftl.segsize = ssize;
    ftl.nunit = fsize >> eshift;
    nov := ((ftl.segsize / BSIZE) * 4 + BAM_OFFSET + BSIZE - 1) / BSIZE;
    ftl.fstart = nov;
    segblocks := ftl.segsize / BSIZE - nov;
    ftl.nblock = ftl.nunit * segblocks;
    if ftl.nblock >= 0x10000 { ftl.nblock = 0x10000 }

    for i: 0..fsize - 1 { VecPush(ftl.flashm, 0) }
    for i: 0..ftl.nblock - 1 { VecPush(ftl.vbm, 0) }
    for i: 0..ftl.nunit - 1 {
        u: Terase;
        VecPush(ftl.units, u);
    }

    for i: 0..ftl.nunit - 2 {
        if !EraseInit(*ftl, i * ftl.segsize, cast(u32)i, 1) {
            unused Io.CloseFile(fd1);
            unused Io.CloseFile(fd2);
            return 0;
        }
    }
    if !EraseInit(*ftl, (ftl.nunit - 1) * ftl.segsize, XFER_ID, 1) {
        unused Io.CloseFile(fd1);
        unused Io.CloseFile(fd2);
        return 0;
    }

    ftl.xfer = -1;
    for i: 0..ftl.nunit - 1 {
        if EraseLoad(*ftl, i, i * ftl.segsize, *ftl.units[i]) {
            if ftl.units[i].id == XFER_ID { ftl.xfer = i }
        }
    }
    if ftl.xfer >= 0 { ftl.nblock -= segblocks }
    if ftl.nblock >= 1000 {
        ftl.rwlimit = ftl.nblock - 100;
    } else {
        ftl.rwlimit = (ftl.nblock * USABLE_PCT) / 100;
    }

    buf: [8192]u8;
    offset: s64 = 0;
    while true {
        r := Io.ReadBytes(fd1, buf[:]);
        if r <= 0 { break }
        if FtlWrite(*ftl, buf[:r], offset) != cast(s64)r {
            unused Cli.WriteAll(2, "ftl: ftlwrite failed - input file too big\n");
            unused Io.CloseFile(fd1);
            unused Io.CloseFile(fd2);
            return 0;
        }
        offset += cast(s64)r;
    }
    // Write flashm in 8 KiB chunks
    wpos: s64 = 0;
    while wpos < ftl.flashm.count {
        m := ftl.flashm.count - wpos;
        if m > 8192 { m = 8192 }
        unused Io.WriteBytes(fd2, TextView(ftl.flashm[wpos:wpos + m]));
        wpos += m;
    }
    unused Io.CloseFile(fd1);
    unused Io.CloseFile(fd2);

    // Print ftlstat
    sline: Vec(u8);
    BuilderAppend(sline, "16r");
    AppendHex(*sline, cast(u64)(ftl.rwlimit * BSIZE));
    BuilderAppend(sline, ":16r");
    AppendHex(*sline, cast(u64)offset);
    BuilderAppend(sline, ":16r");
    AppendHex(*sline, cast(u64)fsize);
    BuilderPrint(*sline, "\n%:%:% in 512b blocks\n", ftl.rwlimit, offset >> BSHIFT, fsize >> BSHIFT);
    unused Cli.WriteAll(1, BuilderFinish(sline));

    // Verify by reading back and comparing against input file
    sz := offset;
    offset = 0;
    buf1: [8192]u8;
    fd1 = Io.OpenFile(inpath, 0);
    while fd1 >= 0 {
        r := Io.ReadBytes(fd1, buf1[:]);
        if r <= 0 { break }
        if FtlRead(*ftl, buf[:r], offset) != cast(s64)r {
            unused Cli.WriteAll(2, "ftl: ftlread failed\n");
            unused Io.CloseFile(fd1);
            return 0;
        }
        for i: 0..r - 1 {
            if buf[i] != buf1[i] {
                unused Cli.WriteAll(2, "ftl: bad read\n");
                unused Io.CloseFile(fd1);
                return 0;
            }
        }
        offset += cast(s64)r;
    }
    if fd1 >= 0 { unused Io.CloseFile(fd1) }
    if offset != sz { unused Cli.WriteAll(2, "ftl: bad final offset\n") }
    return 0;
}
