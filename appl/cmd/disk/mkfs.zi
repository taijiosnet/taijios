// disk/mkfs [-aprvxS] [-d root] [-n kfscmdname] [-s src-fs] [-u userfile]
// [-z n] [-G group] [-U user] proto ...: build a filesystem or archive from proto files.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Stat :: #import "taijios_stat";
using Cli :: #import "zx_cli";
using Arg :: #import "zx_arg";
using Quote :: #import "taijios_quote";

USAGE :: "usage: mkfs [-aprvxS] [-d root] [-n kfscmdname] [-s src-fs] [-u userfile] [-z n] [-G group] [-U user] proto ...\n";

FS_KFS :: 0;
FS_FS :: 1;
FS_ARCHIVE :: 2;

ProtoLine :: struct {
    indent: s32;
    lineno: s32;
    elem: Text;
    mode: u32;
    has_mode: bool;
    uid: Text;
    gid: Text;
    old: Text;
}

Ctx :: struct {
    fskind: s32;
    oldroot: string;
    newroot: string;
    usrid: string;
    grpid: string;
    user: Text;
    verb: bool;
    modes: bool;
    ream: bool;
    debug: bool;
    xflag: bool;
    setuid: bool;
    proto: string;
    lines: Vec(ProtoLine);
    cursor: s64;
    failed: bool;
}

Warn :: (ctx: *Ctx, lineno: s32, msg: string) {
    out: Vec(u8);
    BuilderPrint(*out, "mkfs: %:%: %\n", ctx.proto, lineno, msg);
    unused Cli.WriteAll(2, BuilderFinish(out));
}

AppendOctal :: (out: *Vec(u8), v_in: u32) {
    buf: [16]u8;
    n := 0;
    v := v_in;
    while true {
        buf[n] = #char "0" + cast(u8)(v & 7);
        n += 1;
        v >>= 3;
        if v == 0 { break }
    }
    for i: 0..n - 1 { VecPush(<<out, buf[n - 1 - i]) }
}

ReadSmallFile :: (path: string, out: *Text) -> bool {
    VecClear(out.bytes);
    fd := Io.OpenFile(path, 0);
    if fd < 0 { return false }
    buf: [256]u8;
    n := Io.ReadBytes(fd, buf[:]);
    unused Io.CloseFile(fd);
    if n <= 0 { return false }
    BuilderAppend(out.bytes, TextView(buf[:n]));
    return true;
}

ParseToken :: (s: string, pos: *s64, out: *Text) {
    VecClear(out.bytes);
    i := <<pos;
    while i < s.count && (s[i] == #char " " || s[i] == #char "\t") { i += 1 }
    quoted := false;
    while i < s.count && s[i] != #char "\n" && s[i] != #char "\r" {
        c := s[i];
        if !quoted && (c == #char " " || c == #char "\t") { break }
        if c == #char "'" {
            if i + 1 < s.count && s[i + 1] == #char "'" {
                VecPush(out.bytes, #char "'");
                i += 2;
                continue;
            }
            quoted = !quoted;
            i += 1;
            continue;
        }
        VecPush(out.bytes, c);
        i += 1;
    }
    <<pos = i;
    if out.bytes.count > 0 && out.bytes[0] == #char "$" {
        vname := TextView(out.bytes[1:]);
        envpath: Vec(u8);
        if vname == "user" {
            BuilderAppend(envpath, "/dev/user");
        } else {
            BuilderPrint(*envpath, "/env/%", vname);
        }
        val: Text;
        if ReadSmallFile(BuilderFinish(envpath), *val) {
            VecClear(out.bytes);
            BuilderAppend(out.bytes, TextView(val));
        }
    }
}

ParseMode :: (ctx: *Ctx, lineno: s32, s_in: string) -> (mode: u32, has_mode: bool) {
    if s_in.count == 0 || s_in == "-" { return 0, false }
    s := s_in;
    m: u32 = 0;
    if s.count > 0 && s[0] == #char "d" { m |= Stat.Directory; s = s[1:] }
    if s.count > 0 && s[0] == #char "a" { m |= Stat.AppendOnly; s = s[1:] }
    if s.count > 0 && s[0] == #char "l" { m |= Stat.Exclusive; s = s[1:] }
    if s.count < 3 {
        msg: Vec(u8);
        BuilderPrint(*msg, "bad mode specification %", s_in);
        Warn(ctx, lineno, BuilderFinish(msg));
        return 0, false;
    }
    v: u32 = 0;
    for i: 0..s.count - 1 {
        if s[i] < #char "0" || s[i] > #char "7" {
            msg: Vec(u8);
            BuilderPrint(*msg, "bad mode specification %", s_in);
            Warn(ctx, lineno, BuilderFinish(msg));
            return 0, false;
        }
        v = (v << 3) | cast(u32)(s[i] - #char "0");
    }
    return m | v, true;
}

LoadProto :: (ctx: *Ctx, text: string) {
    VecClear(ctx.lines);
    ctx.cursor = 0;
    pos: s64 = 0;
    lineno: s32 = 0;
    while pos < text.count {
        start := pos;
        while pos < text.count && text[pos] != #char "\n" { pos += 1 }
        end := pos;
        if pos < text.count { pos += 1 }
        lineno += 1;
        ind: s32 = 0;
        p := start;
        while p < end {
            if text[p] == #char " " { ind += 1; p += 1 }
            else if text[p] == #char "\t" { ind += 8; p += 1 }
            else { break }
        }
        if p >= end || text[p] == #char "\r" || text[p] == #char "#" { continue }
        line_str := text[p:end];
        cur: s64 = 0;
        pl: ProtoLine;
        pl.indent = ind;
        pl.lineno = lineno;
        ParseToken(line_str, *cur, *pl.elem);
        mstr: Text;
        ParseToken(line_str, *cur, *mstr);
        pm, ph := ParseMode(ctx, lineno, TextView(mstr));
        pl.mode = pm;
        pl.has_mode = ph;
        ParseToken(line_str, *cur, *pl.uid);
        if pl.uid.bytes.count == 0 { BuilderAppend(pl.uid.bytes, "-") }
        ParseToken(line_str, *cur, *pl.gid);
        if pl.gid.bytes.count == 0 { BuilderAppend(pl.gid.bytes, "-") }
        ParseToken(line_str, *cur, *pl.old);
        if TextView(pl.old) == "-" { VecClear(pl.old.bytes) }
        VecPush(ctx.lines, pl);
    }
}

EmitArch :: (newfile: string, mode: u32, uid: string, gid: string, mtime: s32, length: s64) {
    out: Vec(u8);
    Quote.Quote(*out, newfile);
    VecPush(out, #char " ");
    AppendOctal(*out, mode);
    VecPush(out, #char " ");
    Quote.Quote(*out, uid);
    VecPush(out, #char " ");
    Quote.Quote(*out, gid);
    BuilderPrint(*out, " % %\n", cast(u32)mtime, length);
    unused Cli.WriteAll(1, BuilderFinish(out));
}

CopyEntry :: (ctx: *Ctx, f_new: string, f_elem: string, oldfile: string, newfile: string,
              f_mode: u32, has_mode: bool, f_uid: string, f_gid: string, d: Stat.Info, permonly: bool, lineno: s32) -> bool {
    if ctx.xflag && ctx.fskind == FS_ARCHIVE {
        out: Vec(u8);
        Quote.Quote(*out, f_new);
        BuilderPrint(*out, "\t%\t%\n", d.modified, d.length);
        unused Cli.WriteAll(1, BuilderFinish(out));
        return (d.mode & Stat.Directory) != 0;
    }
    mode := d.mode;
    uid := d.owner;
    gid := d.group;
    if f_uid != "-" { uid = f_uid }
    if f_gid != "-" { gid = f_gid }
    if ctx.fskind == FS_FS && !ctx.setuid {
        uid = TextView(ctx.user);
        gid = TextView(ctx.user);
    }
    if ctx.usrid != "" { uid = ctx.usrid }
    if ctx.grpid != "" { gid = ctx.grpid }
    if has_mode {
        if permonly {
            mode = (mode & ~cast(u32)0x1B6) | (f_mode & 0x1B6);
        } else if (mode & Stat.Directory) != (f_mode & Stat.Directory) {
            msg: Vec(u8);
            BuilderPrint(*msg, "inconsistent mode for %", f_new);
            Warn(ctx, lineno, BuilderFinish(msg));
        } else {
            mode = f_mode;
        }
    }

    is_dir := (mode & Stat.Directory) != 0;
    if ctx.fskind == FS_ARCHIVE {
        EmitArch(newfile, mode, uid, gid, d.modified, d.length);
        if !is_dir {
            fd := Io.OpenFile(oldfile, 0);
            if fd < 0 {
                msg: Vec(u8);
                BuilderPrint(*msg, "can't open %: %", oldfile, Io.LastError());
                Warn(ctx, lineno, BuilderFinish(msg));
                return false;
            }
            buf: [8192]u8;
            while true {
                n := Io.ReadBytes(fd, buf[:]);
                if n <= 0 { break }
                unused Cli.WriteAll(1, TextView(buf[:n]));
            }
            unused Io.CloseFile(fd);
        }
        return is_dir;
    }

    // FS_FS or FS_KFS destination
    if is_dir {
        fd := Io.CreateFile(newfile, 0, cast(s32)mode);
        if fd >= 0 { unused Io.CloseFile(fd) }
        return true;
    }
    if ctx.verb {
        vmsg: Vec(u8);
        Quote.Quote(*vmsg, f_new);
        VecPush(vmsg, #char "\n");
        unused Cli.WriteAll(2, BuilderFinish(vmsg));
    }
    src := Io.OpenFile(oldfile, 0);
    if src < 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "can't open %: %", oldfile, Io.LastError());
        Warn(ctx, lineno, BuilderFinish(msg));
        return false;
    }
    dst := Io.CreateFile(newfile, 1, cast(s32)mode);
    if dst < 0 {
        unused Io.CloseFile(src);
        msg: Vec(u8);
        BuilderPrint(*msg, "can't create %: %", newfile, Io.LastError());
        Warn(ctx, lineno, BuilderFinish(msg));
        return false;
    }
    buf: [8192]u8;
    while true {
        n := Io.ReadBytes(src, buf[:]);
        if n <= 0 { break }
        unused Io.WriteBytes(dst, TextView(buf[:n]));
    }
    unused Io.CloseFile(src);
    unused Io.CloseFile(dst);
    return false;
}

WalkTree :: (ctx: *Ctx, parent_new: string, parent_old: string, mode: u32, has_mode: bool,
             uid: string, gid: string, rec: bool, filesonly: bool, lineno: s32) {
    fd := Io.OpenFile(parent_old, 0);
    if fd < 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "can't open %: %", parent_old, Io.LastError());
        Warn(ctx, lineno, BuilderFinish(msg));
        return;
    }
    dirbuf: [Stat.BufferSize]u8;
    entries: Vec(Stat.Info);
    names: Vec(Text);
    while true {
        n := Io.ReadBytes(fd, dirbuf[:]);
        if n <= 0 { break }
        off: s64 = 0;
        while off < cast(s64)n {
            info := Stat.Decode(dirbuf[off:n]);
            if info.size <= 0 { break }
            dup := false;
            for k: 0..names.count - 1 {
                if TextView(names[k]) == info.name { dup = true; break }
            }
            if !dup {
                nm: Text;
                BuilderAppend(nm.bytes, info.name);
                VecPush(names, nm);
                VecPush(entries, info);
            }
            off += info.size;
        }
    }
    unused Io.CloseFile(fd);

    for idx: 0..entries.count - 1 {
        d := entries[idx];
        ename := TextView(names[idx]);
        if filesonly && (d.mode & Stat.Directory) != 0 { continue }
        cnew: Vec(u8);
        BuilderPrint(*cnew, "%/%", parent_new, ename);
        cnew_s := BuilderFinish(cnew);
        of: Vec(u8);
        BuilderPrint(*of, "%/%", parent_old, ename);
        of_s := BuilderFinish(of);
        nf_s: Vec(u8);
        BuilderAppend(nf_s, ctx.newroot);
        BuilderAppend(nf_s, cnew_s);
        is_dir := CopyEntry(ctx, cnew_s, ename, of_s, BuilderFinish(nf_s), mode, has_mode, uid, gid, d, true, lineno);
        if is_dir && rec {
            WalkTree(ctx, cnew_s, of_s, mode, has_mode, uid, gid, rec, filesonly, lineno);
        }
    }
}

SkipSubtree :: (ctx: *Ctx, level: s32) {
    while ctx.cursor < ctx.lines.count && ctx.lines[ctx.cursor].indent > level {
        ctx.cursor += 1;
    }
}

ProcessLevel :: (ctx: *Ctx, parent_new: string, level: s32) {
    while ctx.cursor < ctx.lines.count {
        idx := ctx.cursor;
        if ctx.lines[idx].indent <= level { return }
        ctx.cursor += 1;
        elem := TextView(ctx.lines[idx].elem);
        if elem == "+" || elem == "*" || elem == "%" {
            rec := elem == "+";
            filesonly := elem == "%";
            of: Vec(u8);
            if ctx.lines[idx].old.bytes.count > 0 {
                os := TextView(ctx.lines[idx].old);
                if os[0] == #char "/" { BuilderAppend(of, ctx.oldroot) }
                BuilderAppend(of, os);
            } else {
                BuilderAppend(of, ctx.oldroot);
                BuilderAppend(of, parent_new);
            }
            WalkTree(ctx, parent_new, BuilderFinish(of), ctx.lines[idx].mode, ctx.lines[idx].has_mode,
                TextView(ctx.lines[idx].uid), TextView(ctx.lines[idx].gid), rec, filesonly, ctx.lines[idx].lineno);
            continue;
        }
        cnew: Vec(u8);
        BuilderPrint(*cnew, "%/%", parent_new, elem);
        cnew_s := BuilderFinish(cnew);
        nf: Vec(u8);
        BuilderAppend(nf, ctx.newroot);
        BuilderAppend(nf, cnew_s);
        of: Vec(u8);
        if ctx.lines[idx].old.bytes.count > 0 {
            os := TextView(ctx.lines[idx].old);
            if os[0] == #char "/" { BuilderAppend(of, ctx.oldroot) }
            BuilderAppend(of, os);
        } else {
            BuilderAppend(of, ctx.oldroot);
            BuilderAppend(of, cnew_s);
        }
        oldfile := BuilderFinish(of);
        sbuf: [Stat.BufferSize]u8;
        info := Stat.PathInfo(oldfile, sbuf[:]);
        if info.size == 0 {
            msg: Vec(u8);
            BuilderPrint(*msg, "can't stat file ");
            Quote.Quote(*msg, oldfile);
            BuilderPrint(*msg, ": %", Io.LastError());
            Warn(ctx, ctx.lines[idx].lineno, BuilderFinish(msg));
            SkipSubtree(ctx, ctx.lines[idx].indent);
            continue;
        }
        is_dir := CopyEntry(ctx, cnew_s, elem, oldfile, BuilderFinish(nf),
            ctx.lines[idx].mode, ctx.lines[idx].has_mode, TextView(ctx.lines[idx].uid), TextView(ctx.lines[idx].gid), info, false, ctx.lines[idx].lineno);
        if is_dir {
            ProcessLevel(ctx, cnew_s, ctx.lines[idx].indent);
        }
    }
}

main :: () -> s32 {
    ctx: Ctx;
    ctx.fskind = FS_KFS;
    ctx.newroot = "/n/kfs";
    if !ReadSmallFile("/dev/user", *ctx.user) {
        BuilderAppend(ctx.user.bytes, "none");
    }

    scan: Arg.Scan;
    letter := Arg.Option(*scan);
    while letter != 0 {
        if letter == #char "a" {
            ctx.fskind = FS_ARCHIVE;
            ctx.newroot = "";
        } else if letter == #char "d" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            ctx.fskind = FS_FS;
            ctx.newroot = val;
        } else if letter == #char "D" {
            ctx.debug = true;
        } else if letter == #char "n" || letter == #char "u" || letter == #char "z" {
            _, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
        } else if letter == #char "p" {
            ctx.modes = true;
        } else if letter == #char "q" {
            // quiet (no-op)
        } else if letter == #char "r" {
            ctx.ream = true;
        } else if letter == #char "s" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            ctx.oldroot = val;
        } else if letter == #char "v" {
            ctx.verb = true;
        } else if letter == #char "x" {
            ctx.xflag = true;
        } else if letter == #char "U" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            ctx.usrid = val;
        } else if letter == #char "G" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            ctx.grpid = val;
        } else if letter == #char "S" {
            ctx.setuid = true;
        } else {
            return Cli.Usage(USAGE);
        }
        letter = Arg.Option(*scan);
    }

    count := Args.OperandCount();
    if scan.next >= count { return Cli.Usage(USAGE) }

    errs: s32 = 0;
    for i: scan.next..count - 1 {
        ctx.proto = Args.Operand(i);
        pmsg: Vec(u8);
        BuilderPrint(*pmsg, "processing %\n", ctx.proto);
        unused Cli.WriteAll(2, BuilderFinish(pmsg));

        fd := Io.OpenFile(ctx.proto, 0);
        if fd < 0 {
            emsg: Vec(u8);
            BuilderAppend(emsg, "mkfs: can't open ");
            Quote.Quote(*emsg, ctx.proto);
            BuilderPrint(*emsg, ": %: skipping\n", Io.LastError());
            unused Cli.WriteAll(2, BuilderFinish(emsg));
            errs += 1;
            continue;
        }
        text: Vec(u8);
        chunk: [4096]u8;
        while true {
            n := Io.ReadBytes(fd, chunk[:]);
            if n <= 0 { break }
            for chunk[:n] { VecPush(text, it) }
        }
        unused Io.CloseFile(fd);

        LoadProto(*ctx, TextView(text[:]));
        ProcessLevel(*ctx, "", -1);
    }

    unused Cli.WriteAll(2, "file system made\n");
    if errs > 0 {
        unused Args.SetFailure("skipped protos");
        return 1;
    }
    if ctx.fskind == FS_ARCHIVE {
        unused Cli.WriteAll(1, "end of archive\n");
    }
    return 0;
}
