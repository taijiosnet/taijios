// disk/format [-df] [-b bootblock] [-c csize] [-l label] [-r nresrv] [-t type] disk [files ...]:
// format a floppy or disk image with a FAT12/FAT16 filesystem and optional files.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Stat :: #import "taijios_stat";
using Time :: #import "taijios_time";
using Cli :: #import "zx_cli";
using Arg :: #import "zx_arg";
using Quote :: #import "taijios_quote";
using Disks :: #import "disks";

USAGE :: "usage: disk/format [-df] [-b bootblock] [-c csize] [-l label] [-r nresrv] [-t type] disk [files ...]\n";

DB_MAGIC :: 0;
DB_VERSION :: 3;
DB_SECTSIZE :: 11;
DB_CLUSTSIZE :: 13;
DB_NRESRV :: 14;
DB_NFATS :: 16;
DB_ROOTSIZE :: 17;
DB_VOLSIZE :: 19;
DB_MEDIADESC :: 21;
DB_FATSIZE :: 22;
DB_TRKSIZE :: 24;
DB_NHEADS :: 26;
DB_NHIDDEN :: 28;
DB_BIGVOLSIZE :: 32;
DB_DRIVENO :: 36;
DB_BOOTSIG :: 38;
DB_VOLID :: 39;
DB_LABEL :: 43;
DB_TYPE :: 54;
DB_SIZE :: 62;

DD_NAME :: 0;
DD_EXT :: 8;
DD_ATTR :: 11;
DD_TIME :: 22;
DD_DATE :: 24;
DD_START :: 26;
DD_LENGTH :: 28;
DD_SIZE :: 32;
DSYSTEM :: 0x04;

SOF :: 1;
EOF_MARK :: 2;

FloppyType :: struct {
    name: string;
    bytes: s64;
    sectors: s64;
    heads: s64;
    tracks: s64;
    media: u8;
    cluster: s64;
}

FmtState :: struct {
    dev: string;
    typ: string;
    pbs: string;
    clustersize: s64;
    fat: Vec(u8);
    fatbits: s64;
    fatsecs: s64;
    fatlast: s64;
    clusters: s64;
    volsecs: s64;
    root: Vec(u8);
    rootsecs: s64;
    rootfiles: s64;
    chatty: bool;
    xflag: bool;
    nresrv: s64;
    dos: bool;
    fflag: bool;
    writepbs: bool;
    label: [11]u8;
    failed: bool;
}

Fatal :: (st: *FmtState, msg: string) {
    out: Vec(u8);
    BuilderPrint(*out, "format: %\n", msg);
    unused Cli.WriteAll(2, BuilderFinish(out));
    unused Args.SetFailure("error");
    st.failed = true;
}

ParseInt :: (s: string) -> s64 {
    v: s64 = 0;
    for i: 0..s.count - 1 {
        c := s[i];
        if c < #char "0" || c > #char "9" { break }
        v = v * 10 + cast(s64)(c - #char "0");
    }
    return v;
}

PutShort :: (b: []u8, off: s64, v: s64) {
    b[off] = cast(u8)(v & 0xFF);
    b[off + 1] = cast(u8)((v >> 8) & 0xFF);
}

PutLong :: (b: []u8, off: s64, v: s64) {
    PutShort(b, off, v);
    PutShort(b, off + 2, v >> 16);
}

FillBootProg :: (dst: []u8) {
    for i: 0..511 { dst[i] = 0 }
    dst[0] = 0xEB;
    dst[1] = 0x3C;
    dst[2] = 0x90;
    code: [57]u8 = .[
        0xFA, 0xFC, 0x8C, 0xC8, 0x8E, 0xD8, 0x8E, 0xD0,
        0xBC, 0x00, 0x7C, 0xBE, 0x77, 0x7C, 0xE8, 0x19,
        0x00, 0x33, 0xC0, 0xCD, 0x16, 0xBB, 0x40, 0x00,
        0x8E, 0xC3, 0xBB, 0x72, 0x00, 0xB8, 0x34, 0x12,
        0x26, 0x89, 0x07, 0xEA, 0x00, 0x00, 0xFF, 0xFF,
        0xEB, 0xD6, 0xAC, 0x0A, 0xC0, 0x74, 0x09, 0xB4,
        0x0E, 0xBB, 0x07, 0x00, 0xCD, 0x10, 0xEB, 0xF2,
        0xC3,
    ];
    for i: 0..code.count - 1 { dst[0x3E + i] = code[i] }
    msg := "Not a bootable disc or disc error\r\nPress almost any key to reboot...";
    for i: 0..msg.count - 1 { dst[0x3E + 57 + i] = msg[i] }
    dst[510] = 0x55;
    dst[511] = 0xAA;
}

WriteN :: (fd: s32, buf: []u8) -> s64 {
    tot: s64 = 0;
    while tot < buf.count {
        m := buf.count - tot;
        if m > 8192 { m = 8192 }
        if Io.WriteBytes(fd, TextView(buf[tot:tot + m])) != cast(s32)m { break }
        tot += m;
    }
    return tot;
}

ClustAlloc :: (st: *FmtState, flag: s32) -> s64 {
    if flag != SOF {
        x: s64 = ifx flag == EOF_MARK then 0xFFFF else st.fatlast + 1;
        if st.fatbits == 12 {
            x &= 0xFFF;
            o := (3 * st.fatlast) / 2;
            if (st.fatlast & 1) != 0 {
                st.fat[o] = cast(u8)((cast(s64)st.fat[o] & 0x0F) | ((x << 4) & 0xF0));
                st.fat[o + 1] = cast(u8)((x >> 4) & 0xFF);
            } else {
                st.fat[o] = cast(u8)(x & 0xFF);
                st.fat[o + 1] = cast(u8)((cast(s64)st.fat[o + 1] & 0xF0) | ((x >> 8) & 0x0F));
            }
        } else {
            o := 2 * st.fatlast;
            st.fat[o] = cast(u8)(x & 0xFF);
            st.fat[o + 1] = cast(u8)((x >> 8) & 0xFF);
        }
    }
    if flag == EOF_MARK { return 0 }
    st.fatlast += 1;
    if st.fatlast >= st.clusters {
        msg: Vec(u8);
        BuilderPrint(*msg, "data does not fit on disk (% %)", st.fatlast, st.clusters);
        Fatal(st, BuilderFinish(msg));
        return -1;
    }
    return st.fatlast;
}

PutDosName :: (p: string, buf: []u8) {
    for i: 0..10 { buf[i] = #char " " }
    i: s64 = 0;
    while i < 8 && i < p.count && p[i] != #char "." {
        c := p[i];
        if c >= #char "a" && c <= #char "z" { c -= 32 }
        buf[DD_NAME + i] = c;
        i += 1;
    }
    for k: 0..p.count - 1 {
        if p[k] == #char "." {
            ext := p[k + 1:];
            j: s64 = 0;
            while j < 3 && j < ext.count {
                c := ext[j];
                if c >= #char "a" && c <= #char "z" { c -= 32 }
                buf[DD_EXT + j] = c;
                j += 1;
            }
            break;
        }
    }
}

PutDosTime :: (buf: []u8, epoch: s64) {
    sec := epoch % 60;
    t := epoch / 60;
    min := t % 60;
    t /= 60;
    hour := t % 24;
    days := t / 24;
    yr: s64 = 1970;
    while true {
        leap := (yr % 4 == 0 && yr % 100 != 0) || (yr % 400 == 0);
        yd: s64 = ifx leap then 366 else 365;
        if days < yd { break }
        days -= yd;
        yr += 1;
    }
    dm: [12]s64 = .[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    mon: s64 = 1;
    while true {
        md := dm[mon - 1];
        if mon == 2 && ((yr % 4 == 0 && yr % 100 != 0) || (yr % 400 == 0)) { md = 29 }
        if days < md { break }
        days -= md;
        mon += 1;
    }
    mday := days + 1;
    tv := (hour << 11) | (min << 5) | (sec >> 1);
    dv := ((yr - 1980) << 9) | (mon << 5) | mday;
    PutShort(buf, DD_TIME, tv);
    PutShort(buf, DD_DATE, dv);
}

AddRootName :: (buf: []u8, length: s64, name: string, start: s64, now_sec: s64) {
    s := name;
    slash: s64 = -1;
    for i: 0..s.count - 1 {
        if s[i] == #char "/" { slash = i }
    }
    if slash >= 0 { s = s[slash + 1:] }
    PutDosName(s, buf);
    buf[DD_ATTR] = ifx s == "9load" then cast(u8)DSYSTEM else 0;
    PutDosTime(buf, now_sec);
    PutShort(buf, DD_START, start);
    PutLong(buf, DD_LENGTH, length);
}

AppendHex :: (out: *Vec(u8), v: u32) {
    digits := "0123456789abcdef";
    if v == 0 { VecPush(<<out, #char "0"); return }
    tmp: [8]u8;
    n := 0;
    x := v;
    while x > 0 {
        tmp[n] = digits[x & 0xF];
        x >>= 4;
        n += 1;
    }
    for i: 0..n - 1 { VecPush(<<out, tmp[n - 1 - i]) }
}

DosFs :: (st: *FmtState, disk: *Disks.Disk, file_first: s32, file_count: s32, commit: bool) -> bool {
    if !st.dos && !st.writepbs { return true }
    types: [6]FloppyType = .[
        .{name = "3\xC2\xBDHD", bytes = 512, sectors = 18, heads = 2, tracks = 80, media = 0xF0, cluster = 1},
        .{name = "3\xC2\xBDDD", bytes = 512, sectors = 9, heads = 2, tracks = 80, media = 0xF9, cluster = 2},
        .{name = "3\xC2\xBDQD", bytes = 512, sectors = 36, heads = 2, tracks = 80, media = 0xF9, cluster = 2},
        .{name = "5\xC2\xBCHD", bytes = 512, sectors = 15, heads = 2, tracks = 80, media = 0xF9, cluster = 1},
        .{name = "5\xC2\xBCDD", bytes = 512, sectors = 9, heads = 2, tracks = 40, media = 0xFD, cluster = 2},
        .{name = "hard", bytes = 512, sectors = 0, heads = 0, tracks = 0, media = 0xF8, cluster = 4},
    ];
    tidx: s64 = -1;
    for i: 0..types.count - 1 {
        if st.typ == types[i].name { tidx = i; break }
    }
    if tidx < 0 {
        msg: Vec(u8);
        BuilderAppend(msg, "unknown floppy type ");
        Quote.Quote(*msg, st.typ);
        Fatal(st, BuilderFinish(msg));
        return false;
    }
    t := types[tidx];
    if t.sectors == 0 && st.typ == "hard" {
        t.sectors = disk.s;
        t.heads = disk.h;
        t.tracks = disk.c;
    }
    if t.sectors == 0 && st.dos {
        msg: Vec(u8);
        BuilderPrint(*msg, "cannot format fat with type %: geometry unknown", st.typ);
        Fatal(st, BuilderFinish(msg));
        return false;
    }
    if st.fflag {
        disk.size = t.bytes * t.sectors * t.heads * t.tracks;
        disk.secsize = t.bytes;
        disk.secs = disk.size / disk.secsize;
    }
    secsize := disk.secsize;
    length := disk.size;

    if st.fflag && disk.dtype == "file" {
        sbuf: [Stat.BufferSize]u8;
        info := Stat.DescriptorInfo(disk.wfd, sbuf[:]);
        if info.size == 0 {
            msg: Vec(u8);
            BuilderPrint(*msg, "fstat disk: %", Io.LastError());
            Fatal(st, BuilderFinish(msg));
            return false;
        }
        if commit && info.length < disk.size {
            if Io.SeekFile(disk.wfd, disk.size - 1, 0) < 0 {
                Fatal(st, "seek to 9");
                return false;
            }
            if Io.WriteBytes(disk.wfd, "9") < 0 {
                Fatal(st, "writing 9");
                return false;
            }
        }
    }

    buf: Vec(u8);
    for i: 0..secsize - 1 { VecPush(buf, 0) }
    if Io.SeekFile(disk.fd, 0, 0) < 0 {
        Fatal(st, "seek to boot sector");
        return false;
    }
    if commit && Io.ReadBytes(disk.fd, buf[:]) != cast(s32)secsize {
        Fatal(st, "reading boot sector");
        return false;
    }
    if st.dos {
        for i: 0..DB_SIZE - 1 { buf[i] = 0 }
    }
    buf[DB_MAGIC] = 0xEB;
    buf[DB_MAGIC + 1] = 0x3C;
    buf[DB_MAGIC + 2] = 0x90;
    oem := "Plan9.00";
    for i: 0..7 { buf[DB_VERSION + i] = oem[i] }

    if st.writepbs {
        pbsbuf: Vec(u8);
        for i: 0..secsize - 1 { VecPush(pbsbuf, 0) }
        npbs: s64 = 0;
        if st.pbs != "" {
            sfd := Io.OpenFile(st.pbs, 0);
            if sfd < 0 {
                msg: Vec(u8);
                BuilderPrint(*msg, "open %: %", st.pbs, Io.LastError());
                Fatal(st, BuilderFinish(msg));
                return false;
            }
            got := Io.ReadBytes(sfd, pbsbuf[:]);
            unused Io.CloseFile(sfd);
            if got < 0 { Fatal(st, "read bootblock"); return false }
            npbs = cast(s64)got;
            if npbs > secsize - 2 { Fatal(st, "boot block too large"); return false }
        } else {
            FillBootProg(pbsbuf[:]);
            npbs = 512;
        }
        if npbs <= 0x3E {
            unused Cli.WriteAll(2, "warning: pbs too small\n");
        } else {
            for i: 0x3E..npbs - 1 { buf[i] = pbsbuf[i] }
        }
    }

    if st.dos {
        if commit {
            m: Vec(u8);
            BuilderPrint(*m, "Initializing FAT file system\ntype %, % tracks, % heads, % sectors/track, % bytes/sec\n",
                t.name, t.tracks, t.heads, t.sectors, secsize);
            unused Cli.WriteAll(1, BuilderFinish(m));
        }
        if st.clustersize == 0 { st.clustersize = t.cluster }
        st.fatbits = 12;
        while true {
            st.volsecs = length / secsize;
            st.clusters = 0;
            iter := 0;
            while true {
                st.fatsecs = (st.fatbits * st.clusters + 8 * secsize - 1) / (8 * secsize);
                st.rootsecs = st.volsecs / 200;
                st.rootfiles = st.rootsecs * (secsize / DD_SIZE);
                if st.rootfiles > 512 {
                    st.rootfiles = 512;
                    st.rootsecs = st.rootfiles / (secsize / DD_SIZE);
                }
                data := st.nresrv + 2 * st.fatsecs + (st.rootfiles * DD_SIZE + secsize - 1) / secsize;
                newc := 2 + (st.volsecs - data) / st.clustersize;
                if newc == st.clusters { break }
                st.clusters = newc;
                iter += 1;
                if iter > 10 {
                    Fatal(st, "can't decide how many clusters to use");
                    return false;
                }
            }
            if st.clusters < 4087 || st.fatbits > 12 { break }
            st.fatbits = 16;
        }
        if st.clusters >= 65527 {
            Fatal(st, "disk too big; implement fat32");
            return false;
        }
        PutShort(buf[:], DB_SECTSIZE, secsize);
        buf[DB_CLUSTSIZE] = cast(u8)st.clustersize;
        PutShort(buf[:], DB_NRESRV, st.nresrv);
        buf[DB_NFATS] = 2;
        PutShort(buf[:], DB_ROOTSIZE, st.rootfiles);
        if st.volsecs < 65536 { PutShort(buf[:], DB_VOLSIZE, st.volsecs) }
        buf[DB_MEDIADESC] = t.media;
        PutShort(buf[:], DB_FATSIZE, st.fatsecs);
        PutShort(buf[:], DB_TRKSIZE, t.sectors);
        PutShort(buf[:], DB_NHEADS, t.heads);
        PutLong(buf[:], DB_NHIDDEN, disk.offset);
        PutLong(buf[:], DB_BIGVOLSIZE, st.volsecs);
        buf[DB_DRIVENO] = ifx t.media == 0xF8 then cast(u8)0x80 else 0;
        buf[DB_BOOTSIG] = 0x29;
        volid := disk.offset + 2 * st.fatsecs + st.nresrv;
        PutLong(buf[:], DB_VOLID, volid);
        for i: 0..10 { buf[DB_LABEL + i] = st.label[i] }
        ft := ifx st.fatbits == 12 then "FAT12   " else "FAT16   ";
        for i: 0..7 { buf[DB_TYPE + i] = ft[i] }
    }

    buf[secsize - 2] = Disks.MAGIC0;
    buf[secsize - 1] = Disks.MAGIC1;
    if commit {
        if Io.SeekFile(disk.wfd, 0, 0) < 0 || Io.WriteBytes(disk.wfd, TextView(buf[:])) != cast(s32)secsize {
            Fatal(st, "writing to boot sector");
            return false;
        }
    }
    if !st.dos { return true }

    if Io.SeekFile(disk.wfd, st.nresrv * secsize, 0) < 0 { Fatal(st, "seek to fat"); return false }
    VecClear(st.fat);
    for i: 0..st.fatsecs * secsize - 1 { VecPush(st.fat, 0) }
    st.fat[0] = t.media;
    st.fat[1] = 0xFF;
    st.fat[2] = 0xFF;
    if st.fatbits == 16 { st.fat[3] = 0xFF }
    st.fatlast = 1;

    if Io.SeekFile(disk.wfd, 2 * st.fatsecs * secsize, 1) < 0 { Fatal(st, "seek to root"); return false }
    VecClear(st.root);
    for i: 0..st.rootsecs * secsize - 1 { VecPush(st.root, 0) }
    if Io.SeekFile(disk.wfd, st.rootsecs * secsize, 1) < 0 { Fatal(st, "seek to files"); return false }

    Time.LoadZone();
    now_sec := Time.LocalSeconds();
    p: s64 = 0;
    for fi: file_first..file_count - 1 {
        if p >= st.rootsecs * secsize { Fatal(st, "too many files in root"); return false }
        fname := Args.Operand(fi);
        sfd := Io.OpenFile(fname, 0);
        if sfd < 0 {
            msg: Vec(u8);
            BuilderPrint(*msg, "open %: %", fname, Io.LastError());
            Fatal(st, BuilderFinish(msg));
            return false;
        }
        sbuf: [Stat.BufferSize]u8;
        info := Stat.DescriptorInfo(sfd, sbuf[:]);
        if info.size == 0 {
            unused Io.CloseFile(sfd);
            Fatal(st, "stat failed");
            return false;
        }
        if commit {
            m: Vec(u8);
            BuilderPrint(*m, "Adding file %, length %\n", fname, info.length);
            unused Cli.WriteAll(1, BuilderFinish(m));
        }
        x: s64 = 0;
        if info.length > 0 {
            csz := secsize * st.clustersize;
            padded := ((info.length + csz - 1) / csz) * csz;
            fbuf: Vec(u8);
            for i: 0..padded - 1 { VecPush(fbuf, 0) }
            nr := Disks.ReadN(sfd, fbuf[:info.length]);
            if nr != info.length {
                unused Io.CloseFile(sfd);
                Fatal(st, "short read");
                return false;
            }
            if commit && WriteN(disk.wfd, fbuf[:]) != fbuf.count {
                unused Io.CloseFile(sfd);
                Fatal(st, "write failed");
                return false;
            }
            ncl := padded / csz;
            x = ClustAlloc(st, SOF);
            if x < 0 { unused Io.CloseFile(sfd); return false }
            for n: 0..ncl - 2 {
                if ClustAlloc(st, 0) < 0 { unused Io.CloseFile(sfd); return false }
            }
            unused ClustAlloc(st, EOF_MARK);
        }
        unused Io.CloseFile(sfd);
        emsg: Vec(u8);
        BuilderPrint(*emsg, "add % at clust ", info.name);
        AppendHex(*emsg, cast(u32)x);
        VecPush(emsg, #char "\n");
        unused Cli.WriteAll(2, BuilderFinish(emsg));
        AddRootName(st.root[p:p + DD_SIZE], info.length, fname, x, now_sec);
        p += DD_SIZE;
    }

    if commit {
        if Io.SeekFile(disk.wfd, st.nresrv * secsize, 0) < 0 ||
            WriteN(disk.wfd, st.fat[:]) != st.fat.count ||
            WriteN(disk.wfd, st.fat[:]) != st.fat.count ||
            WriteN(disk.wfd, st.root[:]) != st.root.count {
            Fatal(st, "writing fat/root");
            return false;
        }
    }
    return true;
}

main :: () -> s32 {
    st: FmtState;
    st.nresrv = 1;
    def_lbl := "CYLINDRICAL";
    for i: 0..10 { st.label[i] = def_lbl[i] }

    scan: Arg.Scan;
    letter := Arg.Option(*scan);
    while letter != 0 {
        if letter == #char "b" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            st.pbs = val;
            st.writepbs = true;
        } else if letter == #char "d" {
            st.dos = true;
            st.writepbs = true;
        } else if letter == #char "c" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            st.clustersize = ParseInt(val);
        } else if letter == #char "f" {
            st.fflag = true;
        } else if letter == #char "l" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            for i: 0..10 {
                st.label[i] = ifx i < val.count then val[i] else #char " ";
            }
        } else if letter == #char "r" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            st.nresrv = ParseInt(val);
        } else if letter == #char "t" {
            val, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            st.typ = val;
        } else if letter == #char "v" {
            st.chatty = true;
        } else if letter == #char "x" {
            st.xflag = true;
        } else {
            return Cli.Usage(USAGE);
        }
        letter = Arg.Option(*scan);
    }

    count := Args.OperandCount();
    if scan.next >= count { return Cli.Usage(USAGE) }
    st.dev = Args.Operand(scan.next);

    disk: Disks.Disk;
    opened := Disks.Open(*disk, st.dev, 2, false);
    if !opened && st.fflag {
        fd := Io.CreateFile(st.dev, 2, 0x1B6);
        if fd >= 0 {
            unused Io.CloseFile(fd);
            opened = Disks.Open(*disk, st.dev, 2, false);
        }
    }
    if !opened {
        msg: Vec(u8);
        BuilderAppend(msg, "opendisk ");
        Quote.Quote(*msg, st.dev);
        BuilderPrint(*msg, ": %", Io.LastError());
        Fatal(*st, BuilderFinish(msg));
        return 1;
    }

    if disk.dtype == "file" { st.fflag = true }
    if st.typ == "" {
        if disk.dtype == "file" { st.typ = "3\xC2\xBDHD" }
        else if disk.dtype == "sd" { st.typ = "hard" }
        else { st.typ = "unknown" }
    }

    // Sanity check for Plan 9 partition table on sector 1
    if disk.dtype != "floppy" && !st.xflag {
        if st.dos && st.nresrv < 2 && Io.SeekFile(disk.fd, disk.secsize, 0) == disk.secsize {
            sbuf: [5]u8;
            if Io.ReadBytes(disk.fd, sbuf[:]) >= 5 && TextView(sbuf[:]) == "part " {
                unused Cli.WriteAll(2, "there's a plan9 partition on the disk\nand you didn't specify -r 2 (or greater).\neither specify -r 2 or -x to disable this check.\n");
                Disks.Close(*disk);
                unused Args.SetFailure("failed disk sanity check");
                return 1;
            }
        }
    }

    if !DosFs(*st, *disk, scan.next + 1, count, false) {
        Disks.Close(*disk);
        return 1;
    }
    if !DosFs(*st, *disk, scan.next + 1, count, true) {
        Disks.Close(*disk);
        return 1;
    }

    umsg: Vec(u8);
    BuilderPrint(*umsg, "used % bytes\n", st.fatlast * st.clustersize * disk.secsize);
    unused Cli.WriteAll(1, BuilderFinish(umsg));
    Disks.Close(*disk);
    return 0;
}
