// Print the SHA-1 digest of each file, replacing the Limbo sha1sum.
#import "std/vec"
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";
using Kr :: #import "taijios_keyring";

Name :: "sha1sum";
Algorithm :: Kr.SHA1;
Digits :: "0123456789abcdef";

// Two lowercase hexadecimal digits per byte.
Hex :: (out: *Vec(u8), digest: []u8) {
    for byte: digest {
        high := cast(s64)(byte >> 4);
        low := cast(s64)(byte & 15);
        unused BuilderAppend(<<out, Digits[high:high + 1]);
        unused BuilderAppend(<<out, Digits[low:low + 1]);
    }
}

// Digest one open file and print the result with its name.
Sum :: (handle: s32, file: string) -> s32 {
    state: Kr.DigestState;
    buffer: [8192]u8;
    while true {
        got := Io.ReadBytes(handle, buffer[:]);
        if got < 0 {
            unused Cli.WriteAll(2, Name);
            unused Cli.WriteAll(2, ": error reading ");
            unused Cli.WriteAll(2, file);
            unused Cli.WriteAll(2, ": ");
            unused Cli.WriteAll(2, Io.LastError());
            unused Cli.WriteAll(2, "\n");
            return 1;
        }
        if got == 0 { break; }
        unused Kr.DigestAdd(Algorithm, *state, TextView(buffer[:got]));
    }
    digest: [64]u8;
    length := Kr.DigestBytes(Algorithm);
    if Kr.DigestEnd(Algorithm, *state, digest[:length]) < 0 {
        unused Cli.WriteAll(2, Name);
        unused Cli.WriteAll(2, ": cannot digest ");
        unused Cli.WriteAll(2, file);
        unused Cli.WriteAll(2, "\n");
        return 1;
    }
    line: Vec(u8);
    Hex(*line, digest[:length]);
    if file.count > 0 {
        unused BuilderAppend(line, "\t");
        unused BuilderAppend(line, file);
    }
    unused BuilderAppend(line, "\n");
    unused Cli.WriteAll(1, BuilderFinish(line));
    return 0;
}

#program_export
main :: () -> s32 {
    failed := false;
    count := Args.OperandCount();
    if count == 0 {
        if Sum(0, "") != 0 { failed = true; }
    } else {
        for i: 0..count-1 {
            path := Args.Operand(i);
            handle := Io.OpenFile(path, 0);
            if handle < 0 {
                unused Cli.WriteAll(2, Name);
                unused Cli.WriteAll(2, ": cannot open ");
                unused Cli.WriteAll(2, path);
                unused Cli.WriteAll(2, ": ");
                unused Cli.WriteAll(2, Io.LastError());
                unused Cli.WriteAll(2, "\n");
                failed = true;
            } else {
                if Sum(handle, path) != 0 { failed = true; }
                unused Io.CloseFile(handle);
            }
        }
    }
    if failed {
        unused Args.SetFailure("error");
        return 1;
    }
    return 0;
}
