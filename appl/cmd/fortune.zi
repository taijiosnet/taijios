// Reservoir sampling and the original fortunes.index cache format.
// Ported from Inferno fortune.b (see NOTICE).
Args :: #import "taijios_args";
Io :: #import "taijios_io";
Fs :: #import "taijios_stat";
Cli :: #import "zx_cli";
Bufio :: #import "zx_bufio";
Keyring :: #import "taijios_keyring";
Rand :: #import "zx_rand";
#import "std/vec"

Random32 :: () -> (value: s64, ok: bool) {
    bytes: [4]u8;
    if Keyring.Random(bytes[:]) != 4 { return 0, false }
    return cast(s64)Fs.Uint(bytes[:], 0, 4), true;
}

#program_export
main :: () -> s32 {
    default_file := Args.OperandCount() == 0;
    filename := ifx default_file then "/lib/games/fortunes" else Args.Operand(0);
    input := Io.Open(filename, 0);
    if input < 0 {
        unused Cli.WriteAll(2, "fortune: can't open ");
        unused Cli.WriteAll(2, filename);
        unused Cli.WriteAll(2, ": ");
        unused Cli.WriteAll(2, Io.Error());
        unused Cli.WriteAll(2, "\n");
        unused Args.SetFailure("open");
        return 1;
    }
    defer Io.Close(input);
    index: s32 = -1;
    new_index: s32 = -1;
    length: s64;
    if default_file {
        index = Io.Open("/lib/games/fortunes.index", 0);
        if index >= 0 {
            first: [Fs.BufferSize]u8;
            second: [Fs.BufferSize]u8;
            cached := Fs.DescriptorInfo(index, first[:]);
            source := Fs.DescriptorInfo(input, second[:]);
            if source.modified >= cached.modified {
                unused Io.Close(index);
                index = -1;
                new_index = Io.Create("/lib/games/fortunes.index", 1, 438);
            } else { length = cached.length }
        } else { new_index = Io.Create("/lib/games/fortunes.index", 1, 438) }
    }
    defer { if index >= 0 { unused Io.Close(index) }; if new_index >= 0 { unused Io.Close(new_index) } }
    reader: Bufio.Reader;
    reader.handle = input;
    choice: Vec(u8);
    if index >= 0 && length != 0 {
        value, ok := Random32();
        if !ok { unused Args.SetFailure("random"); return 1 }
        unused Io.Seek(index, (value % length) & ~3, 0);
        offset: [4]u8;
        // A partial index entry has no usable offset. Preserve the existing
        // misfortune result without interpreting uninitialized padding bytes.
        if Io.Read(index, offset[:]) != 4 { BuilderAppend(choice, "Misfortune!\n") }
        else {
            unused Io.Seek(input, cast(s32)Fs.Uint(offset[:], 0, 4), 0);
            if !Bufio.ReadLine(*reader, *choice) { BuilderAppend(choice, "Misfortune!\n") }
        }
    } else {
        seed, ok := Random32();
        if !ok { unused Args.SetFailure("random"); return 1 }
        generator: Rand.Generator;
        Rand.Seed(*generator, cast(s32)seed);
        count: s32 = 1;
        line: Vec(u8);
        pending: Vec(u8);
        offset: [4]u8;
        while true {
            position := reader.offset;
            if !Bufio.ReadLine(*reader, *line) { break }
            if new_index >= 0 {
                Fs.Put(offset[:], 0, 4, cast(u64)position);
                BuilderAppend(pending, TextView(offset[:]));
                if pending.count >= 8192 {
                    unused Cli.WriteAll(new_index, TextView(pending[:]));
                    VecClear(pending);
                }
            }
            if Rand.Next(*generator, count) == 0 { VecClear(choice); BuilderAppend(choice, TextView(line[:])) }
            count = cast(s32)(cast(s64)count + 1);
        }
        if new_index >= 0 { unused Cli.WriteAll(new_index, TextView(pending[:])) }
    }
    end: s64;
    while end < choice.count && choice[end] != 0 { end += 1 }
    unused Cli.WriteAll(1, TextView(choice[:end]));
    return 0;
}
