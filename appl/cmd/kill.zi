// Guest process control, ported from Inferno kill.b (see NOTICE).
Args :: #import "taijios_args";
Io :: #import "taijios_io";
Fs :: #import "taijios_stat";
Cli :: #import "zx_cli";
Options :: #import "zx_arg";
Tasks :: #import "taijios_tasks";
#import "std/vec"
#import "std/format"
#import "std/number_text"

Usage :: () -> s32 {
    unused Cli.WriteAll(2, "usage: kill [-g] pid|module [...]\n");
    unused Args.SetFailure(" usage");
    return 1;
}

Path :: (pid: string, leaf: string) -> Text {
    path: Vec(u8);
    BuilderPrint(*path, "/prog/%/%", pid, leaf);
    return BuilderFinish(path);
}

Warn :: (prefix: string, name: string, problem: string) {
    unused Cli.WriteAll(2, prefix);
    unused Cli.WriteAll(2, name);
    unused Cli.WriteAll(2, ": ");
    unused Cli.WriteAll(2, problem);
    unused Cli.WriteAll(2, "\n");
}

KillPid :: (pid: string, message: string, explicit: bool) -> s32 {
    path := Path(pid, "ctl");
    fd := Io.Open(TextView(path), 1);
    if fd < 0 {
        problem := Io.Error();
        missing := problem.count >= 14 && problem[problem.count-14:] == "does not exist";
        if explicit || (problem != "thread exited" && problem.count >= 14 && !missing) {
            Warn("kill: cannot open ", TextView(path), problem);
        }
        return 0;
    }
    defer Io.Close(fd);
    if Io.Write(fd, message) < 0 {
        problem := Io.Error();
        if explicit || problem != "thread exited" { Warn("kill: cannot kill ", pid, problem) }
        return 0;
    }
    return 1;
}

Matches :: (pid: string, module: string) -> bool {
    path := Path(pid, "status");
    fd := Io.Open(TextView(path), 0);
    if fd < 0 { return false }
    defer Io.Close(fd);
    bytes: [512]u8;
    count := Io.Read(fd, bytes[:]);
    if count < 0 {
        problem := Io.Error();
        if problem != "thread exited" { Warn("kill: cannot read ", TextView(path), problem) }
        return false;
    }
    // tokenize(..., " ") selects the last nonempty space-separated field.
    end: s64 = count;
    while end > 0 && bytes[end-1] == #char " " { end -= 1 }
    start := end;
    while start > 0 && bytes[start-1] != #char " " { start -= 1 }
    for at: start..end-1 { if bytes[at] == #char "[" { end = at; break } }
    return TextView(bytes[start:end]) == module;
}

KillModule :: (module: string, message: string) -> s32 {
    fd := Io.Open("/prog", 0);
    if fd < 0 { Warn("kill: open ", "/prog", Io.Error()); return 0 }
    defer Io.Close(fd);
    // Snapshot names before killing anything. Keep the original reverse order.
    names: Vec(u8);
    offsets: Vec(s64);
    buffer: [Fs.BufferSize]u8;
    while true {
        count := Io.Read(fd, buffer[:]);
        if count <= 0 {
            if count < 0 { Warn("kill: read ", "/prog", Io.Error()) }
            break;
        }
        at: s64;
        while at < count {
            info := Fs.Decode(buffer[at:count]);
            if info.size <= 0 { break }
            at += info.size;
            if Matches(info.name, module) {
                VecPush(offsets, names.count);
                BuilderAppend(names, info.name);
                VecPush(names, 0);
            }
        }
    }
    if offsets.count == 0 {
        unused Cli.WriteAll(2, "kill: cannot find ");
        unused Cli.WriteAll(2, module);
        unused Cli.WriteAll(2, "\n");
        return 0;
    }
    total: s32;
    end := names.count - 1;
    index := offsets.count;
    while index > 0 {
        index -= 1;
        start := offsets[index];
        pid := TextView(names[start:end]);
        if KillPid(pid, message, false) != 0 {
            unused Cli.WriteAll(1, pid);
            unused Cli.WriteAll(1, " ");
            total += 1;
        }
        end = start - 1;
    }
    if total > 0 { unused Cli.WriteAll(1, "\n") }
    return total;
}

// The Dis-free runtime has no /prog entries. Its task snapshot supplies public
// PIDs and groups, distinct from a parent's local Process.Start handles.
NativeTask :: struct { pid: s32; group: s32; matched: bool; }

NativeKill :: (operand: string, group: bool, explicit: bool) -> s32 {
    pid: s64;
    if explicit {
        for at: 0..operand.count-1 {
            digit := operand[at];
            if digit < 48 || digit > 57 || pid > (2147483647 - cast(s64)(digit - 48)) / 10 {
                path := Path(operand, "ctl");
                Warn("kill: cannot open ", TextView(path), "file does not exist");
                return 0;
            }
            pid = pid * 10 + cast(s64)(digit - 48);
        }
    }
    count := Tasks.Capture();
    if count < 0 { Warn("kill: read ", "/prog", "task snapshot unavailable"); return 0 }
    rows: Vec(NativeTask);
    fields: [4]s64;
    name: [64]u8;
    user: [64]u8;
    matched: bool;
    for index: 0..count-1 {
        if Tasks.TaskAt(cast(s32)index, fields[:], name[:], user[:]) != 0 { continue }
        end: s64;
        while end < name.count && name[end] != 0 { end += 1 }
        hit := ifx explicit then fields[0] == pid else TextView(name[:end]) == operand;
        if hit { matched = true }
        VecPush(rows, NativeTask.{cast(s32)fields[0], cast(s32)fields[1], hit});
    }
    if !matched {
        if explicit {
            path := Path(operand, "ctl");
            Warn("kill: cannot open ", TextView(path), "file does not exist");
        } else {
            unused Cli.WriteAll(2, "kill: cannot find ");
            unused Cli.WriteAll(2, operand);
            unused Cli.WriteAll(2, "\n");
        }
        return 0;
    }
    total: s32;
    index := rows.count;
    while index > 0 {
        index -= 1;
        if !rows[index].matched { continue }
        // Group members are selected from the same snapshot as the target.
        accepted: bool;
        if group && rows[index].group > 0 {
            member := rows.count;
            while member > 0 {
                member -= 1;
                if rows[member].group == rows[index].group && Tasks.Terminate(rows[member].pid) == 0 { accepted = true }
            }
        } else { accepted = Tasks.Terminate(rows[index].pid) == 0 }
        if accepted {
            total += 1;
            if !explicit {
                digits: [24]u8;
                unused Cli.WriteAll(1, FormatInteger(rows[index].pid, digits[:]));
                unused Cli.WriteAll(1, " ");
            }
        } else if explicit { Warn("kill: cannot kill ", operand, "process exited or rejected termination") }
    }
    if !explicit && total > 0 { unused Cli.WriteAll(1, "\n") }
    return total;
}

#program_export
main :: () -> s32 {
    scan: Options.Scan;
    message := "kill";
    while true {
        option := Options.Option(*scan);
        if option == 0 { break }
        if option != #char "g" { return Usage() }
        message = "killgrp";
    }
    if scan.next == Args.OperandCount() { return Usage() }
    native := Tasks.Native();
    total: s32;
    for index: scan.next..Args.OperandCount()-1 {
        operand := Args.Operand(cast(s32)index);
        if operand.count == 0 { return Usage() }
        explicit := operand[0] >= #char "0" && operand[0] <= #char "9";
        if native { total += NativeKill(operand, message == "killgrp", explicit) }
        else if explicit { total += KillPid(operand, message, true) }
        else { total += KillModule(operand, message) }
    }
    if total == 0 { unused Args.SetFailure("nothing killed"); return 1 }
    return 0;
}
