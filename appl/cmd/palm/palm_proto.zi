// Palm serial link (SLP), connection management (CMP), packet assembly (PADP),
// and Desk Link Protocol (DLP) encoding/decoding for zx/palm.
#import "std/vec";

// SLP constants
SLP_SYSTEM :: 0;
SLP_UNUSED :: 1;
SLP_PAD :: 2;
SLP_LOOP :: 3;
SLPHDRLEN :: 10;

// CMP constants
CMPHDRLEN :: 10;
C_WAKE :: 1;
C_INIT :: 2;
C_ABORT :: 3;
C_EXTENDED :: 4;
C_MAJOR :: 1;
C_MINOR :: 2;
INIT_BAUD :: 9600;
CHANGE_BAUD :: 0x80;
WRONG_VERSION :: 0x80;

// PADP constants
PADP_FIRST :: 0x80;
PADP_LAST :: 0x40;
PADP_MEMERROR :: 0x20;
P_DATA :: 1;
P_ACK :: 2;
P_TICKLE :: 4;
P_ABORT :: 8;
PADPHDRLEN :: 4;

// DLP constants
T_READ_USER_INFO :: 0x10;
T_WRITE_USER_INFO :: 0x11;
T_READ_SYS_INFO :: 0x12;
T_GET_SYS_DATE_TIME :: 0x13;
T_SET_SYS_DATE_TIME :: 0x14;
T_READ_STORAGE_INFO :: 0x15;
T_READ_DB_LIST :: 0x16;
T_OPEN_DB :: 0x17;
T_CREATE_DB :: 0x18;
T_CLOSE_DB :: 0x19;
T_DELETE_DB :: 0x1A;
T_READ_RECORD :: 0x20;
T_OPEN_CONDUIT :: 0x2E;
T_END_OF_SYNC :: 0x2F;
DLP_RESPONSE :: 0x80;
ARG_ID_BASE :: 0x20;
DB_LIST_RAM :: 0x80;
DB_LIST_ROM :: 0x40;
DB_LIST_MULTIPLE :: 0x20;

Get2 :: (p: []u8, off: s64) -> u16 {
    return (cast(u16)p[off] << 8) | cast(u16)p[off + 1];
}

Get4 :: (p: []u8, off: s64) -> u32 {
    return (cast(u32)p[off] << 24) | (cast(u32)p[off + 1] << 16) |
        (cast(u32)p[off + 2] << 8) | cast(u32)p[off + 3];
}

Put2 :: (out: *Vec(u8), v: u16) {
    VecPush(<<out, cast(u8)((v >> 8) & 0xFF));
    VecPush(<<out, cast(u8)(v & 0xFF));
}

Put4 :: (out: *Vec(u8), v: u32) {
    VecPush(<<out, cast(u8)((v >> 24) & 0xFF));
    VecPush(<<out, cast(u8)((v >> 16) & 0xFF));
    VecPush(<<out, cast(u8)((v >> 8) & 0xFF));
    VecPush(<<out, cast(u8)(v & 0xFF));
}

// CRC-16/XMODEM (polynomial 0x1021) as used by Palm SLP.
Crc16 :: (buf: []u8, init_crc: u16) -> u16 {
    crc: u32 = cast(u32)init_crc;
    for buf {
        crc ^= cast(u32)it << 8;
        for i: 0..7 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF;
            } else {
                crc = (crc << 1) & 0xFFFF;
            }
        }
    }
    return cast(u16)(crc & 0xFFFF);
}

SlpFrame :: struct {
    dst: u8;
    src: u8;
    proto: u8;
    xid: u8;
    data: Vec(u8);
}

EncodeSlp :: (dst: u8, src: u8, proto: u8, xid: u8, body: []u8, out: *Vec(u8)) {
    VecClear(<<out);
    hdr: [10]u8;
    hdr[0] = 0xBE;
    hdr[1] = 0xEF;
    hdr[2] = 0xED;
    hdr[3] = dst;
    hdr[4] = src;
    hdr[5] = proto;
    hdr[6] = cast(u8)((body.count >> 8) & 0xFF);
    hdr[7] = cast(u8)(body.count & 0xFF);
    hdr[8] = xid;
    sum: u32 = 0;
    for i: 0..8 { sum += cast(u32)hdr[i] }
    hdr[9] = cast(u8)(sum & 0xFF);
    for hdr { VecPush(<<out, it) }
    crc := Crc16(hdr[:], 0);
    for body { VecPush(<<out, it) }
    crc = Crc16(body, crc);
    Put2(out, crc);
}

DecodeSlp :: (raw: []u8, frame: *SlpFrame) -> bool {
    VecClear(frame.data);
    if raw.count < SLPHDRLEN + 2 { return false }
    if raw[0] != 0xBE || raw[1] != 0xEF || raw[2] != 0xED { return false }
    sum: u32 = 0;
    for i: 0..8 { sum += cast(u32)raw[i] }
    if cast(u8)(sum & 0xFF) != raw[9] { return false }
    size := cast(s64)Get2(raw, 6);
    if raw.count < SLPHDRLEN + size + 2 { return false }
    crc := Crc16(raw[:SLPHDRLEN], 0);
    crc = Crc16(raw[SLPHDRLEN:SLPHDRLEN + size], crc);
    if crc != Get2(raw, SLPHDRLEN + size) { return false }
    frame.dst = raw[3];
    frame.src = raw[4];
    frame.proto = raw[5];
    frame.xid = raw[8];
    for i: 0..size - 1 { VecPush(frame.data, raw[SLPHDRLEN + i]) }
    return true;
}

CmpMsg :: struct {
    op: u8;
    flags: u8;
    major: u8;
    minor: u8;
    baud: u32;
}

EncodeCmp :: (m: CmpMsg, out: *Vec(u8)) {
    VecClear(<<out);
    VecPush(<<out, m.op);
    VecPush(<<out, m.flags);
    VecPush(<<out, m.major);
    VecPush(<<out, m.minor);
    VecPush(<<out, 0);
    VecPush(<<out, 0);
    Put4(out, m.baud);
}

DecodeCmp :: (raw: []u8, m: *CmpMsg) -> bool {
    if raw.count != CMPHDRLEN { return false }
    m.op = raw[0];
    m.flags = raw[1];
    m.major = raw[2];
    m.minor = raw[3];
    m.baud = Get4(raw, 6);
    return true;
}

EncodePadp :: (ptype: u8, flags: u8, size_or_off: u16, payload: []u8, out: *Vec(u8)) {
    VecClear(<<out);
    VecPush(<<out, ptype);
    VecPush(<<out, flags);
    Put2(out, size_or_off);
    for payload { VecPush(<<out, it) }
}

// DLP argument packing (matches Palm->packargs/unpackargs).
PackDlpReq :: (cmd: u8, argid: u8, arg: []u8, has_arg: bool, out: *Vec(u8)) {
    VecClear(<<out);
    VecPush(<<out, cmd);
    if !has_arg {
        VecPush(<<out, 0);
        return;
    }
    VecPush(<<out, 1);
    if arg.count < 256 {
        VecPush(<<out, argid);
        VecPush(<<out, cast(u8)arg.count);
    } else if arg.count < 65536 {
        VecPush(<<out, argid | 0x80);
        VecPush(<<out, 0);
        Put2(out, cast(u16)arg.count);
    } else {
        VecPush(<<out, argid | 0x40);
        VecPush(<<out, 0);
        Put4(out, cast(u32)arg.count);
    }
    for arg { VecPush(<<out, it) }
}

DlpErrorText :: (rc: s32) -> string {
    if rc == 0 { return "no error" }
    if rc == 1 { return "general Pilot system error" }
    if rc == 2 { return "unknown request" }
    if rc == 3 { return "out of dynamic memory on device" }
    if rc == 4 { return "invalid parameter" }
    if rc == 5 { return "not found" }
    if rc == 6 { return "no open databases" }
    if rc == 7 { return "database already open" }
    if rc == 8 { return "too many open databases" }
    if rc == 9 { return "database already exists" }
    if rc == 10 { return "cannot open database" }
    if rc == 11 { return "record previously deleted" }
    if rc == 12 { return "record busy" }
    if rc == 13 { return "operation not supported" }
    if rc == 14 { return "unexpected error (ErrUnused1)" }
    if rc == 15 { return "read only object" }
    if rc == 16 { return "not enough space" }
    if rc == 17 { return "size limit exceeded" }
    if rc == 18 { return "sync cancelled" }
    if rc == 19 { return "bad arg wrapper" }
    if rc == 20 { return "argument missing" }
    if rc == 21 { return "bad argument size" }
    return "unknown error";
}

// Decodes a DLP response header and first argument payload.
UnpackDlpReply :: (cmd: u8, reply: []u8, arg_out: *Vec(u8), err_out: *Text) -> bool {
    VecClear(<<arg_out);
    VecClear(err_out.bytes);
    if reply.count < 1 {
        BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
        return false;
    }
    r := reply[0];
    if (r & DLP_RESPONSE) == 0 {
        BuilderPrint(*err_out.bytes, "palm: received request #% not response", r);
        return false;
    }
    if r != (DLP_RESPONSE | cmd) {
        BuilderPrint(*err_out.bytes, "palm: wrong response #%", r);
        return false;
    }
    if reply.count < 4 {
        BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
        return false;
    }
    rc := cast(s32)Get2(reply, 2);
    if rc != 0 {
        BuilderPrint(*err_out.bytes, "palm: %", DlpErrorText(rc));
        return false;
    }
    argc := reply[1];
    if argc == 0 { return true }
    if reply.count < 6 {
        BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
        return false;
    }
    aid := reply[4];
    off: s64 = 6;
    alen: s64 = 0;
    if (aid & 0x80) != 0 {
        if reply.count < 8 {
            BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
            return false;
        }
        alen = cast(s64)Get2(reply, 6);
        off = 8;
    } else if (aid & 0x40) != 0 {
        if reply.count < 10 {
            BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
            return false;
        }
        alen = cast(s64)Get4(reply, 6);
        off = 10;
    } else {
        alen = cast(s64)reply[5];
        off = 6;
    }
    if off + alen > reply.count {
        BuilderAppend(err_out.bytes, "palm: desklink protocol: response too short");
        return false;
    }
    for i: 0..alen - 1 { VecPush(<<arg_out, reply[off + i]) }
    return true;
}

// Parses [cardno/]dbname, defaulting cardno to 0.
ParseDbName :: (name: string) -> (cardno: s32, dbname: string) {
    for i: 0..name.count - 1 {
        if name[i] == #char "/" {
            cno: s32 = 0;
            for j: 0..i - 1 {
                if name[j] >= #char "0" && name[j] <= #char "9" {
                    cno = cno * 10 + cast(s32)(name[j] - #char "0");
                }
            }
            return cno, name[i + 1:];
        }
    }
    return 0, name;
}

CStringSlice :: (b: []u8) -> string {
    end := b.count;
    for i: 0..b.count - 1 {
        if b[i] == 0 { end = i; break }
    }
    return TextView(b[:end]);
}
