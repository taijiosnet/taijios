    Proto.Put4(*arg, name);
    Proto.Put2(*arg, id);
    Proto.PackDlpReq(T_DELETE_RESOURCE, A1, arg[:], true, out);
}

DeleteResource :: (c: *Client, db: *OpenDB, name: u32, id: u16, err: *Text) -> bool {
