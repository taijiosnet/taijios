    Proto.PackDlpReq(T_READ_NEXT_MODIFIED_REC, A1, arg[:], true, out);
}

ReadNextModifiedRec :: (c: *Client, db: *OpenDB, rec: *Record, err: *Text) -> bool {
    req: [1]u8 = .[db.handle];
    body: Vec(u8);
    if !Exec(c, T_READ_NEXT_MODIFIED_REC, A1, req[:], true, 10, *body, err) { return false }
    return UnpackRec(body[:], rec);
}

PdbResetNext :: (c: *Client, db: *OpenDB, err: *Text) -> bool {
    req: [1]u8 = .[db.handle];
    out: Vec(u8);
    return Exec(c, T_RESET_DB_INDEX, A1, req[:], true, 0, *out, err);
}

PdbReadId :: (c: *Client, db: *OpenDB, id: u32, rec: *Record, err: *Text) -> bool {
    req: Vec(u8);
    VecPush(req, db.handle);
    VecPush(req, 0);
    Proto.Put4(*req, id);
    Proto.Put2(*req, 0);
    Proto.Put2(*req, MAXRECBYTES);
    body: Vec(u8);
    if !Exec(c, Proto.T_READ_RECORD, A1, req[:], true, 10, *body, err) { return false }
    return UnpackRec(body[:], rec);
}

PdbDeleteCat :: (c: *Client, db: *OpenDB, cat: u8, err: *Text) -> bool {
    req: [8]u8 = .[db.handle, 0x40, 0, 0, 0, 0, 0, cat];
    out: Vec(u8);
    return Exec(c, T_DELETE_RECORD, A1, req[:], true, 0, *out, err);
}

PdbTruncate :: (c: *Client, db: *OpenDB, err: *Text) -> bool {
    req: [8]u8 = .[db.handle, 0x80, 0, 0, 0, 0, 0, 0];
    out: Vec(u8);
    return Exec(c, T_DELETE_RECORD, A1, req[:], true, 0, *out, err);
}

PackWriteResourceReq :: (handle: u8, res: *Resource, out: *Vec(u8)) {
    arg: Vec(u8);
    VecPush(arg, handle);
    VecPush(arg, 0);
    Proto.Put4(*arg, res.name);
    Proto.Put2(*arg, res.id);
    Proto.Put2(*arg, cast(u16)res.data.count);
    for res.data { VecPush(arg, it) }
    Proto.PackDlpReq(T_WRITE_RESOURCE, A1, arg[:], true, out);
}

WriteResource :: (c: *Client, db: *OpenDB, res: *Resource, err: *Text) -> bool {
    req: Vec(u8);
    VecPush(req, db.handle);
    VecPush(req, 0);
    Proto.Put4(*req, res.name);
    Proto.Put2(*req, res.id);
    Proto.Put2(*req, cast(u16)res.data.count);
    for res.data { VecPush(req, it) }
    out: Vec(u8);
    return Exec(c, T_WRITE_RESOURCE, A1, req[:], true, 0, *out, err);
}

PrcWrite :: (c: *Client, db: *OpenDB, res: *Resource, err: *Text) -> bool {
    return WriteResource(c, db, res, err);
}

PackDeleteResourceReq :: (handle: u8, name: u32, id: u16, out: *Vec(u8)) {
