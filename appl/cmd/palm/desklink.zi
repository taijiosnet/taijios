    return Exec(c, T_RESET_SYNC_FLAGS, A1, req[:], true, 0, *out, err);
}

PackMoveCategoryReq :: (handle: u8, from_cat: u8, to_cat: u8, out: *Vec(u8)) {
    arg: [4]u8 = .[handle, from_cat, to_cat, 0];
    Proto.PackDlpReq(T_MOVE_CATEGORY, A1, arg[:], true, out);
}

MoveCategory :: (c: *Client, db: *OpenDB, from_cat: u8, to_cat: u8, err: *Text) -> bool {
