// env: list the guest environment, following appl/cmd/env.b.
#import "std/vec"
using Args :: #import "taijios_args";
using Cli :: #import "zx_cli";
using Files :: #import "taijios_files";
using Fs :: #import "taijios_stat";
using Io :: #import "taijios_io";

Usage :: "Usage: env\n";

CopyName :: (text: string) -> string { return TextDetach(TextCopy(text)) }

// The names in /env, in directory order, without duplicates.
EnvironmentNames :: (names: *Vec(string)) -> bool {
    handle := Io.OpenFile("/env", 0);
    if handle < 0 { return false }
    bytes: [Fs.BufferSize]u8;
    while true {
        size := Io.ReadBytes(handle, bytes[:]);
        if size < 0 { unused Io.CloseFile(handle); return false }
        if size == 0 { break }
        offset: s64;
        while offset < size {
            info := Fs.Decode(bytes[offset:size]);
            if info.size == 0 { unused Io.CloseFile(handle); return false }
            offset += info.size;
            seen := false;
            for i: 0..names.count-1 { if names.*[i] == info.name { seen = true; break } }
            if !seen && !VecPush(names.*, CopyName(info.name)) { unused Io.CloseFile(handle); return false }
        }
    }
    return Io.CloseFile(handle) >= 0;
}

#program_export
main :: () -> s32 {
    if Args.OperandCount() != 0 { return Cli.Usage(Usage) }
    names: Vec(string);
    if !EnvironmentNames(*names) {
        unused Cli.WriteAll(2, "env: cannot read /env: ");
        unused Cli.WriteAll(2, Io.LastError());
        unused Cli.WriteAll(2, "\n");
        unused Args.SetFailure("error");
        return 1;
    }
    for names {
        name := CopyName(it);
        unused Cli.WriteAll(1, name);
        unused Cli.WriteAll(1, "=");
        path: Vec(u8);
        unused BuilderAppend(path, "/env/");
        unused BuilderAppend(path, name);
        value: Text;
        if Files.ReadFile(BuilderFinish(path), *value, 1048576) >= 0 { unused Cli.WriteAll(1, TextView(value)) }
        unused Cli.WriteAll(1, "\n");
    }
    return 0;
}
