<../../../mkconfig

TARG=\
	cs.dis\
	dns.dis\
	registry.dis\

SYSMODULES=\
	sys.m\
	draw.m\
	bufio.m\
	arg.m\
	attrdb.m\
	ip.m\
	ipattr.m\
	styx.m\
	styxservers.m\

MODULES=\

DISBIN=$ROOT/dis/ndb

<$ROOT/mkfiles/mkdis

# Commands that exist only as ZX bundles.
ZXCOMMANDS=csquery dnsquery mkhash query regquery
ZXUTIL=ndb_client.zi ../zx_cli.zi ../zx_arg.zi ../zx_lines.zi ../taijios_args.zi ../taijios_io.zi ../../lib/taijios_quote.zi ../../lib/attrdb.zi ../../lib/attrhash.zi

install:V: ${ZXCOMMANDS:%=$DISBIN/%.zx}

&.zx: &.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --entry $stem:main -o $target $stem.zi

$DISBIN/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 "$stem.zx" "$staged" && mv "$staged" "$target"
