// regquery [-m mntpt] [-n] [attr val ...]: asks the registry's find file
// for the services that match the attributes, or each line read after a
// "> " prompt, and prints the replies. With -n it prints only each
// service's name.
#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";
using Arg :: #import "zx_arg";
using Lines :: #import "zx_lines";
using Quote :: #import "taijios_quote";

USAGE :: "usage: regquery [-m mntpt] [-n] [attr val attr val ...]\n";

// False when the find file cannot be opened, which ends the command.
Query :: (finder: string, query: string, names_only: bool) -> bool {
    fd := Io.OpenFile(finder, 2);
    if fd < 0 {
        message: Vec(u8);
        BuilderPrint(*message, "regquery: can't open %: %\n", finder, Io.LastError());
        unused Cli.WriteAll(2, BuilderFinish(message));
        unused Args.SetFailure("open");
        return false;
    }
    defer Io.CloseFile(fd);
    if Io.WriteBytes(fd, query) >= 0 {
        unused Io.SeekFile(fd, 0, 0);
        if names_only {
            reader: Lines.LineReader;
            reader.handle = fd;
            line: Vec(u8);
            while Lines.ReadLine(*reader, *line) {
                words: Vec(Text);
                Quote.Unquoted(TextView(line[:]), *words);
                if words.count > 0 { Cli.PrintLine(TextView(words[0])) }
            }
            return true;
        }
        reply: [8192]u8;
        count := Io.ReadBytes(fd, reply[:]);
        while count > 0 {
            unused Cli.WriteAll(1, TextView(reply[:count]));
            count = Io.ReadBytes(fd, reply[:]);
        }
        if count == 0 { return true }
    }
    failure: Vec(u8);
    BuilderPrint(*failure, "regquery: %\n", Io.LastError());
    unused Cli.WriteAll(2, BuilderFinish(failure));
    return true;
}

main :: () -> s32 {
    mount := "/mnt/registry";
    names_only := false;
    scan: Arg.Scan;
    letter := Arg.Option(*scan);
    while letter != 0 {
        if letter == #char "m" {
            value, ok := Arg.Value(*scan);
            if !ok { return Cli.Usage(USAGE) }
            mount = value;
        } else if letter == #char "n" {
            names_only = true;
        } else {
            return Cli.Usage(USAGE);
        }
        letter = Arg.Option(*scan);
    }
    path: Vec(u8);
    BuilderPrint(*path, "%/find", mount);
    finder := BuilderFinish(path);
    if scan.next < Args.OperandCount() {
        query: Vec(u8);
        while scan.next < Args.OperandCount() {
            if query.count > 0 { VecPush(query, #char " ") }
            Quote.Quote(*query, Args.Operand(scan.next));
            scan.next += 1;
        }
        return ifx Query(finder, TextView(query[:]), names_only) then 0 else 1;
    }
    reader: Lines.LineReader;
    line: Vec(u8);
    while true {
        unused Cli.WriteAll(1, "> ");
        if !Lines.ReadLine(*reader, *line) { break }
        // Like the Limbo command, drop the last character, newline or not.
        if !Query(finder, TextView(line[0:line.count - 1]), names_only) { return 1 }
    }
    return 0;
}
