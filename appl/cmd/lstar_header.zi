// Pure POSIX tar header decoding, ported from Inferno lstar.b (see NOTICE).
UTF :: #import "std/utf8";
#import "std/vec"

BlockSize :: 512;
BadMagic :: 1;
BadChecksum :: 2;
BadType :: 3;
HardLink :: 1;
SymbolicLink :: 2;
SpecialFile :: 3;

Header :: struct {
    // Views borrow the input block until its buffer is reused.
    name: string;
    prefix: string;
    link: string;
    size: s32;
    modified: s32;
    notice: s32;
    problem: s32;
    flag: u8;
    present: bool;
}

Octal :: (bytes: []u8) -> s32 {
    value: u32;
    for at: 0..bytes.count-1 {
        byte := bytes[at];
        if byte == #char " " { continue }
        if byte == 0 { break }
        // The old parser accepts all bytes and wraps a 32-bit int.
        value = value * 8 + cast(u32)byte - 48;
    }
    return cast(s32)value;
}

NullTerminated :: (bytes: []u8) -> string {
    end: s64;
    while end < bytes.count && bytes[end] != 0 { end += 1 }
    return TextView(bytes[:end]);
}

Decode :: (block: []u8) -> Header {
    header: Header;
    if block.count != BlockSize || block[0] == 0 { return header }
    header.present = true;
    header.name = NullTerminated(block[:100]);
    if block[345] != 0 { header.prefix = NullTerminated(block[345:500]) }
    if block[257] != 0 && TextView(block[257:262]) != "ustar" {
        header.problem = BadMagic;
        return header;
    }
    checksum := cast(u32)Octal(block[148:156]);
    for at: 0..BlockSize-1 {
        byte := ifx at >= 148 && at < 156 then #char " " else block[at];
        checksum -= cast(u32)byte;
    }
    if checksum != 0 { header.problem = BadChecksum; return header }
    header.flag = block[156];
    if header.flag == 0 || header.flag == #char "0" || header.flag == #char "5" || header.flag == #char "7" {
        header.size = Octal(block[124:136]);
        header.modified = Octal(block[136:148]);
    } else if header.flag == #char "1" {
        header.notice = HardLink;
        header.link = TextView(block[157:257]);
    } else if header.flag == #char "2" || header.flag == #char "s" { header.notice = SymbolicLink }
    else if header.flag == #char "3" || header.flag == #char "4" || header.flag == #char "6" { header.notice = SpecialFile }
    else { header.problem = BadType }
    return header;
}

// Match Limbo byte-to-string conversion and %s: replace malformed runes,
// discard an incomplete tail and stop at a NUL when printing a link field.
AppendText :: (output: *Vec(u8), text: string) {
    at: s32;
    while at < text.count && text[at] != 0 {
        byte := text[at];
        width := ifx byte < 0x80 then 1 else (ifx byte < 0xe0 then 2 else (ifx byte < 0xf0 then 3 else 4));
        if text.count - at < width { break }
        rune := UTF.Decode(text, at);
        if rune.valid { BuilderAppend(output.*, text[at:rune.after]) }
        else { BuilderAppend(output.*, "�") }
        at = rune.after;
    }
}
