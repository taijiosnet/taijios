// Native input adapter for the Inferno Tcl shell port. See ../../NOTICE (MIT).
#import "std/vec"
#import "std/byte_text_linux"
#import "std/stdio_linux"
#import "std/file"
using Timer :: #import "std/timer_linux"
using Tcl :: #import "tcl"
using Types :: #import "tcl_types"

LoadScript :: (context: s64, path: string, result: *Types.Result) {
    script, ok := ReadEntireFile(path);
    if ok && script.count <= 1048576 {
        if BuilderAppend(result.value.bytes, script) { return }
    }
    failure := Types.QuotedError("could not read Tcl script \"", path, "\"");
    result.code = failure.code;
    VecSwap(result.value.bytes, failure.value.bytes);
}

NativeMillis :: (context: s64) -> s64 { return Timer.MonotonicMilliseconds() }

Run :: (script: string) -> s32 {
    interpreter: Tcl.Interpreter;
    Tcl.SetSourceLoader(*interpreter, LoadScript);
    Tcl.SetClock(*interpreter, NativeMillis);
    result := Tcl.Eval(*interpreter, script);
    output: Text = Tcl.TakeOutput(*interpreter);
    WriteOutput(TextView(output));
    if result.code != .OK && result.code != .Exit {
        PrintError(TextView(result.value));
        PrintError("\n");
        return 1;
    }
    return 0;
}

main :: (argc: s32, argv: **u8) -> s32 {
    if argc > 2 { PrintError("usage: tclsh-ziran [script.tcl|-]\n"); return 2 }
    if argc == 2 {
        path := TextFromCString(argv[1]);
        if path != "-" {
            source, ok := ReadEntireFile(path);
            if !ok { PrintError("could not read Tcl script\n"); return 1 }
            return Run(source);
        }
    }
    source: Text = ReadStandardInput();
    return Run(TextView(source));
}
