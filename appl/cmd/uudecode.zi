// Decode uuencoded files, replacing the Limbo uudecode.
#import "std/vec"
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Fs :: #import "taijios_stat";
using Cli :: #import "zx_cli";

LineLength :: 45;

// The input read in blocks, so that lines can be taken one at a time.
Reader :: struct {
    handle: s32;
    buffer: [1024]u8;
    start: s64;
    end: s64;
    finished: bool;
}

// The next line with its newline, or false at the end of the input.
Line :: (reader: *Reader) -> (text: string, ok: bool) {
    line: Vec(u8);
    while true {
        if reader.start >= reader.end {
            if reader.finished { break }
            count := Io.ReadBytes(reader.handle, reader.buffer[:]);
            if count <= 0 {
                reader.finished = true;
                break;
            }
            reader.start = 0;
            reader.end = count;
        }
        byte := reader.buffer[reader.start];
        reader.start += 1;
        unused VecPush(line, byte);
        if byte == cast(u8)10 { break }
    }
    if line.count == 0 { return "", false }
    return TextDetach(BuilderFinish(line)), true;
}

// An owned copy of a part of a line that outlives it.
Copy :: (text: string) -> string {
    return TextDetach(TextCopy(text));
}

// Split on blanks and newlines, as sys->tokenize did.
Words :: (line: string, words: *Vec(string)) {
    start: s64 = -1;
    for i: 0..line.count-1 {
        byte := line[i];
        if byte == cast(u8)32 || byte == cast(u8)10 {
            if start >= 0 {
                unused VecPush(words.*, Copy(line[start:i]));
                start = -1;
            }
        } else if start < 0 {
            start = i;
        }
    }
    if start >= 0 { unused VecPush(words.*, Copy(line[start:])) }
}
// String->toint in base 8: blanks, a sign, then digits; 0 without digits.
OctalNumber :: (text: string) -> s32 {
    i: s64 = 0;
    while i < text.count && (text[i] == cast(u8)32 || text[i] == cast(u8)9 || text[i] == cast(u8)10) { i += 1 }
    negative := false;
    if i < text.count && (text[i] == cast(u8)45 || text[i] == cast(u8)43) {
        negative = text[i] == cast(u8)45;
        i += 1;
    }
    first := i;
    number: s32 = 0;
    while i < text.count && text[i] >= cast(u8)48 && text[i] <= cast(u8)55 {
        number = number * 8 + (cast(s32)text[i] - 48);
        i += 1;
    }
    if i == first { return 0 }
    if negative { return -number }
    return number;
}

// One encoded character back to its six bits.
Code :: (byte: u8) -> s32 {
    return (cast(s32)byte - 32) & 0x3f;
}

// Print a diagnostic and report failure, as the Limbo fatal did.
Fatal :: (text: string) -> bool {
    unused Cli.WriteAll(2, text);
    unused Cli.WriteAll(2, "\n");
    return false;
}

// A diagnostic made of a prefix, a name and the host's reason.
Problem :: (before: string, name: string, reason: string) -> bool {
    message: Vec(u8);
    unused BuilderAppend(message, before);
    unused BuilderAppend(message, name);
    if name.count > 0 {
        unused BuilderAppend(message, ": ");
    }
    unused BuilderAppend(message, reason);
    return Fatal(BuilderFinish(message));
}

// Decode one input to the standard output or to the named file.
Decode :: (handle: s32, tostdout: bool) -> bool {
    reader: Reader;
    reader.handle = handle;
    mode: u32 = 0;
    ofile: string = "";
    begun := false;
    while true {
        line, ok := Line(*reader);
        if !ok { break }
        if line.count >= 6 && line[0:6] == "begin " {
            words: Vec(string);
            Words(line, *words);
            if words.count < 3 { return Fatal("bad begin line") }
            mode = cast(u32)OctalNumber(words[1]);
            ofile = Copy(words[2]);
            begun = true;
            break;
        }
    }
    if !begun { return Fatal("no begin line") }
    output: s32 = 1;
    if !tostdout {
        if ofile.count > 0 && ofile[0] == cast(u8)126 {
            path: Vec(u8);
            BuilderPrint(*path, "/usr/%", ofile[1:]);
            ofile = BuilderFinish(path);
        }
        output = Io.Create(ofile, 1, 0x1b6);
        if output < 0 { return Problem("cannot create ", ofile, Io.LastError()) }
    }
    while true {
        line, ok := Line(*reader);
        if !ok { break }
        n := Code(line[0]);
        if n == 0 && (line.count != 2 || line[1] != cast(u8)10) {
            return Fatal("bad 0 count line");
        }
        if n <= 0 { break }
        if n > LineLength { return Fatal("too many bytes on line") }
        least: s32 = 0;
        most: s32 = 0;
        if n % 3 == 1 {
            least = 2;
            most = 4;
        } else if n % 3 == 2 {
            least = 3;
            most = 4;
        }
        groups := n / 3;
        if line.count < 4 * groups + least + 2 || line.count > 4 * groups + most + 2 {
            return Fatal("bad uuencode count");
        }
        out: Vec(u8);
        at: s64 = 1;
        left := n;
        while left > 0 {
            a := Code(line[at]);
            b := Code(line[at+1]);
            c := Code(line[at+2]);
            d := Code(line[at+3]);
            unused VecPush(out, cast(u8)((a << 2) | (b >> 4)));
            if left >= 2 { unused VecPush(out, cast(u8)((b << 4) | (c >> 2))) }
            if left >= 3 { unused VecPush(out, cast(u8)((c << 6) | d)) }
            at += 4;
            left -= 3;
        }
        if !Cli.WriteAll(output, BuilderFinish(out)) {
            return Problem("bad write to output", "", Io.LastError());
        }
    }
    line, ok := Line(*reader);
    if !ok || line.count < 4 || line[0:4] != "end\n" { return Fatal("missing end line") }
    if !tostdout {
        if !Fs.Change(output, .{mode = mode}, true, false, false, false) {
            return Problem("cannot wstat ", ofile, Io.LastError());
        }
    }
    return true;
}

#program_export
main :: () -> s32 {
    count := Args.OperandCount();
    next: s32 = 0;
    tostdout := false;
    if count > 0 && Args.Operand(0) == "-p" {
        tostdout = true;
        next = 1;
    }
    if next < count {
        for i: next..count-1 {
            name := Args.Operand(i);
            handle := Io.OpenFile(name, 0);
            if handle < 0 {
                message: Vec(u8);
                BuilderPrint(*message, "cannot open %", name);
                unused Fatal(BuilderFinish(message));
                return 0;
            }
            if !Decode(handle, tostdout) { return 0 }
            unused Io.CloseFile(handle);
        }
    } else {
        if !Decode(0, tostdout) { return 0 }
    }
    return 0;
}
