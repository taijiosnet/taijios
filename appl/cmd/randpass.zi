// Print a random password of base64 digits, replacing the Limbo randpass.
// Limbo made IPint.random(length*8) and printed the first length characters
// of its base64 form; BigRandom and BigConvert run the same libmp code.
#import "std/vec"
using Args :: #import "taijios_args";
using Cli :: #import "zx_cli";
using Kr :: #import "taijios_keyring";

Usage :: "Usage: randpass [password-length(<256, default=16)]\n";

// Every character a decimal digit, as Limbo isnumeric required.
Digits :: (text: string) -> bool {
    for i: 0..text.count-1 {
        if text[i] < cast(u8)48 || text[i] > cast(u8)57 { return false }
    }
    return text.count > 0;
}

#program_export
main :: () -> s32 {
    length: s64 = 16;
    if Args.OperandCount() > 0 {
        text := Args.Operand(0);
        if !Digits(text) { return Cli.Usage(Usage) }
        length = 0;
        for i: 0..text.count-1 {
            if length <= 1000000 { length = length * 10 + cast(s64)(text[i] - cast(u8)48) }
        }
        if length <= 8 || length > 256 { return Cli.Usage(Usage) }
    }
    hex: [1024]u8;
    got := Kr.BigRandom(cast(s32)(length * 8), hex[:]);
    if got <= 0 {
        unused Args.SetFailure("random failed");
        return 1;
    }
    encoded: [512]u8;
    count := Kr.BigConvert(TextView(hex[:got]), 16, 64, encoded[:]);
    if count <= 0 {
        unused Args.SetFailure("random failed");
        return 1;
    }
    if cast(s64)count > length { count = cast(s32)length }
    unused Cli.WriteAll(1, TextView(encoded[:count]));
    unused Cli.WriteAll(1, "\n");
    return 0;
}
