<../../../mkconfig

DIRS=\
	factotum\

TARG=\
	ai2key.dis\
	changelogin.dis\
	countersigner.dis\
	convpasswd.dis\
	createsignerkey.dis\
	dsagen.dis\
	keyfs.dis\
	keysrv.dis\
	getpk.dis\
	logind.dis\
	mkauthinfo.dis\
	passwd.dis\
	rsagen.dis\
	secstore.dis\
	signer.dis\
	verify.dis\

SYSMODULES=\
	arg.m\
	keyring.m\
	security.m\
	rand.m\
	sys.m\
	draw.m\
	bufio.m\
	string.m\
	styx.m\
	styxservers.m\

DISBIN=$ROOT/dis/auth

<$ROOT/mkfiles/mkdis
<$ROOT/mkfiles/mksubdirs

ZXCOMMANDS=aescbc
ZXUTIL=../zx_cli.zi ../zx_arg.zi ../taijios_args.zi ../taijios_io.zi ../taijios_keyring.zi ../../lib/taijios_quote.zi

install:V: ${ZXCOMMANDS:%=$DISBIN/%.zx}

&.zx: &.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_keyring --entry $stem:main -o $target $stem.zi

$DISBIN/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 "$stem.zx" "$staged" && mv "$staged" "$target"
