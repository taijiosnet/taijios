<../../../mkconfig

DIRS=\
	factotum\

TARG=\
	changelogin.dis\
	convpasswd.dis\
	keyfs.dis\
	keysrv.dis\
	logind.dis\
	mkauthinfo.dis\
	passwd.dis\
	secstore.dis\
	signer.dis\

SYSMODULES=\
	arg.m\
	keyring.m\
	security.m\
	rand.m\
	sys.m\
	draw.m\
	bufio.m\
	string.m\
	styx.m\
	styxservers.m\

DISBIN=$ROOT/dis/auth

<$ROOT/mkfiles/mkdis
<$ROOT/mkfiles/mksubdirs

ZXCOMMANDS=aescbc rsagen dsagen getpk ai2key verify countersigner createsignerkey
ZXUTIL=keygen.zi authinfo.zi keydb.zi ../zx_cli.zi ../zx_arg.zi ../taijios_args.zi ../taijios_io.zi ../taijios_keyring.zi ../taijios_clock.zi ../taijios_time.zi ../taijios_files.zi ../../lib/taijios_quote.zi

install:V: ${ZXCOMMANDS:%=$DISBIN/%.zx}

# ai2key reads the clock, verify and countersigner only files, the others
# use the cryptography, and createsignerkey also the clock and time zone.
&.zx: &.zi $ZXUTIL
	binds='--bind-host taijios_keyring'
	case $stem in
	ai2key) binds='--bind-host taijios_clock' ;;
	verify|countersigner) binds= ;;
	createsignerkey) binds='--bind-host taijios_keyring --bind-host taijios_clock --bind-host taijios_files' ;;
	esac
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io $binds --entry $stem:main -o $target $stem.zi

$DISBIN/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 "$stem.zx" "$staged" && mv "$staged" "$target"
