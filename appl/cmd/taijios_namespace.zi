// Guest namespace calls for ZX file servers and the programs that mount them.
// Handles are taijios_io handles. A call that returns -1 leaves its reason in Error.
host_api :: #system_library "host_api";

#scope_export
// Mount and bind flags, as in Sys. Add AllowCreate to Replace, Before or After.
Replace :: 0;
Before :: 1;
After :: 2;
AllowCreate :: 4;
Cache :: 16;

// Create a pipe and store its two handles. What is written to either end is
// read from the other. Returns 0, or -1 with the slice unchanged.
Pipe :: (ends: []s32) -> s32 #foreign host_api;

// Attach the 9P server that answers on a handle at the name `old`. The handle
// must be open for reading and writing. `afd` is an authentication handle or
// -1. The call waits for the server's version and attach replies, so the
// server has to run in another process. Returns 0 or -1.
Mount :: (fd: s32, afd: s32, old: string, flags: s32, aname: string) -> s32 #foreign host_api;

// Start Mount beside the caller and return a positive ticket, or -1. A file
// server uses this to attach its own tree: it answers the version and attach
// requests on the other end of the pipe itself. The handles may be closed
// right away. MountDone returns -2 while the mount is still waiting for the
// server, or waits for it to finish if asked; 0 or -1 retires the ticket.
MountAsync :: (fd: s32, afd: s32, old: string, flags: s32, aname: string) -> s32 #foreign host_api;
MountDone :: (ticket: s32, wait: bool) -> s32 #foreign host_api;

// Serve the names under `dir` to the 9P client on a handle, as Sys export
// does. With `wait` the call returns when the client is gone; without it the
// service runs beside the caller. Returns 0 or -1.
Export :: (fd: s32, dir: string, wait: bool) -> s32 #foreign host_api;

// Make the file or directory `new` appear at `old`. Returns 0 or -1.
Bind :: (new: string, old: string, flags: s32) -> s32 #foreign host_api;

// Undo a mount or bind at `old`. An empty `source` removes everything
// attached there; otherwise only that file or directory. Returns 0 or -1.
Unmount :: (source: string, old: string) -> s32 #foreign host_api;

// Give the calling process a private copy of its namespace, as pctl FORKNS
// does. Its later mounts and binds stay out of its parent's namespace, and
// the children it starts afterwards share the copy. A child that should not
// change its parent's namespace calls this first.
Fork :: () -> bool #foreign host_api;

// Give the calling process a namespace whose root is its current directory,
// as pctl NEWNS does. Devices stay forbidden if NoDevs was called.
NewNs :: () -> bool #foreign host_api;

// Forbid attaching devices by # name, as pctl NODEVS does, except pipes (#|),
// the environment (#e), file2chan space (#s) and the secure-socket devices.
// Like pctl, it changes the namespace the caller shares: call Fork first to
// keep the restriction to the caller and its later children.
NoDevs :: () -> bool #foreign host_api;

// Give the calling process its own copy of the environment, as pctl FORKENV
// does. ZX children share their parent's environment, so a child that sets
// variables only for itself, such as a shell, calls this first.
ForkEnv :: () -> bool #foreign host_api;

Error :: () -> string #foreign host_api;

// Read one raw bind/mount/cd record from a native ZX process namespace.
// Initialize cursor[0] to zero; it becomes -1 after cd. Returns the bytes
// written, zero at EOF, or -1 with Error set and cursor unchanged. A live
// native PID is required; Dis callers read /prog/PID/ns through taijios_io.
Read :: (pid: s32, cursor: []s64, output: []u8) -> s32 #foreign host_api;
