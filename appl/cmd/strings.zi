// Print runs of printable bytes with their offsets, replacing the Limbo strings.
#import "std/vec"
#import "std/number_text"
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";

Minimum :: 6;
Line :: 70;

Printable :: (byte: u8) -> bool {
    return (byte >= 32 && byte < 127) || byte > 160;
}

// Eight-wide right-aligned offset, as Limbo's %8bd printed it.
Offset :: (out: *Vec(u8), value: s64) {
    digits: [24]u8;
    number := FormatInteger(value, digits[:]);
    for i: number.count..7 { unused BuilderAppend(<<out, " "); }
    unused BuilderAppend(<<out, number);
}

// One line of a run, with " ..." when the run continues past the buffer.
Emit :: (start: s64, data: []u8, more: bool) {
    line: Vec(u8);
    Offset(*line, start);
    unused BuilderAppend(line, ": ");
    unused BuilderAppend(line, TextView(data));
    if more { unused BuilderAppend(line, " ..."); }
    unused BuilderAppend(line, "\n");
    unused Cli.WriteAll(1, BuilderFinish(line));
}

// Scan one stream, printing each run of at least six printable bytes.
Scan :: (handle: s32) {
    data: [Line]u8;
    count: s64 = 0;
    start: s64 = -1;
    position: s64 = 0;
    one: [1]u8;
    while true {
        got := Io.ReadBytes(handle, one[:]);
        if got <= 0 { break; }
        here := position;
        position += 1;
        if Printable(one[0]) {
            if start < 0 { start = here; }
            data[count] = one[0];
            count += 1;
            if count == Line {
                Emit(start, data[:count], true);
                start = -1;
                count = 0;
            }
        } else {
            if count >= Minimum { Emit(start, data[:count], false); }
            start = -1;
            count = 0;
        }
    }
    if count >= Minimum { Emit(start, data[:count], false); }
}

#program_export
main :: () -> s32 {
    count := Args.OperandCount();
    if count == 0 {
        Scan(0);
        return 0;
    }
    for i: 0..count-1 {
        name := Args.Operand(i);
        if count > 1 {
            unused Cli.WriteAll(1, name);
            unused Cli.WriteAll(1, ":\n");
        }
        if name.count == 0 {
            Scan(0);
            continue;
        }
        handle := Io.OpenFile(name, 0);
        if handle < 0 {
            unused Cli.WriteAll(2, "cannot open ");
            unused Cli.WriteAll(2, name);
            unused Cli.WriteAll(2, "\n");
            continue;
        }
        Scan(handle);
        unused Io.CloseFile(handle);
    }
    return 0;
}
