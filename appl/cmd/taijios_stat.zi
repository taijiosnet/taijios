// Packed guest Dir records use the same format as Inferno directory reads.
using Io :: #import "taijios_io";

Directory :: 0x80000000;
AppendOnly :: 0x40000000;
Exclusive :: 0x20000000;
Authentication :: 0x08000000;
Temporary :: 0x04000000;
FixedSize :: 49;
ModeAt :: 21;
AccessedAt :: 25;
ModifiedAt :: 29;
NamesAt :: 41;
BufferSize :: 8192;

Identity :: struct { dev: u64; qid: u64; version: u64; qtype: u8; }
Info :: struct {
    identity: Identity;
    mode: u32;
    accessed: s32;
    modified: s32;
    length: s64;
    name: string;
    owner: string;
    group: string;
    modifier: string;
    size: s64;
}

SameFile :: (a: Identity, b: Identity) -> bool {
    return a.dev == b.dev && a.qid == b.qid && a.version == b.version && a.qtype == b.qtype;
}

Uint :: (data: []u8, offset: s64, bytes: s64) -> u64 {
    value: u64;
    for i: 0..bytes-1 { value |= cast(u64)data[offset+i] << cast(u64)(8*i) }
    return value;
}

Put :: (data: []u8, offset: s64, bytes: s64, value: u64) {
    for i: 0..bytes-1 { data[offset+i] = cast(u8)(value >> cast(u64)(8*i)) }
}

Name :: (data: []u8, offset: s64) -> (text: string, next: s64) {
    if offset + 2 > data.count { return "", -1 }
    start := offset + 2;
    end := start + cast(s64)Uint(data, offset, 2);
    if end > data.count { return "", -1 }
    return TextView(data[start:end]), end;
}

Decode :: (data: []u8) -> Info {
    if data.count < FixedSize { return .{} }
    size := cast(s64)Uint(data, 0, 2) + 2;
    if size < FixedSize || size > data.count { return .{} }
    record := data[:size];
    name, next := Name(record, NamesAt);
    if next < 0 { return .{} }
    owner, group_at := Name(record, next);
    if group_at < 0 { return .{} }
    group, modifier_at := Name(record, group_at);
    if modifier_at < 0 { return .{} }
    modifier, end := Name(record, modifier_at);
    if end != size { return .{} }
    identity := Identity.{dev = Uint(record, 2, 6), qid = Uint(record, 13, 8),
                          version = Uint(record, 9, 4), qtype = record[8]};
    return .{identity = identity, mode = cast(u32)Uint(record, ModeAt, 4),
             accessed = cast(s32)Uint(record, AccessedAt, 4),
             modified = cast(s32)Uint(record, ModifiedAt, 4), length = cast(s64)Uint(record, 33, 8),
             name = name, owner = owner, group = group, modifier = modifier, size = size};
}

PathInfo :: (path: string, bytes: []u8) -> Info {
    size := Io.StatPacked(path, bytes);
    if size <= 0 { return .{} }
    return Decode(bytes[:size]);
}

DescriptorInfo :: (handle: s32, bytes: []u8) -> Info {
    size := Io.FstatPacked(handle, bytes);
    if size <= 0 { return .{} }
    return Decode(bytes[:size]);
}

PutName :: (data: []u8, offset: s64, name: string) -> s64 {
    Put(data, offset, 2, cast(u64)name.count);
    for i: 0..name.count-1 { data[offset + 2 + i] = name[i] }
    return offset + 2 + name.count;
}

// Inferno wstat ignores fields filled with all ones and empty strings.
Change :: (handle: s32, source: Info, mode: bool, modified: bool, owner: bool, group: bool) -> bool {
    if !mode && !modified && !owner && !group { return true }
    user := ifx owner then source.owner else "";
    team := ifx group then source.group else "";
    bytes: [BufferSize]u8;
    size := FixedSize + user.count + team.count;
    if size > bytes.count { return false }
    for i: 2..NamesAt-1 { bytes[i] = 0xff }
    Put(bytes[:], 0, 2, cast(u64)(size - 2));
    if mode { Put(bytes[:], ModeAt, 4, cast(u64)source.mode) }
    if modified { Put(bytes[:], ModifiedAt, 4, cast(u64)cast(u32)source.modified) }
    next := PutName(bytes[:], NamesAt, "");
    next = PutName(bytes[:], next, user);
    next = PutName(bytes[:], next, team);
    unused PutName(bytes[:], next, "");
    return Io.WstatPacked(handle, TextView(bytes[:size])) >= 0;
}
