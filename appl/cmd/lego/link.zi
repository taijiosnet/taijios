// Lego RCX infrared link command over /net/legolink (replaces appl/cmd/lego/link.b + timers.b).
Args :: #import "taijios_args";
IO :: #import "taijios_io";
Service :: #import "legolink_service";

main :: () -> s32 {
    if Args.OperandCount() != 1 {
        unused IO.Write(1, "usage: lego/link portnum\n");
        return 0;
    }
    return Service.Run(Args.Operand(0));
}
