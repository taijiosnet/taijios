// Lego RCX infrared link service over /net/legolink, shared by lego/link and demo legolink.
IO :: #import "taijios_io";
Namespace :: #import "taijios_namespace";
Clock :: #import "taijios_clock";
F2C :: #import "taijios_file2chan";
#import "std/format"
#import "std/vec"

POLLDONT :: 0
POLLNOW :: 0x02
POLLDO :: 0x04

TX_HDR :: 3
DL_HDR :: 5
LN_HDR :: 1
LN_JUNK :: 2
LN_LEN :: 2
LN_RXLEN :: 2
LN_POLLMASK :: 0x06
LN_COMPMASK :: 0x08

rdfd: s32 = -1;
wrfd: s32 = -1;
overrun: Vec(u8);
errormsg: Vec(u8);

WriteOut :: (s: string) {
    if s.count > 0 { unused IO.Write(1, s) }
}

ParseInt :: (s: string) -> s32 {
    val: s32 = 0;
    for i: 0..s.count - 1 {
        c := cast(u8)s[i];
        if c < 48 || c > 57 { break }
        val = val * 10 + cast(s32)(c - 48);
    }
    return val;
}

SetErr :: (s: string) {
    VecClear(errormsg);
    unused BuilderAppend(errormsg, s);
}

RLEncode :: (data: []u8, out: *Vec(u8)) {
    VecClear(out.*);
    srcix: s64 = 0;
    val: s32 = 0;
    nextval: s32 = -1;
    n0: s32 = 0;

    while srcix < data.count || nextval != -1 {
        if nextval != -1 {
            val = nextval;
            nextval = -1;
        } else {
            val = cast(s32)data[srcix];
            if val == 0x88 { nextval = 0 }
            if val == 0 {
                n0 += 1;
                srcix += 1;
                if srcix < data.count && n0 < 0xFF + 2 { continue }
            }
            if n0 == 0 {
                srcix += 1;
            } else if n0 == 1 {
                val = 0;
                nextval = -1;
                n0 = 0;
            } else if n0 == 2 {
                val = 0;
                nextval = 0;
                n0 = 0;
            } else {
                val = 0x88;
                nextval = n0 - 2;
                n0 = 0;
            }
        }
        VecPush(out.*, cast(u8)(val & 0xFF));
    }
}

RLDecode :: (data: []u8, out: *Vec(u8)) -> bool {
    VecClear(out.*);
    srcix: s64 = 0;
    n0: s32 = 0;
    val: u8 = 0;

    while srcix < data.count || n0 > 0 {
        if n0 > 0 {
            n0 -= 1;
        } else {
            val = data[srcix];
            srcix += 1;
            if val == 0x88 {
                if srcix >= data.count { return false }
                n0 = cast(s32)data[srcix];
                srcix += 1;
                if n0 > 0 {
                    n0 += 2;
                    val = 0;
                    continue;
                }
            }
        }
        VecPush(out.*, val);
    }
    return true;
}

NBRead :: (ms: s64, n: s64, out: *Vec(u8)) -> bool {
    VecClear(out.*);
    if overrun.count > 0 {
        take := overrun.count;
        if take > n { take = n }
        for i: 0..take - 1 { VecPush(out.*, overrun[i]) }
        rem := overrun.count - take;
        for i: 0..rem - 1 { overrun[i] = overrun[take + i] }
        VecResize(overrun, rem);
        if out.count >= n { return true }
    }
    buf: [64]u8;
    deadline := Clock.Millis() + ms;
    while out.count < n {
        want := n - out.count;
        if want > buf.count { want = buf.count }
        r := IO.PollRead(rdfd, buf[:want]);
        if r > 0 {
            for i: 0..cast(s64)r - 1 { VecPush(out.*, buf[i]) }
            deadline = Clock.Millis() + ms;
        } else if r == -2 {
            if Clock.Millis() >= deadline { break }
        } else {
            break;
        }
    }
    return out.count > 0;
}

Consume :: () {
    tmp: Vec(u8);
    while NBRead(300, 1024, *tmp) {}
}

DataSend :: (seqnum_in: s32, data_in: []u8, startup: bool, out_reply: *Vec(u8)) -> (poll_out: s32, err_out: string) {
    VecClear(out_reply.*);
    if startup {
        dummy: [4]u8 = .[255, 0, 255, 0];
        unused IO.Write(wrfd, TextView(dummy[:]));
        tmp: Vec(u8);
        unused NBRead(100, 100, *tmp);
    }
    seqnum := seqnum_in & 1;
    docomp := false;
    payload: Vec(u8);
    if data_in.count > 0 {
        comp: Vec(u8);
        RLEncode(data_in, *comp);
        if comp.count < data_in.count {
            docomp = true;
            for i: 0..comp.count - 1 { VecPush(payload, comp[i]) }
        } else {
            for i: 0..data_in.count - 1 { VecPush(payload, data_in[i]) }
        }
    }

    llen := LN_HDR + payload.count;
    blklen := LN_LEN + llen - 1;
    ldata: Vec(u8);
    VecResize(ldata, DL_HDR + blklen + 1);

    ldata[0] = ifx seqnum == 0 then cast(u8)0x45 else cast(u8)0x4d;
    ldata[1] = 0;
    ldata[2] = 0;
    ldata[3] = cast(u8)(blklen & 0xFF);
    ldata[4] = cast(u8)((blklen >> 8) & 0xFF);
    ldata[5] = cast(u8)(llen & 0xFF);
    ldata[6] = cast(u8)((llen >> 8) & 0xFF);
    lhval: u8 = 0;
    if seqnum == 1 { lhval = lhval | 0x01 }
    if docomp { lhval = lhval | 0x08 }
    ldata[7] = lhval;
    for i: 0..payload.count - 1 { ldata[8 + i] = payload[i] }

    rcxlen := TX_HDR + 2 * (ldata.count + 1);
    rcxdata: Vec(u8);
    VecResize(rcxdata, rcxlen);
    rcxdata[0] = 0x55;
    rcxdata[1] = 0xFF;
    rcxdata[2] = 0x00;
    rcix: s64 = TX_HDR;
    cksum: u32 = 0;
    for i: 0..ldata.count - 1 {
        b := ldata[i];
        rcxdata[rcix] = b;
        rcxdata[rcix + 1] = ~b;
        rcix += 2;
        cksum += cast(u32)b;
    }
    rcxdata[rcix] = cast(u8)(cksum & 0xFF);
    rcxdata[rcix + 1] = cast(u8)((~cksum) & 0xFF);

    err: string = "";
    reply: Vec(u8);
    for try: 0..7 {
        if err.count > 0 {
            msg: Vec(u8);
            BuilderPrint(*msg, "Try % (lasterr %)\n", try, err);
            WriteOut(TextView(msg[:]));
        }
        err = "";
        step: s64 = 8;
        i: s64 = 0;
        while err.count == 0 && i < rcxlen {
            if i + step > rcxlen { step = rcxlen - i }
            if IO.Write(wrfd, TextView(rcxdata[i:i + step])) != cast(s32)step {
                return 0, "hangup";
            }
            ok := NBRead(300, step, *reply);
            if !ok || reply.count != step {
                err = "tower not responding";
            }
            if err.count == 0 {
                for ei: 0..step - 1 {
                    if reply[ei] != rcxdata[i + ei] {
                        err = "serial comms error";
                        break;
                    }
                }
            }
            i += step;
        }
        if err.count > 0 {
            Consume();
            continue;
        }

        replen: s64 = TX_HDR + LN_JUNK + 2 * LN_RXLEN;
        ok := NBRead(300, replen, *reply);
        if !ok || reply.count != replen {
            err = "brick not responding";
            Consume();
            continue;
        }
        if reply[0] != 0x55 || reply[1] != 0xFF || reply[2] != 0 ||
            reply[5] != ~reply[6] || reply[7] != ~reply[8] {
            err = "bad reply from brick";
            Consume();
            continue;
        }
        replen = cast(s64)reply[5] + (cast(s64)reply[7] << 8) + 1;
        cksum = cast(u32)reply[3] + cast(u32)reply[5] + cast(u32)reply[7];
        ok2 := NBRead(200, replen * 2, *reply);
        if !ok2 || reply.count != replen * 2 {
            err = "short reply from brick";
            Consume();
            continue;
        }
        cksum += cast(u32)reply[0];
        for ri: 1..replen - 1 {
            reply[ri] = reply[2 * ri];
            cksum += cast(u32)reply[ri];
        }
        cksum -= cast(u32)reply[replen - 1];
        if reply[replen - 1] != cast(u8)(cksum & 0xFF) {
            err = "bad checksum from brick";
            Consume();
            continue;
        }
        if (reply[0] & 1) != cast(u8)(seqnum & 1) {
            err = "bad seqnum from brick";
            continue;
        }

        lnhdr := cast(s32)reply[0];
        poll := lnhdr & LN_POLLMASK;
        if replen > 2 {
            if (lnhdr & LN_COMPMASK) != 0 {
                if !RLDecode(reply[1:replen - 1], out_reply) {
                    err = "bad brick msg compression";
                    continue;
                }
            } else {
                for ri: 1..replen - 2 { VecPush(out_reply.*, reply[ri]) }
            }
        }
        return poll, "";
    }
    return 0, err;
}

OpenSerialPort :: (port: s32) -> (ok: bool, err: string) {
    serport: Vec(u8);
    BuilderPrint(*serport, "/dev/eia%", cast(s64)port);
    serctl: Vec(u8);
    BuilderPrint(*serctl, "/dev/eia%ctl", cast(s64)port);

    rfd := IO.Open(TextView(serport[:]), 0);
    if rfd < 0 { return false, "cannot read serial port" }
    wfd := IO.Open(TextView(serport[:]), 1);
    if wfd < 0 {
        unused IO.Close(rfd);
        return false, "cannot write serial port";
    }
    ctlfd := IO.Open(TextView(serctl[:]), 1);
    if ctlfd < 0 {
        unused IO.Close(rfd);
        unused IO.Close(wfd);
        return false, "cannot open serial ctl";
    }
    cfg: [7]string = .["b2400", "l8", "po", "m0", "s1", "d1", "r1"];
    for i: 0..6 {
        if IO.Write(ctlfd, cfg[i]) <= 0 {
            unused IO.Close(ctlfd);
            unused IO.Close(rfd);
            unused IO.Close(wfd);
            return false, "serial config failed";
        }
    }
    unused IO.Close(ctlfd);
    rdfd = rfd;
    wrfd = wfd;
    return true, "";
}

Run :: (port: string) -> s32 {
    portnum := ParseInt(port);
    ok, err := OpenSerialPort(portnum);
    if !ok {
        msg: Vec(u8);
        BuilderPrint(*msg, "%\n", err);
        WriteOut(TextView(msg[:]));
        return 0;
    }

    if Namespace.Bind("#s", "/net", Namespace.Before) == -1 {
        msg: Vec(u8);
        BuilderPrint(*msg, "failed to bind srv device: %\n", Namespace.Error());
        WriteOut(TextView(msg[:]));
        return 0;
    }

    srv: F2C.File;
    if !F2C.Create(*srv, "/net", "legolink") {
        msg: Vec(u8);
        BuilderPrint(*msg, "cannot create legolink channel: %\n", IO.Error());
        WriteOut(TextView(msg[:]));
        return 0;
    }

    Consume();

    rdfid: s32 = -1;
    wrfid: s32 = -1;
    rxbuf: Vec(u8);
    has_pending_read := false;
    pending_read: F2C.Request;

    seqnum: s32 = 0;
    starttower := true;
    tower_deadline := Clock.Millis() + 1500;
    poll_active := false;
    poll_deadline: s64 = 0;

    req: F2C.Request;
    reply: Vec(u8);

    while true {
        now := Clock.Millis();
        if now >= tower_deadline {
            starttower = true;
            tower_deadline = now + 1500;
        }
        if poll_active && now >= poll_deadline {
            poll_active = false;
            empty: [0]u8;
            poll, derr := DataSend(seqnum, empty[:], starttower, *reply);
            seqnum += 1;
            starttower = false;
            tower_deadline = Clock.Millis() + 1500;
            if derr.count > 0 {
                SetErr(derr);
                if has_pending_read {
                    unused F2C.ReplyError(*srv, *pending_read, TextView(errormsg[:]));
                    has_pending_read = false;
                }
                break;
            }
            for i: 0..reply.count - 1 { VecPush(rxbuf, reply[i]) }
            if poll == POLLDO {
                poll_active = true;
                poll_deadline = Clock.Millis() + 250;
            }
        }

        if has_pending_read && rxbuf.count > 0 {
            cnt := cast(s64)pending_read.count;
            if cnt > rxbuf.count { cnt = rxbuf.count }
            unused F2C.ReplyRead(*srv, *pending_read, rxbuf[:cnt]);
            rem := rxbuf.count - cnt;
            for i: 0..rem - 1 { rxbuf[i] = rxbuf[cnt + i] }
            VecResize(rxbuf, rem);
            has_pending_read = false;
        }

        wait := !poll_active && !has_pending_read;
        st := F2C.Next(*srv, *req, wait);
        if st < 0 { break }
        if st == 0 { continue }

        if req.kind == F2C.Close {
            if req.fid == rdfid { rdfid = -1; has_pending_read = false }
            if req.fid == wrfid { wrfid = -1 }
        } else if req.kind == F2C.Read {
            if rdfid == -1 { rdfid = req.fid }
            if req.fid != rdfid {
                unused F2C.ReplyError(*srv, *req, "file in use");
                continue;
            }
            if errormsg.count > 0 {
                unused F2C.ReplyError(*srv, *req, TextView(errormsg[:]));
                break;
            }
            if rxbuf.count > 0 {
                cnt := cast(s64)req.count;
                if cnt > rxbuf.count { cnt = rxbuf.count }
                unused F2C.ReplyRead(*srv, *req, rxbuf[:cnt]);
                rem := rxbuf.count - cnt;
                for i: 0..rem - 1 { rxbuf[i] = rxbuf[cnt + i] }
                VecResize(rxbuf, rem);
            } else {
                pending_read = req;
                has_pending_read = true;
            }
        } else if req.kind == F2C.Write {
            if wrfid == -1 { wrfid = req.fid }
            if req.fid != wrfid {
                unused F2C.ReplyError(*srv, *req, "file in use");
                continue;
            }
            if errormsg.count > 0 {
                unused F2C.ReplyError(*srv, *req, TextView(errormsg[:]));
                break;
            }
            poll, derr := DataSend(seqnum, req.data[:req.count], starttower, *reply);
            seqnum += 1;
            starttower = false;
            tower_deadline = Clock.Millis() + 1500;
            if derr.count > 0 {
                SetErr(derr);
                unused F2C.ReplyError(*srv, *req, TextView(errormsg[:]));
                break;
            }
            for i: 0..reply.count - 1 { VecPush(rxbuf, reply[i]) }
            unused F2C.ReplyWrite(*srv, *req, req.count);
            while poll == POLLNOW {
                empty: [0]u8;
                poll2, derr2 := DataSend(seqnum, empty[:], starttower, *reply);
                seqnum += 1;
                tower_deadline = Clock.Millis() + 1500;
                if derr2.count > 0 {
                    SetErr(derr2);
                    break;
                }
                for i: 0..reply.count - 1 { VecPush(rxbuf, reply[i]) }
                poll = poll2;
            }
            if poll == POLLDO {
                poll_active = true;
                poll_deadline = Clock.Millis() + 250;
            } else {
                poll_active = false;
            }
        }
    }

    F2C.Remove(*srv);
    if rdfd >= 0 { unused IO.Close(rdfd) }
    if wrfd >= 0 { unused IO.Close(wrfd) }
    return 0;
}
