// lego/send portnum XX...: send raw hex bytes to a Lego RCX over IR serial
// and print the hex reply, matching appl/cmd/lego/send.b.
#import "std/vec";
using Args :: #import "taijios_args";
using Cli :: #import "zx_cli";
using Proto :: #import "lego_proto";
using Serial :: #import "rcx_serial";

main :: () -> s32 {
    count := Args.OperandCount();
    if count < 2 {
        Cli.PrintLine("usage: send portnum XX...");
        return 0;
    }
    port := Args.Operand(0);
    cmd: Vec(u8);
    for i: 1..count - 1 {
        arg := Args.Operand(i);
        b, ok := Proto.ParseHexArg(arg);
        if !ok {
            msg: Vec(u8);
            BuilderPrint(*msg, "bad arg %\n\n", arg);
            unused Cli.WriteAll(1, BuilderFinish(msg));
            return 0;
        }
        VecPush(cmd, b);
    }

    p: Serial.RcxPort;
    err: Text;
    if !Serial.OpenPort(*p, port, true, *err) {
        Cli.PrintLine("");
        return 0;
    }
    reply: Vec(u8);
    unused Serial.Send(*p, cmd[:], -1, *reply);
    Serial.HexDump(reply[:]);
    Serial.ClosePort(*p);
    return 0;
}
