// Lego Mindstorms RCX protocol: packet complement framing, zero-run RLE,
// S-record firmware loader, and clockface click math.
#import "std/vec";

IMG_START :: 0x8000;
IMG_LEN :: 0x4C00;
NCLICKS :: 120;

HexDigit :: (h: u8) -> s32 {
    if h >= #char "0" && h <= #char "9" { return cast(s32)(h - #char "0") }
    if h >= #char "A" && h <= #char "F" { return 10 + cast(s32)(h - #char "A") }
    if h >= #char "a" && h <= #char "f" { return 10 + cast(s32)(h - #char "a") }
    return -1;
}

ParseHexArg :: (arg: string) -> (val: u8, ok: bool) {
    if arg.count == 0 || arg.count > 2 { return 0, false }
    d1: s32 = 0;
    d2 := HexDigit(arg[0]);
    if arg.count == 2 {
        d1 = d2;
        d2 = HexDigit(arg[1]);
    }
    if d1 < 0 || d2 < 0 { return 0, false }
    return cast(u8)((d1 << 4) + d2), true;
}

// Encodes an RCX IR packet: 55 ff 00 (d[i] ~d[i])* cksum ~cksum.
EncodeRcxPacket :: (data: []u8, out: *Vec(u8)) {
    VecClear(<<out);
    VecPush(<<out, 0x55);
    VecPush(<<out, 0xFF);
    VecPush(<<out, 0x00);
    cksum: u32 = 0;
    for data {
        VecPush(<<out, it);
        VecPush(<<out, ~it);
        cksum += cast(u32)it;
    }
    c := cast(u8)(cksum & 0xFF);
    VecPush(<<out, c);
    VecPush(<<out, ~c);
}

// Decodes an RCX IR reply packet and verifies header + checksum.
DecodeRcxReply :: (reply: []u8, out: *Vec(u8)) -> bool {
    VecClear(<<out);
    if reply.count < 5 { return false }
    if reply[0] != 0x55 || reply[1] != 0xFF || reply[2] != 0x00 { return false }
    body_len := reply.count - 5;
    if (body_len & 1) != 0 { return false }
    cksum := reply[reply.count - 2];
    sum: u32 = 0;
    n := body_len / 2;
    for i: 0..n - 1 {
        b := reply[3 + i * 2];
        VecPush(<<out, b);
        sum += cast(u32)b;
    }
    if cksum != cast(u8)(sum & 0xFF) {
        VecClear(<<out);
        return false;
    }
    return true;
}

// Zero-run RLE encoder used by lego/link (0x88 escape).
RleEncode :: (data: []u8, out: *Vec(u8)) {
    VecClear(<<out);
    srcix: s64 = 0;
    nextval: s32 = -1;
    n0: s32 = 0;
    while srcix < data.count || nextval != -1 {
        val: s32 = 0;
        if nextval != -1 {
            val = nextval;
            nextval = -1;
        } else {
            val = cast(s32)data[srcix];
            if val == 0x88 { nextval = 0 }
            if val == 0 {
                n0 += 1;
                srcix += 1;
                if srcix < data.count && n0 < 0xFF + 2 { continue }
            }
            if n0 == 0 {
                srcix += 1;
            } else if n0 == 1 {
                val = 0;
                nextval = -1;
                n0 = 0;
            } else if n0 == 2 {
                val = 0;
                nextval = 0;
                n0 = 0;
            } else {
                val = 0x88;
                nextval = n0 - 2;
                n0 = 0;
            }
        }
        VecPush(<<out, cast(u8)(val & 0xFF));
    }
}

// Zero-run RLE decoder used by lego/link.
RleDecode :: (data: []u8, out: *Vec(u8)) -> bool {
    VecClear(<<out);
    srcix: s64 = 0;
    n0: s32 = 0;
    val: u8 = 0;
    while srcix < data.count || n0 > 0 {
        if n0 > 0 {
            n0 -= 1;
        } else {
            val = data[srcix];
            srcix += 1;
            if val == 0x88 {
                if srcix >= data.count {
                    VecClear(<<out);
                    return false;
                }
                n0 = cast(s32)data[srcix];
                srcix += 1;
                if n0 > 0 {
                    n0 += 2;
                    val = 0;
                    continue;
                }
            }
        }
        VecPush(<<out, val);
    }
    return true;
}

FirmwareImage :: struct {
    start: u32;
    offset: u32;
    length: s64;
    data: Vec(u8);
    err: Text;
}

ByteSum :: (data: []u8) -> u32 {
    t: u32 = 0;
    for data { t += cast(u32)it }
    return t;
}

WordVal :: (src: []u8, s: s64, l: s64) -> u32 {
    r: u32 = 0;
    for i: 0..l - 1 {
        r = (r << 8) | cast(u32)src[s + i];
    }
    return r;
}

HexToBytes :: (s: string, out: *Vec(u8)) -> bool {
    VecClear(<<out);
    if (s.count & 1) != 0 { return false }
    i: s64 = 0;
    while i < s.count {
        d1 := HexDigit(s[i]);
        d2 := HexDigit(s[i + 1]);
        if d1 < 0 || d2 < 0 { return false }
        VecPush(<<out, cast(u8)((d1 << 4) + d2));
        i += 2;
    }
    return true;
}

ParseFirmwareText :: (text: string, img: *FirmwareImage) -> bool {
    img.start = IMG_START;
    img.offset = IMG_START;
    img.length = 0;
    VecClear(img.data);
    VecClear(img.err.bytes);
    for i: 0..IMG_LEN - 1 { VecPush(img.data, 0) }

    pos: s64 = 0;
    lnum: s64 = 0;
    bytes: Vec(u8);
    while pos < text.count {
        start := pos;
        while pos < text.count && text[pos] != #char "\n" { pos += 1 }
        end := pos;
        if pos < text.count { pos += 1 }
        lnum += 1;
        while end > start && (text[end - 1] == #char " " || text[end - 1] == #char "\r" || text[end - 1] == #char "\n") {
            end -= 1;
        }
        s := text[start:end];
        if s.count == 0 { continue }
        if s.count < 10 {
            BuilderPrint(*img.err.bytes, "short S-record: line %", lnum);
            return false;
        }
        t := s[1];
        if s[0] != #char "S" || t < #char "0" || t > #char "9" {
            BuilderPrint(*img.err.bytes, "bad S-record format: line %", lnum);
            return false;
        }
        if !HexToBytes(s[2:], *bytes) {
            BuilderPrint(*img.err.bytes, "bad chars in S-record:  line %", lnum);
            return false;
        }
        count := cast(s64)bytes[0];
        if count != bytes.count - 1 {
            BuilderPrint(*img.err.bytes, "S-record length mis-match:  line %", lnum);
            return false;
        }
        if (ByteSum(bytes[:bytes.count]) & 0xFF) != 0xFF {
            BuilderPrint(*img.err.bytes, "bad S-record checksum:  line %", lnum);
            return false;
        }
        if t == #char "0" || t == #char "5" || t == #char "6" { continue }
        if t == #char "4" {
            BuilderPrint(*img.err.bytes, "bad S-record type: line %", lnum);
            return false;
        }
        if t == #char "7" { img.start = WordVal(bytes[:], 1, 4); continue }
        if t == #char "8" { img.start = WordVal(bytes[:], 1, 3); continue }
        if t == #char "9" { img.start = WordVal(bytes[:], 1, 2); continue }
        alen: s64 = 2;
        if t == #char "2" { alen = 3 } else if t == #char "3" { alen = 4 }
        waddr := WordVal(bytes[:], 1, alen);
        if waddr < img.offset {
            BuilderPrint(*img.err.bytes, "S-record address out of range: line %", lnum);
            return false;
        }
        addr := cast(s64)(waddr - img.offset);
        dlen := count - (alen + 1);
        if addr < 0 || addr + dlen > img.data.count {
            BuilderPrint(*img.err.bytes, "S-record address out of range: line %", lnum);
            return false;
        }
        for j: 0..dlen - 1 {
            img.data[addr + j] = bytes[1 + alen + j];
        }
        if addr + dlen > img.length { img.length = addr + dlen }
    }
    return true;
}

// Clockface click calculations (120 clicks per revolution).
ClockClicks :: (hour: s32, minute: s32) -> (hclk: s32, mclk: s32) {
    h := ((hour * NCLICKS) / 12) + ((minute * NCLICKS) / (12 * 60));
    m := (minute * NCLICKS) / 60;
    return h, m;
}

ClickDistance :: (start: s32, stop_in: s32, mod: s32) -> s32 {
    stop := stop_in;
    if start > stop { stop += mod }
    d := (stop - start) % mod;
    if d > mod / 2 { d -= mod }
    return d;
}

AppendHex4 :: (out: *Vec(u8), v: u32) {
    digits := "0123456789abcdef";
    VecPush(<<out, digits[(v >> 12) & 0xF]);
    VecPush(<<out, digits[(v >> 8) & 0xF]);
    VecPush(<<out, digits[(v >> 4) & 0xF]);
    VecPush(<<out, digits[v & 0xF]);
}
