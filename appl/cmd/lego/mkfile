<../../../mkconfig

TARG=\
	clock.dis\

SYSMODULES=\
	sys.m\
	draw.m\
	bufio.m\

MODULES=

DISBIN=$ROOT/zx/lego

<$ROOT/mkfiles/mkdis

ZXCOMMANDS=firmdl send link clockface
ZXUTIL=lego_proto.zi rcx_serial.zi legolink_service.zi ../zx_cli.zi ../taijios_args.zi ../taijios_io.zi ../taijios_namespace.zi ../taijios_file2chan.zi ../taijios_clock.zi

install:V: ${ZXCOMMANDS:%=$DISBIN/%.zx}

link.zx: link.zi legolink_service.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_namespace --bind-host taijios_clock --entry link:main -o $target link.zi

clockface.zx: clockface.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_namespace --bind-host taijios_clock --entry clockface:main -o $target clockface.zi

&.zx: &.zi $ZXUTIL
	zi2zx --root . --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --entry $stem:main -o $target $stem.zi

$DISBIN/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 "$stem.zx" "$staged" && mv "$staged" "$target"
