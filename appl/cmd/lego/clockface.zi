// Lego RCX clockface controller over /chan/clockface (replaces appl/cmd/lego/clockface.b).
Args :: #import "taijios_args";
IO :: #import "taijios_io";
Clock :: #import "taijios_clock";
F2C :: #import "taijios_file2chan";
#import "std/format"
#import "std/vec"

ONTHRESH :: 780
OFFTHRESH :: 740
NCLICKS :: 120
MINCLICKS :: 2
HOUR_ADJUST :: 1
MINUTE_ADJUST :: 2

Hand :: struct {
    motor: s32;
    sensor: s32;
    fwd: string;
    rev: string;
    stop: string;
    pos: s32;
    time: s32;
}

lightsensor: s32 = -1;
allmotors: s32 = -1;
hourhand: Hand;
minutehand: Hand;
timedata: Vec(u8);
verbose: bool;

readers: [32]s32;
reader_count: s64;
readq: [32]F2C.Request;
readq_count: s64;

WriteOut :: (s: string) {
    if s.count > 0 { unused IO.Write(1, s) }
}

Log :: (msg: string) {
    if verbose {
        out: Vec(u8);
        BuilderPrint(*out, "%\n", msg);
        WriteOut(TextView(out[:]));
    }
}

ParseInt :: (s: string) -> s32 {
    i: s64 = 0;
    while i < s.count && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) { i += 1 }
    neg := false;
    if i < s.count && s[i] == 45 {
        neg = true;
        i += 1;
    }
    val: s32 = 0;
    while i < s.count {
        c := cast(u8)s[i];
        if c < 48 || c > 57 { break }
        val = val * 10 + cast(s32)(c - 48);
        i += 1;
    }
    if neg { return -val }
    return val;
}

StopHand :: (h: *Hand) {
    unused IO.Seek(h.motor, 0, 0);
    unused IO.Write(h.motor, h.stop);
}

StopAll :: () {
    unused IO.Seek(allmotors, 0, 0);
    unused IO.Write(allmotors, "s0s0s0");
}

ReleaseAll :: () {
    unused IO.Seek(allmotors, 0, 0);
    unused IO.Write(allmotors, "F0F0F0");
}

Forward :: (h: *Hand) {
    unused IO.Seek(h.motor, 0, 0);
    unused IO.Write(h.motor, h.fwd);
}

Reverse :: (h: *Hand) {
    unused IO.Seek(h.motor, 0, 0);
    unused IO.Write(h.motor, h.rev);
}

ReadSensor :: (fd: s32) -> s32 {
    buf: [16]u8;
    unused IO.Seek(fd, 0, 0);
    n := IO.Read(fd, buf[:4]);
    if n <= 0 { return -1 }
    return ParseInt(TextView(buf[:n]));
}

SetSensorTypes :: () {
    unused IO.Write(hourhand.sensor, "b0");
    unused IO.Write(minutehand.sensor, "b0");
    if lightsensor >= 0 { unused IO.Write(lightsensor, "l0") }
}

ClickDistance :: (start: s32, stop_in: s32, mod: s32) -> s32 {
    stop := stop_in;
    if start > stop { stop += mod }
    d := (stop - start) % mod;
    if d > mod / 2 { d -= mod }
    return d;
}

Clicks :: () -> (h_out: s32, m_out: s32) {
    h := hourhand.time;
    m := minutehand.time;
    hc := ((h * NCLICKS) / 12) + ((m * NCLICKS) / (12 * 60));
    mc := (m * NCLICKS) / 60;
    return hc, mc;
}

LightWait :: (fd: s32, on: bool) -> s32 {
    cmd: Vec(u8);
    if on {
        BuilderPrint(*cmd, "l>%", ONTHRESH);
    } else {
        BuilderPrint(*cmd, "l<%", OFFTHRESH);
    }
    unused IO.Seek(fd, 0, 0);
    unused IO.Write(fd, TextView(cmd[:]));
    return ReadSensor(fd);
}

HandWait :: (h: *Hand, clicks: s32) -> s32 {
    cmd: Vec(u8);
    BuilderPrint(*cmd, "b%", cast(s64)clicks);
    unused IO.Seek(h.sensor, 0, 0);
    unused IO.Write(h.sensor, TextView(cmd[:]));
    return ReadSensor(h.sensor);
}

SetHand :: (h: *Hand, delta_in: s32) {
    dir: s32 = 1;
    delta := delta_in;
    if delta < 0 {
        dir = -1;
        delta = -delta;
    }
    if delta > MINCLICKS {
        if dir > 0 { Forward(h) } else { Reverse(h) }
        unused HandWait(h, delta - MINCLICKS);
        StopHand(h);
        h.pos += dir * ReadSensor(h.sensor);
    } else {
        startval := ReadSensor(h.sensor);
        if dir > 0 { Forward(h) } else { Reverse(h) }
        StopHand(h);
        h.pos += dir * (ReadSensor(h.sensor) - startval);
    }
    while h.pos < 0 { h.pos += NCLICKS }
    h.pos = h.pos % NCLICKS;
}

ResetHand :: (h: *Hand) {
    Log("running hand until light sensor activated");
    Forward(h);
    unused LightWait(lightsensor, true);
    StopHand(h);
    startclick := ReadSensor(h.sensor);

    Log("running hand until light sensor clear");
    Forward(h);
    unused LightWait(lightsensor, false);
    StopHand(h);
    stopclick := ReadSensor(h.sensor);
    nclicks := stopclick - startclick;
    h.pos = nclicks / 2;
}

FormatTimeData :: () {
    VecClear(timedata);
    hr := (hourhand.time + 11) % 12 + 1;
    if hr < 10 { VecPush(timedata, 32) }
    BuilderPrint(*timedata, "%:", cast(s64)hr);
    if minutehand.time < 10 { VecPush(timedata, 48) }
    BuilderPrint(*timedata, "%\n", cast(s64)minutehand.time);
}

SetHands :: (srv: *F2C.File) {
    FormatTimeData();
    for i: 0..readq_count - 1 {
        unused F2C.ReplyRead(srv, *readq[i], timedata[:]);
    }
    readq_count = 0;

    hclk, mclk := Clicks();
    for _: 0..5 {
        hdelta := ClickDistance(hourhand.pos, hclk, NCLICKS);
        mdelta := ClickDistance(minutehand.pos, mclk, NCLICKS);
        if hdelta != 0 {
            SetHand(*hourhand, hdelta);
        } else if mdelta != 0 {
            SetHand(*minutehand, mdelta);
        } else {
            break;
        }
    }
    ReleaseAll();
}

ResetClock :: (srv: *F2C.File) {
    if lightsensor >= 0 {
        val := ReadSensor(lightsensor);
        if val > OFFTHRESH {
            Log("wait for hands clear of light sensor");
            Forward(*minutehand);
            Reverse(*hourhand);
            unused LightWait(lightsensor, false);
            StopAll();
        }
        ResetHand(*hourhand);
        hourhand.pos += HOUR_ADJUST;
        ResetHand(*minutehand);
        minutehand.pos += MINUTE_ADJUST;
    }
    SetHands(srv);
}

MarkOpenReader :: (fid: s32) -> bool {
    for i: 0..reader_count - 1 {
        if readers[i] == fid { return true }
    }
    if reader_count < readers.count {
        readers[reader_count] = fid;
        reader_count += 1;
    }
    return false;
}

CloseReader :: (fid: s32) {
    w: s64 = 0;
    for i: 0..reader_count - 1 {
        if readers[i] != fid {
            readers[w] = readers[i];
            w += 1;
        }
    }
    reader_count = w;
}

IsDelim :: (b: u8) -> bool {
    return b == 58 || b == 32 || b == 9 || b == 10 || b == 13;
}

SplitTokens :: (s: string, out_t0: *Vec(u8), out_t1: *Vec(u8)) -> s32 {
    VecClear(out_t0.*);
    VecClear(out_t1.*);
    pos: s64 = 0;
    cnt: s32 = 0;
    while pos < s.count {
        while pos < s.count && IsDelim(cast(u8)s[pos]) { pos += 1 }
        if pos >= s.count { break }
        start := pos;
        while pos < s.count && !IsDelim(cast(u8)s[pos]) { pos += 1 }
        if cnt == 0 { unused BuilderAppend(out_t0.*, s[start:pos]) }
        else if cnt == 1 { unused BuilderAppend(out_t1.*, s[start:pos]) }
        cnt += 1;
    }
    return cnt;
}

main :: () -> s32 {
    argc := Args.OperandCount();
    idx: s32 = 0;
    if idx < argc && Args.Operand(idx) == "-v" {
        verbose = true;
        idx += 1;
    }
    if argc - idx != 1 {
        WriteOut("usage: [-v] legodir\n");
        unused Args.SetFailure("usage");
        return 1;
    }
    legodir := Args.Operand(idx);

    srv: F2C.File;
    if !F2C.Create(*srv, "/chan", "clockface") {
        msg: Vec(u8);
        BuilderPrint(*msg, "cannot create clockface channel: %\n", IO.Error());
        WriteOut(TextView(msg[:]));
        return 0;
    }

    p_hm: Vec(u8); BuilderPrint(*p_hm, "%/motor/0", legodir);
    p_mm: Vec(u8); BuilderPrint(*p_mm, "%/motor/2", legodir);
    p_am: Vec(u8); BuilderPrint(*p_am, "%/motor/012", legodir);
    hm := IO.Open(TextView(p_hm[:]), 1);
    mm := IO.Open(TextView(p_mm[:]), 1);
    allmotors = IO.Open(TextView(p_am[:]), 1);
    if hm < 0 || mm < 0 || allmotors < 0 {
        WriteOut("cannot open motor files\n");
        unused Args.SetFailure("error");
        return 1;
    }

    p_hb: Vec(u8); BuilderPrint(*p_hb, "%/sensor/0", legodir);
    p_mb: Vec(u8); BuilderPrint(*p_mb, "%/sensor/2", legodir);
    p_ls: Vec(u8); BuilderPrint(*p_ls, "%/sensor/1", legodir);
    hb := IO.Open(TextView(p_hb[:]), 2);
    mb := IO.Open(TextView(p_mb[:]), 2);
    lightsensor = IO.Open(TextView(p_ls[:]), 2);
    if hb < 0 || mb < 0 {
        WriteOut("cannot open sensor files\n");
        unused Args.SetFailure("error");
        return 1;
    }

    hourhand = Hand.{ motor = hm, sensor = hb, fwd = "r7", rev = "f7", stop = "s7", pos = 0, time = 0 };
    minutehand = Hand.{ motor = mm, sensor = mb, fwd = "f7", rev = "r7", stop = "s7", pos = 0, time = 0 };

    SetSensorTypes();
    ResetClock(*srv);

    next_tick := Clock.Millis() + 60000;
    req: F2C.Request;

    while true {
        if Clock.Millis() >= next_tick {
            next_tick += 60000;
            minutehand.time += 1;
            if minutehand.time == 60 {
                minutehand.time = 0;
                hourhand.time = (hourhand.time + 1) % 12;
            }
            SetHands(*srv);
        }

        st := F2C.Next(*srv, *req, false);
        if st < 0 { break }
        if st == 0 { continue }

        if req.kind == F2C.Close {
            CloseReader(req.fid);
        } else if req.kind == F2C.Read {
            if cast(s64)req.count < timedata.count {
                unused F2C.ReplyError(*srv, *req, "read too small");
                continue;
            }
            if MarkOpenReader(req.fid) {
                if readq_count < readq.count {
                    readq[readq_count] = req;
                    readq_count += 1;
                }
            } else {
                unused F2C.ReplyRead(*srv, *req, timedata[:]);
            }
        } else if req.kind == F2C.Write {
            t0: Vec(u8);
            t1: Vec(u8);
            nt := SplitTokens(TextView(req.data[:req.count]), *t0, *t1);
            if nt == 2 {
                unused F2C.ReplyWrite(*srv, *req, req.count);
                hourhand.time = ParseInt(TextView(t0[:])) % 12;
                minutehand.time = ParseInt(TextView(t1[:])) % 60;
                SetHands(*srv);
            } else if nt == 1 && TextView(t0[:]) == "reset" {
                unused F2C.ReplyWrite(*srv, *req, req.count);
                ResetClock(*srv);
            } else {
                unused F2C.ReplyError(*srv, *req, "syntax is hh:mm or `reset'");
            }
        }
    }

    F2C.Remove(*srv);
    return 0;
}
