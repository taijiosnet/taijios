cleanname.dis: $MODDIR/names.m
zxrun.dis: $MODDIR/zx.m $MODDIR/wmclient.m $MODDIR/timers.m $MODDIR/keyboard.m
cat.zx: cat.zi taijios_args.zi taijios_io.zi
	zi2zx --root . --bind-host taijios_args --bind-host taijios_io --entry cat:main -o $target cat.zi

echo.zx: echo.zi $UTILZX
	zi2zx --root . --bind-host taijios_args --bind-host taijios_io --entry echo:main -o $target echo.zi

basename.zx: basename.zi $UTILZX $NAMEZX
	zi2zx --root . --module-path $ZXLIB --bind-host taijios_args --bind-host taijios_io --entry basename:main -o $target basename.zi

cleanname.zx: cleanname.zi $UTILZX $NAMEZX
	zi2zx --root . --module-path $ZXLIB --bind-host taijios_args --bind-host taijios_io --entry cleanname:main -o $target cleanname.zi

tclsh.zx: tclsh_stdin.zi taijios_stdin.zi taijios_files.zi taijios_io.zi $TCLZX
	zi2zx --root . --module-path $ZXLIB --bind-host taijios_stdin --bind-host taijios_files --bind-host taijios_io --entry tclsh_stdin:main -o $target tclsh_stdin.zi

coffee.zx: tcltk/coffee_app.zi tcltk/coffee_art.zi tcltk/tcltk.zi tcltk/zx_surface.zi taijios_files.zi taijios_stdin.zi $TCLZX $TKZX
	zi2zx --root tcltk --module-path $ZXLIB --module-path . --bind-host zx_surface --bind-host taijios_files --entry coffee_app:main -o $target tcltk/coffee_app.zi

logwindow.zx: tcltk/logwindow_app.zi tcltk/logwindow_input.zi tcltk/logwindow_stream.zi tcltk/tcltk.zi tcltk/zx_surface.zi taijios_args.zi taijios_files.zi taijios_stdin.zi $TCLZX $TKZX
	zi2zx --root tcltk --module-path $ZXLIB --module-path . --bind-host zx_surface --bind-host taijios_args --bind-host taijios_files --bind-host taijios_stdin --entry logwindow_app:main -o $target tcltk/logwindow_app.zi

install-zx:V: zxrun.install install-cat-zx install-tclsh-zx install-coffee-zx install-logwindow-zx install-utilities-zx
	(cd sh && mk sh.install)
install-cat-zx:V: $DISBIN/cat.zx
install-tclsh-zx:V: $DISBIN/tclsh.zx
install-coffee-zx:V: $DISBIN/coffee.zx tcltk/coffee.tcl $COFFEEART
install-logwindow-zx:V: $DISBIN/wm/logwindow.zx tcltk/logwindow.tcl
install-utilities-zx:V: $DISBIN/echo.zx $DISBIN/basename.zx $DISBIN/cleanname.zx

$DISBIN/cat.zx: cat.zx mkfile
$DISBIN/tclsh.zx: tclsh.zx
$DISBIN/coffee.zx: coffee.zx
$DISBIN/wm/logwindow.zx: logwindow.zx
$DISBIN/echo.zx: echo.zx mkfile
$DISBIN/basename.zx: basename.zx mkfile
$DISBIN/cleanname.zx: cleanname.zx mkfile

$DISBIN/%.zx: %.zx
	mode=0644
	case " $ZXCOMMANDS " in
		*" $stem "*) mode=0755 ;;
	esac
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m "$mode" "$stem.zx" "$staged" && mv "$staged" "$target"

$DISBIN/wm/%.zx: %.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 "$stem.zx" "$staged" && mv "$staged" "$target"

