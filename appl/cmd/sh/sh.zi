// sh: the TaijiOS command shell as a ZX program, after appl/cmd/sh/sh.y.
//     sh [-ilexn] [-c command] [file [arg...]]
// The builtin modules that `load` names are compiled in. The operand -%
// starts the internal mode in which one shell runs a list for another, as
// a Limbo shell thread did: see ChildOperands in shell.zi.
#import "std/vec";
Args :: #import "taijios_args";
Io :: #import "taijios_io";
Ns :: #import "taijios_namespace";
#import "shell_parse";
#import "shell_util";
#import "shell";
#import "shell_std";
#import "shell_string";
#import "shell_expr";
#import "shell_small";
#import "shell_regex";
#import "shell_csv";

main :: () -> s32 {
    unused RegisterModule("builtin", InitShellBuiltins, ShellRun, ShellSRun, ShellWhatis);
    unused RegisterModule("std", StdInit, StdRun, StdSRun, StdWhatis);
    unused RegisterModule("string", StringInit, StringRun, StringSRun, NoWhatis);
    unused RegisterModule("expr", ExprInit, ExprRun, ExprSRun, NoWhatis);
    unused RegisterModule("echo", EchoInit, EchoRun, NoSRun, NoWhatis);
    unused RegisterModule("test", TestInit, TestRun, NoSRun, NoWhatis);
    unused RegisterModule("arg", ArgInit, ArgRun, NoSRun, NoWhatis);
    unused RegisterModule("regex", RegexInit, RegexRun, RegexSRun, NoWhatis);
    unused RegisterModule("csv", CsvInit, CsvRun, CsvSRun, NoWhatis);
    count := Args.OperandCount();
    if count > 0 && Args.Operand(0) == "-%" { return Child(count) }

    interactive := false;
    lflag := false;
    nflag := false;
    ctxtflags: s32 = 0;
    carg: Text;
    hascarg := false;
    i: s32 = 0;
    while i < count {
        a := Args.Operand(i);
        if a.count == 0 || a[0] != #char "-" { break }
        j: s64 = 1;
        while j < a.count {
            c := a[j];
            if c == #char "i" { interactive = true }
            else if c == #char "l" { lflag = true }
            else if c == #char "n" { nflag = true }
            else if c == #char "e" { ctxtflags |= ERROREXIT }
            else if c == #char "x" { ctxtflags |= EXECPRINT }
            else if c == #char "c" {
                if j < a.count - 1 {
                    unused BuilderAppend(carg.bytes, a[j + 1:]);
                } else if i + 1 >= count || Args.Operand(i + 1) == "" {
                    return Usage();
                } else {
                    i += 1;
                    unused BuilderAppend(carg.bytes, Args.Operand(i));
                }
                hascarg = true;
                break;
            }
            j += 1;
        }
        i += 1;
    }

    if !nflag { unused Ns.Fork() }
    NewContext(true);
    if Unwinding() { return Finish("") }
    unused SetOptions(ctxtflags, true);
    if hascarg {
        list: Items;
        block: Vec(u8);
        BuilderPrint(*block, "{%}", TextView(carg));
        PushWord(*list, TextView(block[:]));
        for k: i..count - 1 { PushWord(*list, Args.Operand(k)) }
        status: Text = Run(*list, !interactive);
        if !interactive || Unwinding() { return Finish(TextView(status)) }
        SetStatus(TextView(status));
    }
    if lflag {
        none: Items;
        RunScript(LIBSHELLRC, *none, false);
        if Unwinding() { return Finish("") }
    }
    if i >= count {
        mode: s32 = 0;
        if interactive || IsConsole(0) { mode = INTERACTIVE }
        unused SetOptions(mode, true);
        none: Items;
        RunFile(0, "stdin", *none);
    } else {
        if interactive { unused SetOptions(INTERACTIVE, true) }
        rest: Items;
        for k: i + 1..count - 1 { PushWord(*rest, Args.Operand(k)) }
        RunScript(Args.Operand(i), *rest, true);
    }
    return Finish("");
}

#scope_file

Usage :: () -> s32 {
    unused Io.Write(2, "usage: sh [-ilexn] [-c command] [file [arg...]]\n");
    unused Args.SetFailure("usage");
    return 1;
}

// The exit status: a raised "fail:x" or a final status x fails with x.
Finish :: (status: string) -> s32 {
    if exiting { return 0 }
    if raising {
        failure: Text = FailureStatus(TextView(raised));
        if TextView(raised).count < 5 || TextView(raised)[:5] != "fail:" { VecSwap(failure.bytes, raised.bytes) }
        unused Args.SetFailure(TextView(failure));
        return 1;
    }
    if status.count != 0 {
        unused Args.SetFailure(status);
        return 1;
    }
    return 0;
}

// Whether a handle is the console, as isconsole.
IsConsole :: (h: s32) -> bool {
    a: [512]u8;
    b: [512]u8;
    n1 := Io.FstatPacked(h, a[:]);
    n2 := Io.StatPacked("/dev/cons", b[:]);
    if n1 < 21 || n2 < 21 { return false }
    for k: 2..3 { if a[k] != b[k] { return false } }
    for k: 13..20 { if a[k] != b[k] { return false } }
    return true;
}

// -% modules star zero status options word...
Child :: (count: s32) -> s32 {
    if count < 6 { return Usage() }
    NewContext(false);
    flags := LimboInt(Args.Operand(5));
    unused SetOptions(INTERACTIVE | VERBOSE | EXECPRINT | ERROREXIT, false);
    unused SetOptions(cast(s32)flags, true);
    names := Unquoted(Args.Operand(1));
    for k: 0..names.count - 1 {
        unused LoadModule(TextView(names[k]));
        if Unwinding() { return Finish("") }
    }
    star := Unquoted(Args.Operand(2));
    starval := StringsToList(*star);
    SetLocal("*", *starval);
    zero := Unquoted(Args.Operand(3));
    zeroval := StringsToList(*zero);
    SetLocal("0", *zeroval);
    if Args.Operand(4) != "" { SetStatus(Args.Operand(4)) }
    list: Items;
    for k: 6..count - 1 { PushWord(*list, Args.Operand(k)) }
    status: Text = Run(*list, true);
    return Finish(TextView(status));
}
