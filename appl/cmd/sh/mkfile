<../../../mkconfig

TARG=sh.dis\
	arg.dis\
	expr.dis\
	mpexpr.dis\
	file2chan.dis\
	mload.dis\
	regex.dis\
	sexprs.dis\
	std.dis\
	string.dis\
	tk.dis\
	echo.dis\
	csv.dis\
	test.dis\

INS=	$ROOT/zx/sh.dis\
	$ROOT/zx/sh/arg.dis\
	$ROOT/zx/sh/expr.dis\
	$ROOT/zx/sh/file2chan.dis\
	$ROOT/zx/sh/mload.dis\
	$ROOT/zx/sh/mpexpr.dis\
	$ROOT/zx/sh/regex.dis\
	$ROOT/zx/sh/std.dis\
	$ROOT/zx/sh/string.dis\
#	$ROOT/zx/sh/tk.dis\
	$ROOT/zx/sh/echo.dis\
	$ROOT/zx/sh/csv.dis\
	$ROOT/zx/sh/test.dis\

SYSMODULES=\
	bufio.m\
	draw.m\
	env.m\
	filepat.m\
	lock.m\
	sexprs.m\
	sh.m\
	string.m\
	sys.m\
	tk.m\
	tkclient.m\
	zx.m

DISBIN=$ROOT/zx/sh

<$ROOT/mkfiles/mkdis

all:V:		$TARG

install:V:	$INS sh.install

sh.install:V:	$ROOT/zx/sh.dis $DISBIN/sh.dis $ROOT/zx/sh.zx

nuke:V: clean
	rm -f $INS

clean:V:
	rm -f *.dis *.sbl

uninstall:V:
	rm -f $INS

$ROOT/zx/sh.dis:	sh.dis
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 sh.dis "$staged" && mv "$staged" "$target"

%.dis: ${SYSMODULES:%=$MODDIR/%}

# The ZX shell: sh.zi and its modules, with the builtin modules compiled in.
SHZX=sh.zi shell.zi shell_parse.zi shell_util.zi shell_filepat.zi shell_std.zi shell_string.zi shell_expr.zi shell_small.zi shell_regexp.zi shell_regex.zi shell_csv.zi shell_sexpr.zi shell_sexprs.zi shell_file2chan.zi shell_mpexpr.zi shell_alphabet.zi
CMDZX=../taijios_args.zi ../taijios_io.zi ../taijios_process.zi ../taijios_namespace.zi ../taijios_clock.zi ../taijios_file2chan.zi ../taijios_keyring.zi
# The alphabet library `load alphabet` runs: the modules of appl/alphabet.
ALPHAZX=`{ls ../../alphabet/*.zi ../../alphabet/*/*.zi}
ALPHACMD=../taijios_files.zi ../taijios_dial.zi ../taijios_stat.zi ../taijios_time.zi ../auth/authinfo.zi ../../lib/taijios_quote.zi

sh.zx:	$SHZX $CMDZX $ALPHACMD $ALPHAZX mkfile
	zi2zx --root . --module-path ../../alphabet --module-path main=../../alphabet/main --module-path abc=../../alphabet/abc --module-path fs=../../alphabet/fs --module-path grid=../../alphabet/grid --module-path auth=../auth --module-path .. --module-path ../../lib --bind-host taijios_args --bind-host taijios_io --bind-host taijios_process --bind-host taijios_namespace --bind-host taijios_clock --bind-host taijios_keyring --bind-host taijios_files --bind-host taijios_dial --entry sh:main -o $target sh.zi
	chmod 755 $target

install-zx:V:	$ROOT/zx/sh.zx

$ROOT/zx/sh.zx:	sh.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 sh.zx "$staged" && mv "$staged" "$target"
