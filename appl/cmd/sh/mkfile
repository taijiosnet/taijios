<../../../mkconfig

TARG=sh.dis\
	arg.dis\
	expr.dis\
	mpexpr.dis\
	file2chan.dis\
	mload.dis\
	regex.dis\
	sexprs.dis\
	std.dis\
	string.dis\
	tk.dis\
	echo.dis\
	csv.dis\
	test.dis\

INS=	$ROOT/dis/sh.dis\
	$ROOT/dis/sh/arg.dis\
	$ROOT/dis/sh/expr.dis\
	$ROOT/dis/sh/file2chan.dis\
	$ROOT/dis/sh/mload.dis\
	$ROOT/dis/sh/mpexpr.dis\
	$ROOT/dis/sh/regex.dis\
	$ROOT/dis/sh/std.dis\
	$ROOT/dis/sh/string.dis\
#	$ROOT/dis/sh/tk.dis\
	$ROOT/dis/sh/echo.dis\
	$ROOT/dis/sh/csv.dis\
	$ROOT/dis/sh/test.dis\

SYSMODULES=\
	bufio.m\
	draw.m\
	env.m\
	filepat.m\
	lock.m\
	sexprs.m\
	sh.m\
	string.m\
	sys.m\
	tk.m\
	tkclient.m\
	zx.m

DISBIN=$ROOT/dis/sh

<$ROOT/mkfiles/mkdis

all:V:		$TARG

install:V:	$INS sh.install

sh.install:V:	$ROOT/dis/sh.dis $DISBIN/sh.dis $ROOT/dis/sh.zx

nuke:V: clean
	rm -f $INS

clean:V:
	rm -f *.dis *.sbl

uninstall:V:
	rm -f $INS

$ROOT/dis/sh.dis:	sh.dis
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 sh.dis "$staged" && mv "$staged" "$target"

%.dis: ${SYSMODULES:%=$MODDIR/%}

# The ZX shell: sh.zi and its modules, with the builtin modules compiled in.
SHZX=sh.zi shell.zi shell_parse.zi shell_util.zi shell_std.zi shell_string.zi shell_expr.zi shell_small.zi shell_regexp.zi shell_regex.zi shell_csv.zi
CMDZX=../taijios_args.zi ../taijios_io.zi ../taijios_process.zi ../taijios_namespace.zi ../taijios_clock.zi

sh.zx:	$SHZX $CMDZX mkfile
	zi2zx --root . --module-path .. --bind-host taijios_args --bind-host taijios_io --bind-host taijios_process --bind-host taijios_namespace --bind-host taijios_clock --entry sh:main -o $target sh.zi
	chmod 755 $target

install-zx:V:	$ROOT/dis/sh.zx

$ROOT/dis/sh.zx:	sh.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 sh.zx "$staged" && mv "$staged" "$target"
