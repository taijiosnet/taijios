// S-expressions as appl/lib/sexprs.b reads and prints them (SDSI/SPKI:
// tokens, "quoted" strings, #hex#, |base64|, n:raw bytes, [hint]s and
// {base64 transport}), with the base64 and base16 encodings of
// appl/lib/encoding. Limbo built strings from the bytes it read, one byte
// to a character, so string contents are rune arrays here too. Nodes live
// in one pool, reset by the caller, and are named by index.
#import "std/vec";

#scope_export

STRING :: 0;
BINARY :: 1;
LIST :: 2;

SNode :: struct {
    kind: s32;
    s: Vec(s32);
    hint: Vec(s32);
    data: Vec(u8);
    kids: Vec(s32);
}

snodes: Vec(SNode);

ResetSexps :: () { VecClear(snodes) }

// A byte source: a buffer, or standard input through ReadProc.
ReadProc :: #type (buffer: []u8) -> s32;

SReader :: struct {
    usefd: bool;
    read: ReadProc;
    data: Vec(u8);
    pos: s64;
    buf: [8192]u8;
    bpos: s32;
    blen: s32;
    eof: bool;
    offset: s64;
    last: s32;
    back: bool;
    // A syntax error: its text and position (-1 for here).
    failed: bool;
    diag: Text;
    errpos: s64;
}

Getb :: (r: *SReader) -> s32 {
    if r.back {
        r.back = false;
        r.offset += 1;
        return r.last;
    }
    c: s32 = -1;
    if r.usefd {
        if r.bpos >= r.blen && !r.eof {
            r.bpos = 0;
            r.blen = r.read(r.buf[:]);
            if r.blen <= 0 { r.blen = 0; r.eof = true }
        }
        if r.bpos < r.blen { c = cast(s32)r.buf[r.bpos]; r.bpos += 1 }
    } else if r.pos < r.data.count {
        c = cast(s32)r.data[r.pos];
        r.pos += 1;
    }
    r.last = c;
    if c >= 0 { r.offset += 1 }
    return c;
}

Ungetb :: (r: *SReader) {
    if r.last >= 0 && !r.back {
        r.back = true;
        r.offset -= 1;
    }
}

#scope_file

Syntax :: (r: *SReader, diag: string, pos: s64) -> s32 {
    if !r.failed {
        r.failed = true;
        VecClear(r.diag.bytes);
        unused BuilderAppend(r.diag.bytes, diag);
        r.errpos = pos;
    }
    return -2;
}

IsSpace :: (c: s32) -> bool { return c == 32 || c == 13 || c == 9 || c == 10 }

Ws :: (r: *SReader) -> s32 {
    c := Getb(r);
    while IsSpace(c) { c = Getb(r) }
    return c;
}

IsTokenc :: (c: s32) -> bool {
    return (c >= #char "0" && c <= #char "9") || (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") ||
        c == #char "-" || c == #char "." || c == #char "/" || c == #char "_" || c == #char ":" || c == #char "*" ||
        c == #char "+" || c == #char "=";
}

NewNode :: (kind: s32) -> s32 {
    n: SNode;
    n.kind = kind;
    VecPush(snodes, n);
    return cast(s32)(snodes.count - 1);
}

SetHint :: (n: s32, hint: *Vec(s32)) {
    for i: 0..hint.count - 1 { VecPush(snodes[n].hint, hint.*[i]) }
}

StringNode :: (text: *Vec(s32), hint: *Vec(s32)) -> s32 {
    n := NewNode(STRING);
    for i: 0..text.count - 1 { VecPush(snodes[n].s, text.*[i]) }
    SetHint(n, hint);
    return n;
}

// Text if every byte is printable or a blank, else binary data.
SForm :: (a: *Vec(u8), hint: *Vec(s32)) -> s32 {
    textual := true;
    for i: 0..a.count - 1 {
        c := cast(s32)a.*[i];
        if (c < 32 && !IsSpace(c)) || c >= 127 { textual = false; break }
    }
    if textual {
        n := NewNode(STRING);
        for i: 0..a.count - 1 { VecPush(snodes[n].s, cast(s32)a.*[i]) }
        SetHint(n, hint);
        return n;
    }
    n := NewNode(BINARY);
    for i: 0..a.count - 1 { VecPush(snodes[n].data, a.*[i]) }
    SetHint(n, hint);
    return n;
}

ToClosing :: (r: *SReader, end: s32, s: *Vec(s32)) -> bool {
    p0 := r.offset;
    c := Getb(r);
    while c != end {
        if c < 0 {
            msg: Vec(u8);
            unused BuilderAppend(msg, "missing closing '");
            VecPush(msg, cast(u8)end);
            VecPush(msg, 39);
            unused Syntax(r, TextView(msg[:]), p0);
            return false;
        }
        VecPush(<<s, c);
        c = Getb(r);
    }
    return true;
}

Hex :: (c: s32) -> s32 {
    if c >= #char "0" && c <= #char "9" { return c - #char "0" }
    if c >= #char "a" && c <= #char "f" { return 10 + c - #char "a" }
    if c >= #char "A" && c <= #char "F" { return 10 + c - #char "A" }
    return -1;
}

Unquote :: (r: *SReader, os: *Vec(s32)) -> bool {
    p0 := r.offset;
    c := Getb(r);
    while c != 34 {
        if c < 0 { unused Syntax(r, "unclosed quoted string", p0); return false }
        if c == 92 {
            e0 := r.offset;
            c = Getb(r);
            if c < 0 { break }
            if c == 13 {
                c = Getb(r);
                if c != 10 { Ungetb(r) }
                c = Getb(r);
                continue;
            } else if c == 10 {
                c = Getb(r);
                if c != 13 { Ungetb(r) }
                c = Getb(r);
                continue;
            } else if c == #char "b" { c = 8 }
            else if c == #char "f" { c = 12 }
            else if c == #char "n" { c = 10 }
            else if c == #char "r" { c = 13 }
            else if c == #char "t" { c = 9 }
            else if c == #char "v" { c = 11 }
            else if c >= #char "0" && c <= #char "7" {
                oct: s32 = 0;
                i: s32 = 0;
                while true {
                    if !(c >= #char "0" && c <= #char "7") { unused Syntax(r, "illegal octal escape", e0); return false }
                    oct = (oct << 3) | (c - #char "0");
                    i += 1;
                    if i == 3 { break }
                    c = Getb(r);
                }
                c = oct & 255;
            } else if c == #char "x" {
                c0 := Hex(Getb(r));
                c1 := Hex(Getb(r));
                if c0 < 0 || c1 < 0 { unused Syntax(r, "illegal hex escape", e0); return false }
                c = (c0 << 4) | c1;
            }
        }
        VecPush(<<os, c);
        c = Getb(r);
    }
    return true;
}

SimpleString :: (r: *SReader, first: s32, hint: *Vec(s32)) -> s32 {
    c := first;
    dec: s64 = -1;
    hasdigits := false;
    if c >= #char "0" && c <= #char "9" {
        // A Limbo int: the length wraps at 32 bits.
        d: u32 = 0;
        while c >= #char "0" && c <= #char "9" {
            d = d * 10 + cast(u32)(c - #char "0");
            hasdigits = true;
            c = Getb(r);
        }
        dec = cast(s64)cast(s32)d;
        if dec < 0 || dec > 1048576 { return Syntax(r, "implausible token length", -1) }
    }
    if c == 34 {
        text: Vec(s32);
        if !Unquote(r, *text) { return -2 }
        return StringNode(*text, hint);
    }
    if c == #char "|" || c == #char "#" {
        enc: Vec(s32);
        if !ToClosing(r, c, *enc) { return -2 }
        bytes: Vec(u8);
        if c == #char "|" { Base64Decode(*enc, *bytes) } else { Base16Decode(*enc, *bytes) }
        return SForm(*bytes, hint);
    }
    if c == #char ":" && dec >= 0 {
        a: Vec(u8);
        for i: 1..dec {
            b := Getb(r);
            if b < 0 { return Syntax(r, "missing bytes in raw token", -1) }
            VecPush(a, cast(u8)b);
        }
        return SForm(*a, hint);
    }
    if hasdigits { return Syntax(r, "token can't start with a digit", -1) }
    s: Vec(s32);
    while IsTokenc(c) {
        VecPush(s, c);
        c = Getb(r);
    }
    if s.count == 0 { return Syntax(r, "missing token", -1) }
    if c >= 0 { Ungetb(r) }
    return StringNode(*s, hint);
}

#scope_export

// One expression: its node, -1 at the end of input, or -2 after an error.
ParseItem :: (r: *SReader) -> s32 {
    p0 := r.offset;
    c := Ws(r);
    if c < 0 { return -1 }
    nohint: Vec(s32);
    if c == #char "{" {
        a: Vec(s32);
        if !ToClosing(r, #char "}", *a) { return -2 }
        nested: SReader;
        nested.last = -1;
        Base64Decode(*a, *nested.data);
        n := ParseItem(*nested);
        if nested.failed {
            r.failed = true;
            VecSwap(r.diag.bytes, nested.diag.bytes);
            r.errpos = nested.errpos;
            return -2;
        }
        return n;
    }
    if c == #char "(" {
        kids: Vec(s32);
        c = Ws(r);
        while c != #char ")" {
            if c < 0 { return Syntax(r, "unclosed '('", p0) }
            Ungetb(r);
            e := ParseItem(r);
            if e == -2 { return -2 }
            VecPush(kids, e);
            c = Ws(r);
        }
        n := NewNode(LIST);
        for i: 0..kids.count - 1 { VecPush(snodes[n].kids, kids[i]) }
        return n;
    }
    if c == #char "[" {
        e := SimpleString(r, Getb(r), *nohint);
        if e == -2 { return -2 }
        c = Ws(r);
        if c != #char "]" {
            if c >= 0 { Ungetb(r) }
            return Syntax(r, "missing ] in display hint", p0);
        }
        if e < 0 || snodes[e].kind != STRING { return Syntax(r, "illegal display hint", -1) }
        hint: Vec(s32);
        for i: 0..snodes[e].s.count - 1 { VecPush(hint, snodes[e].s[i]) }
        return SimpleString(r, Ws(r), *hint);
    }
    return SimpleString(r, c, *nohint);
}

// The error text of a failed read, as Sexp.read: "diag at offset n".
ReadError :: (r: *SReader) -> Text {
    pos := r.errpos;
    if pos < 0 { pos += r.offset }
    out: Vec(u8);
    BuilderPrint(*out, "% at offset %", TextView(r.diag), pos);
    return BuilderFinish(out);
}

Base64Decode :: (s: *Vec(s32), out: *Vec(u8)) {
    b24: s32 = 0;
    i: s32 = 0;
    for n: 0..s.count - 1 {
        c := s.*[n];
        v: s32 = -1;
        if c >= #char "A" && c <= #char "Z" { v = c - #char "A" }
        else if c >= #char "a" && c <= #char "z" { v = c - #char "a" + 26 }
        else if c >= #char "0" && c <= #char "9" { v = c - #char "0" + 52 }
        else if c == #char "+" { v = 62 }
        else if c == #char "/" { v = 63 }
        if v < 0 { continue }
        if i == 0 { b24 = v << 18 }
        else if i == 1 { b24 |= v << 12 }
        else if i == 2 { b24 |= v << 6 }
        else {
            b24 |= v;
            VecPush(<<out, cast(u8)(b24 >> 16));
            VecPush(<<out, cast(u8)(b24 >> 8));
            VecPush(<<out, cast(u8)b24);
            i = -1;
        }
        i += 1;
    }
    if i == 2 { VecPush(<<out, cast(u8)(b24 >> 16)) }
    if i == 3 {
        VecPush(<<out, cast(u8)(b24 >> 16));
        VecPush(<<out, cast(u8)(b24 >> 8));
    }
}

Base16Decode :: (s: *Vec(s32), out: *Vec(u8)) {
    j: s32 = 0;
    n: s32 = 0;
    for i: 0..s.count - 1 {
        c := s.*[i];
        n = n << 4;
        if c >= #char "0" && c <= #char "9" { n |= c - #char "0" }
        else if c >= #char "A" && c <= #char "F" { n |= c - #char "A" + 10 }
        else if c >= #char "a" && c <= #char "f" { n |= c - #char "a" + 10 }
        else { continue }
        j += 1;
        if j == 2 {
            VecPush(<<out, cast(u8)n);
            j = 0;
            n = 0;
        }
    }
}

Base64Encode :: (a: *Vec(u8), out: *Vec(u8)) {
    v := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    n := a.count;
    if n == 0 { return }
    start := out.count;
    i: s64 = 0;
    while i < n {
        x := cast(s32)a.*[i] << 16;
        i += 1;
        if i < n { x |= cast(s32)a.*[i] << 8; i += 1 }
        if i < n { x |= cast(s32)a.*[i]; i += 1 }
        VecPush(<<out, v[cast(s64)((x >> 18) & 63)]);
        VecPush(<<out, v[cast(s64)((x >> 12) & 63)]);
        VecPush(<<out, v[cast(s64)((x >> 6) & 63)]);
        VecPush(<<out, v[cast(s64)(x & 63)]);
    }
    m := n % 3;
    if m != 0 {
        out.*[out.count - 1] = #char "=";
        if m == 1 { out.*[out.count - 2] = #char "=" }
    }
}

Base16Encode :: (a: *Vec(u8), out: *Vec(u8)) {
    hex := "0123456789ABCDEF";
    for i: 0..a.count - 1 {
        n := cast(s64)a.*[i];
        VecPush(<<out, hex[n >> 4]);
        VecPush(<<out, hex[n & 15]);
    }
}

#scope_file

IsToken :: (s: *Vec(s32)) -> bool {
    if s.count == 0 { return false }
    for i: 0..s.count - 1 {
        c := s.*[i];
        if c >= #char "0" && c <= #char "9" { if i == 0 { return false } continue }
        if (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") || c == #char "-" || c == #char "." ||
            c == #char "/" || c == #char "_" || c == #char ":" || c == #char "*" || c == #char "+" || c == #char "=" { continue }
        return false;
    }
    return true;
}

// esc: how a rune is written inside a quoted string, or false for itself.
Esc :: (out: *Vec(u8), c: s32) -> bool {
    if c == 34 { unused BuilderAppend(<<out, "\\\""); return true }
    if c == 92 { unused BuilderAppend(<<out, "\\\\"); return true }
    if c == 8 { unused BuilderAppend(<<out, "\\b"); return true }
    if c == 12 { unused BuilderAppend(<<out, "\\f"); return true }
    if c == 10 { unused BuilderAppend(<<out, "\\n"); return true }
    if c == 9 { unused BuilderAppend(<<out, "\\t"); return true }
    if c == 13 { unused BuilderAppend(<<out, "\\r"); return true }
    if c == 11 { unused BuilderAppend(<<out, "\\v"); return true }
    if c < 32 || c >= 127 {
        hex := "0123456789abcdef";
        b := cast(s64)(c & 255);
        unused BuilderAppend(<<out, "\\x");
        VecPush(<<out, hex[b >> 4]);
        VecPush(<<out, hex[b & 15]);
        return true;
    }
    return false;
}

PutRunes :: (out: *Vec(u8), s: *Vec(s32)) {
    for i: 0..s.count - 1 { PutRuneUtf8(out, s.*[i]) }
}

PutRuneUtf8 :: (out: *Vec(u8), r: s32) {
    if r < 128 && r >= 0 { VecPush(<<out, cast(u8)r); return }
    if r < 2048 && r >= 0 {
        VecPush(<<out, cast(u8)(192 | (r >> 6)));
        VecPush(<<out, cast(u8)(128 | (r & 63)));
        return;
    }
    if r < 65536 && r >= 0 {
        VecPush(<<out, cast(u8)(224 | (r >> 12)));
        VecPush(<<out, cast(u8)(128 | ((r >> 6) & 63)));
        VecPush(<<out, cast(u8)(128 | (r & 63)));
        return;
    }
    VecPush(<<out, cast(u8)(240 | ((r >> 18) & 7)));
    VecPush(<<out, cast(u8)(128 | ((r >> 12) & 63)));
    VecPush(<<out, cast(u8)(128 | ((r >> 6) & 63)));
    VecPush(<<out, cast(u8)(128 | (r & 63)));
}

QuoteRunes :: (out: *Vec(u8), s: *Vec(s32)) {
    if IsToken(s) { PutRunes(out, s); return }
    VecPush(<<out, 34);
    for i: 0..s.count - 1 {
        if !Esc(out, s.*[i]) { PutRuneUtf8(out, s.*[i]) }
    }
    VecPush(<<out, 34);
}

PackBytes :: (out: *Vec(u8), n: s32, bytes: *Vec(u8)) {
    BuilderPrint(out, "%:", bytes.count);
    for i: 0..bytes.count - 1 { VecPush(<<out, bytes.*[i]) }
}

RunesUtf8 :: (s: *Vec(s32), out: *Vec(u8)) { PutRunes(out, s) }

#scope_export

// Sexp.text
SexpText :: (out: *Vec(u8), n: s32) {
    if n < 0 { return }
    k := snodes[n].kind;
    if k == STRING {
        if snodes[n].hint.count != 0 {
            VecPush(<<out, #char "[");
            QuoteRunes(out, *snodes[n].hint);
            VecPush(<<out, #char "]");
        }
        QuoteRunes(out, *snodes[n].s);
        return;
    }
    if k == BINARY {
        if snodes[n].hint.count != 0 {
            VecPush(<<out, #char "[");
            QuoteRunes(out, *snodes[n].hint);
            VecPush(<<out, #char "]");
        }
        if snodes[n].data.count <= 4 {
            VecPush(<<out, #char "#");
            Base16Encode(*snodes[n].data, out);
            VecPush(<<out, #char "#");
        } else {
            VecPush(<<out, #char "|");
            Base64Encode(*snodes[n].data, out);
            VecPush(<<out, #char "|");
        }
        return;
    }
    VecPush(<<out, #char "(");
    for i: 0..snodes[n].kids.count - 1 {
        if i > 0 { VecPush(<<out, 32) }
        SexpText(out, snodes[n].kids[i]);
    }
    VecPush(<<out, #char ")");
}

// Sexp.pack, the canonical form.
SexpPack :: (out: *Vec(u8), n: s32) {
    if n < 0 { return }
    k := snodes[n].kind;
    if k == LIST {
        VecPush(<<out, #char "(");
        for i: 0..snodes[n].kids.count - 1 { SexpPack(out, snodes[n].kids[i]) }
        VecPush(<<out, #char ")");
        return;
    }
    if snodes[n].hint.count != 0 {
        hint: Vec(u8);
        RunesUtf8(*snodes[n].hint, *hint);
        VecPush(<<out, #char "[");
        PackBytes(out, 0, *hint);
        VecPush(<<out, #char "]");
    }
    if k == STRING {
        s: Vec(u8);
        RunesUtf8(*snodes[n].s, *s);
        PackBytes(out, 0, *s);
    } else {
        PackBytes(out, 0, *snodes[n].data);
    }
}

// Sexp.astext: a string's text, a binary's bytes read as UTF-8, nothing
// for a list.
SexpAsText :: (out: *Vec(u8), n: s32) {
    if n < 0 { return }
    if snodes[n].kind == STRING { PutRunes(out, *snodes[n].s) }
    else if snodes[n].kind == BINARY {
        bytes: Vec(u8);
        for i: 0..snodes[n].data.count - 1 { VecPush(bytes, snodes[n].data[i]) }
        runes: Vec(s32);
        DecodeUtf8(TextView(bytes[:]), *runes);
        PutRunes(out, *runes);
    }
}

// Limbo's string of a byte array: UTF-8, a bad byte becoming U+FFFD.
DecodeUtf8 :: (text: string, out: *Vec(s32)) {
    i: s64;
    while i < text.count {
        c := cast(s32)text[i];
        if c < 128 { VecPush(<<out, c); i += 1; continue }
        need: s64 = 0;
        r: s32 = 0;
        min: s32 = 0;
        if c >= 240 && c < 248 { need = 3; r = c & 7; min = 65536 }
        else if c >= 224 && c < 240 { need = 2; r = c & 15; min = 2048 }
        else if c >= 192 && c < 224 { need = 1; r = c & 31; min = 128 }
        ok := need > 0;
        j := i + 1;
        while ok && j <= i + need {
            if j >= text.count || text[j] < 128 || text[j] >= 192 { ok = false; break }
            r = (r << 6) | (cast(s32)text[j] & 63);
            j += 1;
        }
        if ok && r >= min && r <= 1114111 { VecPush(<<out, r); i = j } else { VecPush(<<out, 65533); i += 1 }
    }
}

SexpIsList :: (n: s32) -> bool { return n >= 0 && snodes[n].kind == LIST }

// A string node holding the runes of text, as ref Sexp.String(text, nil).
TextNode :: (text: string) -> s32 {
    n := NewNode(STRING);
    runes: Vec(s32);
    DecodeUtf8(text, *runes);
    for i: 0..runes.count - 1 { VecPush(snodes[n].s, runes[i]) }
    return n;
}
