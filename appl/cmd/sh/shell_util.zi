// Text helpers the shell and its builtin modules share: UTF-8 runes,
// sys->tokenize, str->unquoted, filepat->match and the Limbo shell's
// variable hash. Limbo strings index runes; these work on runes too.
#import "std/vec";

#scope_export

// The rune at byte i and the index after it. Bad bytes count as one rune.
RuneAt :: (s: string, i: s64) -> (rune: s32, next: s64) {
    c := cast(s32)s[i];
    if c < 128 { return c, i + 1 }
    need: s64;
    r: s32;
    if c >= 240 && c < 248 { need = 3; r = c & 7 }
    else if c >= 224 { need = 2; r = c & 15 }
    else if c >= 192 { need = 1; r = c & 31 }
    else { return c, i + 1 }
    j := i + 1;
    while j <= i + need {
        if j >= s.count { return c, i + 1 }
        b := cast(s32)s[j];
        if b < 128 || b >= 192 { return c, i + 1 }
        r = (r << 6) | (b & 63);
        j += 1;
    }
    return r, j;
}

Runes :: (s: string) -> Vec(s32) {
    out: Vec(s32);
    i: s64;
    while i < s.count {
        r, next := RuneAt(s, i);
        VecPush(out, r);
        i = next;
    }
    return out;
}

RuneCount :: (s: string) -> s64 {
    n: s64;
    i: s64;
    while i < s.count {
        _, next := RuneAt(s, i);
        n += 1;
        i = next;
    }
    return n;
}

PutRune :: (out: *Vec(u8), r: s32) {
    if r < 0 || r > 1114111 { r = 65533 }
    if r < 128 { VecPush(<<out, cast(u8)r); return }
    if r < 2048 {
        VecPush(<<out, cast(u8)(192 | (r >> 6)));
        VecPush(<<out, cast(u8)(128 | (r & 63)));
        return;
    }
    if r < 65536 {
        VecPush(<<out, cast(u8)(224 | (r >> 12)));
        VecPush(<<out, cast(u8)(128 | ((r >> 6) & 63)));
        VecPush(<<out, cast(u8)(128 | (r & 63)));
        return;
    }
    VecPush(<<out, cast(u8)(240 | (r >> 18)));
    VecPush(<<out, cast(u8)(128 | ((r >> 12) & 63)));
    VecPush(<<out, cast(u8)(128 | ((r >> 6) & 63)));
    VecPush(<<out, cast(u8)(128 | (r & 63)));
}

HasRune :: (set: []s32, r: s32) -> bool {
    for set { if it == r { return true } }
    return false;
}

HasRuneIn :: (set: *Vec(s32), r: s32) -> bool {
    for i: 0..set.count - 1 { if set.*[i] == r { return true } }
    return false;
}

// sys->tokenize: the pieces between runes of seps, empty pieces dropped.
Tokenize :: (s: string, seps: string) -> Vec(Text) {
    sep := Runes(seps);
    out: Vec(Text);
    i: s64;
    while i < s.count {
        r, next := RuneAt(s, i);
        if HasRune(sep[:], r) { i = next; continue }
        start := i;
        while i < s.count {
            r2, n2 := RuneAt(s, i);
            if HasRune(sep[:], r2) { break }
            i = n2;
        }
        VecPush(out, TextCopy(s[start:i]));
    }
    return out;
}

IsBlank :: (c: u8) -> bool { return c == 32 || c == 9 || c == 10 }

// str->unquoted: words split at blanks outside single quotes, where ''
// inside quotes is one quote. Unbalanced quotes are closed at the end.
Unquoted :: (s: string) -> Vec(Text) {
    args: Vec(Text);
    word: Vec(u8);
    inquote := false;
    j := s.count;
    while j > 0 {
        c := s[j - 1];
        if IsBlank(c) { j -= 1; continue }
        i := j - 1;
        while i >= 0 {
            c = s[i];
            if IsBlank(c) && !inquote { break }
            if c == 39 {
                piece: Vec(u8);
                unused BuilderAppend(piece, s[i + 1:j]);
                unused BuilderAppend(piece, TextView(word[:]));
                VecSwap(word, piece);
                j = i;
                if !inquote || i == 0 || s[i - 1] != 39 {
                    inquote = !inquote;
                } else {
                    i -= 1;
                }
            }
            i -= 1;
        }
        whole: Vec(u8);
        unused BuilderAppend(whole, s[i + 1:j]);
        unused BuilderAppend(whole, TextView(word[:]));
        t: Text = BuilderFinish(whole);
        VecPush(args, t);
        VecClear(word);
        j = i;
    }
    if inquote {
        again: Vec(u8);
        unused BuilderAppend(again, s);
        VecPush(again, 39);
        closed: Text = BuilderFinish(again);
        return Unquoted(TextView(closed));
    }
    // The words were found from the end.
    out: Vec(Text);
    k := args.count - 1;
    while k >= 0 {
        moved: Text;
        VecSwap(moved.bytes, args[k].bytes);
        VecPush(out, moved);
        k -= 1;
    }
    return out;
}

IsNum :: (s: string) -> bool {
    for s { if it > #char "9" || it < #char "0" { return false } }
    return true;
}

Compare :: (a: string, b: string) -> s32 {
    n := ifx a.count < b.count then a.count else b.count;
    for i: 0..n - 1 {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
    }
    if a.count < b.count { return -1 }
    if a.count > b.count { return 1 }
    return 0;
}

// The Limbo shell's hashfn over runes, on 32-bit ints.
HashName :: (s: string, n: s32) -> s32 {
    h: u32;
    i: s64;
    while i < s.count {
        r, next := RuneAt(s, i);
        h = h * 65599 + cast(u32)r;
        i = next;
    }
    return cast(s32)((h & 0x7fffffff) % cast(u32)n);
}

// Limbo's int conversion of a string: optional blanks, a sign and leading
// decimal digits; anything else ends the number.
LimboInt :: (s: string) -> s64 {
    i: s64;
    while i < s.count && (s[i] == 32 || s[i] == 9) { i += 1 }
    neg := false;
    if i < s.count && (s[i] == #char "-" || s[i] == #char "+") { neg = s[i] == #char "-"; i += 1 }
    v: s64;
    while i < s.count && s[i] >= #char "0" && s[i] <= #char "9" {
        v = v * 10 + cast(s64)(s[i] - #char "0");
        i += 1;
    }
    v = cast(s64)cast(s32)v;
    return ifx neg then -v else v;
}

#scope_file

// The next pattern rune, possibly backslash-escaped: (index, rune, escaped).
PatChar :: (pat: []s32, p: s64) -> (next: s64, r: s32, esc: s32) {
    if p == pat.count { return p, 0, -1 }
    r := pat[p];
    p += 1;
    if p == pat.count || r != 92 { return p, r, 0 }
    return p + 1, pat[p], 1;
}

PatRange :: (pat: []s32, p: s64) -> (next: s64, lo: s32, hi: s32) {
    q, lo, _ := PatChar(pat, p);
    q1, hi, esc := PatChar(pat, q);
    if esc == 0 && hi == #char "-" {
        q2, hi2, _ := PatChar(pat, q1);
        return q2, lo, hi2;
    }
    return q, lo, lo;
}

MatchRunes :: (pat: []s32, name: []s32) -> bool {
    n: s64;
    p: s64;
    while p < pat.count {
        r := pat[p];
        p += 1;
        if r == #char "*" {
            rest := pat[p:];
            if rest.count == 0 { return true }
            while n <= name.count {
                if MatchRunes(rest, name[n:]) { return true }
                n += 1;
            }
            return false;
        } else if r == #char "[" {
            if n == name.count { return false }
            s := name[n];
            n += 1;
            matched := false;
            invert := false;
            first := true;
            esc: s32;
            closed := false;
            while p < pat.count {
                p2, r2, esc2 := PatChar(pat, p);
                p = p2; r = r2; esc = esc2;
                if first && esc == 0 && r == #char "^" {
                    invert = true;
                    first = false;
                    continue;
                }
                first = false;
                if esc == 0 && r == #char "]" { closed = true; break }
                p3, lo, hi := PatRange(pat, p - 1);
                p = p3;
                if lo <= s && s <= hi { matched = true }
            }
            if !closed || invert == matched { return false }
        } else if r == #char "?" {
            if n == name.count { return false }
            n += 1;
        } else if r == 92 {
            if n == name.count || p == pat.count { return false }
            pc := pat[p];
            p += 1;
            nc := name[n];
            n += 1;
            if pc != nc { return false }
        } else {
            if n == name.count { return false }
            if r != name[n] { return false }
            n += 1;
        }
    }
    return n == name.count;
}

#scope_export

// filepat->match: *, ?, [...] with ^ and ranges, and \ escapes.
Match :: (pat: string, name: string) -> bool {
    p := Runes(pat);
    n := Runes(name);
    return MatchRunes(p[:], n[:]);
}
