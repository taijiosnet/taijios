#import "std/vec";
using Args :: #import "taijios_args";
using Io :: #import "taijios_io";
using Cli :: #import "zx_cli";

main :: () -> s32 {
    count := Args.OperandCount();
    i: s32;
    newline := true;
    first := Args.Operand(0);
    if first == "-n" || first == "--" {
        newline = first != "-n";
        i = 1;
    }
    output: Text;
    while i < count {
        if !BuilderAppend(output.bytes, Args.Operand(i)) { return 1 }
        i += 1;
        if i < count && !BuilderAppend(output.bytes, " ") { return 1 }
    }
    if newline && !BuilderAppend(output.bytes, "\n") { return 1 }
    if Cli.WriteAll(1, TextView(output)) { return 0 }
    problem := Io.LastError();
    unused Cli.WriteAll(2, "echo: write error: ");
    unused Cli.WriteAll(2, problem);
    unused Cli.WriteAll(2, "\n");
    return 1;
}
