using Args :: #import "taijios_args";
using Cli :: #import "zx_cli";
using Names :: #import "taijios_names";

main :: () -> s32 {
    count := Args.OperandCount();
    options := Cli.ParseNameOptions(count, false);
    operands := count - options.next;
    if !options.valid || operands < 1 || operands > 2 || (options.directory && operands != 1) {
        return Cli.Usage("usage: basename [-d] string [suffix]\n");
    }
    path := Args.Operand(options.next);
    if options.directory {
        Cli.PrintLine(Names.Dirname(path));
    } else {
        Cli.PrintLine(Names.Basename(path, Args.Operand(options.next + 1)));
    }
    return 0;
}
