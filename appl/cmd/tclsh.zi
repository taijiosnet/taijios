// Hosted input adapter for the Inferno Tcl shell port. See ../../NOTICE (MIT).
// A small tcl_input module supplies Script for the console ZX entry.
#import "std/vec"
using Tcl :: #import "tcl/interpreter"
using Packages :: #import "tcl/packages"
using Input :: #import "tcl_input"

main :: () -> s32 {
    interpreter: Tcl.Interpreter;
    Packages.Attach(*interpreter);
    result := Tcl.Eval(*interpreter, Input.Script);
    output: Text = Tcl.TakeOutput(*interpreter);
    print("%", TextView(output));
    if result.code != .OK && result.code != .Exit {
        print("tclsh: %\n", TextView(result.value));
        return 1;
    }
    return 0;
}
