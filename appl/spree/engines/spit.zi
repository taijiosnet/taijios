// Spree Spit 2-player card game engine, ported from appl/spree/engines/spit.b.
#import "std/vec"
using Core :: #import "spree_core"
using Allow :: #import "allow"
using CL :: #import "cardlib"

CLICK :: 0;
SPIT :: 1;
SAY :: 2;
SHOW :: 3;

SpitMember :: struct {
    spare: s32;
    row: [4]s32;
    centre: s32;
}

SpitEngine :: struct {
    cs: CL.CardState;
    al: Allow.AllowList;
    dmembers: [2]SpitMember;
    deck: s32;
    playing: bool;
    dealt: bool;
    winner_id: s32;
}

ClientType :: () -> string { return "cards" }
MaxMembers :: () -> s32 { return 2 }
Propose :: (n: s32) -> string { return ifx n != 2 then "need exactly two members" else "" }

NewStack :: (c: *Core.Clique, parent_id: s32, style: string, maxc: s32, stype: string) -> s32 {
    s := CL.NewStack(c, parent_id, -1, .{style = style, maxcards = maxc, conceal = false, title = ""});
    Core.ObjSetAttr(c, s, "type", stype, Core.SetNone());
    Core.ObjSetAttr(c, s, "actions", "click", Core.SetAll());
    return s;
}

ClearSel :: (e: *SpitEngine, c: *Core.Clique) {
    for i: 0..e.cs.cmembers.count-1 { CL.SelSet(*e.cs, c, *e.cs.cmembers[i].sel, -1) }
}

OwnerOrd :: (e: *SpitEngine, c: *Core.Clique, stack_id: s32) -> s32 {
    pid := c.objects[stack_id].parent_id;
    for i: 0..1 {
        if e.cs.cmembers[i].obj_id == pid { return cast(s32)i }
    }
    return -1;
}

Deal :: (e: *SpitEngine, c: *Core.Clique) {
    ClearSel(e, c);
    n := cast(s32)c.objects[e.deck].children.count;
    if n > 0 {
        Core.ObjTransfer(c, e.deck, 0, n / 2, e.dmembers[0].spare, 0);
        Core.ObjTransfer(c, e.deck, 0, cast(s32)c.objects[e.deck].children.count, e.dmembers[1].spare, 0);
    }
    for i: 0..1 {
        d := *e.dmembers[i];
        done := false;
        for j: 0..3 {
            for k: j..3 {
                sn := cast(s32)c.objects[d.spare].children.count;
                if sn == 0 { done = true; break }
                Core.ObjTransfer(c, d.spare, sn - 1, sn, d.row[k], cast(s32)c.objects[d.row[k]].children.count);
            }
            if done { break }
        }
        for j: 0..3 {
            rn := c.objects[d.row[j]].children.count;
            if rn > 0 { CL.SetFace(c, c.objects[d.row[j]].children[rn - 1], 1) }
        }
    }
}

Go :: (e: *SpitEngine, c: *Core.Clique) {
    for i: 0..1 {
        d := *e.dmembers[i];
        other := *e.dmembers[1 - i];
        n := cast(s32)c.objects[d.spare].children.count;
        if n > 0 {
            Core.ObjTransfer(c, d.spare, n - 1, n, d.centre, cast(s32)c.objects[d.centre].children.count);
        } else if c.objects[other.spare].children.count > 0 {
            m := cast(s32)c.objects[other.spare].children.count;
            Core.ObjTransfer(c, other.spare, m - 1, m, d.centre, cast(s32)c.objects[d.centre].children.count);
        } else {
            for j: 0..1 {
                CL.Discard(c, e.dmembers[j].centre, e.dmembers[j].spare, false);
                CL.Flip(c, e.dmembers[j].spare);
            }
            Go(e, c);
            return;
        }
        cn := c.objects[d.centre].children.count;
        if cn > 0 { CL.SetFace(c, c.objects[d.centre].children[cn - 1], 1) }
    }
}

CanPlay :: (e: *SpitEngine, c: *Core.Clique, ord: s32) -> bool {
    d := *e.dmembers[ord];
    nmulti: s32 = 0;
    nfree: s32 = 0;
    for j: 0..3 {
        s1 := d.row[j];
        nc := c.objects[s1].children.count;
        if nc > 0 {
            if nc > 1 { nmulti += 1 }
            c1 := CL.GetCard(c, c.objects[s1].children[nc - 1]);
            for k: 0..1 {
                s2 := e.dmembers[k].centre;
                nc2 := c.objects[s2].children.count;
                if nc2 > 0 {
                    c2 := CL.GetCard(c, c.objects[s2].children[nc2 - 1]);
                    if (c1.number + 1) % 13 == c2.number || (c1.number + 12) % 13 == c2.number {
                        return true;
                    }
                }
            }
        } else {
            nfree += 1;
        }
    }
    return nmulti > 0 && nfree > 0;
}

BottomDiscard :: (c: *Core.Clique, src: s32, dst: s32) {
    CL.Flip(c, src);
    for i: 0..c.objects[src].children.count-1 {
        CL.SetFace(c, c.objects[src].children[i], 0);
    }
    Core.ObjTransfer(c, src, 0, cast(s32)c.objects[src].children.count, dst, 0);
}

FinishRound :: (e: *SpitEngine, c: *Core.Clique, win_ord: s32) {
    loser := *e.dmembers[1 - win_ord];
    for i: 0..1 {
        BottomDiscard(c, e.dmembers[i].centre, loser.spare);
        for j: 0..3 { BottomDiscard(c, e.dmembers[i].row[j], loser.spare) }
    }
    e.playing = false;
    e.dealt = false;
    Allow.Del(*e.al, CLICK, -1);
    Allow.Add(*e.al, SPIT, -1, "spit");
    ClearSel(e, c);
}

Start :: (e: *SpitEngine, c: *Core.Clique, m0: s32, m1: s32) {
    CL.Init(*e.cs);
    unused VecResize(e.al.actions, 0);
    e.winner_id = -1;
    unused CL.JoinMember(*e.cs, c, m0);
    unused CL.JoinMember(*e.cs, c, m1);
    pset := Core.SetAdd(Core.SetSingleton(m0), m1);
    Core.ObjSetVisibility(c, e.cs.cmembers[0].layout_id, Core.SetAdd(Core.SetDiff(Core.SetAll(), pset), m0));

    for i: 0..1 {
        pobj := e.cs.cmembers[i].obj_id;
        e.dmembers[i].spare = NewStack(c, pobj, "pile", 13, "spare");
        for j: 0..3 { e.dmembers[i].row[j] = NewStack(c, pobj, "display", 4, "row") }
        e.dmembers[i].centre = NewStack(c, pobj, "pile", 13, "centre");
    }
    e.deck = Core.CliqueNewObject(c, 0, Core.SetAll(), "stack");
    CL.MakeCards(c, e.deck, 0, 13, "0");
    CL.Shuffle(c, e.deck);
    Deal(e, c);
    e.dealt = true;
    e.playing = false;
    Allow.Add(*e.al, SPIT, -1, "spit");
    Allow.Add(*e.al, SAY, -1, "say &");
    Allow.Add(*e.al, SHOW, -1, "show");
}

Command :: (e: *SpitEngine, c: *Core.Clique, member_id: s32, cmd: string) -> string {
    toks: Vec(Text);
    tag, err := Allow.CheckAction(*e.al, c, member_id, cmd, *toks);
    if err.count > 0 {
        if e.winner_id >= 0 {
            return ifx e.winner_id == member_id then "game has finished: you have won" else "game has finished: you have lost";
        }
        return err;
    }
    ord := CL.FindMember(*e.cs, member_id);
    if ord < 0 { return "you're only watching" }
    sel := *e.cs.cmembers[ord].sel;
    d := *e.dmembers[ord];

    if tag == SHOW { Core.CliqueShow(c, member_id); return "" }
    if tag == SAY { return "" }
    if tag == SPIT {
        if !e.dealt {
            Deal(e, c);
            e.dealt = true;
        } else if !e.playing {
            Go(e, c);
            Allow.Add(*e.al, CLICK, -1, "click %o %d");
            e.playing = true;
        } else if !CanPlay(e, c, 1 - ord) {
            Go(e, c);
        } else {
            return "it is possible to play";
        }
        return "";
    }
    if tag == CLICK {
        stack_id := CL.ParseInt(TextView(toks[1]));
        idx := CL.ParseInt(TextView(toks[2]));
        nc := cast(s32)c.objects[stack_id].children.count;
        stype: Text;
        unused Core.ObjGetAttr(c, stack_id, "type", *stype);
        st := TextView(stype);
        if CL.SelIsEmpty(sel) || sel.stack_id == stack_id {
            if idx < 0 || idx >= nc { return "invalid index" }
            if OwnerOrd(e, c, stack_id) != ord { return "not yours, don't touch!" }
            if st != "row" { return "you can't move cards from there" }
            card := CL.GetCard(c, c.objects[stack_id].children[nc - 1]);
            if card.face == 0 {
                CL.SetFace(c, c.objects[stack_id].children[nc - 1], 1);
            } else if CL.SelIsEmpty(sel) {
                CL.SelSet(*e.cs, c, sel, stack_id);
                CL.SelSetRange(*e.cs, c, sel, nc - 1, nc);
            } else {
                CL.SelSet(*e.cs, c, sel, -1);
            }
            return "";
        }
        from_id := sel.stack_id;
        if st == "centre" {
            card := CL.GetCard(c, c.objects[from_id].children[sel.start]);
            onto := CL.GetCard(c, c.objects[stack_id].children[nc - 1]);
            if (card.number + 1) % 13 != onto.number && (card.number + 12) % 13 != onto.number {
                CL.SelSet(*e.cs, c, sel, -1);
                return "out of sequence";
            }
            CL.SelTransfer(*e.cs, c, sel, stack_id, nc);
            all_empty := true;
            for j: 0..3 {
                if c.objects[d.row[j]].children.count > 0 { all_empty = false; break }
            }
            if all_empty {
                if c.objects[d.spare].children.count == 0 {
                    e.winner_id = member_id;
                    Allow.Del(*e.al, CLICK, -1);
                    Allow.Del(*e.al, SPIT, -1);
                    ClearSel(e, c);
                } else {
                    FinishRound(e, c, ord);
                }
            }
            return "";
        }
        if st == "row" {
            if OwnerOrd(e, c, stack_id) != ord { CL.SelSet(*e.cs, c, sel, -1); return "not yours, don't touch!" }
            if nc != 0 { CL.SelSet(*e.cs, c, sel, -1); return "cannot stack cards" }
            CL.SelTransfer(*e.cs, c, sel, stack_id, nc);
            return "";
        }
        CL.SelSet(*e.cs, c, sel, -1);
        return "can't move there";
    }
    return "unknown command";
}
