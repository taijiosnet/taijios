<../../mkconfig

ENGINES=\
	engines/afghan.dis \
	engines/bounce.dis \
	engines/canfield.dis \
	engines/freecell.dis \
	engines/gather.dis \
	engines/lobby.dis \
	engines/othello.dis \
	engines/racingdemon.dis \
	engines/spit.dis \
	engines/spider.dis \
	engines/whist.dis \

CLIENTS=\
	clients/cards.dis \

LIB=\
	lib/allow.dis \
	lib/cardlib.dis \
	lib/objstore.dis \
	lib/tricks.dis \

MAIN=\
	archives.dis \
	spree.dis \

MODULES=\
	sys.m\
	draw.m\
	tk.m\
	tkclient.m\
	styx.m\
	styxservers.m\

DEST=$ROOT/dis/spree

ALL= ${ENGINES:%=$DEST/%} \
	${CLIENTS:%=$DEST/%} \
	${LIB:%=$DEST/%} \
	${MAIN:%=$DEST/%} \
	$DEST/joinsession.zx \
	$DEST/clients/othello.zx \
	$DEST/clients/gather.zx \
	$DEST/clients/lobby.zx

all:V: $ENGINES $CLIENTS $LIB $MAIN joinsession.zx clients/othello.zx clients/gather.zx clients/lobby.zx

clients/lobby.zx: clients/lobby.zi clients/lobby_model.zi ../cmd/tcltk/tcltk.zi ../cmd/tcltk/zx_surface.zi ../cmd/taijios_files.zi ../cmd/taijios_stdin.zi ../cmd/taijios_io.zi ../cmd/taijios_process.zi mkfile
	(cd clients && ziran bundle --project --root . --define TK_MENU --module-path . --module-path ../../cmd/tcltk --module-path ../../cmd --bind-host zx_surface --bind-host taijios_files --bind-host taijios_stdin --bind-host taijios_io --bind-host taijios_process --entry lobby:main -o lobby.zx lobby.zi)

$DEST/clients/lobby.zx: clients/lobby.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 clients/lobby.zx "$staged" && mv "$staged" "$target"

clients/gather.zx: clients/gather.zi clients/gather_model.zi ../cmd/tcltk/tcltk.zi ../cmd/tcltk/zx_surface.zi ../cmd/taijios_files.zi ../cmd/taijios_stdin.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi ../cmd/taijios_process.zi mkfile
	(cd clients && ziran bundle --project --root . --module-path . --module-path ../../cmd/tcltk --module-path ../../cmd --bind-host zx_surface --bind-host taijios_files --bind-host taijios_stdin --bind-host taijios_args --bind-host taijios_io --bind-host taijios_process --entry gather:main -o gather.zx gather.zi)

$DEST/clients/gather.zx: clients/gather.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 clients/gather.zx "$staged" && mv "$staged" "$target"

clients/othello.zx: clients/othello.zi clients/othello_model.zi ../cmd/tcltk/tcltk.zi ../cmd/tcltk/zx_surface.zi ../cmd/taijios_files.zi ../cmd/taijios_stdin.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi mkfile
	(cd clients && ziran bundle --project --root . --module-path . --module-path ../../cmd/tcltk --module-path ../../cmd --bind-host zx_surface --bind-host taijios_files --bind-host taijios_stdin --bind-host taijios_args --bind-host taijios_io --entry othello:main -o othello.zx othello.zi)

$DEST/clients/othello.zx: clients/othello.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 clients/othello.zx "$staged" && mv "$staged" "$target"

joinsession.zx: joinsession.zi join_model.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi ../cmd/taijios_namespace.zi ../cmd/taijios_process.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../cmd --bind-host taijios_args --bind-host taijios_io --bind-host taijios_namespace --bind-host taijios_process --entry joinsession:main -o $target joinsession.zi

$DEST/joinsession.zx: joinsession.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 joinsession.zx "$staged" && mv "$staged" "$target"

install:V:	$ALL

$ROOT/dis/spree/%.dis:	%.dis
	cp $prereq $target

%.dis:	%.b
	limbo -gw -I$ROOT/module -Ilib -o $stem.dis $stem.b

$ENGINES $MAIN $LIB: spree.m gather.m lib/cardlib.m lib/allow.m lib/objstore.m
$ENGINES $MAIN $CLIENTS $LIB: ${MODULES:%=$ROOT/module/%}

clean:V:
	rm -f *.dis *.sbl */*.dis */*.sbl

nuke:V: clean
	rm -f $DEST/*.dis $DEST/*/*.dis
