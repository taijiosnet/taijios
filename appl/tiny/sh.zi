// tiny/sh: the small shell of appl/tiny/sh.b as a ZX program.
//     sh [-e] [-n] [-l] [-c cmd] [file]
// Words, 'quotes', < > >> redirections, | pipelines and ; & lists, with
// wildcards expanded; each command is a ZX program, cmd.zx in the current
// directory or in /dis. Standard input is read in 1024-byte pieces and each
// piece is one line of commands, as the Limbo shell did.
#import "std/vec";
#import "std/option";
Args :: #import "taijios_args";
Io :: #import "taijios_io";
Ns :: #import "taijios_namespace";
Process :: #import "taijios_process";
#import "shell_util";
#import "shell_filepat";

#scope_file

// U+FFF0 marks a word whose wildcards were quoted.
QUOTED :: "\xef\xbf\xb0";

SEQ :: 0;
ASYNC :: 1;

Command :: struct {
    args: Vec(Text);
    inf: Text;
    outf: Text;
    append: bool;
}

Pipeline :: struct {
    cmds: Vec(Command);
    term: s32;
}

Err :: (s: string) { unused Io.Write(2, s) }

Usage :: () { Err("Usage: sh [-n] [-c cmd] [file]\n") }

IsMeta :: (c: u8) -> bool {
    return c == #char "*" || c == #char "[" || c == #char "?" || c == #char "#" || c == 39 || c == #char "|" ||
        c == #char "&" || c == #char ";" || c == #char ">" || c == #char "<";
}

HasMark :: (t: *Text) -> bool { return TextView(<<t).count >= 3 && TextView(<<t)[:3] == QUOTED }

AddChar :: (token: *Text, c: u8) {
    if IsMeta(c) && !HasMark(token) {
        marked: Vec(u8);
        unused BuilderAppend(marked, QUOTED);
        unused BuilderAppend(marked, TextView(<<token));
        VecSwap(token.bytes, marked);
    }
    VecPush(token.bytes, c);
}

PushToken :: (tok: *Vec(Text), token: *Text) {
    t: Text;
    VecSwap(t.bytes, token.bytes);
    VecPush(<<tok, t);
}

PushWord :: (tok: *Vec(Text), s: string) { VecPush(<<tok, TextCopy(s)) }

// The words of a line; a word still open at the end is dropped.
Tokenize :: (s: string, tok: *Vec(Text)) -> bool {
    VecClear(<<tok);
    token: Text;
    instring := false;
    i: s64 = 0;
    while i < s.count {
        c := s[i];
        if instring {
            if c != 39 {
                AddChar(*token, c);
            } else if i == s.count - 1 || s[i + 1] != 39 {
                if i == s.count - 1 || s[i + 1] == 32 || s[i + 1] == 9 || s[i + 1] == 10 { PushToken(tok, *token) }
                instring = false;
            } else {
                VecPush(token.bytes, 39);
                i += 1;
            }
            i += 1;
            continue;
        }
        if c == 32 || c == 9 || c == 10 || c == #char "#" || c == 39 || c == #char "|" || c == #char "&" ||
            c == #char ";" || c == #char ">" || c == #char "<" || c == 13 {
            if token.bytes.count != 0 && c != 39 { PushToken(tok, *token) }
            if c == #char "#" { break }
            if c == 39 {
                instring = true;
            } else if c == #char ">" {
                if i < s.count - 1 && s[i + 1] == c { PushWord(tok, ">>"); i += 1 } else { PushWord(tok, ">") }
            } else if c == #char "|" || c == #char "&" || c == #char ";" || c == #char "<" {
                one: [1]u8;
                one[0] = c;
                PushWord(tok, TextView(one[:]));
            }
        } else {
            VecPush(token.bytes, c);
        }
        i += 1;
    }
    if instring {
        Err("sh: unmatched quote\n");
        VecClear(<<tok);
        return false;
    }
    return true;
}

Unmark :: (s: string) -> string {
    if s.count >= 3 && s[:3] == QUOTED { return s[3:] }
    return s;
}

DoExpand :: (word: string, args: *Vec(Text)) {
    if word.count == 0 { PushWord(args, word); return }
    if word.count >= 3 && word[:3] == QUOTED { PushWord(args, word[3:]); return }
    for word {
        if it == #char "*" || it == #char "[" || it == #char "?" {
            files := Expand(word);
            if files.count != 0 {
                for i: 0..files.count - 1 { PushWord(args, TextView(files[i])) }
                return;
            }
            break;
        }
    }
    PushWord(args, word);
}

// One command up to | ; or &, or false for a syntax error.
GetCommand :: (words: *Vec(Text), at: *s64, cmd: *Command) -> bool {
    while true {
        word: Text = TextCopy(TextView(words.*[at.*]));
        w := TextView(word);
        if w == ">" || w == ">>" {
            if cmd.outf.bytes.count != 0 { return false }
            <<at = at.* + 1;
            if at.* >= words.count { return false }
            unused BuilderAppend(cmd.outf.bytes, Unmark(TextView(words.*[at.*])));
            if w == ">>" { cmd.append = true }
        } else if w == "<" {
            if cmd.inf.bytes.count != 0 { return false }
            <<at = at.* + 1;
            if at.* >= words.count { return false }
            unused BuilderAppend(cmd.inf.bytes, Unmark(TextView(words.*[at.*])));
        } else if w == "|" || w == ";" || w == "&" {
            return true;
        } else {
            DoExpand(w, *cmd.args);
        }
        <<at = at.* + 1;
        if at.* >= words.count { return true }
    }
    return true;
}

GetPipe :: (words: *Vec(Text), at: *s64, p: *Pipeline) -> bool {
    p.term = SEQ;
    last: Text;
    while at.* < words.count {
        SetTo(*last, TextView(words.*[at.*]));
        if TextView(last) == "|" { return false }
        cmd: Command;
        if !GetCommand(words, at, *cmd) { return false }
        VecPush(p.cmds, cmd);
        if at.* >= words.count { break }
        SetTo(*last, TextView(words.*[at.*]));
        <<at = at.* + 1;
        if TextView(last) == ";" { break }
        if TextView(last) == "&" { p.term = ASYNC; break }
        if TextView(last) == "|" { continue }
        return false;
    }
    if TextView(last) == "|" { return false }
    return true;
}

SetTo :: (t: *Text, s: string) {
    VecClear(t.bytes);
    unused BuilderAppend(t.bytes, s);
}

Parse :: (words: *Vec(Text), pipes: *Vec(Pipeline)) -> bool {
    VecClear(<<pipes);
    at: s64 = 0;
    while at < words.count {
        p: Pipeline;
        if !GetPipe(words, *at, *p) {
            Err("sh: syntax error\n");
            VecClear(<<pipes);
            return false;
        }
        VecPush(<<pipes, p);
    }
    return true;
}

// The ZX program for a command, as exec: cmd.zx where it is named, else
// in /zx; or the reason there is none.
Resolve :: (cmd: string, path: *Text, err: *Text) -> bool {
    file: Vec(u8);
    if cmd.count >= 4 && cmd[cmd.count - 4:] == ".dis" { unused BuilderAppend(file, cmd[:cmd.count - 4]) } else { unused BuilderAppend(file, cmd) }
    zx: Vec(u8);
    BuilderPrint(*zx, "%.zx", TextView(file[:]));
    if Executable(TextView(zx[:]), 73) { SetTo(path, TextView(zx[:])); return true }
    dis: Vec(u8);
    BuilderPrint(*dis, "%.dis", TextView(file[:]));
    VecClear(err.bytes);
    BuilderPrint(*err.bytes, "'%' does not exist", TextView(dis[:]));
    absolute := file.count > 0 && (file[0] == #char "/" || (file.count >= 2 && file[0] == #char "." && file[1] == #char "/"));
    if !absolute {
        inbin: Vec(u8);
        BuilderPrint(*inbin, "/zx/%.zx", TextView(file[:]));
        if Executable(TextView(inbin[:]), 73) { SetTo(path, TextView(inbin[:])); return true }
        VecClear(err.bytes);
        BuilderPrint(*err.bytes, "'/zx/%' does not exist", TextView(dis[:]));
    }
    return false;
}

// Start one command with its standard input and output; 0 if it did not start.
StartCommand :: (cmd: *Command, input: s32, output: s32) -> s32 {
    if cmd.args.count == 0 { return 0 }
    path: Text;
    err: Text;
    name := TextView(cmd.args[0]);
    if !Resolve(name, *path, *err) {
        msg: Vec(u8);
        BuilderPrint(*msg, "%: %\n", name, TextView(err));
        Err(TextView(msg[:]));
        return 0;
    }
    ops: Vec(string);
    for i: 1..cmd.args.count - 1 { VecPush(ops, TextView(cmd.args[i])) }
    launch := Process.StartWith(TextView(path), ops[:], input, output, -1);
    if launch.id == 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "%: %\n", name, launch.error);
        Err(TextView(msg[:]));
    }
    return launch.id;
}

// Report a command that failed, as the wait message the Limbo shell printed.
Report :: (id: s32, name: string, outcome: Process.Outcome) {
    status: Vec(u8);
    if outcome.status < 0 {
        unused BuilderAppend(status, outcome.error);
    } else if outcome.status > 0 && outcome.value != 0 {
        if outcome.error != "" { BuilderPrint(*status, "fail:%", outcome.error) } else { BuilderPrint(*status, "fail:%", outcome.value) }
    }
    if status.count == 0 { return }
    msg: Vec(u8);
    BuilderPrint(*msg, "% \"%\":%\n", id, name, TextView(status[:]));
    Err(TextView(msg[:]));
}

background: Vec(s32);

RunPipeline :: (p: *Pipeline) {
    ids: Vec(s32);
    names: Vec(Text);
    inpipe: s32 = -1;
    for k: 0..p.cmds.count - 1 {
        last := k == p.cmds.count - 1;
        infd: s32 = -1;
        if k > 0 {
            infd = inpipe;
        } else if p.cmds[k].inf.bytes.count != 0 {
            infd = Io.Open(TextView(p.cmds[k].inf), 0);
            if infd < 0 {
                msg: Vec(u8);
                BuilderPrint(*msg, "sh: can't open %: %\n", TextView(p.cmds[k].inf), Io.Error());
                Err(TextView(msg[:]));
                return;
            }
        }
        outfd: s32 = -1;
        outpipe: s32 = -1;
        if !last {
            ends: [2]s32;
            if Ns.Pipe(ends[:]) != 0 {
                msg: Vec(u8);
                BuilderPrint(*msg, "sh: can't make pipe: %\n", Ns.Error());
                Err(TextView(msg[:]));
                return;
            }
            outpipe = ends[0];
            outfd = ends[1];
        } else if p.cmds[k].outf.bytes.count != 0 {
            if p.cmds[k].append {
                outfd = Io.Open(TextView(p.cmds[k].outf), 1);
                if outfd >= 0 { unused Io.Seek(outfd, 0, 2) }
            }
            if outfd < 0 { outfd = Io.Create(TextView(p.cmds[k].outf), 1, 438) }
            if outfd < 0 {
                msg: Vec(u8);
                BuilderPrint(*msg, "sh: can't open %: %\n", TextView(p.cmds[k].outf), Io.Error());
                Err(TextView(msg[:]));
                if infd >= 0 { unused Io.Close(infd) }
                return;
            }
        }
        id := StartCommand(*p.cmds[k], infd, outfd);
        if infd >= 0 { unused Io.Close(infd) }
        if outfd >= 0 { unused Io.Close(outfd) }
        if id != 0 {
            VecPush(ids, id);
            VecPush(names, TextCopy(TextView(p.cmds[k].args[0])));
        }
        inpipe = outpipe;
    }
    if p.term == ASYNC {
        for ids { VecPush(background, it) }
        return;
    }
    for i: 0..ids.count - 1 {
        outcome := Process.Wait(ids[i]);
        Report(ids[i], TextView(names[i]), outcome);
    }
}

RunLine :: (line: string) {
    ReapBackground();
    words: Vec(Text);
    if !Tokenize(line, *words) || words.count == 0 { return }
    pipes: Vec(Pipeline);
    if !Parse(*words, *pipes) { return }
    for i: 0..pipes.count - 1 { RunPipeline(*pipes[i]) }
}

ReapBackground :: () {
    i: s64 = 0;
    while i < background.count {
        outcome := Process.Poll(background[i]);
        if outcome.status == -2 { i += 1; continue }
        background[i] = background[background.count - 1];
        unused VecPop(background);
    }
}

// Each line of a file.
Script :: (path: string) {
    h := Io.Open(path, 0);
    if h < 0 {
        msg: Vec(u8);
        BuilderPrint(*msg, "sh: open %: %\n", path, Io.Error());
        Err(TextView(msg[:]));
        return;
    }
    line: Vec(u8);
    buf: [8192]u8;
    while true {
        n := Io.Read(h, buf[:]);
        if n <= 0 { break }
        for i: 0..n - 1 {
            VecPush(line, buf[i]);
            if buf[i] == 10 {
                RunLine(TextView(line[:]));
                VecClear(line);
            }
        }
    }
    if line.count != 0 { RunLine(TextView(line[:])) }
    unused Io.Close(h);
}

ReadSmall :: (path: string, out: *Vec(u8)) -> bool {
    h := Io.Open(path, 0);
    if h < 0 { return false }
    buf: [128]u8;
    n := Io.Read(h, buf[:]);
    unused Io.Close(h);
    if n < 0 { return false }
    unused BuilderAppend(<<out, TextView(buf[:n]));
    return true;
}

// -l: $home from /dev/user, then /lib/infernoinit and $home/lib/infernoinit.
Startup :: () {
    user: Vec(u8);
    home: Vec(u8);
    if ReadSmall("/dev/user", *user) { BuilderPrint(*home, "/usr/%", TextView(user[:])) } else { VecPush(home, #char "/") }
    h := Io.Create("/env/home", 1, 384);
    if h >= 0 { unused Io.Write(h, TextView(home[:])); unused Io.Close(h) }
    profile := "/lib/infernoinit";
    EScript(profile);
    mine: Vec(u8);
    unused BuilderAppend(mine, TextView(home[:]));
    unused BuilderAppend(mine, profile);
    EScript(TextView(mine[:]));
}

// A script that exists.
EScript :: (path: string) {
    h := Io.Open(path, 0);
    if h < 0 { return }
    unused Io.Close(h);
    Script(path);
}

#scope_export

main :: () -> s32 {
    count := Args.OperandCount();
    eflag := false;
    nflag := false;
    lflag := false;
    hascmd := false;
    cmd: Text;
    i: s32 = 0;
    while i < count {
        a := Args.Operand(i);
        if a.count == 0 || a[0] != #char "-" { break }
        if a == "-e" { eflag = true }
        else if a == "-n" { nflag = true }
        else if a == "-l" { lflag = true }
        else if a == "-c" {
            if count - (i + 1) != 1 { Usage(); return 0 }
            i += 1;
            SetTo(*cmd, Args.Operand(i));
            hascmd = true;
        } else { Usage(); return 0 }
        i += 1;
    }
    if lflag { Startup() }
    if !eflag { unused Ns.ForkEnv() }
    if !nflag { unused Ns.Fork() }
    if hascmd {
        line: Vec(u8);
        BuilderPrint(*line, "%\n", TextView(cmd));
        RunLine(TextView(line[:]));
        return 0;
    }
    if i < count {
        Script(Args.Operand(i));
        return 0;
    }
    name: Vec(u8);
    if !ReadSmall("#c/sysname", *name) { unused BuilderAppend(name, "anon") }
    unused BuilderAppend(name, "$ ");
    buf: [1024]u8;
    while true {
        unused Io.Write(1, TextView(name[:]));
        n := Io.Read(0, buf[:]);
        if n <= 0 { break }
        RunLine(TextView(buf[:n]));
    }
    return 0;
}
