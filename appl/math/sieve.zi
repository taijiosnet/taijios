// Sieve of Eratosthenes benchmark with 5 algorithms (replaces appl/math/sieve.b).
Args :: #import "taijios_args";
Arg :: #import "zx_arg";
MathUtil :: #import "math_util";
#import "std/format"
#import "std/vec"

M :: 16 * 1024 * 1024
N :: 8 * M

out: Vec(u8);

FlushIfNeeded :: () {
    if out.count >= 16384 {
        MathUtil.WriteOut(TextView(out[:]));
        VecClear(out);
    }
}

Init0 :: (lim: s64) -> s64 {
    p: Vec(u8);
    VecResize(p, lim);
    for i: 0..lim - 1 { p[i] = 1 }
    p[0] = 0;
    p[1] = 0;
    np: s64 = 0;
    for i: 0..lim - 1 {
        if p[i] == 1 {
            np += 1;
            BuilderPrint(*out, "%\n", i);
            FlushIfNeeded();
            j := i + i;
            while j < lim {
                p[j] = 0;
                j += i;
            }
        }
    }
    return np;
}

Init1 :: (lim: s64) -> s64 {
    n := (lim + 31) / 32;
    p: Vec(u32);
    VecResize(p, n);
    for i: 0..n - 1 { p[i] = 0xffffffff }
    p[0] = 0xfffffffc;
    np: s64 = 0;
    for i: 0..lim - 1 {
        bit := cast(u32)1 << cast(u32)(i & 31);
        if (p[i >> 5] & bit) != 0 {
            np += 1;
            BuilderPrint(*out, "%\n", i);
            FlushIfNeeded();
            j := i + i;
            while j < lim {
                jbit := cast(u32)1 << cast(u32)(j & 31);
                p[j >> 5] = p[j >> 5] & ~jbit;
                j += i;
            }
        }
    }
    return np;
}

Init2 :: (lim: s64) -> s64 {
    n := ((lim + 1) / 2 + 31) / 32;
    p: Vec(u32);
    VecResize(p, n);
    for i: 0..n - 1 { p[i] = 0xffffffff }
    p[0] = 0xfffffffe;
    np: s64 = 1;
    unused BuilderAppend(out, "2\n");
    i: s64 = 1;
    while i < lim {
        k := (i - 1) >> 1;
        bit := cast(u32)1 << cast(u32)(k & 31);
        if (p[k >> 5] & bit) != 0 {
            np += 1;
            BuilderPrint(*out, "%\n", i);
            FlushIfNeeded();
            inc := i + i;
            j := i + i + i;
            while j < lim {
                kj := (j - 1) >> 1;
                jbit := cast(u32)1 << cast(u32)(kj & 31);
                p[kj >> 5] = p[kj >> 5] & ~jbit;
                j += inc;
            }
        }
        i += 2;
    }
    return np;
}

Init3 :: (lim: s64) -> s64 {
    n := ((lim + 2) / 3 + 31) / 32;
    p: Vec(u32);
    VecResize(p, n);
    for i: 0..n - 1 { p[i] = 0xffffffff }
    p[0] = 0xfffffffe;
    np: s64 = 2;
    unused BuilderAppend(out, "2\n3\n");
    d: s64 = 2;
    i: s64 = 1;
    while i < lim {
        k := (i - 1) / 3;
        bit := cast(u32)1 << cast(u32)(k & 31);
        if (p[k >> 5] & bit) != 0 {
            np += 1;
            BuilderPrint(*out, "%\n", i);
            FlushIfNeeded();
            inc := 6 * i;
            j := 5 * i;
            while j > 0 && j < lim {
                kj := (j - 1) / 3;
                jbit := cast(u32)1 << cast(u32)(kj & 31);
                p[kj >> 5] = p[kj >> 5] & ~jbit;
                j += inc;
            }
            j = 7 * i;
            while j > 0 && j < lim {
                kj := (j - 1) / 3;
                jbit := cast(u32)1 << cast(u32)(kj & 31);
                p[kj >> 5] = p[kj >> 5] & ~jbit;
                j += inc;
            }
        }
        d = 6 - d;
        i += d;
    }
    return np;
}

ClearMod30 :: (p: *Vec(u32), start: s64, inc: s64, lim: s64) {
    j := start;
    while j > 0 && j < lim {
        k := (17 * (j % 30 - 1)) / 60 + 8 * (j / 30);
        jbit := cast(u32)1 << cast(u32)(k & 31);
        p.*[k >> 5] = p.*[k >> 5] & ~jbit;
        j += inc;
    }
}

Init4 :: (lim: s64) -> s64 {
    n := (4 * ((lim + 14) / 15) + 31) / 32;
    p: Vec(u32);
    VecResize(p, n);
    for i: 0..n - 1 { p[i] = 0xffffffff }
    p[0] = 0xfffffffe;
    np: s64 = 3;
    unused BuilderAppend(out, "2\n3\n5\n");
    m: s64 = -1;
    d: [8]s64 = .[6, 4, 2, 4, 2, 4, 6, 2];
    i: s64 = 1;
    while i < lim {
        k := (17 * (i % 30 - 1)) / 60 + 8 * (i / 30);
        bit := cast(u32)1 << cast(u32)(k & 31);
        if (p[k >> 5] & bit) != 0 {
            np += 1;
            BuilderPrint(*out, "%\n", i);
            FlushIfNeeded();
            inc := 30 * i;
            ClearMod30(*p, 7 * i, inc, lim);
            ClearMod30(*p, 11 * i, inc, lim);
            ClearMod30(*p, 13 * i, inc, lim);
            ClearMod30(*p, 17 * i, inc, lim);
            ClearMod30(*p, 19 * i, inc, lim);
            ClearMod30(*p, 23 * i, inc, lim);
            ClearMod30(*p, 29 * i, inc, lim);
            ClearMod30(*p, 31 * i, inc, lim);
        }
        m += 1;
        if m == 8 { m = 0 }
        i += d[m];
    }
    return np;
}

main :: () -> s32 {
    scan: Arg.Scan;
    alg: s64 = 3;
    while true {
        c := Arg.Option(*scan);
        if c == 0 { break }
        if c == 97 {
            av, ok := Arg.Value(*scan);
            if ok { alg = MathUtil.ParseInt(av) }
        }
    }
    if alg < 0 || alg > 4 { alg = 3 }
    limits: [5]s64 = .[M, N, 2 * N, 3 * N, 15 * (N / 4)];
    lim := limits[alg];
    if scan.next < Args.OperandCount() {
        lim = MathUtil.ParseInt(Args.Operand(scan.next));
    }
    if lim < 0 || lim > limits[alg] { lim = limits[alg] }
    np: s64 = 0;
    if lim < 6 {
        if lim > 2 {
            unused BuilderAppend(out, "2\n");
            np += 1;
        }
        if lim > 3 {
            unused BuilderAppend(out, "3\n");
            np += 1;
        }
    } else if alg == 0 {
        np = Init0(lim);
    } else if alg == 1 {
        np = Init1(lim);
    } else if alg == 2 {
        np = Init2(lim);
    } else if alg == 3 {
        np = Init3(lim);
    } else {
        np = Init4(lim);
    }
    BuilderPrint(*out, "% primes < %\n", np, lim);
    MathUtil.WriteOut(TextView(out[:]));
    return 0;
}
