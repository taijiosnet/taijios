// Arbitrary-precision signed integer arithmetic (base 10^9) for zx/math ZX tools.
#import "std/format"
#import "std/vec"

BASE :: 1000000000

BigInt :: struct {
    neg: bool;
    limbs: Vec(u32);
}

Trim :: (a: *BigInt) {
    while a.limbs.count > 0 && a.limbs[a.limbs.count - 1] == 0 {
        VecResize(a.limbs, a.limbs.count - 1);
    }
    if a.limbs.count == 0 { a.neg = false }
}

FromInt :: (v: s64) -> BigInt {
    r: BigInt;
    x := v;
    if x < 0 {
        r.neg = true;
        x = -x;
    }
    while x > 0 {
        VecPush(r.limbs, cast(u32)(x % BASE));
        x /= BASE;
    }
    return r;
}

Clone :: (a: *BigInt) -> BigInt {
    r: BigInt;
    r.neg = a.neg;
    for i: 0..a.limbs.count - 1 {
        VecPush(r.limbs, a.limbs[i]);
    }
    return r;
}

CopyInto :: (dst: *BigInt, src: *BigInt) {
    dst.neg = src.neg;
    VecClear(dst.limbs);
    for i: 0..src.limbs.count - 1 {
        VecPush(dst.limbs, src.limbs[i]);
    }
}

IsZero :: (a: *BigInt) -> bool {
    return a.limbs.count == 0;
}

CmpAbs :: (a: *BigInt, b: *BigInt) -> s32 {
    if a.limbs.count < b.limbs.count { return -1 }
    if a.limbs.count > b.limbs.count { return 1 }
    i := a.limbs.count - 1;
    while i >= 0 {
        if a.limbs[i] < b.limbs[i] { return -1 }
        if a.limbs[i] > b.limbs[i] { return 1 }
        i -= 1;
    }
    return 0;
}

Cmp :: (a: *BigInt, b: *BigInt) -> s32 {
    if a.limbs.count == 0 && b.limbs.count == 0 { return 0 }
    if a.neg && !b.neg { return -1 }
    if !a.neg && b.neg { return 1 }
    c := CmpAbs(a, b);
    if a.neg { return -c }
    return c;
}

AddAbs :: (a: *BigInt, b: *BigInt) -> BigInt {
    r: BigInt;
    n := a.limbs.count;
    if b.limbs.count > n { n = b.limbs.count }
    carry: u64 = 0;
    for i: 0..n - 1 {
        sum := carry;
        if i < a.limbs.count { sum += cast(u64)a.limbs[i] }
        if i < b.limbs.count { sum += cast(u64)b.limbs[i] }
        if sum >= BASE {
            VecPush(r.limbs, cast(u32)(sum - BASE));
            carry = 1;
        } else {
            VecPush(r.limbs, cast(u32)sum);
            carry = 0;
        }
    }
    if carry > 0 { VecPush(r.limbs, cast(u32)carry) }
    return r;
}

// Assumes |a| >= |b|
SubAbs :: (a: *BigInt, b: *BigInt) -> BigInt {
    r: BigInt;
    borrow: s64 = 0;
    for i: 0..a.limbs.count - 1 {
        diff := cast(s64)a.limbs[i] - borrow;
        if i < b.limbs.count { diff -= cast(s64)b.limbs[i] }
        if diff < 0 {
            diff += BASE;
            borrow = 1;
        } else {
            borrow = 0;
        }
        VecPush(r.limbs, cast(u32)diff);
    }
    Trim(*r);
    return r;
}

Add :: (a: *BigInt, b: *BigInt) -> BigInt {
    if a.neg == b.neg {
        r := AddAbs(a, b);
        r.neg = a.neg;
        Trim(*r);
        return r;
    }
    c := CmpAbs(a, b);
    if c == 0 { z: BigInt; return z }
    if c > 0 {
        r := SubAbs(a, b);
        r.neg = a.neg;
        Trim(*r);
        return r;
    }
    r := SubAbs(b, a);
    r.neg = b.neg;
    Trim(*r);
    return r;
}

Sub :: (a: *BigInt, b: *BigInt) -> BigInt {
    nb := Clone(b);
    if nb.limbs.count > 0 { nb.neg = !nb.neg }
    return Add(a, *nb);
}

MulSmall :: (a: *BigInt, m: u64) -> BigInt {
    if a.limbs.count == 0 || m == 0 { z: BigInt; return z }
    r: BigInt;
    carry: u64 = 0;
    for i: 0..a.limbs.count - 1 {
        prod := cast(u64)a.limbs[i] * m + carry;
        VecPush(r.limbs, cast(u32)(prod % BASE));
        carry = prod / BASE;
    }
    while carry > 0 {
        VecPush(r.limbs, cast(u32)(carry % BASE));
        carry /= BASE;
    }
    Trim(*r);
    return r;
}

Mul :: (a: *BigInt, b: *BigInt) -> BigInt {
    if a.limbs.count == 0 || b.limbs.count == 0 { z: BigInt; return z }
    r: BigInt;
    VecResize(r.limbs, a.limbs.count + b.limbs.count);
    for i: 0..a.limbs.count - 1 {
        carry: u64 = 0;
        ai := cast(u64)a.limbs[i];
        for j: 0..b.limbs.count - 1 {
            cur := cast(u64)r.limbs[i + j] + ai * cast(u64)b.limbs[j] + carry;
            r.limbs[i + j] = cast(u32)(cur % BASE);
            carry = cur / BASE;
        }
        k := i + b.limbs.count;
        while carry > 0 {
            cur := cast(u64)r.limbs[k] + carry;
            r.limbs[k] = cast(u32)(cur % BASE);
            carry = cur / BASE;
            k += 1;
        }
    }
    r.neg = a.neg != b.neg;
    Trim(*r);
    return r;
}

ModSmall :: (a: *BigInt, m: s64) -> s64 {
    if m <= 0 { return 0 }
    rem: s64 = 0;
    i := a.limbs.count - 1;
    while i >= 0 {
        rem = (rem * BASE + cast(s64)a.limbs[i]) % m;
        i -= 1;
    }
    if a.neg && rem != 0 { rem = m - rem }
    return rem;
}

// Non-negative a mod positive m
Mod :: (a: *BigInt, m: *BigInt) -> BigInt {
    if m.limbs.count == 0 { z: BigInt; return z }
    if CmpAbs(a, m) < 0 { return Clone(a) }
    rem: BigInt;
    i := a.limbs.count - 1;
    while i >= 0 {
        if rem.limbs.count > 0 || a.limbs[i] != 0 {
            nrem: BigInt;
            VecPush(nrem.limbs, a.limbs[i]);
            for k: 0..rem.limbs.count - 1 {
                VecPush(nrem.limbs, rem.limbs[k]);
            }
            CopyInto(*rem, *nrem);
        }
        if CmpAbs(*rem, m) >= 0 {
            lo: u64 = 0;
            hi: u64 = BASE - 1;
            best: u64 = 0;
            while lo <= hi {
                mid := (lo + hi) / 2;
                prod := MulSmall(m, mid);
                if CmpAbs(*prod, *rem) <= 0 {
                    best = mid;
                    lo = mid + 1;
                } else {
                    if mid == 0 { break }
                    hi = mid - 1;
                }
            }
            if best > 0 {
                prod := MulSmall(m, best);
                next_rem := SubAbs(*rem, *prod);
                CopyInto(*rem, *next_rem);
            }
        }
        i -= 1;
    }
    Trim(*rem);
    return rem;
}

AppendDecimal :: (out: *Vec(u8), a: *BigInt) {
    if a.limbs.count == 0 {
        unused BuilderAppend(out.*, "0");
        return;
    }
    if a.neg { unused BuilderAppend(out.*, "-") }
    top := a.limbs.count - 1;
    BuilderPrint(out, "%", cast(s64)a.limbs[top]);
    i := top - 1;
    while i >= 0 {
        v := cast(s64)a.limbs[i];
        div: s64 = 100000000;
        for _: 0..8 {
            d := (v / div) % 10;
            VecPush(out.*, cast(u8)(48 + d));
            div /= 10;
        }
        i -= 1;
    }
}
