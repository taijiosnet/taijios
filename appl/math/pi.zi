// Compute digits of pi via Machin-like series (replaces appl/math/pi.b).
Args :: #import "taijios_args";
MathUtil :: #import "math_util";
#import "std/format"
#import "std/vec"

LBASE :: 3
BASE :: 1000

Terms :: (dp: s64, f: s64, v: s64) -> (t_out: s64, p_out: s64) {
    p := dp;
    t: s64 = 0;
    while true {
        t = 2 + cast(s64)((cast(float64)p * MathUtil.Log(10.0) + MathUtil.Log(cast(float64)v)) / MathUtil.Log(cast(float64)f));
        if (t & 1) == 0 { t += 1 }
        e := cast(s64)(MathUtil.Log(cast(float64)(v * (t + 1) / 2)) / MathUtil.Log(10.0)) + 1;
        if dp <= p - e { break }
        p += e;
    }
    k := t;
    if t < f * f { k = f * f }
    m := BASE * k;
    if m < 0 || m > 2147483647 || m < BASE || m < k { return -1, -1 }
    return t, p;
}

RoundUp :: (n: s64, m: s64) -> (r_out: s64, q_out: s64) {
    r := m * ((n + m - 1) / m);
    return r, r / m;
}

Series1 :: (m: s64, n: s64, f: s64, a: *Vec(s64), p: *Vec(s64)) {
    n0: s64 = 0;
    i: s64 = 1;
    while i <= m {
        r1: s64 = 0;
        r2: s64 = 0;
        for j: n0..n - 1 {
            v := a.*[j] + r1;
            q := v / f;
            r1 = (v - q * f) * BASE;
            a.*[j] = q;
            v = q + r2;
            q = v / i;
            r2 = (v - q * i) * BASE;
            k := j;
            while q > 0 {
                r := p.*[k] + q;
                if r >= BASE {
                    p.*[k] = r - BASE;
                    q = 1;
                } else {
                    p.*[k] = r;
                    q = 0;
                }
                k -= 1;
            }
        }
        while n0 < n && a.*[n0] == 0 { n0 += 1 }
        i += 2;
        r1 = 0;
        r2 = 0;
        for j: n0..n - 1 {
            v := a.*[j] + r1;
            q := v / f;
            r1 = (v - q * f) * BASE;
            a.*[j] = q;
            v = q + r2;
            q = v / i;
            r2 = (v - q * i) * BASE;
            k := j;
            while q > 0 {
                r := p.*[k] - q;
                if r < 0 {
                    p.*[k] = r + BASE;
                    q = 1;
                } else {
                    p.*[k] = r;
                    q = 0;
                }
                k -= 1;
            }
        }
        while n0 < n && a.*[n0] == 0 { n0 += 1 }
        i += 2;
    }
}

Series2 :: (m: s64, n: s64, f: s64, a: *Vec(s64), p: *Vec(s64)) {
    n0: s64 = 0;
    i: s64 = 1;
    while i <= m {
        r1: s64 = 0;
        r2: s64 = 0;
        for j: n0..n - 1 {
            v := a.*[j] + r1;
            q := v / f;
            r1 = (v - q * f) * BASE;
            a.*[j] = q;
            v = q + r2;
            q = v / i;
            r2 = (v - q * i) * BASE;
            k := j;
            while q > 0 {
                r := p.*[k] - q;
                if r < 0 {
                    p.*[k] = r + BASE;
                    q = 1;
                } else {
                    p.*[k] = r;
                    q = 0;
                }
                k -= 1;
            }
        }
        while n0 < n && a.*[n0] == 0 { n0 += 1 }
        i += 2;
        r1 = 0;
        r2 = 0;
        for j: n0..n - 1 {
            v := a.*[j] + r1;
            q := v / f;
            r1 = (v - q * f) * BASE;
            a.*[j] = q;
            v = q + r2;
            q = v / i;
            r2 = (v - q * i) * BASE;
            k := j;
            while q > 0 {
                r := p.*[k] + q;
                if r >= BASE {
                    p.*[k] = r - BASE;
                    q = 1;
                } else {
                    p.*[k] = r;
                    q = 0;
                }
                k -= 1;
            }
        }
        while n0 < n && a.*[n0] == 0 { n0 += 1 }
        i += 2;
    }
}

RunSeries :: (m: s64, n: s64, f_in: s64, v_in: s64, s: s64, a: *Vec(s64), p: *Vec(s64)) {
    v := v_in * f_in;
    f := f_in * f_in;
    for j: 0..n - 1 { a.*[j] = 0 }
    a.*[0] = v;
    if s == 1 {
        Series1(m, n, f, a, p);
    } else {
        Series2(m, n, f, a, p);
    }
}

ComputePi :: (dp_in: s64, fs: []s64, vs: []s64, ss: []s64, res: *Vec(s64)) -> bool {
    k := fs.count;
    dp, n := RoundUp(dp_in, LBASE);
    cdp := dp;
    m: Vec(s64);
    VecResize(m, k);
    for i: 0..k - 1 {
        mi, adp := Terms(dp + 1, fs[i], vs[i]);
        if mi < 0 { return false }
        m[i] = mi;
        if adp > cdp { cdp = adp }
    }
    cdp2, cn := RoundUp(cdp, LBASE);
    unused cdp2;
    a: Vec(s64);
    VecResize(a, cn);
    p: Vec(s64);
    VecResize(p, cn);
    for i: 0..k - 1 {
        RunSeries(m[i], cn, fs[i], (vs[i] * BASE) / 10, ss[i], *a, *p);
    }
    VecResize(res.*, n);
    for i: 0..n - 1 { res.*[i] = p[i] }
    return true;
}

PrintPi :: (p: []s64) {
    out: Vec(u8);
    VecPush(out, 0xCF);
    VecPush(out, 0x80);
    VecPush(out, 0x20);
    VecPush(out, 0xE2);
    VecPush(out, 0x89);
    VecPush(out, 0x85);
    VecPush(out, 0x20);
    m := BASE / 10;
    BuilderPrint(*out, "%.", p[0] / m);
    MathUtil.AppendZeroPad(*out, p[0] % m, LBASE - 1);
    for i: 1..p.count - 1 {
        MathUtil.AppendZeroPad(*out, p[i], LBASE);
    }
    unused BuilderAppend(out, "\n");
    MathUtil.WriteOut(TextView(out[:]));
}

PiCmp :: (f1: string, f2: string) {
    b1: Vec(u8);
    b2: Vec(u8);
    ok1 := MathUtil.ReadAllFile(f1, *b1);
    ok2 := MathUtil.ReadAllFile(f2, *b2);
    if !ok1 || !ok2 {
        out: Vec(u8);
        BuilderPrint(*out, "cannot open % or %\n", f1, f2);
        MathUtil.WriteOut(TextView(out[:]));
        return;
    }
    minlen := b1.count;
    if b2.count < minlen { minlen = b2.count }
    for i: 0..minlen - 1 {
        if b1[i] != b2[i] {
            if b1[i] == 10 || b2[i] == 10 { return }
            out: Vec(u8);
            BuilderPrint(*out, "% % differ at byte %(", f1, f2, i);
            VecPush(out, b1[i]);
            unused BuilderAppend(out, " ");
            VecPush(out, b2[i]);
            unused BuilderAppend(out, ")\n");
            MathUtil.WriteOut(TextView(out[:]));
            return;
        }
    }
}

main :: () -> s32 {
    argc := Args.OperandCount();
    dp: s64 = 1000;
    if argc > 0 {
        if argc > 1 {
            PiCmp(Args.Operand(0), Args.Operand(1));
            return 0;
        }
        dp = MathUtil.ParseInt(Args.Operand(0));
    }
    if dp <= 0 { return 0 }

    fs2: [3]s64 = .[18, 57, 239];
    vs2: [3]s64 = .[48, 32, 20];
    ss2: [3]s64 = .[1, 1, -1];
    p2: Vec(s64);
    ok2 := ComputePi(dp + 1, fs2[:], vs2[:], ss2[:], *p2);
    if ok2 { PrintPi(p2[:]) }

    fs1: [2]s64 = .[5, 239];
    vs1: [2]s64 = .[16, 4];
    ss1: [2]s64 = .[1, -1];
    p1: Vec(s64);
    ok1 := ComputePi(dp + 1, fs1[:], vs1[:], ss1[:], *p1);

    if !ok1 && !ok2 {
        MathUtil.WriteOut("too many dp: reduce dp or source base\n");
        return 0;
    }
    if ok1 && ok2 {
        if p1.count != p2.count {
            out: Vec(u8);
            BuilderPrint(*out, "lens differ % %\n", p1.count, p2.count);
            MathUtil.WriteOut(TextView(out[:]));
            return 0;
        }
        for i: 0..p1.count - 1 {
            if p1[i] != p2[i] {
                out: Vec(u8);
                BuilderPrint(*out, "arrays differ %/%: % %\n", i, p1.count, p1[i], p2[i]);
                MathUtil.WriteOut(TextView(out[:]));
                return 0;
            }
            if p1[i] < 0 || p1[i] >= BASE {
                out: Vec(u8);
                BuilderPrint(*out, "bad array element %: %\n", i, p1[i]);
                MathUtil.WriteOut(TextView(out[:]));
                return 0;
            }
        }
    }
    return 0;
}
