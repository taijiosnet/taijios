// Find numbers expressible as sums of powers in multiple ways (replaces appl/math/powers.b).
Args :: #import "taijios_args";
Arg :: #import "zx_arg";
MathUtil :: #import "math_util";
#import "std/format"
#import "std/vec"

MAXNODES :: 262144

verbose: bool;
out: Vec(u8);

BNode :: struct {
    sum: s64;
    left: s32;
    right: s32;
}

DNode :: struct {
    sum: s64;
    freq: s32;
    list_head: s32;
    left: s32;
    right: s32;
}

TupleNode :: struct {
    offset: s32;
    count: s32;
    next: s32;
}

bnodes: Vec(BNode);
dnodes: Vec(DNode);
tnodes: Vec(TupleNode);
tvals: Vec(s32);

PowS64 :: (base_in: s64, p_in: s64) -> s64 {
    res: s64 = 1;
    base := base_in;
    p := p_in;
    while p > 0 {
        if (p & 1) != 0 { res *= base }
        base *= base;
        p = p >> 1;
    }
    return res;
}

Hcf :: (a_in: s64, b_in: s64) -> s64 {
    a := a_in;
    b := b_in;
    if b == 0 { return a }
    while a != 0 {
        if a < b {
            t := a;
            a = b;
            b = t;
        }
        a = a % b;
    }
    return b;
}

NCr :: (n: s64, r_in: s64) -> s64 {
    r := r_in;
    if r > n - r { r = n - r }
    if r <= 0 { return 1 }
    num: Vec(s64);
    den: Vec(s64);
    VecResize(num, r);
    VecResize(den, r);
    for i: 0..r - 1 {
        num[i] = n - i;
        den[i] = i + 1;
    }
    for i: 0..r - 1 {
        j: s64 = 0;
        while den[i] != 1 {
            if num[j] != 1 {
                k := Hcf(num[j], den[i]);
                if k != 1 {
                    num[j] /= k;
                    den[i] /= k;
                }
            }
            j += 1;
        }
    }
    f: s64 = 1;
    for i: 0..r - 1 { f *= num[i] }
    return f;
}

NHr :: (n: s64, r: s64) -> s64 {
    if n == 0 { return 0 }
    return NCr(n + r - 1, r);
}

NSr :: (n: s64, i: s64, j: s64) -> s64 {
    return NHr(j, n) - NHr(i, n);
}

NSrmax :: (n: s64, i: s64, m: s64) -> s64 {
    s: s64 = 0;
    k := i;
    while true {
        s += NHr(k + 1, n - 1);
        if s > m { break }
        k += 1;
    }
    if k == i { return i + 1 }
    return k;
}

IRoot :: (x: s64, p: s64) -> s64 {
    if x == 0 || x == 1 { return x }
    v := x;
    n: s64 = 0;
    i: s64 = 32;
    while i > 0 {
        m := ((cast(s64)1 << i) - 1) << i;
        if (v & m) != 0 {
            n += i;
            v = v >> i;
        }
        i = i >> 1;
    }
    a := cast(s64)1 << (n / p);
    b := a << 1;
    while a < b {
        m := (a + b + 1) / 2;
        y := PowS64(m, p);
        if y > x {
            b = m - 1;
        } else if y < x {
            a = m;
        } else {
            a = m;
            b = m;
        }
    }
    return a;
}

AddDup :: (s: s64) -> s32 {
    p: s32 = 0;
    lp: s32 = 0;
    while p >= 0 {
        if s == dnodes[p].sum {
            dnodes[p].freq += 1;
            return dnodes[p].freq;
        }
        lp = p;
        if s < dnodes[p].sum {
            p = dnodes[p].left;
        } else {
            p = dnodes[p].right;
        }
    }
    nid := cast(s32)dnodes.count;
    VecPush(dnodes, DNode.{ sum = s, freq = 2, list_head = -1, left = -1, right = -1 });
    if s < dnodes[lp].sum {
        dnodes[lp].left = nid;
    } else {
        dnodes[lp].right = nid;
    }
    return 2;
}

AddSum :: (s: s64) -> s32 {
    p: s32 = 0;
    lp: s32 = 0;
    while p >= 0 {
        if s == bnodes[p].sum {
            return AddDup(s);
        }
        lp = p;
        if s < bnodes[p].sum {
            p = bnodes[p].left;
        } else {
            p = bnodes[p].right;
        }
    }
    nid := cast(s32)bnodes.count;
    VecPush(bnodes, BNode.{ sum = s, left = -1, right = -1 });
    if s < bnodes[lp].sum {
        bnodes[lp].left = nid;
    } else {
        bnodes[lp].right = nid;
    }
    return 1;
}

FindDup :: (s: s64, c: []s64, f: s32) {
    p: s32 = 0;
    while p >= 0 {
        if s == dnodes[p].sum {
            if dnodes[p].freq >= f {
                m: s32 = 0;
                for i: 0..c.count - 1 {
                    if c[i] != 0 { m += 1 }
                }
                off := cast(s32)tvals.count;
                for i: 0..m - 1 {
                    VecPush(tvals, cast(s32)c[i]);
                }
                tid := cast(s32)tnodes.count;
                VecPush(tnodes, TupleNode.{ offset = off, count = m, next = dnodes[p].list_head });
                dnodes[p].list_head = tid;
            }
            return;
        }
        if s < dnodes[p].sum {
            p = dnodes[p].left;
        } else {
            p = dnodes[p].right;
        }
    }
}

ListGcd :: (head: s32) -> s64 {
    g := cast(s64)tvals[tnodes[head].offset];
    cur := head;
    while cur >= 0 {
        tn := tnodes[cur];
        for i: 0..tn.count - 1 {
            g = Hcf(cast(s64)tvals[tn.offset + i], g);
        }
        cur = tn.next;
    }
    return g;
}

PrintDup :: (p: s32, pow: s64, ix: s64) -> bool {
    if p < 0 { return false }
    if PrintDup(dnodes[p].left, pow, ix) { return true }
    head := dnodes[p].list_head;
    if head >= 0 {
        if ListGcd(head) == 1 {
            min1: s64 = 0x7fffffff;
            min2: s64 = 0x7fffffff;
            cur := head;
            while cur >= 0 {
                cnt := cast(s64)tnodes[cur].count;
                if cnt < min1 {
                    min2 = min1;
                    min1 = cnt;
                } else if cnt < min2 {
                    min2 = cnt;
                }
                cur = tnodes[cur].next;
            }
            idx := min1 + min2 - pow;
            if idx <= ix {
                BuilderPrint(*out, "[%, %] %", idx, cast(s64)dnodes[p].freq, dnodes[p].sum);
                cur = head;
                while cur >= 0 {
                    tn := tnodes[cur];
                    unused BuilderAppend(out, " = ");
                    j := tn.count - 1;
                    while j >= 0 {
                        BuilderPrint(*out, "%**%", cast(s64)tvals[tn.offset + j], pow);
                        if j > 0 { unused BuilderAppend(out, " + ") }
                        j -= 1;
                    }
                    cur = tn.next;
                }
                unused BuilderAppend(out, "\n");
                if out.count >= 16384 {
                    MathUtil.WriteOut(TextView(out[:]));
                    VecClear(out);
                }
                if idx < 0 {
                    unused BuilderAppend(out, "****************\n");
                    return true;
                }
            }
        }
    }
    return PrintDup(dnodes[p].right, pow, ix);
}

InitVal :: (c: []s64, n: s64, p: s64, v: s64) -> s64 {
    for i: 0..n - 1 { c[i] = 0 }
    c[0] = v;
    return PowS64(v, p);
}

NxtVal :: (c: []s64, n: s64, p: s64, s_in: s64) -> s64 {
    s := s_in;
    k := n - 1;
    while k >= 0 {
        s -= PowS64(c[k], p);
        c[k] += 1;
        if k == 0 {
            s += PowS64(c[k], p);
            break;
        } else {
            if c[k] <= c[k - 1] {
                s += PowS64(c[k], p);
                break;
            }
            c[k] = 0;
        }
        k -= 1;
    }
    return s;
}

RunPowers :: (p: s64, n: s64, f: s64, ix: s64, lim0: s64, lim: s64) {
    min_v := lim0;
    c: Vec(s64);
    VecResize(c, n);

    while true {
        imin := IRoot((min_v + n - 1) / n, p);
        imax := NSrmax(n, imin, MAXNODES);
        max_v := PowS64(imax, p) - 1;
        while max_v <= min_v {
            imax += 1;
            max_v = PowS64(imax, p) - 1;
        }
        if max_v > lim {
            max_v = lim;
            imax = IRoot(max_v, p) + 1;
        }

        if verbose {
            BuilderPrint(*out, "searching in %-%(%-%)\n", imin, imax, min_v, max_v);
        }

        VecClear(bnodes);
        VecPush(bnodes, BNode.{ sum = -1, left = -1, right = -1 });
        VecClear(dnodes);
        VecPush(dnodes, DNode.{ sum = -1, freq = 0, list_head = -1, left = -1, right = -1 });
        VecClear(tnodes);
        VecClear(tvals);

        m: s64 = 0;
        mm: s64 = 0;
        maxf: s32 = 0;
        s := InitVal(c[:], n, p, imin);
        while true {
            mm += 1;
            if s >= min_v && s < max_v {
                fr := AddSum(s);
                if fr > maxf { maxf = fr }
                m += 1;
            }
            s = NxtVal(c[:], n, p, s);
            if c[0] == imax { break }
        }

        VecClear(bnodes);

        if cast(s64)maxf >= f {
            if verbose { unused BuilderAppend(out, "finding duplicates\n") }
            s = InitVal(c[:], n, p, imin);
            while true {
                if s >= min_v && s < max_v {
                    FindDup(s, c[:], cast(s32)f);
                }
                s = NxtVal(c[:], n, p, s);
                if c[0] == imax { break }
            }
            stop := PrintDup(0, p, ix);
            if stop { return }
        }

        if verbose {
            BuilderPrint(*out, "%(%) nodes searched\n", m, mm);
        }

        if mm != NSr(n, imin, imax) {
            unused BuilderAppend(out, "**fatal**\n");
            return;
        }

        min_v = max_v;
        if min_v >= lim { break }
    }
}

Usage :: () -> s32 {
    MathUtil.WriteOut("usage: powers -p power -n number -f frequency -i index -l minimum -m maximum -s procs -v\n");
    return 0;
}

main :: () -> s32 {
    p: s64 = 2;
    n: s64 = 2;
    f: s64 = 2;
    ix: s64 = 1 << 30;
    l: s64 = 0;
    m: s64 = 0;
    s_procs: s64 = 1;

    scan: Arg.Scan;
    while true {
        c := Arg.Option(*scan);
        if c == 0 { break }
        if c == 112 {
            av, ok := Arg.Value(*scan);
            if ok { p = MathUtil.ParseInt(av) }
        } else if c == 110 {
            av, ok := Arg.Value(*scan);
            if ok { n = MathUtil.ParseInt(av) }
        } else if c == 102 {
            av, ok := Arg.Value(*scan);
            if ok { f = MathUtil.ParseInt(av) }
        } else if c == 105 {
            av, ok := Arg.Value(*scan);
            if ok { ix = MathUtil.ParseInt(av) }
        } else if c == 108 {
            av, ok := Arg.Value(*scan);
            if ok { l = MathUtil.ParseInt(av) }
        } else if c == 109 {
            av, ok := Arg.Value(*scan);
            if ok { m = MathUtil.ParseInt(av) + 1 }
        } else if c == 115 {
            av, ok := Arg.Value(*scan);
            if ok { s_procs = MathUtil.ParseInt(av) }
        } else if c == 118 {
            verbose = true;
        } else {
            return Usage();
        }
    }
    if scan.next < Args.OperandCount() { return Usage() }

    if p < 2 {
        p = 2;
        BuilderPrint(*out, "setting p = %\n", p);
    }
    if n < 2 {
        n = 2;
        BuilderPrint(*out, "setting n = %\n", n);
    }
    if f < 2 {
        f = 2;
        BuilderPrint(*out, "setting f = %\n", f);
    }
    if l < 0 {
        l = 0;
        BuilderPrint(*out, "setting l = %\n", l);
    }
    if m <= 0 {
        m = (1 << 13) + 1;
        BuilderPrint(*out, "setting m = %\n", m - 1);
    }
    if l >= m {
        if out.count > 0 { MathUtil.WriteOut(TextView(out[:])) }
        return 0;
    }

    unused s_procs;
    RunPowers(p, n, f, ix, l, m);
    if out.count > 0 { MathUtil.WriteOut(TextView(out[:])) }
    return 0;
}
