// Linear algebra routines: printmat, daxpy, dscal, dgefa, dgesl (replaces appl/math/linalg.b).
Args :: #import "taijios_args";
Util :: #import "math_util";
#import "std/format"
#import "std/vec"

Dot :: (x: []float64, y: []float64) -> float64 {
    n := x.count;
    if y.count < n { n = y.count }
    s: float64 = 0.0;
    for i: 0..n - 1 { s += x[i] * y[i] }
    return s;
}

Iamax :: (x: []float64) -> s64 {
    if x.count <= 0 { return 0 }
    best: s64 = 0;
    bval := Util.AbsF64(x[0]);
    for i: 1..x.count - 1 {
        v := Util.AbsF64(x[i]);
        if v > bval {
            bval = v;
            best = i;
        }
    }
    return best;
}

Daxpy :: (da: float64, dx: []float64, dy: []float64) {
    n := dx.count;
    if dy.count < n { n = dy.count }
    if n <= 0 || da == 0.0 { return }
    for i: 0..n - 1 {
        dy[i] += da * dx[i];
    }
}

Dscal :: (da: float64, dx: []float64) {
    for i: 0..dx.count - 1 {
        dx[i] *= da;
    }
}

PrintMat :: (label: string, a: []float64, lda: s64, m: s64, n: s64, out: *Vec(u8)) {
    if m > 30 || n > 10 { return }
    BuilderPrint(out, "%% % by % matrix\n% = [", m, n, label);
    for i: 0..m - 1 {
        Util.AppendF64(out, a[i]);
        for j: 1..n - 1 {
            unused BuilderAppend(out.*, ", ");
            Util.AppendF64(out, a[i + lda * j]);
        }
        if i == m - 1 {
            unused BuilderAppend(out.*, "]\n");
        } else {
            unused BuilderAppend(out.*, ";\n");
        }
    }
}

Dgefa :: (a: []float64, lda: s64, n: s64, ipvt: []s32) -> s32 {
    info: s32 = 0;
    nm1 := n - 1;
    if nm1 >= 1 {
        for k: 0..nm1 - 1 {
            kp1 := k + 1;
            ldak := lda * k;
            l := Iamax(a[ldak + k:ldak + n]) + k;
            ipvt[k] = cast(s32)l;
            if a[ldak + l] != 0.0 {
                if l != k {
                    t := a[ldak + l];
                    a[ldak + l] = a[ldak + k];
                    a[ldak + k] = t;
                }
                t := -1.0 / a[ldak + k];
                Dscal(t, a[ldak + k + 1:ldak + n]);
                for j: kp1..n - 1 {
                    ldaj := lda * j;
                    tj := a[ldaj + l];
                    if l != k {
                        a[ldaj + l] = a[ldaj + k];
                        a[ldaj + k] = tj;
                    }
                    Daxpy(tj, a[ldak + k + 1:ldak + n], a[ldaj + k + 1:ldaj + n]);
                }
            } else {
                info = cast(s32)k;
            }
        }
    }
    ipvt[n - 1] = cast(s32)(n - 1);
    if a[lda * (n - 1) + (n - 1)] == 0.0 {
        info = cast(s32)(n - 1);
    }
    return info;
}

Dgesl :: (a: []float64, lda: s64, n: s64, ipvt: []s32, b: []float64, job: s32) {
    nm1 := n - 1;
    if job == 0 {
        if nm1 >= 1 {
            for k: 0..nm1 - 1 {
                l := cast(s64)ipvt[k];
                t := b[l];
                if l != k {
                    b[l] = b[k];
                    b[k] = t;
                }
                Daxpy(t, a[lda * k + k + 1:lda * k + n], b[k + 1:n]);
            }
        }
        for kb: 0..n - 1 {
            k := n - (kb + 1);
            b[k] = b[k] / a[lda * k + k];
            t := -b[k];
            Daxpy(t, a[lda * k:lda * k + k], b[0:k]);
        }
    } else {
        for k: 0..n - 1 {
            t := Dot(a[lda * k:lda * k + k], b[0:k]);
            b[k] = (b[k] - t) / a[lda * k + k];
        }
        if nm1 >= 1 {
            for kb: 1..nm1 - 1 {
                k := n - (kb + 1);
                b[k] += Dot(a[lda * k + k + 1:lda * k + n], b[k + 1:n]);
                l := cast(s64)ipvt[k];
                if l != k {
                    t := b[l];
                    b[l] = b[k];
                    b[k] = t;
                }
            }
        }
    }
}

main :: () -> s32 {
    // 3x3 test system: A * x = b (column-major: A[i + lda*j])
    // Row 0: 2*x0 + 1*x1 + 1*x2 = 8
    // Row 1: 4*x0 - 6*x1 + 0*x2 = -2
    // Row 2: -2*x0 + 7*x1 + 2*x2 = 9
    // Solution: x = [1, 1, 5]
    a: [9]float64 = .[
        2.0, 4.0, -2.0,
        1.0, -6.0, 7.0,
        1.0, 0.0, 2.0
    ];
    b: [3]float64 = .[8.0, -2.0, 9.0];
    ipvt: [3]s32;
    info := Dgefa(a[:], 3, 3, ipvt[:]);
    Dgesl(a[:], 3, 3, ipvt[:], b[:], 0);
    out: Vec(u8);
    BuilderPrint(*out, "info=% x=", info);
    Util.AppendF64(*out, b[0]);
    unused BuilderAppend(out, " ");
    Util.AppendF64(*out, b[1]);
    unused BuilderAppend(out, " ");
    Util.AppendF64(*out, b[2]);
    VecPush(out, 10);
    Util.WriteOut(TextView(out[:]));
    return 0;
}
