// CSS1 stylesheet and inline declaration parser, ported from appl/ebook/cssparser.b.
#import "std/vec"

Decl :: struct {
    name: Text;
    important: bool;
    val: Text;
}

DeclList :: struct {
    items: Vec(Decl);
}

Rule :: struct {
    selector: Text;
    decls: Vec(Decl);
}

RuleList :: struct {
    items: Vec(Rule);
}

IsSpace :: (c: u8) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 12;
}

LowerByte :: (c: u8) -> u8 {
    return ifx c >= 65 && c <= 90 then c + 32 else c;
}

HexDigit :: (c: u8) -> s32 {
    if c >= 48 && c <= 57 { return cast(s32)(c - 48) }
    if c >= 97 && c <= 102 { return cast(s32)(c - 87) }
    if c >= 65 && c <= 70 { return cast(s32)(c - 55) }
    return -1;
}

HexChar :: (v: s32) -> u8 {
    return ifx v < 10 then cast(u8)(48 + v) else cast(u8)(87 + v);
}

AppendRgbHex :: (r: s32, g: s32, b: s32, out: *Text) {
    cr := ifx r < 0 then 0 else (ifx r > 255 then 255 else r);
    cg := ifx g < 0 then 0 else (ifx g > 255 then 255 else g);
    cb := ifx b < 0 then 0 else (ifx b > 255 then 255 else b);
    unused VecPush(out.bytes, 35); // '#'
    unused VecPush(out.bytes, HexChar((cr >> 4) & 15));
    unused VecPush(out.bytes, HexChar(cr & 15));
    unused VecPush(out.bytes, HexChar((cg >> 4) & 15));
    unused VecPush(out.bytes, HexChar(cg & 15));
    unused VecPush(out.bytes, HexChar((cb >> 4) & 15));
    unused VecPush(out.bytes, HexChar(cb & 15));
}

NormalizeValue :: (raw: string, out: *Text, important: *bool) {
    unused VecResize(out.bytes, 0);
    <<important = false;
    // Trim whitespace
    s: s64 = 0;
    e := raw.count;
    while s < e && IsSpace(raw[s]) { s += 1 }
    while e > s && IsSpace(raw[e - 1]) { e -= 1 }
    val := raw[s:e];

    // Check trailing !important
    if val.count >= 10 {
        // Scan backwards for '!'
        bang: s64 = -1;
        for i: 0..val.count-1 {
            if val[i] == 33 { bang = i }
        }
        if bang >= 0 {
            tail_s := bang + 1;
            while tail_s < val.count && IsSpace(val[tail_s]) { tail_s += 1 }
            tail := val[tail_s:];
            if tail.count == 9 {
                imp: [9]u8;
                for k: 0..8 { imp[k] = LowerByte(tail[k]) }
                if TextView(imp[:]) == "important" {
                    <<important = true;
                    e2 := bang;
                    while e2 > 0 && IsSpace(val[e2 - 1]) { e2 -= 1 }
                    val = val[:e2];
                }
            }
        }
    }

    // Normalize #RGB (3 hex digits) -> #RRGGBB
    if val.count == 4 && val[0] == 35 {
        d0 := HexDigit(val[1]);
        d1 := HexDigit(val[2]);
        d2 := HexDigit(val[3]);
        if d0 >= 0 && d1 >= 0 && d2 >= 0 {
            AppendRgbHex(d0 * 17, d1 * 17, d2 * 17, out);
            return;
        }
    }
    // Normalize #RRGGBB to lowercase
    if val.count == 7 && val[0] == 35 {
        unused VecPush(out.bytes, 35);
        for i: 1..6 { unused VecPush(out.bytes, LowerByte(val[i])) }
        return;
    }

    // Strip surrounding quotes on single quoted string values
    if val.count >= 2 && ((val[0] == 34 && val[val.count - 1] == 34) || (val[0] == 39 && val[val.count - 1] == 39)) {
        unused BuilderAppend(out.bytes, val[1:val.count - 1]);
        return;
    }

    // Collapse internal runs of whitespace to single space
    in_sp := false;
    for i: 0..val.count-1 {
        c := val[i];
        if IsSpace(c) {
            if !in_sp { unused VecPush(out.bytes, 32); in_sp = true }
        } else {
            unused VecPush(out.bytes, c);
            in_sp = false;
        }
    }
}

ParseDeclsInto :: (s: string, out: *Vec(Decl)) {
    unused VecResize(<<out, 0);
    i: s64 = 0;
    while i < s.count {
        while i < s.count && (IsSpace(s[i]) || s[i] == 59) { i += 1 }
        if i >= s.count { break }
        // Skip /* ... */ comments
        if i + 1 < s.count && s[i] == 47 && s[i + 1] == 42 {
            i += 2;
            while i + 1 < s.count && !(s[i] == 42 && s[i + 1] == 47) { i += 1 }
            if i + 1 < s.count { i += 2 }
            continue;
        }
        // Property name until ':'
        ns := i;
        while i < s.count && s[i] != 58 && s[i] != 59 { i += 1 }
        if i >= s.count || s[i] != 58 { continue }
        ne := i;
        while ne > ns && IsSpace(s[ne - 1]) { ne -= 1 }
        i += 1; // skip ':'
        vs := i;
        quote: u8 = 0;
        while i < s.count {
            if quote != 0 {
                if s[i] == quote { quote = 0 }
            } else if s[i] == 34 || s[i] == 39 {
                quote = s[i];
            } else if s[i] == 59 {
                break;
            }
            i += 1;
        }
        ve := i;
        if ne > ns {
            d: Decl;
            for k: ns..ne-1 { unused VecPush(d.name.bytes, LowerByte(s[k])) }
            NormalizeValue(s[vs:ve], *d.val, *d.important);
            if d.val.bytes.count > 0 {
                unused VecPush(<<out, d);
            }
        }
    }
}

ParseDecls :: (s: string, out: *DeclList) {
    ParseDeclsInto(s, *out.items);
}

Parse :: (css: string, out_rules: *RuleList) {
    unused VecResize(out_rules.items, 0);
    i: s64 = 0;
    while i < css.count {
        // Skip whitespace and comments
        while i < css.count {
            if IsSpace(css[i]) { i += 1; continue }
            if i + 1 < css.count && css[i] == 47 && css[i + 1] == 42 {
                i += 2;
                while i + 1 < css.count && !(css[i] == 42 && css[i + 1] == 47) { i += 1 }
                if i + 1 < css.count { i += 2 }
                continue;
            }
            break;
        }
        if i >= css.count { break }
        // Skip @-rules
        if css[i] == 64 {
            while i < css.count && css[i] != 59 && css[i] != 123 { i += 1 }
            if i < css.count && css[i] == 123 {
                depth: s32 = 1;
                i += 1;
                while i < css.count && depth > 0 {
                    if css[i] == 123 { depth += 1 }
                    else if css[i] == 125 { depth -= 1 }
                    i += 1;
                }
            } else if i < css.count {
                i += 1;
            }
            continue;
        }
        sel_start := i;
        while i < css.count && css[i] != 123 { i += 1 }
        if i >= css.count { break }
        sel_group := css[sel_start:i];
        i += 1; // skip '{'
        body_start := i;
        while i < css.count && css[i] != 125 { i += 1 }
        body := css[body_start:i];
        if i < css.count { i += 1 }

        // Split comma-separated selectors; skip context-specific selectors containing whitespace.
        p: s64 = 0;
        while p < sel_group.count {
            ss := p;
            while p < sel_group.count && sel_group[p] != 44 { p += 1 }
            se := p;
            if p < sel_group.count { p += 1 }
            while ss < se && IsSpace(sel_group[ss]) { ss += 1 }
            while se > ss && IsSpace(sel_group[se - 1]) { se -= 1 }
            if se <= ss { continue }
            has_space := false;
            for k: ss..se-1 { if IsSpace(sel_group[k]) { has_space = true; break } }
            if has_space { continue }
            rule: Rule;
            for k: ss..se-1 { unused VecPush(rule.selector.bytes, LowerByte(sel_group[k])) }
            ParseDeclsInto(body, *rule.decls);
            unused VecPush(out_rules.items, rule);
        }
    }
}
