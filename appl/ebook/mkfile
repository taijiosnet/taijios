<../../mkconfig

TARG=

MODULES=

SYSMODULES=

DISBIN=$ROOT/dis/ebook

<$ROOT/mkfiles/mkdis

ebook.zx: ebook.zi oebpackage.zi reader_model.zi units.zi ../cmd/tcltk/tcltk.zi ../cmd/tcltk/zx_surface.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi ../cmd/taijios_stdin.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../cmd/tcltk --module-path ../cmd --define TK_NO_CANVAS --bind-host zx_surface --bind-host taijios_args --bind-host taijios_io --bind-host taijios_stdin --entry ebook:main -o $target ebook.zi

$DISBIN/ebook.zx: ebook.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 ebook.zx "$staged" && mv "$staged" "$target"

install:V:	$DISBIN/ebook.zx
