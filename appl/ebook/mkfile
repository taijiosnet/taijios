<../../mkconfig

TARG=\

MODULES=\

SYSMODULES=\

DISBIN=$ROOT/dis/ebook

<$ROOT/mkfiles/mkdis

ebook.zx: ebook.zi reader_model.zi oebpackage.zi mimeimage.zi units.zi strmap.zi cssparser.zi stylesheet.zi cssfont.zi table.zi ../cmd/tcltk/tcltk.zi ../cmd/tcltk/zx_surface.zi ../cmd/taijios_args.zi ../cmd/taijios_io.zi ../cmd/taijios_files.zi ../cmd/taijios_stdin.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../cmd/tcltk --module-path ../cmd --bind-host zx_surface --bind-host taijios_args --bind-host taijios_io --bind-host taijios_files --bind-host taijios_stdin --entry ebook:main -o $target ebook.zi

$DISBIN/ebook.zx: ebook.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 ebook.zx "$staged" && mv "$staged" "$target"

install:V:	$DISBIN/ebook.zx
%.install:V:	$DISBIN/%
%.installall:V:	$DISBIN/%
