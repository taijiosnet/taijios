// MIME image type dispatch and image dimension/pixel decoding,
// ported from appl/ebook/mimeimage.b.
#import "std/vec"
#import "std/image"
JPEG :: #import "std/jpeg";

ImageInfo :: struct {
    width: s32;
    height: s32;
    rgba: Vec(u8);
}

LowerByte :: (c: u8) -> u8 {
    return ifx c >= 65 && c <= 90 then c + 32 else c;
}

// Infer media type from filename extension when mediatype is empty.
InferMediaType :: (mediatype: string, file: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    if mediatype.count > 0 {
        for c: mediatype { unused VecPush(out.bytes, LowerByte(c)) }
        return;
    }
    dot: s64 = -1;
    for i: 0..file.count-1 {
        if file[i] == 46 { dot = i }
    }
    if dot >= 0 && dot + 1 < file.count {
        for i: dot + 1..file.count-1 {
            unused VecPush(out.bytes, LowerByte(file[i]));
        }
    }
}

IsSupportedType :: (mt: string) -> bool {
    return mt == "bit" || mt == "gif" || mt == "jpeg" || mt == "jpg" ||
           mt == "xbm" || mt == "pic" || mt == "png";
}

ParseIntField :: (s: string) -> (val: s32, ok: bool) {
    i: s64 = 0;
    while i < s.count && (s[i] == 32 || s[i] == 9) { i += 1 }
    if i >= s.count { return 0, false }
    neg := false;
    if s[i] == 45 { neg = true; i += 1 }
    if i >= s.count || s[i] < 48 || s[i] > 57 { return 0, false }
    v: s64 = 0;
    while i < s.count && s[i] >= 48 && s[i] <= 57 {
        v = v * 10 + cast(s64)(s[i] - 48);
        i += 1;
    }
    return cast(s32)(ifx neg then -v else v), true;
}

ReadBE32 :: (data: []u8, off: s64) -> s32 {
    if off + 4 > data.count { return 0 }
    return (cast(s32)data[off] << 24) | (cast(s32)data[off + 1] << 16) |
           (cast(s32)data[off + 2] << 8) | cast(s32)data[off + 3];
}

ReadLE16 :: (data: []u8, off: s64) -> s32 {
    if off + 2 > data.count { return 0 }
    return cast(s32)data[off] | (cast(s32)data[off + 1] << 8);
}

// Parse Inferno .bit header dimensions (and RGB24 pixels if uncompressed).
DecodeBit :: (data: []u8, out: *ImageInfo) -> bool {
    if data.count < 60 { return false }
    start: s64 = 0;
    if data.count >= 11 && TextView(data[:11]) == "compressed\n" {
        start = 11;
    }
    if start + 60 > data.count { return false }
    minx, ok0 := ParseIntField(TextView(data[start + 12:start + 24]));
    miny, ok1 := ParseIntField(TextView(data[start + 24:start + 36]));
    maxx, ok2 := ParseIntField(TextView(data[start + 36:start + 48]));
    maxy, ok3 := ParseIntField(TextView(data[start + 48:start + 60]));
    if !ok0 || !ok1 || !ok2 || !ok3 { return false }
    w := maxx - minx;
    h := maxy - miny;
    if w <= 0 || h <= 0 || w > 8192 || h > 8192 { return false }
    out.width = w;
    out.height = h;
    if start == 0 {
        need := cast(s64)w * cast(s64)h * 3;
        if data.count >= 60 + need {
            unused VecResize(out.rgba, 0);
            for i: 0..cast(s64)w * cast(s64)h - 1 {
                off := 60 + i * 3;
                unused VecPush(out.rgba, data[off]);
                unused VecPush(out.rgba, data[off + 1]);
                unused VecPush(out.rgba, data[off + 2]);
                unused VecPush(out.rgba, 255);
            }
        }
    }
    return true;
}

// Decode image dimensions (and RGBA pixels where supported) by MIME type or extension.
DecodeImage :: (mediatype: string, file: string, data: []u8, out: *ImageInfo) -> (ok: bool, err: string) {
    out.width = 0;
    out.height = 0;
    unused VecResize(out.rgba, 0);

    mt_text: Text;
    InferMediaType(mediatype, file, *mt_text);
    mt := TextView(mt_text);
    if !IsSupportedType(mt) {
        return false, "unrecognised image type";
    }
    if mt == "bit" {
        if !DecodeBit(data, out) { return false, "invalid bit image" }
        return true, "";
    }
    if mt == "jpg" || mt == "jpeg" {
        img := JPEG.ReadJPEG(data);
        if !ImageValid(*img) { return false, "invalid jpeg image" }
        out.width = cast(s32)img.width;
        out.height = cast(s32)img.height;
        pix := VecSlice(img.pixels, 0, img.pixels.count);
        unused BuilderAppend(out.rgba, TextView(pix));
        return true, "";
    }
    if mt == "png" {
        if data.count < 24 || data[0] != 137 || data[1] != 80 || data[2] != 78 || data[3] != 71 {
            return false, "invalid png image";
        }
        w := ReadBE32(data, 16);
        h := ReadBE32(data, 20);
        if w <= 0 || h <= 0 { return false, "invalid png dimensions" }
        out.width = w;
        out.height = h;
        return true, "";
    }
    if mt == "gif" {
        if data.count < 10 || (TextView(data[:6]) != "GIF87a" && TextView(data[:6]) != "GIF89a") {
            return false, "invalid gif image";
        }
        w := ReadLE16(data, 6);
        h := ReadLE16(data, 8);
        if w <= 0 || h <= 0 { return false, "invalid gif dimensions" }
        out.width = w;
        out.height = h;
        return true, "";
    }
    if mt == "xbm" {
        // Parse #define <name>_width W and #define <name>_height H
        text := TextView(data);
        w: s32 = 0;
        h: s32 = 0;
        i: s64 = 0;
        while i < text.count {
            if i + 6 <= text.count && text[i:i + 6] == "_width" {
                v, ok := ParseIntField(text[i + 6:]);
                if ok { w = v }
            } else if i + 7 <= text.count && text[i:i + 7] == "_height" {
                v, ok := ParseIntField(text[i + 7:]);
                if ok { h = v }
            }
            i += 1;
        }
        if w <= 0 || h <= 0 { return false, "invalid xbm image" }
        out.width = w;
        out.height = h;
        return true, "";
    }
    // Plan 9 pic header: WINDOW=x0 y0 x1 y1
    if mt == "pic" {
        text := TextView(data);
        for i: 0..text.count-1 {
            if i + 7 <= text.count && text[i:i + 7] == "WINDOW=" {
                rest := text[i + 7:];
                // Parse 4 integers
                vals: [4]s32;
                vc: s32 = 0;
                p: s64 = 0;
                while p < rest.count && vc < 4 && rest[p] != 10 {
                    while p < rest.count && rest[p] == 32 { p += 1 }
                    s0 := p;
                    while p < rest.count && rest[p] != 32 && rest[p] != 10 { p += 1 }
                    v, ok := ParseIntField(rest[s0:p]);
                    if ok { vals[vc] = v; vc += 1 }
                }
                if vc == 4 && vals[2] > vals[0] && vals[3] > vals[1] {
                    out.width = vals[2] - vals[0];
                    out.height = vals[3] - vals[1];
                    return true, "";
                }
            }
        }
        return false, "invalid pic image";
    }
    return false, "unrecognised image type";
}
