// OEB 1.0.1 package (.opf) and standalone document descriptor,
// ported from appl/ebook/oebpackage.b.
#import "std/vec"

MAX_ITEMS :: 64;
MAX_GUIDE :: 32;

Item :: struct {
    id: Text;
    href: Text;
    media_type: Text;
    file: Text;
}

Reference :: struct {
    kind: Text;
    title: Text;
    href: Text;
}

Package :: struct {
    file: Text;
    title: Text;
    manifest: [MAX_ITEMS]Item;
    manifest_count: s32;
    spine: [MAX_ITEMS]s32; // indices into manifest
    spine_count: s32;
    guide: [MAX_GUIDE]Reference;
    guide_count: s32;
}

BaseDir :: (path: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    last_slash: s64 = -1;
    for i: 0..path.count-1 {
        if path[i] == 47 { last_slash = i }
    }
    if last_slash >= 0 {
        unused BuilderAppend(out.bytes, path[:last_slash + 1]);
    }
}

ResolveHref :: (base_file: string, href: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    if href.count > 0 && href[0] == 47 {
        unused BuilderAppend(out.bytes, href);
        return;
    }
    dir: Text;
    BaseDir(base_file, *dir);
    unused BuilderAppend(out.bytes, TextView(dir));
    unused BuilderAppend(out.bytes, href);
}

FindAttr :: (tag: string, name: string, out: *Text) -> bool {
    unused VecResize(out.bytes, 0);
    i: s64 = 0;
    while i < tag.count {
        while i < tag.count && (tag[i] == 32 || tag[i] == 9 || tag[i] == 10 || tag[i] == 13) { i += 1 }
        start := i;
        while i < tag.count && tag[i] != 61 && tag[i] != 32 && tag[i] != 9 && tag[i] != 10 && tag[i] != 13 && tag[i] != 62 && tag[i] != 47 { i += 1 }
        key := tag[start:i];
        while i < tag.count && (tag[i] == 32 || tag[i] == 9) { i += 1 }
        if i >= tag.count || tag[i] != 61 {
            while i < tag.count && tag[i] != 32 && tag[i] != 9 && tag[i] != 10 && tag[i] != 13 { i += 1 }
            continue;
        }
        i += 1; // skip '='
        while i < tag.count && (tag[i] == 32 || tag[i] == 9) { i += 1 }
        if i >= tag.count { break }
        quote: u8 = 0;
        if tag[i] == 34 || tag[i] == 39 { quote = tag[i]; i += 1 }
        val_start := i;
        if quote != 0 {
            while i < tag.count && tag[i] != quote { i += 1 }
        } else {
            while i < tag.count && tag[i] != 32 && tag[i] != 9 && tag[i] != 10 && tag[i] != 13 && tag[i] != 62 { i += 1 }
        }
        val := tag[val_start:i];
        if quote != 0 && i < tag.count { i += 1 }
        if key == name {
            unused BuilderAppend(out.bytes, val);
            return true;
        }
    }
    return false;
}

IsPackageContent :: (data: string) -> bool {
    // Check for <package tag in content.
    needle := "<package";
    if data.count < needle.count { return false }
    for i: 0..data.count - needle.count {
        if data[i:i + needle.count] == needle { return true }
    }
    return false;
}

FindManifestById :: (pkg: *Package, id: string) -> s32 {
    for i: 0..cast(s64)pkg.manifest_count-1 {
        if TextView(pkg.manifest[i].id) == id { return cast(s32)i }
    }
    return -1;
}

ParsePackage :: (file_path: string, data: string, pkg: *Package) {
    unused VecResize(pkg.file.bytes, 0);
    unused BuilderAppend(pkg.file.bytes, file_path);
    unused VecResize(pkg.title.bytes, 0);
    pkg.manifest_count = 0;
    pkg.spine_count = 0;
    pkg.guide_count = 0;

    if !IsPackageContent(data) {
        // Standalone OEB/HTML/XML document wrapped as a single-item package.
        pkg.manifest_count = 1;
        unused VecResize(pkg.manifest[0].id.bytes, 0);
        unused BuilderAppend(pkg.manifest[0].id.bytes, "doc");
        unused VecResize(pkg.manifest[0].href.bytes, 0);
        unused BuilderAppend(pkg.manifest[0].href.bytes, file_path);
        unused VecResize(pkg.manifest[0].media_type.bytes, 0);
        unused BuilderAppend(pkg.manifest[0].media_type.bytes, "text/x-oeb1-document");
        unused VecResize(pkg.manifest[0].file.bytes, 0);
        unused BuilderAppend(pkg.manifest[0].file.bytes, file_path);
        pkg.spine[0] = 0;
        pkg.spine_count = 1;
        return;
    }

    i: s64 = 0;
    while i < data.count {
        if data[i] != 60 { i += 1; continue }
        start := i + 1;
        end := start;
        while end < data.count && data[end] != 62 { end += 1 }
        if end >= data.count { break }
        tag := data[start:end];
        i = end + 1;

        // Extract tag name.
        ns: s64 = 0;
        while ns < tag.count && (tag[ns] == 32 || tag[ns] == 9) { ns += 1 }
        ne := ns;
        while ne < tag.count && tag[ne] != 32 && tag[ne] != 9 && tag[ne] != 10 && tag[ne] != 13 && tag[ne] != 47 { ne += 1 }
        name := tag[ns:ne];
        attrs := tag[ne:];

        if (name == "dc:Title" || name == "dc:title" || name == "title") && pkg.title.bytes.count == 0 {
            close_pos := i;
            while close_pos < data.count && data[close_pos] != 60 { close_pos += 1 }
            unused BuilderAppend(pkg.title.bytes, data[i:close_pos]);
        } else if name == "item" && pkg.manifest_count < MAX_ITEMS {
            idx := pkg.manifest_count;
            unused FindAttr(attrs, "id", *pkg.manifest[idx].id);
            unused FindAttr(attrs, "href", *pkg.manifest[idx].href);
            unused FindAttr(attrs, "media-type", *pkg.manifest[idx].media_type);
            ResolveHref(file_path, TextView(pkg.manifest[idx].href), *pkg.manifest[idx].file);
            pkg.manifest_count += 1;
        } else if name == "itemref" && pkg.spine_count < MAX_ITEMS {
            idref: Text;
            if FindAttr(attrs, "idref", *idref) {
                found := FindManifestById(pkg, TextView(idref));
                if found >= 0 {
                    pkg.spine[pkg.spine_count] = found;
                    pkg.spine_count += 1;
                }
            }
        } else if name == "reference" && pkg.guide_count < MAX_GUIDE {
            g := pkg.guide_count;
            unused FindAttr(attrs, "type", *pkg.guide[g].kind);
            unused FindAttr(attrs, "title", *pkg.guide[g].title);
            unused FindAttr(attrs, "href", *pkg.guide[g].href);
            pkg.guide_count += 1;
        }
    }

    if pkg.spine_count == 0 && pkg.manifest_count > 0 {
        for m: 0..cast(s64)pkg.manifest_count-1 {
            pkg.spine[pkg.spine_count] = cast(s32)m;
            pkg.spine_count += 1;
        }
    }
}
