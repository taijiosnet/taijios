// CSS length unit parsing, n2s formatting, and pixel conversion,
// ported from appl/ebook/units.b.
#import "std/vec"
#import "std/number_text"

DPI :: 100;
SCALE :: 1000;

UnitKind :: enum {
    Invalid;
    Em;
    Ex;
    Px;
    In;
    Cm;
    Mm;
    Pt;
    Pc;
    Percent;
    None;
}

IsRelative :: (s: string) -> bool {
    n := s.count;
    if n < 2 { return false }
    if s[n - 1] == 37 { return true } // '%'
    tail := s[n - 2:];
    return tail == "em" || tail == "ex";
}

// Format a SCALE-fixed-point integer as decimal string (matching units.b n2s).
N2S :: (n: s64, out: *Text) {
    unused VecResize(out.bytes, 0);
    i := n / SCALE;
    f := n % SCALE;
    buf: [24]u8;
    if i == 0 && f < 0 {
        unused VecPush(out.bytes, 45); // '-'
    }
    unused BuilderAppend(out.bytes, FormatInteger(i, buf[:]));
    if f == 0 { return }
    if f < 0 { f = -f }
    unused VecPush(out.bytes, 46); // '.'
    if f < 100 { unused VecPush(out.bytes, 48) }
    if f < 10 { unused VecPush(out.bytes, 48) }
    unused BuilderAppend(out.bytes, FormatInteger(f, buf[:]));
}

ParseUnits :: (s: string) -> (scaled: s64, kind: UnitKind) {
    if s.count == 0 { return 0, .Invalid }
    i: s64 = 0;
    neg := false;
    if s[0] == 45 || s[0] == 43 {
        neg = s[0] == 45;
        i = 1;
    }
    n: s64 = 0;
    while i < s.count && s[i] >= 48 && s[i] <= 57 {
        n = n * 10 + cast(s64)(s[i] - 48);
        i += 1;
    }
    n *= SCALE;
    if i < s.count && s[i] == 46 {
        i += 1;
        mul: s64 = 100;
        while i < s.count && s[i] >= 48 && s[i] <= 57 {
            n += cast(s64)(s[i] - 48) * mul;
            mul /= 10;
            i += 1;
        }
    }
    kind: UnitKind = .None;
    if i < s.count {
        unit := s[i:];
        if unit == "em" { kind = .Em }
        else if unit == "ex" { kind = .Ex }
        else if unit == "px" { kind = .Px }
        else if unit == "in" { kind = .In }
        else if unit == "cm" { kind = .Cm }
        else if unit == "mm" { kind = .Mm }
        else if unit == "pt" { kind = .Pt }
        else if unit == "pc" { kind = .Pc }
        else if unit == "%" { kind = .Percent }
        else { return 0, .Invalid }
    }
    if neg { n = -n }
    return n, kind;
}

LengthPx :: (s: string, emsize: s64, xsize: s64, relative_px: s64) -> (px: s64, ok: bool) {
    n, kind := ParseUnits(s);
    if kind == .Invalid { return 0, false }
    if kind == .Em { return (n * emsize) / SCALE, true }
    if kind == .Ex { return (n * xsize) / SCALE, true }
    if kind == .Px { return n / SCALE, true }
    if kind == .In { return (n * DPI) / SCALE, true }
    if kind == .Cm { return (n * DPI * 100) / (2540 * SCALE), true }
    if kind == .Mm { return (n * DPI * 10) / (254 * SCALE), true }
    if kind == .Pt { return (n * DPI) / (72 * SCALE), true }
    if kind == .Pc { return (n * DPI * 12) / (72 * SCALE), true }
    if kind == .Percent { return ((n * relative_px) / SCALE) / 100, true }
    if kind == .None { return (n * relative_px) / SCALE, true }
    return 0, false;
}

// Return length in pixels and absolute-unit string equivalent (matching units.b length()).
Length :: (s: string, emsize: s64, xsize: s64, relative: string, abs_out: *Text) -> (px: s64, ok: bool) {
    unused VecResize(abs_out.bytes, 0);
    n, kind := ParseUnits(s);
    if kind == .Invalid { return 0, false }
    if kind == .Em {
        px := n * emsize;
        N2S(px, abs_out);
        unused BuilderAppend(abs_out.bytes, "px");
        return px / SCALE, true;
    }
    if kind == .Ex {
        px := n * xsize;
        N2S(px, abs_out);
        unused BuilderAppend(abs_out.bytes, "px");
        return px / SCALE, true;
    }
    if kind == .Percent || kind == .None {
        if relative.count == 0 { return 0, false }
        rn, rok := LengthPx(relative, 0, 0, 0);
        if !rok { return 0, false }
        px := (n * rn) / SCALE;
        if kind == .Percent { px /= 100 }
        buf: [24]u8;
        unused BuilderAppend(abs_out.bytes, FormatInteger(px, buf[:]));
        unused BuilderAppend(abs_out.bytes, "px");
        return px, true;
    }
    px, ok := LengthPx(s, emsize, xsize, 0);
    unused BuilderAppend(abs_out.bytes, s);
    return px, ok;
}
