TASKMGR_ZX=
install-taskmgr-zx:V:
	if ! test -s "$TASKMGR_ZX"; then echo 'Set TASKMGR_ZX to the canonical Task Manager guest bundle' >&2; exit 1; fi
	staged=$(mktemp "$DISBIN/taskmgr.zx.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 "$TASKMGR_ZX" "$staged" && mv "$staged" "$DISBIN/taskmgr.zx"

EXPLORER_ZX=
install-explorer-zx:V:
	if ! test -s "$EXPLORER_ZX"; then echo 'Set EXPLORER_ZX to the canonical Explorer guest bundle' >&2; exit 1; fi
	staged=$(mktemp "$DISBIN/explorer.zx.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0644 "$EXPLORER_ZX" "$staged" && mv "$staged" "$DISBIN/explorer.zx"

RILL_ZX=
RILL_ICON_ATLAS=
RILL_SWEET_THEME=
RILL_THEME=$ROOT/lib/rill/themes/Sweet-Dark
RILL_ICONS=$ROOT/lib/rill/icons
install-rill-zx:V:
	if ! test -s "$RILL_ZX"; then echo 'Set RILL_ZX to the canonical Rill guest bundle' >&2; exit 1; fi
	if ! test -s "$RILL_ICON_ATLAS" || test "$(wc -c < "$RILL_ICON_ATLAS")" -ne 1048576; then
		echo 'Set RILL_ICON_ATLAS to the canonical 512×512 RGBA Rill atlas' >&2; exit 1
	fi
	if ! test -s "$RILL_SWEET_THEME/chrome.rgba" || test "$(wc -c < "$RILL_SWEET_THEME/chrome.rgba")" -ne 28224; then
		echo 'Set RILL_SWEET_THEME to the canonical Sweet-Dark resource directory' >&2; exit 1
	fi
	if ! test -s "$RILL_SWEET_THEME/LICENSE" || ! test -s "$RILL_SWEET_THEME/themerc"; then exit 1; fi
	python3 "$ROOT/tools/generate-app-catalog.py" --guest-assets &&
	mkdir -p "$RILL_ICONS" "$RILL_THEME" &&
	staged=$(mktemp "$DISBIN/rill.zx.XXXXXX") &&
	trap 'rm -f "$staged" "$atlas" "$chrome"' EXIT &&
	atlas=$(mktemp "$RILL_ICONS/ui.rgba.XXXXXX") &&
	chrome=$(mktemp "$RILL_THEME/chrome.rgba.XXXXXX") &&
	install -m 0644 "$RILL_SWEET_THEME/chrome.rgba" "$chrome" &&
	install -m 0644 "$RILL_SWEET_THEME/LICENSE" "$RILL_THEME/LICENSE" &&
	install -m 0644 "$RILL_SWEET_THEME/themerc" "$RILL_THEME/themerc" &&
	install -m 0644 "$RILL_ICON_ATLAS" "$atlas" &&
	install -m 0644 "$RILL_ZX" "$staged" &&
	mv "$chrome" "$RILL_THEME/chrome.rgba" &&
	mv "$atlas" "$RILL_ICONS/ui.rgba" && mv "$staged" "$DISBIN/rill.zx"

