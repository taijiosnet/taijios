// The rules of Inferno's Reversi (appl/wm/reversi.b): an 8 by 8 board with a
// 1-square border, 8-direction disc flipping, ring-weight and corner-line
// evaluation, and resumable minimax with alpha-beta and reservoir tie-breaking.
// See ../../NOTICE.
Rand :: #import "inferno_rand";

SZB :: 8
SZF :: SZB + 2
MC1 :: SZB / 2
MC2 :: MC1 + 1
PIECES :: SZB * SZB
SQUARES :: PIECES - 4
MAXMOVES :: 3 * PIECES / 2
NOMOVE :: SZF * SZF - 1

Black :: 0
White :: 1
Empty :: 2
Border :: 3

Machine :: 0
Human :: 1

SKILLB :: 6
SKILLW :: 0
MAXPLIES :: 6
Infinity :: 1073741824
MaxSearchDepth :: 20

Coord :: struct {
    m: s32
    n: s32
}

Game :: struct {
    brd: [SZF * SZF]s32
    val: [SZF * SZF]s32
    order: [SQUARES]Coord
    pieces: [2]s32
    value: [2]s32
    kind: [2]s32
    skill: [2]s32
    fullsrch: bool
}

Cell :: (m: s32, n: s32) -> s32 { return m * SZF + n }

Pow :: (base: s32, exp: s32) -> s32 {
    p: s32 = 1
    e := exp
    while e > 0 {
        p *= base
        e -= 1
    }
    return p
}

// initboard + ordrect from reversi.b: ring weights and non-center square order
// sorted ascending by val so FindMoves (which reverses like list cons) tries
// the highest-valued squares first.
Init :: (game: *Game) {
    for idx: 0..SZF * SZF - 1 { game.val[idx] = 0 }
    s := -Pow(-1, SZB / 2)
    for i: 1..SZB {
        for j: 1..SZB {
            k: s32 = SZB / 2
            while k > 0 {
                if cast(s32)i == k || cast(s32)i == SZB + 1 - k ||
                   cast(s32)j == k || cast(s32)j == SZB + 1 - k {
                    game.val[Cell(cast(s32)i, cast(s32)j)] = s * Pow(-7, SZB / 2 - k)
                    break
                }
                k -= 1
            }
        }
    }
    n: s32 = 0
    for i: 1..SZB {
        for j: 1..SZB {
            if i < SZB / 2 || j < SZB / 2 || i > SZB / 2 + 1 || j > SZB / 2 + 1 {
                game.order[n] = .{cast(s32)i, cast(s32)j}
                n += 1
            }
        }
    }
    for k: 0..SQUARES - 2 {
        for l: k + 1..SQUARES - 1 {
            a := game.order[k]
            b := game.order[l]
            if game.val[Cell(a.m, a.n)] > game.val[Cell(b.m, b.n)] {
                game.order[k] = b
                game.order[l] = a
            }
        }
    }
    game.kind[Black] = Machine
    game.kind[White] = Human
    game.skill[Black] = SKILLB
    game.skill[White] = SKILLW
    game.fullsrch = false
}

// initbrd from reversi.b: bordered empty board with the 4 center discs.
Reset :: (game: *Game) {
    for i: 0..SZF - 1 {
        for j: 0..SZF - 1 {
            game.brd[Cell(cast(s32)i, cast(s32)j)] = Empty
        }
    }
    for i: 0..SZF - 1 {
        game.brd[Cell(cast(s32)i, 0)] = Border
        game.brd[Cell(cast(s32)i, SZF - 1)] = Border
        game.brd[Cell(0, cast(s32)i)] = Border
        game.brd[Cell(SZF - 1, cast(s32)i)] = Border
    }
    game.brd[Cell(MC1, MC1)] = Black
    game.brd[Cell(MC2, MC2)] = Black
    game.brd[Cell(MC1, MC2)] = White
    game.brd[Cell(MC2, MC1)] = White
    game.pieces[Black] = 2
    game.pieces[White] = 2
    game.value[Black] = -2
    game.value[White] = -2
}

FlipList :: struct {
    count: s32
    coords: [24]Coord
}

// dirmove from reversi.b: check or apply flips along (dx, dy).
DirMove :: (game: *Game, m_in: s32, n_in: s32, dx: s32, dy: s32,
            me: s32, you: s32, apply: bool, flips: *FlipList) -> bool {
    p: s32 = 0
    m := m_in + dx
    n := n_in + dy
    while game.brd[Cell(m, n)] == you {
        m += dx
        n += dy
        p += 1
    }
    if p > 0 && game.brd[Cell(m, n)] == me {
        if apply {
            game.pieces[me] += p
            game.pieces[you] -= p
            m -= p * dx
            n -= p * dy
            while p > 0 {
                p -= 1
                idx := Cell(m, n)
                game.brd[idx] = me
                game.value[me] += game.val[idx]
                game.value[you] -= game.val[idx]
                if flips != null && flips.count < 24 {
                    flips.coords[flips.count] = .{m, n}
                    flips.count += 1
                }
                m += dx
                n += dy
            }
        }
        return true
    }
    return false
}

// IsValid: check whether (m, n) is a legal move for me without modifying state.
IsValid :: (game: *Game, m: s32, n: s32, me: s32, you: s32) -> bool {
    if m < 1 || m > SZB || n < 1 || n > SZB { return false }
    if game.brd[Cell(m, n)] != Empty { return false }
    for dx: -1..1 {
        for dy: -1..1 {
            if dx == 0 && dy == 0 { continue }
            if DirMove(game, m, n, cast(s32)dx, cast(s32)dy, me, you, false, null) {
                return true
            }
        }
    }
    return false
}

// MakeMove: apply a legal move and record flipped squares for UndoMove.
MakeMove :: (game: *Game, m: s32, n: s32, me: s32, you: s32, flips: *FlipList) -> bool {
    if flips != null { flips.count = 0 }
    if m < 1 || m > SZB || n < 1 || n > SZB { return false }
    if game.brd[Cell(m, n)] != Empty { return false }
    idx := Cell(m, n)
    game.pieces[me] += 1
    game.value[me] += game.val[idx]
    game.brd[idx] = me
    valid := false
    for dx: -1..1 {
        for dy: -1..1 {
            if dx == 0 && dy == 0 { continue }
            if DirMove(game, m, n, cast(s32)dx, cast(s32)dy, me, you, true, flips) {
                valid = true
            }
        }
    }
    if !valid {
        game.pieces[me] -= 1
        game.value[me] -= game.val[idx]
        game.brd[idx] = Empty
    }
    return valid
}

// UndoMove: exact inverse of MakeMove using the recorded FlipList.
UndoMove :: (game: *Game, m: s32, n: s32, me: s32, you: s32, flips: *FlipList) {
    idx := Cell(m, n)
    game.brd[idx] = Empty
    game.pieces[me] -= 1
    game.value[me] -= game.val[idx]
    for i: 0..flips.count - 1 {
        c := flips.coords[i]
        ci := Cell(c.m, c.n)
        game.brd[ci] = you
        game.pieces[me] -= 1
        game.pieces[you] += 1
        game.value[me] -= game.val[ci]
        game.value[you] += game.val[ci]
    }
}

// FindMoves: legal moves in reverse order[] (matching reversi.b's list cons).
FindMoves :: (game: *Game, me: s32, you: s32, out: []Coord) -> s32 {
    count: s32 = 0
    k: s32 = SQUARES - 1
    while k >= 0 {
        c := game.order[k]
        if game.brd[Cell(c.m, c.n)] == Empty && IsValid(game, c.m, c.n, me, you) {
            out[count] = c
            count += 1
        }
        k -= 1
    }
    return count
}

Line0 :: (game: *Game, m_in: s32, n_in: s32, dx: s32, dy: s32, me: s32, you: s32) -> s32 {
    v: s32 = 0
    m := m_in
    n := n_in
    p := game.brd[Cell(m, n)]
    corner_val := game.val[Cell(1, 1)]
    while game.brd[Cell(m, n)] == p {
        v += corner_val
        m += dx
        n += dy
    }
    if p == you { return -v }
    return v
}

CornerLine :: (game: *Game, m: s32, n: s32, me: s32, you: s32) -> s32 {
    if game.brd[Cell(m, n)] == Empty { return 0 }
    dx: s32 = ifx m == 1 then 1 else -1
    dy: s32 = ifx n == 1 then 1 else -1
    return Line0(game, m, n, 0, dy, me, you) +
           Line0(game, m, n, dx, 0, me, you) +
           Line0(game, m, n, dx, dy, me, you)
}

// eval from reversi.b.
Eval :: (game: *Game, me: s32, you: s32) -> s32 {
    d := game.pieces[me] - game.pieces[you]
    if game.fullsrch { return d }
    n := game.pieces[me] + game.pieces[you]
    v := CornerLine(game, 1, 1, me, you) +
         CornerLine(game, 1, SZB, me, you) +
         CornerLine(game, SZB, 1, me, you) +
         CornerLine(game, SZB, SZB, me, you)
    return (PIECES - n) * (game.value[me] - game.value[you] + v) + n * d
}

SearchResult :: struct {
    value: s32
    m: s32
    n: s32
}

SearchFrame :: struct {
    me: s32
    you: s32
    plies: s32
    alphabeta: s32
    mv: s32
    moves: [32]Coord
    move_count: s32
    at: s32
    best: SearchResult
    equal: s32
    waiting_child: bool
    passed_child: bool
    cut: bool
    move_m: s32
    move_n: s32
    flips: FlipList
    child_value: s32
}

SearchState :: struct {
    active: bool
    has_moves: bool
    depth: s32
    plies_used: s32
    goes: s32
    frames: [MaxSearchDepth]SearchFrame
    result: SearchResult
    visits: s32
    leaves: s32
}

SearchPlies :: (game: *Game, me: s32) -> s32 {
    plies := game.skill[me]
    left := PIECES - (game.pieces[Black] + game.pieces[White])
    if left < plies {
        plies = left
    } else if left < 2 * plies {
        plies = left
    } else {
        k := left / plies
        if k < 3 { plies = ((k + 2) * plies) / (k + 1) }
    }
    if plies >= MaxSearchDepth - 2 { plies = MaxSearchDepth - 2 }
    return plies
}

InitFrame :: (game: *Game, f: *SearchFrame, me: s32, you: s32, plies: s32, alphabeta: s32, mv: s32) {
    f.me = me
    f.you = you
    f.plies = plies
    f.alphabeta = alphabeta
    f.mv = mv
    f.move_count = ifx plies > 0 then FindMoves(game, me, you, f.moves[:]) else 0
    f.at = 0
    f.best = .{-Infinity, 0, 0}
    f.equal = 0
    f.waiting_child = false
    f.passed_child = false
    f.cut = false
    f.move_m = 0
    f.move_n = 0
    f.flips.count = 0
    f.child_value = 0
}

SearchBegin :: (game: *Game, state: *SearchState, me: s32, you: s32, random: *Rand.Random) {
    state.visits = 0
    state.leaves = 0
    state.depth = 0
    root_moves: [32]Coord
    count := FindMoves(game, me, you, root_moves[:])
    state.goes = count
    if count == 0 {
        state.has_moves = false
        state.result = .{0, 0, 0}
        state.active = false
        return
    }
    state.has_moves = true
    if game.skill[me] == 0 {
        pick := Rand.Next(random, count)
        state.plies_used = 0
        state.result = .{0, root_moves[pick].m, root_moves[pick].n}
        state.active = false
        return
    }
    plies := SearchPlies(game, me)
    left := PIECES - (game.pieces[Black] + game.pieces[White])
    game.fullsrch = plies == left
    state.plies_used = plies
    InitFrame(game, *state.frames[0], me, you, plies, Infinity, 1)
    state.active = true
}

SearchDeliver :: (state: *SearchState, value: s32) {
    if state.depth == 0 {
        state.result = state.frames[0].best
        state.active = false
        return
    }
    state.depth -= 1
    parent := *state.frames[state.depth]
    parent.waiting_child = true
    parent.child_value = value
}

SearchImprove :: (frame: *SearchFrame, score: s32, random: *Rand.Random) {
    if score > frame.best.value {
        frame.equal = 1
    } else if score == frame.best.value {
        frame.equal += 1
        if Rand.Next(random, frame.equal) != 0 { return }
    } else {
        return
    }
    frame.best = .{score, frame.move_m, frame.move_n}
    if frame.best.value >= frame.alphabeta { frame.cut = true }
}

SearchSlice :: (game: *Game, state: *SearchState, random: *Rand.Random, budget_in: s32) -> bool {
    if !state.active { return true }
    budget := budget_in
    while budget > 0 {
        budget -= 1
        frame := *state.frames[state.depth]
        if frame.plies <= 0 {
            state.visits += 1
            state.leaves += 1
            SearchDeliver(state, Eval(game, frame.me, frame.you))
            continue
        }
        if frame.waiting_child {
            frame.waiting_child = false
            if frame.passed_child {
                frame.passed_child = false
                SearchDeliver(state, -frame.child_value)
                continue
            }
            UndoMove(game, frame.move_m, frame.move_n, frame.me, frame.you, *frame.flips)
            SearchImprove(frame, -frame.child_value, random)
            if frame.cut {
                frame.cut = false
                SearchDeliver(state, Infinity)
            } else {
                frame.at += 1
            }
            continue
        }
        if frame.move_count == 0 {
            // Pass turn: matches reversi.b lines 698-704.
            if state.depth + 1 >= MaxSearchDepth {
                SearchDeliver(state, Eval(game, frame.me, frame.you))
                continue
            }
            next_plies := ifx frame.mv != 0 then frame.plies else frame.plies - 1
            frame.waiting_child = true
            frame.passed_child = true
            state.depth += 1
            InitFrame(game, *state.frames[state.depth], frame.you, frame.me, next_plies, Infinity, 0)
            continue
        }
        if frame.at >= frame.move_count {
            SearchDeliver(state, frame.best.value)
            continue
        }
        move := frame.moves[frame.at]
        frame.move_m = move.m
        frame.move_n = move.n
        unused MakeMove(game, move.m, move.n, frame.me, frame.you, *frame.flips)
        frame.waiting_child = true
        frame.passed_child = false
        state.depth += 1
        InitFrame(game, *state.frames[state.depth], frame.you, frame.me, frame.plies - 1, -frame.best.value, 1)
    }
    return !state.active
}

SearchFinish :: (game: *Game, state: *SearchState, me: s32, you: s32) -> s32 {
    if !state.has_moves { return 0 }
    flips: FlipList
    unused MakeMove(game, state.result.m, state.result.n, me, you, *flips)
    return state.result.m * SZF + state.result.n
}

GenMove :: (game: *Game, me: s32, you: s32, random: *Rand.Random) -> s32 {
    state: SearchState
    SearchBegin(game, *state, me, you, random)
    while !SearchSlice(game, *state, random, 1024) { }
    return SearchFinish(game, *state, me, you)
}
