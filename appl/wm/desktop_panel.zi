Surface :: #import "kryon/host/surface";
Theme :: #import "kryon/theme";
Panel :: #import "taijios_panel";
#import "kryon/geometry"
#import "kryon/input_protocol"
#import "std/vec"

Capacity :: 192
DockHeight :: 32
RowHeight :: 25
MenuWidth :: 166
SubmenuWidth :: 188

Entry :: struct {
    kind: s32
    id: s32
    group: [Panel.LabelBytes]u8
    label: [Panel.LabelBytes]u8
}

entries: [Capacity]Entry;
primary_rows: [Capacity]s32;
secondary_rows: [Capacity]s32;
task_rows: [Capacity]s32;
primary_count: s32;
secondary_count: s32;
task_count: s32;
last_generation: s32 = -1;
opened: bool;
category: s32 = -1;
keyboard_column: s32;
selected_row: s32 = -1;
first_primary: s32;
first_secondary: s32;
popup_height: s32;
dragging_start: bool;
had_focus: bool;
pressed_entry: s32 = -1;
pressed_task: s32 = -1;

Label :: (bytes: []u8) -> string {
    length: s32 = 0
    while length < Panel.LabelBytes && bytes[length] != 0 { length += 1 }
    return TextView(bytes[:length])
}

SameGroup :: (a: s32, b: s32) -> bool {
    for i: 0 .. Panel.LabelBytes - 1 {
        value := entries[a].group[i]
        if value != entries[b].group[i] { return false }
        if value == 0 { return true }
    }
    return true
}

ReadEntries :: (count: s32) {
    primary_count = 0
    secondary_count = 0
    task_count = 0
    category = -1
    selected_row = -1
    keyboard_column = 0
    pressed_entry = -1
    pressed_task = -1
    first_primary = 0
    first_secondary = 0
    for i: 0 .. count - 1 {
        fields: [2]s32
        if Panel.Row(i, fields[:], entries[i].group[:], entries[i].label[:]) {
            entries[i].kind = fields[0]
            entries[i].id = fields[1]
        } else {
            entries[i].kind = 0
        }
    }
    i := count
    while i > 0 {
        i -= 1
        if entries[i].kind == Panel.WindowTask {
            task_rows[task_count] = i
            task_count += 1
        } else if entries[i].kind == Panel.MenuEntry {
            first := true
            if entries[i].group[0] != 0 {
                for earlier: 0 .. i - 1 {
                    if entries[earlier].kind == Panel.MenuEntry && SameGroup(i, earlier) {
                        first = false
                        break
                    }
                }
            }
            if first {
                primary_rows[primary_count] = i
                primary_count += 1
            }
        }
    }
}

OpenCategory :: (index: s32, count: s32) {
    category = index
    secondary_count = 0
    first_secondary = 0
    if index < 0 { return }
    i := count
    while i > 0 {
        i -= 1
        if entries[i].kind == Panel.MenuEntry && SameGroup(index, i) {
            secondary_rows[secondary_count] = i
            secondary_count += 1
        }
    }
}

CloseMenu :: () {
    if !opened { return }
    Panel.Popup(0, 0)
    opened = false
    category = -1
    secondary_count = 0
    keyboard_column = 0
    selected_row = -1
    first_primary = 0
    first_secondary = 0
    popup_height = 0
    dragging_start = false
}

Activate :: (index: s32, count: s32, submenu: bool) {
    if !submenu && entries[index].group[0] != 0 {
        OpenCategory(index, count)
    } else if entries[index].label[0] != 0 {
        CloseMenu()
        Panel.Choose(entries[index].kind, entries[index].id)
    }
}

HandleKeys :: (key: s32, count: s32, visible: s32) {
    if key == KeyEscape {
        CloseMenu()
        return
    }
    if key == KeyLeft && keyboard_column == 1 {
        keyboard_column = 0
        selected_row = first_primary
        for i: 0 .. primary_count - 1 {
            if primary_rows[i] == category { selected_row = i }
        }
        return
    }
    rows := primary_count
    if keyboard_column == 1 { rows = secondary_count }
    if rows == 0 { return }
    if key == KeyUp || key == KeyDown {
        if key == KeyUp {
            selected_row -= 1
            if selected_row < 0 { selected_row = rows - 1 }
        } else {
            selected_row += 1
            if selected_row >= rows { selected_row = 0 }
        }
        if keyboard_column == 0 {
            if selected_row < first_primary { first_primary = selected_row }
            if selected_row >= first_primary + visible { first_primary = selected_row - visible + 1 }
        } else {
            if selected_row < first_secondary { first_secondary = selected_row }
            if selected_row >= first_secondary + visible { first_secondary = selected_row - visible + 1 }
        }
    }
    if selected_row < 0 || selected_row >= rows { return }
    if keyboard_column == 0 && (key == KeyRight || key == KeyEnter) {
        index := primary_rows[selected_row]
        if key == KeyEnter || entries[index].group[0] != 0 {
            Activate(index, count, false)
            if opened && secondary_count > 0 {
                keyboard_column = 1
                selected_row = 0
            }
        }
    } else if keyboard_column == 1 && key == KeyEnter {
        Activate(secondary_rows[selected_row], count, true)
    }
}


RowBounds :: (row: s32, x: s32, width: s32) -> Rectangle {
    return .{cast(float32)(x + 2), cast(float32)(row * RowHeight + 1), cast(float32)(width - 4), 23.0}
}

TaskBounds :: (task: s32, width: s32, dock_top: s32) -> Rectangle {
    task_width := (width - 86) / task_count
    if task_width > 152 { task_width = 152 }
    return .{cast(float32)(82 + task * task_width), cast(float32)(dock_top + 3),
        cast(float32)(task_width - 3), 26.0}
}

Hit :: (event: Surface.SurfaceEvent, bounds: Rectangle) -> bool {
    return PointInBounds(cast(float32)event.x, cast(float32)event.y, bounds)
}

ColumnWidth :: (width: s32) -> s32 {
    if width < MenuWidth + SubmenuWidth { return width / 2 }
    return MenuWidth
}

Update :: (event: Surface.SurfaceEvent, width: s32, dock_top: s32, visible: s32, count: s32) {
    key: s32
    if event.kind == Surface.KeyDown { key = event.key }
    press := event.kind == Surface.ButtonDown && event.button == 1
    release := event.kind == Surface.ButtonUp && event.button == 1
    if press && Hit(event, .{4.0, cast(float32)(dock_top + 3), 74.0, 26.0}) {
        if opened {
            CloseMenu()
        } else if primary_count > 0 && visible > 0 {
            opened = true
            dragging_start = true
        }
        return
    }
    if !opened && key == KeyEnter && had_focus && primary_count > 0 && visible > 0 {
        opened = true
        return
    }
    for i: 0 .. task_count - 1 {
        if !Hit(event, TaskBounds(i, width, dock_top)) { continue }
        index := task_rows[i]
        if press { pressed_task = entries[index].id }
        if release && pressed_task == entries[index].id {
            CloseMenu()
            unused Panel.Choose(Panel.WindowTask, pressed_task)
        }
        break
    }
    if release { pressed_task = -1 }
    if !opened { return }
    if key != 0 {
        HandleKeys(key, count, visible)
        return
    }
    if dock_top <= 0 || (event.kind != Surface.PointerMoved && !press && !release) { return }

    menu_width: s32 = MenuWidth + SubmenuWidth
    if menu_width > width { menu_width = width }
    column := ColumnWidth(width)
    index: s32 = -1
    submenu := false
    if event.y >= 0 && event.y < dock_top {
        row := event.y / RowHeight
        if event.x >= 0 && event.x < column && first_primary + row < primary_count {
            index = primary_rows[first_primary + row]
        } else if event.x >= column && event.x < menu_width && first_secondary + row < secondary_count {
            index = secondary_rows[first_secondary + row]
            submenu = true
        }
    }
    if index >= 0 {
        if !submenu {
            if entries[index].group[0] != 0 && category != index { OpenCategory(index, count) }
            if entries[index].group[0] == 0 && category >= 0 { OpenCategory(-1, count) }
        }
        if press { pressed_entry = index }
        if release && (dragging_start || pressed_entry == index) { Activate(index, count, submenu) }
    } else if press && !Hit(event, .{0.0, cast(float32)dock_top, cast(float32)width, cast(float32)DockHeight}) {
        CloseMenu()
    }
    if release {
        dragging_start = false
        pressed_entry = -1
    }
}

DrawRect :: (bounds: Rectangle, rgba: u32, label: string = "") {
    unused Panel.Paint(cast(s32)bounds.x, cast(s32)bounds.y, cast(s32)bounds.width,
        cast(s32)bounds.height, cast(s32)rgba, label)
}

PaintButton :: (bounds: Rectangle, label: string, selected: bool, cascade: bool, palette: Theme.Palette) {
    fill := palette.surface
    ink := palette.foreground
    if selected {
        fill = Theme.StateLayer(palette.surface, palette.accent, 18)
        ink = palette.selection_text
    }
    DrawRect(bounds, fill)
    reserved: float32 = 18.0
    if cascade { reserved += 10.0 }
    DrawRect(.{bounds.x + 9.0, bounds.y, bounds.width - reserved, bounds.height}, ink, label)
    if cascade {
        DrawRect(.{bounds.x + bounds.width - 17.0, bounds.y, 9.0, bounds.height}, ink, ">")
    }
}

PaintMenuRow :: (index: s32, bounds: Rectangle, selected: bool, primary: bool, palette: Theme.Palette) {
    if primary && entries[index].group[0] != 0 {
        PaintButton(bounds, Label(entries[index].group[:]), selected, true, palette)
    } else if entries[index].label[0] != 0 {
        PaintButton(bounds, Label(entries[index].label[:]), selected, false, palette)
    } else {
        DrawRect(.{bounds.x + 8.0, bounds.y + 11.0, bounds.width - 16.0, 1.0}, palette.border)
    }
}

Paint :: (width: s32, height: s32) {
    palette := Theme.LightPalette()
    DrawRect(.{0.0, 0.0, cast(float32)width, cast(float32)height}, palette.surface_muted)
    dock_top := height - DockHeight
    PaintButton(.{4.0, cast(float32)(dock_top + 3), 74.0, 26.0}, "Start", opened, false, palette)
    for i: 0 .. task_count - 1 {
        index := task_rows[i]
        PaintButton(TaskBounds(i, width, dock_top), Label(entries[index].label[:]),
            pressed_task == entries[index].id, false, palette)
    }
    if !opened || dock_top <= 0 { return }
    column := ColumnWidth(width)
    menu_width: s32 = MenuWidth + SubmenuWidth
    if menu_width > width { menu_width = width }
    for i: first_primary .. primary_count - 1 {
        bounds := RowBounds(i - first_primary, 0, column)
        if bounds.y >= cast(float32)dock_top { break }
        index := primary_rows[i]
        PaintMenuRow(index, bounds, index == category || (keyboard_column == 0 && selected_row == i),
            true, palette)
    }
    for i: first_secondary .. secondary_count - 1 {
        bounds := RowBounds(i - first_secondary, column, menu_width - column)
        if bounds.y >= cast(float32)dock_top { break }
        PaintMenuRow(secondary_rows[i], bounds, keyboard_column == 1 && selected_row == i, false, palette)
    }
}

#program_export
main :: () -> s32 {
    width: s32 = 800
    height: s32 = DockHeight
    if !Surface.Open("Desktop panel", width, height) { return 1 }
    defer Surface.Close()
    event: Surface.SurfaceEvent = .{.kind = Surface.Redraw}
    while event.kind != Surface.Closed {
        if event.kind == Surface.Resized {
            if !Surface.SurfaceSizeValid(event.width, event.height) { return 1 }
            width = event.width
            height = event.height
        }
        if event.kind != Surface.Idle && (opened || event.kind != Surface.PointerMoved) {
            desktop: [4]s32
            desktop_width := Panel.Snapshot(desktop[:])
            count := desktop[1]
            if count > Capacity { count = Capacity }
            if desktop[0] != last_generation {
                ReadEntries(count)
                last_generation = desktop[0]
            }
            if desktop[2] == 0 && had_focus { CloseMenu() }
            had_focus = desktop[2] != 0
            visible := (desktop[3] - DockHeight) / RowHeight
            Update(event, width, height - DockHeight, visible, count)
            if opened {
                rows := primary_count
                if secondary_count > rows { rows = secondary_count }
                if rows > visible { rows = visible }
                menu_height := rows * RowHeight
                menu_width: s32 = MenuWidth + SubmenuWidth
                if menu_width > desktop_width { menu_width = desktop_width }
                if menu_height != popup_height || height == DockHeight {
                    if menu_height > 0 && Panel.Popup(menu_width, menu_height) {
                        popup_height = menu_height
                    } else {
                        CloseMenu()
                    }
                }
            }
            if height == DockHeight + popup_height {
                Paint(width, height)
                if !Panel.Flush() { return 1 }
            }
        }
        event = Surface.Event(1000)
    }
    return 0
}
