// Date, mark, schedule-record and Set-Time logic ported from Inferno's
// appl/wm/calendar.b. See ../../NOTICE.
#import "std/vec"
#import "std/number_text"

Oval :: 0;
Diamond :: 1;
Square :: 2;
NumShapes :: 3;
NumColors :: 4;

// Packed date is year*10000 + month*100 + day, with 0-based month (0..11),
// matching appl/wm/calendar.b's ymd2date/date2ymd.
DateYMD :: (date: s32) -> (year: s32, month: s32, day: s32) {
    return date / 10000, (date / 100) % 100, date % 100
}

YMDDate :: (year: s32, month: s32, day: s32) -> s32 {
    return day + month * 100 + year * 10000
}

DaySize :: (year: s32) -> s32 {
    if (year % 4) == 0 && (year % 100 != 0 || year % 400 == 0) { return 366 }
    return 365
}

DaysInMonth :: (month: s32, year: s32) -> s32 {
    if month < 0 || month > 11 { return 0 }
    table: [12]s32 = .[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    days := table[month]
    if month == 1 && DaySize(year) == 366 { days += 1 }
    return days
}

// Days since 1970-01-01 (Gregorian proleptic, valid for 1970..2037 and beyond).
DaysFromYMD :: (year: s32, month: s32, day: s32) -> s64 {
    y := cast(s64)year
    m := cast(s64)month + 1
    d := cast(s64)day
    if m <= 2 { y -= 1 }
    era := (ifx y >= 0 then y else y - 399) / 400
    yoe := y - era * 400
    mp := ifx m > 2 then m - 3 else m + 9
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

YMDFromDays :: (days: s64) -> (year: s32, month: s32, day: s32) {
    z := days + 719468
    era := (ifx z >= 0 then z else z - 146096) / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := ifx mp < 10 then mp + 3 else mp - 9
    if m <= 2 { y += 1 }
    return cast(s32)y, cast(s32)(m - 1), cast(s32)d
}

// Weekday: 0 = Sun, 1 = Mon, ..., 6 = Sat. 1970-01-01 was Thursday (4).
Weekday :: (year: s32, month: s32, day: s32) -> s32 {
    days := DaysFromYMD(year, month, day)
    w := (days + 4) % 7
    if w < 0 { w += 7 }
    return cast(s32)w
}

MonthInfo :: (month: s32, year: s32) -> (days: s32, first_wday: s32) {
    return DaysInMonth(month, year), Weekday(year, month, 1)
}

ValidDate :: (year: s32, month: s32, day: s32) -> bool {
    if year < 1970 || year > 2037 || month < 0 || month > 11 || day < 1 { return false }
    return day <= DaysInMonth(month, year)
}

ValidTime :: (hour: s32, minute: s32, second: s32) -> bool {
    return hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 && second >= 0 && second <= 59
}

EpochFromLocal :: (year: s32, month: s32, day: s32, hour: s32, minute: s32, second: s32) -> s64 {
    return DaysFromYMD(year, month, day) * 86400 + cast(s64)hour * 3600 + cast(s64)minute * 60 + cast(s64)second
}

AddDays :: (date: s32, delta: s32) -> s32 {
    year, month, day := DateYMD(date)
    ny, nm, nd := YMDFromDays(DaysFromYMD(year, month, day) + cast(s64)delta)
    if !ValidDate(ny, nm, nd) { return date }
    return YMDDate(ny, nm, nd)
}

IncMonth :: (date: s32) -> s32 {
    year, month, day := DateYMD(date)
    if month < 11 {
        month += 1
    } else if year < 2037 {
        year += 1
        month = 0
    }
    max_day := DaysInMonth(month, year)
    if day > max_day { day = max_day }
    return YMDDate(year, month, day)
}

DecMonth :: (date: s32) -> s32 {
    year, month, day := DateYMD(date)
    if month > 0 {
        month -= 1
    } else if year > 1970 {
        year -= 1
        month = 11
    }
    max_day := DaysInMonth(month, year)
    if day > max_day { day = max_day }
    return YMDDate(year, month, day)
}

KindToShapeCol :: (kind: s32) -> (shape: s32, col: s32) {
    k := (kind - 1) & 0xffff
    return (k & 0xff) % NumShapes, (k >> 8) % NumColors
}

ShapeColToKind :: (shape: s32, col: s32) -> s32 {
    return (shape + (col << 8)) + 1
}

CycleColor :: (kind: s32) -> s32 {
    shape, col := KindToShapeCol(kind)
    return ShapeColToKind(shape, (col + 1) % NumColors)
}

CycleShape :: (kind: s32) -> s32 {
    shape, col := KindToShapeCol(kind)
    return ShapeColToKind((shape + 1) % NumShapes, col)
}

IsDigits :: (text: string) -> bool {
    if text.count == 0 { return false }
    for i: 0..text.count-1 {
        if text[i] < 48 || text[i] > 57 { return false }
    }
    return true
}

ParseUnsigned :: (text: string) -> (value: s32, ok: bool) {
    if !IsDigits(text) { return 0, false }
    v, count := IntegerPrefix(text)
    if count != text.count { return 0, false }
    return cast(s32)v, true
}

// Parse schedule entry file contents: "YYYYMMDD mark\nbody"
// Month in the file is 1-based (01..12); returned date uses 0-based month.
ParsedEntry :: struct {
    ok: bool;
    date: s32;
    mark: s32;
    body_start: s64;
    error: string;
}

ParseBody :: (text: string) -> ParsedEntry {
    nl: s64 = -1
    for i: 0..text.count-1 {
        if text[i] == 10 { nl = i; break }
    }
    if nl < 0 { return .{.error = "invalid schedule header (no newline)"} }
    header := text[:nl]
    at: s64 = 0
    while at < header.count && (header[at] == 32 || header[at] == 9) { at += 1 }
    s0 := at
    while at < header.count && header[at] != 32 && header[at] != 9 { at += 1 }
    tok0 := header[s0:at]
    while at < header.count && (header[at] == 32 || header[at] == 9) { at += 1 }
    s1 := at
    while at < header.count && header[at] != 32 && header[at] != 9 { at += 1 }
    tok1 := header[s1:at]
    if tok0.count == 0 || tok1.count == 0 {
        return .{.error = "invalid schedule header (too few fields)"}
    }
    raw_date, ok0 := IntegerPrefix(tok0)
    raw_mark, ok1 := IntegerPrefix(tok1)
    if ok0 == 0 || ok1 == 0 { return .{.error = "invalid schedule header"} }
    dval := cast(s32)raw_date
    y := dval / 10000
    m := (dval / 100) % 100
    d := dval % 100
    if y < 1970 || y > 2037 || m < 1 || m > 12 || d < 1 || d > 31 {
        return .{.error = "invalid date in schedule header"}
    }
    return .{.ok = true, .date = YMDDate(y, m - 1, d), .mark = cast(s32)raw_mark, .body_start = nl + 1}
}

FormatEntry :: (out: *Vec(u8), date: s32, mark: s32, body: string) {
    digits: [24]u8
    unused BuilderAppend(out.*, FormatInteger(cast(s64)(date + 100), digits[:]))
    unused BuilderAppend(out.*, " ")
    unused BuilderAppend(out.*, FormatInteger(cast(s64)mark, digits[:]))
    unused BuilderAppend(out.*, "\n")
    unused BuilderAppend(out.*, body)
}

// Parse Set Time fields matching appl/wm/calendar.b's settime/s2a/validtm.
SetTimeResult :: struct {
    ok: bool;
    epoch: s64;
    error: string;
}

SplitInts :: (text: string, sep1: u8, sep2: u8, out: []s32) -> s64 {
    count: s64 = 0
    at: s64 = 0
    while at < text.count {
        while at < text.count && (text[at] == sep1 || text[at] == sep2) { at += 1 }
        if at >= text.count { break }
        start := at
        while at < text.count && text[at] != sep1 && text[at] != sep2 { at += 1 }
        if count >= out.count { return -1 }
        val, ok := ParseUnsigned(text[start:at])
        if !ok { return -1 }
        out[count] = val
        count += 1
    }
    return count
}

ParseSetTime :: (date_text: string, time_text: string) -> SetTimeResult {
    da: [3]s32
    if SplitInts(date_text, 47, 47, da[:]) != 3 {
        return .{.error = "Invalid date syntax"}
    }
    ta: [3]s32
    tn := SplitInts(time_text, 58, 46, ta[:])
    if tn < 2 || tn > 3 {
        return .{.error = "Invalid time syntax"}
    }
    y := da[0]
    m := da[1]
    d := da[2]
    if d > 1000 {
        tmp := y
        y = d
        d = tmp
    }
    hour := ta[0]
    minute := ta[1]
    second: s32 = ifx tn == 3 then ta[2] else 0
    if !ValidDate(y, m - 1, d) || !ValidTime(hour, minute, second) {
        return .{.error = "Invalid time or date given"}
    }
    return .{.ok = true, .epoch = EpochFromLocal(y, m - 1, d, hour, minute, second)}
}

// Rawdbfs file record parsing and serialization (10-byte "%4d %4d\n" header).
RawHeaderLen :: 10;
RawMinSize :: 20;

RawRecord :: struct {
    id: s32;
    count: s32;
    datalen: s32;
    offset: s64;
}

ParseRawHeader :: (hdr: string) -> (count: s32, datalen: s32, ok: bool) {
    if hdr.count != RawHeaderLen || hdr[9] != 10 { return 0, 0, false }
    at: s64 = 0
    while at < 9 && hdr[at] == 32 { at += 1 }
    c, cn := IntegerPrefix(hdr[at:9])
    if cn == 0 { return 0, 0, false }
    at += cn
    while at < 9 && hdr[at] == 32 { at += 1 }
    d, dn := IntegerPrefix(hdr[at:9])
    if dn == 0 { return 0, 0, false }
    at += dn
    if at != 9 { return 0, 0, false }
    return cast(s32)c, cast(s32)d, true
}

AppendRawRecord :: (out: *Vec(u8), payload: string) {
    count := cast(s32)payload.count
    if count < RawMinSize { count = RawMinSize }
    AppendPadded4(out, count)
    unused VecPush(out.*, 32)
    AppendPadded4(out, cast(s32)payload.count)
    unused VecPush(out.*, 10)
    unused BuilderAppend(out.*, payload)
    pad := cast(s64)count - payload.count
    for _: 0..pad-1 { unused VecPush(out.*, 0) }
}

AppendPadded4 :: (out: *Vec(u8), value: s32) {
    digits: [16]u8
    text := FormatInteger(cast(s64)value, digits[:])
    if text.count < 4 {
        for _: 0..3-text.count { unused VecPush(out.*, 32) }
    }
    unused BuilderAppend(out.*, text)
}

FormatTwo :: (out: *Vec(u8), value: s32) {
    unused VecPush(out.*, cast(u8)(48 + (value / 10) % 10))
    unused VecPush(out.*, cast(u8)(48 + value % 10))
}

FormatFour :: (out: *Vec(u8), value: s32) {
    unused VecPush(out.*, cast(u8)(48 + (value / 1000) % 10))
    unused VecPush(out.*, cast(u8)(48 + (value / 100) % 10))
    unused VecPush(out.*, cast(u8)(48 + (value / 10) % 10))
    unused VecPush(out.*, cast(u8)(48 + value % 10))
}
