<../../../mkconfig

ZI2ZX=zi2zx
ZXBIN=$ROOT/dis/mpeg
ZIFLAGS=--root . --module-path ../../cmd --bind-host taijios_args --bind-host taijios_io

ZXCOMMANDS=\
	decode\
	decode4\
	fixidct\
	fltidct\
	makergbvmap\
	mpeg\
	mpegio\
	refidct\
	remap\
	remap1\
	remap2\
	remap4\
	remap8\
	remap24\
	scidct\
	vlc\

ZXTARGETS=${ZXCOMMANDS:%=%.zx}
ZXINSTALL=${ZXCOMMANDS:%=$ZXBIN/%.zx}

all:V:		$ZXTARGETS

install:V:	$ZXINSTALL

clean:V:
	rm -f *.zx *.dis *.sbl

nuke:V:		clean
	cd $ZXBIN; rm -f $ZXTARGETS

%.zx:	%.zi
	$ZI2ZX $ZIFLAGS --entry $stem:main -o $target $stem.zi

$ZXBIN/%.zx:	%.zx
	install -m 0755 $stem.zx $target
