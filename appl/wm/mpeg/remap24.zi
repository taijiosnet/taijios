// 24-bit RGB YCbCr remapper (replaces appl/wm/mpeg/remap24.b).
Args :: #import "taijios_args";
Io :: #import "taijios_io";
#import "mpeg_types"
#import "std/format"
#import "std/vec"

CLOFF :: 255;

B :: 16;
M :: 1 << B;
B0 :: -22553; // int(-0.34414 * 65536.0)
B1 :: 116129; // int(1.772 * 65536.0)
R0 :: 91881;  // int(1.402 * 65536.0)
R1 :: -46801; // int(-0.71414 * 65536.0)

width: s32;
height: s32;
w2: s32;
h2: s32;
b0r1: Vec(s32);
b1: Vec(s32);
r0: Vec(s32);
clamp: [CLOFF + 256 + CLOFF]u8;

Init :: (m: *Mpegi, out_buf: *Plane) {
    width = m.width;
    height = m.height;
    w2 = width >> 1;
    h2 = height >> 1;
    VecClear(out_buf.b); for _: 0..(cast(s64)(3 * width * height)) - 1 { VecPush(out_buf.b, 0) }
    VecClear(b0r1); for _: 0..(cast(s64)w2) - 1 { VecPush(b0r1, 0) }
    VecClear(b1); for _: 0..(cast(s64)w2) - 1 { VecPush(b1, 0) }
    VecClear(r0); for _: 0..(cast(s64)w2) - 1 { VecPush(r0, 0) }
    for i: 0..CLOFF - 1 {
        clamp[i] = 0;
    }
    for i: 0..255 {
        clamp[i + CLOFF] = cast(u8)i;
    }
    for i: CLOFF + 256..CLOFF + 256 + CLOFF - 1 {
        clamp[i] = 255;
    }
}

Remap :: (p: *YCbCr, out_buf: *Plane) -> *Plane {
    Y := *p.Y;
    Cb := *p.Cb;
    Cr := *p.Cr;
    m: s64 = 0;
    n: s64 = 0;
    x: s64 = 0;
    for _: 0..cast(s64)h2 - 1 {
        for j: 0..cast(s64)w2 - 1 {
            cb := cast(s32)Cb.b[m] - 128;
            cr := cast(s32)Cr.b[m] - 128;
            b0r1[j] = B0 * cb + R1 * cr;
            b1[j] = B1 * cb;
            r0[j] = R0 * cr;
            m += 1;
        }
        for _: 0..1 {
            for k: 0..cast(s64)w2 - 1 {
                for _: 0..1 {
                    y := cast(s32)Y.b[n] << B;
                    n += 1;
                    out_buf.b[x] = clamp[cast(s64)(((y + r0[k]) >> B) + CLOFF)];
                    x += 1;
                    out_buf.b[x] = clamp[cast(s64)(((y + b0r1[k]) >> B) + CLOFF)];
                    x += 1;
                    out_buf.b[x] = clamp[cast(s64)(((y + b1[k]) >> B) + CLOFF)];
                    x += 1;
                }
            }
        }
    }
    return out_buf;
}

main :: () -> s32 {
    m: Mpegi;
    m.width = 4;
    m.height = 2;
    out_buf: Plane;
    Init(*m, *out_buf);
    p: YCbCr;
    VecClear(p.Y.b); for _: 0..(8) - 1 { VecPush(p.Y.b, 0) }
    VecClear(p.Cb.b); for _: 0..(2) - 1 { VecPush(p.Cb.b, 0) }
    VecClear(p.Cr.b); for _: 0..(2) - 1 { VecPush(p.Cr.b, 0) }
    for i: 0..7 { p.Y.b[i] = cast(u8)(100 + i * 10) }
    p.Cb.b[0] = 120;
    p.Cb.b[1] = 140;
    p.Cr.b[0] = 135;
    p.Cr.b[1] = 110;
    res := Remap(*p, *out_buf);
    out: Vec(u8);
    BuilderPrint(*out, "len=% % % % % % %\n", res.b.count, cast(s32)res.b[0], cast(s32)res.b[1], cast(s32)res.b[2], cast(s32)res.b[3], cast(s32)res.b[4], cast(s32)res.b[5]);
    unused Io.Write(1, TextView(out[:]));
    return 0;
}
