UnpackPairs :: (rle: []s32, dst: []Pair) {
    idx: s64 = 0;
    i: s64 = 0;
    while i < rle.count {
        cnt := rle[i];
        a := rle[i + 1];
        b := rle[i + 2];
        for _: 0..cast(s64)cnt - 1 {
            dst[idx].a = a;
            dst[idx].b = b;
            idx += 1;
        }
        i += 3;
    }
}

UnpackTriples :: (rle: []s32, dst: []Triple) {
    idx: s64 = 0;
    i: s64 = 0;
    while i < rle.count {
        cnt := rle[i];
        a := rle[i + 1];
        b := rle[i + 2];
        c := rle[i + 3];
        for _: 0..cast(s64)cnt - 1 {
            dst[idx].a = a;
            dst[idx].b = b;
            dst[idx].c = c;
            idx += 1;
        }
        i += 4;
    }
}

InitTables :: () {
    if tabs_inited { return }
    tabs_inited = true;
    UnpackPairs(mai_rle[:], mai_table[:]);
    UnpackPairs(mbi_rle[:], mbi_table[:]);
    UnpackPairs(mbp_rle[:], mbp_table[:]);
    UnpackPairs(mbb_rle[:], mbb_table[:]);
    UnpackPairs(motion_rle[:], motion_table[:]);
    UnpackPairs(cbp_rle[:], cbp_table[:]);
    UnpackPairs(cdc_rle[:], cdc_table[:]);
    UnpackPairs(ydc_rle[:], ydc_table[:]);
    UnpackPairs(c1_rle[:], c1_table[:]);
    UnpackPairs(c2_rle[:], c2_table[:]);
    UnpackPairs(c3_rle[:], c3_table[:]);
    UnpackPairs(c4_rle[:], c4_table[:]);
    UnpackPairs(c5_rle[:], c5_table[:]);
    UnpackPairs(c6_rle[:], c6_table[:]);
    UnpackPairs(c7_rle[:], c7_table[:]);
    UnpackTriples(rl0f_rle[:], rl0f_table[:]);
    UnpackTriples(rl0n_rle[:], rl0n_table[:]);
    UnpackTriples(c0_rle[:], c0_table[:]);
}
