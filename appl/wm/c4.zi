// Port of Inferno's Connect (appl/wm/c4.b). See ../../NOTICE.
// usage: wm/c4 [-a] [-p] [-s]
// -a makes both players machines, -p prints every move with the two line
// values, -s drops the pauses. The Black and White menus pick who plays,
// the level entries set the search depth, and a click drops a piece.
Surface :: #import "kryon/host/surface";
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Shape :: #import "kryon/shape";
Text :: #import "kryon/text";
Field :: #import "kryon/text_field";
Connect :: #import "c4_model";
Rand :: #import "inferno_rand";
IO :: #import "taijios_io";
Args :: #import "taijios_args";
Clock :: #import "taijios_clock";
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/key_input"
#import "kryon/session"
#import "kryon/text_align"
#import "kryon/tree"
#import "kryon/tree_input"
#import "std/vec"
#import "std/number_text"

Width :: 400
Height :: 478
BoardTop :: 78
// c4.b shipped Black at level 8, which the ZX host runs about seventy times
// slower than the Dis interpreter; 3 answers in about the wall time the Dis's
// 8 did, and the level entry still takes 0 to 10.
DefaultSkillBlack :: 3
// brdx and brdy as the Dis panel's 400 by 400 gave them.
CellW :: Width / Connect.Columns
CellH :: (Height - BoardTop) / Connect.Rows
// The Dis piece was an ellipse 3*CellW/8 across; the round piece takes the
// narrower of its radii.
PieceRadius :: 3 * CellW / 8
CrossX :: 3 * CellW / 8
CrossY :: 3 * CellH / 8

grey: Color = .{221, 221, 221, 255};
light: Color = .{255, 255, 255, 255};
dark: Color = .{173, 173, 173, 255};
black: Color = .{0, 0, 0, 255};
white: Color = .{255, 255, 255, 255};
yellow: Color = .{255, 255, 0, 255};

random: Rand.Random;
game: Connect.Game;
plays: s32;
bwins: s32;
wwins: s32;
turn: s32;
over: bool;
over_until: s64;
score_shown: bool;
illegal_until: s64;
pending: s32 = -1;
menu_open: s32 = -1;
auto: bool;
printout: bool;
nosleep: bool;
message: Vec(u8);
cross_count: s32;
crosses: [24]Connect.MiniMaxResult;

black_bytes: [16]u8;
black_level: Field.State;
white_bytes: [16]u8;
white_level: Field.State;

// daytime->now(): /dev/time in seconds, the seed c4.b drew.
Now :: () -> s32 {
    bytes: [64]u8
    fd := IO.Open("/dev/time", 0)
    if fd < 0 { return 0 }
    count := IO.Read(fd, bytes[:])
    unused IO.Close(fd)
    value: s64 = 0
    for i: 0..count-1 {
        if bytes[i] < cast(u8)48 || bytes[i] > cast(u8)57 { break }
        value = value * 10 + cast(s64)(bytes[i] - cast(u8)48)
    }
    return cast(s32)(value / 1000000)
}

Number :: (text: string) -> s32 {
    value: s32 = 0
    negative := text.count > 0 && text[0] == cast(u8)45
    for i: cast(s64)(ifx negative then 1 else 0)..text.count-1 {
        if text[i] < cast(u8)48 || text[i] > cast(u8)57 { break }
        value = value * 10 + cast(s32)(text[i] - cast(u8)48)
    }
    return ifx negative then -value else value
}

// puts: the message line above the board.
SetMessage :: (text: string) {
    VecClear(message)
    unused BuilderAppend(message, text)
}

Pause :: (millis: s64) -> s64 {
    return ifx nosleep then 0 else millis
}

// blev and wlev: the entry's number becomes the level, capped as c4.b did.
SetSkill :: (colour: s32, text: string) {
    level := Number(text)
    if level > Connect.MaxPlies { level = Connect.MaxPlies }
    if level >= 0 { game.skill[colour] = level }
}

SetField :: (state: *Field.State, text: string) {
    state.length = 0
    for i: cast(s64)0..text.count-1 {
        state.bytes[state.length] = text[i]
        state.length += 1
    }
    state.cursor = state.length
    state.anchor = state.length
}

// highlight: a cross in the opposite colour on every piece of a winning run.
CollectCrosses :: (winner: s32) {
    cross_count = 0
    for column: 0..Connect.Columns - 1 {
        for row: 0..Connect.Rows - 1 {
            cell := Connect.CellAt(cast(s32)column, cast(s32)row)
            if game.cells[cell] != winner { continue }
            for at: 0..game.cell_run_count[cell] - 1 {
                run := game.cell_runs[cell * Connect.CellSlots + at]
                if game.runs[run * 2 + winner] == Connect.WinRun {
                    crosses[cross_count] = .{0, cast(s32)column, cast(s32)row}
                    cross_count += 1
                    break
                }
            }
        }
    }
}

Report :: (mover: s32, move: s32) {
    if !printout { return }
    line: Vec(u8)
    defer VecFree(line)
    digits: [24]u8
    if mover == Connect.Black { unused BuilderAppend(line, "black: ") }
    else { unused BuilderAppend(line, "white: ") }
    unused BuilderAppend(line, FormatInteger(cast(s64)move, digits[:]))
    unused BuilderAppend(line, " ")
    unused BuilderAppend(line, FormatInteger(cast(s64)game.value[Connect.Black], digits[:]))
    unused BuilderAppend(line, " ")
    unused BuilderAppend(line, FormatInteger(cast(s64)game.value[Connect.White], digits[:]))
    unused BuilderAppend(line, "\n")
    unused IO.Write(1, TextView(line[:]))
}

FinishWin :: (winner: s32, now: s64) {
    if winner == Connect.Black { bwins += 1 } else { wwins += 1 }
    if winner == Connect.Black { SetMessage("black wins") } else { SetMessage("white wins") }
    CollectCrosses(winner)
    over = true
    score_shown = false
    over_until = now + Pause(2500)
}

FinishDraw :: (now: s64) {
    SetMessage("draw")
    over = true
    score_shown = false
    over_until = now + Pause(2500)
}

AfterMove :: (mover: s32, now: s64) {
    if Connect.Win(*game, mover) {
        FinishWin(mover, now)
        return
    }
    if game.pieces[Connect.Black] + game.pieces[Connect.White] == Connect.Pieces {
        FinishDraw(now)
        return
    }
    turn = 1 - mover
}

// The machine's search runs in slices between frames, where the Dis's
// process thought through one blocking turn; the budget of steps per frame
// keeps every frame short and the board answering.
SliceLeaves :: 2048
search: Connect.SearchState;
thinking: bool;

// play(): both sides move in turn, the machine thinking, the human clicking.
Step :: (now: s64) {
    if over {
        if now < over_until { return }
        if !score_shown {
            score_shown = true
            digits: [24]u8
            score: Vec(u8)
            defer VecFree(score)
            unused BuilderAppend(score, "black ")
            unused BuilderAppend(score, FormatInteger(cast(s64)bwins, digits[:]))
            unused BuilderAppend(score, ":")
            unused BuilderAppend(score, FormatInteger(cast(s64)wwins, digits[:]))
            unused BuilderAppend(score, " white")
            SetMessage(TextView(score[:]))
            over_until = now + Pause(2500)
            return
        }
        // play()'s trailing blank line and the next game.
        if printout { unused IO.Write(1, "\n") }
        plays += 1
        over = false
        cross_count = 0
        thinking = false
        Connect.Reset(*game)
        turn = ifx plays % 2 == 0 then Connect.Black else Connect.White
        SetMessage("")
        return
    }
    if now < illegal_until { return }
    mover := turn
    other := 1 - turn
    if game.kind[mover] == Connect.Machine {
        if !thinking {
            thinking = true
            SetMessage(ifx mover == Connect.Black then "machine black move" else "machine white move")
            Connect.SearchBegin(*game, *search, mover, other, *random)
        }
        if Connect.SearchSlice(*game, *search, *random, SliceLeaves) {
            thinking = false
            move := Connect.SearchFinish(*game, *search, mover, other)
            Report(mover, move)
            AfterMove(mover, now)
        }
        return
    }
    if pending < 0 {
        SetMessage(ifx mover == Connect.Black then "human black move" else "human white move")
        return
    }
    column := pending
    pending = -1
    if column < 0 || column >= Connect.Columns || game.heights[column] >= Connect.Rows {
        SetMessage("illegal move")
        illegal_until = now + Pause(2500)
        return
    }
    row := game.heights[column]
    Connect.MakeMove(*game, column, row, mover, other)
    Report(mover, column * Connect.MoveScale + row)
    AfterMove(mover, now)
}

// All three canvas buttons did the same: the click's column.
Input :: (session: Session) {
    pointer := PointerSample(session)
    secondary := SecondaryPointerSample(session)
    tertiary := TertiaryPointerSample(session)
    if (pointer.pressed || secondary.pressed || tertiary.pressed) &&
        pointer.y >= cast(float32)BoardTop && pointer.y < cast(float32)(BoardTop + CellH * Connect.Rows) {
        pending = cast(s32)pointer.x / CellW
    }
}

Spot :: struct {
    x: float32
    y: float32
}

CellCenter :: (column: s32, row: s32) -> Spot {
    x := cast(float32)(column * CellW + CellW / 2)
    y := cast(float32)(BoardTop + (Connect.Rows - 1 - row) * CellH + CellH / 2)
    return .{x, y}
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    now := Clock.Millis()
    Input(session)

    typed: [64]u8
    text := TypedTextTake(session, typed[:])
    key := KeyboardTake(session)
    mods := KeyboardModifiers(session)
    input := TextFieldInputFor(key, mods, text)

    Step(now)

    Box.Draw(session, .{.key = 1, .bounds = .{0.0, 0.0, cast(float32)Width, cast(float32)Height}, .fill = grey})
    if Button.Draw(session, .{.key = 10, .bounds = .{2.0, 3.0, 60.0, 20.0}, .label = "Black"}) > 0 {
        menu_open = ifx menu_open == 0 then -1 else 0
    }
    if Button.Draw(session, .{.key = 11, .bounds = .{338.0, 3.0, 60.0, 20.0}, .label = "White"}) > 0 {
        menu_open = ifx menu_open == 1 then -1 else 1
    }
    if menu_open >= 0 {
        left := ifx menu_open == 0 then 2 else 338
        if Button.Draw(session, .{.key = 40, .bounds = .{cast(float32)left, 25.0, 60.0, 20.0}, .label = "Human"}) > 0 {
            game.kind[menu_open] = Connect.Human
            menu_open = -1
        }
        if Button.Draw(session, .{.key = 41, .bounds = .{cast(float32)left, 47.0, 60.0, 20.0}, .label = "Machine"}) > 0 {
            game.kind[menu_open] = Connect.Machine
            menu_open = -1
        }
    }

    Text.Draw(session, .{.key = 50, .bounds = .{2.0, 28.0, 84.0, 20.0}, .text = "Black level", .size = 12})
    black_edit := Field.Draw(session, Field.StateProps(black_level, .{.key = 20, .focus_id = 20,
        .bounds = .{88.0, 26.0, 64.0, 22.0}, .max_bytes = 15, .input = input}))
    unused Field.StateApplyResult(*black_level, black_edit)
    if black_edit.committed { SetSkill(Connect.Black, TextView(black_bytes[:black_level.length])) }
    Text.Draw(session, .{.key = 51, .bounds = .{196.0, 28.0, 84.0, 20.0}, .text = "White level", .size = 12})
    white_edit := Field.Draw(session, Field.StateProps(white_level, .{.key = 22, .focus_id = 22,
        .bounds = .{282.0, 26.0, 64.0, 22.0}, .max_bytes = 15, .input = input}))
    unused Field.StateApplyResult(*white_level, white_edit)
    if white_edit.committed { SetSkill(Connect.White, TextView(white_bytes[:white_level.length])) }

    if message.count > 0 {
        Text.Draw(session, .{.key = 30, .bounds = .{2.0, 52.0, 396.0, 24.0},
            .text = TextView(message[:]), .size = 12})
    }

    // The board: the Dis panel's full 400 by 400 in yellow, with c4.b's grid
    // over it, which stops a cell short of the right and bottom edge as its
    // integer division left them.
    Box.Draw(session, .{.key = 2, .bounds = .{0.0, cast(float32)BoardTop,
        cast(float32)Width, cast(float32)(Height - BoardTop)}, .fill = yellow})
    for i: 1..Connect.Columns - 1 {
        x := cast(float32)(i * CellW)
        Shape.Draw(session, .{.key = cast(u64)(60 + i), .start = .{x, cast(float32)BoardTop},
            .end = .{x, cast(float32)(BoardTop + CellH * Connect.Rows)}, .thickness = 1.0, .color = black})
    }
    for j: 1..Connect.Rows - 1 {
        y := cast(float32)(BoardTop + j * CellH)
        Shape.Draw(session, .{.key = cast(u64)(70 + j), .start = .{0.0, y},
            .end = .{cast(float32)(CellW * Connect.Columns), y}, .thickness = 1.0, .color = black})
    }
    for column: 0..Connect.Columns - 1 {
        for row: 0..Connect.Rows - 1 {
            piece := game.cells[Connect.CellAt(cast(s32)column, cast(s32)row)]
            if piece != Connect.Black && piece != Connect.White { continue }
            center := CellCenter(cast(s32)column, cast(s32)row)
            Shape.Circle(session, .{.key = cast(u64)(100 + cast(s32)row * Connect.Columns + cast(s32)column),
                .center = .{center.x, center.y}, .radius = cast(float32)PieceRadius,
                .fill = ifx piece == Connect.Black then black else white})
        }
    }
    for at: 0..cross_count - 1 {
        center := CellCenter(crosses[at].column, crosses[at].row)
        piece := game.cells[Connect.CellAt(crosses[at].column, crosses[at].row)]
        mark := ifx piece == Connect.Black then white else black
        Shape.Draw(session, .{.key = cast(u64)(300 + at * 2),
            .start = .{center.x - cast(float32)CrossX, center.y},
            .end = .{center.x + cast(float32)CrossX, center.y}, .thickness = 1.0, .color = mark})
        Shape.Draw(session, .{.key = cast(u64)(301 + at * 2),
            .start = .{center.x, center.y - cast(float32)CrossY},
            .end = .{center.x, center.y + cast(float32)CrossY}, .thickness = 1.0, .color = mark})
    }

}

// The level entry's text: one or two digits.
FormatLevel :: (level: s32, digits: []u8) -> []u8 {
    text: [4]u8
    at := 0
    if level >= 10 {
        text[at] = cast(u8)(48 + level / 10)
        at += 1
    }
    text[at] = cast(u8)(48 + level % 10)
    at += 1
    for i: 0..at - 1 { digits[i] = text[i] }
    return digits[:at]
}

#program_export
main :: () -> s32 {
    Connect.Init(*game)
    Connect.Reset(*game)
    for at: 0..Args.OperandCount() - 1 {
        word := Args.Operand(at)
        if word.count > 0 && word[0] == cast(u8)45 {
            for i: cast(s64)1..word.count-1 {
                if word[i] == cast(u8)97 { auto = true }
                else if word[i] == cast(u8)112 { printout = true }
                else if word[i] == cast(u8)115 { nosleep = true }
            }
        }
    }
    if auto { game.kind[Connect.White] = Connect.Machine }
    game.skill[Connect.Black] = DefaultSkillBlack
    Rand.Seed(*random, Now())
    turn = Connect.Black
    black_level.bytes = black_bytes[:]
    digits: [24]u8
    SetField(*black_level, TextView(FormatLevel(DefaultSkillBlack, digits[:])))
    white_level.bytes = white_bytes[:]
    SetField(*white_level, "0")
    return Surface.RunRetained(.{.title = "Connect", .width = Width, .height = Height}, Draw, 15)
}
