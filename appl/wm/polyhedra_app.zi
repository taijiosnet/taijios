// Port of Inferno's Polyhedra (appl/wm/polyhedra.b), built as polyhedra.zx.
// See ../../NOTICE. prev and next step through /lib/polyhedra.all, dual shows
// the dual solid, edges, faces and clear change the drawing, slow and fast
// the speed, axis picks another axis, and menu lists every solid.
// usage: wm/polyhedra [-p index] [-r]
Surface :: #import "kryon/host/surface";
Box :: #import "kryon/box";
Text :: #import "kryon/text";
Render :: #import "polyhedra_render";
Rand :: #import "inferno_rand";
IO :: #import "taijios_io";
Args :: #import "taijios_args";
Clock :: #import "taijios_clock";
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/session"
#import "kryon/text_align"
#import "kryon/tree"
#import "kryon/tree_input"
#import "std/vec"
#import "std/number_text"

Database :: "/lib/polyhedra.all"
Width :: 406
Height :: 496
PanelLeft :: 3
PanelTop :: 93
MenuRows :: 10
MenuRow :: 18

grey: Color = .{221, 221, 221, 255};
light: Color = .{255, 255, 255, 255};
dark: Color = .{173, 173, 173, 255};
pressed_face: Color = .{238, 238, 238, 255};

random: Rand.Random;
current: s64;
dual: bool;
options: Render.Options = .{false, true, true};
motion: Render.Motion;
canvas: Render.Canvas;
animation: Render.Animation;
solid: Render.Solid;
title: Vec(u8);
held: s32 = -1;
menu_open: bool;
menu_offset: s32;
menu_tick: s64;
restart: bool = true;
showing_dual: bool;

// The controls: buttons and check buttons in three rows, then menu.
Prev :: 0
Next :: 1
Dual :: 2
Edges :: 3
Faces :: 4
Clear :: 5
Slow :: 6
Fast :: 7
Axis :: 8
Menu :: 9
Controls :: 10

Control :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
    label: string
    check: bool
}

Layout :: (index: s32) -> Control {
    if index == Prev { return .{1, 1, 42, 18, "prev", false} }
    if index == Next { return .{Width - 43, 1, 42, 18, "next", false} }
    if index == Dual { return .{176, 1, 56, 18, "dual", true} }
    if index == Edges { return .{1, 20, 62, 18, "edges", true} }
    if index == Faces { return .{Width - 63, 20, 62, 18, "faces", true} }
    if index == Clear { return .{172, 20, 64, 18, "clear", true} }
    if index == Slow { return .{1, 40, 42, 18, "slow", false} }
    if index == Fast { return .{Width - 43, 40, 42, 18, "fast", false} }
    if index == Axis { return .{183, 40, 42, 18, "axis", false} }
    return .{1, 72, 42, 18, "menu", false}
}

Checked :: (index: s32) -> bool {
    if index == Dual { return dual }
    if index == Edges { return options.edges }
    if index == Faces { return options.faces }
    return options.clear
}

Inside :: (x: float32, y: float32, left: s32, top: s32, width: s32, height: s32) -> bool {
    return x >= cast(float32)left && y >= cast(float32)top &&
        x < cast(float32)(left + width) && y < cast(float32)(top + height)
}

Count :: () -> s32 { return Render.Count() }

// The solid to draw: the polyhedron, or its dual unless it is an antiprism.
Prepare :: () {
    showing_dual = Render.Choose(current, dual, *solid, *animation, *motion, *canvas)
    VecClear(title)
    digits: [24]u8
    Render.Name(current, showing_dual, *title)
    unused BuilderAppend(title, " (")
    unused BuilderAppend(title, FormatInteger(cast(s64)Render.Index(current), digits[:]))
    unused BuilderAppend(title, ")")
}

// setaxis: a random axis, never zero and never the one before.
NewAxis :: () {
    old := motion.axis
    while (motion.axis[0] == 0 && motion.axis[1] == 0 && motion.axis[2] == 0) ||
          (motion.axis[0] == old[0] && motion.axis[1] == old[1] && motion.axis[2] == old[2]) {
        motion.axis[0] = Rand.Next(*random, 5) - 2
        motion.axis[1] = Rand.Next(*random, 5) - 2
        motion.axis[2] = Rand.Next(*random, 5) - 2
    }
}

Act :: (index: s32) {
    if index == Prev { current = (current - 1 + Count()) % Count(); restart = true }
    else if index == Next { current = (current + 1) % Count(); restart = true }
    else if index == Dual { dual = !dual; restart = true }
    else if index == Edges { options.edges = !options.edges }
    else if index == Faces { options.faces = !options.faces }
    else if index == Clear { options.clear = !options.clear }
    else if index == Slow {
        if motion.theta > Render.Epsilon {
            theta := ifx motion.theta < 2.0 then motion.theta / 2.0 else motion.theta - 1.0
            Render.SetSpeed(*animation, *motion, theta)
        }
    } else if index == Fast {
        if motion.theta < 45.0 {
            theta := ifx motion.theta < 1.0 then 2.0 * motion.theta else motion.theta + 1.0
            Render.SetSpeed(*animation, *motion, theta)
        }
    } else if index == Axis {
        NewAxis()
        Render.SetMatrix(*motion)
        restart = true
    } else if index == Menu {
        menu_open = true
        menu_tick = 0
    }
}

// The menu of solids, ten rows at a time, opened at an eighth of the panel.
MenuLeft :: () -> s32 { return PanelLeft + canvas.width / 8 }
MenuTop :: () -> s32 { return PanelTop + canvas.height / 8 }
MenuWidth :: () -> s32 { return 240 }

MenuLabel :: (index: s64, out: *Vec(u8)) {
    digits: [24]u8
    unused BuilderAppend(out.*, FormatInteger(cast(s64)Render.Index(index), digits[:]))
    unused BuilderAppend(out.*, " ")
    Render.Name(index, dual, out)
}

MenuInput :: (session: Session, pointer: PointerFrame, now: s64) {
    left := MenuLeft()
    top := MenuTop()
    rows := ifx Count() < MenuRows then Count() else MenuRows
    // Pausing just above or below the menu scrolls it a row every 100 ms.
    if now - menu_tick >= 100 && pointer.x > cast(float32)left && pointer.x < cast(float32)(left + MenuWidth()) {
        menu_tick = now
        if pointer.y < cast(float32)top && pointer.y > cast(float32)(top - MenuRow) && menu_offset > 0 { menu_offset -= 1 }
        bottom := top + rows * MenuRow
        if pointer.y >= cast(float32)bottom && pointer.y < cast(float32)(bottom + MenuRow) && menu_offset < Count() - rows {
            menu_offset += 1
        }
    }
    if pointer.released {
        if Inside(pointer.x, pointer.y, left, top, MenuWidth(), rows * MenuRow) {
            row := (cast(s32)pointer.y - top) / MenuRow
            chosen := Render.Index(cast(s64)(menu_offset + row))
            menu_open = false
            for i: cast(s64)0..cast(s64)Count()-1 {
                if Render.Index(i) == chosen { current = i; restart = true; break }
            }
        } else if !Inside(pointer.x, pointer.y, Layout(Menu).x, Layout(Menu).y, Layout(Menu).width, Layout(Menu).height) {
            menu_open = false
        }
    }
}

Input :: (session: Session) {
    pointer := PointerSample(session)
    if menu_open {
        MenuInput(session, pointer, Clock.Millis())
        return
    }
    over: s32 = -1
    for index: cast(s32)0..Controls-1 {
        c := Layout(index)
        if Inside(pointer.x, pointer.y, c.x, c.y, c.width, c.height) { over = index }
    }
    if pointer.pressed { held = over }
    if pointer.released {
        if held >= 0 && held == over { Act(held) }
        held = -1
    }
}

Bevel :: (session: Session, key: u64, c: Control, sunken: bool) {
    upper := ifx sunken then dark else light
    lower := ifx sunken then light else dark
    x := cast(float32)c.x
    y := cast(float32)c.y
    w := cast(float32)c.width
    h := cast(float32)c.height
    Box.Draw(session, .{.key = key, .bounds = .{x, y + h - 1.0, w, 1.0}, .fill = lower})
    Box.Draw(session, .{.key = key + 1, .bounds = .{x + w - 1.0, y, 1.0, h}, .fill = lower})
    Box.Draw(session, .{.key = key + 2, .bounds = .{x, y, w - 1.0, 1.0}, .fill = upper})
    Box.Draw(session, .{.key = key + 3, .bounds = .{x, y, 1.0, h - 1.0}, .fill = upper})
}

DrawControl :: (session: Session, index: s32, pointer: PointerFrame) {
    c := Layout(index)
    key := cast(u64)(100 + index * 10)
    over := Inside(pointer.x, pointer.y, c.x, c.y, c.width, c.height)
    if c.check {
        box: Control = .{c.x + 3, c.y + 3, 12, 12, "", false}
        Box.Draw(session, .{.key = key, .bounds = .{cast(float32)box.x, cast(float32)box.y, 12.0, 12.0},
            .fill = ifx over then pressed_face else grey})
        Bevel(session, key + 1, box, true)
        if Checked(index) {
            Text.Draw(session, .{.key = key + 5, .bounds = .{cast(float32)box.x, cast(float32)box.y, 12.0, 12.0},
                .text = "✔", .size = 11, .align = .TextAlignCenter, .vertical_align = .TextAlignCenter})
        }
        Text.Draw(session, .{.key = key + 6, .bounds = .{cast(float32)(c.x + 20), cast(float32)c.y,
            cast(float32)(c.width - 20), cast(float32)c.height}, .text = c.label, .size = 12,
            .vertical_align = .TextAlignCenter})
        return
    }
    Box.Draw(session, .{.key = key, .bounds = .{cast(float32)c.x, cast(float32)c.y, cast(float32)c.width,
        cast(float32)c.height}, .fill = ifx over then pressed_face else grey})
    Bevel(session, key + 1, c, held == index && over)
    Text.Draw(session, .{.key = key + 6, .bounds = .{cast(float32)c.x, cast(float32)c.y, cast(float32)c.width,
        cast(float32)c.height}, .text = c.label, .size = 12, .align = .TextAlignCenter,
        .vertical_align = .TextAlignCenter})
}

DrawMenu :: (session: Session, pointer: PointerFrame) {
    left := MenuLeft()
    top := MenuTop()
    rows := ifx Count() < MenuRows then Count() else MenuRows
    frame: Control = .{left - 3, top - 3, MenuWidth() + 6, rows * MenuRow + 6, "", false}
    Box.Draw(session, .{.key = 3000, .bounds = .{cast(float32)frame.x, cast(float32)frame.y,
        cast(float32)frame.width, cast(float32)frame.height}, .fill = grey})
    Bevel(session, 3001, frame, false)
    for row: cast(s32)0..rows-1 {
        top_y := top + row * MenuRow
        if Inside(pointer.x, pointer.y, left, top_y, MenuWidth(), MenuRow) {
            Box.Draw(session, .{.key = cast(u64)(3010 + row * 4), .bounds = .{cast(float32)left, cast(float32)top_y,
                cast(float32)MenuWidth(), cast(float32)MenuRow}, .fill = pressed_face})
        }
        label: Vec(u8)
        defer VecFree(label)
        MenuLabel(cast(s64)(menu_offset + row), *label)
        Text.Draw(session, .{.key = cast(u64)(3011 + row * 4), .bounds = .{cast(float32)(left + 4), cast(float32)top_y,
            cast(float32)(MenuWidth() - 8), cast(float32)MenuRow}, .text = TextView(label[:]), .size = 12,
            .vertical_align = .TextAlignCenter})
    }
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    bounds := TreeRootBounds(session)
    width := cast(s32)bounds.width - 2 * PanelLeft
    height := cast(s32)bounds.height - PanelTop - 3
    if width < 3 { width = 3 }
    if height < 3 { height = 3 }
    if width != canvas.width || height != canvas.height {
        // setimage keeps the turn and draws at the new size.
        unused Render.Resize(*canvas, width, height)
    }
    Input(session)
    if restart {
        restart = false
        Prepare()
    }
    Render.Draw(current, showing_dual, solid, *animation, *motion, *canvas, options)

    pointer := PointerSample(session)
    Box.Draw(session, .{.key = 1, .bounds = bounds, .fill = grey})
    for index: cast(s32)0..Controls-1 { DrawControl(session, index, pointer) }
    Text.Draw(session, .{.key = 2, .bounds = .{0.0, 58.0, cast(float32)Width, 14.0}, .text = TextView(title[:]),
        .size = 12, .align = .TextAlignCenter, .vertical_align = .TextAlignCenter})
    Render.Show(session, *canvas, PanelLeft, PanelTop)
    if menu_open { DrawMenu(session, pointer) }
}

// daytime->now(): /dev/time in seconds.
Now :: () -> s32 {
    bytes: [64]u8
    fd := IO.Open("/dev/time", 0)
    if fd < 0 { return 0 }
    count := IO.Read(fd, bytes[:])
    unused IO.Close(fd)
    value: s64 = 0
    for i: 0..count-1 {
        if bytes[i] < cast(u8)48 || bytes[i] > cast(u8)57 { break }
        value = value * 10 + cast(s64)(bytes[i] - cast(u8)48)
    }
    return cast(s32)(value / 1000000)
}

Number :: (text: string) -> s32 {
    value: s32 = 0
    negative := text.count > 0 && text[0] == cast(u8)45
    for i: cast(s64)(ifx negative then 1 else 0)..text.count-1 {
        if text[i] < cast(u8)48 || text[i] > cast(u8)57 { break }
        value = value * 10 + cast(s32)(text[i] - cast(u8)48)
    }
    return ifx negative then -value else value
}

#program_export
main :: () -> s32 {
    Rand.Seed(*random, Now())
    initial: s32 = 40
    at: s32 = 0
    while at < Args.OperandCount() {
        word := Args.Operand(at)
        if word == "-p" && at + 1 < Args.OperandCount() { at += 1; initial = Number(Args.Operand(at)) }
        else if word == "-r" { initial = -1 }
        else if word == "-c" && at + 1 < Args.OperandCount() { at += 1 }
        at += 1
    }
    if Render.Load(Database) <= 0 {
        unused IO.Write(2, "cannot open polyhedra database\n")
        return 1
    }
    // initgeom: the chosen or a random solid, a random axis and 1 to 5 degrees a frame.
    pick := ifx initial < 0 then Rand.Next(*random, Count()) else initial
    current = cast(s64)(pick % Count())
    motion.axis = s32.[1, 1, 1]
    NewAxis()
    motion.theta = cast(float64)(Rand.Next(*random, 5) + 1)
    Render.SetMatrix(*motion)
    menu_offset = (Count() - MenuRows) / 2
    unused Render.Resize(*canvas, 400, 400)
    return Surface.Run(.{.title = "Polyhedra", .width = Width, .height = Height}, Draw, 10)
}
