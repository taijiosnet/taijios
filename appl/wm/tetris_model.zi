// The rules of Inferno's Tetris (appl/wm/tetris.b): a 10x22 board, pieces
// entering at (3, -4), the per-rotation scores, a level every 10 rows and
// the tick delays 300 down to 80 ms. Landed blocks keep their colour, and
// deleted rows move the rows above them down. See ../../NOTICE.
Rand :: #import "inferno_rand";

Width :: 10
Height :: 22
Shapes :: 7

// Keys from module/keyboard.m.
UpKey :: 57362
DownKey :: 57363
LeftKey :: 57364
RightKey :: 57365

Point :: struct {
    x: s32
    y: s32
}

Piece :: struct {
    shape: s32
    rotation: s32
}

Game :: struct {
    // Each cell holds 0 or the landed block's shape + 1.
    cells: [Height * Width]u8
    level: s32
    delay: s32
    score: s32
    rows: s32
    position: Point
    current: Piece
    next: Piece
    over: bool
}

Rotations :: (shape: s32) -> s32 {
    if shape == 1 { return 1 }
    if shape == 2 || shape == 5 || shape == 6 { return 4 }
    return 2
}

// The four blocks of a shape in one rotation, packed as x0 y0 x1 y1 ...
Blocks :: (piece: Piece) -> [8]s32 {
    blocks: [8]s32
    s := piece.shape
    r := piece.rotation
    if s == 0 {
        if r == 0 { blocks = s32.[0,1, 1,1, 2,1, 3,1] } else { blocks = s32.[1,0, 1,1, 1,2, 1,3] }
    } else if s == 1 {
        blocks = s32.[0,0, 0,1, 1,0, 1,1]
    } else if s == 2 {
        if r == 0 { blocks = s32.[1,0, 0,1, 1,1, 2,1] }
        else if r == 1 { blocks = s32.[1,0, 1,1, 2,1, 1,2] }
        else if r == 2 { blocks = s32.[0,1, 1,1, 2,1, 1,2] }
        else { blocks = s32.[1,0, 0,1, 1,1, 1,2] }
    } else if s == 3 {
        if r == 0 { blocks = s32.[0,0, 1,0, 1,1, 2,1] } else { blocks = s32.[1,0, 0,1, 1,1, 0,2] }
    } else if s == 4 {
        if r == 0 { blocks = s32.[1,0, 2,0, 0,1, 1,1] } else { blocks = s32.[0,0, 0,1, 1,1, 1,2] }
    } else if s == 5 {
        if r == 0 { blocks = s32.[2,0, 0,1, 1,1, 2,1] }
        else if r == 1 { blocks = s32.[0,0, 0,1, 0,2, 1,2] }
        else if r == 2 { blocks = s32.[0,0, 1,0, 2,0, 0,1] }
        else { blocks = s32.[0,0, 1,0, 1,1, 1,2] }
    } else {
        if r == 0 { blocks = s32.[0,0, 1,0, 2,0, 2,1] }
        else if r == 1 { blocks = s32.[1,0, 1,1, 0,2, 1,2] }
        else if r == 2 { blocks = s32.[0,0, 0,1, 1,1, 2,1] }
        else { blocks = s32.[0,0, 1,0, 0,1, 0,2] }
    }
    return blocks
}

// The score for landing a shape in a rotation.
Value :: (piece: Piece) -> s32 {
    s := piece.shape
    r := piece.rotation
    if s == 0 { return ifx r == 0 then 5 else 8 }
    if s == 1 { return 6 }
    if s == 2 { return ifx r == 2 then 6 else 5 }
    return ifx r % 2 == 0 then 6 else 7
}

Delay :: (level: s32) -> s32 {
    if level <= 0 { return 300 }
    if level == 1 { return 250 }
    if level == 2 { return 200 }
    if level == 3 { return 150 }
    if level == 4 { return 100 }
    return 80
}

Random :: (random: *Rand.Random) -> Piece {
    shape := Rand.Next(random, Shapes)
    return .{shape, Rand.Next(random, Rotations(shape))}
}

CanMove :: (game: *Game, piece: Piece, at: Point) -> bool {
    blocks := Blocks(piece)
    for i: 0..3 {
        x := at.x + blocks[i * 2]
        y := at.y + blocks[i * 2 + 1]
        if x < 0 || x >= Width || y >= Height { return false }
        if y >= 0 && game.cells[y * Width + x] != cast(u8)0 { return false }
    }
    return true
}

NewPiece :: (game: *Game, random: *Rand.Random) {
    game.current = game.next
    game.next = Random(random)
    game.position = .{3, -4}
}

// Game.new: a fresh board; the generator carries on from the last game.
Start :: (game: *Game, random: *Rand.Random) {
    for i: 0..Height*Width-1 { game.cells[i] = cast(u8)0 }
    game.level = 0
    game.delay = Delay(0)
    game.score = 0
    game.rows = 0
    game.over = false
    game.next = Random(random)
    NewPiece(game, random)
}

Move :: (game: *Game, dx: s32) {
    at: Point = .{game.position.x + dx, game.position.y}
    if CanMove(game, game.current, at) { game.position = at }
}

// Keys and clicks rotate anticlockwise, as rotate(0) did.
Rotate :: (game: *Game) {
    piece := game.current
    turns := Rotations(piece.shape)
    piece.rotation = (piece.rotation - 1 + turns) % turns
    if CanMove(game, piece, game.position) { game.current = piece }
}

Drop :: (game: *Game) {
    at: Point = .{game.position.x, game.position.y + 1}
    while CanMove(game, game.current, at) { at.y += 1 }
    at.y -= 1
    game.position = at
}

// Remove full rows; the rows above move down over them.
DeleteRows :: (game: *Game, full: [4]s32, count: s32) {
    keep: s32 = Height - 1
    row: s32 = Height - 1
    while row >= 0 {
        deleted := false
        for i: 0..count-1 { if full[i] == row { deleted = true } }
        if !deleted {
            if keep != row {
                for x: 0..Width-1 { game.cells[keep * Width + x] = game.cells[row * Width + x] }
            }
            keep -= 1
        }
        row -= 1
    }
    while keep >= 0 {
        for x: 0..Width-1 { game.cells[keep * Width + x] = cast(u8)0 }
        keep -= 1
    }
}

// One tick: fall a row, or land, clear full rows, score and take the next
// piece. A landing above the board ends the game and returns false; blocks
// of that piece checked before the one above the board stay landed.
Tick :: (game: *Game, random: *Rand.Random) -> bool {
    if game.over { return false }
    below: Point = .{game.position.x, game.position.y + 1}
    if CanMove(game, game.current, below) {
        game.position = below
        return true
    }
    blocks := Blocks(game.current)
    top := game.position.y + 4
    bottom := game.position.y
    for i: 0..3 {
        x := game.position.x + blocks[i * 2]
        y := game.position.y + blocks[i * 2 + 1]
        if y < 0 {
            game.delay = -1
            game.over = true
            return false
        }
        if y > bottom { bottom = y }
        if y < top { top = y }
        game.cells[y * Width + x] = cast(u8)(game.current.shape + 1)
    }
    full: [4]s32
    count: s32 = 0
    for row: top..bottom {
        filled := true
        for x: 0..Width-1 { if game.cells[row * Width + x] == cast(u8)0 { filled = false } }
        if filled { full[count] = row; count += 1 }
    }
    if count > 0 {
        DeleteRows(game, full, count)
        game.rows += count
        level := game.rows / 10
        if level != game.level {
            game.level = level
            game.delay = Delay(level)
        }
    }
    game.score += Value(game.current)
    NewPiece(game, random)
    return true
}

// The preview offset that centres the next piece in a 4x4 box of size-pixel blocks.
PreviewOrigin :: (piece: Piece, size: s32) -> Point {
    blocks := Blocks(piece)
    low: Point = .{4, 4}
    high: Point = .{0, 0}
    for i: 0..3 {
        x := blocks[i * 2]
        y := blocks[i * 2 + 1]
        if x > high.x { high.x = x }
        if x < low.x { low.x = x }
        if y > high.y { high.y = y }
        if y < low.y { low.y = y }
    }
    return .{(4 - (high.x - low.x + 1)) * size / 2 - low.x * size, (4 - (high.y - low.y + 1)) * size / 2 - low.y * size}
}
