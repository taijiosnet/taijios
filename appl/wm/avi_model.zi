using Riff :: #import "riff";

PutPixel :: (rgba: []u8, x: s64, y: s64, width: s64, height: s64, palette: []u8, index: s32) {
    if x < 0 || y < 0 || x >= width || y >= height || index < 0 || index > 255 { return }
    at := (y*width + x) * 4
    rgba[at] = palette[index*3]
    rgba[at+1] = palette[index*3+1]
    rgba[at+2] = palette[index*3+2]
    rgba[at+3] = 255
}



Decode :: (movie: *Riff.Movie, data: []u8, index: s32, rgba: []u8) -> string {
    if index < 0 || index >= movie.frames.count { return "no such frame" }
    frame := movie.frames[index]
    if frame.offset+frame.length > data.count { return "truncated frame" }
    body := data[frame.offset:frame.offset+frame.length]
    width := cast(s64)movie.width
    height := cast(s64)movie.height
    if rgba.count < width*height*4 { return "pixel buffer is too small" }
    if movie.compression == Riff.BI_RGB {
        if body.count < width*height { return "short frame" }
        for i: cast(s64)0..width*height-1 {
            PutPixel(rgba, i % width, i / width, width, height, movie.palette[:], cast(s32)body[i])
        }
        return ""
    }


    p: s64 = 0
    x: s64 = 0
    y: s64 = height-1
    while p < body.count {
        n := cast(s32)body[p]
        p += 1
        if n == 0 {
            if p >= body.count { break }
            escape := cast(s32)body[p]
            p += 1
            if escape == 0 { x = 0; y -= 1; continue }
            if escape == 1 { break }
            if escape == 2 {
                if p+1 >= body.count { break }
                x += cast(s64)body[p]; p += 1
                y -= cast(s64)body[p]; p += 1
                continue
            }
            for k: cast(s32)0..escape-1 {
                if p >= body.count { break }
                PutPixel(rgba, x, y, width, height, movie.palette[:], cast(s32)body[p])
                p += 1
                x += 1
            }
            if (p & 1) != 0 { p += 1 }
            continue
        }
        if p >= body.count { break }
        colour := cast(s32)body[p]
        p += 1
        for k: cast(s32)0..n-1 {
            PutPixel(rgba, x, y, width, height, movie.palette[:], colour)
            x += 1
        }
    }
    return ""
}
