// File Chooser, ported from appl/wm/filename.b and appl/lib/selectfile.b.
Surface :: #import "kryon/host/surface";
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Label :: #import "kryon/text";
Field :: #import "kryon/text_field";
Scroll :: #import "kryon/scroll";
M :: #import "filename_model";
IO :: #import "taijios_io";
Stat :: #import "taijios_stat";
Args :: #import "taijios_args";
Clock :: #import "taijios_clock";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/key_input"
#import "kryon/drawing_props"
#import "std/vec"

ColumnWidth :: 180.0;
RowHeight :: 24.0;
HeaderHeight :: 26.0;
DoubleClickMillis :: 450;

Entry :: struct {
    name: Vec(u8);
    is_dir: bool;
}

Column :: struct {
    title: Vec(u8);
    entries: Vec(Entry);
    selected: s32;
    scroll_y: s32;
}

columns: Vec(Column);
patterns: Vec(M.Pattern);

bpath: Vec(u8);
epath: Vec(u8);
path_bytes: [1024]u8;
path_field: Field.State;

filter_bytes: [512]u8;
filter_field: Field.State;

scroll_x: s32;
scroll_to_end: bool;

last_click_col: s32 = -1;
last_click_row: s32 = -1;
last_click_ms: s64 = 0;

accepted: bool;
result_bytes: Vec(u8);

FreeColumn :: (col: *Column) {
    VecFree(col.title);
    for *e: col.entries[:] { VecFree(e.name); }
    VecFree(col.entries);
}

EntryName :: (e: *Entry) -> string {
    return TextView(e.name[:]);
}

ColumnTitle :: (col: *Column) -> string {
    return TextView(col.title[:]);
}

SwapEntries :: (a: *Entry, b: *Entry) {
    first: Vec(u8);
    defer VecFree(first);
    second: Vec(u8);
    defer VecFree(second);
    unused BuilderAppend(first, EntryName(a));
    unused BuilderAppend(second, EntryName(b));
    VecClear(a.name);
    unused BuilderAppend(a.name, TextView(second[:]));
    VecClear(b.name);
    unused BuilderAppend(b.name, TextView(first[:]));
    dir := a.is_dir;
    a.is_dir = b.is_dir;
    b.is_dir = dir;
}

DeleteColumnsFrom :: (from: s64) {
    while columns.count > from {
        FreeColumn(*columns[columns.count - 1]);
        unused VecResize(columns, columns.count - 1);
    }
}

SetPathField :: (text: string) {
    n := text.count;
    if n >= path_bytes.count { n = path_bytes.count - 1; }
    for i: cast(s64)0..n-1 { path_bytes[i] = text[i]; }
    path_field.length = cast(s32)n;
    path_field.cursor = path_field.length;
    path_field.anchor = path_field.length;
    VecClear(epath);
    unused BuilderAppend(epath, text[:n]);
}

SetFilterField :: (text: string) {
    n := text.count;
    if n >= filter_bytes.count { n = filter_bytes.count - 1; }
    for i: cast(s64)0..n-1 { filter_bytes[i] = text[i]; }
    filter_field.length = cast(s32)n;
    filter_field.cursor = filter_field.length;
    filter_field.anchor = filter_field.length;
}

IsDirectory :: (path: string) -> (exists: bool, is_dir: bool) {
    meta: [12]u8;
    if IO.Stat(path, meta[:]) != 0 { return false, false; }
    return true, (meta[11] & cast(u8)128) != cast(u8)0;
}

ReadDirectoryColumn :: (dir_path: string, title: string) -> bool {
    fd := IO.Open(dir_path, 0);
    if fd < 0 { return false; }
    defer { unused IO.Close(fd); }

    col: Column;
    col.selected = -1;
    unused BuilderAppend(col.title, title);

    buf: [8192]u8;
    while true {
        n := IO.Read(fd, buf[:]);
        if n <= 0 { break; }
        pos: s64 = 0;
        while pos < cast(s64)n {
            info := Stat.Decode(buf[pos:n]);
            if info.size <= 0 { break; }
            pos += info.size;
            is_dir := (info.mode & cast(u32)Stat.Directory) != cast(u32)0;
            if !M.MatchesAny(patterns[:], info.name, is_dir) { continue; }
            // Compact duplicates (matching Readdir->COMPACT).
            dup := false;
            for *existing: col.entries[:] {
                if M.Deslash(TextView(existing.name[:])) == info.name {
                    dup = true;
                    break;
                }
            }
            if dup { continue; }
            entry: Entry;
            entry.is_dir = is_dir;
            unused BuilderAppend(entry.name, info.name);
            if is_dir { unused BuilderAppend(entry.name, "/"); }
            unused VecPush(col.entries, entry);
        }
    }

    // Insertion sort by name (matching Readdir->NAME).
    for i: cast(s64)1..col.entries.count-1 {
        j := i;
        while j > 0 && M.CompareText(EntryName(*col.entries[j - 1]), EntryName(*col.entries[j])) > 0 {
            SwapEntries(*col.entries[j], *col.entries[j - 1]);
            j -= 1;
        }
    }

    unused VecPush(columns, col);
    scroll_to_end = true;
    return true;
}

SelectInColumn :: (cno: s64, elem: string) {
    if cno < 0 || cno >= columns.count { return; }
    col := *columns[cno];
    col.selected = -1;
    if elem.count == 0 { return; }
    index: s32 = 0;
    for *e: col.entries[:] {
        if M.Deslash(EntryName(e)) == elem {
            col.selected = index;
            return;
        }
        index += 1;
    }
}

// Synchronize Miller columns with epath, matching selectfile.b bsync().
Sync :: () {
    // Cap iterations so a malformed path can never loop forever.
    for step: cast(s32)0..63 {
        if !SyncStep() { return; }
    }
}

// One descent step. Returns false when the columns are in sync, true to
// descend another element.
SyncStep :: () -> bool {
    ep := TextView(epath[:]);
    bp := TextView(bpath[:]);
    cno: s64 = 0;
    prefix: Vec(u8);
    defer VecFree(prefix);
    matched: Vec(u8);
    defer VecFree(matched);
    e1: string;
    e2: string;
    while true {
        ne1, p1 := M.NextElem(ep);
        ne2, p2 := M.NextElem(bp);
        e1 = ne1;
        e2 = ne2;
        if e1.count == 0 || e1 != e2 { break; }
        tmp: Vec(u8);
        M.PathCat(TextView(prefix[:]), e1, *tmp);
        VecClear(prefix);
        unused BuilderAppend(prefix, TextView(tmp[:]));
        VecFree(tmp);
        ep = p1;
        bp = p2;
        cno += 1;
    }

    if ep.count == 0 {
        if bp.count > 0 {
            DeleteColumnsFrom(cno);
            SelectInColumn(cno - 1, "");
            VecClear(bpath);
            unused BuilderAppend(bpath, TextView(prefix[:]));
        }
        return false;
    }

    if cno == 0 && M.IsLastElem(ep) { return false; }

    if e1.count > 0 && M.IsLastElem(ep) {
        if cno - 1 >= 0 && cno - 1 < columns.count {
            col := *columns[cno - 1];
            for *entry: col.entries[:] {
                name := EntryName(entry);
                if M.StartsWith(name, e1) {
                    VecClear(matched);
                    unused BuilderAppend(matched, M.Deslash(name));
                    break;
                }
            }
        }
        if matched.count > 0 {
            if TextView(matched[:]) == e2 && M.IsLastElem(bp) { return false; }
            e1 = TextView(matched[:]);
            if e1 == e2 { cno += 1; }
        } else {
            DeleteColumnsFrom(cno);
            VecClear(bpath);
            unused BuilderAppend(bpath, TextView(prefix[:]));
            return false;
        }
    }

    DeleteColumnsFrom(cno);
    SelectInColumn(cno - 1, e1);
    np: Vec(u8);
    defer VecFree(np);
    M.PathCat(TextView(prefix[:]), e1, *np);
    exists, is_dir := IsDirectory(TextView(np[:]));
    descend := exists && is_dir && ReadDirectoryColumn(TextView(np[:]), e1);
    VecClear(bpath);
    if descend || (exists && !is_dir) {
        unused BuilderAppend(bpath, TextView(np[:]));
    } else {
        unused BuilderAppend(bpath, TextView(prefix[:]));
    }
    return descend;
}

ClickEntry :: (cno: s64, row: s32) {
    if cno < 0 || cno >= columns.count { return; }
    if row < 0 || cast(s64)row >= columns[cno].entries.count { return; }
    now := Clock.MonotonicMillis();
    is_double := (last_click_col == cast(s32)cno && last_click_row == row &&
                  now - last_click_ms <= DoubleClickMillis);
    last_click_col = cast(s32)cno;
    last_click_row = row;
    last_click_ms = now;

    columns[cno].selected = row;
    // Reconstruct path from bpath elements 0..cno plus selected entry.
    base: Vec(u8);
    defer VecFree(base);
    unused BuilderAppend(base, TextView(bpath[:]));
    bp := TextView(base[:]);
    nb: Vec(u8);
    defer VecFree(nb);
    for k: cast(s64)0..cno {
        elem, rest := M.NextElem(bp);
        bp = rest;
        if elem.count > 0 {
            tmp: Vec(u8);
            defer VecFree(tmp);
            M.PathCat(TextView(nb[:]), elem, *tmp);
            VecClear(nb);
            unused BuilderAppend(nb, TextView(tmp[:]));
        }
    }
    selected: Vec(u8);
    defer VecFree(selected);
    unused BuilderAppend(selected, EntryName(*columns[cno].entries[row]));
    if selected.count > 0 {
        tmp: Vec(u8);
        defer VecFree(tmp);
        M.PathCat(TextView(nb[:]), TextView(selected[:]), *tmp);
        VecClear(nb);
        unused BuilderAppend(nb, TextView(tmp[:]));
    }
    SetPathField(TextView(nb[:]));
    Sync();
    if is_double {
        Accept();
    }
}

Accept :: () {
    accepted = true;
    VecClear(result_bytes);
    unused BuilderAppend(result_bytes, TextView(path_bytes[:path_field.length]));
    Surface.Close();
}

Cancel :: () {
    accepted = false;
    VecClear(result_bytes);
    Surface.Close();
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch};
    bounds := TreeRootBounds(session);
    Box.Draw(session, .{.key = 1, .bounds = bounds, .fill = .{242, 244, 248, 255}});

    typed: [256]u8;
    text := TypedTextTake(session, typed[:]);
    key := KeyboardTake(session);
    mods := KeyboardModifiers(session);

    // Tab expands the path field to the matched browser path (selectfile.b <Key-\t>).
    if key == KeyTab && bpath.count > 0 {
        SetPathField(TextView(bpath[:]));
        key = 0;
    } else if key == KeyEscape {
        Cancel();
        return;
    }

    // Bottom bar: Filter row and Path + OK/Cancel row.
    bottom_h: float32 = 82.0;
    cols_area: Rectangle = .{bounds.x + 8.0, bounds.y + 8.0, bounds.width - 16.0, bounds.height - bottom_h - 14.0};

    // Draw Miller columns inside a horizontal scroll view.
    if cols_area.width > 32.0 && cols_area.height > 40.0 {
        Box.Draw(session, .{.key = 2, .bounds = cols_area, .fill = .{224, 228, 235, 255}});
        total_w := cast(s32)(cast(float32)(columns.count + 1) * ColumnWidth);
        if scroll_to_end {
            scroll_to_end = false;
            want := total_w - cast(s32)cols_area.width;
            if want < 0 { want = 0; }
            scroll_x = want;
        }
        horiz := Scroll.Draw(session, .{.key = 3, .bounds = cols_area, .horizontal = true, .content_width = total_w, .scroll_offset = scroll_x, .immediate_wheel = true, .manual_scroll = true});
        scroll_x = horiz.scroll_offset;

        col_h := horiz.viewport.height;
        clicked_col: s64 = -1;
        clicked_row: s32 = -1;

        for cno: cast(s64)0..columns.count-1 {
            cx := horiz.content.x + cast(float32)cno * ColumnWidth;
            cy := horiz.viewport.y;
            base_key := cast(u64)(1000 + cno * 10000);
            Box.Draw(session, .{.key = base_key, .bounds = .{cx, cy, ColumnWidth - 2.0, col_h}, .fill = .{255, 255, 255, 255}});
            Box.Draw(session, .{.key = base_key + 1, .bounds = .{cx, cy, ColumnWidth - 2.0, HeaderHeight}, .fill = .{24, 28, 38, 255}});
            Label.Draw(session, .{.key = base_key + 2, .bounds = .{cx + 6.0, cy + 4.0, ColumnWidth - 14.0, HeaderHeight - 6.0}, .text = ColumnTitle(*columns[cno])});

            list_rect: Rectangle = .{cx, cy + HeaderHeight, ColumnWidth - 2.0, col_h - HeaderHeight};
            if list_rect.height > 8.0 {
                content_h := cast(s32)(cast(float32)columns[cno].entries.count * RowHeight);
                vert := Scroll.Draw(session, .{.key = base_key + 3, .bounds = list_rect, .content_height = content_h, .scroll_offset = columns[cno].scroll_y, .immediate_wheel = true, .manual_scroll = true});
                columns[cno].scroll_y = vert.scroll_offset;

                for row: cast(s64)0..columns[cno].entries.count-1 {
                    ry := vert.content.y + cast(float32)row * RowHeight;
                    if ry + RowHeight < vert.viewport.y || ry > vert.viewport.y + vert.viewport.height { continue; }
                    row_rect: Rectangle = .{vert.viewport.x, ry, vert.viewport.width, RowHeight};
                    is_sel := columns[cno].selected == cast(s32)row;
                    if is_sel {
                        Box.Draw(session, .{.key = base_key + 10 + cast(u64)row * 2, .bounds = row_rect, .fill = .{52, 114, 204, 255}});
                    }
                    if Button.Draw(session, .{.key = base_key + 11 + cast(u64)row * 2, .bounds = row_rect, .label = EntryName(*columns[cno].entries[row])}) > 0 {
                        clicked_col = cno;
                        clicked_row = cast(s32)row;
                    }
                }
                if vert.opened { End(session); }
            }
        }
        if horiz.opened { End(session); }

        if clicked_col >= 0 {
            ClickEntry(clicked_col, clicked_row);
            if accepted { return; }
        }
    }

    // Filter row
    fy := bounds.y + bounds.height - bottom_h;
    Label.Draw(session, .{.key = 10, .bounds = .{bounds.x + 8.0, fy + 6.0, 52.0, 24.0}, .text = "Filter:", .size = 14});
    fedit := Field.Draw(session, Field.StateProps(filter_field, .{.key = 11, .focus_id = 11, .bounds = .{bounds.x + 62.0, fy, bounds.width - 70.0, 32.0}, .placeholder = "Glob patterns (e.g. *.zi *.b)", .max_bytes = 511, .input = TextFieldInputFor(key, mods, text)}));
    unused Field.StateApplyResult(*filter_field, fedit);
    if fedit.committed {
        M.ParseFilter(TextView(filter_bytes[:filter_field.length]), *patterns);
        DeleteColumnsFrom(0);
        VecClear(bpath);
        Sync();
    }

    // Path row + OK / Cancel buttons
    py := fy + 40.0;
    pedit := Field.Draw(session, Field.StateProps(path_field, .{.key = 12, .focus_id = 12, .bounds = .{bounds.x + 8.0, py, bounds.width - 178.0, 32.0}, .placeholder = "File path", .max_bytes = 1023, .input = TextFieldInputFor(key, mods, text)}));
    unused Field.StateApplyResult(*path_field, pedit);
    if pedit.edit.changed {
        VecClear(epath);
        unused BuilderAppend(epath, TextView(path_bytes[:path_field.length]));
        Sync();
    }
    if pedit.committed {
        Accept();
        return;
    }

    if Button.Draw(session, .{.key = 13, .bounds = .{bounds.x + bounds.width - 162.0, py, 74.0, 32.0}, .label = "OK"}) > 0 {
        Accept();
        return;
    }
    if Button.Draw(session, .{.key = 14, .bounds = .{bounds.x + bounds.width - 82.0, py, 74.0, 32.0}, .label = "Cancel"}) > 0 {
        Cancel();
        return;
    }
}

WriteStderr :: (msg: string) {
    unused IO.Write(2, msg);
}

#program_export
main :: () -> s32 {
    argc := Args.Count();
    operands: Vec(string);
    defer VecFree(operands);
    for i: cast(s32)0..argc-1 {
        unused VecPush(operands, Args.Operand(i));
    }

    opts := M.ParseArgs(operands[:]);
    if opts.usage_error {
        if opts.error_opt != 0 {
            msg: Vec(u8);
            defer VecFree(msg);
            unused BuilderAppend(msg, "filename: unknown option -");
            unused VecPush(msg, opts.error_opt);
            unused BuilderAppend(msg, "\n");
            WriteStderr(TextView(msg[:]));
        }
        WriteStderr("usage: filename [-g geom] [-d startdir] [pattern...]\n");
        return 1;
    }

    startdir := opts.startdir;
    if startdir.count == 0 || startdir == "." {
        cwd := IO.Cwd();
        if cwd.count > 0 {
            exists, _ := IsDirectory(cwd);
            if exists { startdir = cwd; }
            else { startdir = "/"; }
        } else {
            startdir = "/";
        }
    }

    filter_init: Vec(u8);
    defer VecFree(filter_init);
    if opts.pattern_start < cast(s32)operands.count {
        M.MakePats(operands[opts.pattern_start:], *patterns, *filter_init);
    }

    path_field.bytes = path_bytes[:];
    filter_field.bytes = filter_bytes[:];
    SetPathField(startdir);
    SetFilterField(TextView(filter_init[:]));
    Sync();

    rc := Surface.RunRetained(.{.title = opts.title, .width = 640, .height = 420}, Draw, 0);

    // Match filename.b: print chosen path (or empty line if cancelled) + newline.
    out: Vec(u8);
    defer VecFree(out);
    if accepted {
        unused BuilderAppend(out, TextView(result_bytes[:]));
    }
    unused BuilderAppend(out, "\n");
    unused IO.Write(1, TextView(out[:]));

    DeleteColumnsFrom(0);
    VecFree(columns);
    M.FreePatterns(*patterns);
    VecFree(bpath);
    VecFree(epath);
    VecFree(result_bytes);
    return rc;
}
