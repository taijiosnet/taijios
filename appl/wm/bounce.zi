// Port of Inferno's Bounce (appl/wm/bounce.b). See ../../NOTICE.
// usage: wm/bounce [nballs]
// A press on the canvas and its release draw a line the balls bounce off,
// from either canvas button as the Dis version bound them. The toolbar's
// left and right buttons drop and add balls, as its bitmap arrows did.
Surface :: #import "kryon/host/surface";
Box :: #import "kryon/box";
Shape :: #import "kryon/shape";
Text :: #import "kryon/text";
Board :: #import "bounce_model";
Rand :: #import "inferno_rand";
IO :: #import "taijios_io";
Args :: #import "taijios_args";
Clock :: #import "taijios_clock";
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/input_protocol"
#import "kryon/session"
#import "kryon/text_align"
#import "kryon/tree"
#import "kryon/tree_input"
#import "std/vec"
#import "std/number_text"

BarHeight :: 24
Width :: 404
Height :: 428
// The canvas the Dis version configured at 400 by 400, inside the 2-pixel ridge.
OriginX :: 2
OriginY :: 26
CanvasWidth :: 400
CanvasHeight :: 400
// The Dis drew its lines with tk's -width 3.
LineThickness :: 3.0

grey: Color = .{221, 221, 221, 255};
light: Color = .{255, 255, 255, 255};
dark: Color = .{173, 173, 173, 255};
black: Color = .{0, 0, 0, 255};
pressed_face: Color = .{238, 238, 238, 255};

random: Rand.Random;
board: Board.Board;
// Balls that found no line ahead, as the Dis deleted their ovals. They stay
// stacked until the left button drops them, as the monitor kept their slot.
lost: [Board.MaxBalls]bool;
// The line each ball last bounced off: a new line replans the flight from
// where the ball is, skipping that line once, as lineversion did.
last_bounce: [Board.MaxBalls]s32;
drawing: bool;
draw_index: s32;
draw_x: s32;
draw_y: s32;
held: s32 = -1;
seen_lines: s32;
last_millis: s64;

NewBall :: () {
    if board.ball_count >= Board.MaxBalls { return }
    Board.NewBall(*board, *random)
    at := board.ball_count - 1
    lost[at] = false
    last_bounce[at] = -1
}

// The frame's k commands: one ball off or on the top of the stack.
Adjust :: (delta: s32) {
    if delta > 0 {
        NewBall()
        return
    }
    unused Board.RemoveBall(*board)
}

Inside :: (x: float32, y: float32, left: s32, top: s32, width: s32, height: s32) -> bool {
    return x >= cast(float32)left && y >= cast(float32)top &&
        x < cast(float32)(left + width) && y < cast(float32)(top + height)
}

LeftButton :: 0
RightButton :: 1

ButtonAt :: (x: float32, y: float32) -> s32 {
    if Inside(x, y, 2, 3, 20, 18) { return LeftButton }
    if Inside(x, y, 26, 3, 20, 18) { return RightButton }
    return -1
}

// makelinesproc: the press adds the degenerate line and the release gives it
// its far end. Both canvas buttons did the same, as the Dis bound them.
StartLine :: (x: float32, y: float32) {
    if board.line_count >= Board.MaxLines { return }
    draw_x = cast(s32)x - OriginX
    draw_y = cast(s32)y - OriginY
    Board.AddLine(*board, .{cast(float64)draw_x, cast(float64)draw_y, cast(float64)draw_x, cast(float64)draw_y})
    draw_index = board.line_count - 1
    drawing = true
}

FinishLine :: (x: float32, y: float32) {
    if !drawing { return }
    drawing = false
    updated: Board.Line = .{cast(float64)draw_x, cast(float64)draw_y,
        cast(float64)(cast(s32)x - OriginX), cast(float64)(cast(s32)y - OriginY)}
    board.lines[draw_index] = updated
}

Input :: (session: Session) {
    pointer := PointerSample(session)
    middle := TertiaryPointerSample(session)
    over := ButtonAt(pointer.x, pointer.y)
    if (pointer.pressed || middle.pressed) && held < 0 && !drawing {
        if over >= 0 { held = over }
        else if Inside(pointer.x, pointer.y, OriginX, OriginY, CanvasWidth, CanvasHeight) {
            StartLine(pointer.x, pointer.y)
        }
    }
    if pointer.released || middle.released {
        if held >= 0 {
            if held == over { Adjust(ifx held == RightButton then 1 else -1) }
            held = -1
        } else {
            FinishLine(pointer.x, pointer.y)
        }
    }
}

// animproc's flight for one frame: travel the frame's distance, bouncing at
// every line ahead. Returns false when no line is ahead, as the Dis gave up.
Advance :: (at: s32, travel: float64, replan: bool) -> bool {
    ball := *board.balls[at]
    if replan { ball.hit_id = last_bounce[at] }
    remaining := travel
    for hop: 0..63 {
        hit := Board.NextHit(ball, *board)
        if !hit.found { return false }
        if hit.distance >= remaining {
            ball.x += ball.vx * remaining
            ball.y += ball.vy * remaining
            return true
        }
        if hit.distance < 0.0001 { ball.small += 1 } else { ball.small = 0 }
        last_bounce[at] = ball.hit_id
        ball.x = hit.x
        ball.y = hit.y
        Board.Reflect(ball, *board)
        remaining -= hit.distance
    }
    return true
}

Ridge :: (session: Session, key: u64, x: float32, y: float32, width: float32, height: float32) {
    Box.Draw(session, .{.key = key, .bounds = .{x, y, width, 1.0}, .fill = light})
    Box.Draw(session, .{.key = key + 1, .bounds = .{x, y, 1.0, height}, .fill = light})
    Box.Draw(session, .{.key = key + 2, .bounds = .{x + 1.0, y + 1.0, width - 2.0, 1.0}, .fill = dark})
    Box.Draw(session, .{.key = key + 3, .bounds = .{x + 1.0, y + 1.0, 1.0, height - 2.0}, .fill = dark})
    Box.Draw(session, .{.key = key + 4, .bounds = .{x + 1.0, y + height - 2.0, width - 2.0, 1.0}, .fill = light})
    Box.Draw(session, .{.key = key + 5, .bounds = .{x + width - 2.0, y + 1.0, 1.0, height - 2.0}, .fill = light})
    Box.Draw(session, .{.key = key + 6, .bounds = .{x, y + height - 1.0, width, 1.0}, .fill = dark})
    Box.Draw(session, .{.key = key + 7, .bounds = .{x + width - 1.0, y, 1.0, height}, .fill = dark})
}

Bevel :: (session: Session, key: u64, x: s32, y: s32, width: s32, height: s32, sunken: bool) {
    upper := ifx sunken then dark else light
    lower := ifx sunken then light else dark
    left := cast(float32)x
    top := cast(float32)y
    w := cast(float32)width
    h := cast(float32)height
    Box.Draw(session, .{.key = key, .bounds = .{left, top + h - 1.0, w, 1.0}, .fill = lower})
    Box.Draw(session, .{.key = key + 1, .bounds = .{left + w - 1.0, top, 1.0, h}, .fill = lower})
    Box.Draw(session, .{.key = key + 2, .bounds = .{left, top, w - 1.0, 1.0}, .fill = upper})
    Box.Draw(session, .{.key = key + 3, .bounds = .{left, top, 1.0, h - 1.0}, .fill = upper})
}

// The Dis toolbar's bitmap arrows, as text buttons.
DrawButton :: (session: Session, which: s32, pointer: PointerFrame) {
    x: s32 = ifx which == LeftButton then 2 else 26
    key := cast(u64)(100 + which * 10)
    over := Inside(pointer.x, pointer.y, x, 3, 20, 18)
    Box.Draw(session, .{.key = key, .bounds = .{cast(float32)x, 3.0, 20.0, 18.0},
        .fill = ifx over then pressed_face else grey})
    Bevel(session, key + 1, x, 3, 20, 18, held == which && over)
    Text.Draw(session, .{.key = key + 6, .bounds = .{cast(float32)x, 3.0, 20.0, 18.0},
        .text = ifx which == LeftButton then "<" else ">", .size = 12,
        .align = .TextAlignCenter, .vertical_align = .TextAlignCenter})
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    now := Clock.Millis()
    elapsed := now - last_millis
    last_millis = now
    if elapsed < 0 { elapsed = 0 }
    if elapsed > 100 { elapsed = 100 }

    Input(session)
    replan := board.line_count != seen_lines
    seen_lines = board.line_count
    for at: 0..board.ball_count-1 {
        if lost[at] { continue }
        if !Advance(at, cast(float64)elapsed * board.balls[at].speed, replan) { lost[at] = true }
    }

    Box.Draw(session, .{.key = 1, .bounds = .{0.0, 0.0, cast(float32)Width, cast(float32)Height}, .fill = grey})
    pointer := PointerSample(session)
    DrawButton(session, LeftButton, pointer)
    DrawButton(session, RightButton, pointer)
    digits: [24]u8
    label: Vec(u8)
    defer VecFree(label)
    unused BuilderAppend(label, FormatInteger(cast(s64)board.ball_count, digits[:]))
    unused BuilderAppend(label, " balls")
    Text.Draw(session, .{.key = 2, .bounds = .{52.0, 0.0, 200.0, cast(float32)BarHeight},
        .text = TextView(label[:]), .size = 12, .vertical_align = .TextAlignCenter})

    Box.Draw(session, .{.key = 3, .bounds = .{0.0, cast(float32)BarHeight,
        cast(float32)(CanvasWidth + 4), cast(float32)(CanvasHeight + 4)}, .fill = light})
    Ridge(session, 4, 0.0, cast(float32)BarHeight,
        cast(float32)(CanvasWidth + 4), cast(float32)(CanvasHeight + 4))

    // The four edges sit on the canvas border as they did; the drawn lines show.
    for at: 4..board.line_count-1 {
        line := *board.lines[at]
        x1 := cast(float32)line.x1 + cast(float32)OriginX
        y1 := cast(float32)line.y1 + cast(float32)OriginY
        x2 := cast(float32)line.x2 + cast(float32)OriginX
        y2 := cast(float32)line.y2 + cast(float32)OriginY
        Shape.Draw(session, .{.key = cast(u64)(1000 + at * 2), .start = .{x1, y1}, .end = .{x2, y2},
            .thickness = LineThickness, .color = black})
    }

    // A tk oval: the colour inside a black rim.
    for at: 0..board.ball_count-1 {
        if lost[at] { continue }
        ball := *board.balls[at]
        x := cast(float32)(cast(s32)ball.x + OriginX) + 0.5
        y := cast(float32)(cast(s32)ball.y + OriginY) + 0.5
        Shape.Circle(session, .{.key = cast(u64)(200 + at * 2), .center = .{x, y}, .radius = 4.5, .fill = black})
        Shape.Circle(session, .{.key = cast(u64)(201 + at * 2), .center = .{x, y}, .radius = 3.5,
            .fill = .{cast(u8)((ball.color >> cast(u64)16) & cast(u32)255),
                cast(u8)((ball.color >> cast(u64)8) & cast(u32)255),
                cast(u8)(ball.color & cast(u32)255), 255}})
    }
}

Number :: (text: string) -> s32 {
    value: s32 = 0
    negative := text.count > 0 && text[0] == cast(u8)45
    for i: cast(s64)(ifx negative then 1 else 0)..text.count-1 {
        if text[i] < cast(u8)48 || text[i] > cast(u8)57 { break }
        value = value * 10 + cast(s32)(text[i] - cast(u8)48)
    }
    return ifx negative then -value else value
}

#program_export
main :: () -> s32 {
    count: s32 = 8
    if Args.OperandCount() > 0 { count = Number(Args.Operand(0)) }
    if count < 0 {
        unused IO.Write(2, "usage: bounce [nballs]\n")
        return 1
    }
    if count > Board.MaxBalls { count = Board.MaxBalls }
    Board.Edges(*board)
    seen_lines = board.line_count
    for at: 0..count-1 { NewBall() }
    last_millis = Clock.Millis()
    return Surface.Run(.{.title = "Bounce", .width = Width, .height = Height}, Draw, 15)
}
