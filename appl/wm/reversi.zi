// Port of Inferno's Reversi (appl/wm/reversi.b), built as reversi.zx. See ../../NOTICE.
// usage: wm/reversi [-a] [-p] [-s]
// -a makes both players machines, -p prints the starting colour and every move
// (m*10+n, or 0 for pass), -s drops pauses. The Black and White menus pick who
// plays, the level entries set the search depth (0..6), last move replays the
// most recent moves, and clicking a square places a disc.
Surface :: #import "kryon/host/surface";
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Shape :: #import "kryon/shape";
Text :: #import "kryon/text";
Field :: #import "kryon/text_field";
Rev :: #import "reversi_model";
Rand :: #import "inferno_rand";
IO :: #import "taijios_io";
Args :: #import "taijios_args";
Clock :: #import "taijios_clock";
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/key_input"
#import "kryon/session"
#import "kryon/text_align"
#import "kryon/tree"
#import "kryon/tree_input"
#import "std/vec"
#import "std/number_text"

Width :: 400
Height :: 478
BoardTop :: 78
CellW :: Width / Rev.SZB
CellH :: (Height - BoardTop) / Rev.SZB
PieceRadius :: 3 * CellW / 8
SliceSteps :: 2048

grey: Color = .{221, 221, 221, 255};
black: Color = .{0, 0, 0, 255};
white: Color = .{255, 255, 255, 255};
green: Color = .{0, 255, 0, 255};

random: Rand.Random;
game: Rev.Game;
display_brd: [Rev.SZF * Rev.SZF]s32;
moves: [Rev.MAXMOVES + 1]s32;
move_len: s32;
plays: s32;
bscore: s32;
wscore: s32;
bwins: s32;
wwins: s32;
turn: s32;
last_m1: s32 = 1;
last_m2: s32 = 1;
over: bool;
over_until: s64;
score_shown: bool;
pause_until: s64;
pending_m: s32 = -1;
pending_n: s32 = -1;
lasts: s32 = 1;
menu_open: s32 = -1;
auto: bool;
printout: bool;
nosleep: bool;
message: Vec(u8);

// Replay state for the "last move" button.
replaying: bool;
replay_game: Rev.Game;
replay_at: s32;
replay_me: s32;
replay_you: s32;
replay_next_ms: s64;

search: Rev.SearchState;
thinking: bool;

black_bytes: [16]u8;
black_level: Field.State;
white_bytes: [16]u8;
white_level: Field.State;

Now :: () -> s32 {
    bytes: [64]u8
    fd := IO.Open("/dev/time", 0)
    if fd < 0 { return 0 }
    count := IO.Read(fd, bytes[:])
    unused IO.Close(fd)
    value: s64 = 0
    for i: 0..count - 1 {
        if bytes[i] < cast(u8)48 || bytes[i] > cast(u8)57 { break }
        value = value * 10 + cast(s64)(bytes[i] - cast(u8)48)
    }
    return cast(s32)(value / 1000000)
}

Number :: (text: string) -> s32 {
    value: s32 = 0
    negative := text.count > 0 && text[0] == cast(u8)45
    for i: cast(s64)(ifx negative then 1 else 0)..text.count - 1 {
        if text[i] < cast(u8)48 || text[i] > cast(u8)57 { break }
        value = value * 10 + cast(s32)(text[i] - cast(u8)48)
    }
    return ifx negative then -value else value
}

Pause :: (millis: s64) -> s64 {
    return ifx nosleep then 0 else millis
}

SetMessage :: (text: string) {
    VecClear(message)
    unused BuilderAppend(message, text)
}

SyncDisplay :: (src: *Rev.Game) {
    for i: 0..Rev.SZF * Rev.SZF - 1 {
        display_brd[i] = src.brd[i]
    }
}

SetSkill :: (colour: s32, text: string) {
    level := Number(text)
    if level > Rev.MAXPLIES { level = Rev.MAXPLIES }
    if level >= 0 { game.skill[colour] = level }
}

SetField :: (state: *Field.State, text: string) {
    state.length = 0
    for i: cast(s64)0..text.count - 1 {
        state.bytes[state.length] = text[i]
        state.length += 1
    }
    state.cursor = state.length
    state.anchor = state.length
}

FormatScore :: (prefix: string, a: s32, mid: string, b: s32, suffix: string) {
    digits: [24]u8
    buf: Vec(u8)
    defer VecFree(buf)
    unused BuilderAppend(buf, prefix)
    unused BuilderAppend(buf, FormatInteger(cast(s64)a, digits[:]))
    unused BuilderAppend(buf, mid)
    unused BuilderAppend(buf, FormatInteger(cast(s64)b, digits[:]))
    unused BuilderAppend(buf, suffix)
    SetMessage(TextView(buf[:]))
}

PrintIntLine :: (v: s32) {
    digits: [24]u8
    line: Vec(u8)
    defer VecFree(line)
    unused BuilderAppend(line, FormatInteger(cast(s64)v, digits[:]))
    unused BuilderAppend(line, "\n")
    unused IO.Write(1, TextView(line[:]))
}

StartGame :: () {
    Rev.Reset(*game)
    SyncDisplay(*game)
    for i: 0..Rev.MAXMOVES { moves[i] = Rev.NOMOVE }
    move_len = 0
    first: s32 = ifx (plays % 2) != 0 then Rev.White else Rev.Black
    turn = first
    if printout { PrintIntLine(first) }
    moves[move_len] = first
    move_len += 1
    last_m1 = 1
    last_m2 = 1
    over = false
    score_shown = false
    thinking = false
    replaying = false
    lasts = 1
    SetMessage("")
}

BeginReplay :: (p_in: s32, now: s64) {
    if move_len <= 1 { return }
    k := move_len
    p := p_in
    if k - p < 1 { p = k - 1 }
    for i: k - p..k - 1 {
        if moves[i] == 0 { p += 1 }
    }
    if k - p < 1 { p = k - 1 }
    Rev.Init(*replay_game)
    Rev.Reset(*replay_game)
    n: s32 = 0
    me := moves[n]
    n += 1
    you := Rev.Black + Rev.White - me
    flips: Rev.FlipList
    while n < k - p {
        m := moves[n]
        n += 1
        if m != 0 {
            unused Rev.MakeMove(*replay_game, m / Rev.SZF, m % Rev.SZF, me, you, *flips)
        }
        tmp := me
        me = you
        you = tmp
    }
    SyncDisplay(*replay_game)
    replay_at = n
    replay_me = me
    replay_you = you
    replay_next_ms = now + Pause(1000)
    replaying = true
}

StepReplay :: (now: s64) {
    if now < replay_next_ms { return }
    if replay_at >= move_len {
        SyncDisplay(*game)
        replaying = false
        return
    }
    m := moves[replay_at]
    replay_at += 1
    flips: Rev.FlipList
    if m != 0 {
        unused Rev.MakeMove(*replay_game, m / Rev.SZF, m % Rev.SZF, replay_me, replay_you, *flips)
        SyncDisplay(*replay_game)
    }
    tmp := replay_me
    replay_me = replay_you
    replay_you = tmp
    if replay_at < move_len {
        replay_next_ms = now + Pause(500)
    } else {
        SyncDisplay(*game)
        replaying = false
    }
}

FinishGame :: (now: s64) {
    b := game.pieces[Rev.Black]
    w := game.pieces[Rev.White]
    bscore += b
    wscore += w
    if b > w { bwins += 1 }
    else if b < w { wwins += 1 }
    plays += 1
    if auto {
        digits: [24]u8
        buf: Vec(u8)
        defer VecFree(buf)
        unused BuilderAppend(buf, "score: ")
        unused BuilderAppend(buf, FormatInteger(cast(s64)b, digits[:]))
        unused BuilderAppend(buf, "-")
        unused BuilderAppend(buf, FormatInteger(cast(s64)w, digits[:]))
        unused BuilderAppend(buf, "\n")
        unused IO.Write(1, TextView(buf[:]))
    }
    FormatScore("black ", b, ":", w, " white")
    over = true
    score_shown = false
    over_until = now + Pause(2000)
}

RecordMove :: (m: s32, now: s64) {
    if printout { PrintIntLine(m) }
    if move_len <= Rev.MAXMOVES {
        moves[move_len] = m
        move_len += 1
    }
    last_m2 = last_m1
    last_m1 = m
    SyncDisplay(*game)
    if game.pieces[Rev.Black] + game.pieces[Rev.White] == Rev.PIECES || (last_m1 == 0 && last_m2 == 0) {
        FinishGame(now)
        return
    }
    turn = 1 - turn
}

Step :: (now: s64) {
    if replaying {
        StepReplay(now)
        return
    }
    if over {
        if now < over_until { return }
        if !score_shown {
            score_shown = true
            FormatScore("black ", bwins, ":", wwins, " white")
            over_until = now + Pause(2000)
            return
        }
        StartGame()
        return
    }
    if now < pause_until { return }

    mover := turn
    other := 1 - turn
    if game.kind[mover] == Rev.Machine {
        if !thinking {
            thinking = true
            SetMessage(ifx mover == Rev.Black then "machine black move" else "machine white move")
            Rev.SearchBegin(*game, *search, mover, other, *random)
        }
        if Rev.SearchSlice(*game, *search, *random, SliceSteps) {
            thinking = false
            m := Rev.SearchFinish(*game, *search, mover, other)
            if m == 0 {
                SetMessage(ifx mover == Rev.Black then "machine black cannot go" else "machine white cannot go")
                pause_until = now + Pause(2000)
            } else {
                pause_until = now + Pause(300)
            }
            RecordMove(m, now)
        }
        return
    }

    // Human turn: check if any legal move exists.
    legal: [32]Rev.Coord
    if Rev.FindMoves(*game, mover, other, legal[:]) == 0 {
        SetMessage(ifx mover == Rev.Black then "human black cannot go" else "human white cannot go")
        pause_until = now + Pause(2000)
        RecordMove(0, now)
        return
    }
    if pending_m < 0 {
        SetMessage(ifx mover == Rev.Black then "human black move" else "human white move")
        return
    }
    cm := pending_m
    cn := pending_n
    pending_m = -1
    pending_n = -1
    flips: Rev.FlipList
    if !Rev.MakeMove(*game, cm, cn, mover, other, *flips) {
        SetMessage("illegal move")
        pause_until = now + Pause(2000)
        return
    }
    RecordMove(cm * Rev.SZF + cn, now)
}

Input :: (session: Session) {
    pointer := PointerSample(session)
    secondary := SecondaryPointerSample(session)
    tertiary := TertiaryPointerSample(session)
    if (pointer.pressed || secondary.pressed || tertiary.pressed) &&
        pointer.y >= cast(float32)BoardTop && pointer.y < cast(float32)(BoardTop + CellH * Rev.SZB) {
        m := cast(s32)pointer.x / CellW + 1
        n := (cast(s32)pointer.y - BoardTop) / CellH + 1
        if m >= 1 && m <= Rev.SZB && n >= 1 && n <= Rev.SZB {
            pending_m = m
            pending_n = n
            lasts = 1
        }
    }
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    now := Clock.Millis()
    Input(session)

    typed: [64]u8
    text := TypedTextTake(session, typed[:])
    key := KeyboardTake(session)
    mods := KeyboardModifiers(session)
    input := TextFieldInputFor(key, mods, text)

    Step(now)

    Box.Draw(session, .{.key = 1, .bounds = .{0.0, 0.0, cast(float32)Width, cast(float32)Height}, .fill = grey})
    if Button.Draw(session, .{.key = 10, .bounds = .{2.0, 3.0, 60.0, 20.0}, .label = "Black"}) > 0 {
        menu_open = ifx menu_open == 0 then -1 else 0
    }
    if Button.Draw(session, .{.key = 12, .bounds = .{150.0, 3.0, 100.0, 20.0}, .label = "last move"}) > 0 {
        if !over && !thinking {
            BeginReplay(lasts, now)
            lasts += 1
        }
    }
    if Button.Draw(session, .{.key = 11, .bounds = .{338.0, 3.0, 60.0, 20.0}, .label = "White"}) > 0 {
        menu_open = ifx menu_open == 1 then -1 else 1
    }
    if menu_open >= 0 {
        left := ifx menu_open == 0 then 2 else 338
        if Button.Draw(session, .{.key = 40, .bounds = .{cast(float32)left, 25.0, 60.0, 20.0}, .label = "Human"}) > 0 {
            game.kind[menu_open] = Rev.Human
            menu_open = -1
        }
        if Button.Draw(session, .{.key = 41, .bounds = .{cast(float32)left, 47.0, 60.0, 20.0}, .label = "Machine"}) > 0 {
            game.kind[menu_open] = Rev.Machine
            menu_open = -1
        }
    }

    Text.Draw(session, .{.key = 50, .bounds = .{2.0, 28.0, 84.0, 20.0}, .text = "Black level", .size = 12})
    black_edit := Field.Draw(session, Field.StateProps(black_level, .{.key = 20, .focus_id = 20,
        .bounds = .{88.0, 26.0, 64.0, 22.0}, .max_bytes = 15, .input = input}))
    unused Field.StateApplyResult(*black_level, black_edit)
    if black_edit.committed { SetSkill(Rev.Black, TextView(black_bytes[:black_level.length])) }
    Text.Draw(session, .{.key = 51, .bounds = .{196.0, 28.0, 84.0, 20.0}, .text = "White level", .size = 12})
    white_edit := Field.Draw(session, Field.StateProps(white_level, .{.key = 22, .focus_id = 22,
        .bounds = .{282.0, 26.0, 64.0, 22.0}, .max_bytes = 15, .input = input}))
    unused Field.StateApplyResult(*white_level, white_edit)
    if white_edit.committed { SetSkill(Rev.White, TextView(white_bytes[:white_level.length])) }

    if message.count > 0 {
        Text.Draw(session, .{.key = 30, .bounds = .{2.0, 52.0, 396.0, 24.0},
            .text = TextView(message[:]), .size = 12})
    }

    // 8x8 green Reversi board with black grid lines and black/white discs.
    Box.Draw(session, .{.key = 2, .bounds = .{0.0, cast(float32)BoardTop,
        cast(float32)Width, cast(float32)(Height - BoardTop)}, .fill = green})
    for i: 1..Rev.SZB - 1 {
        x := cast(float32)(i * CellW)
        Shape.Draw(session, .{.key = cast(u64)(60 + i), .start = .{x, cast(float32)BoardTop},
            .end = .{x, cast(float32)(BoardTop + CellH * Rev.SZB)}, .thickness = 1.0, .color = black})
    }
    for j: 1..Rev.SZB - 1 {
        y := cast(float32)(BoardTop + j * CellH)
        Shape.Draw(session, .{.key = cast(u64)(70 + j), .start = .{0.0, y},
            .end = .{cast(float32)(CellW * Rev.SZB), y}, .thickness = 1.0, .color = black})
    }
    for m: 1..Rev.SZB {
        for n: 1..Rev.SZB {
            piece := display_brd[Rev.Cell(cast(s32)m, cast(s32)n)]
            if piece != Rev.Black && piece != Rev.White { continue }
            cx := cast(float32)((m - 1) * CellW + CellW / 2)
            cy := cast(float32)(BoardTop + (n - 1) * CellH + CellH / 2)
            Shape.Circle(session, .{.key = cast(u64)(100 + m * Rev.SZF + n),
                .center = .{cx, cy}, .radius = cast(float32)PieceRadius,
                .fill = ifx piece == Rev.Black then black else white})
        }
    }
}

#program_export
main :: () -> s32 {
    Rev.Init(*game)
    for at: 0..Args.OperandCount() - 1 {
        word := Args.Operand(at)
        if word.count > 0 && word[0] == cast(u8)45 {
            for i: cast(s64)1..word.count - 1 {
                if word[i] == cast(u8)97 { auto = true }
                else if word[i] == cast(u8)112 { printout = true }
                else if word[i] == cast(u8)115 { nosleep = true }
            }
        }
    }
    if auto { game.kind[Rev.White] = Rev.Machine }
    Rand.Seed(*random, Now())
    black_level.bytes = black_bytes[:]
    white_level.bytes = white_bytes[:]
    digits: [24]u8
    SetField(*black_level, FormatInteger(cast(s64)game.skill[Rev.Black], digits[:]))
    SetField(*white_level, FormatInteger(cast(s64)game.skill[Rev.White], digits[:]))
    StartGame()
    rc := Surface.Run(.{.title = "Reversi", .width = Width, .height = Height}, Draw, 20)
    VecFree(message)
    return rc
}
