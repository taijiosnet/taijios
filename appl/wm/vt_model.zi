// VT100/ANSI escape parser, 16-color cell grid, scroll regions, SGR attributes,
// save/restore state, and resize rules of Inferno's WmVt (appl/wm/vt.b).
// See ../../NOTICE.
#import "std/vec"
#import "std/number_text"

VtMaxParam :: 8
MaxCols :: 160
MaxRows :: 64

Vt :: struct {
    y1: s32
    y2: s32
    mode: s32
    qmode: s32
    attr: s32
    fg: s32
    bg: s32

    save_x: s32
    save_y: s32
    save_attr: s32
    save_fg: s32
    save_bg: s32
    save_mode: s32
    save_qmode: s32

    esc: s32
    pcount: s32
    etype: s32
    ptype: s32
    value: s32
    param: [VtMaxParam]s32

    wid: s32
    hgt: s32
    x: s32
    y: s32
    dx: s32
    dy: s32
    nlcr: bool
    ccc: u8
    beeped: s32

    scr: [MaxRows * MaxCols]u8
    cc: [MaxRows * MaxCols]u8
}

CellIdx :: (row: s32, col: s32) -> s64 {
    return cast(s64)row * cast(s64)MaxCols + cast(s64)col
}

SetColor :: (vt: *Vt) {
    c: s32 = 0
    if (vt.attr & 128) != 0 {
        c = ((vt.fg & 15) << 4) | (vt.bg & 15)
    } else {
        c = ((vt.bg & 15) << 4) | (vt.fg & 15)
    }
    if (vt.attr & 2) != 0 {
        c = c ^ 8
    }
    vt.ccc = cast(u8)(c & 255)
}

SaveState :: (vt: *Vt) {
    vt.save_x = vt.x
    vt.save_y = vt.y
    vt.save_attr = vt.attr
    vt.save_fg = vt.fg
    vt.save_bg = vt.bg
    vt.save_mode = vt.mode
    vt.save_qmode = vt.qmode
}

RestoreState :: (vt: *Vt) {
    vt.x = vt.save_x
    vt.y = vt.save_y
    vt.attr = vt.save_attr
    vt.fg = vt.save_fg
    vt.bg = vt.save_bg
    vt.mode = vt.save_mode
    vt.qmode = vt.save_qmode
    SetColor(vt)
}

ClearRect :: (vt: *Vt, x1: s32, y1: s32, x2: s32, y2: s32) {
    if y1 < 0 { y1 = 0 }
    if y2 >= vt.hgt { y2 = vt.hgt - 1 }
    if x1 < 0 { x1 = 0 }
    if x2 >= vt.wid { x2 = vt.wid - 1 }
    if y1 > y2 || x1 > x2 { return }
    for r: y1..y2 {
        for c: x1..x2 {
            idx := CellIdx(r, c)
            vt.scr[idx] = cast(u8)32
            vt.cc[idx] = vt.ccc
        }
    }
}

Init :: (vt: *Vt, wid: s32, hgt: s32) {
    if wid < 1 { wid = 80 }
    if wid > MaxCols { wid = MaxCols }
    if hgt < 1 { hgt = 24 }
    if hgt > MaxRows { hgt = MaxRows }
    vt.wid = wid
    vt.hgt = hgt
    vt.fg = 7
    vt.bg = 0
    vt.attr = 0
    vt.mode = 0
    vt.qmode = 128 // autowrap (1<<7)
    vt.y1 = 0
    vt.y2 = hgt - 1
    vt.x = 0
    vt.y = 0
    vt.dx = 1
    vt.dy = 1
    vt.nlcr = true
    vt.esc = 0
    vt.pcount = 0
    vt.etype = 0
    vt.ptype = 1
    vt.value = 0
    vt.beeped = 0
    for i: 0..VtMaxParam - 1 { vt.param[i] = 0 }
    SetColor(vt)
    SaveState(vt)
    ClearRect(vt, 0, 0, wid - 1, hgt - 1)
}

Resize :: (vt: *Vt, wid: s32, hgt: s32) {
    if wid < 1 { wid = 1 }
    if wid > MaxCols { wid = MaxCols }
    if hgt < 1 { hgt = 1 }
    if hgt > MaxRows { hgt = MaxRows }
    if wid == vt.wid && hgt == vt.hgt { return }

    old_scr: Vec(u8)
    old_cc: Vec(u8)
    defer VecFree(old_scr)
    defer VecFree(old_cc)
    unused VecResize(old_scr, cast(s64)vt.hgt * cast(s64)MaxCols)
    unused VecResize(old_cc, cast(s64)vt.hgt * cast(s64)MaxCols)
    for i: cast(s64)0..old_scr.count - 1 {
        old_scr[i] = vt.scr[i]
        old_cc[i] = vt.cc[i]
    }
    old_h := vt.hgt
    old_w := vt.wid
    vt.wid = wid
    vt.hgt = hgt
    vt.y1 = 0
    vt.y2 = hgt - 1
    ClearRect(vt, 0, 0, wid - 1, hgt - 1)

    for y: 0..hgt - 1 {
        oy := y + old_h - hgt
        if oy >= 0 && oy < old_h {
            copy_w := ifx old_w < wid then old_w else wid
            for x: 0..copy_w - 1 {
                vt.scr[CellIdx(y, x)] = old_scr[CellIdx(oy, x)]
                vt.cc[CellIdx(y, x)] = old_cc[CellIdx(oy, x)]
            }
        }
    }
    vt.y += hgt - old_h
    if vt.x < 0 { vt.x = 0 }
    if vt.x >= wid { vt.x = wid - 1 }
    if vt.y < 0 { vt.y = 0 }
    if vt.y >= hgt { vt.y = hgt - 1 }
}

ScrollUp :: (vt: *Vt, x1: s32, y1: s32, x2: s32, y2: s32, n: s32) {
    if n <= 0 { return }
    if y1 < 0 { y1 = 0 }
    if y2 >= vt.hgt { y2 = vt.hgt - 1 }
    if n > y2 - y1 + 1 { n = y2 - y1 + 1 }
    for r: y1..y2 - n {
        for c: x1..x2 {
            vt.scr[CellIdx(r, c)] = vt.scr[CellIdx(r + n, c)]
            vt.cc[CellIdx(r, c)] = vt.cc[CellIdx(r + n, c)]
        }
    }
    ClearRect(vt, x1, y2 - n + 1, x2, y2)
}

ScrollDown :: (vt: *Vt, x1: s32, y1: s32, x2: s32, y2: s32, n: s32) {
    if n <= 0 { return }
    if y1 < 0 { y1 = 0 }
    if y2 >= vt.hgt { y2 = vt.hgt - 1 }
    if n > y2 - y1 + 1 { n = y2 - y1 + 1 }
    r := y2
    while r >= y1 + n {
        for c: x1..x2 {
            vt.scr[CellIdx(r, c)] = vt.scr[CellIdx(r - n, c)]
            vt.cc[CellIdx(r, c)] = vt.cc[CellIdx(r - n, c)]
        }
        r -= 1
    }
    ClearRect(vt, x1, y1, x2, y1 + n - 1)
}

ScrollLeft :: (vt: *Vt, x1: s32, y1: s32, x2: s32, y2: s32, n: s32) {
    if n <= 0 { return }
    for r: y1..y2 {
        for c: x1..x2 {
            if c + n <= x2 {
                vt.scr[CellIdx(r, c)] = vt.scr[CellIdx(r, c + n)]
                vt.cc[CellIdx(r, c)] = vt.cc[CellIdx(r, c + n)]
            } else {
                vt.scr[CellIdx(r, c)] = cast(u8)32
                vt.cc[CellIdx(r, c)] = vt.ccc
            }
        }
    }
}

ScrollRight :: (vt: *Vt, x1: s32, y1: s32, x2: s32, y2: s32, n: s32) {
    if n <= 0 { return }
    for r: y1..y2 {
        c := x2
        while c >= x1 {
            if c - n >= x1 {
                vt.scr[CellIdx(r, c)] = vt.scr[CellIdx(r, c - n)]
                vt.cc[CellIdx(r, c)] = vt.cc[CellIdx(r, c - n)]
            } else {
                vt.scr[CellIdx(r, c)] = cast(u8)32
                vt.cc[CellIdx(r, c)] = vt.ccc
            }
            c -= 1
        }
    }
}

Param :: (vt: *Vt, n: s32, def: s32, lo: s32, hi: s32) -> s32 {
    p := vt.param[n]
    if p == 0 { p = def }
    if p < lo { p = lo }
    if p > hi { p = hi }
    return p
}

CheckScroll :: (vt: *Vt) {
    if vt.y == vt.y2 + 1 || vt.y >= vt.hgt {
        vt.y = vt.y2
        ScrollUp(vt, 0, vt.y1, vt.wid - 1, vt.y2, 1)
    } else if vt.y == vt.y1 - 1 {
        vt.y = vt.y1
        ScrollDown(vt, 0, vt.y1, vt.wid - 1, vt.y2, 1)
    } else if vt.y < 0 {
        vt.y = 0
    }
}

CallNcsi :: (vt: *Vt, ch: u8) -> bool {
    if ch == cast(u8)69 { vt.x = 0; vt.y += 1; return true } // 'E'
    if ch == cast(u8)68 { vt.y += 1; return true } // 'D'
    if ch == cast(u8)77 { vt.y -= 1; return true } // 'M'
    if ch == cast(u8)55 { SaveState(vt); return false } // '7'
    if ch == cast(u8)56 { RestoreState(vt); return false } // '8'
    return false
}

CallCsi :: (vt: *Vt, ch: u8, reply: *Vec(u8)) {
    if ch == cast(u8)65 { vt.y -= Param(vt, 0, 1, 1, vt.hgt) } // 'A'
    else if ch == cast(u8)66 { vt.y += Param(vt, 0, 1, 1, vt.hgt) } // 'B'
    else if ch == cast(u8)67 { vt.x += Param(vt, 0, 1, 1, vt.wid) } // 'C'
    else if ch == cast(u8)68 { vt.x -= Param(vt, 0, 1, 1, vt.wid) } // 'D'
    else if ch == cast(u8)72 || ch == cast(u8)102 { // 'H' or 'f'
        vt.y = Param(vt, 0, 1, 1, vt.hgt) - 1
        vt.x = Param(vt, 1, 1, 1, vt.wid) - 1
        vt.qmode = vt.qmode & (~32768)
    } else if ch == cast(u8)74 { // 'J'
        p := vt.param[0]
        if p == 0 {
            ClearRect(vt, vt.x, vt.y, vt.wid - 1, vt.y)
            ClearRect(vt, 0, vt.y + 1, vt.wid - 1, vt.y2)
        } else if p == 1 {
            ClearRect(vt, 0, 0, vt.wid - 1, vt.y - 1)
            ClearRect(vt, 0, vt.y, vt.x, vt.y)
        } else if p == 2 {
            ClearRect(vt, 0, vt.y1, vt.wid - 1, vt.y2)
        }
    } else if ch == cast(u8)75 { // 'K'
        p := vt.param[0]
        if p == 0 { ClearRect(vt, vt.x, vt.y, vt.wid - 1, vt.y) }
        else if p == 1 { ClearRect(vt, 0, vt.y, vt.x, vt.y) }
        else if p == 2 { ClearRect(vt, 0, vt.y, vt.wid - 1, vt.y) }
    } else if ch == cast(u8)76 { // 'L'
        ScrollDown(vt, 0, vt.y, vt.wid - 1, vt.y2, Param(vt, 0, 1, 1, vt.hgt))
    } else if ch == cast(u8)77 { // 'M'
        ScrollUp(vt, 0, vt.y, vt.wid - 1, vt.y2, Param(vt, 0, 1, 1, vt.hgt))
    } else if ch == cast(u8)64 { // '@'
        ScrollRight(vt, vt.x, vt.y, vt.wid - 1, vt.y, Param(vt, 0, 1, 1, vt.wid - vt.x))
    } else if ch == cast(u8)80 { // 'P'
        ScrollLeft(vt, vt.x, vt.y, vt.wid - 1, vt.y, Param(vt, 0, 1, 1, vt.wid - vt.x))
    } else if ch == cast(u8)88 { // 'X'
        n := Param(vt, 0, 1, 1, vt.wid - vt.x)
        ClearRect(vt, vt.x, vt.y, vt.x + n - 1, vt.y)
    } else if ch == cast(u8)109 { // 'm'
        if vt.pcount == 0 { vt.pcount = 1 }
        for i: 0..vt.pcount - 1 {
            n := vt.param[i]
            if n == 0 {
                vt.attr = 0; vt.fg = 7; vt.bg = 0
            } else if n > 0 && n < 16 {
                vt.attr = vt.attr | (cast(s32)1 << cast(s32)n)
            } else if n >= 20 && n < 28 {
                vt.attr = vt.attr & (~(cast(s32)1 << cast(s32)(n - 20)))
            } else if n >= 30 && n < 38 {
                vt.fg = n - 30
            } else if n >= 40 && n < 48 {
                vt.bg = n - 40
            } else if n >= 50 && n < 58 {
                vt.fg = n - 50 + 8
            } else if n >= 60 && n < 68 {
                vt.bg = n - 60 + 8
            }
        }
        SetColor(vt)
    } else if ch == cast(u8)99 { // 'c'
        if vt.wid >= 132 { unused BuilderAppend(reply.*, "\x1b[?61;1;6c") }
        else { unused BuilderAppend(reply.*, "\x1b[?61;6c") }
    } else if ch == cast(u8)110 { // 'n'
        n := Param(vt, 0, 0, 0, 9)
        if n == 5 { unused BuilderAppend(reply.*, "\x1b[0n") }
        if n == 5 || n == 6 {
            d1: [16]u8
            d2: [16]u8
            unused BuilderAppend(reply.*, "\x1b[")
            unused BuilderAppend(reply.*, FormatInteger(cast(s64)(vt.y + 1), d1[:]))
            unused BuilderAppend(reply.*, ";")
            unused BuilderAppend(reply.*, FormatInteger(cast(s64)(vt.x + 1), d2[:]))
            unused BuilderAppend(reply.*, "R")
        }
    } else if ch == cast(u8)114 { // 'r'
        vt.y1 = Param(vt, 0, 1, 1, vt.hgt) - 1
        vt.y2 = Param(vt, 1, vt.hgt, 1, vt.hgt) - 1
        if vt.y1 > vt.y2 { vt.y1 = 0; vt.y2 = vt.hgt - 1 }
    } else if ch == cast(u8)115 { SaveState(vt) } // 's'
    else if ch == cast(u8)117 { RestoreState(vt) } // 'u'
    else if ch == cast(u8)104 { // 'h'
        for i: 0..vt.pcount - 1 {
            n := vt.param[i]
            if n >= 0 && n < 30 { vt.mode = vt.mode | (cast(s32)1 << cast(s32)n) }
            else if n < 0 && -n < 30 { vt.qmode = vt.qmode | (cast(s32)1 << cast(s32)(-n)) }
        }
    } else if ch == cast(u8)108 { // 'l'
        for i: 0..vt.pcount - 1 {
            n := vt.param[i]
            if n >= 0 && n < 30 { vt.mode = vt.mode & (~(cast(s32)1 << cast(s32)n)) }
            else if n < 0 && -n < 30 { vt.qmode = vt.qmode & (~(cast(s32)1 << cast(s32)(-n))) }
        }
    }
    if vt.y < 0 { vt.y = 0 }
    if vt.y >= vt.hgt { vt.y = vt.hgt - 1 }
    if vt.x < 0 { vt.x = 0 }
    if vt.x >= vt.wid { vt.x = vt.wid - 1 }
}

Write :: (vt: *Vt, data: string, reply: *Vec(u8)) {
    for i: cast(s64)0..data.count - 1 {
        ch := data[i]
        check_scroll := false
        if vt.esc == 1 {
            if ch == cast(u8)91 { // '['
                vt.etype = 91
                vt.esc = 2
                vt.value = 0
                vt.pcount = 0
                vt.ptype = 1
                for k: 0..VtMaxParam - 1 { vt.param[k] = 0 }
            } else {
                check_scroll = CallNcsi(vt, ch)
                vt.esc = 0
            }
        } else if vt.esc == 2 {
            if ch >= cast(u8)48 && ch <= cast(u8)57 {
                vt.value = vt.value * 10 + cast(s32)(ch - cast(u8)48)
            } else if ch == cast(u8)63 { // '?'
                vt.ptype = -1
            } else {
                if vt.pcount < VtMaxParam {
                    vt.param[vt.pcount] = vt.value * vt.ptype
                    vt.pcount += 1
                }
                if ch == cast(u8)59 { // ';'
                    if vt.pcount >= VtMaxParam { vt.pcount = VtMaxParam - 1 }
                    vt.value = 0
                } else {
                    CallCsi(vt, ch, reply)
                    vt.esc = 0
                }
            }
        } else {
            if ch == cast(u8)10 { // '\n'
                vt.y += vt.dy
                check_scroll = true
                if vt.nlcr { vt.x = 0 }
                vt.qmode = vt.qmode & (~32768)
            } else if ch == cast(u8)13 { // '\r'
                vt.x = 0
                vt.qmode = vt.qmode & (~32768)
            } else if ch == cast(u8)8 { // '\b'
                if vt.x > 0 { vt.x -= vt.dx }
                vt.qmode = vt.qmode & (~32768)
            } else if ch == cast(u8)9 { // '\t'
                n := (vt.x & (~7)) + 8
                if (vt.mode & 16) != 0 {
                    ScrollRight(vt, vt.x, vt.y, vt.wid - 1, vt.y, n - vt.x)
                }
                vt.x = n
                if vt.x >= vt.wid {
                    vt.x = 0
                    vt.y += 1
                    check_scroll = true
                }
            } else if ch == cast(u8)7 { // BEL
                vt.beeped += 1
            } else if ch == cast(u8)11 { // VT
                vt.x = 0
                vt.y = vt.y1
            } else if ch == cast(u8)12 { // FF
                ClearRect(vt, 0, vt.y1, vt.wid - 1, vt.y2)
            } else if ch == cast(u8)27 { // ESC
                vt.esc = 1
            } else if ch == cast(u8)133 { // NEL
                vt.x = 0; vt.y += 1; check_scroll = true
            } else if ch == cast(u8)132 { // IND
                vt.y += 1; check_scroll = true
            } else if ch == cast(u8)141 { // RI
                vt.y -= 1; check_scroll = true
            } else if ch == cast(u8)147 { // 8-bit CSI
                vt.etype = 91; vt.esc = 2; vt.value = 0; vt.pcount = 0; vt.ptype = 1
                for k: 0..VtMaxParam - 1 { vt.param[k] = 0 }
            } else if ch >= cast(u8)32 && ch <= cast(u8)126 {
                if (vt.mode & 16) != 0 {
                    ScrollRight(vt, vt.x, vt.y, vt.wid - 1, vt.y, 1)
                }
                if (vt.qmode & 32768) != 0 {
                    if vt.x >= vt.wid - 1 && (vt.qmode & 128) != 0 {
                        vt.x = 0
                        vt.y += vt.dy
                        CheckScroll(vt)
                    }
                    vt.qmode = vt.qmode & (~32768)
                }
                idx := CellIdx(vt.y, vt.x)
                vt.scr[idx] = ch
                vt.cc[idx] = vt.ccc
                vt.x += vt.dx
                if vt.x >= vt.wid {
                    vt.x = vt.wid - 1
                    vt.qmode = vt.qmode | 32768
                }
            }
        }
        if check_scroll { CheckScroll(vt) }
        if vt.x < 0 { vt.x = 0 } else if vt.x >= vt.wid { vt.x = vt.wid - 1 }
        if vt.y < 0 { vt.y = 0 } else if vt.y >= vt.hgt { vt.y = vt.hgt - 1 }
    }
}

RowText :: (vt: *Vt, row: s32, out: *Vec(u8)) {
    VecClear(out.*)
    if row < 0 || row >= vt.hgt { return }
    end := vt.wid
    while end > 0 && vt.scr[CellIdx(row, end - 1)] == cast(u8)32 { end -= 1 }
    for c: 0..end - 1 { unused VecPush(out.*, vt.scr[CellIdx(row, c)]) }
}
