#import "std/vec";
Args :: #import "taijios_args";
Process :: #import "taijios_process";
Link :: #import "taijios_native_wm";
Surface :: #import "zx_surface";
Draw :: #import "guest_draw";
Compositor :: #import "compositor";
Input :: #import "guest_input";
Windows :: #import "desktop_windows";
Titlebar :: #import "native_titlebar";
TitlePolicy :: #import "kryon/window_chrome";

#program_export
main :: () -> s32 {
    // Without operands this is the session: open the installed desktop.
    count := Args.OperandCount();
    desktop := count == 0 || Args.Operand(0) == "--desktop";
    if desktop && count == 1 { return Fail("supply a guest ZX desktop path") }
    shell := DefaultDesktop;
    if count >= 2 { shell = Args.Operand(1) }
    manager: Manager;
    manager.windows = Windows.New(desktop, desktop);
    if !Draw.Open(*manager.display) { return Fail("open Draw") }
    defer Draw.Close(*manager.display);
    manager.bounds = Draw.Screen(*manager.display).bounds;
    if desktop { Titlebar.LoadAtlas(*manager.title_painter, *manager.display) }
    manager.background = Draw.Solid(*manager.display, 0x183858ff);
    if !Paint(*manager) { return Fail("paint desktop") }
    input := Input.OpenPoll();
    if input < 0 { return Fail("open input") }
    defer Input.Close(input);

    noargs: [0]string;
    first: s32 = 0;
    if desktop {
        manager.shell = Link.StartDesktop(shell, noargs[:]);
        if manager.shell <= 0 {
            return Fail(ifx count == 0 then "the Rill desktop is not installed at /dis/wm/rill.zx" else "start desktop");
        }
        if !VecPush(manager.apps, Application.{id = manager.shell}) { return Fail("start desktop") }
        first = 2;
    }
    for i: first .. count - 1 {
        path := Args.Operand(i);
        id := Link.StartWindow(path, noargs[:]);
        if id <= 0 || !VecPush(manager.apps, Application.{id = id, app_id = AppID(path)}) { return Fail("start application") }
    }
    return Run(*manager, input);
}

#scope_file

DefaultDesktop :: "/dis/wm/rill.zx";

Application :: struct {
    id: s32;
    bounds: Draw.Rect;
    image: Draw.Image;
    pending: Draw.Image;
    title: string;
    app_id: string;
    normal: Draw.Rect;
    cursor: [272]u8;
    cursor_size: s64;
    caption: Titlebar.Caption;
    click: TitlePolicy.State;
    maximized: bool;
    open: bool;
    closing: bool; // The manager closed this window; its exit is not a failure.
}

Manager :: struct {
    display: Draw.Display;
    background: Draw.Image;
    sample: Draw.Image;
    bounds: Draw.Rect;
    windows: Windows.State;
    apps: Vec(Application);
    shell: s32;
    chrome: [8]Draw.Rect;
    chrome_count: s64;
    title_painter: Titlebar.Painter;
    title_target: s32;
    title_press: TitlePolicy.Action;
    title_origin: Draw.Rect;
    title_x: s32;
    title_y: s32;
    title_moved: bool;
    generation: s32;
    buttons: s32;
    pointer_tick: u32;
    pointer_epoch: s64;
    pointer_x: s32;
    pointer_y: s32;
    pointer_known: bool;
    cursor_target: s32;
    sample_owner: s32;
    sample_x: s32;
    sample_y: s32;
    sample_release: bool;
    dirty: bool;
}

Fail :: (message: string) -> s32 {
    unused Args.SetFailure(message);
    return 1;
}

AppID :: (path: string) -> string {
    first: s64 = 0;
    end := path.count;
    for i: 0 .. path.count - 1 {
        if path[i] == 0 { end = i; break }
        if path[i] == #char "/" { first = i + 1 }
    }
    if end - first > 3 && path[end - 3:end] == ".zx" { end -= 3 }
    if end - first > 512 { return "" }
    return path[first:end];
}

ChromeLayers :: (manager: *Manager, layers: []Compositor.Layer) -> s64 {
    index := Find(manager, manager.shell);
    if index < 0 || !manager.apps[index].open { return 0 }
    image := manager.apps[index].image;
    for i: 0 .. manager.chrome_count - 1 {
        region := manager.chrome[i];
        layers[i] = .{image, region, manager.bounds.left + region.left, manager.bounds.top + region.top};
    }
    return manager.chrome_count;
}

FrameArea :: (manager: *Manager) -> Draw.Rect {
    chrome: [8]Compositor.Layer;
    count := ChromeLayers(manager, chrome[:]);
    return Windows.WorkArea(manager.bounds, chrome[:count]);
}

TitleHeight :: (manager: *Manager, area: Draw.Rect) -> s32 {
    return ifx manager.shell != 0 && area.bottom - area.top > Titlebar.Height then Titlebar.Height else 0;
}

WorkArea :: (manager: *Manager) -> Draw.Rect {
    area := FrameArea(manager);
    area.top += TitleHeight(manager, area);
    return area;
}

DesktopChanged :: (manager: *Manager) {
    manager.generation += 1;
    manager.dirty = true;
}

ApplyCursor :: (manager: *Manager, id: s32) -> bool {
    index := Find(manager, id);
    if index >= 0 && manager.apps[index].open {
        app := *manager.apps[index];
        return Link.ApplyCursor(app.cursor[:app.cursor_size]);
    }
    empty: [0]u8;
    return Link.ApplyCursor(empty[:]);
}

SetCursor :: (manager: *Manager, app: *Application, size: s32) -> bool {
    if size < 0 || size > app.cursor.count { return false }
    if size != 0 && Link.Payload(app.id, 0, app.cursor[:size]) != size { return false }
    app.cursor_size = size;
    return app.id != manager.cursor_target || ApplyCursor(manager, app.id);
}

RefreshCursor :: (manager: *Manager, chrome: []Compositor.Layer) {
    if !manager.pointer_known { return }
    hover := Windows.Hit(*manager.windows, chrome, manager.pointer_x, manager.pointer_y);
    if hover == Windows.Desktop { hover = manager.shell }
    index := Find(manager, hover);
    if index >= 0 && InTitle(manager, *manager.apps[index], manager.pointer_x, manager.pointer_y) { hover = 0 }
    if hover != manager.cursor_target {
        manager.cursor_target = hover;
        unused ApplyCursor(manager, hover);
    }
}

SamplePointer :: (manager: *Manager, id: s32) -> s32 {
    if id != manager.sample_owner { return -1 }
    if manager.sample_release { manager.sample_owner = 0 }
    for i: 0 .. manager.windows.windows.count - 1 {
        window := Windows.At(*manager.windows, i);
        if window.id != id || window.workspace != manager.windows.workspace || window.minimized { continue }
        if manager.sample.id == 0 { manager.sample = Draw.Buffer(*manager.display, .{0, 0, 1, 1}, 0x000000ff) }
        return Draw.ScreenRGB(*manager.display, manager.sample, manager.sample_x, manager.sample_y);
    }
    return -1;
}

Capture :: (manager: *Manager, id: s32) -> bool {
    if id != manager.shell { return false }
    area := manager.bounds;
    focus := manager.windows.keyboard_focus;
    fields: [7]s32 = .{manager.generation, 0, ifx focus > 0 then focus else 0,
        area.right - area.left, area.bottom - area.top, manager.windows.workspace_count, manager.windows.workspace};
    records: [32 * 9]s32;
    names: [32 * 2]string;
    count: s64 = 0;
    for i: 0 .. manager.windows.windows.count - 1 {
        window := Windows.At(*manager.windows, i);
        index := Find(manager, window.id);
        if index < 0 || count >= 32 { return false }
        app := *manager.apps[index];
        bounds := app.bounds;
        start := count * 9;
        records[start] = app.id;
        records[start + 1] = bounds.left - area.left;
        records[start + 2] = bounds.top - area.top;
        records[start + 3] = bounds.right - bounds.left;
        records[start + 4] = bounds.bottom - bounds.top;
        records[start + 5] = window.workspace;
        records[start + 6] = cast(s32)(window.id == focus);
        records[start + 7] = cast(s32)window.minimized;
        records[start + 8] = cast(s32)app.maximized;
        names[2 * count] = app.title;
        names[2 * count + 1] = app.app_id;
        count += 1;
    }
    fields[1] = cast(s32)count;
    return Link.Snapshot(id, fields[:], records[:count * 9], names[:count * 2]);
}

SetChrome :: (manager: *Manager, id: s32) -> bool {
    if id != manager.shell { return false }
    raw: [32]s32;
    count := Link.ChromeRegions(id, raw[:]);
    if count < 0 || count > raw.count || count % 4 != 0 { return false }
    width := manager.bounds.right - manager.bounds.left;
    height := manager.bounds.bottom - manager.bounds.top;
    next: [8]Draw.Rect;
    changed := count / 4 != manager.chrome_count;
    for i: 0 .. count / 4 - 1 {
        x := raw[4 * i]; y := raw[4 * i + 1];
        w := raw[4 * i + 2]; h := raw[4 * i + 3];
        if x < 0 || y < 0 || x >= width || y >= height || w <= 0 || h <= 0 || w > width - x || h > height - y {
            return false;
        }
        next[i] = .{x, y, x + w, y + h};
        before := manager.chrome[i];
        changed = changed || before.left != x || before.top != y || before.right != x + w || before.bottom != y + h;
    }
    if changed {
        manager.chrome = next;
        manager.chrome_count = count / 4;
        area := WorkArea(manager);
        for *app: manager.apps[:] {
            if !app.open || app.id == manager.shell { continue }
            bounds := ifx app.maximized then area else FitBounds(app.bounds, area);
            unused SetBounds(manager, app, bounds);
        }
        manager.dirty = true;
    }
    return true;
}

DesktopAction :: (manager: *Manager, action: string, value: s32) -> bool {
    ok := false;
    if action == "switch_workspace" { ok = Windows.SwitchWorkspace(*manager.windows, value) }
    else if action == "configure_workspaces" { ok = Windows.ConfigureWorkspaces(*manager.windows, value) }
    else if action == "show_desktop" {
        for *app: manager.apps[:] {
            if app.id != manager.shell && app.open { unused TaskWindow(manager, app, true) }
        }
        return true;
    }
    if ok { DesktopChanged(manager) }
    return ok;
}

TaskWindow :: (manager: *Manager, app: *Application, task: bool) -> bool {
    for i: 0 .. manager.windows.windows.count - 1 {
        window := Windows.At(*manager.windows, i);
        if window.id != app.id || window.workspace != manager.windows.workspace { continue }
        was_tasked := window.minimized;
        ok := false;
        if task { ok = Windows.Minimize(*manager.windows, app.id) }
        else { ok = Windows.Focus(*manager.windows, app.id) }
        if ok {
            DesktopChanged(manager);
            if task != was_tasked {
                bounds := app.bounds;
                fields: [9]s32 = .{Surface.Visibility, 0, 0, cast(s32)task, 0, 0,
                    bounds.right - bounds.left, bounds.bottom - bounds.top, 0};
                if Link.Dispatch(app.id, fields[:], -1) == 0 { Link.Disconnect(app.id) }
            }
        }
        return ok;
    }
    return false;
}

FitBounds :: (bounds: Draw.Rect, area: Draw.Rect) -> Draw.Rect {
    width := bounds.right - bounds.left;
    height := bounds.bottom - bounds.top;
    if width > area.right - area.left { width = area.right - area.left }
    if height > area.bottom - area.top { height = area.bottom - area.top }
    left := bounds.left;
    top := bounds.top;
    if left > area.right - width { left = area.right - width }
    if top > area.bottom - height { top = area.bottom - height }
    if left < area.left { left = area.left }
    if top < area.top { top = area.top }
    return .{left, top, left + width, top + height};
}

SetBounds :: (manager: *Manager, app: *Application, bounds: Draw.Rect) -> bool {
    before := app.bounds;
    if bounds.left == before.left && bounds.top == before.top &&
       bounds.right == before.right && bounds.bottom == before.bottom { return true }
    width := bounds.right - bounds.left;
    height := bounds.bottom - bounds.top;
    app.bounds = bounds;
    if !Windows.SetLayer(*manager.windows, app.id, Layer(app)) { return false }
    DesktopChanged(manager);
    if width != before.right - before.left || height != before.bottom - before.top { NotifyResize(app, width, height) }
    return true;
}

NotifyResize :: (app: *Application, width: s32, height: s32) {
    fields: [9]s32 = .{Surface.Resize, 0, 0, 0, 0, 0, width, height, 0};
    if Link.Dispatch(app.id, fields[:], -1) == 0 { Link.Disconnect(app.id) }
}

CloseWindow :: (manager: *Manager, app: *Application) {
    app.closing = true;
    Link.Disconnect(app.id);
    RemoveWindow(manager, app);
}

Maximize :: (manager: *Manager, app: *Application, maximize: bool) -> bool {
    if maximize == app.maximized { return true }
    area := WorkArea(manager);
    if maximize { app.normal = app.bounds }
    app.maximized = maximize;
    return SetBounds(manager, app, ifx maximize then area else FitBounds(app.normal, area));
}

WindowAction :: (manager: *Manager, action: string, request: []s32) -> bool {
    id := request[5];
    index := Find(manager, id);
    if index < 0 || id == manager.shell || !manager.apps[index].open { return false }
    app := *manager.apps[index];
    if action == "move_to_workspace" {
        if !Windows.MoveToWorkspace(*manager.windows, id, request[3]) { return false }
        DesktopChanged(manager);
        return true;
    }
    for i: 0 .. manager.windows.windows.count - 1 {
        window := Windows.At(*manager.windows, i);
        if window.id != id || window.workspace != manager.windows.workspace { continue }
        if action == "close" {
            CloseWindow(manager, app);
            return true;
        }
        if action == "focus" || (action == "restore" && window.minimized) { return TaskWindow(manager, app, false) }
        if action == "minimize" { return TaskWindow(manager, app, true) }
        if window.minimized { return false }
        if action == "maximize" || action == "restore" { return Maximize(manager, app, action == "maximize") }
        if (action != "move" && action != "resize") || app.maximized { return false }
        area := WorkArea(manager);
        screen := manager.bounds;
        if request[3] < 0 || request[4] < 0 || request[3] >= screen.right - screen.left ||
           request[4] >= screen.bottom - screen.top { return false }
        x := screen.left + request[3];
        y := screen.top + request[4];
        width := app.bounds.right - app.bounds.left;
        height := app.bounds.bottom - app.bounds.top;
        if action == "resize" { width = request[1]; height = request[2] }
        if width <= 0 || height <= 0 || width > area.right - area.left || height > area.bottom - area.top { return false }
        return SetBounds(manager, app, FitBounds(.{x, y, x + width, y + height}, area));
    }
    return false;
}

Paint :: (manager: *Manager) -> bool {
    chrome: [8]Compositor.Layer;
    count := ChromeLayers(manager, chrome[:]);
    if !RefreshCaptions(manager) { return false }
    RefreshCursor(manager, chrome[:count]);
    background := manager.background;
    index := Find(manager, manager.shell);
    if index >= 0 && manager.apps[index].open { background = manager.apps[index].image }
    return Windows.Repaint(*manager.windows, *manager.display, background, chrome[:count], manager.bounds);
}

RefreshCaptions :: (manager: *Manager) -> bool {
    height := TitleHeight(manager, FrameArea(manager));
    for i: 0 .. manager.windows.windows.count - 1 {
        window := Windows.At(*manager.windows, i);
        if window.workspace != manager.windows.workspace || window.minimized { continue }
        if height == 0 { Windows.SetCaption(*manager.windows, i, .{}); continue }
        index := Find(manager, window.id);
        if index < 0 { return false }
        app := *manager.apps[index];
        bounds := app.bounds;
        pressed: TitlePolicy.Action = ifx app.id == manager.title_target then manager.title_press else .None;
        if !Titlebar.Paint(*manager.title_painter, *manager.display, *app.caption, bounds.right - bounds.left,
                           app.title, app.id == manager.windows.keyboard_focus, pressed) { return false }
        image := app.caption.image;
        Windows.SetCaption(*manager.windows, i, .{image, image.bounds, bounds.left, bounds.top - Titlebar.Height});
    }
    return true;
}

Run :: (manager: *Manager, input: s32) -> s32 {
    status: s32 = 0;
    while manager.apps.count != 0 {
        // Hand over what a busy application's full queue refused, before
        // reading more input or waiting for activity.
        made_progress := false;
        if retry_count > 0 {
            before := retry_count;
            FlushRetries();
            made_progress = retry_count < before;
        }
        for i: 0 .. 31 {
            event := Input.Next(input);
            if event.kind == 0 { break }
            HandleInput(manager, event);
        }
        cursor: s32 = 0;
        request: [7]s32;
        for n: 0 .. manager.apps.count - 1 {
            id := Link.Request(cursor, request[:]);
            if id <= 0 { break }
            cursor = id;
            if request[0] == Link.Sample {
                unused Link.ReplySample(id, SamplePointer(manager, id));
                continue;
            }
            index := Find(manager, id);
            ok := false;
            if index >= 0 { ok = Service(manager, *manager.apps[index], request[:]) }
            unused Link.Reply(id, ok);
        }
        i: s64 = 0;
        while i < manager.apps.count {
            app := *manager.apps[i];
            outcome := Process.Poll(app.id);
            if outcome.status == -2 {
                i += 1;
                continue;
            }
            // A request can fail under an application whose window was just closed.
            if !app.closing && (outcome.status < 0 || outcome.value != 0) {
                status = 1;
                if outcome.error != "" { unused Args.SetFailure(outcome.error) }
            }
            if app.open { RemoveWindow(manager, app) }
            if app.id == manager.shell { return status }
            manager.apps[i] = manager.apps[manager.apps.count - 1];
            unused VecResize(manager.apps, manager.apps.count - 1);
        }
        if manager.dirty {
            if !Paint(manager) { return Fail("repaint desktop") }
            manager.dirty = false;
        }
        // A retry that gets through means the next turn must run even if
        // nothing else happens, so skip the blocking wait once. Retries that
        // keep failing fall through to the wait, which bounds the spin.
        if made_progress { continue }
        if manager.apps.count != 0 && !Link.WaitActivity() { return Fail("wait for desktop activity") }
    }
    return status;
}

Find :: (manager: *Manager, id: s32) -> s64 {
    if id <= 0 { return -1 }
    for i: 0 .. manager.apps.count - 1 {
        if manager.apps[i].id == id { return i }
    }
    return -1;
}

Layer :: (app: *Application) -> Compositor.Layer {
    local: Draw.Rect = .{0, 0, app.bounds.right - app.bounds.left, app.bounds.bottom - app.bounds.top};
    return .{app.image, Compositor.Intersect(app.image.bounds, local), app.bounds.left, app.bounds.top};
}

Service :: (manager: *Manager, app: *Application, request: []s32) -> bool {
    if request[0] == Link.Capture { return Capture(manager, app.id) }
    if request[0] == Link.Open { return OpenWindow(manager, app, request[1], request[2]) }
    if !app.open { return false }
    if request[0] == Link.Frame { return PaintFrame(manager, app, request) }
    if request[0] == Link.Close {
        RemoveWindow(manager, app);
        return true;
    }
    if request[0] == Link.SetTitle {
        app.title = Link.Text(app.id);
        app.caption.valid = false;
        DesktopChanged(manager);
        return true;
    }
    if request[0] == Link.SetTasked {
        return TaskWindow(manager, app, request[5] != 0);
    }
    if request[0] == Link.Chrome { return SetChrome(manager, app.id) }
    if request[0] == Link.DesktopAction { return DesktopAction(manager, Link.Text(app.id), request[5]) }
    if request[0] == Link.WindowAction { return WindowAction(manager, Link.Text(app.id), request) }
    if request[0] == Link.Resize {
        if app.id == manager.shell || app.maximized { return false }
        bounds := app.bounds;
        bounds.right = bounds.left + request[1];
        bounds.bottom = bounds.top + request[2];
        for i: 0 .. manager.windows.windows.count - 1 {
            window := Windows.At(*manager.windows, i);
            if window.id == app.id && !window.minimized { return SetBounds(manager, app, FitBounds(bounds, WorkArea(manager))) }
        }
        return false;
    }
    if request[0] == Link.Cursor { return SetCursor(manager, app, request[6]) }
    if request[0] == Link.Launch {
        app_id := AppID(Link.Text(app.id));
        id := Link.LaunchWindow(app.id);
        if id <= 0 { return false }
        if VecPush(manager.apps, Application.{id = id, app_id = app_id}) { return true }
        Link.Disconnect(id);
    }
    return false;
}

OpenWindow :: (manager: *Manager, app: *Application, width: s32, height: s32) -> bool {
    if app.open { return false }
    shell := app.id == manager.shell;
    if shell {
        if width != manager.bounds.right - manager.bounds.left || height != manager.bounds.bottom - manager.bounds.top { return false }
        app.bounds = manager.bounds;
    } else {
        area := FrameArea(manager);
        title_height := TitleHeight(manager, area);
        app.bounds = Windows.Place(*manager.windows, area, width, height + title_height);
        app.bounds.top += title_height;
    }
    if app.bounds.right <= app.bounds.left { return false }
    app.image = Draw.Buffer(*manager.display, .{0, 0, width, height}, 0x000000ff);
    if app.image.id == 0 { return false }
    if !shell && !Windows.Add(*manager.windows, app.id, Layer(app), true, true) {
        unused Draw.Release(*manager.display, *app.image);
        return false;
    }
    app.title = Link.Text(app.id);
    app.open = true;
    manager.dirty = true;
    if !shell { manager.generation += 1 }
    actual_width := app.bounds.right - app.bounds.left;
    actual_height := app.bounds.bottom - app.bounds.top;
    if actual_width != width || actual_height != height { NotifyResize(app, actual_width, actual_height) }
    return true;
}

RemoveWindow :: (manager: *Manager, app: *Application) {
    if app.id == manager.shell { manager.chrome_count = 0 }
    else {
        unused Windows.Remove(*manager.windows, app.id);
        manager.generation += 1;
    }
    unused Draw.Release(*manager.display, *app.pending);
    unused Draw.Release(*manager.display, *app.image);
    if app.caption.image.id != 0 { unused Draw.Release(*manager.display, *app.caption.image) }
    app.caption = .{};
    app.open = false;
    if app.id == manager.sample_owner { manager.sample_owner = 0 }
    if app.id == manager.cursor_target {
        manager.cursor_target = 0;
        unused ApplyCursor(manager, 0);
    }
    manager.dirty = true;
}

PaintFrame :: (manager: *Manager, app: *Application, request: []s32) -> bool {
    width := request[1];
    height := request[2];
    first := request[3];
    rows := request[4];
    publish := (request[5] & Link.Publish) != 0;
    staged := (request[5] & Link.Staged) != 0;
    if request[6] != width * rows * 4 { return false }
    // A frame rendered against the old size can arrive after a resize. Keep
    // the current window geometry and let the client handle its Resize event.
    if width != app.bounds.right - app.bounds.left || height != app.bounds.bottom - app.bounds.top {
        if app.pending.id != 0 { unused Draw.Release(*manager.display, *app.pending) }
        return app.id != manager.shell;
    }
    image := app.image;
    if staged && first != 0 {
        image = app.pending;
    } else {
        unused Draw.Release(*manager.display, *app.pending);
        if staged || width != image.bounds.right || height != image.bounds.bottom {
            if first != 0 { return false }
            app.pending = Draw.Buffer(*manager.display, .{0, 0, width, height}, 0x000000ff);
            image = app.pending;
        }
    }
    if !UploadPixels(*manager.display, image, app.id, width, first, rows) {
        unused Draw.Release(*manager.display, *app.pending);
        return false;
    }
    if publish && image.id == app.pending.id {
        unused Draw.Release(*manager.display, *app.image);
        app.image = image;
        app.pending = .{};
        unused Windows.SetLayer(*manager.windows, app.id, Layer(app));
    }
    if publish { manager.dirty = true }
    return true;
}

UploadPixels :: (display: *Draw.Display, image: Draw.Image, id: s32,
                 width: s32, first: s32, rows: s32) -> bool {
    // Draw messages have 21 bytes of framing and fit at most 2042 RGBA pixels.
    buffer: [2042 * 4]u8;
    if image.id == 0 { return false }
    rows_per_tile: s32 = 2042 / width;
    if rows_per_tile == 0 { rows_per_tile = 1 }
    y: s32 = 0;
    while y < rows {
        lines := ifx rows - y < rows_per_tile then rows - y else rows_per_tile;
        x: s32 = 0;
        while x < width {
            columns: s32 = ifx width - x < 2042 then width - x else 2042;
            size := columns * lines * 4;
            offset := (y * width + x) * 4;
            pixels := buffer[:size];
            bounds: Draw.Rect = .{x, first + y, x + columns, first + y + lines};
            if Link.Payload(id, offset, pixels) != size || !Draw.Upload(display, image, bounds, pixels) { return false }
            x += columns;
        }
        y += lines;
    }
    return true;
}

InTitle :: (manager: *Manager, app: *Application, x: s32, y: s32) -> bool {
    return app.caption.image.id != 0 && x >= app.bounds.left && x < app.bounds.right && y < app.bounds.top &&
           y >= app.bounds.top - TitleHeight(manager, FrameArea(manager));
}

DragTitle :: (manager: *Manager, app: *Application, x: s32, y: s32) {
    action := manager.title_press;
    if app.maximized || (action != .Drag && action != .Resize) { return }
    origin := manager.title_origin;
    dx := x - manager.title_x;
    dy := y - manager.title_y;
    if !manager.title_moved && dx == 0 && dy == 0 { return }
    manager.title_moved = true;
    TitlePolicy.CancelClick(*app.click);
    area := WorkArea(manager);
    bounds := origin;
    if action == .Drag {
        bounds = .{origin.left + dx, origin.top + dy, origin.right + dx, origin.bottom + dy};
    } else {
        bounds.right += dx;
        bounds.bottom += dy;
        if bounds.right <= bounds.left { bounds.right = bounds.left + 1 }
        if bounds.bottom <= bounds.top { bounds.bottom = bounds.top + 1 }
        if bounds.right > area.right { bounds.right = area.right }
        if bounds.bottom > area.bottom { bounds.bottom = area.bottom }
    }
    unused SetBounds(manager, app, FitBounds(bounds, area));
}

TitleInput :: (manager: *Manager, target: s32, event: Input.Event, changed: s32, millis: s64) -> bool {
    index := Find(manager, target);
    if manager.title_target == 0 {
        if index < 0 || target == manager.shell { return false }
        app := *manager.apps[index];
        if manager.buttons != 0 || !InTitle(manager, app, event.x, event.y) { return false }
        if event.buttons == 0 { return true }
        manager.title_target = target;
        manager.title_origin = app.bounds;
        manager.title_x = event.x;
        manager.title_y = event.y;
        manager.title_moved = false;
        if (event.buttons & 1) != 0 {
            manager.title_press = Titlebar.Press(*app.click, app.bounds.right - app.bounds.left,
                event.x - app.bounds.left, event.y - app.bounds.top + Titlebar.Height, millis);
            if manager.title_press == .Lower && Windows.Lower(*manager.windows, target) { DesktopChanged(manager) }
        }
        manager.dirty = true;
        return true;
    }
    if index >= 0 && target == manager.title_target {
        app := *manager.apps[index];
        if (manager.buttons & 1) != 0 { DragTitle(manager, app, event.x, event.y) }
        if (changed & manager.buttons & 1) != 0 && !manager.title_moved && InTitle(manager, app, event.x, event.y) {
            action := manager.title_press;
            hit := Titlebar.Hit(app.bounds.right - app.bounds.left, event.x - app.bounds.left,
                                event.y - app.bounds.top + Titlebar.Height);
            if hit == action {
                if action == .Close { CloseWindow(manager, app) }
                else if action == .Hide { unused TaskWindow(manager, app, true) }
                else if action == .Resize { unused Maximize(manager, app, !app.maximized) }
            }
        }
    }
    if (changed & manager.buttons & 1) != 0 { manager.title_press = .None; manager.dirty = true }
    if event.buttons == 0 { manager.title_target = 0 }
    return true;
}

HandleInput :: (manager: *Manager, event: Input.Event) {
    workspace := manager.windows.workspace;
    if Windows.WorkspaceKey(*manager.windows, event) {
        if manager.windows.workspace != workspace { DesktopChanged(manager) }
        return;
    }
    if event.kind == Input.Pointer {
        chrome: [8]Compositor.Layer;
        count := ChromeLayers(manager, chrome[:]);
        focus := manager.windows.keyboard_focus;
        target := Windows.PointerTarget(*manager.windows, chrome[:count], event);
        id := ifx target == Windows.Desktop then manager.shell else target;
        manager.pointer_x = event.x;
        manager.pointer_y = event.y;
        manager.pointer_known = true;
        RefreshCursor(manager, chrome[:count]);
        changed := manager.buttons ^ event.buttons;
        if event.millis < manager.pointer_tick && manager.pointer_tick - event.millis > 0x80000000 {
            manager.pointer_epoch += 4294967296;
        }
        manager.pointer_tick = event.millis;
        millis := manager.pointer_epoch + cast(s64)event.millis;
        if TitleInput(manager, id, event, changed, millis) {
            if focus != manager.windows.keyboard_focus { DesktopChanged(manager) }
            manager.buttons = event.buttons;
            if (changed & event.buttons & 1) != 0 { manager.sample_owner = 0 }
            return;
        }
        if (changed & event.buttons & 1) != 0 {
            manager.sample_owner = ifx id != manager.shell then id else 0;
            manager.sample_release = false;
        }
        if manager.sample_owner > 0 && !manager.sample_release {
            manager.sample_x = event.x;
            manager.sample_y = event.y;
            if (event.buttons & 1) == 0 {
                if id != manager.sample_owner { manager.sample_owner = 0 }
                manager.sample_release = true;
            }
        }
        if manager.buttons == 0 && event.buttons != 0 && id > 0 && id != manager.shell { manager.dirty = true }
        if focus != manager.windows.keyboard_focus { manager.generation += 1 }
        manager.buttons = event.buttons;
        index := Find(manager, id);
        if index < 0 { return }
        bounds := manager.apps[index].bounds;
        x := event.x - bounds.left;
        y := event.y - bounds.top;
        if changed == 0 {
            Send(id, Surface.Move, x, y, 0, 0, 0, 0, millis);
            return;
        }
        wheel := changed & event.buttons;
        if (wheel & 8) != 0 { Send(id, Surface.PointerWheel, x, y, 1000, 0, 0, 0, -1) }
        if (wheel & 16) != 0 { Send(id, Surface.PointerWheel, x, y, -1000, 0, 0, 0, -1) }
        for button: 0 .. 2 {
            bit := cast(s32)(1 << button);
            if (changed & bit) != 0 {
                kind: s32 = ifx (event.buttons & bit) != 0 then Surface.Down else Surface.Up;
                Send(id, kind, x, y, cast(s32)button + 1, 0, 0, 0, millis);
            }
        }
        return;
    }
    target := manager.windows.keyboard_focus;
    id := ifx target == Windows.Desktop then manager.shell else target;
    if id <= 0 { return }
    if event.kind == Input.Text {
        Send(id, Surface.TextEvent, 0, 0, 0, 0, 0, event.code, -1);
    } else if event.kind == Input.KeyDown || event.kind == Input.KeyUp {
        kind: s32 = ifx event.kind == Input.KeyDown then Surface.Key else 8;
        Send(id, kind, 0, 0, 0, event.code, event.modifiers, 0, -1);
    }
}

Send :: (id: s32, kind: s32, x: s32, y: s32, button: s32, key: s32,
         modifiers: s32, rune: s32, millis: s64) {
    fields: [9]s32 = .{kind, x, y, button, key, modifiers, 0, 0, rune};
    // A busy app's full queue reports -1: keep the event for a retry next turn
    // instead of dropping it, and never disconnect an app just for being busy.
    status := Link.Dispatch(id, fields[:], millis);
    if status == 0 { Link.Disconnect(id); return }
    if status < 0 { QueueRetry(id, kind, x, y, button, key, modifiers, rune, millis) }
}

// Events the window manager could not hand over because the application's
// queue was full. They are tried again before new input is read.
RetryLimit :: 64;

retry_count: s32;
retry_fields: [RetryLimit][9]s32;
retry_ids: [RetryLimit]s32;
retry_millis: [RetryLimit]s64;

QueueRetry :: (id: s32, kind: s32, x: s32, y: s32, button: s32, key: s32,
               modifiers: s32, rune: s32, millis: s64) {
    if retry_count >= RetryLimit { return }
    retry_ids[retry_count] = id;
    retry_fields[retry_count] = .{kind, x, y, button, key, modifiers, 0, 0, rune};
    retry_millis[retry_count] = millis;
    retry_count += 1;
}

FlushRetries :: () {
    keep: s32 = 0;
    for i: 0 .. retry_count - 1 {
        id := retry_ids[i];
        status := Link.Dispatch(id, retry_fields[i][:], retry_millis[i]);
        if status == 0 { Link.Disconnect(id) }
        else if status < 0 {
            // Still full: hold it in the compacted list.
            retry_ids[keep] = id;
            retry_fields[keep] = retry_fields[i];
            retry_millis[keep] = retry_millis[i];
            keep += 1;
        }
    }
    retry_count = keep;
}
