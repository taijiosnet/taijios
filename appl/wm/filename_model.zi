// Model and path/pattern helpers for the ZX File Chooser, ported from
// appl/wm/filename.b and appl/lib/selectfile.b.
#import "std/vec"

#scope_export

Pattern :: struct {
    bytes: Vec(u8);
}

Options :: struct {
    startdir: string;
    title: string;
    pattern_start: s32;
    error_opt: u8;
    usage_error: bool;
}

// Parse filename [-d startdir] [-t title] [pattern...]
// Matches Inferno arg(2) + appl/wm/filename.b semantics.
ParseArgs :: (operands: []string) -> Options {
    opts: Options;
    opts.startdir = ".";
    opts.title = "Select a file";
    i: s32 = 0;
    while i < cast(s32)operands.count {
        arg := operands[i];
        if arg.count < 2 || arg[0] != #char "-" {
            break;
        }
        if arg == "--" {
            i += 1;
            break;
        }
        j: s64 = 1;
        while j < arg.count {
            c := arg[j];
            if c == #char "d" || c == #char "t" {
                val: string;
                if j + 1 < arg.count {
                    val = arg[j + 1:];
                } else if i + 1 < cast(s32)operands.count {
                    i += 1;
                    val = operands[i];
                } else {
                    opts.usage_error = true;
                    return opts;
                }
                if c == #char "d" { opts.startdir = val; }
                else { opts.title = val; }
                break;
            } else {
                opts.error_opt = c;
                opts.usage_error = true;
                return opts;
            }
        }
        i += 1;
    }
    opts.pattern_start = i;
    return opts;
}

// Turn each pattern of the form "*.b (Limbo files)" into "*.b", ignoring "*".
// Appends patterns into `pats` and writes space-joined filter text into `filter`.
MakePats :: (args: []string, pats: *Vec(Pattern), filter: *Vec(u8)) {
    VecClear(filter.*);
    for a: args {
        end := a.count;
        for i: cast(s64)0..a.count-1 {
            if a[i] == #char " " { end = i; break; }
        }
        if a != "*" && end > 0 {
            pat: Pattern;
            unused BuilderAppend(pat.bytes, a[:end]);
            if VecPush(pats.*, pat) {
                if filter.count > 0 { unused BuilderAppend(filter.*, " "); }
                unused BuilderAppend(filter.*, a[:end]);
            }
        }
    }
}

ParseFilter :: (text: string, pats: *Vec(Pattern)) {
    FreePatterns(pats);
    i: s64 = 0;
    while i < text.count {
        while i < text.count && text[i] == #char " " { i += 1; }
        start := i;
        while i < text.count && text[i] != #char " " { i += 1; }
        if i > start {
            pat: Pattern;
            unused BuilderAppend(pat.bytes, text[start:i]);
            unused VecPush(pats.*, pat);
        }
    }
}

FreePatterns :: (pats: *Vec(Pattern)) {
    for i: cast(s64)0..pats.count-1 { VecFree(pats.*[i].bytes); }
    VecClear(pats.*);
}

// Inferno filepat(2) glob matching: *, ?, [...], [a-z], [^...].
GlobMatch :: (pat: string, name: string) -> bool {
    return GlobMatchAt(pat, 0, name, 0);
}

MatchesAny :: (pats: []Pattern, name: string, is_dir: bool) -> bool {
    if is_dir || pats.count == 0 { return true; }
    for *p: pats {
        if GlobMatch(TextView(p.bytes[:]), name) { return true; }
    }
    return false;
}

SkipSlash :: (path: string) -> string {
    for i: cast(s64)0..path.count-1 {
        if path[i] != #char "/" { return path[i:]; }
    }
    return "";
}

NextElem :: (path: string) -> (elem: string, rest: string) {
    if path.count == 0 { return "", ""; }
    if path[0] == #char "/" { return "/", SkipSlash(path); }
    i: s64 = 0;
    while i < path.count && path[i] != #char "/" { i += 1; }
    return path[:i], SkipSlash(path[i:]);
}

IsLastElem :: (path: string) -> bool {
    for i: cast(s64)0..path.count-1 {
        if path[i] == #char "/" { return false; }
    }
    return true;
}

Deslash :: (s: string) -> string {
    if s.count > 0 && s[s.count - 1] == #char "/" { return s[:s.count - 1]; }
    return s;
}

PathCat :: (path: string, elem: string, out: *Vec(u8)) {
    VecClear(out.*);
    unused BuilderAppend(out.*, path);
    if out.count > 0 && out.*[out.count - 1] != #char "/" {
        unused BuilderAppend(out.*, "/");
    }
    unused BuilderAppend(out.*, elem);
}

CompareText :: (a: string, b: string) -> s32 {
    n := ifx a.count < b.count then a.count else b.count;
    for i: cast(s64)0..n-1 {
        if a[i] < b[i] { return -1; }
        if a[i] > b[i] { return 1; }
    }
    if a.count < b.count { return -1; }
    if a.count > b.count { return 1; }
    return 0;
}

StartsWith :: (s: string, prefix: string) -> bool {
    if prefix.count > s.count { return false; }
    for i: cast(s64)0..prefix.count-1 {
        if s[i] != prefix[i] { return false; }
    }
    return true;
}

#scope_file

GlobMatchAt :: (pat: string, pi: s64, name: string, ni: s64) -> bool {
    p := pi;
    n := ni;
    while p < pat.count {
        c := pat[p];
        if c == #char "*" {
            while p < pat.count && pat[p] == #char "*" { p += 1; }
            if p == pat.count { return true; }
            k := n;
            while k <= name.count {
                if GlobMatchAt(pat, p, name, k) { return true; }
                k += 1;
            }
            return false;
        }
        if n >= name.count { return false; }
        if c == #char "?" {
            p += 1;
            n += 1;
            continue;
        }
        if c == #char "[" {
            p += 1;
            negate := false;
            if p < pat.count && pat[p] == #char "^" {
                negate = true;
                p += 1;
            }
            matched := false;
            ch := name[n];
            first := true;
            while p < pat.count && (first || pat[p] != #char "]") {
                first = false;
                lo := pat[p];
                if p + 2 < pat.count && pat[p + 1] == #char "-" && pat[p + 2] != #char "]" {
                    hi := pat[p + 2];
                    if ch >= lo && ch <= hi { matched = true; }
                    p += 3;
                } else {
                    if ch == lo { matched = true; }
                    p += 1;
                }
            }
            if p >= pat.count || pat[p] != #char "]" { return false; }
            p += 1;
            if negate { matched = !matched; }
            if !matched { return false; }
            n += 1;
            continue;
        }
        if c != name[n] { return false; }
        p += 1;
        n += 1;
    }
    return n == name.count;
}
