Chrome :: #import "kryon/window_chrome";
Call :: #import "taijios_wm_call";
#import "kryon/geometry"

Measure :: 0
Paint :: 1
Press :: 2
Release :: 3

ControlMask :: (legacy: s32) -> u32 {
    result: u32 = Chrome.ControlClose
    if (legacy & 1) != 0 { result |= Chrome.ControlResize }
    if (legacy & 2) != 0 { result |= Chrome.ControlHide }
    if (legacy & 4) != 0 { result |= Chrome.ControlHelp }
    if (legacy & 8) != 0 { result |= Chrome.ControlOK }
    return result
}

StoreRect :: (fields: []s32, bounds: Rectangle) {
    fields[0] = cast(s32)bounds.x
    fields[1] = cast(s32)bounds.y
    fields[2] = cast(s32)bounds.width
    fields[3] = cast(s32)bounds.height
}

StoreControl :: (fields: []s32, bounds: Rectangle, action: Chrome.Action, pressed: Chrome.Action, props: Chrome.Props) {
    StoreRect(fields, bounds)
    fields[4] = cast(s32)Chrome.ControlColor(props, action, action == pressed)
    sprite := Chrome.ControlSprite(props, action, action == pressed)
    if sprite >= 0 { fields[5] = -sprite - 1; return }
    glyph := Chrome.ControlGlyph(action)
    for i: 0 .. 3 {
        fields[5 + i] = ifx i < glyph.count then cast(s32)glyph[i] else 0
    }
}

WidthNeeded :: (mask: u32, height: s32) -> s32 {
    count: s32 = 3
    for bit: 1 .. 5 {
        if (mask & (cast(u32)1 << bit)) != 0 { count += 1 }
    }
    return count * height
}

main :: () -> s32 {
    request: [15]s32
    if !Call.Read(0, request[:]) { return 1 }
    op := request[0]
    width := request[1]
    height := request[2]
    props: Chrome.Props = .{.bounds = .{0.0, 0.0, cast(float32)width, cast(float32)height},
        .focused = request[4] != 0, .controls = ControlMask(request[3]), .sweet_dark = true}
    if op == Measure {
        result: [2]s32 = .{WidthNeeded(props.controls, height), height}
        if Call.Reply(0, result[:]) { return 0 }
        return 1
    }
    layout := Chrome.LayoutFor(props)
    pressed := cast(Chrome.Action)request[12]
    if op == Paint {
        result: [60]s32
        result[0] = cast(s32)Chrome.CaptionBackground(props)
        result[1] = cast(s32)Chrome.CaptionForegroundFor(props)
        StoreRect(result[2:6], Chrome.CaptionTextBounds(layout))
        StoreControl(result[6:15], layout.close, .Close, pressed, props)
        StoreControl(result[15:24], layout.resize, .Resize, pressed, props)
        StoreControl(result[24:33], layout.task, .Task, pressed, props)
        StoreControl(result[33:42], layout.hide, .Hide, pressed, props)
        StoreControl(result[42:51], layout.help, .Help, pressed, props)
        StoreControl(result[51:60], layout.ok, .OK, pressed, props)
        if Call.Reply(0, result[:]) { return 0 }
        return 1
    }
    point: Vector2 = .{cast(float32)request[5], cast(float32)request[6]}
    state: Chrome.State = .{request[8] != 0, cast(s64)cast(u32)request[9],
        .{cast(float32)request[10], cast(float32)request[11]}}
    action: Chrome.Action = .None
    if op == Press {
        pressed = Chrome.PointerPress(*state, props, point, cast(s64)cast(u32)request[7])
        if pressed == .Drag || pressed == .Lower { action = pressed }
    } else if op == Release {
        if pressed == .Drag && (request[13] != 0 || request[14] != 0) { Chrome.CancelClick(*state) }
        if cast(s32)pressed >= cast(s32)Chrome.Action.Close && Chrome.Hit(layout, point) == pressed { action = pressed }
        pressed = .None
    } else { return 1 }
    fields: [6]s32 = .{cast(s32)action, cast(s32)state.click_pending, cast(s32)state.click_at_ms,
        cast(s32)state.click_point.x, cast(s32)state.click_point.y, cast(s32)pressed}
    if !Call.Reply(0, fields[:]) { return 1 }
    return 0
}
