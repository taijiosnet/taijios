// Replays the game recorded from the Dis Tetris (tetris_games.expected) through
// the Ziran rules: the same seed, keys and drops give the same boards and counters.
Tetris :: #import "tetris_model";
Rand :: #import "inferno_rand";
Fixture :: #import "tetris_games_fixture";
#import "std/vec"

Field :: (line: string, index: s32) -> string {
    at: s64 = 0
    for field: 0..index {
        start := at
        while at < line.count && line[at] != cast(u8)32 { at += 1 }
        if field == index { return line[start:at] }
        at += 1
    }
    return ""
}

Number :: (text: string) -> s32 {
    value: s32 = 0
    for i: cast(s64)0..text.count-1 { value = value * 10 + cast(s32)(text[i] - cast(u8)48) }
    return value
}

Hex :: (text: string) -> s32 {
    value: u32 = 0
    for i: cast(s64)0..text.count-1 {
        digit := cast(u32)text[i]
        if digit >= 97 { digit -= 87 } else { digit -= 48 }
        value = value * cast(u32)16 + digit
    }
    return cast(s32)value
}

// The board as drawn: landed blocks, and the stopped piece once the game is over.
// While a game runs, the two top rows may show the next piece falling, so they
// are left out; ? marks squares under the Game over label.
Matches :: (game: *Tetris.Game, board: string) -> bool {
    if board.count != Tetris.Width * Tetris.Height { return false }
    drawn: [Tetris.Width * Tetris.Height]u8
    for i: 0..Tetris.Width*Tetris.Height-1 { drawn[i] = cast(u8)48 + game.cells[i] }
    first := 2 * Tetris.Width
    if game.over {
        first = 0
        blocks := Tetris.Blocks(game.current)
        for i: 0..3 {
            x := game.position.x + blocks[i * 2]
            y := game.position.y + blocks[i * 2 + 1]
            if y >= 0 { drawn[y * Tetris.Width + x] = cast(u8)(49 + game.current.shape) }
        }
    }
    for i: first..Tetris.Width*Tetris.Height-1 {
        if board[i] != cast(u8)63 && board[i] != drawn[i] { return false }
    }
    return true
}

Counter :: (text: string, value: s32) -> bool {
    return text == "-" || Number(text) == value
}

random: Rand.Random;
game: Tetris.Game;

main :: () -> s32 {
    text := Fixture.Games
    start: s64 = 0
    pieces: s32 = 0
    for at: cast(s64)0..text.count-1 {
        if text[at] != cast(u8)10 { continue }
        line := text[start:at]
        start = at + 1
        if line.count == 0 || line[0] == cast(u8)35 { continue }
        if Field(line, 0) == "random" {
            Rand.Seed(*random, Hex(Field(line, 1)))
            Tetris.Start(*game, *random)
            continue
        }
        keys := Field(line, 1)
        for i: cast(s64)0..keys.count-1 {
            if keys[i] == cast(u8)120 { Tetris.Rotate(*game) }
            else if keys[i] == cast(u8)122 { Tetris.Move(*game, -1) }
            else if keys[i] == cast(u8)99 { Tetris.Move(*game, 1) }
        }
        Tetris.Drop(*game)
        unused Tetris.Tick(*game, *random)
        pieces += 1
        if !Matches(*game, Field(line, 2)) || !Counter(Field(line, 3), game.score) ||
           !Counter(Field(line, 4), game.level) || !Counter(Field(line, 5), game.rows) {
            print("piece % differs: score % level % rows %\n", pieces, game.score, game.level, game.rows)
            return 1
        }
    }
    if !game.over { return 2 }
    print("Tetris matched % pieces recorded from the Dis version, to its game over\n", pieces)
    return 0
}
