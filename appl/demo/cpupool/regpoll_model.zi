// Pure argument validation and polling state machine for demo/cpupool/regpoll,
// ported from appl/demo/cpupool/regpoll.b.
Action :: enum {
    Invalid;
    Up;
    Down;
}

PollStep :: enum {
    WaitMount;
    WaitDown;
    Done;
}

ParseArgs :: (args: []string) -> (regaddr: string, action: Action, ok: bool) {
    if args.count != 2 { return "", .Invalid, false }
    addr := args[0];
    act := args[1];
    if act == "up" { return addr, .Up, true }
    if act == "down" { return addr, .Down, true }
    return "", .Invalid, false;
}

NextStep :: (state: PollStep, action: Action, ok_probe: bool) -> PollStep {
    if state == .WaitMount {
        if !ok_probe { return .WaitMount }
        return ifx action == .Up then .Done else .WaitDown;
    }
    if state == .WaitDown {
        return ifx ok_probe then .WaitDown else .Done;
    }
    return .Done;
}
