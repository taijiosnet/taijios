// Poll an Inferno registry service until it comes up or goes down,
// ported from appl/demo/cpupool/regpoll.b.
using Args :: #import "taijios_args"
using Clock :: #import "taijios_clock"
using Dial :: #import "taijios_dial"
using IO :: #import "taijios_io"
using Namespace :: #import "taijios_namespace"
using Model :: #import "regpoll_model"

POLL_INTERVAL_MS :: 30000;

SleepMillis :: (ms: s64) {
    deadline := Clock.Millis() + ms;
    buf: [32]u8;
    while Clock.Millis() < deadline {
        fd := IO.Open("/dev/msec", 0);
        if fd >= 0 {
            unused IO.Read(fd, buf[:]);
            unused IO.Close(fd);
        }
    }
}

Usage :: () -> s32 {
    print("usage: regpoll regaddr up | down\n");
    unused Args.SetFailure("usage");
    return 2;
}

main :: () -> s32 {
    argc := Args.OperandCount();
    if argc != 2 { return Usage() }
    args: [2]string = .[Args.Operand(0), Args.Operand(1)];
    regaddr, action, ok := Model.ParseArgs(args[:]);
    if !ok { return Usage() }

    unused Namespace.Fork();
    unused Namespace.Unmount("", "/mnt/registry");

    state: Model.PollStep = .WaitMount;
    while state != .Done {
        if state == .WaitMount {
            handles: [2]s32 = .[-1, -1];
            dir: [Dial.DirectoryBytes]u8;
            mounted := false;
            if Dial.Dial(regaddr, "", handles[:], dir[:]) == 0 {
                if handles[0] >= 0 && Namespace.Mount(handles[0], -1, "/mnt/registry", Namespace.Replace, "") == 0 {
                    mounted = true;
                }
                if handles[0] >= 0 { unused IO.Close(handles[0]) }
                if handles[1] >= 0 { unused IO.Close(handles[1]) }
            }
            state = Model.NextStep(state, action, mounted);
            if state == .WaitMount { SleepMillis(POLL_INTERVAL_MS) }
        } else if state == .WaitDown {
            fd := IO.Open("/mnt/registry/new", 0);
            alive := fd >= 0;
            if fd >= 0 { unused IO.Close(fd) }
            SleepMillis(POLL_INTERVAL_MS);
            state = Model.NextStep(state, action, alive);
        }
    }
    return 0;
}
