<../../../mkconfig

TARG=\

SHTARG=\
		runrstyx.sh\

MODULES=\

SYSMODULES= \

DISBIN=$ROOT/dis/demo/cpupool

<$ROOT/mkfiles/mkdis

regpoll.zx: regpoll.zi regpoll_model.zi ../../cmd/taijios_args.zi ../../cmd/taijios_clock.zi ../../cmd/taijios_dial.zi ../../cmd/taijios_io.zi ../../cmd/taijios_namespace.zi mkfile
	ziran bundle --project --root . --module-path . --module-path ../../cmd --bind-host taijios_args --bind-host taijios_clock --bind-host taijios_dial --bind-host taijios_io --bind-host taijios_namespace --entry regpoll:main -o $target regpoll.zi

$DISBIN/regpoll.zx: regpoll.zx
	staged=$(mktemp "$target.XXXXXX") &&
	trap 'rm -f "$staged"' EXIT &&
	install -m 0755 regpoll.zx "$staged" && mv "$staged" "$target"

SHFILES=${SHTARG:%.sh=$DISBIN/%}
install:V:	$SHFILES $DISBIN/regpoll.zx
%.install:V:	$DISBIN/%
%.installall:V:	$DISBIN/%

$DISBIN/%:	%.sh
	cp $stem.sh $target && chmod a+rx $target
