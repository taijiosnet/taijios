// Pure argument parsing and path mapping logic for demo/ns,
// ported from appl/demo/ns/ns.b.
#import "std/vec"

Options :: struct {
    verbose: bool;
    relpath: Text;
    paths: Vec(Text);
}

EnsureTrailingSlash :: (s: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    unused BuilderAppend(out.bytes, s);
    if out.bytes.count == 0 || out.bytes[out.bytes.count - 1] != 47 {
        unused VecPush(out.bytes, 47);
    }
}

ParseArgs :: (args: []string, opts: *Options) -> bool {
    opts.verbose = false;
    unused VecResize(opts.relpath.bytes, 0);
    unused VecResize(opts.paths, 0);

    i: s64 = 0;
    while i < args.count {
        a := args[i];
        if a.count < 2 || a[0] != 45 { break }
        if a == "--" { i += 1; break }
        j: s64 = 1;
        while j < a.count {
            ch := a[j];
            if ch == 118 { // -v
                opts.verbose = true;
                j += 1;
            } else if ch == 114 { // -r relpath
                rel := "";
                if j + 1 < a.count {
                    rel = a[j + 1:];
                    j = a.count;
                } else {
                    i += 1;
                    if i >= args.count { return false }
                    rel = args[i];
                    j = a.count;
                }
                if rel.count == 0 { return false }
                EnsureTrailingSlash(rel, *opts.relpath);
            } else {
                return false;
            }
        }
        i += 1;
    }

    while i < args.count {
        p: Text;
        EnsureTrailingSlash(args[i], *p);
        unused VecPush(opts.paths, p);
        i += 1;
    }
    return true;
}

MapBindPath :: (nspath: string, relpath: string, out: *Text) -> bool {
    unused VecResize(out.bytes, 0);
    if relpath.count > nspath.count { return false }
    if relpath.count > 0 && nspath[:relpath.count] != relpath { return false }
    unused BuilderAppend(out.bytes, "/n/remote/");
    unused BuilderAppend(out.bytes, nspath[relpath.count:]);
    return true;
}
