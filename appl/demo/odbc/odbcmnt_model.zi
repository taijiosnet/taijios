// Pure ODBC mount proxy logic: netmkaddr, Windows-1252->UTF-8 conversion,
// pipe-delimited record parsing, and 9P2000 virtual tree, ported from appl/demo/odbc/odbcmnt.b.
#import "std/vec"
#import "std/number_text"

DMDIR :: 0x80000000;
QTDIR :: 0x80;
QTFILE :: 0x00;

TVERSION :: 100;
RVERSION :: 101;
TATTACH :: 104;
RATTACH :: 105;
RERROR :: 107;
TFLUSH :: 108;
RFLUSH :: 109;
TWALK :: 110;
RWALK :: 111;
TOPEN :: 112;
ROPEN :: 113;
TREAD :: 116;
RREAD :: 117;
TWRITE :: 118;
RWRITE :: 119;
TCLUNK :: 120;
RCLUNK :: 121;
TSTAT :: 124;
RSTAT :: 125;

NODE_DIR :: 0;
NODE_SQL :: 1;
NODE_COLUMN :: 2;

MAX_FIDS :: 64;

Node :: struct {
    parent: s32;
    kind: s32;
    src_idx: s32;
    perm: u32;
    name: Text;
    content: Text;
}

FidEntry :: struct {
    in_use: bool;
    fid: u32;
    node_idx: s32;
    is_open: bool;
}

Server :: struct {
    msize: u32;
    uid: Text;
    nodes: Vec(Node);
    fids: [MAX_FIDS]FidEntry;
}

SqlReadCb :: #type (src_idx: s32, offset: s64, count: s64, out: *Text, err: *Text) -> bool;
SqlWriteCb :: #type (src_idx: s32, data: string, err: *Text) -> s32;

ParseArgs :: (args: []string, addr_out: *Text) -> bool {
    unused VecResize(addr_out.bytes, 0);
    unused BuilderAppend(addr_out.bytes, "127.0.0.1");
    i: s64 = 0;
    while i < args.count {
        a := args[i];
        if a.count < 2 || a[0] != 45 { break }
        if a == "--" { i += 1; break }
        if a == "-a" {
            i += 1;
            if i >= args.count { return false }
            unused VecResize(addr_out.bytes, 0);
            unused BuilderAppend(addr_out.bytes, args[i]);
            i += 1;
        } else if a.count > 2 && a[1] == 97 {
            unused VecResize(addr_out.bytes, 0);
            unused BuilderAppend(addr_out.bytes, a[2:]);
            i += 1;
        } else {
            return false;
        }
    }
    return true;
}

NetMkAddr :: (addr: string, net_in: string, svc: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    net := ifx net_in.count == 0 then "net" else net_in;
    bangs: s32 = 0;
    for i: 0..addr.count-1 {
        if addr[i] == 33 { bangs += 1 }
    }
    if bangs == 0 {
        unused BuilderAppend(out.bytes, net);
        unused BuilderAppend(out.bytes, "!");
        unused BuilderAppend(out.bytes, addr);
        if svc.count > 0 {
            unused BuilderAppend(out.bytes, "!");
            unused BuilderAppend(out.bytes, svc);
        }
        return;
    }
    if svc.count == 0 || bangs >= 2 {
        unused BuilderAppend(out.bytes, addr);
        return;
    }
    unused BuilderAppend(out.bytes, addr);
    unused BuilderAppend(out.bytes, "!");
    unused BuilderAppend(out.bytes, svc);
}

// Windows-1252 (0x80..0x9F) special code points; other 0x80..0xFF match Latin-1.
Win1252CodePoint :: (b: u8) -> u32 {
    if b < 0x80 || b >= 0xA0 { return cast(u32)b }
    table: [32]u32 = .[
        0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
        0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
        0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
        0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178,
    ];
    return table[b - 0x80];
}

AppendUtf8 :: (cp: u32, out: *Vec(u8)) {
    if cp < 0x80 {
        unused VecPush(<<out, cast(u8)cp);
    } else if cp < 0x800 {
        unused VecPush(<<out, cast(u8)(0xC0 | (cp >> 6)));
        unused VecPush(<<out, cast(u8)(0x80 | (cp & 0x3F)));
    } else {
        unused VecPush(<<out, cast(u8)(0xE0 | (cp >> 12)));
        unused VecPush(<<out, cast(u8)(0x80 | ((cp >> 6) & 0x3F)));
        unused VecPush(<<out, cast(u8)(0x80 | (cp & 0x3F)));
    }
}

Win1252ToUtf8 :: (src: []u8, out: *Vec(u8)) {
    unused VecResize(<<out, 0);
    for i: 0..src.count-1 {
        AppendUtf8(Win1252CodePoint(src[i]), out);
    }
}

// Extract the n-th '|'-separated field from a record.
PipeField :: (rec: string, field_idx: s32) -> (val: string, ok: bool) {
    cur: s32 = 0;
    start: s64 = 0;
    for i: 0..rec.count {
        if i == rec.count || rec[i] == 124 { // '|'
            if cur == field_idx { return rec[start:i], true }
            cur += 1;
            start = i + 1;
        }
    }
    return "", false;
}

SplitSourceName :: (line: string) -> string {
    for i: 0..line.count-1 {
        if line[i] == 58 { return line[:i] }
    }
    return line;
}

InitServer :: (s: *Server, uid: string) {
    s.msize = 8192;
    unused VecResize(s.uid.bytes, 0);
    unused BuilderAppend(s.uid.bytes, ifx uid.count > 0 then uid else "inferno");
    unused VecResize(s.nodes, 0);
    for i: 0..MAX_FIDS-1 { s.fids[i].in_use = false }
    root: Node;
    root.parent = 0;
    root.kind = NODE_DIR;
    root.perm = cast(u32)DMDIR | 365;
    unused BuilderAppend(root.name.bytes, ".");
    unused VecPush(s.nodes, root);
}

AddNode :: (s: *Server, parent: s32, kind: s32, src_idx: s32, name: string, perm: u32, content: string) -> s32 {
    n: Node;
    n.parent = parent;
    n.kind = kind;
    n.src_idx = src_idx;
    n.perm = perm;
    unused BuilderAppend(n.name.bytes, name);
    unused BuilderAppend(n.content.bytes, content);
    idx := cast(s32)s.nodes.count;
    unused VecPush(s.nodes, n);
    return idx;
}

ReadU16 :: (b: []u8, off: s64) -> u16 { return cast(u16)b[off] | (cast(u16)b[off + 1] << 8) }
ReadU32 :: (b: []u8, off: s64) -> u32 {
    return cast(u32)b[off] | (cast(u32)b[off + 1] << 8) |
           (cast(u32)b[off + 2] << 16) | (cast(u32)b[off + 3] << 24);
}
ReadU64 :: (b: []u8, off: s64) -> u64 { return cast(u64)ReadU32(b, off) | (cast(u64)ReadU32(b, off + 4) << 32) }
PushU8 :: (out: *Vec(u8), v: u8) { unused VecPush(<<out, v) }
PushU16 :: (out: *Vec(u8), v: u16) { PushU8(out, cast(u8)(v & 0xFF)); PushU8(out, cast(u8)((v >> 8) & 0xFF)) }
PushU32 :: (out: *Vec(u8), v: u32) {
    PushU8(out, cast(u8)(v & 0xFF));
    PushU8(out, cast(u8)((v >> 8) & 0xFF));
    PushU8(out, cast(u8)((v >> 16) & 0xFF));
    PushU8(out, cast(u8)((v >> 24) & 0xFF));
}
PushU64 :: (out: *Vec(u8), v: u64) {
    PushU32(out, cast(u32)(v & 0xFFFFFFFF));
    PushU32(out, cast(u32)((v >> 32) & 0xFFFFFFFF));
}
PushStr :: (out: *Vec(u8), txt: string) { PushU16(out, cast(u16)txt.count); unused BuilderAppend(<<out, txt) }

PushQid :: (out: *Vec(u8), node_idx: s32, is_dir: bool) {
    PushU8(out, ifx is_dir then QTDIR else QTFILE);
    PushU32(out, 0);
    PushU64(out, cast(u64)node_idx);
}

PackNodeDir :: (s: *Server, node_idx: s32, out: *Vec(u8)) {
    n := *s.nodes[node_idx];
    name := TextView(n.name);
    uid := TextView(s.uid);
    is_dir := n.kind == NODE_DIR;
    length: u64 = ifx is_dir then 0 else cast(u64)n.content.bytes.count;
    body_len: u16 = cast(u16)(39 + (2 + name.count) + (2 + uid.count) + (2 + uid.count) + 2);
    PushU16(out, body_len);
    PushU16(out, 0);
    PushU32(out, 0);
    PushQid(out, node_idx, is_dir);
    PushU32(out, n.perm);
    PushU32(out, 0);
    PushU32(out, 0);
    PushU64(out, length);
    PushStr(out, name);
    PushStr(out, uid);
    PushStr(out, uid);
    PushStr(out, "");
}

FinishReply :: (kind: u8, tag: u16, payload: []u8, out: *Text) {
    unused VecResize(out.bytes, 0);
    PushU32(*out.bytes, cast(u32)(7 + payload.count));
    PushU8(*out.bytes, kind);
    PushU16(*out.bytes, tag);
    unused BuilderAppend(out.bytes, TextView(payload));
}

EmitError :: (tag: u16, msg: string, out: *Text) {
    body: Vec(u8);
    PushStr(*body, msg);
    FinishReply(RERROR, tag, VecSlice(body, 0, body.count), out);
}

FindFid :: (s: *Server, fid: u32) -> s64 {
    for i: 0..MAX_FIDS-1 { if s.fids[i].in_use && s.fids[i].fid == fid { return i } }
    return -1;
}

AllocFid :: (s: *Server, fid: u32, node_idx: s32) -> s64 {
    for i: 0..MAX_FIDS-1 {
        if !s.fids[i].in_use {
            s.fids[i].in_use = true;
            s.fids[i].fid = fid;
            s.fids[i].node_idx = node_idx;
            s.fids[i].is_open = false;
            return i;
        }
    }
    return -1;
}

FindChild :: (s: *Server, parent: s32, name: string) -> s32 {
    if name == "." { return parent }
    if name == ".." { return s.nodes[parent].parent }
    for i: 1..s.nodes.count-1 {
        if s.nodes[i].parent == parent && TextView(s.nodes[i].name) == name {
            return cast(s32)i;
        }
    }
    return -1;
}

HandlePacket :: (s: *Server, pkt: []u8, on_read: SqlReadCb, on_write: SqlWriteCb, reply: *Text) {
    unused VecResize(reply.bytes, 0);
    if pkt.count < 7 { return }
    kind := pkt[4];
    tag := ReadU16(pkt, 5);

    if kind == TVERSION {
        req_msize := ifx pkt.count >= 11 then ReadU32(pkt, 7) else 8192;
        if req_msize < s.msize && req_msize >= 256 { s.msize = req_msize }
        body: Vec(u8);
        PushU32(*body, s.msize);
        PushStr(*body, "9P2000");
        FinishReply(RVERSION, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TATTACH {
        if pkt.count < 11 { EmitError(tag, "short Tattach", reply); return }
        fid := ReadU32(pkt, 7);
        if FindFid(s, fid) >= 0 || AllocFid(s, fid, 0) < 0 { EmitError(tag, "bad fid", reply); return }
        body: Vec(u8);
        PushQid(*body, 0, true);
        FinishReply(RATTACH, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TFLUSH {
        empty: [0]u8;
        FinishReply(RFLUSH, tag, empty[:], reply);
        return;
    }
    if kind == TWALK {
        if pkt.count < 17 { EmitError(tag, "short Twalk", reply); return }
        fid := ReadU32(pkt, 7);
        newfid := ReadU32(pkt, 11);
        nwname := cast(s64)ReadU16(pkt, 15);
        idx := FindFid(s, fid);
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        cur := s.fids[idx].node_idx;
        off: s64 = 17;
        qids: [16]s32;
        nq: s64 = 0;
        for w: 0..nwname-1 {
            if off + 2 > pkt.count { EmitError(tag, "short Twalk", reply); return }
            slen := cast(s64)ReadU16(pkt, off);
            off += 2;
            if off + slen > pkt.count { EmitError(tag, "short Twalk", reply); return }
            name := TextView(pkt[off:off + slen]);
            off += slen;
            if s.nodes[cur].kind != NODE_DIR { break }
            next_node := FindChild(s, cur, name);
            if next_node < 0 { break }
            cur = next_node;
            if nq < 16 { qids[nq] = cur; nq += 1 }
        }
        if nwname > 0 && nq == 0 { EmitError(tag, "file does not exist", reply); return }
        if nq == nwname {
            if newfid == fid { s.fids[idx].node_idx = cur }
            else if AllocFid(s, newfid, cur) < 0 { EmitError(tag, "too many fids", reply); return }
        }
        body: Vec(u8);
        PushU16(*body, cast(u16)nq);
        for k: 0..nq-1 { PushQid(*body, qids[k], s.nodes[qids[k]].kind == NODE_DIR) }
        FinishReply(RWALK, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TOPEN {
        if pkt.count < 12 { EmitError(tag, "short Topen", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        s.fids[idx].is_open = true;
        ni := s.fids[idx].node_idx;
        body: Vec(u8);
        PushQid(*body, ni, s.nodes[ni].kind == NODE_DIR);
        PushU32(*body, s.msize - 24);
        FinishReply(ROPEN, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TREAD {
        if pkt.count < 23 { EmitError(tag, "short Tread", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        offset := cast(s64)ReadU64(pkt, 11);
        count := cast(s64)ReadU32(pkt, 19);
        if idx < 0 || !s.fids[idx].is_open { EmitError(tag, "bad fid", reply); return }
        ni := s.fids[idx].node_idx;
        n := *s.nodes[ni];
        if n.kind == NODE_DIR {
            dir_bytes: Vec(u8);
            for c: 1..s.nodes.count-1 {
                if s.nodes[c].parent == ni { PackNodeDir(s, cast(s32)c, *dir_bytes) }
            }
            body: Vec(u8);
            if offset >= dir_bytes.count { PushU32(*body, 0) }
            else {
                end := offset + count;
                if end > dir_bytes.count { end = dir_bytes.count }
                PushU32(*body, cast(u32)(end - offset));
                unused BuilderAppend(body, TextView(VecSlice(dir_bytes, offset, end)));
            }
            FinishReply(RREAD, tag, VecSlice(body, 0, body.count), reply);
            return;
        }
        if n.kind == NODE_COLUMN {
            str := TextView(n.content);
            body: Vec(u8);
            if offset >= str.count { PushU32(*body, 0) }
            else {
                end := offset + count;
                if end > str.count { end = str.count }
                PushU32(*body, cast(u32)(end - offset));
                unused BuilderAppend(body, str[offset:end]);
            }
            FinishReply(RREAD, tag, VecSlice(body, 0, body.count), reply);
            return;
        }
        if n.kind == NODE_SQL {
            raw: Text;
            err: Text;
            if !on_read(n.src_idx, offset, count, *raw, *err) {
                EmitError(tag, TextView(err), reply);
                return;
            }
            utf8: Vec(u8);
            Win1252ToUtf8(VecSlice(raw.bytes, 0, raw.bytes.count), *utf8);
            body: Vec(u8);
            PushU32(*body, cast(u32)utf8.count);
            unused BuilderAppend(body, TextView(VecSlice(utf8, 0, utf8.count)));
            FinishReply(RREAD, tag, VecSlice(body, 0, body.count), reply);
            return;
        }
        EmitError(tag, "bad node", reply);
        return;
    }
    if kind == TWRITE {
        if pkt.count < 23 { EmitError(tag, "short Twrite", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        count := cast(s64)ReadU32(pkt, 19);
        if idx < 0 || !s.fids[idx].is_open { EmitError(tag, "bad fid", reply); return }
        ni := s.fids[idx].node_idx;
        if s.nodes[ni].kind != NODE_SQL { EmitError(tag, "permission denied", reply); return }
        if 23 + count > pkt.count { EmitError(tag, "short Twrite", reply); return }
        err: Text;
        written := on_write(s.nodes[ni].src_idx, TextView(pkt[23:23 + count]), *err);
        if written < 0 { EmitError(tag, TextView(err), reply); return }
        body: Vec(u8);
        PushU32(*body, cast(u32)written);
        FinishReply(RWRITE, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    if kind == TCLUNK {
        if pkt.count >= 11 {
            idx := FindFid(s, ReadU32(pkt, 7));
            if idx >= 0 { s.fids[idx].in_use = false }
        }
        empty: [0]u8;
        FinishReply(RCLUNK, tag, empty[:], reply);
        return;
    }
    if kind == TSTAT {
        if pkt.count < 11 { EmitError(tag, "short Tstat", reply); return }
        idx := FindFid(s, ReadU32(pkt, 7));
        if idx < 0 { EmitError(tag, "bad fid", reply); return }
        st: Vec(u8);
        PackNodeDir(s, s.fids[idx].node_idx, *st);
        body: Vec(u8);
        PushU16(*body, cast(u16)st.count);
        unused BuilderAppend(body, TextView(VecSlice(st, 0, st.count)));
        FinishReply(RSTAT, tag, VecSlice(body, 0, body.count), reply);
        return;
    }
    EmitError(tag, "unsupported 9P message", reply);
}
