// Pure whiteboard state, wire protocol, Plan 9 CMAP8 palette, and rasterizer,
// ported from appl/demo/whiteboard/whiteboard.b.
#import "std/vec"
#import "std/number_text"

CANVAS_W :: 600;
CANVAS_H :: 400;
TOOLBAR_H :: 36;
ERASE_WIDTH :: 6;
COLOR_WHITE :: 0xFFFFFFFF;
COLOR_BLACK :: 0x000000FF;

Point :: struct {
    x: s32;
    y: s32;
}

Stroke :: struct {
    colour: u32;
    width: s32;
    points: [128]Point;
    count: s32;
}

ToolHit :: enum {
    None;
    Pen0;
    Pen1;
    Pen2;
    Erase;
    Colour;
}

State :: struct {
    pen_width: s32;
    pen_colour: u32;
    erase: bool;
    picking_colour: bool;
    pen_down: bool;
    last_x: s32;
    last_y: s32;
    connected: bool;
    read_offset: s64;
}

InitState :: (s: *State) {
    s.pen_width = 1;
    s.pen_colour = COLOR_BLACK;
    s.erase = false;
    s.picking_colour = false;
    s.pen_down = false;
    s.connected = false;
    s.read_offset = 0;
}

ServicePath :: (dir: string, leaf: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    unused BuilderAppend(out.bytes, dir);
    unused BuilderAppend(out.bytes, "/");
    unused BuilderAppend(out.bytes, leaf);
}

// Plan 9 / Inferno 8-bit CMAP8 to 0xRRGGBBFF conversion.
CmapToRGBA :: (index: s32) -> u32 {
    if index < 0 || index > 255 { return COLOR_BLACK }
    // Standard 4x4x4x4 Plan 9 colormap (matches libdraw rgb2cmap/cmap2rgb).
    j := index >> 4;
    k := index & 15;
    r: u32;
    g: u32;
    b: u32;
    if j == 0 && k == 0 { return COLOR_WHITE }
    if index == 255 { return COLOR_BLACK }
    r = cast(u32)((3 - (index >> 6)) * 85);
    g = cast(u32)((3 - ((index >> 4) & 3)) * 85);
    b = cast(u32)((3 - ((index >> 2) & 3)) * 85);
    return (r << 24) | (g << 16) | (b << 8) | 0xFF;
}

ActiveColour :: (s: *State) -> u32 {
    return ifx s.erase then COLOR_WHITE else s.pen_colour;
}

ActiveWidth :: (s: *State) -> s32 {
    return ifx s.erase then ERASE_WIDTH else s.pen_width;
}

AppendSigned :: (out: *Text, value: s64) {
    buf: [24]u8;
    unused BuilderAppend(out.bytes, FormatInteger(value, buf[:]));
}

FormatStroke :: (colour: u32, width: s32, p0: Point, p1: Point, out: *Text) {
    unused VecResize(out.bytes, 0);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)cast(s32)colour);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)width);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)p0.x);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)p0.y);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)p1.x);
    unused BuilderAppend(out.bytes, " ");
    AppendSigned(out, cast(s64)p1.y);
    unused BuilderAppend(out.bytes, "\n");
}

ParseIntToken :: (data: string, pos: *s64) -> (value: s64, ok: bool) {
    n := data.count;
    i := <<pos;
    while i < n && (data[i] == 32 || data[i] == 9 || data[i] == 10 || data[i] == 13) { i += 1 }
    if i >= n { <<pos = i; return 0, false }
    neg := false;
    if data[i] == 45 { neg = true; i += 1 }
    else if data[i] == 43 { i += 1 }
    if i >= n || data[i] < 48 || data[i] > 57 { <<pos = i; return 0, false }
    v: s64 = 0;
    while i < n && data[i] >= 48 && data[i] <= 57 {
        v = v * 10 + cast(s64)(data[i] - 48);
        i += 1;
    }
    <<pos = i;
    return ifx neg then -v else v, true;
}

ParseStrokeLine :: (line: string, out: *Stroke) -> bool {
    out.count = 0;
    pos: s64 = 0;
    col_val, col_ok := ParseIntToken(line, *pos);
    if !col_ok { return false }
    w_val, w_ok := ParseIntToken(line, *pos);
    if !w_ok { return false }
    out.colour = cast(u32)cast(s32)col_val;
    out.width = cast(s32)w_val;
    while out.count < 128 {
        x_val, x_ok := ParseIntToken(line, *pos);
        if !x_ok { break }
        y_val, y_ok := ParseIntToken(line, *pos);
        if !y_ok { break }
        out.points[out.count] = .{x = cast(s32)x_val, y = cast(s32)y_val};
        out.count += 1;
    }
    return out.count >= 2;
}

HitToolbar :: (x: s32, y: s32, canvas_h: s32) -> ToolHit {
    if y < canvas_h || y >= canvas_h + TOOLBAR_H { return .None }
    if x >= 4 && x < 44 { return .Pen0 }
    if x >= 48 && x < 88 { return .Pen1 }
    if x >= 92 && x < 132 { return .Pen2 }
    if x >= 136 && x < 192 { return .Erase }
    if x >= 200 && x < CANVAS_W - 4 { return .Colour }
    return .None;
}

PlotDisc :: (rgba: []u8, width: s32, height: s32, cx: s32, cy: s32, radius: s32, colour: u32) {
    r := ifx radius < 0 then 0 else radius;
    red := cast(u8)((colour >> 24) & 0xFF);
    green := cast(u8)((colour >> 16) & 0xFF);
    blue := cast(u8)((colour >> 8) & 0xFF);
    rr := r * r;
    for dy: -r..r {
        py := cy + dy;
        if py < 0 || py >= height { continue }
        for dx: -r..r {
            if dx * dx + dy * dy > rr { continue }
            px := cx + dx;
            if px < 0 || px >= width { continue }
            off := (cast(s64)py * cast(s64)width + cast(s64)px) * 4;
            if off + 3 >= rgba.count { continue }
            rgba[off] = red;
            rgba[off + 1] = green;
            rgba[off + 2] = blue;
            rgba[off + 3] = 255;
        }
    }
}

DrawLine :: (rgba: []u8, width: s32, height: s32, p0: Point, p1: Point, radius: s32, colour: u32) {
    x0 := p0.x;
    y0 := p0.y;
    x1 := p1.x;
    y1 := p1.y;
    dx := ifx x1 >= x0 then x1 - x0 else x0 - x1;
    dy := ifx y1 >= y0 then y1 - y0 else y0 - y1;
    sx: s32 = ifx x0 < x1 then 1 else -1;
    sy: s32 = ifx y0 < y1 then 1 else -1;
    err := dx - dy;
    while true {
        PlotDisc(rgba, width, height, x0, y0, radius, colour);
        if x0 == x1 && y0 == y1 { break }
        e2 := err * 2;
        if e2 > -dy { err -= dy; x0 += sx }
        if e2 < dx { err += dx; y0 += sy }
    }
}

ParseFileSize :: (metadata: []u8) -> s64 {
    if metadata.count < 8 { return -1 }
    value: u64 = 0;
    for i: 0..7 {
        value |= (cast(u64)metadata[i]) << (cast(u64)i * 8);
    }
    return cast(s64)value;
}
