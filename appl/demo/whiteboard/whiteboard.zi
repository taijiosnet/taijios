// Inferno demo collaborative whiteboard client, ported from appl/demo/whiteboard/whiteboard.b.
#import "std/vec"
using Args :: #import "taijios_args"
using IO :: #import "taijios_io"
using Surface :: #import "zx_surface"
using Model :: #import "whiteboard_model"

ORDWR :: 2;
SEEK_START :: 0;
WIN_W :: Model.CANVAS_W;
WIN_H :: Model.CANVAS_H + Model.TOOLBAR_H;

canvas_rgba: [Model.CANVAS_W * Model.CANVAS_H * 4]u8;
frame_rgba: [WIN_W * WIN_H * 4]u8;
state: Model.State;
strokes_path: Text;
strokes_fd: s32 = -1;

FillRect :: (buf: []u8, bw: s32, bh: s32, x0: s32, y0: s32, w: s32, h: s32, colour: u32) {
    r := cast(u8)((colour >> 24) & 0xFF);
    g := cast(u8)((colour >> 16) & 0xFF);
    b := cast(u8)((colour >> 8) & 0xFF);
    for dy: 0..h-1 {
        py := y0 + dy;
        if py < 0 || py >= bh { continue }
        for dx: 0..w-1 {
            px := x0 + dx;
            if px < 0 || px >= bw { continue }
            off := (cast(s64)py * cast(s64)bw + cast(s64)px) * 4;
            if off + 3 >= buf.count { continue }
            buf[off] = r;
            buf[off + 1] = g;
            buf[off + 2] = b;
            buf[off + 3] = 255;
        }
    }
}

DrawBorder :: (buf: []u8, bw: s32, bh: s32, x0: s32, y0: s32, w: s32, h: s32, colour: u32) {
    FillRect(buf, bw, bh, x0, y0, w, 1, colour);
    FillRect(buf, bw, bh, x0, y0 + h - 1, w, 1, colour);
    FillRect(buf, bw, bh, x0, y0, 1, h, colour);
    FillRect(buf, bw, bh, x0 + w - 1, y0, 1, h, colour);
}

RenderFrame :: () -> bool {
    // Copy canvas into top of frame.
    canvas_bytes := Model.CANVAS_W * Model.CANVAS_H * 4;
    for i: 0..canvas_bytes-1 { frame_rgba[i] = canvas_rgba[i] }

    // If colour picker overlay is active, draw 16x16 CMAP8 grid on top-right of canvas.
    if state.picking_colour {
        gx: s32 = 188;
        gy: s32 = 88;
        cell: s32 = 14;
        FillRect(frame_rgba[:], WIN_W, WIN_H, gx - 4, gy - 4, 16 * cell + 8, 16 * cell + 8, 0xDDDDDDFF);
        DrawBorder(frame_rgba[:], WIN_W, WIN_H, gx - 4, gy - 4, 16 * cell + 8, 16 * cell + 8, 0x222222FF);
        for row: 0..15 {
            for col: 0..15 {
                r32 := cast(s32)row;
                c32 := cast(s32)col;
                c := Model.CmapToRGBA(r32 * 16 + c32);
                FillRect(frame_rgba[:], WIN_W, WIN_H, gx + c32 * cell, gy + r32 * cell, cell, cell, c);
            }
        }
    }

    // Toolbar background.
    ty: s32 = Model.CANVAS_H;
    FillRect(frame_rgba[:], WIN_W, WIN_H, 0, ty, WIN_W, Model.TOOLBAR_H, 0xE6E6E6FF);
    FillRect(frame_rgba[:], WIN_W, WIN_H, 0, ty, WIN_W, 1, 0x888888FF);

    // Pen 0, 1, 2 buttons.
    for i: 0..2 {
        bx: s32 = 4 + cast(s32)i * 44;
        selected := !state.erase && state.pen_width == cast(s32)i;
        bg: u32 = ifx selected then 0xB8D4F8FF else 0xFFFFFFFF;
        FillRect(frame_rgba[:], WIN_W, WIN_H, bx, ty + 4, 40, 28, bg);
        DrawBorder(frame_rgba[:], WIN_W, WIN_H, bx, ty + 4, 40, 28, 0x333333FF);
        Model.PlotDisc(frame_rgba[:], WIN_W, WIN_H, bx + 20, ty + 18, cast(s32)i + 1, 0x000000FF);
    }

    // Erase button.
    ebg: u32 = ifx state.erase then 0xB8D4F8FF else 0xFFFFFFFF;
    FillRect(frame_rgba[:], WIN_W, WIN_H, 136, ty + 4, 56, 28, ebg);
    DrawBorder(frame_rgba[:], WIN_W, WIN_H, 136, ty + 4, 56, 28, 0x333333FF);
    FillRect(frame_rgba[:], WIN_W, WIN_H, 154, ty + 12, 20, 12, 0xFFFFFFFF);
    DrawBorder(frame_rgba[:], WIN_W, WIN_H, 154, ty + 12, 20, 12, 0x222222FF);

    // Colour swatch button.
    FillRect(frame_rgba[:], WIN_W, WIN_H, 200, ty + 4, WIN_W - 204, 28, state.pen_colour);
    DrawBorder(frame_rgba[:], WIN_W, WIN_H, 200, ty + 4, WIN_W - 204, 28, 0x222222FF);

    return Surface.Present(WIN_W, WIN_H, TextView(frame_rgba[:]));
}

ApplyStrokeText :: (text: string) -> bool {
    changed := false;
    start: s64 = 0;
    for i: 0..text.count {
        if i == text.count || text[i] == 10 {
            if i > start {
                stroke: Model.Stroke;
                if Model.ParseStrokeLine(text[start:i], *stroke) {
                    for p: 1..stroke.count-1 {
                        Model.DrawLine(canvas_rgba[:], Model.CANVAS_W, Model.CANVAS_H,
                                       stroke.points[p - 1], stroke.points[p], stroke.width, stroke.colour);
                    }
                    changed = true;
                }
            }
            start = i + 1;
        }
    }
    return changed;
}

PollRemoteStrokes :: () -> bool {
    if !state.connected || strokes_fd < 0 { return false }
    meta: [12]u8;
    if IO.Stat(TextView(strokes_path), meta[:]) != 0 { return false }
    size := Model.ParseFileSize(meta[:]);
    if size <= state.read_offset { return false }
    if IO.Seek(strokes_fd, state.read_offset, SEEK_START) < 0 { return false }
    buf: [4096]u8;
    changed := false;
    while state.read_offset < size {
        n := IO.Read(strokes_fd, buf[:]);
        if n <= 0 { break }
        state.read_offset += cast(s64)n;
        if ApplyStrokeText(TextView(buf[:n])) { changed = true }
    }
    return changed;
}

SendStroke :: (colour: u32, width: s32, p0: Model.Point, p1: Model.Point) {
    if !state.connected || strokes_fd < 0 { return }
    wire: Text;
    Model.FormatStroke(colour, width, p0, p1, *wire);
    if IO.Write(strokes_fd, TextView(wire)) < 0 {
        unused IO.Close(strokes_fd);
        strokes_fd = -1;
        state.connected = false;
        unused Surface.SetTitle("Whiteboard (Disconnected)");
    } else {
        state.read_offset += wire.bytes.count;
    }
}

main :: () -> s32 {
    servicedir := ".";
    if Args.OperandCount() > 0 { servicedir = Args.Operand(0) }
    Model.InitState(*state);
    Model.ServicePath(servicedir, "strokes", *strokes_path);

    // Clear canvas to white.
    FillRect(canvas_rgba[:], Model.CANVAS_W, Model.CANVAS_H, 0, 0, Model.CANVAS_W, Model.CANVAS_H, Model.COLOR_WHITE);

    // Connect to strokes service if available.
    fd := IO.Open(TextView(strokes_path), ORDWR);
    if fd >= 0 {
        strokes_fd = fd;
        state.connected = true;
        unused PollRemoteStrokes();
    }

    if !Surface.Open("Whiteboard", WIN_W, WIN_H) { return 1 }
    defer Surface.Close();
    if !RenderFrame() { return 1 }

    while true {
        event := Surface.Event(50);
        if event.kind == Surface.Closed { break }
        dirty := false;
        if event.kind == Surface.Redraw || event.kind == Surface.Resize {
            dirty = true;
        } else if event.kind == Surface.Down && event.button == 1 {
            if state.picking_colour {
                gx: s32 = 188;
                gy: s32 = 88;
                cell: s32 = 14;
                if event.x >= gx && event.x < gx + 16 * cell && event.y >= gy && event.y < gy + 16 * cell {
                    col := (event.x - gx) / cell;
                    row := (event.y - gy) / cell;
                    state.pen_colour = Model.CmapToRGBA(row * 16 + col);
                    state.erase = false;
                }
                state.picking_colour = false;
                dirty = true;
            } else if event.y >= Model.CANVAS_H {
                hit := Model.HitToolbar(event.x, event.y, Model.CANVAS_H);
                if hit == .Pen0 { state.pen_width = 0; state.erase = false; dirty = true }
                else if hit == .Pen1 { state.pen_width = 1; state.erase = false; dirty = true }
                else if hit == .Pen2 { state.pen_width = 2; state.erase = false; dirty = true }
                else if hit == .Erase { state.erase = true; dirty = true }
                else if hit == .Colour { state.picking_colour = true; dirty = true }
            } else if event.x >= 0 && event.x < Model.CANVAS_W && event.y >= 0 && event.y < Model.CANVAS_H {
                state.pen_down = true;
                state.last_x = event.x;
                state.last_y = event.y;
                p := Model.Point.{x = event.x, y = event.y};
                Model.DrawLine(canvas_rgba[:], Model.CANVAS_W, Model.CANVAS_H, p, p, Model.ActiveWidth(*state), Model.ActiveColour(*state));
                SendStroke(Model.ActiveColour(*state), Model.ActiveWidth(*state), p, p);
                dirty = true;
            }
        } else if event.kind == Surface.Move && state.pen_down {
            if event.x >= 0 && event.x < Model.CANVAS_W && event.y >= 0 && event.y < Model.CANVAS_H {
                if event.x != state.last_x || event.y != state.last_y {
                    p0 := Model.Point.{x = state.last_x, y = state.last_y};
                    p1 := Model.Point.{x = event.x, y = event.y};
                    Model.DrawLine(canvas_rgba[:], Model.CANVAS_W, Model.CANVAS_H, p0, p1, Model.ActiveWidth(*state), Model.ActiveColour(*state));
                    SendStroke(Model.ActiveColour(*state), Model.ActiveWidth(*state), p0, p1);
                    state.last_x = event.x;
                    state.last_y = event.y;
                    dirty = true;
                }
            }
        } else if event.kind == Surface.Up && event.button == 1 {
            state.pen_down = false;
        }
        if PollRemoteStrokes() { dirty = true }
        if dirty {
            if !RenderFrame() { return 1 }
        }
    }

    if strokes_fd >= 0 {
        unused IO.Close(strokes_fd);
        strokes_fd = -1;
    }
    return 0;
}
