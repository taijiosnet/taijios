// Kodak DC260 CDP (Camera Device Protocol) packet framing, encoding/decoding,
// thumbnail YCbCr -> Inferno r8g8b8 bit conversion, and capabilities parser,
// ported from appl/demo/camera/camera.b.
#import "std/vec"
#import "std/number_text"

CDP_GET_PRODUCT_INFO :: 0x01;
CDP_GET_IMAGE_SPECS :: 0x02;
CDP_GET_CAMERA_STATUS :: 0x03;
CDP_SET_PRODUCT_INFO :: 0x05;
CDP_GET_CAMERA_CAPABILITIES :: 0x10;
CDP_GET_CAMERA_STATE :: 0x11;
CDP_SET_CAMERA_STATE :: 0x12;
CDP_GET_CAMERA_DEFAULTS :: 0x13;
CDP_SET_CAMERA_DEFAULTS :: 0x14;
CDP_RESTORE_CAMERA_STATES :: 0x15;
CDP_GET_SCENE_ANALYSIS :: 0x18;
CDP_GET_POWER_MODE :: 0x19;
CDP_SET_POWER_MODE :: 0x1a;
CDP_GET_S1_MODE :: 0x1d;
CDP_SET_S1_MODE :: 0x1e;
CDP_START_CAPTURE :: 0x30;
CDP_GET_FILE_LIST :: 0x40;
CDP_GET_NEW_FILE_LIST :: 0x41;
CDP_GET_FILE_DATA :: 0x42;
CDP_ERASE_FILE :: 0x43;
CDP_GET_STORAGE_STATUS :: 0x44;
CDP_SET_FILE_DATA :: 0x47;
CDP_GET_FILE_TAG :: 0x48;
CDP_SET_USER_FILE_TAG :: 0x49;
CDP_GET_CLOCK :: 0x70;
CDP_SET_CLOCK :: 0x71;
CDP_GET_ERROR :: 0x78;
CDP_GET_INTERFACE_TIMEOUT :: 0x90;
CDP_SET_INTERFACE_TIMEOUT :: 0x91;

CDP_HEADER_LEN :: 12;
MAXFILESIZE :: 5000000;

CdpFile :: struct {
    driveno: s32;
    pathname: [32]u8;
    dosname: [16]u8;
    filelength: s32;
    filestatus: s32;
    thumblength: s32;
}

ErrorText :: (code: s32) -> string {
    tbl: [14]string = .[
        "No Error", "Unimplemented", "Unsupported Version", "Application Timeout",
        "Internal Error", "Parameter Error", "File System Null", "File Not Found",
        "Data Section Not Found", "Invalid File Type", "Unknown Drive",
        "Drive Not Mounted", "System Busy", "Battery Low",
    ];
    if code >= 0 && code < 14 { return tbl[code] }
    return "Unknown Error";
}

CheckSum :: (buf: []u8, n: s64) -> u8 {
    sum: u32 = 0;
    for i: 0..n-1 { sum += cast(u32)buf[i] }
    return cast(u8)(sum & 0xff);
}

BeaconOk :: (buf: []u8) -> bool {
    intro: [7]u8 = .[0xa5, 0x5a, 0x00, 0xc8, 0x00, 0x02, 0xc9];
    if buf.count < 7 { return false }
    for i: 0..6 {
        if buf[i] != intro[i] { return false }
    }
    return true;
}

BuildBeaconAck :: (baud: s32, dfs: s32, hfs: s32, out: []u8) {
    out[0] = 0x5a;
    out[1] = 0xa5;
    out[2] = 0x55;
    out[3] = 0x00;
    out[4] = cast(u8)((baud >> 24) & 0xff);
    out[5] = cast(u8)((baud >> 16) & 0xff);
    out[6] = cast(u8)((baud >> 8) & 0xff);
    out[7] = cast(u8)(baud & 0xff);
    out[8] = cast(u8)((dfs >> 8) & 0xff);
    out[9] = cast(u8)(dfs & 0xff);
    out[10] = cast(u8)((hfs >> 8) & 0xff);
    out[11] = cast(u8)(hfs & 0xff);
    out[12] = CheckSum(out, 12);
}

BuildCdpHeader :: (cdp: []u8, cmd: s32, payload_len: s32) -> s32 {
    l := 8 + payload_len;
    cdp[0] = cast(u8)((l >> 24) & 0xff);
    cdp[1] = cast(u8)((l >> 16) & 0xff);
    cdp[2] = cast(u8)((l >> 8) & 0xff);
    cdp[3] = cast(u8)(l & 0xff);
    cdp[4] = 0; cdp[5] = 0; cdp[6] = 0; cdp[7] = 0;
    cdp[8] = cast(u8)((cmd >> 8) & 0xff);
    cdp[9] = cast(u8)(cmd & 0xff);
    cdp[10] = 0;
    cdp[11] = 0;
    return CDP_HEADER_LEN + payload_len;
}

PutBE32 :: (b: []u8, off: s64, v: s32) -> s64 {
    b[off + 0] = cast(u8)((v >> 24) & 0xff);
    b[off + 1] = cast(u8)((v >> 16) & 0xff);
    b[off + 2] = cast(u8)((v >> 8) & 0xff);
    b[off + 3] = cast(u8)(v & 0xff);
    return off + 4;
}

GetBE32 :: (b: []u8, off: s64) -> s32 {
    return (cast(s32)b[off] << 24) | (cast(s32)b[off + 1] << 16) | (cast(s32)b[off + 2] << 8) | cast(s32)b[off + 3];
}

PutFixed :: (b: []u8, off: s64, src: []u8, width: s64) -> s64 {
    for i: 0..width-1 { b[off + i] = 0 }
    n := ifx src.count < width then src.count else width;
    for i: 0..n-1 { b[off + i] = src[i] }
    return off + width;
}

FixedToString :: (b: []u8, out: *Text) {
    unused VecResize(out.bytes, 0);
    n := b.count;
    while n > 0 && b[n - 1] == 0 { n -= 1 }
    if n > 0 { unused BuilderAppend(out.bytes, TextView(b[0:n])) }
}

ToLowerText :: (s: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    for c: s {
        if c >= 65 && c <= 90 { unused VecPush(out.bytes, c + 32) }
        else { unused VecPush(out.bytes, c) }
    }
}

JpgToBitName :: (s: string, out: *Text) {
    unused VecResize(out.bytes, 0);
    if s.count >= 4 && s[s.count - 4:] == ".jpg" {
        unused BuilderAppend(out.bytes, s[0:s.count - 4]);
        unused BuilderAppend(out.bytes, ".bit");
    } else {
        unused BuilderAppend(out.bytes, s);
    }
}

IntToBcd :: (v: s32) -> u8 {
    tens := (v / 10) % 10;
    ones := v % 10;
    return cast(u8)((tens << 4) | ones);
}

BcdToInt :: (b: u8) -> s32 {
    return cast(s32)((b >> 4) & 0xf) * 10 + cast(s32)(b & 0xf);
}

Append2Digits :: (out: *Text, v: s32) {
    d := ifx v < 0 then 0 else v;
    unused VecPush(out.bytes, cast(u8)(48 + ((d / 10) % 10)));
    unused VecPush(out.bytes, cast(u8)(48 + (d % 10)));
}

FormatClockResponse :: (cdp: []u8, out: *Text) {
    unused VecResize(out.bytes, 0);
    if cdp.count < 20 {
        unused BuilderAppend(out.bytes, "Could not read clock\n");
        return;
    }
    unused BuilderAppend(out.bytes, "date is ");
    Append2Digits(out, BcdToInt(cdp[13])); unused BuilderAppend(out.bytes, "/");
    Append2Digits(out, BcdToInt(cdp[14])); unused BuilderAppend(out.bytes, "/");
    Append2Digits(out, BcdToInt(cdp[15])); unused BuilderAppend(out.bytes, " ");
    Append2Digits(out, BcdToInt(cdp[17])); unused BuilderAppend(out.bytes, ":");
    Append2Digits(out, BcdToInt(cdp[18])); unused BuilderAppend(out.bytes, ":");
    Append2Digits(out, BcdToInt(cdp[19])); unused BuilderAppend(out.bytes, "\n");
}

Contains :: (s: string, sub: string) -> bool {
    if sub.count == 0 { return true }
    if sub.count > s.count { return false }
    for i: 0..s.count - sub.count {
        if s[i:i + sub.count] == sub { return true }
    }
    return false;
}

FilterAbility :: (desc: string) -> bool {
    filt: [13]string = .[
        "Time Format", "Date Format", "File Type", "Video", "Media",
        "Sound", "Volume", "Reset Camera", "Slide", "Timelapse",
        "Burst", "Power", "Sleep",
    ];
    for i: 0..12 {
        if Contains(desc, filt[i]) { return true }
    }
    return false;
}

ClampByte :: (v: s32) -> u8 {
    r := ifx v < 0 then -v else v;
    if r > 255 { r = 255 }
    return cast(u8)r;
}

AppendPadded11 :: (out: *Vec(u8), s: string) {
    pad := 11 - s.count;
    while pad > 0 { unused VecPush(<<out, 32); pad -= 1 }
    unused BuilderAppend(<<out, s);
    unused VecPush(<<out, 32);
}

// Convert Kodak DC260 YCbCr 4:2:2 thumbnail bytes into an Inferno r8g8b8 image file.
ThumbToBit :: (ycbcr: []u8, w: s32, h: s32, out: *Vec(u8)) {
    unused VecResize(<<out, 0);
    if w <= 0 || h <= 0 { return }
    b1: [16]u8; b2: [16]u8;
    AppendPadded11(out, "r8g8b8");
    AppendPadded11(out, "0");
    AppendPadded11(out, "0");
    AppendPadded11(out, FormatInteger(cast(s64)w, b1[:]));
    AppendPadded11(out, FormatInteger(cast(s64)h, b2[:]));

    pairs := (w * h) / 2;
    idx: s64 = 0;
    for i: 0..pairs-1 {
        if idx + 2 >= ycbcr.count {
            for k: 0..5 { unused VecPush(<<out, 0) }
            continue;
        }
        cb := cast(s32)ycbcr[idx] - 128;
        y := cast(s32)ycbcr[idx + 1];
        cr := cast(s32)ycbcr[idx + 2] - 128;
        // Fixed-point matching camera.b's YCbCr->RGB coefficients
        rb := ClampByte(y + (1772 * cb) / 1000);
        gb := ClampByte(y - (344 * cb + 714 * cr) / 1000);
        bb := ClampByte(y + (1402 * cr) / 1000);
        for rep: 0..1 {
            unused VecPush(<<out, rb);
            unused VecPush(<<out, gb);
            unused VecPush(<<out, bb);
        }
        idx += 4;
    }
}
