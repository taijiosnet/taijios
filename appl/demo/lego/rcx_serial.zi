// Lego RCX serial port I/O with non-blocking PollRead timeouts,
// ported from appl/demo/lego/rcxsend.b and timers.b.
#import "std/vec"
#import "std/number_text"
using Clock :: #import "taijios_clock"
using IO :: #import "taijios_io"
using Proto :: #import "rcx_protocol"

SerialPort :: struct {
    rfd: s32;
    wfd: s32;
    ctlfd: s32;
    overrun: Vec(u8);
    debug: bool;
}

OpenSerial :: (sp: *SerialPort, portnum: s32, debug: bool, err: *Text) -> bool {
    unused VecResize(err.bytes, 0);
    unused VecResize(sp.overrun, 0);
    sp.rfd = -1;
    sp.wfd = -1;
    sp.ctlfd = -1;
    sp.debug = debug;

    buf: [24]u8;
    serport: Text;
    unused BuilderAppend(serport.bytes, "/dev/eia");
    unused BuilderAppend(serport.bytes, FormatInteger(cast(s64)portnum, buf[:]));
    serctl: Text;
    unused BuilderAppend(serctl.bytes, TextView(serport));
    unused BuilderAppend(serctl.bytes, "ctl");

    sp.rfd = IO.Open(TextView(serport), 0);
    if sp.rfd < 0 {
        unused BuilderAppend(err.bytes, "cannot read ");
        unused BuilderAppend(err.bytes, TextView(serport));
        unused BuilderAppend(err.bytes, ": ");
        unused BuilderAppend(err.bytes, IO.Error());
        return false;
    }
    sp.wfd = IO.Open(TextView(serport), 1);
    if sp.wfd < 0 {
        unused IO.Close(sp.rfd);
        sp.rfd = -1;
        unused BuilderAppend(err.bytes, "cannot write ");
        unused BuilderAppend(err.bytes, TextView(serport));
        unused BuilderAppend(err.bytes, ": ");
        unused BuilderAppend(err.bytes, IO.Error());
        return false;
    }
    sp.ctlfd = IO.Open(TextView(serctl), 1);
    if sp.ctlfd < 0 {
        unused IO.Close(sp.rfd);
        unused IO.Close(sp.wfd);
        sp.rfd = -1;
        sp.wfd = -1;
        unused BuilderAppend(err.bytes, "cannot open ");
        unused BuilderAppend(err.bytes, TextView(serctl));
        unused BuilderAppend(err.bytes, ": ");
        unused BuilderAppend(err.bytes, IO.Error());
        return false;
    }

    configs: [7]string = .["b2400", "l8", "po", "m0", "s1", "d1", "r1"];
    for configs {
        if IO.Write(sp.ctlfd, it) <= 0 {
            unused BuilderAppend(err.bytes, "serial config (");
            unused BuilderAppend(err.bytes, it);
            unused BuilderAppend(err.bytes, "): ");
            unused BuilderAppend(err.bytes, IO.Error());
            return false;
        }
    }
    return true;
}

CloseSerial :: (sp: *SerialPort) {
    if sp.rfd >= 0 { unused IO.Close(sp.rfd); sp.rfd = -1 }
    if sp.wfd >= 0 { unused IO.Close(sp.wfd); sp.wfd = -1 }
    if sp.ctlfd >= 0 { unused IO.Close(sp.ctlfd); sp.ctlfd = -1 }
}

NbRead :: (sp: *SerialPort, ms: s64, want: s64, out: *Vec(u8)) -> s64 {
    unused VecResize(<<out, 0);
    if sp.overrun.count > 0 {
        take := ifx sp.overrun.count > want then want else sp.overrun.count;
        for i: 0..take-1 { unused VecPush(<<out, sp.overrun[i]) }
        rem := sp.overrun.count - take;
        for i: 0..rem-1 { sp.overrun[i] = sp.overrun[take + i] }
        unused VecResize(sp.overrun, rem);
        if out.count >= want { return out.count }
    }

    deadline := Clock.Millis() + ms;
    buf: [256]u8;
    while out.count < want {
        n := IO.PollRead(sp.rfd, buf[:]);
        if n > 0 {
            need := want - out.count;
            take := ifx cast(s64)n > need then need else cast(s64)n;
            for i: 0..take-1 { unused VecPush(<<out, buf[i]) }
            for i: take..cast(s64)n-1 { unused VecPush(sp.overrun, buf[i]) }
            deadline = Clock.Millis() + ms;
        } else if n == -2 {
            if Clock.Millis() >= deadline { break }
        } else {
            break;
        }
    }
    return out.count;
}

Consume :: (sp: *SerialPort) {
    trash: Vec(u8);
    while NbRead(sp, 300, 1024, *trash) > 0 {}
}

SendRcx :: (sp: *SerialPort, payload: []u8, rlen: s32, reply_out: *Vec(u8)) -> bool {
    unused VecResize(<<reply_out, 0);
    obuf: Vec(u8);
    Proto.EncodeRcxPacket(payload, *obuf);
    oslice := VecSlice(obuf, 0, obuf.count);
    needr: s64 = cast(s64)rlen;
    if rlen > 0 { needr = Proto.TX_HDR + 2 * cast(s64)rlen + Proto.TX_CKSM }

    echo: Vec(u8);
    raw_reply: Vec(u8);
    for try: 0..4 {
        ok := true;
        i: s64 = 0;
        while ok && i < oslice.count {
            step: s64 = 8;
            if i + step > oslice.count { step = oslice.count - i }
            if IO.Write(sp.wfd, TextView(oslice[i:i + step])) != cast(s32)step { return false }
            if NbRead(sp, 200, step, *echo) != step { ok = false; break }
            for ei: 0..step-1 {
                if echo[ei] != oslice[i + ei] { ok = false; break }
            }
            i += step;
        }
        if ok {
            if needr == 0 { return true }
            if needr == -1 {
                unused NbRead(sp, 300, 1024, *raw_reply);
            } else {
                unused NbRead(sp, 200, needr, *raw_reply);
            }
            if raw_reply.count >= needr {
                err := Proto.DecodeRcxReply(VecSlice(raw_reply, 0, raw_reply.count), reply_out);
                if err.count == 0 { return true }
            }
        }
        Consume(sp);
    }
    return false;
}
