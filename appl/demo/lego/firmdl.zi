// Lego RCX firmware downloader (Motorola S-record over IR serial),
// ported from appl/demo/lego/firmdl.b.
#import "std/vec"
using Args :: #import "taijios_args"
using IO :: #import "taijios_io"
using Proto :: #import "rcx_protocol"
using Serial :: #import "rcx_serial"

ParseInt :: (s: string) -> s32 {
    v: s32 = 0;
    for i: 0..s.count-1 {
        if s[i] < 48 || s[i] > 57 { break }
        v = v * 10 + cast(s32)(s[i] - 48);
    }
    return v;
}

Fail :: (msg: string) -> s32 {
    print("%\n", msg);
    unused Args.SetFailure("error");
    return 1;
}

CheckReply :: (got: []u8, expect: []u8, label: string) -> bool {
    if got.count < expect.count {
        print("%: short reply\n", label);
        return false;
    }
    first := got[0] & 0xF7;
    if first != expect[0] {
        print("%: reply mismatch at 0\n", label);
        return false;
    }
    for i: 1..expect.count-1 {
        if got[i] != expect[i] {
            print("%: reply mismatch at %\n", label, i);
            return false;
        }
    }
    return true;
}

main :: () -> s32 {
    if Args.OperandCount() != 2 {
        return Fail("usage: portnum file");
    }
    portnum := ParseInt(Args.Operand(0));
    path := Args.Operand(1);

    fd := IO.Open(path, 0);
    if fd < 0 {
        print("cannot open %: %\n", path, IO.Error());
        unused Args.SetFailure("error");
        return 1;
    }
    srec: Text;
    buf: [4096]u8;
    while true {
        n := IO.Read(fd, buf[:]);
        if n <= 0 { break }
        unused BuilderAppend(srec.bytes, TextView(buf[:n]));
    }
    unused IO.Close(fd);

    img: Proto.FirmImage;
    perr := Proto.ParseSrec(TextView(srec), *img);
    if perr.count > 0 { return Fail(perr) }

    cksum := Proto.SumBytes(img.data[:img.length]);
    print("length % start %\n", img.length, img.start);

    sp: Serial.SerialPort;
    serr: Text;
    if !Serial.OpenSerial(*sp, portnum, true, *serr) {
        return Fail(TextView(serr));
    }
    Serial.Consume(*sp);

    reply: Vec(u8);

    // 1. Delete firmware
    print("delete firmware\n");
    rmfirm: [6]u8 = .[0x65, 1, 3, 5, 7, 11];
    exp_rm: [1]u8 = .[0x92];
    if !Serial.SendRcx(*sp, rmfirm[:], 1, *reply) || !CheckReply(VecSlice(reply, 0, reply.count), exp_rm[:], "delete firmware") {
        Serial.CloseSerial(*sp);
        return Fail("delete firmware failed");
    }

    // 2. Start download
    print("start download\n");
    dlstart: [6]u8 = .[
        0x75,
        cast(u8)(img.start & 0xFF),
        cast(u8)((img.start >> 8) & 0xFF),
        cast(u8)(cksum & 0xFF),
        cast(u8)((cksum >> 8) & 0xFF),
        0,
    ];
    exp_dl: [2]u8 = .[0x82, 0];
    if !Serial.SendRcx(*sp, dlstart[:], 2, *reply) || !CheckReply(VecSlice(reply, 0, reply.count), exp_dl[:], "start download") {
        Serial.CloseSerial(*sp);
        return Fail("start download failed");
    }

    // 3. Send image in DL_DATA (200-byte) chunks
    pkt: [5 + Proto.DL_DATA + 1]u8;
    exp_tx: [2]u8 = .[0xB2, 0];
    seqnum: s32 = 1;
    i: s32 = 0;
    while i < img.length {
        step: s32 = Proto.DL_DATA;
        pkt[0] = ifx (seqnum & 1) != 0 then 0x4D else 0x45;
        if i + step > img.length {
            step = img.length - i;
            seqnum = 0;
        }
        pkt[1] = cast(u8)(seqnum & 0xFF);
        pkt[2] = cast(u8)((seqnum >> 8) & 0xFF);
        pkt[3] = cast(u8)(step & 0xFF);
        pkt[4] = cast(u8)((step >> 8) & 0xFF);
        for k: 0..step-1 { pkt[5 + k] = img.data[i + k] }
        pkt[5 + step] = cast(u8)(Proto.SumBytes(img.data[i:i + step]) & 0xFF);
        if !Serial.SendRcx(*sp, pkt[:5 + step + 1], 2, *reply) || !CheckReply(VecSlice(reply, 0, reply.count), exp_tx[:], "tx data") {
            Serial.CloseSerial(*sp);
            return Fail("tx data failed");
        }
        seqnum += 1;
        i += step;
    }

    // 4. Unlock firmware
    print("\nunlock firmware\n");
    ulfirm: [6]u8 = .[0xA5, 76, 69, 71, 79, 174];
    exp_ul: [1]u8 = .[0x52];
    if !Serial.SendRcx(*sp, ulfirm[:], 26, *reply) || !CheckReply(VecSlice(reply, 0, reply.count), exp_ul[:], "unlock firmware") {
        Serial.CloseSerial(*sp);
        return Fail("unlock firmware failed");
    }
    if reply.count > 1 {
        print("result: %\n", TextView(VecSlice(reply, 1, reply.count)));
    }
    Serial.CloseSerial(*sp);
    return 0;
}
