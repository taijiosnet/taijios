// Pure Lego RCX IR framing, Motorola S-record parser, and RLE link codec,
// ported from appl/demo/lego/rcxsend.b, firmdl.b, and legolink.b.
#import "std/vec"

TX_HDR :: 3;
TX_CKSM :: 2;
IMGSTART :: 0x8000;
IMGLEN :: 0x4C00;
DL_DATA :: 0xC8;
POLLDONT :: 0;
POLLNOW :: 0x02;
POLLDO :: 0x04;
LN_POLLMASK :: 0x06;
LN_COMPMASK :: 0x08;

FirmImage :: struct {
    start: s32;
    offset: s32;
    length: s32;
    data: [IMGLEN]u8;
}

SumBytes :: (data: []u8) -> s32 {
    t: s32 = 0;
    for i: 0..data.count-1 { t += cast(s32)data[i] }
    return t;
}

// Frame an RCX IR packet: 0x55 0xFF 0x00 (d[i] ~d[i])* cksum ~cksum
EncodeRcxPacket :: (payload: []u8, out: *Vec(u8)) {
    unused VecResize(<<out, 0);
    unused VecPush(<<out, 0x55);
    unused VecPush(<<out, 0xFF);
    unused VecPush(<<out, 0x00);
    cksum: s32 = 0;
    for i: 0..payload.count-1 {
        b := payload[i];
        unused VecPush(<<out, b);
        unused VecPush(<<out, ~b);
        cksum += cast(s32)b;
    }
    cb := cast(u8)(cksum & 0xFF);
    unused VecPush(<<out, cb);
    unused VecPush(<<out, ~cb);
}

// Decode an RCX IR reply packet; returns "" on success or error reason.
DecodeRcxReply :: (raw: []u8, out: *Vec(u8)) -> string {
    unused VecResize(<<out, 0);
    if raw.count < TX_HDR + TX_CKSM { return "short reply" }
    if raw[0] != 0x55 || raw[1] != 0xFF || raw[2] != 0x00 { return "reply header error" }
    body_len := raw.count - TX_HDR - TX_CKSM;
    if (body_len & 1) != 0 { return "short reply" }
    n := body_len / 2;
    sum: s32 = 0;
    for i: 0..n-1 {
        b := raw[TX_HDR + i * 2];
        unused VecPush(<<out, b);
        sum += cast(s32)b;
    }
    cksum := cast(s32)raw[raw.count - TX_CKSM];
    if cksum != (sum & 0xFF) {
        unused VecResize(<<out, 0);
        return "bad cksum";
    }
    return "";
}

HexDigit :: (c: u8) -> s32 {
    if c >= 48 && c <= 57 { return cast(s32)(c - 48) }
    if c >= 65 && c <= 70 { return cast(s32)(10 + c - 65) }
    if c >= 97 && c <= 102 { return cast(s32)(10 + c - 97) }
    return -1;
}

HexToBytes :: (s: string, out: *Vec(u8)) -> bool {
    unused VecResize(<<out, 0);
    if (s.count & 1) != 0 { return false }
    i: s64 = 0;
    while i < s.count {
        d1 := HexDigit(s[i]);
        d2 := HexDigit(s[i + 1]);
        if d1 < 0 || d2 < 0 { return false }
        unused VecPush(<<out, cast(u8)((d1 << 4) | d2));
        i += 2;
    }
    return true;
}

WordVal :: (src: []u8, start: s64, length: s64) -> s32 {
    r: s32 = 0;
    for i: 0..length-1 {
        r = (r << 8) + cast(s32)src[start + i];
    }
    return r;
}

// Parse Motorola S-record firmware text into FirmImage; returns "" on success or error message.
ParseSrec :: (text: string, img: *FirmImage) -> string {
    img.start = IMGSTART;
    img.offset = IMGSTART;
    img.length = 0;
    for i: 0..IMGLEN-1 { img.data[i] = 0 }

    bytes: Vec(u8);
    line_start: s64 = 0;
    for pos: 0..text.count {
        if pos < text.count && text[pos] != 10 { continue }
        line_end := pos;
        while line_end > line_start && (text[line_end - 1] == 32 || text[line_end - 1] == 13 || text[line_end - 1] == 10) {
            line_end -= 1;
        }
        line := text[line_start:line_end];
        line_start = pos + 1;
        if line.count == 0 { continue }
        if line.count < 10 { return "short S-record" }
        t := line[1];
        if line[0] != 83 || t < 48 || t > 57 { return "bad S-record format" }
        if !HexToBytes(line[2:], *bytes) { return "bad chars in S-record" }
        bs := VecSlice(bytes, 0, bytes.count);
        count := cast(s64)bs[0];
        if count != bs.count - 1 { return "S-record length mis-match" }
        if (SumBytes(bs) & 0xFF) != 0xFF { return "bad S-record checksum" }

        if t == 48 || t == 53 || t == 54 { continue } // S0, S5, S6
        if t == 52 { return "bad S-record type" } // S4
        if t == 55 { img.start = WordVal(bs, 1, 4); continue } // S7
        if t == 56 { img.start = WordVal(bs, 1, 3); continue } // S8
        if t == 57 { img.start = WordVal(bs, 1, 2); continue } // S9

        alen: s64 = 2;
        if t == 50 { alen = 3 }
        else if t == 51 { alen = 4 }

        addr := WordVal(bs, 1, alen) - img.offset;
        dlen := count - (alen + 1);
        if addr < 0 || cast(s64)addr + dlen > IMGLEN { return "S-record address out of range" }
        for k: 0..dlen-1 {
            img.data[cast(s64)addr + k] = bs[1 + alen + k];
        }
        end_addr := addr + cast(s32)dlen;
        if end_addr > img.length { img.length = end_addr }
    }
    return "";
}

// Zero-run-length encoder from appl/demo/lego/legolink.b (0x88 escape).
RlEncode :: (data: []u8, out: *Vec(u8)) {
    unused VecResize(<<out, 0);
    srcix: s64 = 0;
    nextval: s32 = -1;
    n0: s32 = 0;
    while srcix < data.count || nextval != -1 {
        val: s32 = 0;
        if nextval != -1 {
            val = nextval;
            nextval = -1;
        } else {
            val = cast(s32)data[srcix];
            if val == 0x88 { nextval = 0 }
            if val == 0 {
                n0 += 1;
                srcix += 1;
                if srcix < data.count && n0 < 0xFF + 2 { continue }
            }
            if n0 == 0 {
                srcix += 1;
            } else if n0 == 1 {
                val = 0;
                nextval = -1;
                n0 = 0;
            } else if n0 == 2 {
                val = 0;
                nextval = 0;
                n0 = 0;
            } else {
                val = 0x88;
                nextval = n0 - 2;
                n0 = 0;
            }
        }
        unused VecPush(<<out, cast(u8)val);
    }
}

// Zero-run-length decoder from appl/demo/lego/legolink.b.
RlDecode :: (data: []u8, out: *Vec(u8)) -> bool {
    unused VecResize(<<out, 0);
    srcix: s64 = 0;
    n0: s32 = 0;
    val: u8 = 0;
    while srcix < data.count || n0 > 0 {
        if n0 > 0 {
            n0 -= 1;
        } else {
            val = data[srcix];
            srcix += 1;
            if val == 0x88 {
                if srcix >= data.count { return false }
                n0 = cast(s32)data[srcix];
                srcix += 1;
                if n0 > 0 {
                    n0 += 2;
                    val = 0;
                    continue;
                }
            }
        }
        unused VecPush(<<out, val);
    }
    return true;
}

// Build a framed RCX link-level data packet (for legolink datasend).
EncodeLinkPacket :: (seqnum_in: s32, data_in: []u8, out: *Vec(u8)) {
    seq := seqnum_in & 1;
    comp: Vec(u8);
    docomp := false;
    payload := data_in;
    if data_in.count > 0 {
        RlEncode(data_in, *comp);
        if comp.count < data_in.count {
            docomp = true;
            payload = VecSlice(comp, 0, comp.count);
        }
    }
    llen := 1 + payload.count;
    blklen := 2 + llen - 1;
    ldata: Vec(u8);
    unused VecPush(ldata, cast(u8)(ifx seq == 0 then 0x45 else 0x4D));
    unused VecPush(ldata, 0);
    unused VecPush(ldata, 0);
    unused VecPush(ldata, cast(u8)(blklen & 0xFF));
    unused VecPush(ldata, cast(u8)((blklen >> 8) & 0xFF));
    unused VecPush(ldata, cast(u8)(llen & 0xFF));
    unused VecPush(ldata, cast(u8)((llen >> 8) & 0xFF));
    lhval: u8 = 0;
    if seq == 1 { lhval |= 0x01 }
    if docomp { lhval |= 0x08 }
    unused VecPush(ldata, lhval);
    for i: 0..payload.count-1 { unused VecPush(ldata, payload[i]) }
    // Trailing cksum byte slot (matches legolink.b DL_HDR + blklen + 1)
    unused VecPush(ldata, 0);
    EncodeRcxPacket(VecSlice(ldata, 0, ldata.count), out);
}
