SYSTARG=Linux
ZX_INC=
ZX_LIB=
ZX_LDFLAGS=
<../../mkconfig
SYSTARG=Linux

#Configurable parameters

CONF=emu			#default configuration
CONFLIST=emu
CLEANCONFLIST=

INSTALLDIR=$ROOT/$SYSTARG/$OBJTYPE/bin	#path of directory where kernel is installed

#end configurable parameters

X11LIBS= -lX11 -lXext	# can remove or override using env section in config files

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE	#set vars based on target system

<| $SHELLNAME ../port/mkdevlist $CONF	#sets $IP, $DEVS, $PORT, $LIBS
<mkfile-$OBJTYPE	# sets $ARCHFILES

OBJ=\
	asm-$OBJTYPE.$O\
	$ARCHFILES\
	os.$O\
	kproc-pthreads.$O\
	segflush-$OBJTYPE.$O\
	$CONF.root.$O\
	lock.$O\
	zx.$O\
	$DEVS\
	$PORT\

LIBNAMES=${LIBS:%=lib%.a}
#libs=${LIBS:%=$ROOT/$OBJDIR/lib/lib%.a}

HFILES=\

CFLAGS='-DROOT="'$ROOT'"' -DEMU -I. -I../port -I$ROOT/$SYSTARG/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp $CTHREADFLAGS $CFLAGS $EMUOPTIONS
ZX_CFLAGS=`{if test -n "$ZX_LIB"; then echo -DTAIJI_ZX -I"$ZX_INC"; fi}
ZX_SYSLIBS=`{if test -n "$ZX_LIB"; then echo -ldl; fi}
SYSLIBS= $X11LIBS -lm -lpthread $ZX_SYSLIBS
KERNDATE=`{$NDATE}

default:V:	$O.$CONF

$O.$CONF:	$OBJ $CONF.c $CONF.root.h $LIBNAMES $ZX_LIB
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS $ZX_LDFLAGS -o $target $OBJ $CONF.$O $LIBFILES $ZX_LIB $SYSLIBS

install:V: $O.$CONF
	cp $O.$CONF $INSTALLDIR/$CONF

<../port/portmkfile

zx.$O:	../port/zx.c $ROOT/mkconfig $ZX_LIB $ROOT/include/drawif.h zxrunt.h zxmod.h
	$CC $CFLAGS $ZX_CFLAGS ../port/zx.c

zxrunt.h:D:	../port/zxbuiltin.b $ROOT/module/zx.m $ROOT/module/draw.m $ROOT/module/sys.m
	limbo -I $ROOT/module -a ../port/zxbuiltin.b > $target

zxmod.h:D:	../port/zxbuiltin.b $ROOT/module/zx.m $ROOT/module/draw.m $ROOT/module/sys.m
	limbo -I $ROOT/module -t ZX ../port/zxbuiltin.b > $target

devfs.$O:	../port/devfs-posix.c
devds.$O:	../port/devds.c
