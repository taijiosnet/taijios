// Parity test for the ZX mash, appl/cmd/mash/mash.zi built as mash.zx.
// tests/mash/corpus.txt holds the scripts; the goldens are what the Limbo
// mash, /zx/mash.dis, printed for each: standard output, standard error and
// the status its caller saw. Some cases are recorded from mash.dis with its
// own builtins only, so a case that runs a guest program is marked `frozen`
// and keeps the golden recorded when that program was still Limbo.
//
// From the TaijiOS root, after `(cd appl/cmd/mash && mk install)` and
// `(cd appl/cmd/mash && mk install-zx)`:
//     ziran run --target=c --root tests/mash tests/mash/mash_test.zi -- [--record] [--dis] [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/text_tools"
#import "std/option"

Case :: struct {
    name: Text;
    args: Text;
    noscript: bool;
    input: Text;
    script: Text;
    frozen: bool;
    // A known difference and what it waits for; such a case must still
    // differ, so a fixed one is reported too.
    gap: Text;
}

Golden :: struct {
    name: Text;
    status: Text;
    out: Text;
    err: Text;
}

WORK :: "build/tests/mash";
GUESTWORK :: "/build/tests/mash";

cases: Vec(Case);
goldens: Vec(Golden);
failures: s32;
gapdiffers: bool;
gaps: s32;

SetTo :: (t: *Text, s: string) {
    VecClear(t.bytes);
    unused BuilderAppend(t.bytes, s);
}

Unescape :: (s: string, out: *Text) {
    VecClear(out.bytes);
    i: s64;
    while i < s.count {
        c := s[i];
        if c == 92 && i + 1 < s.count {
            d := s[i + 1];
            if d == #char "n" { VecPush(out.bytes, 10); i += 2; continue }
            if d == #char "t" { VecPush(out.bytes, 9); i += 2; continue }
            if d == 92 { VecPush(out.bytes, 92); i += 2; continue }
        }
        VecPush(out.bytes, c);
        i += 1;
    }
}

Escape :: (out: *Vec(u8), s: string) {
    for s {
        if it == 92 { unused BuilderAppend(<<out, "\\\\") }
        else if it == 10 { unused BuilderAppend(<<out, "\\n") }
        else if it == 9 { unused BuilderAppend(<<out, "\\t") }
        else { VecPush(<<out, it) }
    }
}

LoadCorpus :: () -> bool {
    text, ok := ReadEntireFile("tests/mash/corpus.txt");
    if !ok { return false }
    lines := TextLines(text);
    inscript := false;
    for i: 0..lines.count - 1 {
        line := lines[i];
        if TextHasPrefix(line, "=== ") {
            c: Case;
            SetTo(*c.name, line[4:]);
            VecPush(cases, c);
            inscript = false;
            continue;
        }
        if cases.count == 0 { continue }
        k := cases.count - 1;
        if inscript {
            unused BuilderAppend(cases[k].script.bytes, line);
            VecPush(cases[k].script.bytes, 10);
        } else if line == "script:" {
            inscript = true;
        } else if line == "noscript" {
            cases[k].noscript = true;
        } else if line == "frozen" {
            cases[k].frozen = true;
        } else if TextHasPrefix(line, "args:") {
            SetTo(*cases[k].args, TextTrim(line[5:]));
        } else if TextHasPrefix(line, "input:") {
            Unescape(TextTrim(line[6:]), *cases[k].input);
        } else if TextHasPrefix(line, "gap:") {
            SetTo(*cases[k].gap, TextTrim(line[4:]));
        }
    }
    return true;
}

LoadGoldens :: () -> bool {
    text, ok := ReadEntireFile("tests/mash/goldens.txt");
    if !ok { return false }
    for TextLines(text) {
        if TextHasPrefix(it, "=== ") {
            g: Golden;
            SetTo(*g.name, it[4:]);
            VecPush(goldens, g);
            continue;
        }
        if goldens.count == 0 { continue }
        k := goldens.count - 1;
        if TextHasPrefix(it, "status: ") { Unescape(it[8:], *goldens[k].status) }
        else if TextHasPrefix(it, "out: ") { Unescape(it[5:], *goldens[k].out) }
        else if TextHasPrefix(it, "err: ") { Unescape(it[5:], *goldens[k].err) }
    }
    return true
}

Path :: (kind: string, name: string, index: s64) -> Text {
    out: Vec(u8);
    BuilderPrint(*out, "%/%/%.%", WORK, kind, name, index);
    return BuilderFinish(out);
}

// The digits from at on, as the offset after them.
Digits :: (s: string, at: s64) -> s64 {
    while at < s.count && s[at] >= #char "0" && s[at] <= #char "9" { at += 1 }
    return at
}

// The length of a generator's pipe name at the start of s, 0 when there is
// none. mash.dis serves the pipe as /chan/mash.<pid>.<n>; mash.zx serves it
// from /tmp/pipes as mash.<n>/data, like the ZX shell's own pipes. The name
// is the serving shell's choice, so both compare as $pipe.
PipeNameLen :: (s: string) -> s64 {
    if TextHasPrefix(s, "/chan/mash.") {
        at := Digits(s, 11);
        if at > 11 && at < s.count && s[at] == #char "." {
            end := Digits(s, at + 1);
            if end > at + 1 { return end }
        }
        return 0
    }
    if TextHasPrefix(s, "/tmp/pipes/mash.") {
        at := Digits(s, 16);
        if at > 16 && TextHasPrefix(s[at:], "/data") { return at + 5 }
    }
    return 0
}

NormalizePipes :: (s: string) -> Text {
    out: Vec(u8);
    i: s64 = 0;
    while i < s.count {
        n := PipeNameLen(s[i:]);
        if n > 0 {
            unused BuilderAppend(out, "$pipe");
            i += n;
            continue
        }
        VecPush(out, s[i]);
        i += 1
    }
    return BuilderFinish(out)
}

Prepare :: (kind: string, shell: string) -> bool {
    dir: Vec(u8);
    BuilderPrint(*dir, "%/%", WORK, kind);
    unused RemoveTree(TextView(dir[:]));
    unused CreateDirectory("build");
    unused CreateDirectory("build/tests");
    unused CreateDirectory(WORK);
    if !CreateDirectory(TextView(dir[:])) { return false }
    result: Vec(u8);
    BuilderPrint(*result, "%/%/result", WORK, kind);
    if !CreateDirectory(TextView(result[:])) { return false }
    for i: 0..cases.count - 1 {
        script: Text = Path(kind, "case", i);
        if !WriteEntireFile(TextView(script), TextView(cases[i].script)) { return false }
        driver: Vec(u8);
        BuilderPrint(*driver, "W = %/%\n", GUESTWORK, kind);
        if kind == "zx" { BuilderPrint(*driver, "% % $W/case.%", shell, TextView(cases[i].args), i) }
        else { BuilderPrint(*driver, "% % $W/case.%", shell, TextView(cases[i].args), i) }
        BuilderPrint(*driver, " < /dev/null > $W/result/out.% >[2] $W/result/err.%\n", i, i);
        BuilderPrint(*driver, "echo $status > $W/result/status.%\n", i);
        driverpath: Text = Path(kind, "driver", i);
        if !WriteEntireFile(TextView(driverpath), TextView(driver[:])) { return false }
    }
    return true;
}

Boot :: (emu: string, kind: string, shell: string, index: s64) -> bool {
    root: Text = WorkingDirectory();
    guest: Vec(u8);
    BuilderPrint(*guest, "%/%/driver.%", GUESTWORK, kind, index);
    // The driver is a sh script: it starts the mash under test, so that
    // mash's own exit status and streams are what the case records. Goldens
    // come from a Dis guest, where /zx/mash.dis can load its modules; the
    // ZX run boots the ZX shell instead.
    bootshell := "/zx/sh.zx";
    if kind == "dis" { bootshell = "/zx/sh.dis" }
    command: [7]string = .["timeout", "120", emu, "-r", TextView(root), bootshell, TextView(guest[:])];
    scrub: [4]string = .["DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS"];
    run: ProcessRun;
    started := RunProcess(.{arguments = command[:], environment = scrub[:], input_path = "/dev/null", capture_output = true, new_session = true}, *run);
    if !started { print("cannot start %\n", emu); return false }
    return true;
}

BootAll :: (emu: string, kind: string, shell: string) -> bool {
    for i: 0..cases.count - 1 {
        if !Boot(emu, kind, shell, i) { return false }
    }
    return true;
}

Result :: (kind: string, what: string, index: s64) -> Text {
    out: Vec(u8);
    BuilderPrint(*out, "%/%/result/%.%", WORK, kind, what, index);
    text, ok := ReadEntireFile(TextView(out[:]));
    if !ok { return TextCopy("<missing>") }
    w: Vec(u8);
    BuilderPrint(*w, "%/%", GUESTWORK, kind);
    // TextReplace's result borrows the text, so copy it out.
    replaced := TextReplace(text, TextView(w[:]), "$W");
    return NormalizePipes(replaced);
}

Check :: (kind: string, index: s64, what: string, got: string, want: string) {
    if got == want { return }
    if kind == "zx" && cases[index].gap.bytes.count != 0 { gapdiffers = true; return }
    failures += 1;
    g: Vec(u8);
    Escape(*g, got);
    w: Vec(u8);
    Escape(*w, want);
    print("FAIL % %: %\n  got  [%]\n  want [%]\n", kind, TextView(cases[index].name), what, TextView(g[:]), TextView(w[:]));
}

Compare :: (kind: string) {
    for i: 0..cases.count - 1 {
        if kind == "dis" && cases[i].frozen { continue }
        at: s64 = -1;
        for k: 0..goldens.count - 1 { if TextView(goldens[k].name) == TextView(cases[i].name) { at = k; break } }
        if at < 0 { failures += 1; print("FAIL % %: no golden\n", kind, TextView(cases[i].name)); continue }
        gapdiffers = false;
        status: Text = Result(kind, "status", i);
        out: Text = Result(kind, "out", i);
        err: Text = Result(kind, "err", i);
        Check(kind, i, "status", TextView(status), TextView(goldens[at].status));
        Check(kind, i, "stdout", TextView(out), TextView(goldens[at].out));
        Check(kind, i, "stderr", TextView(err), TextView(goldens[at].err));
        if kind == "zx" && cases[i].gap.bytes.count != 0 {
            if gapdiffers {
                gaps += 1;
                print("GAP %: %\n", TextView(cases[i].name), TextView(cases[i].gap));
            } else {
                failures += 1;
                print("FAIL zx %: matches now; drop its gap line\n", TextView(cases[i].name));
            }
        }
    }
}

Record :: () -> bool {
    out: Vec(u8);
    unused BuilderAppend(out, "# What /zx/mash.dis printed for each case of corpus.txt, recorded by\n# mash_test --record: escaped status, standard output and standard error.\n");
    for i: 0..cases.count - 1 {
        status: Text = Result("dis", "status", i);
        o: Text = Result("dis", "out", i);
        e: Text = Result("dis", "err", i);
        if cases[i].frozen {
            at: s64 = -1;
            for k: 0..goldens.count - 1 { if TextView(goldens[k].name) == TextView(cases[i].name) { at = k } }
            if at < 0 { print("no recorded golden for frozen case %\n", TextView(cases[i].name)); return false }
            SetTo(*status, TextView(goldens[at].status));
            SetTo(*o, TextView(goldens[at].out));
            SetTo(*e, TextView(goldens[at].err));
        }
        BuilderPrint(*out, "=== %\nstatus: ", TextView(cases[i].name));
        Escape(*out, TextView(status));
        unused BuilderAppend(out, "\nout: ");
        Escape(*out, TextView(o));
        unused BuilderAppend(out, "\nerr: ");
        Escape(*out, TextView(e));
        VecPush(out, 10);
    }
    return WriteEntireFile("tests/mash/goldens.txt", TextView(out[:]));
}

main :: (argc: s32, argv: **u8) -> s32 {
    shell := "/zx/mash.zx";
    record := false;
    dis := false;
    emu := ifx PathExists("emu/Linux/o.emu") then "emu/Linux/o.emu" else "Linux/386/bin/emu";
    i: s32 = 1;
    while i < argc {
        a := TextFromCString(argv[i]);
        if a == "--record" { record = true }
        else if a == "--dis" { dis = true }
        else if a == "--shell" && i + 1 < argc { i += 1; shell = TextFromCString(argv[i]) }
        else { emu = a }
        i += 1;
    }
    if !LoadCorpus() { print("cannot read tests/mash/corpus.txt\n"); return 1 }
    if record || dis {
        if record && !LoadGoldens() { print("cannot read tests/mash/goldens.txt\n"); return 1 }
        if !Prepare("dis", "/zx/mash.dis") || !BootAll(emu, "dis", "/zx/mash.dis") { return 1 }
        if record {
            if !Record() { print("cannot write tests/mash/goldens.txt\n"); return 1 }
            print("mash: recorded % cases from /zx/mash.dis\n", cases.count);
            return 0;
        }
    }
    if !LoadGoldens() { print("cannot read tests/mash/goldens.txt\n"); return 1 }
    if dis { Compare("dis") }
    if !Prepare("zx", shell) || !BootAll(emu, "zx", shell) { return 1 }
    Compare("zx");
    if failures != 0 { print("mash: % failures in % cases\n", failures, cases.count); return 1 }
    if gaps != 0 {
        print("mash: % cases match the Limbo shell, % known gaps\n", cases.count - gaps, gaps);
        return 0;
    }
    print("mash: all % cases match the Limbo shell\n", cases.count);
    return 0;
}
