// Table-driven unit tests for appl/demo/cpupool/regpoll_model.zi.
using Model :: #import "regpoll_model"

failures: s32;

Expect :: (ok: bool, what: string) {
    if !ok {
        failures += 1;
        print("FAIL: %\n", what);
    }
}

StepCase :: struct {
    state: Model.PollStep;
    action: Model.Action;
    probe: bool;
    expected: Model.PollStep;
}

main :: () -> s32 {
    a1: [2]string = .["tcp!127.0.0.1!6676", "up"];
    addr1, act1, ok1 := Model.ParseArgs(a1[:]);
    Expect(ok1 && addr1 == "tcp!127.0.0.1!6676" && act1 == .Up, "parse up");

    a2: [2]string = .["tcp!127.0.0.1!6676", "down"];
    addr2, act2, ok2 := Model.ParseArgs(a2[:]);
    Expect(ok2 && addr2 == "tcp!127.0.0.1!6676" && act2 == .Down, "parse down");

    a_bad: [2]string = .["tcp!127.0.0.1!6676", "sideways"];
    _, _, ok_bad := Model.ParseArgs(a_bad[:]);
    Expect(!ok_bad, "reject bad action");

    a_short: [1]string = .["tcp!127.0.0.1!6676"];
    _, _, ok_short := Model.ParseArgs(a_short[:]);
    Expect(!ok_short, "reject 1 arg");

    cases: [6]StepCase = StepCase.[
        .{state = .WaitMount, action = .Up, probe = false, expected = .WaitMount},
        .{state = .WaitMount, action = .Up, probe = true, expected = .Done},
        .{state = .WaitMount, action = .Down, probe = false, expected = .WaitMount},
        .{state = .WaitMount, action = .Down, probe = true, expected = .WaitDown},
        .{state = .WaitDown, action = .Down, probe = true, expected = .WaitDown},
        .{state = .WaitDown, action = .Down, probe = false, expected = .Done},
    ];
    for cases {
        Expect(Model.NextStep(it.state, it.action, it.probe) == it.expected, "NextStep");
    }

    if failures == 0 { print("regpoll_test: all checks passed\n") }
    return ifx failures == 0 then 0 else 1;
}
