// Table-driven unit test for appl/demo/whiteboard/whiteboard_model.zi.
#import "std/vec"
using Model :: #import "whiteboard_model"

failures: s32;

Expect :: (ok: bool, what: string) {
    if !ok {
        failures += 1;
        print("FAIL: %\n", what);
    }
}

ParseCase :: struct {
    line: string;
    ok: bool;
    count: s32;
    width: s32;
    x0: s32;
    y0: s32;
    x1: s32;
    y1: s32;
}

HitCase :: struct {
    x: s32;
    y: s32;
    expected: Model.ToolHit;
}

main :: () -> s32 {
    s: Model.State;
    Model.InitState(*s);
    Expect(Model.ActiveColour(*s) == Model.COLOR_BLACK && Model.ActiveWidth(*s) == 1, "default pen");
    s.erase = true;
    Expect(Model.ActiveColour(*s) == Model.COLOR_WHITE && Model.ActiveWidth(*s) == Model.ERASE_WIDTH, "erase pen");

    Expect(Model.CmapToRGBA(0) == Model.COLOR_WHITE, "cmap 0 white");
    Expect(Model.CmapToRGBA(255) == Model.COLOR_BLACK, "cmap 255 black");

    wire: Text;
    Model.FormatStroke(Model.COLOR_BLACK, 2, .{x = 10, y = 20}, .{x = 30, y = 40}, *wire);
    Expect(TextView(wire) == " 255 2 10 20 30 40\n", "FormatStroke wire");

    parse_cases: [4]ParseCase = ParseCase.[
        .{line = " 255 2 10 20 30 40", ok = true, count = 2, width = 2, x0 = 10, y0 = 20, x1 = 30, y1 = 40},
        .{line = " -1 6 1 2 3 4 5 6", ok = true, count = 3, width = 6, x0 = 1, y0 = 2, x1 = 3, y1 = 4},
        .{line = " 255 1 10 20", ok = false},
        .{line = "", ok = false},
    ];
    for parse_cases {
        st: Model.Stroke;
        ok := Model.ParseStrokeLine(it.line, *st);
        Expect(ok == it.ok, "ParseStrokeLine ok");
        if ok {
            Expect(st.count == it.count && st.width == it.width &&
                   st.points[0].x == it.x0 && st.points[0].y == it.y0 &&
                   st.points[1].x == it.x1 && st.points[1].y == it.y1, "ParseStrokeLine fields");
        }
    }

    hit_cases: [6]HitCase = HitCase.[
        .{x = 20, y = 410, expected = .Pen0},
        .{x = 60, y = 410, expected = .Pen1},
        .{x = 100, y = 410, expected = .Pen2},
        .{x = 160, y = 410, expected = .Erase},
        .{x = 300, y = 410, expected = .Colour},
        .{x = 100, y = 100, expected = .None},
    ];
    for hit_cases {
        Expect(Model.HitToolbar(it.x, it.y, Model.CANVAS_H) == it.expected, "HitToolbar");
    }

    // Verify DrawLine sets pixels on a 16x16 white buffer.
    buf: [16 * 16 * 4]u8;
    for i: 0..buf.count-1 { buf[i] = 255 }
    Model.DrawLine(buf[:], 16, 16, .{x = 2, y = 2}, .{x = 10, y = 2}, 0, Model.COLOR_BLACK);
    off := (2 * 16 + 6) * 4;
    Expect(buf[off] == 0 && buf[off + 1] == 0 && buf[off + 2] == 0 && buf[off + 3] == 255, "DrawLine pixel");

    if failures == 0 { print("whiteboard_test: all checks passed\n") }
    return ifx failures == 0 then 0 else 1;
}
