// The cases of the SHA-1 and Bloom filter test: each one printed as the
// Limbo probe printed it with Keyring's sha1 and the Bloomfilter module,
// for comparison with bloomfilter.limbo.txt.
using Sha1 :: #import "sha1"
using Bloom :: #import "bloomfilter"

// count bytes from a linear congruential generator, as the probe made them.
Data :: (count: s64, seed: s64) -> Vec(u8) {
    data: Vec(u8)
    x := seed
    for 1..count {
        x = (x * 1103515245 + 12345) & 0x7fffffff
        VecPush(data, cast(u8)((x >> 16) & 0xFF))
    }
    return data
}

Hex :: (out: *Vec(u8), bytes: []u8) {
    digits := "0123456789abcdef"
    for bytes {
        VecPush(<<out, digits[it >> 4])
        VecPush(<<out, digits[it & 15])
    }
}

Lines :: (out: *Vec(u8)) {
    none: [0]u8
    digest: [20]u8
    lengths := s64.[0, 1, 3, 55, 56, 57, 62, 63, 64, 65, 119, 120, 127, 128, 129, 1000]
    for lengths {
        data := Data(it, 5)
        Sha1.Digest(TextView(data[:]), digest[:])
        BuilderPrint(out, "sha1 % ", it)
        Hex(out, digest[:])
        BuilderAppend(<<out, "\n")
    }
    Sha1.Digest("abc", digest[:])
    BuilderAppend(<<out, "sha1 abc ")
    Hex(out, digest[:])
    BuilderAppend(<<out, "\n")

    // One message given in two pieces, the digest taken with the second
    // piece and then with no data at all.
    whole := Data(300, 9)
    message := TextView(whole[:])
    cuts := s64.[0, 1, 10, 63, 64, 65, 100, 128, 200, 300]
    for cuts {
        with_data: Sha1.State
        Sha1.Add(*with_data, message[:it], none[:])
        Sha1.Add(*with_data, message[it:], digest[:])
        BuilderPrint(out, "pieces % ", it)
        Hex(out, digest[:])
        alone: Sha1.State
        Sha1.Add(*alone, message[:it], none[:])
        Sha1.Add(*alone, message[it:], none[:])
        Sha1.Add(*alone, "", digest[:])
        BuilderAppend(<<out, " ")
        Hex(out, digest[:])
        BuilderAppend(<<out, "\n")
    }

    // Four digests drawn one after another from the same state.
    for lengths {
        data := Data(it, 11)
        state: Sha1.State
        Sha1.Add(*state, TextView(data[:]), none[:])
        BuilderPrint(out, "stream %", it)
        for counter: 0..3 {
            extra: [2]u8
            extra[0] = cast(u8)counter
            Sha1.Add(*state, TextView(extra[:]), digest[:])
            BuilderAppend(<<out, " ")
            Hex(out, digest[:])
        }
        BuilderAppend(<<out, "\n")
    }

    sizes := s64.[3, 10, 16, 12, 20, 8, 13]
    hashes := s64.[1, 3, 7, 10, 25, 40, 12]
    data_lengths := s64.[0, 5, 62, 200, 61, 64, 63]
    for sizes {
        data := Data(data_lengths[it_index], 21 + it_index)
        filter: Vec(u8)
        unused Bloom.Filter(TextView(data[:]), it, hashes[it_index], *filter)
        BuilderPrint(out, "filter % % %:", data_lengths[it_index], it, hashes[it_index])
        for bit: 0..filter.count * 8 - 1 {
            if Bloom.Holds(filter[:], bit) { BuilderPrint(out, " %", bit) }
        }
        BuilderAppend(<<out, "\n")
    }
    refused: Vec(u8)
    if Bloom.Filter("x", 2, 1, *refused) || Bloom.Filter("x", 31, 1, *refused) { BuilderAppend(<<out, "FAIL: size accepted\n") }
}
