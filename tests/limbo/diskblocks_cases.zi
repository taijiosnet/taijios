// The cases of the scratch-file block test: each operation printed as
// the Limbo probe printed it from the Diskblocks module, for comparison
// with diskblocks.limbo.txt.
using Blocks :: #import "diskblocks"

Lines :: (out: *Vec(u8)) {
    refused: Blocks.Disk
    disk: Blocks.Disk
    zero := Blocks.Init(*refused, 0, 512)
    uneven := Blocks.Init(*refused, 64, 500)
    made := Blocks.Init(*disk, 64, 512)
    BuilderPrint(out, "init % % %\n", ifx zero then 0 else 1, ifx uneven then 0 else 1, ifx made then 1 else 0)
    // Each operation is a kind and two numbers: 0 new block of a bytes
    // into slot b, 1 release slot a, 2 write b bytes to slot a.
    ops := s64.[0, 1, 0, 0, 64, 1, 0, 65, 2, 0, 128, 3, 0, 512, 4, 0, 513, 5, 0, 0, 6, 0, 500, 7, 1, 0, 0, 1, 1, 0, 0, 30, 0, 0, 64, 1, 0, 2, 8, 1, 3, 0, 1, 2, 0, 0, 100, 2, 0, 127, 3, 0, 70, 9, 2, 10, 20, 2, 10, 60, 2, 10, 65, 2, 10, 64, 2, 10, 600, 2, 11, 512, 2, 11, 449, 2, 11, 448, 2, 4, 1, 0, 512, 12, 1, 12, 0, 0, 511, 12, 1, 6, 0, 0, 0, 6, 2, 6, 0, 2, 6, 1, 1, 7, 0, 1, 12, 0, 0, 449, 7, 0, 449, 12, 0, 449, 13]
    slots: [16]Blocks.Block
    for i: 0..15 { slots[i] = Blocks.None() }
    for i: 0..ops.count / 3 - 1 {
        kind := ops[i * 3]
        a := ops[i * 3 + 1]
        b := ops[i * 3 + 2]
        slot := ifx kind == 0 then b else a
        if kind == 0 { slots[slot] = Blocks.New(*disk, a) }
        if kind == 1 { Blocks.Release(*disk, slots[slot]) }
        if kind == 2 { slots[slot] = Blocks.ForWrite(*disk, slots[slot], b) }
        if slots[slot].address < 0 {
            BuilderPrint(out, "op % nil length=%\n", i, disk.length)
        } else {
            BuilderPrint(out, "op % addr=% n=% length=%\n", i, slots[slot].address, slots[slot].size, disk.length)
        }
        if kind == 1 { slots[slot] = Blocks.None() }
    }
}
