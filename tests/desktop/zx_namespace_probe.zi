// In a guest without Dis, one process serves a small 9P tree over a pipe on
// its standard streams, and its parent mounts the tree and reads it.
Args :: #import "taijios_args";
IO :: #import "taijios_io";
Namespace :: #import "taijios_namespace";
Process :: #import "taijios_process";

// The probe's own path; the hosted mode receives it as an operand.
self_path: string = "/namespace.zx";
Greeting :: "hello from ZX\n";
Root :: 0;
File :: 1;

Fail :: (message: string) -> s32 {
    unused Args.SetFailure(message);
    return 1;
}

ReadFull :: (handle: s32, buffer: []u8) -> bool {
    done: s64 = 0;
    while done < buffer.count {
        n := IO.Read(handle, buffer[done:]);
        if n <= 0 { return false }
        done += n;
    }
    return true;
}

WriteAll :: (handle: s32, bytes: []u8) -> bool {
    done: s64 = 0;
    while done < bytes.count {
        n := IO.Write(handle, TextView(bytes[done:]));
        if n <= 0 { return false }
        done += n;
    }
    return true;
}

Same :: (bytes: []u8, text: string) -> bool {
    if bytes.count != text.count { return false }
    for i: 0 .. text.count - 1 { if bytes[i] != text[i] { return false } }
    return true;
}

// The 9P server. Every reply is built in `reply` after its four size bytes.

reply: [8192]u8;
used: s64;

Put :: (value: u64, width: s64) {
    for i: 0 .. width - 1 {
        reply[used] = cast(u8)((value >> cast(u64)(8 * i)) & 255);
        used += 1;
    }
}

PutAt :: (at: s64, value: u64, width: s64) {
    end := used;
    used = at;
    Put(value, width);
    used = end;
}

PutText :: (text: string) {
    Put(cast(u64)text.count, 2);
    for c: text { reply[used] = c; used += 1 }
}

PutQid :: (node: s32) {
    Put(ifx node == Root then 128 else 0, 1);
    Put(0, 4);
    Put(cast(u64)node, 8);
}

// A stat record: its own size, then type, device, qid, mode, times, length and names.
PutStat :: (node: s32) {
    start := used;
    used += 2;
    Put(0, 2);
    Put(0, 4);
    PutQid(node);
    Put(ifx node == Root then 0x800001ed else 0x1a4, 4);
    Put(0, 4);
    Put(0, 4);
    Put(ifx node == Root then 0 else cast(u64)Greeting.count, 8);
    PutText(ifx node == Root then "/" else "hello");
    PutText("zx");
    PutText("zx");
    PutText("zx");
    PutAt(start, cast(u64)(used - start - 2), 2);
}

Get :: (bytes: []u8, at: s64, width: s64) -> u64 {
    value: u64 = 0;
    for i: 0 .. width - 1 { value |= cast(u64)bytes[at + i] << cast(u64)(8 * i) }
    return value;
}

Begin :: (kind: u64, tag: u64) {
    used = 4;
    Put(kind, 1);
    Put(tag, 2);
}

Refuse :: (tag: u64, message: string) {
    Begin(107, tag);
    PutText(message);
}

Fids :: struct {
    number: [16]s64;
    node: [16]s32;
}

Lookup :: (fids: *Fids, number: s64) -> s32 {
    for i: 0 .. 15 { if fids.number[i] == number { return fids.node[i] } }
    return -1;
}

Assign :: (fids: *Fids, number: s64, node: s32) -> bool {
    free: s64 = -1;
    for i: 0 .. 15 {
        if fids.number[i] == number { fids.node[i] = node; return true }
        if fids.number[i] < 0 && free < 0 { free = i }
    }
    if free < 0 { return false }
    fids.number[free] = number;
    fids.node[free] = node;
    return true;
}

Serve :: () -> s32 {
    request: [8192]u8;
    fids: Fids;
    for i: 0 .. 15 { fids.number[i] = -1 }
    while true {
        if !ReadFull(0, request[:4]) { return 0 } // The client closed the connection.
        size := cast(s64)Get(request[:], 0, 4);
        if size < 7 || size > request.count || !ReadFull(0, request[4:size]) { return 3 }
        kind := Get(request[:], 4, 1);
        tag := Get(request[:], 5, 2);
        fid := ifx size >= 11 then cast(s64)Get(request[:], 7, 4) else -1;
        node := Lookup(*fids, fid);
        if kind == 100 {
            limit := Get(request[:], 7, 4);
            Begin(101, tag);
            Put(ifx limit > 8192 then 8192 else limit, 4);
            PutText("9P2000");
        } else if kind == 104 {
            if !Assign(*fids, fid, Root) { return 4 }
            Begin(105, tag);
            PutQid(Root);
        } else if node < 0 {
            Refuse(tag, "unknown fid");
        } else if kind == 110 {
            target := cast(s64)Get(request[:], 11, 4);
            names := Get(request[:], 15, 2);
            found := node;
            if names == 1 {
                length := cast(s64)Get(request[:], 17, 2);
                name := request[19:19 + length];
                if Same(name, "..") { found = Root }
                else if node == Root && Same(name, "hello") { found = File }
                else { found = -1 }
            }
            if names > 1 || found < 0 { Refuse(tag, "file does not exist") }
            else if !Assign(*fids, target, found) { return 4 }
            else {
                Begin(111, tag);
                Put(names, 2);
                if names == 1 { PutQid(found) }
            }
        } else if kind == 112 {
            if node == File && (Get(request[:], 11, 1) & 3) != 0 { Refuse(tag, "permission denied") }
            else {
                Begin(113, tag);
                PutQid(node);
                Put(0, 4);
            }
        } else if kind == 116 {
            offset := cast(s64)Get(request[:], 11, 8);
            count := cast(s64)Get(request[:], 19, 4);
            Begin(117, tag);
            body := used;
            used += 4;
            if node == Root {
                if offset == 0 { PutStat(File) }
            } else {
                i := offset;
                while i < Greeting.count && i - offset < count {
                    reply[used] = Greeting[i];
                    used += 1;
                    i += 1;
                }
            }
            PutAt(body, cast(u64)(used - body - 4), 4);
        } else if kind == 120 {
            unused Assign(*fids, fid, -1);
            for i: 0 .. 15 { if fids.number[i] == fid { fids.number[i] = -1 } }
            Begin(121, tag);
        } else if kind == 124 {
            Begin(125, tag);
            body := used;
            used += 2;
            PutStat(node);
            PutAt(body, cast(u64)(used - body - 2), 2);
        } else {
            Refuse(tag, "not supported");
        }
        size = used;
        PutAt(0, cast(u64)size, 4);
        if !WriteAll(1, reply[:size]) { return 5 }
    }
    return 0;
}

// Answer each line read from the standard input in capitals on the standard
// output, until the line "quit".
Echo :: () -> s32 {
    line: [64]u8;
    count: s64 = 0;
    while true {
        if !ReadFull(0, line[count:count + 1]) { return 0 }
        if line[count] >= #char "a" && line[count] <= #char "z" { line[count] -= 32 }
        count += 1;
        if line[count - 1] == 10 || count == line.count {
            if Same(line[:count], "QUIT\n") { return 0 }
            if !WriteAll(1, line[:count]) { return 6 }
            count = 0;
        }
    }
    return 0;
}

Greets :: (path: string) -> bool {
    handle := IO.Open(path, 0);
    if handle < 0 { return false }
    bytes: [64]u8;
    count := IO.Read(handle, bytes[:]);
    ok := count == Greeting.count && Same(bytes[:count], Greeting) && IO.Read(handle, bytes[:]) == 0;
    return IO.Close(handle) == 0 && ok;
}

Finished :: (id: s32) -> bool {
    outcome := Process.Wait(id);
    return outcome.status >= 0 && outcome.value == 0;
}

Child :: (mode: string, input: s32, output: s32) -> s32 {
    operands: [1]string = .{mode};
    launch := Process.StartWith(self_path, operands[:], input, output, -1);
    return launch.id;
}

// Under the Dis shell's zxrun: a child on chosen streams answers through a pipe,
// and a child blocked reading its input is killed.
// Read up to buffer.count bytes of a file; -1 if it cannot be opened.
ReadSmall :: (path: string, buffer: []u8) -> s64 {
    handle := IO.Open(path, 0);
    if handle < 0 { return -1 }
    done: s64 = 0;
    while done < buffer.count {
        n := IO.Read(handle, buffer[done:]);
        if n <= 0 { break }
        done += n;
    }
    unused IO.Close(handle);
    return done;
}

// The number in a file such as #p/1/pgrp, which pads it with spaces.
ReadNumber :: (path: string) -> s64 {
    bytes: [32]u8;
    count := ReadSmall(path, bytes[:]);
    value: s64 = -1;
    for i: 0 .. count - 1 {
        if bytes[i] >= 48 && bytes[i] <= 57 {
            if value < 0 { value = 0 }
            value = value * 10 + cast(s64)bytes[i] - 48;
        }
    }
    return value;
}

// "#p/<pid>/<file>" in `out`.
ProgPath :: (pid: s32, file: string, out: []u8) -> string {
    digits: [12]u8;
    count: s64 = 0;
    rest := pid;
    while true {
        digits[count] = cast(u8)(48 + rest % 10);
        count += 1;
        rest /= 10;
        if rest == 0 { break }
    }
    used: s64 = 0;
    for c: "#p/" { out[used] = c; used += 1 }
    for i: 0 .. count - 1 { out[used] = digits[count - 1 - i]; used += 1 }
    out[used] = 47; used += 1;
    for c: file { out[used] = c; used += 1 }
    return TextView(out[:used]);
}

SetVariable :: (value: string) -> bool {
    handle := IO.Create("/env/probevar", 1, 438);
    if handle < 0 { return false }
    ok := IO.Write(handle, value) == cast(s32)value.count;
    return IO.Close(handle) == 0 && ok;
}

Variable :: (value: string) -> bool {
    bytes: [32]u8;
    count := ReadSmall("/env/probevar", bytes[:]);
    return count == value.count && Same(bytes[:count], value);
}

// Run this probe in a mode and return its value, or -1 if it failed.
RunMode :: (mode: string) -> s64 {
    operands: [1]string = .{mode};
    outcome := Process.Run(self_path, operands[:]);
    return ifx outcome.status == 1 then outcome.value else -1;
}

// The pctl host calls in the booted program and its children.
Pctl :: () -> s32 {
    if Process.Pid() != 1 { return Fail("the booted program is process 1") }
    if !SetVariable("parent") || RunMode("envshare") != 0 || !Variable("shared") {
        return Fail("children share the environment");
    }
    if !SetVariable("parent") { return Fail("reset the variable") }
    first := RunMode("envfork");
    second := RunMode("envfork");
    if first < 2 || second <= first || !Variable("parent") { return Fail("ForkEnv keeps a child's variables to itself") }
    inner: [16]u8;
    if RunMode("newns") != 0 || ReadSmall("/inner", inner[:]) != -1 || ReadSmall("/pctltest/inner", inner[:]) != 6 {
        return Fail("NewNs roots only the child's namespace at its directory");
    }
    if RunMode("nodevs") != 0 { return Fail("NoDevs forbids devices but not pipes") }
    console := IO.Open("#c", 0);
    if console < 0 || IO.Close(console) != 0 { return Fail("NoDevs in a forked namespace leaves the parent's") }
    print("ZX_PCTL_OK\n");
    return 0;
}

Hosted :: () -> s32 {
    // A command run from Dis is its Dis process, which can lead a new group.
    pid := Process.Pid();
    path: [64]u8;
    status := IO.Open(ProgPath(pid, "status", path[:]), 0);
    if pid <= 0 || status < 0 || IO.Close(status) != 0 || Process.NewPgrp() != pid ||
       ReadNumber(ProgPath(pid, "pgrp", path[:])) != cast(s64)pid {
        return Fail("hosted pid and process group");
    }
    ends: [2]s32;
    if Namespace.Pipe(ends[:]) != 0 { return Fail("hosted pipe") }
    echo := Child("echo", ends[0], ends[0]);
    answer: [5]u8;
    if echo <= 0 || IO.Close(ends[0]) != 0 || IO.Write(ends[1], "ping\n") != 5 || !ReadFull(ends[1], answer[:]) ||
       !Same(answer[:], "PING\n") || IO.Write(ends[1], "quit\n") != 5 || !Finished(echo) || IO.Close(ends[1]) != 0 {
        return Fail("hosted echo child");
    }
    if Namespace.Pipe(ends[:]) != 0 { return Fail("hosted second pipe") }
    blocked := Child("block", ends[0], ends[0]);
    if blocked <= 0 || IO.Close(ends[0]) != 0 || Process.Poll(blocked).status != -2 { return Fail("start a blocked child") }
    if !Process.Kill(blocked) { return Fail("kill the blocked child") }
    outcome := Process.Wait(blocked);
    if outcome.status != -1 || outcome.error != "killed" || Process.Kill(blocked) || IO.Close(ends[1]) != 0 {
        return Fail("killed child outcome");
    }
    print("ZX_HOSTED_PROCESS_OK\n");
    return 0;
}

main :: () -> s32 {
    mode := ifx Args.OperandCount() > 0 then Args.Operand(0) else "";
    if mode == "serve" { return Serve() }
    if mode == "echo" { return Echo() }
    if mode == "block" {
        byte: [1]u8;
        while IO.Read(0, byte[:]) > 0 {}
        return 0;
    }
    // Start a server, mount it at the given name, and exit: the server keeps
    // answering whoever reads the mount until the last mount is gone.
    if mode == "mountout" {
        if Args.OperandCount() != 3 { return Fail("mountout needs the probe path and a mount point") }
        self_path = Args.Operand(1);
        ends: [2]s32;
        if Namespace.Pipe(ends[:]) != 0 || Child("serve", ends[0], ends[0]) <= 0 || IO.Close(ends[0]) != 0 ||
           Namespace.Mount(ends[1], -1, Args.Operand(2), Namespace.Replace, "") != 0 || IO.Close(ends[1]) != 0 {
            return Fail("mount a server and leave it running");
        }
        return 0;
    }
    if mode == "cd" {
        // Relative names resolve against the directory Chdir selects.
        if Args.OperandCount() != 2 || IO.Chdir(Args.Operand(1)) != 0 || IO.Cwd() != Args.Operand(1) ||
           IO.Chdir("/no/such/directory") != -1 || IO.Cwd() != Args.Operand(1) || !Greets("hello") {
            return Fail("change directory");
        }
        print("ZX_CHDIR_OK\n");
        return 0;
    }
    if mode == "hosted" {
        if Args.OperandCount() != 2 { return Fail("hosted mode needs the probe path") }
        self_path = Args.Operand(1);
        return Hosted();
    }
    if mode == "pctl" { return Pctl() }
    if mode == "envshare" { return ifx Variable("parent") && SetVariable("shared") then 0 else 20 }
    if mode == "envfork" {
        if !Namespace.ForkEnv() || !Variable("parent") || !SetVariable("child") || !Variable("child") { return 21 }
        pid := Process.Pid();
        if pid < 2 || Process.NewPgrp() != pid { return 22 }
        return pid;
    }
    if mode == "newns" {
        // Fork first: the directory and the root belong to the namespace.
        if !Namespace.Fork() || IO.Chdir("/pctltest") != 0 || !Namespace.NewNs() { return 23 }
        bytes: [16]u8;
        if ReadSmall("/inner", bytes[:]) != 6 || ReadSmall("/namespace.zx", bytes[:]) != -1 { return 24 }
        return 0;
    }
    if mode == "nodevs" {
        console := IO.Open("#c", 0);
        if console < 0 || IO.Close(console) != 0 { return 25 }
        if !Namespace.Fork() || !Namespace.NoDevs() || IO.Open("#c", 0) >= 0 { return 26 }
        ends: [2]s32;
        if Namespace.Pipe(ends[:]) != 0 { return 27 }
        return 0;
    }
    if mode == "share" { return ifx Namespace.Bind("/n/served", "/n/shared", Namespace.Replace) == 0 then 0 else 7 }
    if mode == "private" {
        if !Namespace.Fork() { return 8 }
        if Namespace.Bind("/n/served", "/n/private", Namespace.Replace) != 0 { return 9 }
        return ifx Greets("/n/private/hello") then 0 else 10;
    }

    ends: [2]s32;
    if Namespace.Pipe(ends[:]) != 0 || ends[0] < 3 || ends[1] < 3 || ends[0] == ends[1] { return Fail("create a pipe") }
    none: [0]string;
    if Process.StartWith(self_path, none[:], 99, -1, -1).id != 0 { return Fail("start with an unknown handle") }
    server := Child("serve", ends[0], ends[0]);
    if server <= 0 || IO.Close(ends[0]) != 0 { return Fail("start the file server on the pipe") }
    if Namespace.Mount(ends[1], -1, "/n/missing", Namespace.Replace, "") != -1 || Namespace.Error() == "" {
        return Fail("mount on a missing name");
    }
    if Namespace.Mount(ends[1], -1, "/n/served", Namespace.Replace, "") != 0 { return Fail("mount the file server") }
    if IO.Close(ends[1]) != 0 || !Greets("/n/served/hello") { return Fail("read a file through the mount") }
    metadata: [12]u8;
    if IO.Stat("/n/served/hello", metadata[:]) != 0 || IO.Open("/n/served/absent", 0) != -1 {
        return Fail("stat and walk through the mount");
    }
    listing := IO.Open("/n/served", 0);
    entries: [256]u8;
    if listing < 0 || IO.Read(listing, entries[:]) <= 2 || IO.Close(listing) != 0 { return Fail("list the mounted directory") }

    if Namespace.Bind("/n/served", "/n/alias", Namespace.Replace) != 0 || !Greets("/n/alias/hello") {
        return Fail("bind the mounted tree");
    }
    // A child shares this namespace until it forks its own copy.
    if !Finished(Child("share", -1, -1)) || !Greets("/n/shared/hello") { return Fail("child bind in the shared namespace") }
    if !Finished(Child("private", -1, -1)) || IO.Open("/n/private/hello", 0) != -1 {
        return Fail("child bind in a forked namespace");
    }

    if Namespace.Pipe(ends[:]) != 0 { return Fail("create a second pipe") }
    echo := Child("echo", ends[0], ends[0]);
    answer: [8]u8;
    if echo <= 0 || IO.Close(ends[0]) != 0 || IO.PollRead(ends[1], answer[:]) != -2 { return Fail("poll an idle pipe") }
    // A waiting read takes the first byte; the rest of the answer is then ready to poll.
    if IO.Write(ends[1], "ping\n") != 5 || IO.Read(ends[1], answer[:1]) != 1 || IO.PollRead(ends[1], answer[1:]) != 4 ||
       !Same(answer[:5], "PING\n") { return Fail("echo through a child's chosen streams") }
    if IO.Write(ends[1], "quit\n") != 5 || IO.Read(ends[1], answer[:]) != 0 || IO.PollRead(ends[1], answer[:]) != 0 {
        return Fail("end of a polled pipe");
    }
    if IO.Close(ends[1]) != 0 || !Finished(echo) { return Fail("echo child did not finish") }

    if Namespace.Unmount("", "/n/alias") != 0 || Namespace.Unmount("", "/n/shared") != 0 ||
       Namespace.Unmount("", "/n/served") != 0 || IO.Open("/n/served/hello", 0) != -1 {
        return Fail("unmount the tree");
    }
    if !Finished(server) { return Fail("file server did not end with its last mount") }
    print("ZX_NAMESPACE_OK\n");
    return 0;
}
