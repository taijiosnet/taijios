D :: #import "image_document";
PNG :: #import "std/png_linux";
JPEG :: #import "std/jpeg";
#import "std/image"
#import "std/file"

CRC :: #import "std/zip";
GIF :: #import "gif_image";
Bitmap :: #import "inferno_image";

// Decode a file through the viewer and compare its pixels with a CRC-32 of
// what a reference decoder produced. For Inferno images that is Inferno's own
// Draw, drawing the file into r8g8b8 (blue, green, red bytes). For GIF it is
// Pillow's first frame as RGBA with transparent pixels cleared, and for X
// bitmaps Inferno's readxbitmap as RGBA.
Matches :: (path: string, format: string, width: s32, height: s32, crc: u32) -> bool {
    bytes: Vec(u8); defer VecFree(bytes)
    if !ReadFileInto(path, *bytes) { return false }
    document := D.Decode(bytes[:]); defer VecFree(document.image.pixels)
    if document.error != "" || document.format != format { print("%: % %\n", path, document.format, document.error); return false }
    if document.image.width != width || document.image.height != height { return false }
    sum := cast(u32)0xffffffff
    if format != "Inferno image" { sum = CRC.ZipCRC32Update(sum, document.image.pixels[:]) }
    else {
        bgr: [3]u8
        for i: cast(s64)0..document.image.pixels.count/4-1 {
            bgr[0] = document.image.pixels[i*4+2]; bgr[1] = document.image.pixels[i*4+1]; bgr[2] = document.image.pixels[i*4]
            sum = CRC.ZipCRC32Update(sum, bgr[:])
        }
    }
    sum ^= cast(u32)0xffffffff
    if sum != crc { print("%: CRC % not %\n", path, sum, crc) }
    return sum == crc
}

#program_export
main :: () -> s32 {
    unused CreateDirectory("build/desktop-registry/images")
    picture := NewImage(64, 32, 240, 32, 16, 255)
    defer VecFree(picture.pixels)
    for y: cast(s32)0..31 { for x: cast(s32)32..63 {
        at := (y*64+x)*4
        picture.pixels[at] = 16; picture.pixels[at+1] = 220; picture.pixels[at+2] = 64
        picture.pixels[at+3] = ifx y < 16 then cast(u8)128 else cast(u8)0
    } }
    png: Vec(u8); defer VecFree(png)
    if !PNG.WritePNG(*picture, *png) { return 1 }
    if !WriteEntireFile("build/desktop-registry/images/reference.png", TextView(png[:])) { return 2 }
    decoded := D.Decode(png[:]); defer VecFree(decoded.image.pixels)
    if decoded.error != "" || decoded.format != "PNG" || decoded.image.pixels.count != picture.pixels.count { return 3 }
    for i: cast(s64)0..picture.pixels.count-1 { if picture.pixels[i] != decoded.image.pixels[i] { return 4 } }
    for size: cast(s64)0..png.count-1 {
        truncated := D.Decode(png[:size]); defer VecFree(truncated.image.pixels)
        if truncated.error == "" { return 5 }
    }
    png[29] ^= cast(u8)1
    broken := D.Decode(png[:]); defer VecFree(broken.image.pixels)
    if broken.error != "PNG checksum mismatch" { return 6 }
    png[29] ^= cast(u8)1
    saved := png[16]; png[16] = 127
    huge := D.Decode(png[:]); defer VecFree(huge.image.pixels)
    if huge.error == "" || huge.image.pixels.count != 0 { return 7 }
    png[16] = saved
    jpeg: Vec(u8); defer VecFree(jpeg)
    if !JPEG.WriteJPEG(*picture, *jpeg, 95) || !WriteEntireFile("build/desktop-registry/images/reference.jpg", TextView(jpeg[:])) { return 8 }
    photo := D.Decode(jpeg[:]); defer VecFree(photo.image.pixels)
    if photo.error != "" || photo.format != "JPEG" || photo.image.width != 64 || photo.image.height != 32 { return 9 }
    for index: cast(s32)0..1 {
        at := ifx index == 0 then (8*64+8)*4 else (8*64+48)*4
        for channel: cast(s32)0..2 {
            delta := cast(s32)photo.image.pixels[at+channel]-picture.pixels[at+channel]
            if delta < -12 || delta > 12 { return 10 }
        }
        if photo.image.pixels[at+3] != 255 { return 11 }
    }
    cut := D.Decode(jpeg[:jpeg.count-2]); defer VecFree(cut.image.pixels)
    if cut.error == "" { return 12 }
    unsupported: [5]u8 = .[71, 73, 70, 56, 57]
    other := D.Decode(unsupported[:]); defer VecFree(other.image.pixels)
    if other.error == "" { return 13 }
    w, h := D.DisplaySize(2048, 1024, 600, 400, 0)
    if w != 600 || h != 300 { return 14 }
    w2, h2 := D.DisplaySize(800, 1600, 600, 400, 0)
    if w2 != 200 || h2 != 400 { return 15 }
    w3, h3 := D.DisplaySize(2048, 1024, 600, 400, 200)
    if w3 != 4096 || h3 != 2048 { return 16 }
    large := NewImage(2048, 1024, 20, 80, 200, 255)
    defer VecFree(large.pixels)
    if !PNG.WritePNGFile("build/desktop-registry/images/large.png", *large) { return 17 }
    excessive: Vec(u8); defer VecFree(excessive)
    if !VecResizeBounded(excessive, 8388609, 8388609) { return 18 }
    rejected := D.Decode(excessive[:]); defer VecFree(rejected.image.pixels)
    if rejected.error == "" { return 19 }
    // Every Inferno image format in the tree: compressed grey, old ldepth 0 and
    // 3 (inverted bits), the colour map, 24-bit colour, and a plain 16-bit
    // image whose rectangle starts at 160,160.
    if !Matches("icons/minicharon/back.bit", "Inferno image", 10, 8, 0x14cc26d9) { return 20 }
    if !Matches("icons/tk/debug/closed.bit", "Inferno image", 13, 13, 0x6d003a77) { return 21 }
    if !Matches("lib/strokes/digits.bit", "Inferno image", 200, 300, 0x5d12c0c4) { return 22 }
    if !Matches("icons/tk/file.bit", "Inferno image", 40, 30, 0xaf9f5e1d) { return 23 }
    if !Matches("icons/monitor/browsemask.bit", "Inferno image", 15, 15, 0xd1148a58) { return 24 }
    if !Matches("icons/penguin.bit", "Inferno image", 161, 209, 0x386e4c28) { return 25 }
    if !Matches("icons/inferno.bit", "Inferno image", 300, 207, 0xb73419a0) { return 26 }
    // GIF: an interlaced picture with a transparent colour, and the GIFs in the tree.
    if !Matches("tests/desktop/interlaced.gif", "GIF", 37, 23, 2395954842) { return 27 }
    if !Matches("doc/limbotk/f1.gif", "GIF", 299, 24, 2025682603) { return 28 }
    if !Matches("doc/limbotk/f2.gif", "GIF", 310, 210, 2702451149) { return 29 }
    if !Matches("services/webget/inferno.gif", "GIF", 233, 75, 3695199128) { return 30 }
    if !Matches("services/webget/smallinferno.gif", "GIF", 150, 48, 3797876854) { return 31 }
    if !Matches("services/webget/vnlogo.gif", "GIF", 121, 110, 2115683368) { return 32 }
    if !Matches("tests/desktop/sample.xbm", "X bitmap", 13, 7, 353782105) { return 36 }
    // frames.gif has three frames: a full one, a smaller one with a transparent
    // colour, and an offset one. Its layers were built with the file.
    frames: Vec(u8); defer VecFree(frames)
    if !ReadFileInto("tests/desktop/frames.gif", *frames) { return 37 }
    layers: Image; defer VecFree(layers.pixels)
    count, problem := GIF.DecodeFrames(frames[:], *layers, 16)
    if problem != "" || count != 3 || layers.width != 9 || layers.height != 18 ||
       CRC.ZipCRC32(layers.pixels[:]) != 2042660174 { return 38 }
    first: Image; defer VecFree(first.pixels)
    one, why := GIF.DecodeFrames(frames[:], *first, 1)
    if why != "" || one != 1 || CRC.ZipCRC32(first.pixels[:]) != 2823328147 { return 39 }
    // sample.pic decodes as Inferno's readpicfile reads it.
    if !Matches("tests/desktop/sample.pic", "PIC picture", 5, 3, 2567782757) { return 40 }
    // The viewer's Save writes the bytes that Inferno's Draw read back as the
    // first two frames of frames.gif over white.
    two: Image; defer VecFree(two.pixels)
    pair, why2 := GIF.DecodeFrames(frames[:], *two, 2)
    if why2 != "" || pair != 2 { return 41 }
    encoded: Vec(u8); defer VecFree(encoded)
    if !VecResize(encoded, Bitmap.EncodedBytes(two.width, two.height)) { return 42 }
    Bitmap.Encode(*two, encoded[:])
    if CRC.ZipCRC32(encoded[:]) != 41973348 { return 43 }
    // Truncated input fails cleanly.
    bitmap: Vec(u8); defer VecFree(bitmap)
    gif: Vec(u8); defer VecFree(gif)
    if !ReadFileInto("icons/tk/file.bit", *bitmap) || !ReadFileInto("doc/limbotk/f2.gif", *gif) { return 33 }
    for size: cast(s64)0..bitmap.count-1 {
        part := D.Decode(bitmap[:size]); defer VecFree(part.image.pixels)
        if part.error == "" { return 34 }
    }
    // A cut GIF either fails or shows the rows that arrived on the full screen.
    for size: cast(s64)0..gif.count-2 {
        part := D.Decode(gif[:size]); defer VecFree(part.image.pixels)
        if part.error == "" && (part.image.width != 310 || part.image.height != 210) { return 35 }
    }
    print("TAIJI_IMAGE_DOCUMENT_OK\n")
    return 0
}
