using Io :: #import "taijios_io";
using Args :: #import "taijios_args";
Draw :: #import "guest_draw";
Compositor :: #import "compositor";
Input :: #import "guest_input";

Fail :: (operation: string) -> s32 {
    print("%: %\n", operation, Io.LastError());
    unused Args.SetFailure(operation);
    return 1;
}

Paint :: (display: *Draw.Display) -> bool {
    screen := Draw.Screen(display);
    background := Draw.Solid(display, 0x183858ff);
    defer Draw.Release(display, *background);

    bounds: Draw.Rect = .{-2, -1, 2098, 2};
    image := Draw.Buffer(display, bounds, 0x000000ff);
    defer Draw.Release(display, *image);
    pixels: [2100 * 3 * 4]u8;
    for y: 0..2 {
        for x: 0..2099 {
            offset := (y * 2100 + x) * 4;
            pixels[offset] = ifx x < 2042 then 230 else 10;
            pixels[offset + 1] = 30 + cast(u8)(y * 25);
            pixels[offset + 2] = ifx x < 2042 then 10 else 230;
            pixels[offset + 3] = 255;
        }
    }
    if Draw.Upload(display, image, bounds, pixels[:4]) || !Draw.Upload(display, image, bounds, pixels[:]) {
        return false;
    }

    overlay := Draw.Solid(display, 0xfacd14ff);
    defer Draw.Release(display, *overlay);
    layers: [2]Compositor.Layer = .{
        .{image, .{2038, -1, 2043, 2}, 10, 10},
        .{overlay, overlay.bounds, 12, 11},
    };
    if !Compositor.Repaint(display, background, layers[:], screen.bounds) { return false }
    // Clear a single pixel of the bottom layer while retaining its neighbors.
    return Compositor.Repaint(display, background, layers[:0], .{10, 10, 11, 11});
}

main :: () -> s32 {
    display: Draw.Display;
    if !Draw.Open(*display) { return Fail("open Draw") }
    defer Draw.Close(*display);
    if !Paint(*display) { return Fail("paint") }
    input := Input.Open();
    if input < 0 || Input.Open() >= 0 { return Fail("open exclusive input") }
    keyboard := Io.OpenFile("/dev/keyboard", 0);
    if keyboard < 0 { return Fail("open keyboard") }
    defer Io.CloseFile(keyboard);
    bounds := Draw.Screen(*display).bounds;
    print("ZX_DRAW_READY %x%\n", bounds.right - bounds.left, bounds.bottom - bounds.top);

    pressed := false;
    released := false;
    down := false;
    up := false;
    text := false;
    while !(released && up && text) {
        event := Input.Next(input);
        if event.kind == 0 { return Fail("read input") }
        if event.kind == Input.Pointer && event.x == 120 && event.y == 160 {
            if event.buttons == 1 { pressed = true }
            if pressed && event.buttons == 0 { released = true }
        }
        if event.kind == Input.KeyDown && event.code == #char "A" { down = true }
        if event.kind == Input.KeyUp && event.code == #char "A" && down { up = true }
        if event.kind == Input.Text && event.code == #char "a" { text = true }
    }
    Input.Close(input);
    input = Input.Open();
    if input < 0 { return Fail("reopen input") }
    Input.Close(input);
    key: [16]u8;
    n := Io.ReadBytes(keyboard, key[:]);
    if n <= 0 || key[0] != #char "a" { return Fail("read keyboard") }
    print("ZX_DRAW_INPUT_OK\n");
    return 0;
}
