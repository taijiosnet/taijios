Surface :: #import "zx_surface";
Args :: #import "taijios_args";
WM :: #import "taijios_wm";
Draw :: #import "taijios_draw";

Color :: 37;
Width :: 48;
Height :: 32;

main :: () -> s32 {
    desktop_probe := Args.OperandCount() > 0;
    if desktop_probe && (Args.OperandCount() != 2 || Args.Operand(0) != "café 猫" || Args.Operand(1) != "") {
        unused Args.SetFailure("desktop launch lost its operands");
        return 8;
    }
    if !Surface.Open("Native window probe", Width, Height) { return 1 }
    if !Surface.SetTitle("ZX surface probe") { return 2 }
    if WM.Resize(0, Height) || WM.SetCursor(0, 0, 7, 2, "") { return 9 }
    if Draw.SampleGuestPointer() != -1 { return 13 }
    pixels: [Width * Height * 4]u8;
    for i: 0 .. Width * Height - 1 {
        offset := i * 4;
        pixels[offset] = Color;
        pixels[offset + 1] = 90;
        pixels[offset + 2] = 170;
        pixels[offset + 3] = 255;
    }
    if Color == 37 {
        if !Surface.Present(Width, Height, TextView(pixels[:])) { return 3 }
    } else {
        half := Width * Height * 2;
        if !Surface.PresentOpaqueRows(Width, Height, 0, TextView(pixels[:half])) ||
           !Surface.PresentOpaqueRows(Width, Height, Height / 2, TextView(pixels[half:])) { return 4 }
        strip: [Width]u32;
        for i: 0 .. Width - 1 { strip[i] = (Color << 16) | 0x5ac8 }
        if !Surface.PresentRGBStrip(Width, Height, Height - 1, strip[:]) { return 5 }
    }
    down := false;
    up := false;
    key := false;
    text := false;
    requested_resize := false;
    while !(up && key && text) {
        event := Surface.Event(1000);
        if event.kind == Surface.Closed {
            if desktop_probe { print("ZX_DESKTOP_CHILD_CLOSED\n"); return 0 }
            return 6;
        }
        if desktop_probe && event.kind == Surface.Resize && event.width == 72 && event.height == 48 {
            requested_resize = true;
            print("ZX_DESKTOP_CHILD_RESIZED\n");
        }
        if desktop_probe && event.kind == Surface.Resize && event.width == 250 && event.height == 100 {
            if !Surface.PresentOpaqueRows(Width, Height, 0, TextView(pixels[:])) { return 15 }
        }
        if requested_resize && event.kind == Surface.Visibility && event.button == 0 {
            if !WM.Resize(56, 40) { return 10 }
        }
        if event.kind == Surface.Down && event.x == 16 && event.y == 17 && event.button == 1 {
            if Surface.PointerMillis() < 0 { return 7 }
            cursor: [2]u8 = .{0x80, 0x80};
            if !WM.SetCursor(0, 0, 8, 2, TextView(cursor[:])) { return 11 }
            down = true;
        }
        if event.kind == Surface.Up && event.button == 1 && down {
            if Draw.SampleGuestPointer() != ((Color << 16) | 0x5aaa) || Draw.SampleGuestPointer() != -1 { return 14 }
            if !WM.SetCursor(0, 0, 0, 0, "") { return 12 }
            up = true;
        }
        if event.kind == Surface.Key && event.key == #char "A" { key = true }
        if event.kind == Surface.TextEvent && event.text == "a" { text = true }
    }
    print("ZX_WINDOW_DONE %\n", Color);
    Surface.Close();
    return 0;
}
