Surface :: #import "zx_surface";

Color :: 37;
Width :: 48;
Height :: 32;

main :: () -> s32 {
    if !Surface.Open("Native window probe", Width, Height) { return 1 }
    if !Surface.SetTitle("ZX surface probe") { return 2 }
    pixels: [Width * Height * 4]u8;
    for i: 0 .. Width * Height - 1 {
        offset := i * 4;
        pixels[offset] = Color;
        pixels[offset + 1] = 90;
        pixels[offset + 2] = 170;
        pixels[offset + 3] = 255;
    }
    if Color == 37 {
        if !Surface.Present(Width, Height, TextView(pixels[:])) { return 3 }
    } else {
        half := Width * Height * 2;
        if !Surface.PresentOpaqueRows(Width, Height, 0, TextView(pixels[:half])) ||
           !Surface.PresentOpaqueRows(Width, Height, Height / 2, TextView(pixels[half:])) { return 4 }
        strip: [Width]u32;
        for i: 0 .. Width - 1 { strip[i] = (Color << 16) | 0x5ac8 }
        if !Surface.PresentRGBStrip(Width, Height, Height - 1, strip[:]) { return 5 }
    }
    down := false;
    up := false;
    key := false;
    text := false;
    while !(up && key && text) {
        event := Surface.Event(1000);
        if event.kind == Surface.Closed { return 6 }
        if event.kind == Surface.Down && event.x == 16 && event.y == 17 && event.button == 1 {
            if Surface.PointerMillis() < 0 { return 7 }
            down = true;
        }
        if event.kind == Surface.Up && event.button == 1 && down { up = true }
        if event.kind == Surface.Key && event.key == #char "A" { key = true }
        if event.kind == Surface.TextEvent && event.text == "a" { text = true }
    }
    print("ZX_WINDOW_DONE %\n", Color);
    Surface.Close();
    return 0;
}
