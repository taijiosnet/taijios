// Guest parity regression for the top-level shell commands A to L rewritten in
// Ziran: env, date, chgrp, chmod, comm, cmp, ... Every expected status, output
// and diagnostic below is what the Limbo original printed. Each case runs
// through the guest shell, which starts /zx/NAME.zx. While /zx/NAME.dis is
// still installed the same case also runs it, from the same starting state,
// and both must agree exactly.
//
// From the TaijiOS root, after "(cd appl/cmd && mk install)":
//     ziran run --target=c --root tests/commands tests/commands/commands_a_l_test.zi -- [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"

Case :: struct {
    tool: string // empty: args is a whole shell command
    args: string
    before: string // shell lines run before each run, in the same guest shell
    input: string // fixture used as standard input; empty reads /dev/null
    status: string
    out: string
    err: string
    binary_out: bool // standard output must equal the binary fixture
    modes: string // files whose ls -ld mode and name are checked after the run
    owner: string // files whose ls -l owner and group are checked after the run
    after_out: string // expected output of the modes or owner check
};

WORK :: "build/dis-commands-a-l/test";

ALPHA :: "alpha\nbeta\nbeta\ncafé κ\n";
WORDS :: "one two  three\nfour\tfive\n";
SQUEEZE :: "abczz\naabb\n";


// The emulator's own variables name this host, so env's cases remove them first.
cases: [88]Case = Case.[
    .{tool = "env", before = "rm /env/emuargs /env/emuroot /env/emuhost /env/emuwdir\na=one\nb='two words'\n", out = "b='two words'\na=one\n"},
    .{tool = "env", args = "x", status = "usage", err = "Usage: env\n"},
    .{tool = "date", args = "-u 0", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "0", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "-u -n 1234567890", out = "1234567890\n"},
    .{tool = "date", args = "-nu 1234567890", out = "1234567890\n"},
    .{tool = "date", args = "-uu 1234567890", out = "Fri Feb 13 23:31:30 GMT 2009\n"},
    .{tool = "date", args = "-- 0", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "''", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "-n 010", out = "10\n"},
    .{tool = "date", args = "-u 1970", out = "Thu Jan 01 00:32:50 GMT 1970\n"},
    .{tool = "date", args = "-u 2147483647", out = "Tue Jan 19 03:14:07 GMT 2038\n"},
    // Limbo's int conversion stops at the largest 32-bit value.
    .{tool = "date", args = "-u 99999999999", out = "Tue Jan 19 03:14:07 GMT 2038\n"},
    .{tool = "date", args = "0 1", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "abc", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "-x", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "-", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "-n 0x10", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "-100", status = "usage", err = "usage: date [-un] [seconds]\n"},
    .{tool = "date", args = "-n -0", status = "usage", err = "usage: date [-un] [seconds]\n"},
    // The shell stores a spaced timezone value quoted, so its first word keeps the quote.
    .{tool = "date", args = "0", before = "timezone='EST -18000 EDT -14400'\n", out = "Wed Dec 31 19:00:00 'EST 1969\n"},
    .{tool = "date", args = "0", before = "timezone='EST -18000 EDT -14400 -1000000000 1000000000'\n", out = "Wed Dec 31 20:00:00 EDT 1969\n"},
    .{tool = "date", args = "0", before = "timezone='X'\n", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "0", before = "timezone='/locale/Argentina'\n", out = "Wed Dec 31 21:00:00 ART 1969\n"},
    .{tool = "date", args = "0", before = "timezone='#/locale/Argentina'\n", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "0", before = "timezone='/nonexistent'\n", out = "Thu Jan 01 00:00:00 GMT 1970\n"},
    .{tool = "date", args = "50", before = "timezone='A 0 B 3600 0 100'\n", out = "Thu Jan 01 01:00:50 B 1970\n"},
    .{tool = "date", args = "100", before = "timezone='A 0 B 3600 0 100'\n", out = "Thu Jan 01 00:01:40 'A 1970\n"},
    // Without an argument date reads /dev/time; only the shape is fixed.
    .{args = "date -n | sed 's/^[0-9][0-9]*$/number/'", out = "number\n"},
    .{args = "date | sed 's/^[A-Z][a-z][a-z] [A-Z][a-z][a-z] [0-9][0-9] [0-9:]* [A-Z]+ 20[0-9][0-9]$/date/'", before = "rm /env/timezone\n", out = "date\n"},
    // chgrp: the hosted filesystem resolves owner and group by name only.
    .{tool = "chgrp", status = "usage", err = "usage: chgrp [-uo] group file ...\n"},
    .{tool = "chgrp", args = "-x", status = "usage", err = "usage: chgrp [-uo] group file ...\n"},
    .{tool = "chgrp", args = "-h 100 f", before = "rm -f f\necho x > f\n", status = "usage", err = "usage: chgrp [-uo] group file ...\n"},
    .{tool = "chgrp", args = "-u", status = "usage", err = "usage: chgrp [-uo] group file ...\n"},
    .{tool = "chgrp", args = "100 f", before = "rm -f f\necho x > f\n", status = "error", err = "chgrp: can't change f: unknown user or group id\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-u 100 f", before = "rm -f f\necho x > f\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-o 100 f", before = "rm -f f\necho x > f\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-uo 100 f", before = "rm -f f\necho x > f\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-- 100 f", before = "rm -f f\necho x > f\n", status = "error", err = "chgrp: can't change f: unknown user or group id\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "100 nonexist", status = "error", err = "chgrp: can't change nonexist: 'nonexist' file does not exist\n"},
    .{tool = "chgrp", args = "100 nonexist f", before = "rm -f f\necho x > f\n", status = "error", err = "chgrp: can't change nonexist: 'nonexist' file does not exist\nchgrp: can't change f: unknown user or group id\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "root f", before = "rm -f f\necho x > f\n", status = "error", err = "chgrp: can't change f: Operation not permitted\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "$u f", before = "rm -f f\necho x > f\nu=`{cat /dev/user}\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-u $u f", before = "rm -f f\necho x > f\nu=`{cat /dev/user}\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-uo $u f", before = "rm -f f\necho x > f\nu=`{cat /dev/user}\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "-ou $u f", before = "rm -f f\necho x > f\nu=`{cat /dev/user}\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "100", before = "rm -f f\necho x > f\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "100 ''", before = "rm -f f\necho x > f\n", status = "error", err = "chgrp: can't change : empty file name\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "'' f", before = "rm -f f\necho x > f\n", owner = "f", after_out = "user user\n"},
    .{tool = "chgrp", args = "$u d", before = "rm -r d\nmkdir d\nu=`{cat /dev/user}\n", owner = "d", after_out = "user user\n"},
    // chmod: an octal mode, or [augo][+-=][rwxalt] against the current mode.
    .{tool = "chmod", status = "usage", err = "usage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n"},
    .{tool = "chmod", args = "644", status = "usage", err = "usage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n"},
    .{tool = "chmod", args = "600 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rw------- f\n"},
    .{tool = "chmod", args = "8r600 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rw------- f\n"},
    .{tool = "chmod", args = "0755 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rwxr-xr-x f\n"},
    .{tool = "chmod", args = "' 644' f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "1000 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "----------- f\n"},
    .{tool = "chmod", args = "8r0 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "----------- f\n"},
    .{tool = "chmod", args = "8r777777 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rwxrwxrwx f\n"},
    .{tool = "chmod", args = "8r-1 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rwxrwxrwx f\n"},
    .{tool = "chmod", args = "8r77777777777777777777777 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rwxrwxrwx f\n"},
    .{tool = "chmod", args = "77777777777777777777777777 f", before = "rm -f f\necho x > f\n", modes = "f", after_out = "--rwxrwxrwx f\n"},
    .{tool = "chmod", args = "-777 f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "----------x f\n"},
    .{tool = "chmod", args = "u+x f", before = "rm -f f\necho x > f\nchmod 600 f\n", modes = "f", after_out = "--rwx------ f\n"},
    .{tool = "chmod", args = "go-rx f", before = "rm -f f\necho x > f\nchmod 755 f\n", modes = "f", after_out = "--rwx------ f\n"},
    .{tool = "chmod", args = "'a=rw' f", before = "rm -f f\necho x > f\nchmod 600 f\n", modes = "f", after_out = "--rw-rw-rw- f\n"},
    .{tool = "chmod", args = "+x f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rwxr-xr-x f\n"},
    .{tool = "chmod", args = "g+w f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rw-rw-r-- f\n"},
    .{tool = "chmod", args = "ug+r f", before = "rm -f f\necho x > f\nchmod 600 f\n", modes = "f", after_out = "--rw-r----- f\n"},
    .{tool = "chmod", args = "'u=' f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "-----r--r-- f\n"},
    .{tool = "chmod", args = "'u+' f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "a+l f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "a+t f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "a+a f", before = "rm -f f\necho x > f\nchmod 644 f\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "755 f g", before = "rm -f f g\necho x > f\necho y > g\n", modes = "f g", after_out = "--rwxr-xr-x f\n--rwxr-xr-x g\n"},
    .{tool = "chmod", args = "644 d", before = "rm -r d\nmkdir d\nchmod 755 d\n", modes = "d", after_out = "d-rw-r--r-- d\n"},
    .{tool = "chmod", args = "999 f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode '999'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n", modes = "f", after_out = "--rw------- f\n"},
    .{tool = "chmod", args = "bad f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode 'bad'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "0x1ff f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode '0x1ff'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "8r f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode ''\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "'' f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode ''\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "x f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode 'x'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "a+x+l+t f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode 'a+x+l+t'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "u+x+y f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode 'u+x+y'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "'u=rw,go-w' f", before = "rm -f f\necho x > f\n", status = "usage", err = "chmod: bad mode 'u=rw,go-w'\nusage: chmod [8r]777 file ... or chmod [augo][+-=][rwxal] file ...\n",},
    .{tool = "chmod", args = "644 nonexist", err = "chmod: cannot stat nonexist: 'nonexist' file does not exist\n"},
    .{tool = "chmod", args = "644 nonexist f", before = "rm -f f\necho x > f\nchmod 600 f\n", err = "chmod: cannot stat nonexist: 'nonexist' file does not exist\n", modes = "f", after_out = "--rw-r--r-- f\n"},
    .{tool = "chmod", args = "a+w nonexist f", before = "rm -f f\necho x > f\nchmod 600 f\n", err = "chmod: cannot stat nonexist: 'nonexist' file does not exist\n", modes = "f", after_out = "--rw--w--w- f\n"},
];

failures: s32;

Expect :: (ok: bool, index: s64, what: string, got: string, want: string) {
    if ok { return }
    failures += 1
    print("FAIL case % (% %) %:\n  got  [%]\n  want [%]\n", index, cases[index].tool, cases[index].args, what, got, want)
}

Write :: (name: string, text: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/work/%", WORK, name)
    return WriteEntireFile(BuilderFinish(path), text)
}

Directory :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", WORK, name)
    return CreateDirectory(BuilderFinish(path))
}

// The bytes 0 through 255, forty times: crosses the 8 KiB transfer size.
Binary :: () -> Text {
    bytes: Vec(u8)
    for 1..40 { for 0..255 { VecPush(bytes, cast(u8)it) } }
    return BuilderFinish(bytes)
}

Prepare :: (binary: string) -> bool {
    unused RemoveTree(WORK)
    unused CreateDirectory("build")
    unused CreateDirectory("build/dis-commands-a-l")
    if !CreateDirectory(WORK) || !Directory("work") || !Directory("result") ||
        !Directory("work/tree") || !Directory("work/tree/sub") { return false }
    return Write("a.txt", ALPHA) && Write("words", WORDS) && Write("squeeze", SQUEEZE) &&
        Write("empty", "") && Write("bin", binary) && Write("-dash", "dash\n") &&
        Write("café blanc", "c\n") && Write("tree/x", "x\n") && Write("tree/sub/y", "yy\n")
}

// /zx/NAME.dis is compared while it is still installed.
DisInstalled :: (tool: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "zx/%.dis", tool)
    return PathExists(BuilderFinish(path))
}

// The shell lines that record the state a case checks after its run.
After :: (item: Case) -> string {
    text: Vec(u8)
    // ls -ld without the owner, group, size and date columns.
    if item.modes != "" {
        BuilderPrint(*text, "ls -ld % | sed 's/ [A-Z] [0-9][0-9]* [^ ]* [^ ]* [0-9][0-9]* [A-Z][a-z][a-z] [0-9][0-9]* [0-9:]*//'", item.modes)
        return BuilderFinish(text)
    }
    // ls -ld with only the owner and group, the user's own name as "user".
    if item.owner != "" {
        BuilderPrint(*text, "ls -ld % | sed 's/^.* [A-Z] [0-9][0-9]* //' | sed 's/ [0-9][0-9]* .*//' | sed s/$u/user/g", item.owner)
        return BuilderFinish(text)
    }
    return ""
}

// One guest shell script runs every case: the ZX command, and the Dis one
// while it is installed, each from the same starting state and each keeping
// its results in a file.
Script :: () -> Text {
    script: Vec(u8)
    BuilderPrint(*script, "cd /%/work\n", WORK)
    for cases {
        after := After(it)
        input := ifx it.input == "" then "/dev/null" else it.input
        if it.tool == "" {
            if it.before != "" { BuilderAppend(script, it.before) }
            BuilderPrint(*script, "{%}", it.args)
        } else {
            if DisInstalled(it.tool) {
                if it.before != "" { BuilderAppend(script, it.before) }
                BuilderPrint(*script, "/zx/%.dis %", it.tool, it.args)
                BuilderPrint(*script, " < % > ../result/dis.out.% >[2] ../result/dis.err.%\n", input, it_index, it_index)
                BuilderPrint(*script, "echo $status > ../result/dis.status.%\n", it_index)
                if after != "" {
                    if it.owner != "" { unused BuilderAppend(script, "u=`{cat /dev/user}\n") }
                    BuilderPrint(*script, "{%\n} > ../result/dis.after.% >[2] ../result/dis.after.%\n", after, it_index, it_index)
                }
            }
            if it.before != "" { BuilderAppend(script, it.before) }
            BuilderPrint(*script, "% %", it.tool, it.args)
        }
        BuilderPrint(*script, " < % > ../result/zx.out.% >[2] ../result/zx.err.%\n", input, it_index, it_index)
        BuilderPrint(*script, "echo $status > ../result/zx.status.%\n", it_index)
        if after != "" {
            if it.owner != "" { unused BuilderAppend(script, "u=`{cat /dev/user}\n") }
            BuilderPrint(*script, "{%\n} > ../result/zx.after.% >[2] ../result/zx.after.%\n", after, it_index, it_index)
        }
    }
    return BuilderFinish(script)
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index)
    text, ok := ReadEntireFile(BuilderFinish(path))
    return ifx ok then text else "<missing>"
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else (ifx PathExists("emu/Linux/o.emu") then "emu/Linux/o.emu" else "Linux/386/bin/emu")
    binary: Text = Binary()
    if !Prepare(TextView(binary)) { print("cannot prepare %\n", WORK); return 1 }
    script: Text = Script()
    script_path: Vec(u8)
    BuilderPrint(*script_path, "%/script", WORK)
    if !WriteEntireFile(BuilderFinish(script_path), TextView(script)) { return 1 }
    root: Text = WorkingDirectory()
    guest: Vec(u8)
    BuilderPrint(*guest, "/%/script", WORK)
    command: [5]string = .[emu, "-r", TextView(root), "/zx/sh.dis", BuilderFinish(guest)]
    run: ProcessRun
    started := RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run)
    if !started { print("cannot start %\n", emu); return 1 }
    for cases {
        status_line: Vec(u8)
        BuilderPrint(*status_line, "%\n", it.status)
        status := BuilderFinish(status_line)
        got_status := Result("zx.status", it_index)
        Expect(got_status == status, it_index, "status", got_status, status)
        out := Result("zx.out", it_index)
        want := ifx it.binary_out then TextView(binary) else it.out
        Expect(out == want, it_index, "stdout", out, want)
        err := Result("zx.err", it_index)
        Expect(err == it.err, it_index, "stderr", err, it.err)
        compared := it.tool != "" && DisInstalled(it.tool)
        if compared {
            dis_status := Result("dis.status", it_index)
            Expect(dis_status == got_status, it_index, "Dis status", dis_status, got_status)
            dis_out := Result("dis.out", it_index)
            Expect(dis_out == out, it_index, "Dis stdout", dis_out, out)
            dis_err := Result("dis.err", it_index)
            Expect(dis_err == err, it_index, "Dis stderr", dis_err, err)
        }
        if it.modes != "" || it.owner != "" {
            after := Result("zx.after", it_index)
            Expect(after == it.after_out, it_index, "after", after, it.after_out)
            if compared {
                dis_after := Result("dis.after", it_index)
                Expect(dis_after == after, it_index, "Dis after", dis_after, after)
            }
        }
    }
    if failures != 0 { print("commands a-l: % failures in % cases\n", failures, cases.count); return 1 }
    print("commands a-l: all % cases match the Limbo originals\n", cases.count)
    return 0
}
