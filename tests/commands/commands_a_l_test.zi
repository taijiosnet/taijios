// Guest parity regression for the top-level shell commands A to L rewritten in
// Ziran: env, date, chgrp, chmod, comm, cmp, ... Every expected status, output
// and diagnostic below is what the Limbo original printed. Each case runs
// through the guest shell, which starts /dis/NAME.zx. While /dis/NAME.dis is
// still installed the same case also runs it, and both must agree exactly.
//
// From the TaijiOS root, after "(cd appl/cmd && mk install)":
//     ziran run --target=c --root tests/commands tests/commands/commands_a_l_test.zi -- [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"

Case :: struct {
    tool: string // empty: args is a whole shell command
    args: string
    before: string // shell lines run first, in the same guest shell
    input: string // fixture used as standard input; empty reads /dev/null
    status: string
    out: string
    err: string
    binary_out: bool // standard output must equal the binary fixture
}

WORK :: "build/dis-commands-a-l/test";

ALPHA :: "alpha\nbeta\nbeta\ncafé κ\n";
WORDS :: "one two  three\nfour\tfive\n";
SQUEEZE :: "abczz\naabb\n";

// The emulator's own variables name this host, so env's cases remove them first.
cases: [2]Case = Case.[
    .{tool = "env", before = "rm /env/emuargs /env/emuroot /env/emuhost /env/emuwdir\na=one\nb='two words'\n", out = "b='two words'\na=one\n"},
    .{tool = "env", args = "x", status = "usage", err = "Usage: env\n"},
];

failures: s32;

Expect :: (ok: bool, index: s64, what: string, got: string, want: string) {
    if ok { return }
    failures += 1
    print("FAIL case % (% %) %:\n  got  [%]\n  want [%]\n", index, cases[index].tool, cases[index].args, what, got, want)
}

Write :: (name: string, text: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/work/%", WORK, name)
    return WriteEntireFile(BuilderFinish(path), text)
}

Directory :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", WORK, name)
    return CreateDirectory(BuilderFinish(path))
}

// The bytes 0 through 255, forty times: crosses the 8 KiB transfer size.
Binary :: () -> Text {
    bytes: Vec(u8)
    for 1..40 { for 0..255 { VecPush(bytes, cast(u8)it) } }
    return BuilderFinish(bytes)
}

Prepare :: (binary: string) -> bool {
    unused RemoveTree(WORK)
    unused CreateDirectory("build")
    unused CreateDirectory("build/dis-commands-a-l")
    if !CreateDirectory(WORK) || !Directory("work") || !Directory("result") ||
        !Directory("work/tree") || !Directory("work/tree/sub") { return false }
    return Write("a.txt", ALPHA) && Write("words", WORDS) && Write("squeeze", SQUEEZE) &&
        Write("empty", "") && Write("bin", binary) && Write("-dash", "dash\n") &&
        Write("café blanc", "c\n") && Write("tree/x", "x\n") && Write("tree/sub/y", "yy\n")
}

// /dis/NAME.dis is compared while it is still installed.
DisInstalled :: (tool: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "dis/%.dis", tool)
    return PathExists(BuilderFinish(path))
}

// One guest shell script runs every case: the ZX command, and the Dis one
// while it is installed, each keeping its results in a file.
Script :: () -> Text {
    script: Vec(u8)
    BuilderPrint(*script, "cd /%/work\n", WORK)
    for cases {
        if it.before != "" { BuilderAppend(script, it.before) }
        input := ifx it.input == "" then "/dev/null" else it.input
        if it.tool == "" {
            BuilderPrint(*script, "{%}", it.args)
        } else {
            if DisInstalled(it.tool) {
                BuilderPrint(*script, "/dis/%.dis %", it.tool, it.args)
                BuilderPrint(*script, " < % > ../result/dis.out.% >[2] ../result/dis.err.%\n", input, it_index, it_index)
                BuilderPrint(*script, "echo $status > ../result/dis.status.%\n", it_index)
            }
            BuilderPrint(*script, "% %", it.tool, it.args)
        }
        BuilderPrint(*script, " < % > ../result/zx.out.% >[2] ../result/zx.err.%\n", input, it_index, it_index)
        BuilderPrint(*script, "echo $status > ../result/zx.status.%\n", it_index)
    }
    return BuilderFinish(script)
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index)
    text, ok := ReadEntireFile(BuilderFinish(path))
    return ifx ok then text else "<missing>"
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else (ifx PathExists("emu/Linux/o.emu") then "emu/Linux/o.emu" else "Linux/386/bin/emu")
    binary: Text = Binary()
    if !Prepare(TextView(binary)) { print("cannot prepare %\n", WORK); return 1 }
    script: Text = Script()
    script_path: Vec(u8)
    BuilderPrint(*script_path, "%/script", WORK)
    if !WriteEntireFile(BuilderFinish(script_path), TextView(script)) { return 1 }
    root: Text = WorkingDirectory()
    guest: Vec(u8)
    BuilderPrint(*guest, "/%/script", WORK)
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)]
    run: ProcessRun
    started := RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run)
    if !started { print("cannot start %\n", emu); return 1 }
    for cases {
        status_line: Vec(u8)
        BuilderPrint(*status_line, "%\n", it.status)
        status := BuilderFinish(status_line)
        got_status := Result("zx.status", it_index)
        Expect(got_status == status, it_index, "status", got_status, status)
        out := Result("zx.out", it_index)
        want := ifx it.binary_out then TextView(binary) else it.out
        Expect(out == want, it_index, "stdout", out, want)
        err := Result("zx.err", it_index)
        Expect(err == it.err, it_index, "stderr", err, it.err)
        if it.tool != "" && DisInstalled(it.tool) {
            dis_status := Result("dis.status", it_index)
            Expect(dis_status == got_status, it_index, "Dis status", dis_status, got_status)
            dis_out := Result("dis.out", it_index)
            Expect(dis_out == out, it_index, "Dis stdout", dis_out, out)
            dis_err := Result("dis.err", it_index)
            Expect(dis_err == err, it_index, "Dis stderr", dis_err, err)
        }
    }
    if failures != 0 { print("commands a-l: % failures in % cases\n", failures, cases.count); return 1 }
    print("commands a-l: all % cases match the Limbo originals\n", cases.count)
    return 0
}
