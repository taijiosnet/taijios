// Guest regression for the top-level shell commands M to Z rewritten in Ziran.
// Every expected status, output and diagnostic below is what the Limbo
// original printed when it was replaced. Each case runs through the guest
// shell, which starts /dis/NAME.zx.
//
// From the TaijiOS root, after "(cd appl/cmd && mk install)":
//     ziran run --target=c --root tests/commands tests/commands/m_z_test.zi -- [EMU]
// EMU defaults to the emulator built from this tree, emu/Linux/o.emu, and
// to Linux/386/bin/emu when that has not been built.
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"

Case :: struct {
    tool: string // empty: args is a whole shell command
    args: string
    input: string // fixture used as standard input; empty reads /dev/null
    status: string
    out: string
    err: string
    binary_out: bool // standard output must equal the binary fixture
}

WORK :: "build/tests/commands-m-z";

ALPHA :: "alpha\nbeta\nbeta\ncafé κ\n";
WORDS :: "one two  three\nfour\tfive\n";
QUICK :: "The quick brown fox\n";
UNSORTED :: "banana\napple\nCherry\napple\n10\n9\n100\n-5\n";

cases: [210]Case = Case.[
    .{tool = "pwd", out = "/build/tests/commands-m-z/work\n"},
    .{tool = "pwd", args = "ignored arguments", out = "/build/tests/commands-m-z/work\n"},
    .{tool = "pwd", args = "-x", out = "/build/tests/commands-m-z/work\n"},
    // tokenize: split at any delimiter, none quoted, leading and repeats skipped.
    .{tool = "tokenize", args = "'a b  c' ' '", out = "a\nb\nc\n"},
    .{tool = "tokenize", args = "'a,b,,c' ','", out = "a\nb\nc\n"},
    .{tool = "tokenize", args = "'  lead and trail  ' ' '", out = "lead\nand\ntrail\n"},
    .{tool = "tokenize", args = "'a b' ' ,'", out = "a\nb\n"},
    .{tool = "tokenize", args = "'a\"b c\"d e' ' '", out = "a\"b\nc\"d\ne\n"},
    .{tool = "tokenize", args = "one", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", args = "a b c", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", args = "'' ' '", out = ""},
    .{tool = "tokenize", args = "'a\tb' ' '", out = "a\tb\n"},
    .{tool = "tokenize", args = "'ab' 'b'", out = "a\n"},
    .{tool = "tokenize", args = "'café κλά' ' '", out = "café\nκλά\n"},
    .{tool = "tokenize", args = "'aébc' 'é'", out = "a\nbc\n"},
    .{tool = "tokenize", args = "'aéb c' ' '", out = "aéb\nc\n"},
    // newer: status only, nothing on standard error except usage.
    .{tool = "newer", args = "gone1 gone2", status = "new:'gone1' file does not exist"},
    .{tool = "newer", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "gone1", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "gone1 gone2 gone3", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "a.txt gone2", status = "old:'gone2' file does not exist"},
    .{tool = "newer", args = "a.txt tree", status = "old:directory"},
    .{tool = "newer", args = "tree a.txt", status = "new:directory"},
    .{tool = "newer", args = "a.txt words"},
    .{args = "sleep 1; echo x > late; /dis/newer.zx a.txt late", status = "older"},
    .{tool = "newer", args = "-dash -dash"},
    // read: one read of count bytes after an optional seek.
    .{tool = "read", args = "5", input = "a.txt", out = "alpha"},
    .{tool = "read", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "0", input = "a.txt"},
    .{tool = "read", args = "3", input = "empty", status = "eof"},
    .{tool = "read", args = "abc", input = "a.txt"},
    .{tool = "read", args = "0x5", input = "a.txt"},
    .{tool = "read", args = "5abc", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-o 2 3", input = "a.txt", out = "pha"},
    .{tool = "read", args = "-e 2 3", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-r 1 3", input = "a.txt", out = "lph"},
    .{tool = "read", args = "-o 2", input = "a.txt", out = "pha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "-x 2 3", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-o", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "1 2", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-o 1 2 3", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-5", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "''", input = "a.txt"},
    .{tool = "read", args = "' 5'", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-o -1 3", input = "a.txt", out = "alp"},
    .{tool = "read", args = "-o x 3", input = "a.txt", out = "alp"},
    .{tool = "read", args = "100000", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "-o 100 5", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-e 0 5", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-r -2 5", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-e -10 3", input = "a.txt", out = "\nca"},
    .{tool = "read", args = "-o 24 3", input = "a.txt", out = "\n"},
    .{tool = "read", args = "26", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "5", input = "words", out = "one t"},
    .{tool = "read", args = "2", input = "empty", status = "eof"},
    // sum: crc, six-wide size, name; directories skipped, failures reported.
    .{tool = "sum", args = "a.txt", out = "78465aa6     25 a.txt\n"},
    .{tool = "sum", args = "nosuch", status = "error", err = "sum: cannot get status of nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sum", args = "."},
    .{tool = "sum"},
    .{tool = "sum", args = "nosuch . a.txt", status = "error", out = "78465aa6     25 a.txt\n", err = "sum: cannot get status of nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sum", args = "empty words bin", out = "2aa280dc      0 empty\n652bf7c4     25 words\n16ad4d37  10240 bin\n"},
    .{tool = "sum", args = "-", status = "error", err = "sum: cannot get status of -: '-' file does not exist\n"},
    .{tool = "sum", args = "a.txt a.txt", out = "78465aa6     25 a.txt\n78465aa6     25 a.txt\n"},
    // randpass: a random base64 password, nine to 256 characters long.
    .{args = "{ randpass | sed 's/./x/g' }", out = "xxxxxxxxxxxxxxxx\n"},
    .{args = "{ randpass 9 | sed 's/./x/g' }", out = "xxxxxxxxx\n"},
    .{args = "{ randpass 9 extra | sed 's/./x/g' }", out = "xxxxxxxxx\n"},
    .{tool = "randpass", args = "8", status = "usage", err = "Usage: randpass [password-length(<256, default=16)]\n"},
    .{tool = "randpass", args = "257", status = "usage", err = "Usage: randpass [password-length(<256, default=16)]\n"},
    .{tool = "randpass", args = "abc", status = "usage", err = "Usage: randpass [password-length(<256, default=16)]\n"},
    .{tool = "randpass", args = "0", status = "usage", err = "Usage: randpass [password-length(<256, default=16)]\n"},
    .{tool = "randpass", args = "-1", status = "usage", err = "Usage: randpass [password-length(<256, default=16)]\n"},
    .{args = "{ randpass 256 | wc -c }", out = "    257\n"},
    // zeros: one block of a byte value, or one random block, written n times.
    .{tool = "zeros", args = "-v 41 4 2", out = "AAAAAAAA"},
    .{tool = "zeros", args = "-v 41", out = "A"},
    .{args = "{ zeros 4 2 | wc -c }", out = "      8\n"},
    .{args = "{ zeros 4 2 3 | wc -c }", out = "      8\n"},
    .{args = "{ zeros 10x 2 | wc -c }", out = "     20\n"},
    .{args = "{ zeros -v 0x7f 2 1 | wc -c }", out = "      2\n"},
    .{args = "{ zeros -v 41 8 1 | strings }", out = "       0: AAAAAAAA\n"},
    .{args = "{ zeros -v 0x7f 8 1 | strings }"},
    .{args = "{ zeros -v 300 8 1 | strings }"},
    .{args = "{ zeros -v zz 8 1 | strings }"},
    .{tool = "zeros", args = "0", status = "usage", err = "usage: zeros [-r] [-v value] blocksize [number]\n"},
    .{tool = "zeros", args = "4 0", status = "usage", err = "usage: zeros [-r] [-v value] blocksize [number]\n"},
    .{tool = "zeros", args = "abc", status = "usage", err = "usage: zeros [-r] [-v value] blocksize [number]\n"},
    .{tool = "zeros", args = "4 abc", status = "usage", err = "usage: zeros [-r] [-v value] blocksize [number]\n"},
    .{tool = "zeros", args = "-x 4 2", status = "unknown option (x)"},
    .{args = "{ zeros -r 4 2 > r1; sum r1 | sed 's/^[0-9a-f]* /CRC /' }", out = "CRC      8 r1\n"},
    // One random block written twice: both halves share one checksum.
    .{args = "{ zeros -r 32 2 > r2; read -o 0 32 < r2 > p1; read -o 32 32 < r2 > p2; sum p1 p2 | sed 's/ p[12]$//' | uniq | wc -l }", out = "      1\n"},
    // touch: creates or sets the modification time; -c never creates.
    .{args = "{ touch -t 1000000000 t1; newer t1 a.txt }", status = "older"},
    .{args = "{ touch -t 1000000000 t1; sleep 1; touch t1; newer t1 a.txt }"},
    .{args = "{ touch -t abc t3; newer t3 a.txt }", status = "older"},
    .{tool = "touch", args = "-c t2", status = "touch", err = "touch: t2: cannot change time: 't2' file does not exist\n"},
    .{tool = "touch", args = "nosuchdir/x", status = "touch", err = "touch: nosuchdir/x: cannot create: 'nosuchdir' file does not exist\n"},
    .{tool = "touch", status = "usage", err = "usage: touch [-c] [-t time] file ...\n"},
    .{tool = "touch", args = "-x t1", status = "usage", err = "usage: touch [-c] [-t time] file ...\n"},
    // strings: runs of at least six printable bytes, eight-wide offsets.
    .{tool = "strings", args = "a.txt", out = "      16: café κ\n"},
    .{tool = "strings", input = "a.txt", out = "      16: café κ\n"},
    .{tool = "strings", args = "''", input = "a.txt", out = "      16: café κ\n"},
    .{tool = "strings", args = "nosuch", err = "cannot open nosuch\n"},
    .{tool = "strings", args = "a.txt nosuch", out = "a.txt:\n      16: café κ\nnosuch:\n", err = "cannot open nosuch\n"},
    .{tool = "strings", args = "s1", out = "       3: abcdef\n"},
    .{tool = "strings", args = "s2", out = "       0: qaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ...\n      70: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n     102: zzzzzz\n"},
    .{tool = "strings", args = "short"},
    .{tool = "strings", args = "s1 short s1", out = "s1:\n       3: abcdef\nshort:\ns1:\n       3: abcdef\n"},
    // md5sum: digest, a tab and the name; standard input has no name.
    .{tool = "md5sum", input = "a.txt", out = "927effb95bbe6703d655f813398a1031\n"},
    .{tool = "md5sum", args = "a.txt", out = "927effb95bbe6703d655f813398a1031\ta.txt\n"},
    .{tool = "md5sum", args = "bin", out = "c3cd26e07e555c0116db237fbc06d99c\tbin\n"},
    .{tool = "md5sum", args = "''", status = "error", err = "md5sum: cannot open : empty file name\n"},
    .{tool = "md5sum", args = "nosuch", status = "error", err = "md5sum: cannot open nosuch: 'nosuch' file does not exist\n"},
    .{tool = "md5sum", args = "nosuch a.txt", status = "error", out = "927effb95bbe6703d655f813398a1031\ta.txt\n", err = "md5sum: cannot open nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sha1sum", input = "a.txt", out = "5e5d745a8a9035905fa69c5d3c51e3f1f757077a\n"},
    .{tool = "sha1sum", args = "a.txt", out = "5e5d745a8a9035905fa69c5d3c51e3f1f757077a\ta.txt\n"},
    .{tool = "sha1sum", args = "bin", out = "36812e99f2d591c5114a7b09519ea9d7daba2380\tbin\n"},
    // timestamp: elapsed milliseconds zero-padded to ten digits, then the note.
    .{args = "{ timestamp note < a.txt | sed 's/[0-9][0-9]*/N/g' }", out = "N note start N\nN note alpha\nN note beta\nN note beta\nN note café κ\n"},
    .{args = "{ timestamp < /dev/null | sed 's/[0-9][0-9]*/N/g' }", out = "N start N\n"},
    // ps: every numeric entry of /prog, its first 128 status bytes, in a private namespace.
    .{args = "{ bind fakeprog /prog; ps | sort; unmount /prog }", out = "proc1 one\nproc2 two\nproc3\nyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\n"},
    // unmount: removes a bind or mount; errors never change the status.
    .{tool = "unmount", args = "/nonesuch", err = "unmount: '/nonesuch' file does not exist\n"},
    .{tool = "unmount", args = "a.txt", err = "unmount: not mounted\n"},
    .{tool = "unmount", err = "Usage: unmount [source] target\n"},
    .{tool = "unmount", args = "a b c", err = "Usage: unmount [source] target\n"},
    .{args = "{ bind fakeprog tree/sub; cat tree/sub/1/status; unmount tree/sub; cat tree/sub/1/status }", out = "proc1 one", status = "bad open", err = "cat: cannot open tree/sub/1/status: 'tree/sub/1' does not exist\n"},
    .{args = "{ bind fakeprog tree/sub; unmount fakeprog tree/sub; cat tree/sub/1/status }", status = "bad open", err = "cat: cannot open tree/sub/1/status: 'tree/sub/1' does not exist\n"},
    // netstat: the numbered entries of each protocol directory.
    .{tool = "netstat"},
    .{tool = "netstat", args = "ignored"},
    // rm: usage, -r on files and directories, -f quiet, -F makes directories writable.
    .{args = "{ chmod 555 d4; chmod 555 d7/c; chmod 555 d8 }"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    .{tool = "rm", args = "-x a", status = "usage", err = "Usage: rm [-fr] file ...\n"},
    .{tool = "rm", args = "-- q2"},
    .{tool = "rm", args = "-r q2", status = "errors", err = "rm: q2: 'q2' file does not exist\n"},
    .{tool = "rm", args = "nosuch", status = "errors", err = "rm: nosuch: 'nosuch' file does not exist\n"},
    .{tool = "rm", args = "''", status = "errors", err = "rm: : empty file name\n"},
    .{tool = "rm", args = "-f nosuch ''"},
    .{tool = "rm", args = "-fr d8"},
    .{tool = "rm", args = "-r d8", status = "errors", err = "rm: d8/x: permission denied\nrm: d8: Directory not empty\n"},
    .{tool = "rm", args = "-r d4", status = "errors", err = "rm: d4/x: permission denied\nrm: d4: Directory not empty\n"},
    .{tool = "rm", args = "-rF d4"},
    .{tool = "rm", args = "d4", status = "errors", err = "rm: d4: 'd4' file does not exist\n"},
    .{tool = "rm", args = "-r d7", status = "errors", err = "rm: d7/c/z: permission denied\nrm: d7/c: Directory not empty\nrm: d7: Directory not empty\n"},
    .{args = "{ ls d7 }", out = "d7/c\n"},
    .{args = "{ chmod 755 d7/c }"},
    .{tool = "rm", args = "-rf d7"},
    .{tool = "rm", args = "d7", status = "errors", err = "rm: d7: 'd7' file does not exist\n"},
    .{tool = "rm", args = "-F d9", status = "errors", err = "rm: d9: Directory not empty\n"},
    .{tool = "rm", args = "dempty"},
    .{tool = "rm", args = "dempty", status = "errors", err = "rm: dempty: 'dempty' file does not exist\n"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    // uuencode: the begin line, 45-byte lines, a space for the empty last line.
    .{tool = "uuencode", err = "usage: uuencode [ sourcefile ] remotefile\n"},
    .{tool = "uuencode", args = "q.txt remote extra", err = "usage: uuencode [ sourcefile ] remotefile\n"},
    .{tool = "uuencode", args = "q.txt remote", out = "begin 600 remote\n45&AE('%U:6-K(&)R;W=N(&9O> H \n \nend\n"},
    .{tool = "uuencode", args = "out", input = "hello", out = "begin 666 out\n%:&5L;&\\ \n \nend\n"},
    .{tool = "uuencode", args = "empty remote", out = "begin 600 remote\n \nend\n"},
    .{tool = "uuencode", args = "'' remote", err = "cannot open \n"},
    .{tool = "uuencode", args = "nosuch remote", err = "cannot open nosuch\n"},
    .{tool = "uuencode", args = "dd remote", err = "cannot uuencode a directory\n"},
    .{args = "{ uuencode bin remote > bin.uu; uudecode -p < bin.uu > out.bin; cmp out.bin bin }"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    // uudecode: to standard output with -p, otherwise to the named file in mode 644.
    .{tool = "uudecode", args = "-p", input = "six.uu", out = "Cat"},
    .{tool = "uudecode", input = "six.uu"},
    .{tool = "uudecode", args = "-p six.uu junk.uu", out = "CatCat"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    .{tool = "uudecode", args = "-p", input = "bad0.uu", out = "Cat", err = "bad 0 count line\n"},
    .{tool = "uudecode", args = "-p", input = "badend.uu", out = "Cat", err = "missing end line\n"},
    .{tool = "uudecode", args = "-p", input = "noend.uu", out = "Cat", err = "missing end line\n"},
    .{tool = "uudecode", args = "-p", input = "toolong.uu", err = "bad uuencode count\n"},
    .{tool = "uudecode", args = "-p", input = "shortline.uu", err = "bad uuencode count\n"},
    .{tool = "uudecode", args = "-p", input = "toomany.uu", err = "too many bytes on line\n"},
    .{tool = "uudecode", args = "-p", input = "badbegin.uu", err = "bad begin line\n"},
    .{tool = "uudecode", args = "-p", input = "junk.uu", out = "Cat"},
    .{tool = "uudecode", args = "-p", input = "nobegin.uu", err = "no begin line\n"},
    .{tool = "uudecode", args = "six.uu"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    .{args = "{ cat name; ls -lm name | sed 's/ U 0.*//' }", out = "Cat[] --rw-r--r--\n"},
    .{tool = "uudecode", args = "tilde.uu", err = "cannot create /usr/u/f: '/usr/u' does not exist\n"},
    .{args = "{ ls fakenet/2 }", out = "fakenet/2/local
fakenet/2/remote
fakenet/2/status
"},
    .{tool = "uudecode", args = "-p", input = "tilde.uu", out = "Cat"},
    .{tool = "uudecode", args = "-p", input = "empty", err = "no begin line\n"},
    .{tool = "uudecode", args = "-p -x", input = "six.uu", err = "cannot open -x\n"},
    .{tool = "uudecode", args = "-x", input = "six.uu", err = "cannot open -x\n"},
    .{tool = "uudecode", args = "nosuch", err = "cannot open nosuch\n"},
    .{args = "{ bind fakenet /net/tcp; netstat; unmount /net/tcp }", out = "tcp/2      wao        Established  udp!0.0.0.0!53       udp!9.9.9.9!53\ntcp/1      wao        listen       tcp!1.2.3.4!80       tcp!5.6.7.8!1234\n"},
    // sleep: only a signed number of seconds is accepted; the rest is usage.
    .{tool = "sleep", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "abc", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "-", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "1abc", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "0x10", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "-- 1", status = "usage", err = "usage: sleep time\n"},
    .{tool = "sleep", args = "0"},
    .{tool = "sleep", args = "1 2"},
    // runas: sets /dev/user and runs the command through the shell.
    .{tool = "runas", status = "usage", err = "usage: runas user cmd [args...]\n"},
    .{tool = "runas", args = "user", status = "usage", err = "usage: runas user cmd [args...]\n"},
    .{args = "runas nobody cat /dev/user", out = "nobody"},
    .{args = "runas user echo hello", out = "hello\n"},
    // p: page size parsing, a missing file and the short input that fits one
    // page. Paging itself waits on /dev/cons, so it is left out here.
    .{tool = "p", args = "short", out = "short\n"},
    .{tool = "p", args = "-200 short", out = "short\n"},
    .{tool = "p", args = "-0 short", status = "usage", err = "Usage: p [-number] [file...]\n"},
    .{tool = "p", args = "-x short", status = "usage", err = "Usage: p [-number] [file...]\n"},
    .{tool = "p", args = "-novalue short", status = "usage", err = "Usage: p [-number] [file...]\n"},
    .{tool = "p", args = "nosuch", err = "p: nosuch: can't open nosuch: 'nosuch' file does not exist\n"},
    // A missing file is reported and the rest still prints.
    .{tool = "p", args = "nosuch short", out = "short\n", err = "p: nosuch: can't open nosuch: 'nosuch' file does not exist\n"},
    // sort: byte order, then numeric order where a non-number reads as zero.
    .{tool = "sort", args = "unsorted", out = "-5\n10\n100\n9\nCherry\napple\napple\nbanana\n"},
    .{tool = "sort", args = "-r unsorted", out = "banana\napple\napple\nCherry\n9\n100\n10\n-5\n"},
    .{tool = "sort", args = "-n unsorted", out = "-5\nbanana\napple\nCherry\napple\n9\n10\n100\n"},
    .{tool = "sort", args = "-nr unsorted", out = "100\n10\n9\napple\nCherry\napple\nbanana\n-5\n"},
    .{tool = "sort", input = "unsorted", out = "-5\n10\n100\n9\nCherry\napple\napple\nbanana\n"},
    .{tool = "sort", args = "empty"},
    .{tool = "sort", args = "nosuch", status = "open file", err = "sort: cannot open nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sort", args = "unsorted unsorted", status = "usage", err = "usage: sort [-n] [file]\n"},
    .{tool = "sort", args = "-x unsorted", status = "usage", err = "usage: sort [-n] [file]\n"},
];

failures: s32;

Expect :: (ok: bool, index: s64, what: string, got: string, want: string) {
    if ok { return }
    failures += 1
    print("FAIL case % (% %) %:\n  got  [%]\n  want [%]\n", index, cases[index].tool, cases[index].args, what, got, want)
}

Write :: (name: string, text: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/work/%", WORK, name)
    return WriteEntireFile(BuilderFinish(path), text)
}

Directory :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", WORK, name)
    return CreateDirectory(BuilderFinish(path))
}

// The bytes 0 through 255, forty times: crosses the 8 KiB transfer size.
Binary :: () -> Text {
    bytes: Vec(u8)
    for 1..40 { for 0..255 { VecPush(bytes, cast(u8)it) } }
    return BuilderFinish(bytes)
}

// ab NUL abcdef NUL 12345 NUL xy NUL: one run of six printable bytes.
S1 :: () -> string {
    data: Vec(u8)
    for "ab" { VecPush(data, it) }
    VecPush(data, 0)
    for "abcdef" { VecPush(data, it) }
    VecPush(data, 0)
    for "12345" { VecPush(data, it) }
    VecPush(data, 0)
    for "xy" { VecPush(data, it) }
    VecPush(data, 0)
    return BuilderFinish(data)
}

// q and a hundred letters, then six z's: the long run splits every 70 bytes.
S2 :: () -> string {
    data: Vec(u8)
    VecPush(data, #char "q")
    for 1..100 { VecPush(data, #char "a") }
    VecPush(data, 0)
    for "zzzzzz" { VecPush(data, it) }
    VecPush(data, 0)
    return BuilderFinish(data)
}

// A begin line and fifty encoded characters: longer than the count permits.
TOOLONG :: () -> string {
    data: Vec(u8)
    for "begin 644 n\n" { VecPush(data, it) }
    for 1..50 { VecPush(data, #char "A") }
    for "\n`\nend\n" { VecPush(data, it) }
    return BuilderFinish(data)
}

// Fifty numbered lines: two full pages of twenty-two and a part page.
Lines :: () -> string {
    data: Vec(u8)
    for 1..50 { BuilderPrint(*data, "line %\n", it) }
    return BuilderFinish(data)
}

Prepare :: (binary: string) -> bool {
    unused RemoveTree(WORK)
    unused CreateDirectory("build")
    unused CreateDirectory("build/tests")
    if !CreateDirectory(WORK) || !Directory("work") || !Directory("result") ||
        !Directory("work/tree") || !Directory("work/tree/sub") || !Directory("work/fakeprog") ||
        !Directory("work/fakeprog/1") || !Directory("work/fakeprog/2") ||
        !Directory("work/fakeprog/3") || !Directory("work/fakeprog/4") || !Directory("work/fakenet") ||
        !Directory("work/fakenet/1") || !Directory("work/fakenet/2") { return false }
    one := S1()
    two := S2()
    // ps prints only the first 128 bytes of a status file.
    long: Vec(u8)
    for 1..130 { VecPush(long, #char "y") }
    if !Directory("work/d4") || !Directory("work/d7") || !Directory("work/d7/c") || !Directory("work/d8") ||
        !Directory("work/d9") || !Directory("work/dempty") || !Directory("work/dd") { return false }
    return Write("a.txt", ALPHA) && Write("words", WORDS) && Write("empty", "") && Write("bin", binary) &&
        Write("-dash", "dash\n") && Write("café blanc", "c\n") && Write("tree/x", "x\n") && Write("tree/sub/y", "yy\n") &&
        Write("s1", one) && Write("s2", two) && Write("short", "short\n") &&
        Write("lines.txt", Lines()) &&
        Write("unsorted", UNSORTED) &&
        Write("fakeprog/1/status", "proc1 one") && Write("fakeprog/2/status", "proc2 two") &&
        Write("fakeprog/3/status", "proc3") && Write("fakeprog/4/status", BuilderFinish(long)) &&
        Write("fakenet/1/status", "listen 0 0\n") && Write("fakenet/1/local", "tcp!1.2.3.4!80\n") &&
        Write("fakenet/1/remote", "tcp!5.6.7.8!1234\n") && Write("fakenet/2/status", "Established x\n") &&
        Write("q.txt", QUICK) && Write("q2", "q\n") && Write("hello", "hello") &&
        Write("d4/x", "a\n") && Write("d7/a", "a\n") && Write("d7/b", "b\n") && Write("d7/c/z", "c\n") &&
        Write("d8/x", "x\n") && Write("d9/x", "x\n") && Write("dd/name", "n\n") &&
        Write("six.uu", "begin 644 name\n#0V%T\n`\nend\n") &&
        Write("bad0.uu", "begin 644 n\n#0V%T\n`x\nend\n") &&
        Write("badend.uu", "begin 644 n\n#0V%T\n") && Write("noend.uu", "begin 644 n\n#0V%T\n`\n") &&
        Write("toolong.uu", TOOLONG()) && Write("shortline.uu", "begin 644 n\n#0V%\n`\nend\n") &&
        Write("toomany.uu", "begin 644 n\nN\n`\nend\n") && Write("badbegin.uu", "begin 644\n#0V%T\n`\nend\n") &&
        Write("junk.uu", "x\ny\nbegin 644 n\n#0V%T\n`\nend\n") &&
        Write("tilde.uu", "begin 644 ~u/f\n#0V%T\n`\nend\n") && Write("nobegin.uu", "hello\n") &&
        Write("fakenet/2/local", "udp!0.0.0.0!53\n") && Write("fakenet/2/remote", "udp!9.9.9.9!53\n")
}

// One guest shell script runs every case and keeps each result in a file.
Script :: () -> Text {
    script: Vec(u8)
    BuilderPrint(*script, "cd /%/work\n", WORK)
    for cases {
        if it.tool == "" {
            BuilderPrint(*script, "{%}", it.args)
        } else {
            BuilderPrint(*script, "% %", it.tool, it.args)
        }
        input := ifx it.input == "" then "/dev/null" else it.input
        BuilderPrint(*script, " < % > ../result/out.% >[2] ../result/err.%\n", input, it_index, it_index)
        BuilderPrint(*script, "echo $status > ../result/status.%\n", it_index)
    }
    return BuilderFinish(script)
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index)
    text, ok := ReadEntireFile(BuilderFinish(path))
    return ifx ok then text else "<missing>"
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else (ifx PathExists("emu/Linux/o.emu") then "emu/Linux/o.emu" else "Linux/386/bin/emu")
    binary: Text = Binary()
    if !Prepare(TextView(binary)) { print("cannot prepare %\n", WORK); return 1 }
    script: Text = Script()
    if !WriteEntireFile("build/tests/commands-m-z/script", TextView(script)) { return 1 }
    root: Text = WorkingDirectory()
    guest: Vec(u8)
    BuilderPrint(*guest, "%/script", WORK)
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)]
    run: ProcessRun
    started := RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run)
    if !started { print("cannot start %\n", emu); return 1 }
    for cases {
        status_line: Vec(u8)
        BuilderPrint(*status_line, "%\n", it.status)
        status := BuilderFinish(status_line)
        got_status := Result("status", it_index)
        Expect(got_status == status, it_index, "status", got_status, status)
        out := Result("out", it_index)
        want := ifx it.binary_out then TextView(binary) else it.out
        Expect(out == want, it_index, "stdout", out, want)
        err := Result("err", it_index)
        Expect(err == it.err, it_index, "stderr", err, it.err)
    }
    if failures != 0 { print("commands-m-z: % failures in % cases\n", failures, cases.count); return 1 }
    print("commands-m-z: all % cases match the Limbo originals\n", cases.count)
    return 0
}
