// Guest regression for the top-level shell commands M to Z rewritten in Ziran.
// Every expected status, output and diagnostic below is what the Limbo
// original printed when it was replaced. Each case runs through the guest
// shell, which starts /dis/NAME.zx.
//
// From the TaijiOS root, after "(cd appl/cmd && mk install)":
//     ziran run --target=c --root tests/commands tests/commands/m_z_test.zi -- [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"

Case :: struct {
    tool: string // empty: args is a whole shell command
    args: string
    input: string // fixture used as standard input; empty reads /dev/null
    status: string
    out: string
    err: string
    binary_out: bool // standard output must equal the binary fixture
}

WORK :: "build/tests/commands-m-z";

ALPHA :: "alpha\nbeta\nbeta\ncafé κ\n";
WORDS :: "one two  three\nfour\tfive\n";

cases: [64]Case = Case.[
    .{tool = "pwd", out = "/build/tests/commands-m-z/work\n"},
    .{tool = "pwd", args = "ignored arguments", out = "/build/tests/commands-m-z/work\n"},
    .{tool = "pwd", args = "-x", out = "/build/tests/commands-m-z/work\n"},
    // tokenize: split at any delimiter, none quoted, leading and repeats skipped.
    .{tool = "tokenize", args = "'a b  c' ' '", out = "a\nb\nc\n"},
    .{tool = "tokenize", args = "'a,b,,c' ','", out = "a\nb\nc\n"},
    .{tool = "tokenize", args = "'  lead and trail  ' ' '", out = "lead\nand\ntrail\n"},
    .{tool = "tokenize", args = "'a b' ' ,'", out = "a\nb\n"},
    .{tool = "tokenize", args = "'a\"b c\"d e' ' '", out = "a\"b\nc\"d\ne\n"},
    .{tool = "tokenize", args = "one", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", args = "a b c", status = "usage", err = "Usage: tokenize string delimiters\n"},
    .{tool = "tokenize", args = "'' ' '", out = ""},
    .{tool = "tokenize", args = "'a\tb' ' '", out = "a\tb\n"},
    .{tool = "tokenize", args = "'ab' 'b'", out = "a\n"},
    .{tool = "tokenize", args = "'café κλά' ' '", out = "café\nκλά\n"},
    .{tool = "tokenize", args = "'aébc' 'é'", out = "a\nbc\n"},
    .{tool = "tokenize", args = "'aéb c' ' '", out = "aéb\nc\n"},
    // newer: status only, nothing on standard error except usage.
    .{tool = "newer", args = "gone1 gone2", status = "new:'gone1' file does not exist"},
    .{tool = "newer", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "gone1", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "gone1 gone2 gone3", status = "usage", err = "usage: newer newfile oldfile\n"},
    .{tool = "newer", args = "a.txt gone2", status = "old:'gone2' file does not exist"},
    .{tool = "newer", args = "a.txt tree", status = "old:directory"},
    .{tool = "newer", args = "tree a.txt", status = "new:directory"},
    .{tool = "newer", args = "a.txt words"},
    .{args = "sleep 1; echo x > late; /dis/newer.zx a.txt late", status = "older"},
    .{tool = "newer", args = "-dash -dash"},
    // read: one read of count bytes after an optional seek.
    .{tool = "read", args = "5", input = "a.txt", out = "alpha"},
    .{tool = "read", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "0", input = "a.txt"},
    .{tool = "read", args = "3", input = "empty", status = "eof"},
    .{tool = "read", args = "abc", input = "a.txt"},
    .{tool = "read", args = "0x5", input = "a.txt"},
    .{tool = "read", args = "5abc", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-o 2 3", input = "a.txt", out = "pha"},
    .{tool = "read", args = "-e 2 3", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-r 1 3", input = "a.txt", out = "lph"},
    .{tool = "read", args = "-o 2", input = "a.txt", out = "pha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "-x 2 3", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-o", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "1 2", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-o 1 2 3", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "-5", input = "a.txt", status = "usage", err = "usage: read [-[ero] offset] count\n"},
    .{tool = "read", args = "''", input = "a.txt"},
    .{tool = "read", args = "' 5'", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-o -1 3", input = "a.txt", out = "alp"},
    .{tool = "read", args = "-o x 3", input = "a.txt", out = "alp"},
    .{tool = "read", args = "100000", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "-o 100 5", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-e 0 5", input = "a.txt", status = "eof"},
    .{tool = "read", args = "-r -2 5", input = "a.txt", out = "alpha"},
    .{tool = "read", args = "-e -10 3", input = "a.txt", out = "\nca"},
    .{tool = "read", args = "-o 24 3", input = "a.txt", out = "\n"},
    .{tool = "read", args = "26", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "read", args = "5", input = "words", out = "one t"},
    .{tool = "read", args = "2", input = "empty", status = "eof"},
    // sum: crc, six-wide size, name; directories skipped, failures reported.
    .{tool = "sum", args = "a.txt", out = "78465aa6     25 a.txt\n"},
    .{tool = "sum", args = "nosuch", status = "error", err = "sum: cannot get status of nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sum", args = "."},
    .{tool = "sum"},
    .{tool = "sum", args = "nosuch . a.txt", status = "error", out = "78465aa6     25 a.txt\n", err = "sum: cannot get status of nosuch: 'nosuch' file does not exist\n"},
    .{tool = "sum", args = "empty words bin", out = "2aa280dc      0 empty\n652bf7c4     25 words\n16ad4d37  10240 bin\n"},
    .{tool = "sum", args = "-", status = "error", err = "sum: cannot get status of -: '-' file does not exist\n"},
    .{tool = "sum", args = "a.txt a.txt", out = "78465aa6     25 a.txt\n78465aa6     25 a.txt\n"},
];

failures: s32;

Expect :: (ok: bool, index: s64, what: string, got: string, want: string) {
    if ok { return }
    failures += 1
    print("FAIL case % (% %) %:\n  got  [%]\n  want [%]\n", index, cases[index].tool, cases[index].args, what, got, want)
}

Write :: (name: string, text: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/work/%", WORK, name)
    return WriteEntireFile(BuilderFinish(path), text)
}

Directory :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", WORK, name)
    return CreateDirectory(BuilderFinish(path))
}

// The bytes 0 through 255, forty times: crosses the 8 KiB transfer size.
Binary :: () -> Text {
    bytes: Vec(u8)
    for 1..40 { for 0..255 { VecPush(bytes, cast(u8)it) } }
    return BuilderFinish(bytes)
}

Prepare :: (binary: string) -> bool {
    unused RemoveTree(WORK)
    unused CreateDirectory("build")
    unused CreateDirectory("build/tests")
    if !CreateDirectory(WORK) || !Directory("work") || !Directory("result") ||
        !Directory("work/tree") || !Directory("work/tree/sub") { return false }
    return Write("a.txt", ALPHA) && Write("words", WORDS) && Write("empty", "") && Write("bin", binary) &&
        Write("-dash", "dash\n") && Write("café blanc", "c\n") && Write("tree/x", "x\n") && Write("tree/sub/y", "yy\n")
}

// One guest shell script runs every case and keeps each result in a file.
Script :: () -> Text {
    script: Vec(u8)
    BuilderPrint(*script, "cd /%/work\n", WORK)
    for cases {
        if it.tool == "" {
            BuilderPrint(*script, "{%}", it.args)
        } else {
            BuilderPrint(*script, "% %", it.tool, it.args)
        }
        input := ifx it.input == "" then "/dev/null" else it.input
        BuilderPrint(*script, " < % > ../result/out.% >[2] ../result/err.%\n", input, it_index, it_index)
        BuilderPrint(*script, "echo $status > ../result/status.%\n", it_index)
    }
    return BuilderFinish(script)
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index)
    text, ok := ReadEntireFile(BuilderFinish(path))
    return ifx ok then text else "<missing>"
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else "Linux/386/bin/emu"
    binary: Text = Binary()
    if !Prepare(TextView(binary)) { print("cannot prepare %\n", WORK); return 1 }
    script: Text = Script()
    if !WriteEntireFile("build/tests/commands-m-z/script", TextView(script)) { return 1 }
    root: Text = WorkingDirectory()
    guest: Vec(u8)
    BuilderPrint(*guest, "%/script", WORK)
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)]
    run: ProcessRun
    started := RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run)
    if !started { print("cannot start %\n", emu); return 1 }
    for cases {
        status_line: Vec(u8)
        BuilderPrint(*status_line, "%\n", it.status)
        status := BuilderFinish(status_line)
        got_status := Result("status", it_index)
        Expect(got_status == status, it_index, "status", got_status, status)
        out := Result("out", it_index)
        want := ifx it.binary_out then TextView(binary) else it.out
        Expect(out == want, it_index, "stdout", out, want)
        err := Result("err", it_index)
        Expect(err == it.err, it_index, "stderr", err, it.err)
    }
    if failures != 0 { print("commands-m-z: % failures in % cases\n", failures, cases.count); return 1 }
    print("commands-m-z: all % cases match the Limbo originals\n", cases.count)
    return 0
}
