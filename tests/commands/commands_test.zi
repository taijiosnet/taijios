// Guest regression for the shell commands rewritten in Ziran: cat, echo,
// basename, cleanname, wc, uniq, tr, tee, cp, test, ls, mkdir, tclsh,
// ndb/csquery, ndb/dnsquery, ndb/mkhash, ndb/query, ndb/regquery,
// auxi/digest, export, mntgen, auth/aescbc, auth/rsagen, auth/dsagen,
// auth/getpk, auth/ai2key, auth/verify, auth/countersigner and
// auth/createsignerkey.
// Every expected status, output and diagnostic below is what the Limbo
// originals printed when they were replaced. Each case runs through the
// guest shell, which starts /dis/NAME.zx. The Limbo tclsh printed its
// prompts from a second thread, so they raced its results; here they are in
// the order the commands were read.
//
// From the TaijiOS root, after `(cd appl/cmd && mk install)`:
//     ziran run --target=c --root tests/commands tests/commands/commands_test.zi -- [EMU]
// EMU defaults to the emulator built from this tree, emu/Linux/o.emu, and
// to Linux/386/bin/emu when that has not been built.
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"

Case :: struct {
    tool: string // empty: args is a whole shell command
    args: string
    input: string // fixture used as standard input; empty reads /dev/null
    status: string
    out: string
    err: string
    binary_out: bool // standard output must equal the binary fixture
}

WORK :: "build/tests/commands";

ALPHA :: "alpha\nbeta\nbeta\ncafé κ\n";
WORDS :: "one two  three\nfour\tfive\n";
SQUEEZE :: "abczz\naabb\n";
TCL_FILE :: "puts file-one\nset y 7\nnoSuch arg\nputs after-error\n";
REGISTRY :: "service=tcp!alpha.example!1\n\tname=alpha owner='a b' kind=x\nservice=tcp!beta.example!2\n\tname=beta kind=y\nservice=tcp!gamma.example!3\n\tname=gamma kind=x\n";
NDB_MAIN :: "database=\n\tfile=/build/tests/commands/work/ndb.main\n\tfile=/build/tests/commands/work/ndb.second\n\tfile=/build/tests/commands/work/ndb.missing\n\n# a comment line\nsys=alpha ip=10.0.0.1 ether=0011aa\n\tdom=alpha.example\n\tip=10.0.0.9   # second address\nsys=beta ip=10.0.0.2\n\tnote='it''s quoted' empty= bare\n\tdom=\"double q\"\nipnet=lan ip=10.0.0.0 ipmask=255.255.255.0\n\tdns=10.0.0.53 dns=10.0.0.54\n\tauth=alpha\nbad='unclosed\n\tsys=gamma\n";
NDB_SECOND :: "sys=delta ip=10.1.0.1\n\tdom=delta.example\nsys=alpha ip=10.1.0.2\n";
// A file the Limbo auth/aescbc encrypted with the key "secret", and one in
// the older secstore form it also read, both in hexadecimal.
AES_CLEAR :: "4145532043424320534841312020320ad8836a7e1866ac41668a7252c41e3daa12b70f8ccc6ec4acf12b469698c8c935d0445abbe5457bd0f252a7926515863a4d7a5326297019619f6e9f579a313c5bf95d7a6d8d553c92ab7b238c6c1c8b72fef8";
AES_OLD :: "30313233343536373839616263646566a1013d70569efef1a8384a987afbf4365c42261d0e637edf0ba4795123af7eba09a65cd4116bafe9cbe0a2fc0163f2a1c9b86789263996a8";
// Authinfo files the Limbo auth/createsignerkey wrote, in hexadecimal:
// rsa and elgamal keys, one that expires in 2030, one whose expiry was set
// in the past by hand, and two that are not authinfo files.
AUTHINFO_DEFAULT :: "";
AUTHINFO_TCP_ALPHA_EXAMPLE_INFSIGNER :: "";
AUTHINFO_BETA_EXAMPLE :: "";
AUTHINFO_OLD :: "";
AUTHINFO_GARBAGE :: "676172626167650a";
AUTHINFO_SHORT :: "303030340a7273610a";
TCL_LINES :: "set x 5\nputs hi\nproc p {} {\nreturn 3\n}\np\nexpr {1+\n2}\nnoSuchCmd\nputs \"a\nb\"\nset y\nexit\n";


cases: [198]Case = Case.[
    .{tool = "cat", args = "a.txt empty - a.txt", input = "words", out = "alpha\nbeta\nbeta\ncafé κ\none two  three\nfour\tfive\nalpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "cat", input = "bin", binary_out = true},
    .{tool = "cat", args = "missing a.txt", status = "bad open", err = "cat: cannot open missing: 'missing' file does not exist\n"},
    .{tool = "echo", args = "-n 'café' '' x", out = "café  x"},
    .{tool = "echo", args = "-- -n hé", out = "-n hé\n"},
    .{tool = "echo", out = "\n"},
    .{tool = "basename", args = "/a/b.tar .tar", out = "b\n"},
    .{tool = "basename", args = "-d /a/b/c", out = "/a/b\n"},
    .{tool = "basename", args = "foo foo", out = "\n"},
    .{tool = "basename", args = "-d x extra", status = "usage", err = "usage: basename [-d] string [suffix]\n"},
    .{tool = "cleanname", args = "-d/pwd a/../b / '#é/ref/..' '../x' '' /../../ '#/' '#/a/..'", out = "/pwd/b\n/\n#é\n/x\n.\n/\n#/\n#/a\n"},
    .{tool = "cleanname", args = "a/../../b //a///b/.././ '#x/user/../../..' '#é/../a' '#/../x'", out = "../b\n/a\n#x\n#é/a\n#/../x\n"},
    .{tool = "cleanname", args = "-d", status = "usage", err = "usage: cleanname [-d pwd] name ...\n"},
    .{tool = "wc", args = "a.txt words", out = "      4       5      23 a.txt\n      2       5      25 words\n      6      10      48 total\n"},
    .{tool = "wc", args = "-lwc", input = "bin", out = "     40      81   10240\n"},
    .{tool = "wc", args = "-q", input = "a.txt", status = "usage", err = "usage: wc [-lwcbe] [file ...]\n"},
    .{tool = "wc", args = "missing words", out = "      2       5      25 words\n      2       5      25 total\n", err = "wc: can't open missing: 'missing' file does not exist\n"},
    .{tool = "uniq", input = "a.txt", out = "alpha\nbeta\ncafé κ\n"},
    .{tool = "uniq", args = "-c", input = "a.txt", out = "1\talpha\n2\tbeta\n1\tcafé κ\n"},
    .{tool = "uniq", args = "-d a.txt", out = "beta\n"},
    .{tool = "uniq", args = "-u", input = "a.txt", out = "alpha\ncafé κ\n"},
    .{tool = "uniq", args = "-q", status = "usage", err = "usage: uniq [-udc] [file]\n"},
    .{tool = "tr", args = "a-z A-Z", input = "a.txt", out = "ALPHA\nBETA\nBETA\nCAFé κ\n"},
    .{tool = "tr", args = "-d ab", input = "a.txt", out = "lph\net\net\ncfé κ\n"},
    .{tool = "tr", args = "-s a-c z", input = "squeeze", out = "z\nz\n"},
    .{tool = "tr", args = "-c abc d", input = "squeeze", out = "abcdddaabbd"},
    .{tool = "tr", args = "'κ' 'k'", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé k\n"},
    .{tool = "tee", args = "t1 t2", input = "a.txt", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "cat", args = "t1 t2", out = "alpha\nbeta\nbeta\ncafé κ\nalpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "tee", args = "-a t1", input = "words", out = "one two  three\nfour\tfive\n"},
    .{tool = "cat", args = "t1", out = "alpha\nbeta\nbeta\ncafé κ\none two  three\nfour\tfive\n"},
    .{tool = "tee", args = "nodir/x", input = "words", status = "error", err = "tee: cannot open nodir/x: 'nodir' file does not exist\n"},
    .{tool = "cp", args = "a.txt c1"},
    .{tool = "cat", args = "c1", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{tool = "cp", args = "-r tree t3"},
    .{tool = "ls", args = "t3 t3/sub", out = "t3/sub\nt3/x\nt3/sub/y\n"},
    .{tool = "cat", args = "t3/x t3/sub/y", out = "x\nyy\n"},
    .{tool = "cp", args = "a.txt a.txt", status = "error", err = "cp: a.txt and a.txt are the same file\n"},
    .{tool = "cp", args = "missing x", status = "error", err = "cp: missing: 'missing' file does not exist\n"},
    .{tool = "cp", args = "a.txt empty nowhere", status = "error", err = "cp: nowhere  not a directory\n"},
    .{tool = "cp", args = "-q", status = "usage", err = "usage: \tcp [-gux] src target\n\tcp [-r] [-gux] src ... directory\n"},
    .{tool = "test", args = "-f a.txt"},
    .{tool = "test", args = "-d tree"},
    .{tool = "test", args = "-e missing", status = "false"},
    .{tool = "test", args = "010 -eq 10"},
    .{tool = "test", args = "1 -lt -1", status = "bad syntax", err = "test: bad syntax: unknown operator -lt\n"},
    .{tool = "test", args = "'café' '=' 'café'"},
    .{tool = "test", args = "-n ''", status = "false"},
    .{tool = "test", status = "usage", err = ""},
    .{tool = "test", args = "-s empty", status = "false"},
    .{tool = "test", args = "'(' -f a.txt -a ! -d a.txt ')'"},
    .{tool = "ls", args = "tree", out = "tree/sub\ntree/x\n"},
    .{tool = "ls", args = "-p tree", out = "sub\nx\n"},
    .{tool = "ls", args = "-d tree", out = "tree\n"},
    .{tool = "ls", args = "-s a.txt bin", out = "a.txt\nbin\n"},
    .{tool = "ls", args = "-r tree", out = "tree/x\ntree/sub\n"},
    .{tool = "ls", args = "-F tree", out = "tree/sub/\ntree/x\n"},
    .{tool = "ls", args = "-p -- -dash 'café blanc'", out = "-dash\ncafé blanc\n"},
    .{tool = "ls", args = "missing a.txt", status = "errors", out = "a.txt\n", err = "ls: missing: 'missing' file does not exist\n"},
    .{tool = "ls", args = "-Z", status = "usage", err = "usage: ls [-delmnpqrstucFT] [files]\n"},
    .{tool = "mkdir", args = "m1 'café dir'"},
    .{tool = "ls", args = "-d m1 'café dir'", out = "café dir\nm1\n"},
    .{tool = "mkdir", args = "-p m2/a/b"},
    .{tool = "test", args = "-d m2/a/b"},
    .{tool = "mkdir", args = "a.txt", status = "error", err = "mkdir: a.txt already exists\n"},
    .{tool = "mkdir", args = "missing/x", status = "error", err = "mkdir: can't create missing/x: 'missing' file does not exist\n"},
    .{args = "whatis cat echo basename cleanname wc uniq tr tee cp test ls mkdir sh", out = "/dis/cat.zx\n/dis/echo.zx\n/dis/basename.zx\n/dis/cleanname.zx\n/dis/wc.zx\n/dis/uniq.zx\n/dis/tr.zx\n/dis/tee.zx\n/dis/cp.zx\n/dis/test.zx\n/dis/ls.zx\n/dis/mkdir.zx\n/dis/sh.dis\n"},
    .{tool = "tclsh", input = "lines.tcl", out = "tcl% 5\ntcl% hi\ntcl% tcl> tcl> tcl% 3\ntcl% tcl> 3\ntcl% In function noSuchCmd.....\n\tinvalid command name \"noSuchCmd\"\ntcl% tcl> a\nb\ntcl% In function set y.....\n\tcan't read \"y\": no such variable\ntcl% "},
    // A file stops at its first error without a report; its variables stay set.
    .{tool = "tclsh", args = "file.tcl missing.tcl two.tcl", input = "lines.tcl", out = "file-one\nfile-two\ntcl% 5\ntcl% hi\ntcl% tcl> tcl> tcl% 3\ntcl% tcl> 3\ntcl% In function noSuchCmd.....\n\tinvalid command name \"noSuchCmd\"\ntcl% tcl> a\nb\ntcl% 7\ntcl% "},
    .{tool = "tclsh", args = "missing.tcl", out = "tcl% "},
    .{args = "ndb/cs; ndb/csquery 'tcp!127.0.0.1!80' 'bogus!x'", out = "/net/tcp/clone 127.0.0.1!80\nbogus!x: network unavailable bogus\n"},
    .{args = "echo 'tcp!127.0.0.1!7' | ndb/csquery", out = "> /net/tcp/clone 127.0.0.1!7\n> "},
    // The emulator cannot exit while the connection server runs.
    .{args = "kill Cs > /dev/null"},
    .{tool = "ndb/csquery", args = "-s /nonexist x", status = "open", err = "csquery: can't open /nonexist: '/nonexist' file does not exist\n"},
    .{tool = "ndb/csquery", args = "-q", status = "usage", err = "usage: csquery [-x /net] [-s server] [address ...]\n"},
    // A plain file as the DNS server reads back the request dnsquery wrote.
    .{args = "echo -n > dnsf; ndb/dnsquery -s dnsf www.example.com", out = "www.example.com ip\n"},
    .{args = "echo -n > dnsf; ndb/dnsquery -s dnsf '1.2.3.4   ptr'", out = "4.3.2.1.in-addr.arpa ptr\n"},
    .{args = "echo -n > dnsf; ndb/dnsquery -s dnsf 4.3.2.1.in-addr.arpa", out = "4.3.2.1.in-addr.arpa ip\n"},
    .{args = "echo -n > dnsf; ndb/dnsquery -s dnsf 1:2:3:4 cafe.babe", out = "1:2:3:4.in-addr.arpa ptr\ncafe.babe ipddr.arpa ptr\n"},
    .{args = "echo -n > dnsf; ndb/dnsquery -s dnsf '10..1.'", out = "1.10.in-addr.arpa ptr\n"},
    .{args = "echo -n > dnsf; echo example.org | ndb/dnsquery -s dnsf", out = "> example.org ip\n> "},
    .{tool = "ndb/dnsquery", args = "-x /nonexist x", status = "open", err = "dnsquery: can't open /nonexist/dns: '/nonexist' file does not exist\n"},
    .{tool = "ndb/dnsquery", args = "-s", status = "usage", err = "usage: dnsquery [-x /net] [-s server] [address ...]\n"},
    .{tool = "ndb/query", args = "-f /build/tests/commands/work/ndb.main sys alpha", out = "sys=alpha ip=10.0.0.1 ether=0011aa dom=alpha.example ip=10.0.0.9\n"},
    .{tool = "ndb/query", args = "-a -f /build/tests/commands/work/ndb.main sys alpha", out = "sys=alpha ip=10.0.0.1 ether=0011aa dom=alpha.example ip=10.0.0.9\nsys=alpha ip=10.1.0.2\n"},
    .{tool = "ndb/query", args = "-f /build/tests/commands/work/ndb.main sys beta note", out = "'it''s quoted'\n"},
    .{tool = "ndb/query", args = "-f /build/tests/commands/work/ndb.main sys beta empty", out = "bare\n"},
    .{tool = "ndb/query", args = "-a -f /build/tests/commands/work/ndb.main ipnet lan dns", out = "10.0.0.53\n10.0.0.54\n"},
    .{tool = "ndb/query", args = "-a -f /build/tests/commands/work/ndb.main sys alpha ip", out = "10.0.0.1\n10.0.0.9\n10.1.0.2\n"},
    .{tool = "ndb/query", args = "-f /build/tests/commands/work/ndb.main dom 'double q'", out = "sys=beta ip=10.0.0.2 note='it''s quoted' empty=bare dom='double q'\n"},
    .{tool = "ndb/query", args = "-f /build/tests/commands/work/ndb.main sys gamma", out = "sys=gamma\n"},
    .{tool = "ndb/query", args = "-af /build/tests/commands/work/ndb.main database", out = "database='' file=/build/tests/commands/work/ndb.main file=/build/tests/commands/work/ndb.second file=/build/tests/commands/work/ndb.missing\n"},
    .{tool = "ndb/query", args = "-f /nonexist sys", status = "error", err = "query: can't open /nonexist: '/nonexist' file does not exist\n"},
    .{tool = "ndb/query", status = "usage", err = "usage: query [-a] [-f dbfile] attr [value [rattr]]\n"},
    .{args = "ndb/mkhash ndb.second sys; wc -c ndb.second.sys", out = "     23 ndb.second.sys\n"},
    .{tool = "ndb/mkhash", args = "/nonexist sys", status = "error", err = "mkhash: can't open /nonexist: '/nonexist' file does not exist\n"},
    .{tool = "ndb/mkhash", args = "ndb.second", status = "error", err = "mkhash: usage: mkhash file attr\n"},
    // The digest shipped in lib/strokes was written by the Limbo digest.
    .{args = "auxi/digest digits.cl; cmp digits.clx /lib/strokes/digits.clx"},
    .{tool = "auxi/digest", args = "missing.cl", status = "error", err = "digest: error reading classifier from missing.cl: 'missing.cl' file does not exist\n"},
    .{tool = "auxi/digest", args = "-x", status = "usage", err = "Usage: digest [file.cl ...]\n"},
    .{args = "mount -c {ndb/registry -f reg.db} mnt"},
    .{tool = "ndb/regquery", args = "-m mnt name alpha", out = "tcp!alpha.example!1 kind x owner 'a b' name alpha\n"},
    .{tool = "ndb/regquery", args = "-m mnt -n kind x", out = "tcp!alpha.example!1\ntcp!gamma.example!3\n"},
    .{tool = "ndb/regquery", args = "-mmnt owner 'a b'", out = "tcp!alpha.example!1 kind x owner 'a b' name alpha\n"},
    .{args = "echo 'kind y' | ndb/regquery -m mnt -n", out = "> tcp!beta.example!2\n> "},
    // The registry is unmounted so that the emulator can exit.
    .{tool = "unmount", args = "mnt"},
    .{tool = "ndb/regquery", args = "-m /nonexist a b", status = "open", err = "regquery: can't open /nonexist/find: '/nonexist' file does not exist\n"},
    // export serves a tree to the mount on its standard input. With -a it
    // returns at once; without it, it runs until killed, as the Limbo
    // export did: the emulator cannot exit while it runs.
    .{args = "mount -c {export -a tree} mnt; ls mnt; cat mnt/x mnt/sub/y; unmount mnt", out = "mnt/sub\nmnt/x\nx\nyy\n"},
    .{args = "mount -c {export tree} mnt >[2] /dev/null; echo served > mnt/exported; unmount mnt; kill Zxrun Export > /dev/null >[2] /dev/null; cat tree/exported; rm tree/exported", out = "served\n"},
    .{tool = "export", status = "usage", err = "Usage: export [-a] dir [connection]\n"},
    .{tool = "export", args = "-x tree", status = "usage", err = "Usage: export [-a] dir [connection]\n"},
    .{tool = "export", args = "a b c", status = "usage", err = "Usage: export [-a] dir [connection]\n"},
    .{tool = "export", args = "tree /nonexist/file", status = "open", err = "export: can't open /nonexist/file: '/nonexist' file does not exist\n"},
    .{tool = "export", args = "/nonexist/dir", status = "export", err = "export: can't export: inappropriate use of fd\n"},
    // mntgen makes a directory for each name walked to, kept while it is
    // used. A refused remove keeps its name. It runs until killed.
    .{args = "mount {mntgen} mnt >[2] /dev/null; ls -ld mnt | sed 's/ M [0-9]+ / M n /'; ls mnt/foo; ls mnt; bind tree mnt/foo; ls mnt; ls mnt/foo; bind tree mnt/bar; ls mnt; unmount mnt/foo; ls mnt; unmount mnt/bar; ls mnt; unmount mnt; kill Mntgen Nametree Styx Styxservers Zxrun > /dev/null >[2] /dev/null; echo end",
        out = "d-r-xr-xr-x M n me me 0 Jan 01  1970 .\nmnt/foo\nmnt/foo/sub\nmnt/foo/x\nmnt/bar\nmnt/foo\nmnt/bar\nend\n"},
    .{args = "mount {mntgen} mnt >[2] /dev/null; echo hi | tee mnt/y; mkdir mnt/z; rm mnt/q; ls mnt/a/b; cd mnt/k; pwd; cd ../..; ls mnt; unmount mnt; kill Mntgen Nametree Styx Styxservers Zxrun > /dev/null >[2] /dev/null; echo end",
        out = "/build/tests/commands/work/mnt/k\nmnt/q\nend\n",
        err = "tee: cannot open mnt/y: permission denied\nmkdir: mnt/z already exists\nrm: mnt/q: permission denied\nls: mnt/a/b: 'mnt/a/b' does not exist\n"},
    // auth/aescbc decrypts what the Limbo command encrypted, writes the text
    // before checking it, and reads its own output back.
    .{tool = "auth/aescbc", args = "-d -k secret", input = "clear.aes", out = "the clear text\nsecond line ü\n"},
    .{tool = "auth/aescbc", args = "-d -f aes.key", input = "clear.aes", out = "the clear text\nsecond line ü\n"},
    .{tool = "auth/aescbc", args = "-d -k secret", input = "old.aes", out = "old secstore data, not a block multiple\n"},
    .{args = "auth/aescbc -d -k wrong < clear.aes > /dev/null", status = "failed to authenticate", err = "aescbc: decrypted file failed to authenticate\n"},
    .{args = "auth/aescbc -d -k wrong < old.aes > /dev/null", status = "failed to authenticate", err = "aescbc: decrypted file failed to authenticate\n"},
    .{args = "auth/aescbc -e -k k2 < a.txt > a.aes; auth/aescbc -d -k k2 < a.aes", out = "alpha\nbeta\nbeta\ncafé κ\n"},
    .{args = "auth/aescbc -e -f aes.key < bin > bin.aes; auth/aescbc -d -k secret < bin.aes", binary_out = true},
    .{args = "auth/aescbc -e -k k < empty > empty.aes; ls -l empty.aes | sed 's/.* ([0-9]+) [A-Z][a-z][a-z] .*/\\1/'; auth/aescbc -d -k k < empty.aes", out = "68\n"},
    .{tool = "auth/aescbc", args = "-d -k secret", input = "a.txt", status = "read error", err = "aescbc: unexpectedly short read\n"},
    .{tool = "auth/aescbc", args = "-d -f blank.key", input = "clear.aes", status = "no key", err = "aescbc: no key\n"},
    .{tool = "auth/aescbc", args = "-d -f 'no file'", input = "clear.aes", status = "keyfile", err = "aescbc: can't open 'no file': 'no file' file does not exist\n"},
    .{tool = "auth/aescbc", args = "-k secret", status = "usage", err = "usage: auth/aescbc -d [-k key] [-f keyfile] <file.aes >clear.txt\n  or: auth/aescbc -e [-k key] [-f keyfile] <clear.txt >file.aes\n"},
    .{tool = "auth/aescbc", args = "-d -e -k x", status = "usage", err = "usage: auth/aescbc -d [-k key] [-f keyfile] <file.aes >clear.txt\n  or: auth/aescbc -e [-k key] [-f keyfile] <clear.txt >file.aes\n"},
    .{tool = "auth/aescbc", args = "-d -k x extra", status = "usage", err = "usage: auth/aescbc -d [-k key] [-f keyfile] <file.aes >clear.txt\n  or: auth/aescbc -e [-k key] [-f keyfile] <clear.txt >file.aes\n"},
    .{tool = "auth/aescbc", args = "-d -k", status = "usage", err = "usage: auth/aescbc -d [-k key] [-f keyfile] <file.aes >clear.txt\n  or: auth/aescbc -e [-k key] [-f keyfile] <clear.txt >file.aes\n"},
    .{tool = "auth/aescbc", args = "-x", status = "usage", err = "usage: auth/aescbc -d [-k key] [-f keyfile] <file.aes >clear.txt\n  or: auth/aescbc -e [-k key] [-f keyfile] <clear.txt >file.aes\n"},
    // auth/rsagen and auth/dsagen print new keys: their numbers are random,
    // so the cases check the fields, the size and the failures.
    .{args = "auth/rsagen -b 256 -t 'user=me service=x' | sed 's/=[0-9A-F]+/=H/g'", out = "key proto=rsa user=me service=x size=H ek=H n=H !dk=H !p=H !q=H !kp=H !kq=H !c2=H\n"},
    .{args = "auth/rsagen -b 320 | sed 's/.* size=([0-9]+) .*/\\1/'", out = "320\n"},
    .{tool = "auth/rsagen", args = "-b 0", status = "usage", err = "usage: auth/rsagen [-b bits] [-t 'attr=value attr=value ...']\n"},
    .{tool = "auth/rsagen", args = "-b x", status = "usage", err = "usage: auth/rsagen [-b bits] [-t 'attr=value attr=value ...']\n"},
    .{tool = "auth/rsagen", args = "-b 5000", status = "error", err = "rsagen: bits must be no greater than 4096\n"},
    .{tool = "auth/rsagen", args = "extra", status = "usage", err = "usage: auth/rsagen [-b bits] [-t 'attr=value attr=value ...']\n"},
    .{tool = "auth/rsagen", args = "-q", status = "usage", err = "usage: auth/rsagen [-b bits] [-t 'attr=value attr=value ...']\n"},
    .{args = "auth/dsagen -t 'a=b' | sed 's/=[0-9A-F]+/=H/g'", out = "key proto=dsa a=b p=H q=H alpha=H key=H !secret=H\n"},
    .{tool = "auth/dsagen", args = "x", status = "usage", err = "usage: auth/dsagen [-t 'attr=value attr=value ...']\n"},
    .{tool = "auth/dsagen", args = "-t", status = "usage", err = "usage: auth/dsagen [-t 'attr=value attr=value ...']\n"},
    // auth/getpk and auth/ai2key read authinfo files.
    .{args = "auth/getpk default", out = "a955cb77acd28e28cccb86d9d0e11dfe13b8d73f\n"},
    .{args = "auth/getpk -a default", out = "rsa\nsigner\nAML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=\nDQ==\n\n"},
    .{args = "auth/getpk -s 'tcp!alpha.example!infsigner'", out = "05f785e652385185bcda4f23ebb4e3ea10cb4010\n"},
    .{args = "auth/getpk -u default", out = "a955cb77acd28e28cccb86d9d0e11dfe13b8d73f signer\n"},
    .{args = "auth/getpk -asu beta.example", out = "rsa\nbeta\nANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz\nFw==\n beta\n"},
    .{args = "auth/getpk default beta.example missing garbage short", out = "default: a955cb77acd28e28cccb86d9d0e11dfe13b8d73f\nbeta.example: 68a0f3213f7836e84783fbd61886d57facfbd1ae\n", err = "getpk: cannot read missing: 'missing' file does not exist\ngetpk: cannot read garbage: garbage: input or format error\ngetpk: cannot read short: short: input or format error\n"},
    .{args = "auth/getpk", status = "usage", err = "usage: usage: getpk [-asu] file...\n"},
    .{args = "auth/getpk -x default", status = "usage", err = "usage: usage: getpk [-asu] file...\n"},
    .{args = "auth/ai2key default", out = "key proto=infauth dom=* server=* sigalg=rsa-sha1 user=signer signer=signer pk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== !sk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ==^AKT/PDoeE9vLeAfXnIdlaBlr1G/izpgAK34ahLK0YgjK4XQtgrZpCK4Qoe5cXHVET5+n2/gS8vwrxohuFEr+F2U=^AIVD/EHNMGQFUuA2mv7BMgmk1kwN691uKF5HltdJ735x^AXaVZtS3mxAUYexR5xbuTpVqeMK4sN7PDVioMNpV+izL^PYHW40sCpFE58VRHiUV5jkwUIxoeF23rPzS7xdNa1+U=^AQNTvVgwV6irpkElAnJWNmdxGIbOodVURFER+m/FXm3H^ATit+dUNDQuLZK8u6VIpo3WV3dsqvtklRlcONfug9xdl spk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== cert=rsa^sha1^signer^0^ALMkOINkQaJjgvQ+PcluCe+GYhLW9dE5yhWgZy73/s00X9VlIZBSGvs0yqo01HBacyRE+rYtjugN5iGMqbkUDuI= dh-alpha=9766EFB652FEDC03742CBF2E41AC2358BD613645 dh-p=DF6D828EF2C69C8B4A0FBFB58E52A34ED01CAC2BC0D236990342AA803B98159CFF1C10194B8132B69B8287B517F3ABC4B417808676EE9595E9BF75A2FF6162D2A12F0C742D9D80E2E64155ED89CE4304A0D23F10C77B41143638D79D3C01A14A117A8A855845283CB837959AB62617663F7C2BE5F21A763750C1041826A42B0F\n"},
    .{args = "auth/ai2key -t 'proto=x role=client' 'tcp!alpha.example!infsigner'", out = "key proto=infauth proto=x role=client dom=alpha.example server=alpha.example service=infsigner sigalg=elgamal-sha1 user='eg owner' signer='eg owner' pk=elgamal^eg owner^AJa06A7onJ9UJO0JH8oI6Bv7CAvksjKvQpTpbL0JgOOH^e8ZIcIG88rqvXt79ub0wzV2exB9r5SK6QtDc5xyTMRQ=^NMMZdgELfSQ5fR3tmRpny1WADWQ2EQ11YsQxKeS7cCk= !sk=elgamal^eg owner^AJa06A7onJ9UJO0JH8oI6Bv7CAvksjKvQpTpbL0JgOOH^e8ZIcIG88rqvXt79ub0wzV2exB9r5SK6QtDc5xyTMRQ=^NMMZdgELfSQ5fR3tmRpny1WADWQ2EQ11YsQxKeS7cCk=^XSfkfpCS6Bk7Q3aZRrsqNusaGqujfr5++wX5NNMgnuk= spk=elgamal^eg owner^AJa06A7onJ9UJO0JH8oI6Bv7CAvksjKvQpTpbL0JgOOH^e8ZIcIG88rqvXt79ub0wzV2exB9r5SK6QtDc5xyTMRQ=^NMMZdgELfSQ5fR3tmRpny1WADWQ2EQ11YsQxKeS7cCk= cert=elgamal^sha1^eg owner^0^c+qit0WMfZrwqh8Pb3w477r3AmfgbFaS8O/mm82Thfk=^AIW7bSCYZWq0FjZkmQyCUe4hN5RaEauD9cVq16noZFqb dh-alpha=E14AF0E7575ECC9B5FD9AF0C47A1F7AB8B70EE03 dh-p=D679E7D63B9A27C34CA183BFAB2904DACAE5A020597C2556AEE5A4323C62B545B3F5C18BFCD6772DEA0DB76495AD1C0ACB9A6719653B3FB9F71EFC817B5EF59728185F43080214ED3442C4F266A5DBE42A2DDDDAD86CB3427EDC335C9E4E257D1646FACEDB87602A9106AAD9BB9BBC97493257BA4BF36B710E9271DFE0D52011\n"},
    .{args = "auth/ai2key beta.example", out = "key proto=infauth dom=beta.example server=beta.example sigalg=rsa-sha1 user=beta signer=beta pk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw== !sk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw==^N52AawAI2pAymrd4o3oTeNtuFTJTVjg1yILPPKA7D+c=^AIUEo4T/UdlLyM3pCwAb9sM=^AZpMVAxf+FK+yXIoV/E2FdE=^beJw0gqRhvvSZ1E1m+qUMQ==^AOfoXAb+l3yunmHqR/ekIpc=^AROF/x4soDz2cn8Lnoyq4Kw= spk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw== cert=rsa^sha1^beta^1893545999^AIPqUy2HlCaYlpC8XohuYFE49lIJhP9RSXq+eadZp+eG dh-alpha=EADA0D1A25116181AB2A88E0C37D60D8EE8E78AB dh-p=D856757040A8F6AC0D7E4B57E18FD2865FB287958A8804D9CE01EB94B0C01817B8AA0AC438CE47FE65DD4F301932498C668ED4808115A459F5044982228C5D462A4A3633A218B01F698B00C21A693D6DEFB890987E9940FE3A72D6F53EE3FEA4BE39A42B65711C82D097418A18447579F1CF62E6A2562B65A97030CDCA576C9D expires=1893545999\n"},
    .{args = "auth/ai2key -t 'a=b' default beta.example", out = "key proto=infauth a=b dom=* server=* sigalg=rsa-sha1 user=signer signer=signer pk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== !sk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ==^AKT/PDoeE9vLeAfXnIdlaBlr1G/izpgAK34ahLK0YgjK4XQtgrZpCK4Qoe5cXHVET5+n2/gS8vwrxohuFEr+F2U=^AIVD/EHNMGQFUuA2mv7BMgmk1kwN691uKF5HltdJ735x^AXaVZtS3mxAUYexR5xbuTpVqeMK4sN7PDVioMNpV+izL^PYHW40sCpFE58VRHiUV5jkwUIxoeF23rPzS7xdNa1+U=^AQNTvVgwV6irpkElAnJWNmdxGIbOodVURFER+m/FXm3H^ATit+dUNDQuLZK8u6VIpo3WV3dsqvtklRlcONfug9xdl spk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== cert=rsa^sha1^signer^0^ALMkOINkQaJjgvQ+PcluCe+GYhLW9dE5yhWgZy73/s00X9VlIZBSGvs0yqo01HBacyRE+rYtjugN5iGMqbkUDuI= dh-alpha=9766EFB652FEDC03742CBF2E41AC2358BD613645 dh-p=DF6D828EF2C69C8B4A0FBFB58E52A34ED01CAC2BC0D236990342AA803B98159CFF1C10194B8132B69B8287B517F3ABC4B417808676EE9595E9BF75A2FF6162D2A12F0C742D9D80E2E64155ED89CE4304A0D23F10C77B41143638D79D3C01A14A117A8A855845283CB837959AB62617663F7C2BE5F21A763750C1041826A42B0F\nkey proto=infauth  a=b dom=beta.example server=beta.example sigalg=rsa-sha1 user=beta signer=beta pk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw== !sk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw==^N52AawAI2pAymrd4o3oTeNtuFTJTVjg1yILPPKA7D+c=^AIUEo4T/UdlLyM3pCwAb9sM=^AZpMVAxf+FK+yXIoV/E2FdE=^beJw0gqRhvvSZ1E1m+qUMQ==^AOfoXAb+l3yunmHqR/ekIpc=^AROF/x4soDz2cn8Lnoyq4Kw= spk=rsa^beta^ANUxFu+AIfB+F1EUo8f+n/wTIZ4nnr9Y2L2K1nYCNHQz^Fw== cert=rsa^sha1^beta^1893545999^AIPqUy2HlCaYlpC8XohuYFE49lIJhP9RSXq+eadZp+eG dh-alpha=EADA0D1A25116181AB2A88E0C37D60D8EE8E78AB dh-p=D856757040A8F6AC0D7E4B57E18FD2865FB287958A8804D9CE01EB94B0C01817B8AA0AC438CE47FE65DD4F301932498C668ED4808115A459F5044982228C5D462A4A3633A218B01F698B00C21A693D6DEFB890987E9940FE3A72D6F53EE3FEA4BE39A42B65711C82D097418A18447579F1CF62E6A2562B65A97030CDCA576C9D expires=1893545999\n"},
    .{args = "auth/ai2key old default", out = "key proto=infauth dom=* server=* sigalg=rsa-sha1 user=signer signer=signer pk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== !sk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ==^AKT/PDoeE9vLeAfXnIdlaBlr1G/izpgAK34ahLK0YgjK4XQtgrZpCK4Qoe5cXHVET5+n2/gS8vwrxohuFEr+F2U=^AIVD/EHNMGQFUuA2mv7BMgmk1kwN691uKF5HltdJ735x^AXaVZtS3mxAUYexR5xbuTpVqeMK4sN7PDVioMNpV+izL^PYHW40sCpFE58VRHiUV5jkwUIxoeF23rPzS7xdNa1+U=^AQNTvVgwV6irpkElAnJWNmdxGIbOodVURFER+m/FXm3H^ATit+dUNDQuLZK8u6VIpo3WV3dsqvtklRlcONfug9xdl spk=rsa^signer^AML/GKHGdI9k06wtW+XU72PchrLGOfl0kH3CP7vsc9vaeqiBmbl2IUSCoy3X91Fc/SkVb9SElZXGiksyg8n+r5s=^DQ== cert=rsa^sha1^signer^0^ALMkOINkQaJjgvQ+PcluCe+GYhLW9dE5yhWgZy73/s00X9VlIZBSGvs0yqo01HBacyRE+rYtjugN5iGMqbkUDuI= dh-alpha=9766EFB652FEDC03742CBF2E41AC2358BD613645 dh-p=DF6D828EF2C69C8B4A0FBFB58E52A34ED01CAC2BC0D236990342AA803B98159CFF1C10194B8132B69B8287B517F3ABC4B417808676EE9595E9BF75A2FF6162D2A12F0C742D9D80E2E64155ED89CE4304A0D23F10C77B41143638D79D3C01A14A117A8A855845283CB837959AB62617663F7C2BE5F21A763750C1041826A42B0F\n", err = "ai2key: old: certificate expired -- key ignored\n"},
    .{args = "auth/ai2key garbage default", status = "error", err = "ai2key: cannot read garbage: garbage: input or format error\n"},
    .{args = "auth/ai2key missing", status = "error", err = "ai2key: cannot read missing: 'missing' file does not exist\n"},
    .{args = "auth/ai2key", status = "usage", err = "usage: ai2key [-t 'attr=value attr=value ...'] keyfile ...\n"},
    .{args = "auth/ai2key -t", status = "usage", err = "usage: ai2key [-t 'attr=value attr=value ...'] keyfile ...\n"},
    .{args = "auth/ai2key -q default", status = "usage", err = "usage: ai2key [-t 'attr=value attr=value ...'] keyfile ...\n"},
    // auth/verify and auth/countersigner work on a key database bound on
    // /keydb: a box whose certificate was signed, and broken ones.
    .{args = "bind keydb /keydb"},
    .{args = "auth/verify", status = "usage", err = "usage: verify boxid\n"},
    .{args = "auth/verify box1 < no", status = "rejected", out = "0: alpha\t1: alpha\n2: alpha\t3: kilo\n4: bravo\t5: uniform\n6: bravo\t7: echo\n8: charlie\t9: oscar\n10: delta\t11: yankee\n12: delta\t13: india\n14: echo\t15: sierra\n16: foxtrot\t17: charlie\n18: foxtrot\t19: mike\n20: golf\t21: whisky\n22: golf\t23: golf\n24: hotel\t25: quebec\n26: india\t27: alpha\n28: india\t29: kilo\n30: juliet\t31: uniform\n32: kilo\t33: echo\n34: kilo\t35: oscar\n36: lima\t37: yankee\n38: lima\t39: india\n\naccept (y or n)? \nrejected\n"},
    .{args = "auth/verify box1 < empty", status = "rejected", out = "0: alpha\t1: alpha\n2: alpha\t3: kilo\n4: bravo\t5: uniform\n6: bravo\t7: echo\n8: charlie\t9: oscar\n10: delta\t11: yankee\n12: delta\t13: india\n14: echo\t15: sierra\n16: foxtrot\t17: charlie\n18: foxtrot\t19: mike\n20: golf\t21: whisky\n22: golf\t23: golf\n24: hotel\t25: quebec\n26: india\t27: alpha\n28: india\t29: kilo\n30: juliet\t31: uniform\n32: kilo\t33: echo\n34: kilo\t35: oscar\n36: lima\t37: yankee\n38: lima\t39: india\n\naccept (y or n)? \nrejected\n"},
    .{args = "auth/verify box1 < yes", out = "0: alpha\t1: alpha\n2: alpha\t3: kilo\n4: bravo\t5: uniform\n6: bravo\t7: echo\n8: charlie\t9: oscar\n10: delta\t11: yankee\n12: delta\t13: india\n14: echo\t15: sierra\n16: foxtrot\t17: charlie\n18: foxtrot\t19: mike\n20: golf\t21: whisky\n22: golf\t23: golf\n24: hotel\t25: quebec\n26: india\t27: alpha\n28: india\t29: kilo\n30: juliet\t31: uniform\n32: kilo\t33: echo\n34: kilo\t35: oscar\n36: lima\t37: yankee\n38: lima\t39: india\n\naccept (y or n)? \naccepted\n"},
    .{args = "cat keydb/countersigned/box1", out = "0024\nthe blinded certificate\n"},
    .{args = "auth/verify missing < yes", status = "no certificate", err = "signer: can't open signed/missing: 'signed/missing' does not exist\n"},
    .{args = "auth/verify short < yes", status = "bad certificate", err = "signer: can't read signed/short: hungup\n"},
    .{args = "auth/verify remote < yes", status = "bad certificate", err = "signer: can't read signed/remote: nope!\n"},
    .{args = "auth/verify garbage < yes", status = "bad certificate", err = "signer: can't read signed/garbage: hungup\n"},
    .{args = "auth/countersigner < box1.msg", out = "0024\nthe blinded certificate\n"},
    .{args = "auth/countersigner < missing.msg", status = "bad boxid", err = "countersigner: can't open countersigned/missing: 'countersigned/missing' does not exist\n"},
    .{args = "auth/countersigner < bad.msg", status = "hungup", err = "countersigner: client hung up\n"},
    .{args = "auth/countersigner < empty", status = "hungup", err = "countersigner: client hung up\n"},
    .{args = "unmount /keydb"},
    .{args = "bind emptydb /keydb"},
    .{args = "auth/verify box1 < yes", status = "no certificate", err = "signer: can't open signed/box1: 'signed' file does not exist\n"},
    .{args = "unmount /keydb"},
    // auth/createsignerkey makes random keys: ai2key shows their fields
    // with the numbers masked. The failures are exact.
    .{args = "auth/createsignerkey -f csk.rsa -b 256 signer; auth/ai2key csk.rsa | sed 's/\\^[A-Za-z0-9+\\/]+=*/^B64/g; s/dh-(alpha|p)=[0-9A-F]+/dh-\\1=H/g; s/expires=[0-9]+/expires=N/'", out = "key proto=infauth dom=csk.rsa server=csk.rsa sigalg=rsa-sha1 user=signer signer=signer pk=rsa^B64^B64^B64 !sk=rsa^B64^B64^B64^B64^B64^B64^B64^B64^B64 spk=rsa^B64^B64^B64 cert=rsa^B64^B64^B64^B64 dh-alpha=H dh-p=H\n"},
    .{args = "auth/createsignerkey -a elgamal -f csk.eg -b 128 'eg owner'; auth/ai2key csk.eg | sed 's/\\^[A-Za-z0-9+\\/]+=*/^B64/g; s/dh-(alpha|p)=[0-9A-F]+/dh-\\1=H/g; s/expires=[0-9]+/expires=N/'", out = "key proto=infauth dom=csk.eg server=csk.eg sigalg=elgamal-sha1 user='eg owner' signer='eg owner' pk=elgamal^B64 owner^B64^B64^B64 !sk=elgamal^B64 owner^B64^B64^B64^B64 spk=elgamal^B64 owner^B64^B64^B64 cert=elgamal^B64^B64 owner^B64^B64^B64 dh-alpha=H dh-p=H\n"},
    .{args = "auth/createsignerkey -f csk.exp -b 128 -e 01012030 beta; auth/ai2key csk.exp | sed 's/\\^[A-Za-z0-9+\\/]+=*/^B64/g; s/dh-(alpha|p)=[0-9A-F]+/dh-\\1=H/g; s/expires=[0-9]+/expires=N/'", out = "key proto=infauth dom=csk.exp server=csk.exp sigalg=rsa-sha1 user=beta signer=beta pk=rsa^B64^B64^B64 !sk=rsa^B64^B64^B64^B64^B64^B64^B64^B64^B64 spk=rsa^B64^B64^B64 cert=rsa^B64^B64^B64^B64 dh-alpha=H dh-p=H expires=N\n"},
    .{args = "auth/createsignerkey -a x -f x.key owner", status = "error", err = "createsignerkey: unknown algorithm: x\n"},
    .{args = "auth/createsignerkey -b 10 -f x.key owner", status = "error", err = "createsignerkey: modulus must be in the range of 32 to 4096 bits\n"},
    .{args = "auth/createsignerkey -b 5000 -f x.key owner", status = "error", err = "createsignerkey: modulus must be in the range of 32 to 4096 bits\n"},
    .{args = "auth/createsignerkey -e 123 -f x.key owner", status = "error", err = "createsignerkey: !date must be in form ddmmyyyy\n"},
    .{args = "auth/createsignerkey -e 32012030 -f x.key owner", status = "error", err = "createsignerkey: !bad day of month\n"},
    .{args = "auth/createsignerkey -e 01132030 -f x.key owner", status = "error", err = "createsignerkey: !bad month\n"},
    .{args = "auth/createsignerkey -e 01011960 -f x.key owner", status = "error", err = "createsignerkey: !bad year\n"},
    .{args = "auth/createsignerkey -e 01012099 -f x.key owner", status = "error", err = "createsignerkey: !expiration date must be in the future\n"},
    .{args = "auth/createsignerkey -e 01012020 -f x.key owner", status = "error", err = "createsignerkey: !expiration date must be in the future\n"},
    .{args = "auth/createsignerkey -f x.key", status = "usage", err = "usage: createsignerkey [-a algorithm] [-f keyfile] [-e ddmmyyyy] [-b size-in-bits] name-of-owner\n"},
    .{args = "auth/createsignerkey -q owner", status = "usage", err = "usage: createsignerkey [-a algorithm] [-f keyfile] [-e ddmmyyyy] [-b size-in-bits] name-of-owner\n"},
    .{args = "auth/createsignerkey -a", status = "usage", err = "usage: createsignerkey [-a algorithm] [-f keyfile] [-e ddmmyyyy] [-b size-in-bits] name-of-owner\n"},
    .{args = "auth/createsignerkey -f /nonexist/dir/k -b 128 owner", status = "error", err = "createsignerkey: can't write signerkey file /nonexist/dir/k: '/nonexist' file does not exist\n"},
    // Dis commands that load other commands start the ZX bundles too.
    .{args = "echo a.txt words | xargs cat", out = "alpha\nbeta\nbeta\ncafé κ\none two  three\nfour\tfive\n"},
    .{args = "time cat empty >[2] /dev/null"},
    // The shell exports path to /env, so these two stay last.
    // A .zx that is not executable, or is a directory, falls through to the next path entry.
    .{args = "path=(fake /dis); whatis sh ls", out = "/dis/sh.dis\n/dis/ls.zx\n"},
    // An executable .zx wins even when it is not a valid bundle.
    .{args = "path=(fake /dis); whatis cat; cat >[2] /dev/null", status = "zx", out = "fake/cat.zx\n"},
];

failures: s32;

Expect :: (ok: bool, index: s64, what: string, got: string, want: string) {
    if ok { return }
    failures += 1
    print("FAIL case % (% %) %:\n  got  [%]\n  want [%]\n", index, cases[index].tool, cases[index].args, what, got, want)
}

Write :: (name: string, text: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/work/%", WORK, name)
    return WriteEntireFile(BuilderFinish(path), text)
}

Directory :: (name: string) -> bool {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", WORK, name)
    return CreateDirectory(BuilderFinish(path))
}

// The bytes 0 through 255, forty times: crosses the 8 KiB transfer size.
Binary :: () -> Text {
    bytes: Vec(u8)
    for 1..40 { for 0..255 { VecPush(bytes, cast(u8)it) } }
    return BuilderFinish(bytes)
}

// Writes the bytes that hexadecimal text stands for.
WriteHex :: (name: string, hex: string) -> bool {
    bytes: Vec(u8)
    value: u8 = 0
    for hex {
        digit := ifx it >= #char "a" then it - #char "a" + 10 else it - #char "0"
        value = value * 16 + digit
        if it_index % 2 == 1 { VecPush(bytes, value); value = 0 }
    }
    return Write(name, TextView(bytes[:]))
}

Prepare :: (binary: string) -> bool {
    digits, digits_ok := ReadEntireFile("lib/strokes/digits.cl")
    if !digits_ok { return false }
    unused RemoveTree(WORK)
    unused CreateDirectory("build")
    unused CreateDirectory("build/tests")
    if !CreateDirectory(WORK) || !Directory("work") || !Directory("result") ||
        !Directory("work/tree") || !Directory("work/tree/sub") || !Directory("work/fake") ||
        !Directory("work/fake/ls.zx") { return false }
    return Write("a.txt", ALPHA) && Write("words", WORDS) && Write("squeeze", SQUEEZE) &&
        Write("empty", "") && Write("bin", binary) && Write("-dash", "dash\n") &&
        Write("café blanc", "c\n") && Write("tree/x", "x\n") && Write("tree/sub/y", "yy\n") &&
        Write("file.tcl", TCL_FILE) && Write("two.tcl", "puts file-two\n") && Write("lines.tcl", TCL_LINES) &&
        Write("reg.db", REGISTRY) && Write("digits.cl", digits) && Write("ndb.main", NDB_MAIN) && Write("ndb.second", NDB_SECOND) && Directory("work/mnt") &&
        WriteHex("default", AUTHINFO_DEFAULT) && WriteHex("tcp!alpha.example!infsigner", AUTHINFO_TCP_ALPHA_EXAMPLE_INFSIGNER) && WriteHex("beta.example", AUTHINFO_BETA_EXAMPLE) && WriteHex("old", AUTHINFO_OLD) && WriteHex("garbage", AUTHINFO_GARBAGE) && WriteHex("short", AUTHINFO_SHORT) &&
        Directory("work/keydb") && Directory("work/keydb/signed") && Directory("work/keydb/countersigned") && Directory("work/emptydb") &&
        WriteHex("keydb/signed/box1", "303032340a74686520626c696e6465642063657274696669636174650a303032300a000a141e28323c46505a646e78828c96a0aab4be") &&
        WriteHex("keydb/signed/short", "303031360a6f6e6c79206f6e65206d657373616765") &&
        WriteHex("keydb/signed/remote", "303030340a63657274213030350a6e6f706521") &&
        WriteHex("keydb/signed/garbage", "7879") &&
        WriteHex("yes", "790a") &&
        WriteHex("no", "6e0a") &&
        WriteHex("box1.msg", "303030340a626f7831") &&
        WriteHex("missing.msg", "303030370a6d697373696e67") &&
        WriteHex("bad.msg", "3030") &&
        WriteHex("clear.aes", AES_CLEAR) && WriteHex("old.aes", AES_OLD) && Write("aes.key", "secret\n\n") && Write("blank.key", "\n\n") &&
        Write("fake/sh.zx", "not a ZX bundle\n") && Write("fake/cat.zx", "not a ZX bundle\n") &&
        SetPathMode("build/tests/commands/work/fake/cat.zx", 493) // 0755
}

// One guest shell script runs every case and keeps each result in a file.
Script :: () -> Text {
    script: Vec(u8)
    BuilderPrint(*script, "cd /%/work\n", WORK)
    for cases {
        if it.tool == "" {
            BuilderPrint(*script, "{%}", it.args)
        } else {
            BuilderPrint(*script, "% %", it.tool, it.args)
        }
        input := ifx it.input == "" then "/dev/null" else it.input
        BuilderPrint(*script, " < % > ../result/out.% >[2] ../result/err.%\n", input, it_index, it_index)
        BuilderPrint(*script, "echo $status > ../result/status.%\n", it_index)
    }
    return BuilderFinish(script)
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index)
    text, ok := ReadEntireFile(BuilderFinish(path))
    return ifx ok then text else "<missing>"
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else (ifx PathExists("emu/Linux/o.emu") then "emu/Linux/o.emu" else "Linux/386/bin/emu")
    binary: Text = Binary()
    if !Prepare(TextView(binary)) { print("cannot prepare %\n", WORK); return 1 }
    script: Text = Script()
    if !WriteEntireFile("build/tests/commands/script", TextView(script)) { return 1 }
    root: Text = WorkingDirectory()
    guest: Vec(u8)
    BuilderPrint(*guest, "/%/script", WORK)
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)]
    run: ProcessRun
    started := RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run)
    if !started { print("cannot start %\n", emu); return 1 }
    for cases {
        status_line: Vec(u8)
        BuilderPrint(*status_line, "%\n", it.status)
        status := BuilderFinish(status_line)
        got_status := Result("status", it_index)
        Expect(got_status == status, it_index, "status", got_status, status)
        out := Result("out", it_index)
        want := ifx it.binary_out then TextView(binary) else it.out
        Expect(out == want, it_index, "stdout", out, want)
        err := Result("err", it_index)
        Expect(err == it.err, it_index, "stderr", err, it.err)
    }
    if failures != 0 { print("commands: % failures in % cases\n", failures, cases.count); return 1 }
    print("commands: all % cases match the Limbo originals\n", cases.count)
    return 0
}
