// Tests for the Ziran W3C libraries in appl/lib: uris.zi, xpointers.zi,
// xpath.zi, xml_names.zi and the limbo_text.zi helpers they share. The
// .limbo.txt files hold what the Limbo URIs and Xpointers modules printed
// for the same cases; the Ziran modules must print the same lines.
//
//     ziran run --target=c --root tests/w3c --module-path appl/lib tests/w3c/w3c_test.zi
//
// w3c_guest.zi runs the same comparison as a ZX program in the emulator.
#import "std/file"
using Uris :: #import "uris_cases"
using Pointers :: #import "xpointers_cases"
using Golden :: #import "golden"

main :: () -> s32 {
    report: Vec(u8)
    uris: Vec(u8)
    Uris.UriLines(*uris)
    want_uris, ok_uris := ReadEntireFile("tests/w3c/uris.limbo.txt")
    pointers: Vec(u8)
    Pointers.PointerLines(*pointers)
    want_pointers, ok_pointers := ReadEntireFile("tests/w3c/xpointers.limbo.txt")
    if !ok_uris || !ok_pointers { print("FAIL: cannot read tests/w3c/*.limbo.txt\n"); return 1 }
    same := Golden.Same("uris", TextView(uris[:]), want_uris, *report)
    same = Golden.Same("xpointers", TextView(pointers[:]), want_pointers, *report) && same
    if !same { print("%", TextView(report[:])); return 1 }
    print("w3c: URIs and XPointers match the Limbo modules\n")
    return 0
}
