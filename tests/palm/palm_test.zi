// Table-driven tests for Palm SLP/CMP/PADP/DLP/Desklink codecs and guest connex parity.
//
// Run from TaijiOS root:
//   ziran run --target=c --root appl/cmd/palm tests/palm/palm_test.zi -- [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/vec"
using Proto :: #import "palm_proto"

WORK :: "build/dis-legacy-math/palm";

failures: s32;

Expect :: (ok: bool, what: string) {
    if !ok {
        failures += 1;
        print("FAIL: %\n", what);
    }
}

TestProto :: () {
    // CRC-16/XMODEM check vector: "123456789" -> 0x31C3
    vec: [9]u8 = .[#char "1", #char "2", #char "3", #char "4", #char "5", #char "6", #char "7", #char "8", #char "9"];
    Expect(Proto.Crc16(vec[:], 0) == 0x31C3, "CRC16-XMODEM standard vector");

    // SLP encode/decode round-trip + corruption checks
    body: [4]u8 = .[0x01, 0xC0, 0x00, 0x0A];
    raw: Vec(u8);
    Proto.EncodeSlp(3, 3, Proto.SLP_PAD, 0x42, body[:], *raw);
    Expect(raw.count == 16 && raw[0] == 0xBE && raw[1] == 0xEF && raw[2] == 0xED, "SLP header magic");
    frame: Proto.SlpFrame;
    Expect(Proto.DecodeSlp(raw[:], *frame), "SLP decode valid");
    Expect(frame.dst == 3 && frame.src == 3 && frame.proto == Proto.SLP_PAD && frame.xid == 0x42 &&
        frame.data.count == 4 && frame.data[0] == 0x01 && frame.data[3] == 0x0A, "SLP decoded fields");

    raw[raw.count - 1] ^= 0x01;
    Expect(!Proto.DecodeSlp(raw[:], *frame), "SLP rejects bad CRC");
    raw[raw.count - 1] ^= 0x01;
    raw[9] ^= 0x01;
    Expect(!Proto.DecodeSlp(raw[:], *frame), "SLP rejects bad header checksum");

    // CMP encode/decode round-trip
    cmp_in := Proto.CmpMsg.{op = Proto.C_INIT, flags = Proto.CHANGE_BAUD, major = 1, minor = 2, baud = 57600};
    cmp_buf: Vec(u8);
    Proto.EncodeCmp(cmp_in, *cmp_buf);
    cmp_out: Proto.CmpMsg;
    Expect(Proto.DecodeCmp(cmp_buf[:], *cmp_out) && cmp_out.op == Proto.C_INIT &&
        cmp_out.flags == Proto.CHANGE_BAUD && cmp_out.major == 1 && cmp_out.minor == 2 && cmp_out.baud == 57600, "CMP round-trip");

    // PADP header encoding
    padp: Vec(u8);
    Proto.EncodePadp(Proto.P_DATA, Proto.PADP_FIRST | Proto.PADP_LAST, 4, body[:], *padp);
    Expect(padp.count == 8 && padp[0] == Proto.P_DATA && padp[1] == 0xC0 && Proto.Get2(padp[:], 2) == 4, "PADP header");

    // DLP request packing and reply unpacking
    req: Vec(u8);
    arg: [2]u8 = .[0x00, 0x01];
    Proto.PackDlpReq(Proto.T_END_OF_SYNC, Proto.ARG_ID_BASE, arg[:], true, *req);
    Expect(req.count == 6 && req[0] == Proto.T_END_OF_SYNC && req[1] == 1 && req[2] == Proto.ARG_ID_BASE && req[3] == 2, "DLP pack req");

    rep: [8]u8 = .[Proto.DLP_RESPONSE | Proto.T_READ_SYS_INFO, 1, 0, 0, Proto.ARG_ID_BASE, 2, #char "O", #char "K"];
    rep_arg: Vec(u8);
    err: Text;
    Expect(Proto.UnpackDlpReply(Proto.T_READ_SYS_INFO, rep[:], *rep_arg, *err) && TextView(rep_arg[:]) == "OK", "DLP unpack ok reply");

    err_rep: [4]u8 = .[Proto.DLP_RESPONSE | Proto.T_OPEN_DB, 0, 0, 5];
    Expect(!Proto.UnpackDlpReply(Proto.T_OPEN_DB, err_rep[:], *rep_arg, *err) && TextView(err) == "palm: not found", "DLP unpack error code");

    cno, name := Proto.ParseDbName("AddressDB");
    Expect(cno == 0 && name == "AddressDB", "ParseDbName default card 0");
    cno, name = Proto.ParseDbName("2/MemoDB");
    Expect(cno == 2 && name == "MemoDB", "ParseDbName card 2");
}

TestGuest :: (emu: string) {
    unused RemoveTree(WORK);
    unused CreateDirectory("build");
    unused CreateDirectory("build/dis-legacy-math");
    if !CreateDirectory(WORK) || !CreateDirectory("build/dis-legacy-math/palm/work") ||
        !CreateDirectory("build/dis-legacy-math/palm/result") {
        failures += 1;
        print("FAIL: cannot prepare %\n", WORK);
        return;
    }
    script: Vec(u8);
    BuilderPrint(*script, "cd /%/work\n", WORK);
    BuilderPrint(*script, "palm/connex < /dev/null > ../result/conn.out >[2] ../result/conn.err\n");
    BuilderPrint(*script, "echo $status > ../result/conn.st\n");
    unused WriteEntireFile("build/dis-legacy-math/palm/script", BuilderFinish(script));

    root: Text = WorkingDirectory();
    guest: Vec(u8);
    BuilderPrint(*guest, "/%/script", WORK);
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)];
    run: ProcessRun;
    if !RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run) {
        failures += 1;
        print("FAIL: cannot start %\n", emu);
        return;
    }
    st, _ := ReadEntireFile("build/dis-legacy-math/palm/result/conn.st");
    ce, _ := ReadEntireFile("build/dis-legacy-math/palm/result/conn.err");
    Expect(st == "error\n", "connex status");
    Expect(ce == "tconn: can't init Desklink: can't open /chan/palmsrv: '/chan/palmsrv' file does not exist\n", "connex stderr");
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else "Linux/386/bin/emu";
    TestProto();
    TestGuest(emu);
    if failures != 0 {
        print("palm_test: % failures\n", failures);
        return 1;
    }
    print("palm_test: all checks passed\n");
    return 0;
}
