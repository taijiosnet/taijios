// Table-driven tests for Lego RCX framing, RLE codec, S-record firmware loader,
// clockface click math, and guest CLI parity for lego/send and lego/firmdl.
//
// Run from TaijiOS root:
//   ziran run --target=c --root appl/cmd/lego tests/lego/lego_test.zi -- [EMU]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/vec"
using Proto :: #import "lego_proto"

WORK :: "build/dis-legacy-math/lego";

CliCase :: struct {
    name: string;
    cmd: string;
    status: string;
    out: string;
}

cli_cases: [4]CliCase = CliCase.[
    .{name = "send usage", cmd = "lego/send", status = "", out = "usage: send portnum XX...\n"},
    .{name = "send bad hex", cmd = "lego/send 0 zz", status = "", out = "bad arg zz\n\n"},
    .{name = "firmdl usage", cmd = "lego/firmdl 0", status = "", out = "usage: portnum file\n"},
    .{name = "firmdl missing", cmd = "lego/firmdl 0 missing.srec", status = "", out = "cannot open missing.srec: 'missing.srec' file does not exist\n"},
];

failures: s32;

Expect :: (ok: bool, what: string) {
    if !ok {
        failures += 1;
        print("FAIL: %\n", what);
    }
}

TestProto :: () {
    v, ok := Proto.ParseHexArg("a5");
    Expect(ok && v == 0xA5, "ParseHexArg a5");
    v, ok = Proto.ParseHexArg("f");
    Expect(ok && v == 0x0F, "ParseHexArg f");
    _, ok = Proto.ParseHexArg("xyz");
    Expect(!ok, "ParseHexArg rejects >2 chars");

    msg: [3]u8 = .[0x10, 0x20, 0x30];
    pkt: Vec(u8);
    Proto.EncodeRcxPacket(msg[:], *pkt);
    Expect(pkt.count == 11 && pkt[0] == 0x55 && pkt[1] == 0xFF && pkt[2] == 0x00 &&
        pkt[3] == 0x10 && pkt[4] == 0xEF && pkt[9] == 0x60 && pkt[10] == 0x9F, "RCX packet encoding");
    dec: Vec(u8);
    Expect(Proto.DecodeRcxReply(pkt[:], *dec) && dec.count == 3 && dec[0] == 0x10 && dec[2] == 0x30, "RCX reply decode");
    pkt[9] ^= 1;
    Expect(!Proto.DecodeRcxReply(pkt[:], *dec), "RCX reply rejects bad checksum");

    raw: [12]u8 = .[0x01, 0x00, 0x02, 0x00, 0x00, 0x88, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFF];
    enc: Vec(u8);
    Proto.RleEncode(raw[:], *enc);
    Expect(enc.count < raw.count, "RLE compresses 5-zero run");
    rt: Vec(u8);
    Expect(Proto.RleDecode(enc[:], *rt) && rt.count == raw.count, "RLE round-trip length");
    for i: 0..raw.count - 1 { Expect(rt[i] == raw[i], "RLE round-trip byte") }
    bad_rle: [1]u8 = .[0x88];
    Expect(!Proto.RleDecode(bad_rle[:], *rt), "RLE rejects truncated 0x88 escape");

    srec := "S1078000010203046E\nS90380007C\n";
    img: Proto.FirmwareImage;
    Expect(Proto.ParseFirmwareText(srec, *img), "ParseFirmwareText valid");
    Expect(img.start == 0x8000 && img.length == 4 && img.data[0] == 1 && img.data[3] == 4, "ParseFirmwareText contents");

    hclk, mclk := Proto.ClockClicks(3, 30);
    Expect(hclk == 35 && mclk == 60, "ClockClicks 3:30");
    Expect(Proto.ClickDistance(110, 10, 120) == 20, "ClickDistance wrap forward");
    Expect(Proto.ClickDistance(10, 110, 120) == -20, "ClickDistance wrap backward");
}

Result :: (kind: string, index: s64) -> string {
    path: Vec(u8);
    BuilderPrint(*path, "%/result/%.%", WORK, kind, index);
    text, ok := ReadEntireFile(BuilderFinish(path));
    return ifx ok then text else "<missing>";
}

TestGuest :: (emu: string) {
    unused RemoveTree(WORK);
    unused CreateDirectory("build");
    unused CreateDirectory("build/dis-legacy-math");
    if !CreateDirectory(WORK) || !CreateDirectory("build/dis-legacy-math/lego/work") ||
        !CreateDirectory("build/dis-legacy-math/lego/result") {
        failures += 1;
        print("FAIL: cannot prepare %\n", WORK);
        return;
    }
    script: Vec(u8);
    BuilderPrint(*script, "cd /%/work\n", WORK);
    for cli_cases {
        BuilderPrint(*script, "% < /dev/null > ../result/out.% >[2] ../result/err.%\n", it.cmd, it_index, it_index);
        BuilderPrint(*script, "echo $status > ../result/status.%\n", it_index);
    }
    unused WriteEntireFile("build/dis-legacy-math/lego/script", BuilderFinish(script));

    root: Text = WorkingDirectory();
    guest: Vec(u8);
    BuilderPrint(*guest, "/%/script", WORK);
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)];
    run: ProcessRun;
    if !RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run) {
        failures += 1;
        print("FAIL: cannot start %\n", emu);
        return;
    }
    for cli_cases {
        want_st: Vec(u8);
        BuilderPrint(*want_st, "%\n", it.status);
        got_st := Result("status", it_index);
        got_out := Result("out", it_index);
        if got_st != BuilderFinish(want_st) {
            failures += 1;
            print("FAIL % status: got [%] want [%]\n", it.name, got_st, it.status);
        }
        if got_out != it.out {
            failures += 1;
            print("FAIL % stdout: got [%] want [%]\n", it.name, got_out, it.out);
        }
    }
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else "Linux/386/bin/emu";
    TestProto();
    TestGuest(emu);
    if failures != 0 {
        print("lego_test: % failures\n", failures);
        return 1;
    }
    print("lego_test: all checks passed\n");
    return 0;
}
