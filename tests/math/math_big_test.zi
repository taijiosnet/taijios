// Guest parity test for mersenne, parts, and powers.
//
// Run from TaijiOS root:
//   ziran run --target=c --root tests/math tests/math/math_big_test.zi -- [EMU] [PREFIX] [SUFFIX]
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/vec"

WORK :: "build/dis-legacy-math/mathbig";

failures: s32;

Expect :: (ok: bool, what: string) {
    if !ok {
        failures += 1;
        print("FAIL: %\n", what);
    }
}

Result :: (name: string) -> string {
    path: Vec(u8);
    BuilderPrint(*path, "%/result/%", WORK, name);
    text, ok := ReadEntireFile(BuilderFinish(path));
    return ifx ok then text else "<missing>";
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else "Linux/386/bin/emu";
    prefix := ifx argc > 2 then TextFromCString(argv[2]) else "/dis/math/";
    suffix := ifx argc > 3 then TextFromCString(argv[3]) else ".dis";

    unused RemoveTree(WORK);
    unused CreateDirectory("build");
    unused CreateDirectory("build/dis-legacy-math");
    if !CreateDirectory(WORK) || !CreateDirectory("build/dis-legacy-math/mathbig/result") {
        print("FAIL: cannot prepare %\n", WORK);
        return 1;
    }

    script: Vec(u8);
    BuilderPrint(*script, "cd /%/result\n", WORK);
    // 1. mersenne
    BuilderPrint(*script, "%mersenne% 2 > m2.out\n", prefix, suffix);
    BuilderPrint(*script, "%mersenne% 11 > m11.out\n", prefix, suffix);
    BuilderPrint(*script, "%mersenne% 31 > m31.out\n", prefix, suffix);
    BuilderPrint(*script, "%mersenne% 61 > m61.out\n", prefix, suffix);
    BuilderPrint(*script, "%mersenne% 67 > m67.out\n", prefix, suffix);
    // 2. parts
    BuilderPrint(*script, "%parts% 0 10 50 > p_basic.out\n", prefix, suffix);
    BuilderPrint(*script, "%parts% -a 7 > p_all.out\n", prefix, suffix);
    BuilderPrint(*script, "%parts% -c 30 > p_cong.out\n", prefix, suffix);
    // 3. powers
    BuilderPrint(*script, "%powers% -p 3 -m 5000 > pow_cubes.out\n", prefix, suffix);
    BuilderPrint(*script, "%powers% -p 2 -f 3 -m 500 > pow_sq.out\n", prefix, suffix);
    unused WriteEntireFile("build/dis-legacy-math/mathbig/script", BuilderFinish(script));

    root: Text = WorkingDirectory();
    guest: Vec(u8);
    BuilderPrint(*guest, "/%/script", WORK);
    command: [5]string = .[emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(guest)];
    run: ProcessRun;
    if !RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run) {
        print("FAIL: cannot start %\n", emu);
        return 1;
    }

    Expect(Result("m2.out") == "2^2-1 is prime\n", "mersenne 2");
    Expect(Result("m11.out") == "2^11-1 is not prime\n", "mersenne 11");
    Expect(Result("m31.out") == "2^31-1 is prime\n", "mersenne 31");
    Expect(Result("m61.out") == "2^61-1 is prime\n", "mersenne 61");
    Expect(Result("m67.out") == "2^67-1 is not prime\n", "mersenne 67");
    Expect(Result("p_basic.out") == "p[0] = 1\np[10] = 42\np[50] = 204226\n", "parts basic");
    Expect(Result("p_all.out") == "n\tp(n)\n1\t1\n2\t2\n3\t3\n4\t5\n5\t7\n6\t11\n7\t15\n", "parts -a 7");
    Expect(Result("pow_cubes.out") == "[1, 2] 1729 = 1**3 + 12**3 = 9**3 + 10**3\n[1, 2] 4104 = 2**3 + 16**3 = 9**3 + 15**3\n", "powers cubes");
    Expect(Result("pow_sq.out") == "[2, 3] 325 = 1**2 + 18**2 = 6**2 + 17**2 = 10**2 + 15**2\n[2, 3] 425 = 5**2 + 20**2 = 8**2 + 19**2 = 13**2 + 16**2\n", "powers squares");

    if failures != 0 {
        print("math_big_test: % failures\n", failures);
        return 1;
    }
    print("math_big_test: all checks passed\n");
    return 0;
}
