    .{name = "fs:setroot", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/setroot {/fs/walk tree} newroot}}} 1}\n", input = "", status = "", out = "newroot\nnewroot/a.txt\nnewroot/b.b\nnewroot/sub\nnewroot/sub/c.txt\nnewroot/sub/d.b\nnewroot/sub/deep\nnewroot/sub/deep/e.txt\n", err = ""},
    .{name = "fs:setroot-c", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/setroot -c {/fs/walk tree} a/b}}} 1}\n", input = "", status = "", out = "a\na/b\na/b/a.txt\na/b/b.b\na/b/sub\na/b/sub/c.txt\na/b/sub/d.b\na/b/sub/deep\na/b/sub/deep/e.txt\n", err = ""},
    .{name = "fs:setroot-cabs", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/setroot -c {/fs/walk tree} /x/y}}} 1}\n", input = "", status = "", out = "/\n/x\n/x/y\n/x/y/a.txt\n/x/y/b.b\n/x/y/sub\n/x/y/sub/c.txt\n/x/y/sub/d.b\n/x/y/sub/deep\n/x/y/sub/deep/e.txt\n", err = ""},
