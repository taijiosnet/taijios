];

block7: [16]Case = Case.[
    .{name = "fs:fs-types", script = "typeset /fs\necho ${types /fs}\n", input = "", status = "", out = "selector gate entries fs\n", err = ""},
    .{name = "fs:walk-print", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/walk tree}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:walk-sub", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/walk tree/sub}}} 1}\n", input = "", status = "", out = "tree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\n", err = ""},
