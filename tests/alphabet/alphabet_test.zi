    .{name = "fs:auto", script = "typeset /fs\ntype /fs/fs /fs/entries\nautoconvert string fs /fs/walk\nautoconvert fs entries /fs/entries\nautoconvert entries fd /fs/print\n- {/print tree/sub 1}\n", input = "", status = "error", out = "", err = "cannot autoconvert string to fs via /fs/walk: unknown type string\n"},
