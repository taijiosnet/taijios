    .{name = "abc-declares", script = "declares {| declare /echo | import /echo}\n- {/print {echo hi} 1}\necho ${modules}\n", input = "", status = "", out = "hi\n/echo /print echo\n", err = ""},
    .{name = "abc-declares-typeset", script = "declares {| typeset /abc}\ninfo\n", input = "", status = "", out = "typeset /\n/auth [-v] [-k /string] [-C /string] /wfd -> /wfd\n/cat [/fd...] -> /fd\n/create /fd /string -> /status\n/dial /string -> /wfd\n/echo [-n] /string -> /fd\n/env /string -> /string\n/export /string -> /wfd\n/fd /string -> /wfd\n/filter /fd /cmd [/string...] -> /fd\n/mount [-abc] [-x /string] /wfd /string -> /status\n/par [/status...] -> /status\n/parse /string -> /cmd\n/pretty /cmd -> /string\n/print /fd /string -> /status\n/read /string -> /fd\n/readall /fd -> /string\n/rewrite [-d /string] /cmd /cmd -> /cmd\n/seq [-ao] [/status...] -> /status\n/unparse /cmd -> /string\n/w2fd /wfd -> /fd\n/wait /status -> /string\n\ntypeset /abc\n/abc/abc -> /abc/abc\n/abc/autoconvert /abc/abc /string /string /cmd -> /abc/abc\n/abc/autodeclare /abc/abc /string -> /abc/abc\n/abc/declare [-qc] /abc/abc /string [/string...] -> /abc/abc\n/abc/declares /abc/abc /cmd -> /abc/abc\n/abc/define /abc/abc /string /cmd -> /abc/abc\n/abc/eval /abc/abc /cmd [/string...] -> /status\n/abc/import /abc/abc /string [/string...] -> /abc/abc\n/abc/rewrite [-s /string] [-r /string] /abc/abc /cmd -> /cmd\n/abc/type /abc/abc /string [/string...] -> /abc/abc\n/abc/typeset /abc/abc /string -> /abc/abc\n/abc/undeclare /abc/abc /string [/string...] -> /abc/abc\n", err = ""},
