    .{name = "fs:unbundle-file", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/unbundle {/echo 'f 644 u g 0 0'}}}} 1}\n", input = "", status = "", out = "", err = "alphabet: 1. unbundle: first entry is not a directory\n"},
    .{name = "fs:unbundle-filter", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/filter {/fs/unbundle {/fs/bundle {/fs/walk tree}}} {/fs/match '*.b'}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\n", err = ""},
    .{name = "fs:write", script = "typeset /fs\n- {/fs/write {/fs/walk tree} copy}\n- {/print {/fs/print {/fs/entries {/fs/walk copy}}} 1}\n- {/print {/read copy/sub/deep/e.txt} 1}\n", input = "", status = "", out = "copy\ncopy/a.txt\ncopy/b.b\ncopy/sub\ncopy/sub/c.txt\ncopy/sub/d.b\ncopy/sub/deep\ncopy/sub/deep/e.txt\ne\n", err = ""},
    .{name = "fs:write-unbundle", script = "typeset /fs\n- {/fs/write {/fs/unbundle {/fs/bundle {/fs/walk tree/sub}}} copy2}\n- {/print {/read copy2/c.txt} 1}\n- {/print {/fs/print {/fs/entries {/fs/walk copy2}}} 1}\n", input = "", status = "", out = "sea\ncopy2\ncopy2/c.txt\ncopy2/d.b\ncopy2/deep\ncopy2/deep/e.txt\n", err = ""},
    .{name = "fs:write-v", script = "typeset /fs\n- {/fs/write -v {/fs/walk tree/sub} copy3}\n", input = "", status = "", out = "", err = "alphabet: 2. fswrite: create copy3 20000000700\nalphabet: 2. fswrite: create copy3/c.txt 600\nalphabet: 2. fswrite: create copy3/d.b 600\nalphabet: 2. fswrite: create copy3/deep 20000000700\nalphabet: 2. fswrite: create copy3/deep/e.txt 600\n"},
    .{name = "fs:write-filter", script = "typeset /fs\n- {/fs/write {/fs/filter {/fs/walk tree} {/fs/match '*.b'}} copy4}\n- {/print {/fs/print {/fs/entries {/fs/walk copy4}}} 1}\n", input = "", status = "", out = "copy4\ncopy4/b.b\n", err = ""},
    .{name = "fs:write-bad", script = "typeset /fs\n- {/fs/write {/fs/walk tree} /nodir/x}\n", input = "", status = "", out = "", err = "alphabet: 2. fswrite: cannot create /nodir/x, mode 20000000700: '/nodir' file does not exist\n"},
    .{name = "fs:merge", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\ntree/sub/z.txt\ntree/x.b\n", err = ""},
    .{name = "fs:merge-data", script = "typeset /fs\n- {/print {/fs/bundle {/fs/merge {/fs/walk tree} {/fs/walk tree2}}} 1}\n", input = "", status = "", out = "tree 20000000700 @USER@ @USER@ 1577979240 0\na.txt 600 @USER@ @USER@ 1577979240 6\nalpha\nb.b 755 @USER@ @USER@ 1577979240 4\nbee\nsub 20000000700 @USER@ @USER@ 1577979240 0\nc.txt 600 @USER@ @USER@ 1577979240 4\nsea\nd.b 600 @USER@ @USER@ 1577979240 4\ndee\ndeep 20000000700 @USER@ @USER@ 1577979240 0\ne.txt 600 @USER@ @USER@ 1577979240 2\ne\n\nz.txt 600 @USER@ @USER@ 1577979240 4\nzed\n\nx.b 600 @USER@ @USER@ 1577979240 3\nex\n\nend of archive\n", err = ""},
    .{name = "fs:merge-1", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -1 {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\ntree/x.b\n", err = ""},
    .{name = "fs:merge-three", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge {/fs/walk tree} {/fs/walk tree2} {/fs/walk tree2/sub}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/c.txt\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\ntree/sub/z.txt\ntree/x.b\ntree/z.txt\n", err = ""},
    .{name = "fs:merge-newer", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/newer} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree2\ntree2/a.txt\ntree2/b.b\ntree2/sub\ntree2/sub/c.txt\ntree2/sub/d.b\ntree2/sub/deep\ntree2/sub/deep/e.txt\ntree2/sub/z.txt\ntree2/x.b\n", err = ""},
    .{name = "fs:merge-newer-d", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/newer -d} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\ntree/sub/z.txt\ntree/x.b\n", err = ""},
];

block10: [16]Case = Case.[
    .{name = "fs:merge-AinB", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/compose AinB} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/sub\ntree/sub/c.txt\n", err = ""},
    .{name = "fs:merge-AoutB", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/compose AoutB} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\n", err = ""},
    .{name = "fs:merge-BoutA-d", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/compose -d BoutA} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/sub\ntree/sub/z.txt\ntree/x.b\n", err = ""},
    .{name = "fs:merge-AxorB", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/merge -c {/fs/compose AxorB} {/fs/walk tree} {/fs/walk tree2}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\ntree/x.b\n", err = ""},
    .{name = "fs:merge-filter", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/filter {/fs/merge {/fs/walk tree} {/fs/walk tree2}} {/fs/match '*.b'}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\ntree/x.b\n", err = ""},
    .{name = "fs:chstat-mode", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/chstat -m a+r {/fs/walk tree/sub}}}} 1}\n", input = "", status = "", out = "d-rwxr--r-- U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub\n--rw-r--r-- U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/c.txt\n--rw-r--r-- U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/d.b\nd-rwxr--r-- U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub/deep\n--rw-r--r-- U 0 @USER@ @USER@ 2 Jan 02  2020 tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:chstat-owner", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/chstat -u bob -g staff -t 1000000000 {/fs/walk tree/sub}}}} 1}\n", input = "", status = "", out = "d-rwx------ U 0 bob staff 0 Sep 09  2001 tree/sub\n--rw------- U 0 bob staff 4 Sep 09  2001 tree/sub/c.txt\n--rw------- U 0 bob staff 4 Sep 09  2001 tree/sub/d.b\nd-rwx------ U 0 bob staff 0 Sep 09  2001 tree/sub/deep\n--rw------- U 0 bob staff 2 Sep 09  2001 tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:chstat-gate", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/chstat -p {/fs/match '*.b'} -m u+x {/fs/walk tree/sub}}}} 1}\n", input = "", status = "", out = "d-rwx------ U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub\n--rw------- U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/c.txt\n--rwx------ U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/d.b\nd-rwx------ U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub/deep\n--rw------- U 0 @USER@ @USER@ 2 Jan 02  2020 tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:chstat-c", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/chstat -c {/fs/walk tree/sub}}}} 1}\n", input = "", status = "", out = "d-rwxrwxrwx U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub\n--rw-rw-rw- U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/c.txt\n--rw-rw-rw- U 0 @USER@ @USER@ 4 Jan 02  2020 tree/sub/d.b\nd-rwxrwxrwx U 0 @USER@ @USER@ 0 Jan 02  2020 tree/sub/deep\n--rw-rw-rw- U 0 @USER@ @USER@ 2 Jan 02  2020 tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:chstat-bad", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/chstat -m zz {/fs/walk tree/sub}}}} 1}\n", input = "", status = "no value", out = "", err = "fs: chstat: bad mode 'zz'\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:chstat-bundle", script = "typeset /fs\n- {/print {/fs/bundle {/fs/chstat -u x {/fs/walk tree/sub}}} 1}\n", input = "", status = "", out = "tree/sub 20000000700 x wao 1577979240 0\nc.txt 600 x wao 1577979240 4\nsea\nd.b 600 x wao 1577979240 4\ndee\ndeep 20000000700 x wao 1577979240 0\ne.txt 600 x wao 1577979240 2\ne\n\n\nend of archive\n", err = ""},
    .{name = "fs:proto", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/proto -r tree {/read proto.txt}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/deep\ntree/sub/deep/e.txt\n", err = "alphabet: 2. proto: tree/nosuch not found\n"},
    .{name = "fs:proto-ls", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/proto -r tree {/read proto.txt}}}} 1}\n", input = "", status = "", out = "d-rwxrwxrwx � -1 sys sys 0 Jan 02  2020 tree\n--rw-rw-rw- � -1 sys sys 6 Jan 02  2020 tree/a.txt\n--rw------- � -1 bob staff 4 Jan 02  2020 tree/b.b\nd-rwxrwxrwx � -1 sys sys 0 Jan 02  2020 tree/sub\n--rw-rw-rw- � -1 sys sys 4 Jan 02  2020 tree/sub/c.txt\nd-rwxrwxrwx � -1 sys sys 0 Jan 02  2020 tree/sub/deep\n--rw-rw-rw- � -1 sys sys 2 Jan 02  2020 tree/sub/deep/e.txt\n", err = "alphabet: 2. proto: tree/nosuch not found\n"},
    .{name = "fs:proto-bundle", script = "typeset /fs\n- {/print {/fs/bundle {/fs/proto -r tree {/read proto2.txt}}} 1}\n", input = "", status = "", out = "tree 20000000777 sys sys 1577979240 0\nb.b 777 sys sys 1577979240 4\nbee\nsub 20000000777 sys sys 1577979240 0\nc.txt 666 sys sys 1577979240 4\nsea\nd.b 666 sys sys 1577979240 4\ndee\n\n\nend of archive\n", err = ""},
    .{name = "fs:proto-plus", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/proto -r tree {/echo +}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\ntree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:proto-star", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/proto -r tree {/echo '*'}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\ntree/b.b\n", err = ""},
];

block11: [16]Case = Case.[
    .{name = "fs:proto-filter", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/filter {/fs/proto -r tree {/echo +}} {/fs/match '*.txt'}}}} 1}\n", input = "", status = "", out = "tree\ntree/a.txt\n", err = ""},
    .{name = "fs:mergewrite", script = "typeset /fs\n- {/fs/write {/fs/walk tree} copy5}\n- {/fs/mergewrite -v {/fs/walk tree2} copy5 {/fs/compose AoverB}}\n- {/print {/fs/print {/fs/entries {/fs/walk copy5}}} 1}\n- {/print {/read copy5/a.txt} 1}\n", input = "", status = "", out = "copy5\ncopy5/a.txt\ncopy5/b.b\ncopy5/sub\ncopy5/sub/c.txt\ncopy5/sub/z.txt\ncopy5/x.b\nother\n", err = "alphabet: 2. mergewrite: create copy5 20000000700\nalphabet: 2. mergewrite: removing copy5/a.txt\nalphabet: 2. mergewrite: create copy5/a.txt 600\nalphabet: 2. mergewrite: removing copy5/sub\nalphabet: 2. mergewrite: create copy5/sub 20000000700\nalphabet: 2. mergewrite: create copy5/sub/c.txt 600\nalphabet: 2. mergewrite: create copy5/sub/z.txt 600\nalphabet: 2. mergewrite: create copy5/x.b 600\n"},
    .{name = "fs:mergewrite-A", script = "typeset /fs\n- {/fs/write {/fs/walk tree} copy6}\n- {/fs/mergewrite {/fs/walk tree2} copy6 {/fs/compose B}}\n- {/print {/fs/print {/fs/entries {/fs/walk copy6}}} 1}\n", input = "", status = "", out = "copy6\ncopy6/a.txt\ncopy6/b.b\ncopy6/sub\ncopy6/sub/c.txt\ncopy6/sub/d.b\ncopy6/sub/deep\ncopy6/sub/deep/e.txt\n", err = ""},
    .{name = "fs:mergewrite-n", script = "typeset /fs\n- {/fs/mergewrite -n -v {/fs/walk tree2} copy7 {/fs/newer}}\n- {/print {/fs/print {/fs/entries {/fs/walk copy7}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 2. mergewrite: create copy7 20000000700\nalphabet: 2. mergewrite: create copy7/a.txt 600\nalphabet: 2. mergewrite: create copy7/sub 20000000700\nalphabet: 2. mergewrite: create copy7/sub/c.txt 600\nalphabet: 2. mergewrite: create copy7/sub/z.txt 600\nalphabet: 2. mergewrite: create copy7/x.b 600\nfs: walk: cannot stat copy7: 'copy7' file does not exist\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:mergewrite-new", script = "typeset /fs\n- {/fs/mergewrite {/fs/walk tree2} copy8 {/fs/newer}}\n- {/print {/fs/print {/fs/entries {/fs/walk copy8}}} 1}\n", input = "", status = "", out = "copy8\ncopy8/a.txt\ncopy8/sub\ncopy8/sub/c.txt\ncopy8/sub/z.txt\ncopy8/x.b\n", err = ""},
    .{name = "fs:fs-info", script = "typeset /fs\ninfo\n", input = "", status = "", out = "typeset /\n/auth [-v] [-k /string] [-C /string] /wfd -> /wfd\n/cat [/fd...] -> /fd\n/create /fd /string -> /status\n/dial /string -> /wfd\n/echo [-n] /string -> /fd\n/env /string -> /string\n/export /string -> /wfd\n/fd /string -> /wfd\n/filter /fd /cmd [/string...] -> /fd\n/mount [-abc] [-x /string] /wfd /string -> /status\n/par [/status...] -> /status\n/parse /string -> /cmd\n/pretty /cmd -> /string\n/print /fd /string -> /status\n/read /string -> /fd\n/readall /fd -> /string\n/rewrite [-d /string] /cmd /cmd -> /cmd\n/seq [-ao] [/status...] -> /status\n/unparse /cmd -> /string\n/w2fd /wfd -> /fd\n/wait /status -> /string\n\ntypeset /fs\n/fs/and /fs/gate /fs/gate [/fs/gate...] -> /fs/gate\n/fs/bundle /fs/fs -> /fd\n/fs/chstat [-c] [-p /fs/gate] [-m /string] [-u /string] [-g /string] [-t /string] [-a /string] /fs/fs -> /fs/fs\n/fs/compose [-d] /string -> /fs/selector\n/fs/depth /string -> /fs/gate\n/fs/entries /fs/fs -> /fs/entries\n/fs/exec [-pP] [-n /string] [-t /cmd] /fs/entries /cmd -> /status\n/fs/filter [-d] /fs/fs /fs/gate -> /fs/fs\n/fs/ls [-um] /fs/entries -> /fd\n/fs/match [-ar] /string -> /fs/gate\n/fs/merge [-1] [-c /fs/selector] /fs/fs /fs/fs [/fs/fs...] -> /fs/fs\n/fs/mergewrite [-vn] /fs/fs /string /fs/selector -> /status\n/fs/mode /string -> /fs/gate\n/fs/newer [-d] -> /fs/selector\n/fs/not /fs/gate -> /fs/gate\n/fs/or /fs/gate /fs/gate [/fs/gate...] -> /fs/gate\n/fs/path [-x] /string [/string...] -> /fs/gate\n/fs/pipe [-1pP] /fs/fs /cmd -> /status\n/fs/print /fs/entries -> /fd\n/fs/proto [-r /string] /fd -> /fs/fs\n/fs/query [-pP] /cmd -> /fs/gate\n/fs/run /cmd -> /string\n/fs/select /fs/entries /fs/gate -> /fs/entries\n/fs/setroot [-c] /fs/fs /string -> /fs/fs\n/fs/size /fs/entries -> /fd\n/fs/unbundle /fd -> /fs/fs\n/fs/walk [-b /string] /string -> /fs/fs\n/fs/write [-v] /fs/fs /string -> /status\n", err = ""},
    .{name = "fs:exec", script = "typeset /fs\n- {/fs/exec {/fs/entries {/fs/walk tree/sub}} \"{echo file $file}}\n\n", input = "", status = "", out = "file tree/sub\nfile tree/sub/c.txt\nfile tree/sub/d.b\nfile tree/sub/deep\nfile tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:exec-n2", script = "typeset /fs\n- {/fs/exec -n 2 {/fs/entries {/fs/walk tree/sub}} \"{echo $file}}\n\n", input = "", status = "", out = "tree/sub tree/sub/c.txt\ntree/sub/d.b tree/sub/deep\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:exec-p", script = "typeset /fs\n- {/fs/exec -p {/fs/entries {/fs/walk tree/sub}} \"{echo $file $mode $mtime $length}}\n\n", input = "", status = "", out = "tree/sub d-rwx------ 1577979240 0\ntree/sub/c.txt --rw------- 1577979240 4\ntree/sub/d.b --rw------- 1577979240 4\ntree/sub/deep d-rwx------ 1577979240 0\ntree/sub/deep/e.txt --rw------- 1577979240 2\n", err = ""},
    .{name = "fs:exec-P", script = "typeset /fs\n- {/fs/exec -P {/fs/entries {/fs/walk tree/sub}} \"{echo $name $dtype}}\n\n", input = "", status = "", out = "tree/sub U\nc.txt U\nd.b U\ndeep U\ne.txt U\n", err = ""},
    .{name = "fs:exec-t", script = "typeset /fs\n- {/fs/exec -t \"{echo done $#file} {/fs/entries {/fs/walk tree/sub}} \"{echo $file}}\n\n", input = "", status = "", out = "tree/sub\ntree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\ndone 0\n", err = ""},
    .{name = "fs:exec-fail", script = "typeset /fs\n- {/fs/exec {/fs/entries {/fs/walk tree/sub}} \"{test -d $file}}\n\n", input = "", status = "", out = "", err = ""},
    .{name = "fs:exec-n0", script = "typeset /fs\n- {/fs/exec -n 0 {/fs/entries {/fs/walk tree/sub}} \"{echo $file}}\n\n", input = "", status = "no value", out = "", err = "fs: exec: invalid argument to -n\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:exec-pn", script = "typeset /fs\n- {/fs/exec -p -n 2 {/fs/entries {/fs/walk tree/sub}} \"{echo $file}}\n\n", input = "", status = "no value", out = "", err = "fs: exec: cannot specify -p with -n 2\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:exec-block", script = "typeset /fs\n- {/fs/exec {/fs/entries {/fs/walk tree/sub}} {echo $file}}\n\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: $file not defined or cannot be reused\n"},
    .{name = "fs:query", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/query \"{test -d $file}}}} 1}\n\n", input = "", status = "", out = "tree\ntree/sub\ntree/sub/deep\n", err = ""},
];

block12: [16]Case = Case.[
    .{name = "fs:query-p", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/query -p \"{test $length -gt 3}}}} 1}\n\n", input = "", status = "", out = "tree/a.txt\ntree/b.b\ntree/sub/c.txt\ntree/sub/d.b\n", err = ""},
    .{name = "fs:query-P", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree/sub}} {/fs/query -P \"{echo $name $dtype}}}} 1}\n", input = "", status = "", out = "tree/sub U\ntree/sub\nc.txt U\ntree/sub/c.txt\nd.b U\ntree/sub/d.b\ndeep U\ntree/sub/deep\ne.txt U\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:pipe", script = "typeset /fs\n- {/fs/pipe {/fs/walk tree/sub} \"{cat}}\n\n", input = "", status = "", out = "sea\ndee\ne\n", err = ""},
    .{name = "fs:pipe-p", script = "typeset /fs\n- {/fs/pipe -p {/fs/walk tree/sub} \"{echo $file $length}}\n\n", input = "", status = "", out = "tree/sub/c.txt 4\ntree/sub/d.b 4\ntree/sub/deep/e.txt 2\n", err = ""},
    .{name = "fs:pipe-1", script = "typeset /fs\n- {/fs/pipe -1 {/fs/walk tree/sub} \"{cat}}\n\n", input = "", status = "", out = "sea\ndee\ne\n", err = ""},
    .{name = "fs:pipe-1p", script = "typeset /fs\n- {/fs/pipe -1 -p {/fs/walk tree/sub} \"{cat}}\n\n", input = "", status = "no value", out = "", err = "fs: exec: cannot specify -p with -1\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:run", script = "typeset /fs\n- {/print {/echo {/fs/run \"{s=hello}}} 1}\n\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "fs:run-side", script = "typeset /fs\n- {/print {/echo {/fs/run \"{s=hello; echo side}}} 1}\n\n", input = "", status = "", out = "side\nhello\n", err = ""},
    .{name = "fs:run-two", script = "typeset /fs\n- {/print {/echo {/fs/run \"{s=(a b)}}} 1}\n\n", input = "", status = "no value", out = "", err = "fs: run: $s has 2 members; exactly one is required\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:run-none", script = "typeset /fs\n- {/print {/echo {/fs/run \"{x=1}}} 1}\n\n", input = "", status = "no value", out = "", err = "fs: run: $s has 0 members; exactly one is required\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:run-raise", script = "typeset /fs\n- {/print {/echo {/fs/run \"{raise oops}}} 1}\n\n", input = "", status = "no value", out = "", err = "sh: raise: './raise' file does not exist\nfs: run: $s has 0 members; exactly one is required\nalphabet: 0. eval: error: command failed\n"},
    .{name = "fs:run-cmd", script = "typeset /fs\n- {/print {/echo {/fs/run \"{s={a b}}}} 1}\n\n", input = "", status = "", out = "{a b}\n", err = ""},
    .{name = "grid:types", script = "typeset /grid\necho ${types /grid}\n\n", input = "", status = "", out = "records endpoint\n", err = ""},
    .{name = "grid:type", script = "typeset /grid\ntype /grid/endpoint /grid/records\necho ${types}\n\n", input = "", status = "", out = "records endpoint /data /wfd /fd /status /string /cmd\n", err = ""},
    .{name = "grid:usage", script = "typeset /grid\necho ${usage /grid/local}\necho ${usage /grid/line2rec}\n\n", input = "", status = "", out = "[-v] /grid/endpoint -> /fd\n/fd -> /grid/records\n", err = ""},
    .{name = "grid:declared", script = "typeset /grid\ndeclare /grid/local\ndeclare /grid/line2rec\necho ${modules}\n\n", input = "", status = "", out = "/grid/local /grid/line2rec\n", err = ""},
];

