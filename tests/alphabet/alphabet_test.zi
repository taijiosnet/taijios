block9: [16]Case = Case.[
    .{name = "fs:unbundle-ls", script = "typeset /fs\n- {/print {/fs/ls {/fs/entries {/fs/unbundle {/fs/bundle {/fs/walk tree/sub}}}}} 1}\n", input = "", status = "", out = "d-rwx------ � -1 @USER@ @USER@ 0 Jan 02  2020 tree/sub\n--rw------- � -1 @USER@ @USER@ 4 Jan 02  2020 tree/sub/c.txt\n--rw------- � -1 @USER@ @USER@ 4 Jan 02  2020 tree/sub/d.b\nd-rwx------ � -1 @USER@ @USER@ 0 Jan 02  2020 tree/sub/deep\n--rw------- � -1 @USER@ @USER@ 2 Jan 02  2020 tree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:unbundle-garbage", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/unbundle {/echo garbage}}}} 1}\n", input = "", status = "", out = "", err = "alphabet: 1. unbundle: invalid first header garbage\n"},
