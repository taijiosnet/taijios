CASES :: 141;

CaseAt :: (i: s64) -> Case {

    if i < 16 { return block0[i - 0] }

    if i < 32 { return block1[i - 16] }

    if i < 48 { return block2[i - 32] }

    if i < 64 { return block3[i - 48] }

    if i < 80 { return block4[i - 64] }

    if i < 96 { return block5[i - 80] }

    if i < 112 { return block6[i - 96] }

    if i < 128 { return block7[i - 112] }

    if i < 141 { return block8[i - 128] }

    return block0[0];
}


failures: s32;

Expect :: (ok: bool, c: Case, what: string, got: string, want: string) {
    if ok { return }
    failures += 1;
    print("FAIL % %:\n  got  [%]\n  want [%]\n", c.name, what, got, want);
}

Path :: (dir: string, kind: string, index: s64) -> string {
    path: Vec(u8);
    BuilderPrint(*path, "%/%/%.%", WORK, dir, kind, index);
    return BuilderFinish(path);
}

Prepare :: () -> bool {
    unused RemoveTree(WORK);
    unused CreateDirectory("build");
    unused CreateDirectory("build/tests");
    unused CreateDirectory("build/tests/alphabet");
    if !CreateDirectory(WORK) { return false }
    dirs := string.["work", "work/sub", "cases", "result"];
    for dirs {
        path: Vec(u8);
        BuilderPrint(*path, "%/%", WORK, it);
        if !CreateDirectory(BuilderFinish(path)) { return false }
    }
    a: Vec(u8);
    BuilderPrint(*a, "%/work/a.txt", WORK);
    if !WriteEntireFile(BuilderFinish(a), "alpha\nbeta\n") { return false }
    if !Tree() { return false }
    for i: 0..CASES - 1 {
        if !WriteEntireFile(Path("cases", "script", i), CaseAt(i).script) { return false }
    }
    return true;
}

// The fs cases' tree: every file and directory dated 2020-01-02 and
// private to its owner, b.b executable.
Tree :: () -> bool {
    dirs := string.["tree", "tree/sub", "tree/sub/deep"];
    for dirs { if !CreateDirectory(WorkPath(it)) { return false } }
    names := string.["tree/a.txt", "tree/b.b", "tree/sub/c.txt", "tree/sub/d.b", "tree/sub/deep/e.txt"];
    texts := string.["alpha\n", "bee\n", "sea\n", "dee\n", "e\n"];
    for names { if !WriteEntireFile(WorkPath(it), texts[it_index]) { return false } }
    for names {
        mode := ifx it == "tree/b.b" then "755" else "600";
        if !Host3("chmod", mode, WorkPath(it)) { return false }
    }
    for dirs { if !Host3("chmod", "700", WorkPath(it)) { return false } }
    order := string.["tree/a.txt", "tree/b.b", "tree/sub/c.txt", "tree/sub/d.b", "tree/sub/deep/e.txt",
        "tree/sub/deep", "tree/sub", "tree"];
    for order { if !Host4("touch", "-d", "@1577979240", WorkPath(it)) { return false } }
    return true;
}

WorkPath :: (name: string) -> string {
    path: Vec(u8);
    BuilderPrint(*path, "%/work/%", WORK, name);
    return BuilderFinish(path);
}

Host3 :: (tool: string, a: string, path: string) -> bool {
    command: [3]string = .[tool, a, path];
    run: ProcessRun;
    return RunProcess(.{arguments = command[:]}, *run) && run.code == 0;
}

Host4 :: (tool: string, a: string, b: string, path: string) -> bool {
    command: [4]string = .[tool, a, b, path];
    run: ProcessRun;
    return RunProcess(.{arguments = command[:]}, *run) && run.code == 0;
}

// One guest shell script runs every case and keeps each result in files.
Script :: () -> string {
    script: Vec(u8);
    BuilderPrint(*script, "abcvar=hello\nablist=(a b)\ncd /%/work\n", WORK);
    for i: 0..CASES - 1 {
        c := CaseAt(i);
        input := "/dev/null";
        if c.input.count > 0 { input = c.input }
        BuilderPrint(*script, "/dis/alphabet.zx /%/cases/script.% < % > ../result/out.% >[2] ../result/err.%\n",
            WORK, i, input, i, i);
        BuilderPrint(*script, "echo $status > ../result/status.%\n", i);
    }
    return BuilderFinish(script);
}

Result :: (kind: string, index: s64) -> string {
    text, ok := ReadEntireFile(Path("result", kind, index));
    return ifx ok then text else "<missing>";
}

main :: (argc: s32, argv: **u8) -> s32 {
    emu := ifx argc > 1 then TextFromCString(argv[1]) else "emu/Linux/o.emu";
    if !Prepare() { print("cannot prepare %\n", WORK); return 1 }
    guest: Vec(u8);
    BuilderPrint(*guest, "%/script", WORK);
    guest_path := BuilderFinish(guest);
    if !WriteEntireFile(guest_path, Script()) { return 1 }
    root: Text = WorkingDirectory();
    shell: Vec(u8);
    BuilderPrint(*shell, "/%", guest_path);
    command: [7]string = .["timeout", "120", emu, "-r", TextView(root), "/dis/sh.dis", BuilderFinish(shell)];
    run: ProcessRun;
    if !RunProcess(.{arguments = command[:], capture_output = true, new_session = true}, *run) {
        print("cannot start %\n", emu);
        return 1;
    }
    user := EnvironmentText("USER");
    for i: 0..CASES - 1 {
        c := CaseAt(i);
        status: Vec(u8);
        BuilderPrint(*status, "%\n", c.status);
        want_status := BuilderFinish(status);
        got := Result("status", i);
        Expect(got == want_status, c, "status", got, want_status);
        out := Result("out", i);
        want_out: Text = TextReplace(c.out, "@USER@", user);
        Expect(out == TextView(want_out), c, "stdout", out, TextView(want_out));
        err := Result("err", i);
        Expect(err == c.err, c, "stderr", err, c.err);
    }
    if failures != 0 { print("alphabet: % failures in % cases\n", failures, CASES); return 1 }
    print("alphabet: all % cases match the Dis originals\n", CASES);
    return 0;
}
