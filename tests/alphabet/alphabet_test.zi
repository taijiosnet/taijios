// Guest regression for Alphabet in Ziran: the core (parser, type checker,
// evaluator, the builtins of "load alphabet"), the modules of the root
// typeset "/", the abc typeset, whose values are alphabets, and the fs
// typeset's file trees, entries, gates and selectors. An fs case's tree is
// made afresh with fixed modes and times; @USER@ stands for the user
// running the test, who owns its files. Each case is a script of alphabet builtin commands; it runs
// as /dis/alphabet.zx SCRIPT, and its status, output and diagnostics must
// be what the Dis "load alphabet" builtin gave for the same script, run
// with sh. A case with a note says where the Dis original could not be
// matched: it hung, or printed debugging, and the case holds the result
// the original meant.
//
// /filter runs shell commands and waits for /dis/sh.zx; /auth's protocol
// waits for a ZX Inferno Auth client; only its key file is checked here.
// /fs/match -r waits for a regular expression library.
//
// From the TaijiOS root, after "(cd appl/alphabet && mk install-zx)":
//     ziran run --target=c --root tests/alphabet tests/alphabet/alphabet_test.zi -- [EMU]
#import "std/byte_text_linux";
#import "std/file";
#import "std/file_linux";
#import "std/file_tree_linux";
#import "std/process_run_linux";
#import "std/environment_linux";
#import "std/text_tools";

Case :: struct {
    name: string;
    script: string;
    input: string; // a file of the work directory read as standard input; empty reads /dev/null
    status: string;
    out: string;
    err: string;
}

WORK :: "build/tests/alphabet/main";

block0: [16]Case = Case.[
    .{name = "echo-nostatus", script = "- {/echo hello}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no way to get from /fd to /status\n"},
    .{name = "print-echo", script = "- {/print {/echo hello} 1}\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "echo-n", script = "- {/print {/echo -n hello} 1}\n", input = "", status = "", out = "hello", err = ""},
    .{name = "cat-two", script = "- {/print {/cat {/echo a} {/echo b}} 1}\n", input = "", status = "", out = "a\nb\n", err = ""},
    .{name = "cat-none", script = "- {/print {/cat} 1}\n", input = "", status = "", out = "", err = ""},
    .{name = "autoconvert-print", script = "autoconvert /fd /status {(/fd); /print $1 1}\n- {/echo hi}\n", input = "", status = "", out = "hi\n", err = ""},
    .{name = "create", script = "- {/create {/echo data} /build/tests/alphabet/main/work/created}\n- {/print {/read /build/tests/alphabet/main/work/created} 1}\n", input = "", status = "", out = "data\n", err = ""},
    .{name = "create-bad", script = "- {/create {/echo data} /nodir/x}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: cannot create /nodir/x: '/nodir' file does not exist\nalphabet: 0. eval: error: command failed\n"},
    .{name = "read", script = "- {/print {/read /build/tests/alphabet/main/work/a.txt} 1}\n", input = "", status = "", out = "alpha\nbeta\n", err = ""},
    .{name = "read-missing", script = "- {/print {/read /build/tests/alphabet/main/work/missing} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: cannot open /build/tests/alphabet/main/work/missing: '/build/tests/alphabet/main/work/missing' does not exist\nalphabet: 0. eval: error: command failed\n"},
    // the Dis readall never answered a /read producer and hung
    .{name = "readall", script = "- {/print {/echo {/readall {/read /build/tests/alphabet/main/work/a.txt}}} 1}\n", input = "", status = "", out = "alpha\nbeta\n\n", err = ""},
    .{name = "env", script = "- {/print {/echo {/env abcvar}} 1}\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "env-list", script = "- {/print {/echo {/env ablist}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: environment variable ablist has more than one element\nalphabet: 0. eval: error: command failed\n"},
    .{name = "env-unset", script = "- {/print {/echo {/env nosuchvar}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: environment variable nosuchvar not set\nalphabet: 0. eval: error: command failed\n"},
    .{name = "env-badname", script = "- {/print {/echo {/env a/b}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: invalid environment variable name a/b\nalphabet: 0. eval: error: command failed\n"},
    .{name = "parse-unparse", script = "- {/print {/echo {/unparse {/parse 'a  b|c'}}} 1}\n", input = "", status = "", out = "a b|c\n", err = ""},
];

block1: [16]Case = Case.[
    // the Dis module hung after the failed parse
    .{name = "parse-bad", script = "- {/print {/echo {/unparse {/parse 'a }'}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: parse: parse 'a }' failed: internal: parse error: syntax error\nalphabet: 0. eval: error: command failed\n"},
    .{name = "pretty", script = "- {/print {/echo {/pretty \"{/print {/echo a} 1; /print {/echo b|/cat} 1}}} 1}\n", input = "", status = "", out = "{\n\t/print {\n\t\t/echo a\n\t} 1\n\t/print {\n\t\t/echo b |\n\t\t/cat\n\t} 1\n}\n", err = ""},
    .{name = "pretty-bad", script = "- {/print {/echo {/pretty \"{a=b}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: command failed\n"},
    .{name = "wait", script = "- {/print {/echo {/wait {/print {/echo x} 1}}} 1}\n", input = "", status = "", out = "x\n\n", err = ""},
    // Dis seq also printed three debugging lines with its process id
    .{name = "seq", script = "- {/seq {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\nb\n", err = ""},
    // Dis seq -o and -a hung when they stopped early
    .{name = "seq-o", script = "- {/seq -o {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\n", err = ""},
    .{name = "par", script = "- {/par {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\nb\n", err = ""},
    .{name = "fd-stdin", script = "- {/print {/w2fd {/fd 0}} 1}\n", input = "a.txt", status = "", out = "alpha\nbeta\n", err = ""},
    .{name = "fd-bad", script = "- {/print {/w2fd {/fd 9}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no such file descriptor 9\nalphabet: 0. eval: error: command failed\n"},
    // the emulator's refusal text for a ZX dial has no space before the parenthesis
    .{name = "dial-bad", script = "- {/print {/w2fd {/dial tcp!127.0.0.1!1}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: dial: cannot dial tcp!127.0.0.1!1: Connection refused (connect 127.0.0.1!1)\nalphabet: 0. eval: error: command failed\n"},
    // Dis mount of an /export hung
    .{name = "export-mount", script = "- {/mount {/export /build/tests/alphabet/main/work} /n/remote}\n- {/print {/read /n/remote/a.txt} 1}\n", input = "", status = "", out = "alpha\nbeta\n", err = ""},
    // Dis mount hung after reporting a failed mount
    .{name = "mount-bad", script = "- {/mount {/export /build/tests/alphabet/main/work} /nosuchdir}\n", input = "", status = "mount error on '/nosuchdir': '/nosuchdir' file does not exist", out = "", err = "alphabet: 2. mount: mount error on '/nosuchdir': '/nosuchdir' file does not exist\n"},
    .{name = "auth-nokey", script = "- {/print {/w2fd {/auth -k /nosuchkey {/export /}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: auth: cannot read /nosuchkey: '/nosuchkey' file does not exist\nalphabet: 0. eval: error: command failed\n"},
    .{name = "rewrite-mod", script = "- {/print {/echo {/unparse {/rewrite -d /status \"{/echo a} \"{autoconvert /fd /status {(/fd); /print $1 1}}}}} 1}\n", input = "", status = "", out = "{/echo a|/print 1}\n", err = ""},
    .{name = "args", script = "- {(/string); /print {/echo $1} 1} hello\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "args-two", script = "- {(/string /string); /print {/echo $1} $2} hello 1\n", input = "", status = "", out = "hello\n", err = ""},
];

block2: [16]Case = Case.[
    .{name = "args-badtype", script = "- {(/fd /string); /print $1 $2} hello 1\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no way to get from /string to /fd\nalphabet: 0. eval: error: conversion failed for /print $1 $2\nalphabet: 0. eval: error: usage: /print $1 $2 /fd /string -> unknown\n"},
    .{name = "args-count", script = "- {(/string); /print {/echo $1} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: wrong number of arguments (0/1) to /print {/echo $1} 1\nalphabet: 0. eval: error: usage: /print {/echo $1} 1 /string -> unknown\n"},
    .{name = "err-nargs", script = "- {/print {/echo a}}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: wrong number of arguments (1/2) to /print\nalphabet: 0. eval: error: usage: /print /fd /string -> /status\n"},
    .{name = "err-nargs-many", script = "- {/print {/echo a} 1 2}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: wrong number of arguments (3/2) to /print\nalphabet: 0. eval: error: usage: /print /fd /string -> /status\n"},
    .{name = "err-missing", script = "- {/print}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: wrong number of arguments (0/2) to /print\nalphabet: 0. eval: error: usage: /print /fd /string -> /status\n"},
    .{name = "err-nomod", script = "- {/nosuch}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: cannot load /nosuch: cannot load /dis/alphabet/main/nosuch.dis: '/dis/alphabet/main/nosuch.dis' does not exist\n"},
    .{name = "err-echo-noarg", script = "- {/echo}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: wrong number of arguments (0/1) to /echo\nalphabet: 0. eval: error: usage: /echo [-n] /string -> /fd\n"},
    .{name = "err-badopt", script = "- {/echo -x a}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: unknown option -x for /echo\nalphabet: 0. eval: error: usage: /echo [-n] /string -> /fd\n"},
    .{name = "err-cvt-string-fd", script = "- {/cat /a}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no way to get from /string to /fd\nalphabet: 0. eval: error: conversion failed for /cat\nalphabet: 0. eval: error: usage: /cat [/fd...] -> /fd\n"},
    .{name = "err-cvt-fd-string", script = "- {/print {/echo a} {/echo b}}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no way to get from /fd to /string\nalphabet: 0. eval: error: conversion failed for /print\nalphabet: 0. eval: error: usage: /print /fd /string -> /status\n"},
    .{name = "err-var", script = "- {/print $1 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: $1 not defined or cannot be reused\n"},
    .{name = "err-type", script = "- {(/nosuchtype); /echo a}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: invalid command: unknown type /nosuchtype\n"},
    .{name = "err-seqexpr", script = "- {/echo a; /echo b}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: expected pipe, adj or word, got /echo a;/echo b\n"},
    .{name = "err-usage", script = "- foo\n", input = "", status = "usage", out = "", err = "usage: - {expr} [arg...]\n"},
    .{name = "err-nofd", script = "- {/print {/echo a} 7}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no such fd 7\nalphabet: 0. eval: error: command failed\n"},
    .{name = "rewrite-sb", script = "echo ${rewrite {/print {/echo a} 1}}\n", input = "", status = "", out = "{/echo a|/print 1} -> /status\n", err = ""},
];

block3: [16]Case = Case.[
    .{name = "rewrite-sb-type", script = "echo ${rewrite {/echo a} /status}\n", input = "", status = "bad expression", out = "", err = "e: error: no way to get from /fd to /status\n"},
    .{name = "rewrite-sb-auto", script = "autoconvert /fd /status {(/fd); /print $1 1}\necho ${rewrite {/echo a} /status}\n", input = "", status = "", out = "{/echo a|/print 1} -> /status\n", err = ""},
    .{name = "rewrite-sb-block", script = "echo ${rewrite {(/string); /print {/echo $1} 1}}\n", input = "", status = "", out = "{(/string);/echo $1|/print 1} /string -> /status\n", err = ""},
    .{name = "rewrite-sb-dup", script = "echo ${rewrite {(/string); /seq {/print {/echo $1} 1} {/print {/echo $1} 1}}}\n", input = "", status = "", out = "{(/string);/echo $1|/print 1|/seq {/echo $1|/print 1}} /string -> /status\n", err = ""},
    .{name = "define", script = "define hello {(/string); /print {/echo $1} 1}\n- {hello world}\necho ${usage hello}\nwhatis hello\n", input = "", status = "", out = "world\n/string -> /status\nload alphabet; declare hello '/string -> /status'; define hello {(/string ); {(/string);/echo $1|/print 1}}\n", err = ""},
    .{name = "define-bad", script = "define /x {/echo a}\n", input = "", status = "bad define: bad module name", out = "", err = ""},
    .{name = "define-twice", script = "define x {/echo a}\ndefine x {/echo b}\n", input = "", status = "bad define: module already declared", out = "", err = ""},
    .{name = "declare-virtual", script = "declare foo '/string -> /fd'\n- {/print {foo a} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: cannot run a virtually declared module\nalphabet: 0. eval: error: command failed\n"},
    .{name = "declare-compat", script = "declare /echo '/string -> /fd'\necho ${usage /echo}\n", input = "", status = "", out = "/string -> /fd\n", err = ""},
    .{name = "declare-incompat", script = "declare /echo '/fd -> /fd'\n", input = "", status = "error", out = "", err = "cannot declare /echo: 'echo [-n] /string -> /fd' not compatible with '/fd -> /fd' (ff vs fs-n, 0)\n"},
    .{name = "declare-nosuch", script = "declare /nosuch\n", input = "", status = "error", out = "", err = "cannot declare /nosuch: cannot load /dis/alphabet/main/nosuch.dis: '/dis/alphabet/main/nosuch.dis' does not exist\n"},
    .{name = "declare-badsig", script = "declare /echo '/string ->'\n", input = "", status = "error", out = "", err = "cannot declare /echo: bad type sig: expected return type\n"},
    .{name = "import", script = "declare /echo\nimport /echo\n- {/print {echo hi} 1}\necho ${modules}\n", input = "", status = "", out = "hi\n/echo /print echo\n", err = ""},
    .{name = "import-bad", script = "import /nosuch\n", input = "", status = "import error", out = "", err = "alphabet: cannot import /nosuch: cannot import: cannot load /dis/alphabet/main/nosuch.dis: '/dis/alphabet/main/nosuch.dis' does not exist\n"},
    .{name = "type", script = "type /fd /string\necho ${usage /print}\necho ${types}\necho ${types /}\n", input = "", status = "", out = "fd string -> /status\n/data /wfd fd /status string /cmd\ndata wfd fd status string cmd\n", err = ""},
    .{name = "type-bad", script = "type /nosuch\n", input = "", status = "type declare error", out = "", err = "alphabet: cannot import type /nosuch: / does not hold type nosuch\n"},
];

block4: [16]Case = Case.[
    .{name = "types-badts", script = "echo ${types /nosuch}\n", input = "", status = "error", out = "", err = "unknown typeset /nosuch\n"},
    .{name = "usage", script = "echo ${usage /echo}\necho ${usage /seq}\necho ${usage /mount}\n", input = "", status = "", out = "[-n] /string -> /fd\n[-ao] [/status...] -> /status\n[-abc] [-x /string] /wfd /string -> /status\n", err = ""},
    .{name = "usage-nosuch", script = "echo ${usage /nosuch}\n", input = "", status = "error", out = "", err = "module not declared\n"},
    .{name = "undeclare", script = "declare /echo\nundeclare /echo\nundeclare /echo\n", input = "", status = "", out = "", err = "alphabet: cannot undeclare /echo: module not declared\n"},
    .{name = "autodeclare-off", script = "autodeclare 0\n- {/print {/echo a} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: cannot load /echo: module not declared\n"},
    .{name = "info", script = "info\n", input = "", status = "", out = "typeset /\n/auth [-v] [-k /string] [-C /string] /wfd -> /wfd\n/cat [/fd...] -> /fd\n/create /fd /string -> /status\n/dial /string -> /wfd\n/echo [-n] /string -> /fd\n/env /string -> /string\n/export /string -> /wfd\n/fd /string -> /wfd\n/filter /fd /cmd [/string...] -> /fd\n/mount [-abc] [-x /string] /wfd /string -> /status\n/par [/status...] -> /status\n/parse /string -> /cmd\n/pretty /cmd -> /string\n/print /fd /string -> /status\n/read /string -> /fd\n/readall /fd -> /string\n/rewrite [-d /string] /cmd /cmd -> /cmd\n/seq [-ao] [/status...] -> /status\n/unparse /cmd -> /string\n/w2fd /wfd -> /fd\n/wait /status -> /string\n", err = ""},
    .{name = "info-auto", script = "autoconvert /fd /status {(/fd); /print $1 1}\nautoconvert /string /fd /read\ninfo\n", input = "", status = "", out = "typeset /\n/auth [-v] [-k /string] [-C /string] /wfd -> /wfd\n/cat [/fd...] -> /fd\n/create /fd /string -> /status\n/dial /string -> /wfd\n/echo [-n] /string -> /fd\n/env /string -> /string\n/export /string -> /wfd\n/fd /string -> /wfd\n/filter /fd /cmd [/string...] -> /fd\n/mount [-abc] [-x /string] /wfd /string -> /status\n/par [/status...] -> /status\n/parse /string -> /cmd\n/pretty /cmd -> /string\n/print /fd /string -> /status\n/read /string -> /fd\n/readall /fd -> /string\n/rewrite [-d /string] /cmd /cmd -> /cmd\n/seq [-ao] [/status...] -> /status\n/unparse /cmd -> /string\n/w2fd /wfd -> /fd\n/wait /status -> /string\n\nautoconvert /fd /status {(/fd);/print $1 1}\nautoconvert /string /fd {(/string);/read $1}\n", err = ""},
    .{name = "typeset-bad", script = "typeset /nosuch\n", input = "", status = "error", out = "", err = "cannot load typeset /nosuch: cannot load nosuchtypes.dis: '/dis/alphabet/nosuchtypes.dis' does not exist\n"},
    .{name = "clear", script = "define x {/echo a}\nclear\necho ${usage x}\n", input = "", status = "error", out = "", err = "module not declared\n"},
    .{name = "whatis", script = "whatis /echo\n", input = "", status = "", out = "load alphabet; declare /echo '[-n] /string -> /fd'\n", err = ""},
    .{name = "autoconvert-word", script = "autoconvert /string /fd /read\n- {/print /build/tests/alphabet/main/work/a.txt 1}\n", input = "", status = "", out = "alpha\nbeta\n", err = ""},
    .{name = "autoconvert-ambig", script = "autoconvert /string /fd /read\nautoconvert /string /fd /echo\n", input = "", status = "", out = "", err = ""},
    .{name = "autoconvert-loop", script = "autoconvert /string /fd /read\nautoconvert /fd /string /readall\n", input = "", status = "error", out = "", err = "cannot autoconvert /fd to /string via /readall: bad auto-conversion /fd->/string via {(/fd);/readall $1}: ambiguity: self /string|{(/string);/read $1}|{(/fd);/readall $1}, self /string\n"},
    .{name = "autoconvert-badtype", script = "autoconvert /nosuch /fd /read\n", input = "", status = "error", out = "", err = "cannot autoconvert /nosuch to /fd via /read: unknown type /nosuch\n"},
    .{name = "autoconvert-incompat", script = "autoconvert /string /fd /readall\n", input = "", status = "error", out = "", err = "e: error: no way to get from /string to /fd\ne: error: conversion failed for /readall\ne: error: usage: /readall /fd -> /string\ncannot autoconvert /string to /fd via /readall: cannot rewrite transformation {(/string);/readall $1}\n"},
    .{name = "abc-info", script = "typeset /abc\ninfo\n", input = "", status = "", out = "typeset /\n/auth [-v] [-k /string] [-C /string] /wfd -> /wfd\n/cat [/fd...] -> /fd\n/create /fd /string -> /status\n/dial /string -> /wfd\n/echo [-n] /string -> /fd\n/env /string -> /string\n/export /string -> /wfd\n/fd /string -> /wfd\n/filter /fd /cmd [/string...] -> /fd\n/mount [-abc] [-x /string] /wfd /string -> /status\n/par [/status...] -> /status\n/parse /string -> /cmd\n/pretty /cmd -> /string\n/print /fd /string -> /status\n/read /string -> /fd\n/readall /fd -> /string\n/rewrite [-d /string] /cmd /cmd -> /cmd\n/seq [-ao] [/status...] -> /status\n/unparse /cmd -> /string\n/w2fd /wfd -> /fd\n/wait /status -> /string\n\ntypeset /abc\n/abc/abc -> /abc/abc\n/abc/autoconvert /abc/abc /string /string /cmd -> /abc/abc\n/abc/autodeclare /abc/abc /string -> /abc/abc\n/abc/declare [-qc] /abc/abc /string [/string...] -> /abc/abc\n/abc/declares /abc/abc /cmd -> /abc/abc\n/abc/define /abc/abc /string /cmd -> /abc/abc\n/abc/eval /abc/abc /cmd [/string...] -> /status\n/abc/import /abc/abc /string [/string...] -> /abc/abc\n/abc/rewrite [-s /string] [-r /string] /abc/abc /cmd -> /cmd\n/abc/type /abc/abc /string [/string...] -> /abc/abc\n/abc/typeset /abc/abc /string -> /abc/abc\n/abc/undeclare /abc/abc /string [/string...] -> /abc/abc\n", err = ""},
];

block5: [16]Case = Case.[
    .{name = "abc-types", script = "typeset /abc\necho ${types /abc}\necho ${types}\n", input = "", status = "", out = "vmods vtypes abc\n/abc/vmods /abc/vtypes /abc/abc /data /wfd /fd /status /string /cmd\n", err = ""},
    .{name = "abc-eval", script = "typeset /abc\n- {/abc/eval {/abc/autodeclare {/abc/abc} 1} \"{/print {/echo hi} 1}}\n", input = "", status = "", out = "hi\n", err = ""},
    .{name = "abc-eval-args", script = "typeset /abc\n- {/abc/eval {/abc/autodeclare {/abc/abc} 1} \"{(/string /string); /print {/echo $1} $2} hello 1}\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "abc-eval-noauto", script = "typeset /abc\n- {/abc/eval {/abc/abc} \"{/print {/echo hi} 1}}\n", input = "", status = "no value", out = "", err = "alphabet: 1. abceval: error: cannot load /echo: module not declared\nalphabet: 0. eval: error: command failed\n"},
    .{name = "abc-declare", script = "typeset /abc\n- {/abc/eval {/abc/declare {/abc/declare {/abc/abc} /echo} /print} \"{/print {/echo hi} 1}}\n", input = "", status = "", out = "hi\n", err = ""},
    .{name = "abc-declare-sig", script = "typeset /abc\n- {/abc/eval {/abc/declare {/abc/abc} /echo '/string -> /fd'} \"{/print {/echo hi} 1}}\n", input = "", status = "no value", out = "", err = "alphabet: 1. abceval: error: cannot load /print: module not declared\nalphabet: 0. eval: error: command failed\n"},
    .{name = "abc-declare-many", script = "typeset /abc\n- {/abc/eval {/abc/declare {/abc/abc} /echo a b} \"{/echo hi}}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: declare: maximum of two arguments allowed\nalphabet: 0. eval: error: command failed\n"},
