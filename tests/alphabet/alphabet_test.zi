// Guest regression for Alphabet in Ziran: the core (parser, type checker,
// evaluator, the builtins of "load alphabet") and the modules of the root
// typeset "/". Each case is a script of alphabet builtin commands; it runs
// as /dis/alphabet.zx SCRIPT, and its status, output and diagnostics must
// be what the Dis "load alphabet" builtin gave for the same script, run
// with sh. A case with a note says where the Dis original could not be
// matched: it hung, or printed debugging, and the case holds the result
// the original meant.
//
// /filter runs shell commands and waits for /dis/sh.zx; /auth's protocol
// waits for a ZX Inferno Auth client; only its key file is checked here.
//
// From the TaijiOS root, after "(cd appl/alphabet && mk install-zx)":
//     ziran run --target=c --root tests/alphabet tests/alphabet/alphabet_test.zi -- [EMU]
#import "std/byte_text_linux";
#import "std/file";
#import "std/file_linux";
#import "std/file_tree_linux";
#import "std/process_run_linux";

Case :: struct {
    name: string;
    script: string;
    input: string; // a file of the work directory read as standard input; empty reads /dev/null
    status: string;
    out: string;
    err: string;
}

WORK :: "build/tests/alphabet/main";

block0: [16]Case = Case.[
    .{name = "echo-nostatus", script = "- {/echo hello}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no way to get from /fd to /status\n"},
    .{name = "print-echo", script = "- {/print {/echo hello} 1}\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "echo-n", script = "- {/print {/echo -n hello} 1}\n", input = "", status = "", out = "hello", err = ""},
    .{name = "cat-two", script = "- {/print {/cat {/echo a} {/echo b}} 1}\n", input = "", status = "", out = "a\nb\n", err = ""},
    .{name = "cat-none", script = "- {/print {/cat} 1}\n", input = "", status = "", out = "", err = ""},
    .{name = "autoconvert-print", script = "autoconvert /fd /status {(/fd); /print $1 1}\n- {/echo hi}\n", input = "", status = "", out = "hi\n", err = ""},
    .{name = "create", script = "- {/create {/echo data} /build/tests/alphabet/main/work/created}\n- {/print {/read /build/tests/alphabet/main/work/created} 1}\n", input = "", status = "", out = "data\n", err = ""},
    .{name = "create-bad", script = "- {/create {/echo data} /nodir/x}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: cannot create /nodir/x: '/nodir' file does not exist\nalphabet: 0. eval: error: command failed\n"},
    .{name = "read", script = "- {/print {/read /build/tests/alphabet/main/work/a.txt} 1}\n", input = "", status = "", out = "alpha\nbeta\n", err = ""},
    .{name = "read-missing", script = "- {/print {/read /build/tests/alphabet/main/work/missing} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: cannot open /build/tests/alphabet/main/work/missing: '/build/tests/alphabet/main/work/missing' does not exist\nalphabet: 0. eval: error: command failed\n"},
    // the Dis readall never answered a /read producer and hung
    .{name = "readall", script = "- {/print {/echo {/readall {/read /build/tests/alphabet/main/work/a.txt}}} 1}\n", input = "", status = "", out = "alpha\nbeta\n\n", err = ""},
    .{name = "env", script = "- {/print {/echo {/env abcvar}} 1}\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "env-list", script = "- {/print {/echo {/env ablist}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: environment variable ablist has more than one element\nalphabet: 0. eval: error: command failed\n"},
    .{name = "env-unset", script = "- {/print {/echo {/env nosuchvar}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: environment variable nosuchvar not set\nalphabet: 0. eval: error: command failed\n"},
    .{name = "env-badname", script = "- {/print {/echo {/env a/b}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: env: invalid environment variable name a/b\nalphabet: 0. eval: error: command failed\n"},
    .{name = "parse-unparse", script = "- {/print {/echo {/unparse {/parse 'a  b|c'}}} 1}\n", input = "", status = "", out = "a b|c\n", err = ""},
];

block1: [16]Case = Case.[
    // the Dis module hung after the failed parse
    .{name = "parse-bad", script = "- {/print {/echo {/unparse {/parse 'a }'}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: parse: parse 'a }' failed: internal: parse error: syntax error\nalphabet: 0. eval: error: command failed\n"},
    .{name = "pretty", script = "- {/print {/echo {/pretty \"{/print {/echo a} 1; /print {/echo b|/cat} 1}}} 1}\n", input = "", status = "", out = "{\n\t/print {\n\t\t/echo a\n\t} 1\n\t/print {\n\t\t/echo b |\n\t\t/cat\n\t} 1\n}\n", err = ""},
    .{name = "pretty-bad", script = "- {/print {/echo {/pretty \"{a=b}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: command failed\n"},
    .{name = "wait", script = "- {/print {/echo {/wait {/print {/echo x} 1}}} 1}\n", input = "", status = "", out = "x\n\n", err = ""},
    // Dis seq also printed three debugging lines with its process id
    .{name = "seq", script = "- {/seq {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\nb\n", err = ""},
    // Dis seq -o and -a hung when they stopped early
    .{name = "seq-o", script = "- {/seq -o {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\n", err = ""},
    .{name = "par", script = "- {/par {/print {/echo a} 1} {/print {/echo b} 1}}\n", input = "", status = "", out = "a\nb\n", err = ""},
    .{name = "fd-stdin", script = "- {/print {/w2fd {/fd 0}} 1}\n", input = "a.txt", status = "", out = "alpha\nbeta\n", err = ""},
    .{name = "fd-bad", script = "- {/print {/w2fd {/fd 9}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: error: no such file descriptor 9\nalphabet: 0. eval: error: command failed\n"},
    // the emulator's refusal text for a ZX dial has no space before the parenthesis
    .{name = "dial-bad", script = "- {/print {/w2fd {/dial tcp!127.0.0.1!1}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: dial: cannot dial tcp!127.0.0.1!1: Connection refused (connect 127.0.0.1!1)\nalphabet: 0. eval: error: command failed\n"},
    // Dis mount of an /export hung
    .{name = "export-mount", script = "- {/mount {/export /build/tests/alphabet/main/work} /n/remote}\n- {/print {/read /n/remote/a.txt} 1}\n", input = "", status = "", out = "alpha\nbeta\n", err = ""},
    // Dis mount hung after reporting a failed mount
    .{name = "mount-bad", script = "- {/mount {/export /build/tests/alphabet/main/work} /nosuchdir}\n", input = "", status = "mount error on '/nosuchdir': '/nosuchdir' file does not exist", out = "", err = "alphabet: 2. mount: mount error on '/nosuchdir': '/nosuchdir' file does not exist\n"},
    .{name = "auth-nokey", script = "- {/print {/w2fd {/auth -k /nosuchkey {/export /}}} 1}\n", input = "", status = "no value", out = "", err = "alphabet: 0. eval: auth: cannot read /nosuchkey: '/nosuchkey' file does not exist\nalphabet: 0. eval: error: command failed\n"},
    .{name = "rewrite-mod", script = "- {/print {/echo {/unparse {/rewrite -d /status \"{/echo a} \"{autoconvert /fd /status {(/fd); /print $1 1}}}}} 1}\n", input = "", status = "", out = "{/echo a|/print 1}\n", err = ""},
    .{name = "args", script = "- {(/string); /print {/echo $1} 1} hello\n", input = "", status = "", out = "hello\n", err = ""},
    .{name = "args-two", script = "- {(/string /string); /print {/echo $1} $2} hello 1\n", input = "", status = "", out = "hello\n", err = ""},
];

