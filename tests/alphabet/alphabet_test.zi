    .{name = "fs:filter-match", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/filter {/fs/walk tree} {/fs/match '*.b'}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\n", err = ""},
    .{name = "fs:filter-d", script = "typeset /fs\n- {/print {/fs/print {/fs/entries {/fs/filter -d {/fs/walk tree} {/fs/match '*.b'}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\ntree/sub\ntree/sub/d.b\ntree/sub/deep\n", err = ""},
    .{name = "fs:match-a", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/match -a 'tree/sub/*'}}} 1}\n", input = "", status = "", out = "tree/sub/c.txt\ntree/sub/d.b\ntree/sub/deep\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:match-class", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/match '[a-c]*'}}} 1}\n", input = "", status = "", out = "tree/a.txt\ntree/b.b\ntree/sub/c.txt\n", err = ""},
    .{name = "fs:and", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/and {/fs/match '*.txt'} {/fs/depth 1}}}} 1}\n", input = "", status = "", out = "tree/a.txt\n", err = ""},
    .{name = "fs:or", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/or {/fs/match '*.b'} {/fs/match 'e*'}}}} 1}\n", input = "", status = "", out = "tree/b.b\ntree/sub/d.b\ntree/sub/deep/e.txt\n", err = ""},
    .{name = "fs:not", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/not {/fs/match '*.txt'}}}} 1}\n", input = "", status = "", out = "tree\ntree/b.b\ntree/sub\ntree/sub/d.b\ntree/sub/deep\n", err = ""},
