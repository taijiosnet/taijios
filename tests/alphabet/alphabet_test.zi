    .{name = "fs:match-r-end", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/match -r '\\.txt$'}}} 1}\n", input = "", status = "", out = "tree/a.txt\ntree/sub/c.txt\ntree/sub/deep/e.txt\n", err = ""},
