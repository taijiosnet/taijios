    .{name = "fs:mode-bad", script = "typeset /fs\n- {/print {/fs/print {/fs/select {/fs/entries {/fs/walk tree}} {/fs/mode zz}}} 1}\n", input = "", status = "no value", out = "", err = "fs: mode: bad mode 'zz'\nalphabet: 0. eval: error: command failed\n"},
